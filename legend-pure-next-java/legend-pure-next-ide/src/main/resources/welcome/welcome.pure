import meta::pure::compiler::*;

function go():Any[*]
{
     let f = parse('', 'import test::*;\n'+
      'function test::tst():Any[*]\n'+
      '{\n'+
      '    ^MyClass(name=\'ok\').name + 1;\n'+
      '}\n'+
      'Class test::MyClass\n'+
      '{\n'+
      '    name : String[1];\n'+
      '}');
      compile($f);               
}