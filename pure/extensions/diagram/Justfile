# pure/extensions/diagram/Justfile — builds the `###Diagram` language extension.
#
# Direct invocation: just <recipe>     (from pure/extensions/diagram/)
#
# Inputs:  shared/core.pdb, shared/compiler.pdb (produced by `bootstrap::build`).
# Output:  build/diagram.pdb (+ build/diagram-tests.pdb from `build-tests`)
#
# The extension is grammar + Pure, the same pair the Pure language itself is built from:
# grammar/antlr/Diagram{Lexer,Parser}.g4 is generated per platform, and grammar/rules.pure maps
# the resulting AntlrContext onto the protocol form derived from compiler/metamodel.pure. Nothing here is host-specific — a platform
# adapts the extension by generating its own parser from the .g4 and translating the rules.
#
# `compiler` is a dependency because the extension plugs into the compiler's extension seam
# (platform::pure::compiler::extension::CompilerExtension), not because the parser needs it: the
# ANTLR natives and AntlrContext live in core.

set quiet := true
set shell := ["bash", "-c"]

ts_root        := source_directory()
repo_root      := ts_root / ".." / ".." / ".."
shared_out     := repo_root / "shared"
test_results   := repo_root / "test-results"
diagram_out    := ts_root / "build"
# EVERYTHING derived from code/compiler/metamodel.pure lives in generated/: the protocol, the PDB schema
# fragment and the PDB writer. `--source` picks up its .pure files, `**/generated/` keeps it out of git,
# and none of it is ever hand-edited — `generate` recreates it, so deleting it is always safe. code/ is
# hand-written only, build/ only what is loaded at run time (the PDBs).
gen_dir        := ts_root / "generated"
protocol_pdb   := repo_root / "pure" / "modules" / "protocol" / "build" / "protocol.pdb"
metamodel_stage := ts_root / "build" / "metamodel-stage"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"

verbose := ""
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

header := "h(){ s=\"[extensions-diagram::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build diagram.pdb.
default: build

# Compile pure/extensions/diagram into build/diagram.pdb.
# The metamodel is the only authored shape; everything else the extension needs from it is DERIVED,
# by `generate`, so it can never drift from it:
#
#   1. compile code/compiler/metamodel.pure ALONE — the generators read a compiled metamodel, and the
#      rest of the extension cannot compile until their output exists.
#   2. generateProtocol -> generated/protocol.pure (`<<ProtocolInfo.pointer>>` on a slot
#      makes the protocol carry a path where the metamodel carries the resolved element).
#   3. generateFbs -> generated/diagram.fbs, the PDB schema fragment for the metamodel's classes, with
#      field ids pinned in diagram-fbs-field-ids.txt (committed, append-only — the wire format).
#   4. generateExtensionWriter -> generated/writer.pure, which diagramExtension's `pdb` uses.
#   5. compile the extension, generated code included -> build/diagram.pdb
build: _depCheck_base-pdbs generate
    @{{header}} 'build'
    @{{substep}} 'compile pure/extensions/diagram -> build/diagram.pdb'
    mkdir -p {{diagram_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/compiler-tests.pdb \
        --source {{ts_root}}/code --source {{gen_dir}} \
        --output-dir {{diagram_out}} {{err_filter}}

# Phases 1-4: the metamodel compiled on its own, then everything DERIVED from it — its protocol
# form, its PDB schema fragment (pdb/fbsgen, ids pinned in diagram-fbs-field-ids.txt, which is
# committed) and its PDB writer (pdb/writer/generator.pure). Nothing derived is hand-edited.
generate: _depCheck_base-pdbs
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'generate'
    test -f {{protocol_pdb}} || (echo "ERROR: missing {{protocol_pdb}} (run \`just modules::protocol::build\` first)" && exit 1)
    {{substep}} 'compile code/compiler/metamodel.pure alone (the generator reads a compiled metamodel)'
    rm -rf "{{metamodel_stage}}"
    mkdir -p "{{metamodel_stage}}/code/compiler"
    cp "{{ts_root}}/module.json" "{{metamodel_stage}}/"
    cp "{{ts_root}}/code/compiler/metamodel.pure" "{{metamodel_stage}}/code/compiler/"
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/compiler-tests.pdb \
        --source "{{metamodel_stage}}" \
        --output-dir "{{metamodel_stage}}/build" 2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2)
    {{substep}} 'generateProtocol -> generated/protocol.pure'
    mkdir -p "{{gen_dir}}"
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{protocol_pdb}} \
        --pdb "{{metamodel_stage}}/build/diagram.pdb" \
        --function "platform::pure::protocol::generation::generateProtocol_String_1__String_1__String_1_" \
        --args "platform::extensions::pure::diagram::metamodel" "platform::extensions::pure::diagram::protocol" \
        2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2) > "{{gen_dir}}/protocol.pure"
    echo "  wrote generated/protocol.pure ($(wc -c < "{{gen_dir}}/protocol.pure" | tr -d ' ') bytes)"
    {{substep}} 'generateFbs -> generated/diagram.fbs (+ diagram-fbs-field-ids.txt)'
    ids="{{ts_root}}/diagram-fbs-field-ids.txt"
    test -f "$ids" || printf '# FlatBuffer field-ID registry — keeps wire format stable across builds.\n# Auto-maintained by RdfFbsSchemaGenerator. Append-only.\n# Format: TableName.field_name=ID\n\n' > "$ids"
    mkdir -p "{{diagram_out}}"
    gen=$(mktemp); trap 'rm -f "$gen"' EXIT
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb "{{metamodel_stage}}/build/diagram.pdb" \
        --function "platform::pure::compiler::pdb::fbsgen::printFbs_String_1__String_1__String_1__Boolean_1_" \
        --args "platform::extensions::pure::diagram::metamodel" "{{shared_out}}/specification/m3.fbs" "$ids" \
        2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2) > "$gen"
    awk '/^===FBS-BEGIN===$/{f=1;next} /^===FBS-END===$/{f=0} f' "$gen" > "{{gen_dir}}/diagram.fbs"
    awk '/^===IDS-BEGIN===$/{f=1;next} /^===IDS-END===$/{f=0} f' "$gen" > "$ids"
    test -s "{{gen_dir}}/diagram.fbs" || { echo "ERROR: generateFbs produced nothing" >&2; cat "$gen" >&2; exit 1; }
    echo "  wrote generated/diagram.fbs ($(grep -c '^table ' "{{gen_dir}}/diagram.fbs") tables)"
    {{substep}} 'generateExtensionWriter -> generated/writer.pure'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb "{{metamodel_stage}}/build/diagram.pdb" \
        --function "platform::pure::compiler::pdb::generator::printExtensionWriter_String_1__String_1__String_1__String_1__Boolean_1_" \
        --args "{{shared_out}}/specification/m3.fbs" "{{gen_dir}}/diagram.fbs" \
               "platform::extensions::pure::diagram::metamodel" "platform::extensions::pure::diagram::pdb::gen" \
        2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2) > "$gen"
    awk '/^===GENWRITER-BEGIN===$/{f=1;next} /^===GENWRITER-END===$/{f=0} f' "$gen" > "{{gen_dir}}/writer.pure"
    test -s "{{gen_dir}}/writer.pure" || { echo "ERROR: generateExtensionWriter produced nothing" >&2; cat "$gen" >&2; exit 1; }
    rm -rf "{{metamodel_stage}}"
    echo "  wrote generated/writer.pure ($(wc -c < "{{gen_dir}}/writer.pure" | tr -d ' ') bytes)"

# No sibling-extension deps — alias of `build` for symmetry with the module Justfiles.
build-all: build

# Compile with tests split into build/diagram-tests.pdb (needed by `test-all`).
build-tests: _depCheck_base-pdbs generate
    @{{header}} 'build-tests'
    @{{substep}} 'compile pure/extensions/diagram -> build/diagram.pdb + diagram-tests.pdb'
    mkdir -p {{diagram_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/compiler-tests.pdb \
        --source {{ts_root}}/code --source {{gen_dir}} \
        --output-dir {{diagram_out}} \
        --tests split {{err_filter}}

# Compile -> build/diagram.pdb via the Pure compiler on Truffle (picks up compiler-pure changes automatically).
build-truffle: _depCheck_base-pdbs generate
    @{{header}} 'build-truffle'
    @{{substep}} 'compile pure/extensions/diagram -> build/diagram.pdb (Truffle)'
    test -x {{pure_truffle}} || (echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" && exit 1)
    mkdir -p {{diagram_out}}
    {{pure_truffle}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/compiler-tests.pdb \
        --source {{ts_root}}/code --source {{gen_dir}} \
        --output-dir {{diagram_out}} {{err_filter}}

# Run the extension's Pure tests.
#
# The parser tests call parseAntlr with the DiagramParser grammar, so they need a host that has the
# generated parser REGISTERED — not merely generated. On Truffle that is the CLI naming its languages
# (PureCompileMain installs PureLanguage + DiagramLanguage); a host that does not fails with "Unknown
# grammar: DiagramParser", which is the signal that its adapter is missing or uninstalled.
#
# Only the TEST pdbs are named below. `--root` lets the runtime register what each language declares in
# its own manifest — core.pdb, parser-mappings.pdb and compiler.pdb from language_pure.json, diagram.pdb
# from language_diagram.json — so this list holds only what no language declares: test content.
test-all: build-tests
    @{{header}} 'test-all'
    test -f {{shared_out}}/core-tests.pdb || (echo "ERROR: missing {{shared_out}}/core-tests.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -x {{pure_truffle}} || (echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" && exit 1)
    mkdir -p {{test_results}}/spec/diagram/grammar {{test_results}}/spec/diagram/compiler
    @{{substep}} 'parser fixtures: tests/grammar (Truffle)'
    {{pure_truffle}} execute \
        --root {{repo_root}} \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --pdb {{diagram_out}}/diagram-tests.pdb \
        --function "platform::extensions::pure::diagram::tests::runGrammarTests_String_1__String_1__String_1_" \
        --args "{{ts_root}}/tests/grammar" "{{test_results}}/spec/diagram/grammar/pure@cli-truffle.json" {{err_filter}}
    @{{substep}} 'compiler fixtures: tests/compiler (Truffle)'
    {{pure_truffle}} execute \
        --root {{repo_root}} \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --pdb {{diagram_out}}/diagram-tests.pdb \
        --function "platform::extensions::pure::diagram::tests::runCompilerTests_String_1__String_1__String_1_" \
        --args "{{ts_root}}/tests/compiler" "{{test_results}}/spec/diagram/compiler/pure@cli-truffle.json" {{err_filter}}

# Internal: fail loudly if the base PDBs aren't staged.
_depCheck_base-pdbs:
    #!/usr/bin/env bash
    for pdb in core compiler; do
        if [[ ! -f "{{shared_out}}/$pdb.pdb" ]]; then
            echo "ERROR: missing {{shared_out}}/$pdb.pdb (run \`just bootstrap::build\` first)" >&2
            exit 1
        fi
    done

# Rewrite the PDB goldens (tests/compiler-pdb-serialization) after an intended change to the metamodel,
# the compiler or the PDB format: each success fixture under tests/compiler, compiled and written by the
# Pure writer (goldenHexOf). Read the diff — and run truffle::spec-diagram-pdb — before keeping them.
regen-pdb-goldens: build-tests
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'regen-pdb-goldens'
    cd "{{ts_root}}/tests/compiler"
    for f in $(find . -name '*.pure' ! -name '*_E_*' | sort); do
        name="${f#./}"; name="${name%.pure}"
        mkdir -p "{{ts_root}}/tests/compiler-pdb-serialization/$(dirname "$name")"
        {{pure_truffle}} execute --root {{repo_root}} \
            --pdb {{shared_out}}/core-tests.pdb --pdb {{shared_out}}/compiler-tests.pdb --pdb {{diagram_out}}/diagram-tests.pdb \
            --function "platform::extensions::pure::diagram::tests::goldenHexOf_String_1__String_1__String_1_" \
            --args "{{ts_root}}/tests/compiler" "$name" 2>/dev/null | grep -v '^\[graal' | tail -1 | tr -d '\n' \
            | xxd -r -p > "{{ts_root}}/tests/compiler-pdb-serialization/$name.pdb"
        echo "  wrote tests/compiler-pdb-serialization/$name.pdb"
    done

# Remove build/ (diagram.pdb, the tests PDB, metamodel-stage/) and generated/ (protocol, schema, writer).
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove build/ and generated/'
    rm -rf {{diagram_out}} {{gen_dir}}
