// The extension compiling: a `###Diagram` section becomes an element in the graph, and its
// `type=` references become real classes.
//
// The file is composed rather than parsed whole. The `###Pure` half goes through the `parse`
// native, and the diagram section is appended as a protocol Section built by this extension's
// own parser. That keeps the test on core + compiler: putting the whole file through
// `parseDocument` would pull in the parser-mappings module for its section dispatch, which is
// host wiring rather than anything this extension decides. The dispatch is covered where it
// belongs — on the JavaScript platform, which registers the section for real.

import meta::pure::compiler::*;
import meta::pure::diagram::metamodel::*;
import meta::pure::diagram::compiler::*;
import meta::pure::diagram::parser::*;

function meta::pure::diagram::compiler::tests::model(): String[1]
{
   '###Pure\nClass m::Person { name : String[1]; }\nClass m::Firm { legalName : String[1]; }\n';
}

// A file whose `###Pure` half is parsed by the native and whose diagram half is parsed by this
// extension — the same two protocol Sections the host would hand the compiler.
function meta::pure::diagram::compiler::tests::fileWith(diagramSource: String[1]): meta::pure::protocol::PureFile[1]
{
   let pureHalf = meta::pure::functions::meta::parse('d.pure', meta::pure::diagram::compiler::tests::model());
   let section = ^meta::pure::protocol::Section(
      parserName = 'Diagram',
      imports    = [],
      elements   = buildDiagramSection($diagramSource, 'd.pure', 0));
   ^$pureHalf(sections = $pureHalf.sections->concatenate($section));
}

function meta::pure::diagram::compiler::tests::twoBoxes(): String[1]
{
   'Diagram m::D(width=800.0, height=600.0)\n' +
   '{\n' +
   '   TypeView tv_a(type=m::Person, position=(40.0, 60.0), width=200.0, height=90.0)\n' +
   '   TypeView tv_b(type=m::Firm, position=(400.0, 60.0), width=200.0, height=90.0)\n' +
   '   GeneralizationView gv(source=tv_b, target=tv_a, points=[])\n' +
   '}\n';
}

function <<meta::pure::profiles::test.Test>> meta::pure::diagram::compiler::tests::testDiagramReachesTheGraph(): Boolean[1]
{
   let result = compile(meta::pure::diagram::compiler::tests::fileWith(
      meta::pure::diagram::compiler::tests::twoBoxes()), diagramExtension(), true);
   let paths = $result.elements->map(e | $e->elementToPath());
   assert($paths->contains('m::Person'), | 'the classes still compile: ' + $paths->joinStrings(', '));
   assert($paths->contains('m::D'),
          | 'the diagram is an element at its own path: ' + $paths->joinStrings(', '));
   true;
}

function <<meta::pure::profiles::test.Test>> meta::pure::diagram::compiler::tests::testWithoutTheExtensionNothingIsClaimed(): Boolean[1]
{
   // The behaviour before the extension existed, and the proof that the seam is what adds it.
   let result = compile(meta::pure::diagram::compiler::tests::fileWith(
      meta::pure::diagram::compiler::tests::twoBoxes()), [], true);
   let paths = $result.elements->map(e | $e->elementToPath());
   assert($paths->contains('m::Person'), | 'the classes still compile');
   assert(!$paths->contains('m::D'), | 'nothing claimed the parsed diagram');
   true;
}

function <<meta::pure::profiles::test.Test>> meta::pure::diagram::compiler::tests::testGeometryAndReferencesSurvive(): Boolean[1]
{
   let result = compile(meta::pure::diagram::compiler::tests::fileWith(
      meta::pure::diagram::compiler::tests::twoBoxes()), diagramExtension(), true);
   let d = $result.elements->filter(e | $e->instanceOf(Diagram))->toOne()->cast(@Diagram);
   assert($d.width == 800.0 && $d.height == 600.0, | 'the dimension clause survives the compile');
   assert($d.typeViews->size() == 2, | 'both boxes, got ' + $d.typeViews->size()->toString());
   assert($d.generalizationViews->size() == 1, | 'the edge survives');
   let a = $d.typeViews->filter(v | $v.id == 'tv_a')->toOne();
   assert($a.position.x == 40.0 && $a.position.y == 60.0, | 'geometry is carried through verbatim');
   // One slot: the metamodel holds the resolved type, where the protocol held a path.
   assert($a.type->isNotEmpty(), | 'pass 2 resolved m::Person');
   assert($a.type->toOne()->elementToPath() == 'm::Person',
          | 'to the right type, got ' + $a.type->toOne()->elementToPath());
   true;
}

function <<meta::pure::profiles::test.Test>> meta::pure::diagram::compiler::tests::testDanglingReferenceIsReportedNotFatal(): Boolean[1]
{
   // A class renamed out from under a diagram. The file must still compile, so the editor can
   // open the diagram and repair it; the compiler says what is wrong.
   let result = compile(meta::pure::diagram::compiler::tests::fileWith(
      'Diagram m::D\n{\n   TypeView tv(type=m::Gone, position=(0.0, 0.0), width=10.0, height=10.0)\n}\n'),
      diagramExtension(), true);
   let d = $result.elements->filter(e | $e->instanceOf(Diagram))->toOne()->cast(@Diagram);
   // The view survives with nothing resolved, and the compiler reports the dangling path — so the
   // editor can still open the diagram and repair it.
   assert($d.typeViews->toOne().type->isEmpty(), | 'the stale reference resolves to nothing');
   true;
}
