function <<PCT.function, functionType.ReducerFunction>> {PCT.grammarDoc = '4 + 1', PCT.grammarCharacters = '+', platform::pure::profiles::doc.doc = 'Adds every element of an `Integer` collection, returning a single `Integer`.\n\nWritten `+` in Pure: `$a + $b` desugars to `plus([$a, $b])`, which is why the parameter is a collection\nrather than two values. The collection parameter is also what shapes the edge cases: a single value is\nreturned unchanged, so unary `+1` is just `1`, and an empty collection gives `0` — the additive\nidentity, so that adding nothing changes nothing.\n\n**Parameters**\n- `ints` — the values to add.\n\n**Returns** the sum of the collection.\n\n**Examples**\n```pure\n1 + 2                        // 3\n3 + 4 + 5 + 7                // 19\n[15, 13, 2, 1, 1]->plus()    // 32\n+1                           // 1\n```\n\n**See also** `minus(Integer[*]):Integer[1]`,\n`times(Integer[*]):Integer[1]`,\n`plus(Float[*]):Float[1]`,\n`plus(Decimal[*]):Decimal[1]`,\n`plus(Number[*]):Number[1]`'} meta::pure::functions::math::plus(ints: Integer[*]): Integer[1]
{
  []->toOne('not bridged: meta::pure::functions::math::plus')
}

function <<PCT.function, functionType.ReducerFunction>> {platform::pure::profiles::doc.doc = 'Adding every element of a `Float` collection, returning a `Float`.\n\nThe `+` operator desugars to this: `$a + $b` is `plus([$a, $b])`, which is why the parameter is a\ncollection rather than two values. The result keeps the `Float` type.'} meta::pure::functions::math::plus(float: Float[*]): Float[1]
{
  []->toOne('not bridged: meta::pure::functions::math::plus')
}

function <<PCT.function, functionType.ReducerFunction>> {platform::pure::profiles::doc.doc = 'Adding every element of a `Decimal` collection, returning a `Decimal`.\n\nThe `+` operator desugars to this: `$a + $b` is `plus([$a, $b])`, which is why the parameter is a\ncollection rather than two values. The result keeps the `Decimal` type.'} meta::pure::functions::math::plus(decimal: Decimal[*]): Decimal[1]
{
  []->toOne('not bridged: meta::pure::functions::math::plus')
}

function <<PCT.function, functionType.ReducerFunction>> {platform::pure::profiles::doc.doc = 'Adding every element of a `Number` collection, returning a `Number`.\n\nThe `+` operator desugars to this: `$a + $b` is `plus([$a, $b])`, which is why the parameter is a\ncollection rather than two values. The result keeps the `Number` type.'} meta::pure::functions::math::plus(numbers: Number[*]): Number[1]
