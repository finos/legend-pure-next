function <<PCT.function>> {PCT.grammarDoc = '1 - 2', PCT.grammarCharacters = '-', platform::pure::profiles::doc.doc = 'Subtracts every element of an `Integer` collection from the first, left to right, returning a single\n`Integer`.\n\nWritten `-` in Pure: `$a - $b` desugars to `minus([$a, $b])`, which is why the parameter is a collection\nrather than two values. A single value is the case worth knowing: unlike `plus`, it is *negated* rather\nthan returned unchanged, so `minus(1)` is `-1` — this is what makes unary `-` work. An empty collection\ngives `0`.\n\n**Parameters**\n- `ints` — the values to subtract; the first is the starting value, the rest are taken off it in order.\n\n**Returns** the first value with all the others subtracted from it, or the negation of a lone value.\n\n**Examples**\n```pure\n3 - 2                // 1\n3 - -2               // 5\n6 - (4 - 5) - 7      // 0\nminus(1)             // -1\n```\n\n**See also** `plus(Integer[*]):Integer[1]`,\n`times(Integer[*]):Integer[1]`,\n`minus(Float[*]):Float[1]`,\n`minus(Decimal[*]):Decimal[1]`,\n`minus(Number[*]):Number[1]`'} meta::pure::functions::math::minus(ints: Integer[*]): Integer[1]
{
  []->toOne('not bridged: meta::pure::functions::math::minus')
}

function <<PCT.function>> {platform::pure::profiles::doc.doc = 'Subtracting every element of a `Float` collection, left to right, returning a `Float`.\n\nThe `-` operator desugars to this: `$a - $b` is `minus([$a, $b])`, which is why the parameter is a\ncollection rather than two values. The result keeps the `Float` type.'} meta::pure::functions::math::minus(float: Float[*]): Float[1]
{
  []->toOne('not bridged: meta::pure::functions::math::minus')
}

function <<PCT.function>> {platform::pure::profiles::doc.doc = 'Subtracting every element of a `Decimal` collection, left to right, returning a `Decimal`.\n\nThe `-` operator desugars to this: `$a - $b` is `minus([$a, $b])`, which is why the parameter is a\ncollection rather than two values. The result keeps the `Decimal` type.'} meta::pure::functions::math::minus(decimal: Decimal[*]): Decimal[1]
{
  []->toOne('not bridged: meta::pure::functions::math::minus')
}

function <<PCT.function>> {platform::pure::profiles::doc.doc = 'Subtracting every element of a `Number` collection, left to right, returning a `Number`.\n\nThe `-` operator desugars to this: `$a - $b` is `minus([$a, $b])`, which is why the parameter is a\ncollection rather than two values. The result keeps the `Number` type.'} meta::pure::functions::math::minus(numbers: Number[*]): Number[1]
{
  []->toOne('not bridged: meta::pure::functions::math::minus')
}
