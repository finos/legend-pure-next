function <<PCT.function, PCT.platformOnly>> {platform::pure::profiles::doc.doc = 'Creates an instance of a class, giving it an identifier.\n\nThe reflective form of `^Class(...)`, for when the class is chosen at runtime. The `id` names the instance\nso it can be referred to later — it is the identifier `meta::pure::functions::meta::id(Any[1]):String[1]`\nreports, not a property value.\n\nProperties are not set here; use the `KeyValue` form\n`meta::pure::functions::lang::dynamicNew(Class<Any>[1], KeyValue[*]):Any[1]` when you need to populate them.'} meta::pure::functions::lang::new<T>(class: meta::pure::metamodel::type::Class<T>[1], id: String[1]): T[1]
{
  []->toOne('not bridged: meta::pure::functions::lang::new')
}

