// Legacy natives next needs no native for.

// Legacy evaluates its argument and returns it deactivated, as metamodel objects rather than live values.
// In next a lambda or an expression already is a graph object: the value is what legacy code wants.
function meta::pure::functions::meta::evaluateAndDeactivate<T|m>(var:T[m]):T[m]
{
   $var
}

// A function (a lambda, a function reference: next values) is how legacy code reaches a function's metamodel:
// legacy's view of it, its expressions legacy ones.
function meta::pure::functions::meta::evaluateAndDeactivate(var: platform::pure::metamodel::function::Function<Any>[1]): meta::pure::metamodel::function::FunctionDefinition<Any>[1]
{
   meta::pure::bridge::m3::adapt($var)->cast(@meta::pure::metamodel::function::FunctionDefinition<Any>)
}
