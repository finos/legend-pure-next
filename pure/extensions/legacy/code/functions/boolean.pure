// Legacy's identity: the same object, or equal primitive values. Two views of one next object are the same
// view (adapt memoizes).
function meta::pure::functions::boolean::eq(left: Any[1], right: Any[1]): Boolean[1]
{
   if($left->platform::pure::functions::meta::type()->platform::pure::functions::meta::instanceOf(platform::pure::metamodel::type::PrimitiveType),
      | $left->platform::pure::functions::boolean::equal($right),
      | $left->platform::pure::functions::boolean::is($right))
}
