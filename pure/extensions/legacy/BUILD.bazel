# The legend-pure compatibility layer (just: extensions::legacy::build-tests): legacy.pdb and legacy-tests.pdb, and
# the tests of its tools. Its loader is a module of its own (loader/). What needs the pinned legend-pure and
# legend-engine sources (fetch, generate, load, test-loaded, the use cases) is still run by its Justfile.

load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//tools/bazel:pure.bzl", "pure_module")

pure_module(
    name = "legacy",
    srcs = glob(["code/**/*.pure", "module.json"]),
    base_pdbs = ["//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-compiler:core-tests.pdb"],
    bootstrap_base_pdbs = [
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-compiler:core.pdb",
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-compiler:core-tests.pdb",
    ],
    sources = ["code"],
)

# The tests of its tools (just: extensions::legacy::test-tools): the grammar preprocessor.
js_test(
    name = "tools_tests",
    data = ["tools/preprocess.mjs"],
    entry_point = "tools/preprocess.test.mjs",
    tags = ["job:bootstrap"],
)
