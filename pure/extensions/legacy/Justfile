# pure/extensions/legacy/Justfile — the legend-pure compatibility layer: legend-pure's metamodel and
# functions over next's, so legacy Pure code (legend-engine's) compiles and runs on next.
#
# Direct invocation: just <recipe>     (from pure/extensions/legacy/)
#
# Inputs:  shared/core.pdb, shared/core-tests.pdb (produced by `bootstrap::build`).
# Output:  build/legacy.pdb (+ build/legacy-tests.pdb from `build-tests`)
#
# code/m3/m3.pure is GENERATED (`generate`) from legend-pure's m3.pure (fetched from the pinned
# legend-pure-m3-core jar), next's shared/specification/m3.pure and tools/m3-mapping.json. It is
# committed, so building needs neither the jar nor node. Hand-written legacy property bodies live in
# code/m3/overrides.pure.

set quiet := true
set shell := ["bash", "-c"]

legacy_root    := source_directory()
repo_root      := legacy_root / ".." / ".." / ".."
shared_out     := repo_root / "shared"
test_results   := repo_root / "test-results"
legacy_out     := legacy_root / "build"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"
tds_pdb        := repo_root / "pure" / "extensions" / "pure" / "tds" / "build" / "tds.pdb"
err_filter     := "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)"
# The legend-engine release whose Pure the bridge compiles (its function modules, then its core), and the
# legend-pure release it builds on: legend.pure.version in that release's pom.xml, which `_check-versions`
# reads back so the two cannot drift apart. Both are fetched as published jars, never vendored.
legend_engine_version := "5.0.3"
legend_pure_version   := "5.110.0"
legend_pure_dir       := legacy_out / "legend-pure-" + legend_pure_version
legend_engine_dir     := legacy_out / "legend-engine-" + legend_engine_version
# legend-pure's modules beyond its platform that legend-engine's need (their own jars)
legend_pure_modules   := "legend-pure-m2-dsl-tds-pure legend-pure-m3-precisePrimitives"
legend_engine_modules := "legend-engine-pure-functions-json-pure legend-engine-pure-functions-unclassified-pure legend-engine-pure-functions-variant-pure legend-engine-pure-functions-relation-pure legend-engine-pure-functions-standard-pure legend-engine-pure-code-compiled-core"

header := "h(){ s=\"[extensions-legacy::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"

default: build

# Regenerate code/m3/m3.pure (the legacy metamodel as wrappers over next's), from the m3.pure of the
# pinned legend-pure-m3-core jar, and by the loader natives/legacy_platform.pure (legend-pure's natives next
# lacks, as functions failing when called), natives/legacy_platform.adapters.pure (its functions taking
# legacy functions, overloaded for next's) and natives/legacy_platform.nextAdapters.pure (next's functions
# taking metamodel objects, overloaded for legacy's), all compiled with the loaded legacy_platform.
generate: _check-versions _fetch-legend-pure _fetch-legend-engine build-loader
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'generate'
    node {{legacy_root}}/tools/generate-m3.mjs {{legend_pure_version}} {{legend_pure_dir}}/platform/pure/grammar/m3.pure
    node {{legacy_root}}/tools/load.mjs {{legend_pure_dir}}/platform/pure {{legend_engine_dir}} {{loaded_out}} legacy_platform
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{loader_out}}/legacy_loader.pdb \
        --function "meta::pure::bridge::loader::generateStubs_String_1__String_1__String_1__String_1__String_1__String_1__String_1_" \
        --args "{{loaded_out}}/plan.txt" legacy_platform "{{legacy_root}}/natives/legacy_platform.pure" "{{legacy_root}}/natives/legacy_platform.adapters.pure" "{{legacy_root}}/natives/legacy_platform.nextAdapters.pure" "legend-pure {{legend_pure_version}} platform" {{err_filter}}

# Fetch the pinned legend-pure and legend-engine Pure sources into build/.
fetch: _check-versions _fetch-legend-pure _fetch-legend-engine

# legend_pure_version is the legend-pure release legend_engine_version builds on.
_check-versions:
    #!/usr/bin/env bash
    set -euo pipefail
    pom="{{legend_engine_dir}}/legend-engine-{{legend_engine_version}}.pom"
    mkdir -p "{{legend_engine_dir}}"
    test -f "$pom" || curl -sfL -o "$pom" "https://repo1.maven.org/maven2/org/finos/legend/engine/legend-engine/{{legend_engine_version}}/legend-engine-{{legend_engine_version}}.pom"
    declared=$(sed -n 's:.*<legend.pure.version>\(.*\)</legend.pure.version>.*:\1:p' "$pom")
    if [[ "$declared" != "{{legend_pure_version}}" ]]; then
        echo "ERROR: legend-engine {{legend_engine_version}} builds on legend-pure $declared, but legend_pure_version is {{legend_pure_version}}" >&2
        exit 1
    fi

# legend-engine's Pure jars (legend_engine_modules) at legend_engine_version, from the local Maven repository,
# else Maven Central, each unpacked into build/legend-engine-<version>/<artifact>/ (its .pure and definition files).
_fetch-legend-engine:
    #!/usr/bin/env bash
    set -euo pipefail
    for artifact in {{legend_engine_modules}}; do
        dir="{{legend_engine_dir}}/$artifact"
        test -d "$dir" && continue
        jar="$HOME/.m2/repository/org/finos/legend/engine/$artifact/{{legend_engine_version}}/$artifact-{{legend_engine_version}}.jar"
        if [[ ! -f "$jar" ]]; then
            jar="{{legend_engine_dir}}/$artifact-{{legend_engine_version}}.jar"
            curl -sfL -o "$jar" "https://repo1.maven.org/maven2/org/finos/legend/engine/$artifact/{{legend_engine_version}}/$artifact-{{legend_engine_version}}.jar"
        fi
        mkdir -p "$dir.part"
        # unzip exits 11 when a pattern matches nothing: a jar may hold no definition file
        rc=0; unzip -q -o "$jar" '*.pure' '*.definition.json' -d "$dir.part" || rc=$?
        if [[ $rc -ne 0 && $rc -ne 11 ]]; then echo "ERROR: unzip $jar failed ($rc)" >&2; exit 1; fi
        mv "$dir.part" "$dir"
        echo "  $artifact: $(find "$dir" -name '*.pure' | wc -l | tr -d ' ') Pure files"
    done

# legend-pure-m3-core <version> (its platform) and legend_pure_modules, from the local Maven repository, else
# Maven Central, unpacked into build/legend-pure-<version>/.
_fetch-legend-pure:
    #!/usr/bin/env bash
    set -euo pipefail
    jar="$HOME/.m2/repository/org/finos/legend/pure/legend-pure-m3-core/{{legend_pure_version}}/legend-pure-m3-core-{{legend_pure_version}}.jar"
    mkdir -p "{{legend_pure_dir}}"
    if [[ -f "{{legend_pure_dir}}/platform/pure/essential/meta/reflect/deactivate.pure" ]]; then
        :
    elif [[ ! -f "$jar" ]]; then
        jar="{{legend_pure_dir}}/legend-pure-m3-core-{{legend_pure_version}}.jar"
        curl -sfL -o "$jar" "https://repo1.maven.org/maven2/org/finos/legend/pure/legend-pure-m3-core/{{legend_pure_version}}/legend-pure-m3-core-{{legend_pure_version}}.jar"
        unzip -q -o "$jar" 'platform/pure/*' -d "{{legend_pure_dir}}"
    else
        unzip -q -o "$jar" 'platform/pure/*' -d "{{legend_pure_dir}}"
    fi
    # its modules beyond the platform, each unpacked into build/legend-pure-<version>/modules/<artifact>/
    for artifact in {{legend_pure_modules}}; do
        dir="{{legend_pure_dir}}/modules/$artifact"
        test -d "$dir" && continue
        jar="$HOME/.m2/repository/org/finos/legend/pure/$artifact/{{legend_pure_version}}/$artifact-{{legend_pure_version}}.jar"
        if [[ ! -f "$jar" ]]; then
            mkdir -p "{{legend_pure_dir}}/modules"
            jar="{{legend_pure_dir}}/modules/$artifact-{{legend_pure_version}}.jar"
            curl -sfL -o "$jar" "https://repo1.maven.org/maven2/org/finos/legend/pure/$artifact/{{legend_pure_version}}/$artifact-{{legend_pure_version}}.jar"
        fi
        mkdir -p "$dir.part"
        rc=0; unzip -q -o "$jar" '*.pure' '*.definition.json' -d "$dir.part" || rc=$?
        if [[ $rc -ne 0 && $rc -ne 11 ]]; then echo "ERROR: unzip $jar failed ($rc)" >&2; exit 1; fi
        mv "$dir.part" "$dir"
    done

# The legacy modules to load: legend-pure's platform and legend-engine's, by the names their definition
# files give them (with what they depend on).
load_modules := "legacy_platform core_functions_unclassified core_functions_variant core_functions_relation"
loaded_out   := legacy_out / "loaded"
loader_out   := legacy_out / "loader"

# Regenerate loader/code/rewrite.pure (the copy of a parsed source with its references rewritten), from
# next's protocol model.
generate-loader:
    @{{header}} 'generate-loader'
    node {{legacy_root}}/tools/generate-protocol-rewrite.mjs

# Compile the loader (loader/) with its tests -> build/loader/legacy_loader.pdb (+ -tests.pdb).
build-loader: _depCheck_base-pdbs
    @{{header}} 'build-loader'
    mkdir -p {{loader_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --source {{legacy_root}}/loader \
        --output-dir {{loader_out}} \
        --tests split {{err_filter}}

# Run the loader's <<test.Test>> functions (meta::pure::bridge::loader::tests).
test-loader: build-loader
    @{{header}} 'test-loader'
    mkdir -p {{test_results}}/spec/legacy/loader
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{loader_out}}/legacy_loader.pdb \
        --pdb {{loader_out}}/legacy_loader-tests.pdb \
        --function "platform::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::bridge::loader::tests" "{{test_results}}/spec/legacy/loader/pure@cli-bootstrap.json" {{err_filter}}

# Load legacy sources into build/loaded/<module>/: staged (tools/load.mjs), then parsed by next's parser and
# placed on top of the bridge (the loader). Each is then compiled in order, on top of core.pdb, legacy.pdb
# and the modules before it -> build/loaded/<module>.pdb.
load: fetch build-tests build-loader
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'load'
    node {{legacy_root}}/tools/load.mjs {{legend_pure_dir}}/platform/pure {{legend_engine_dir}} {{loaded_out}} {{load_modules}}
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{loader_out}}/legacy_loader.pdb \
        --function "meta::pure::bridge::loader::load_String_1__String_1_" \
        --args "{{loaded_out}}/plan.txt" {{err_filter}}
    # A module with islands (#TDS … #) is compiled by compiler-pure on Truffle: they need next's TDS extension,
    # whose handler is Pure (tds.pdb, on compiler.pdb). The others by the bootstrap compiler, much faster.
    test -f "{{tds_pdb}}" || (echo "ERROR: missing {{tds_pdb}} (run \`just extensions::pure::tds::build-tests\` first)" && exit 1)
    bases=(--base-pdb "{{shared_out}}/core.pdb" --base-pdb "{{shared_out}}/parser-mappings.pdb" --base-pdb "{{shared_out}}/compiler.pdb" --base-pdb "{{tds_pdb}}" --base-pdb "{{legacy_out}}/legacy.pdb")
    while read -r module _; do
        if grep -rqE '#TDS' "{{loaded_out}}/$module/code"; then compiler="{{pure_truffle}}"; else compiler="{{pure_bootstrap}}"; fi
        echo "  compiling $module ($(basename "$compiler"))"
        "$compiler" compile "${bases[@]}" --source "{{loaded_out}}/$module" --output-dir "{{loaded_out}}" {{err_filter}}
        bases+=(--base-pdb "{{loaded_out}}/$module.pdb")
    done < "{{loaded_out}}/modules.txt"

# Compile the layer -> build/legacy.pdb.
build: _depCheck_base-pdbs
    @{{header}} 'build'
    mkdir -p {{legacy_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --source {{legacy_root}}/code \
        --output-dir {{legacy_out}} {{err_filter}}

build-all: build

# Compile with tests -> build/legacy.pdb + build/legacy-tests.pdb.
build-tests: _depCheck_base-pdbs
    @{{header}} 'build-tests'
    mkdir -p {{legacy_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --source {{legacy_root}}/code \
        --output-dir {{legacy_out}} \
        --tests split {{err_filter}}

# The tools' own tests (the grammar preprocessor).
test-tools:
    @{{header}} 'test-tools'
    node --test {{legacy_root}}/tools/*.test.mjs

# Run the tools' tests, then the layer's <<test.Test>> functions (meta::pure::bridge::tests) on the
# bootstrap runtime.
test-all: test-tools test-loader build-tests
    @{{header}} 'test-all'
    mkdir -p {{test_results}}/spec/legacy/unit
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{legacy_out}}/legacy.pdb \
        --pdb {{legacy_out}}/legacy-tests.pdb \
        --function "platform::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::bridge::tests" "{{test_results}}/spec/legacy/unit/pure@cli-bootstrap.json" {{err_filter}}

clean:
    rm -rf {{legacy_out}}

_depCheck_base-pdbs:
    test -f {{shared_out}}/core.pdb || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/core-tests.pdb || (echo "ERROR: missing {{shared_out}}/core-tests.pdb (run \`just bootstrap::build\` first)" && exit 1)
