# pure/extensions/legacy/Justfile — the legend-pure compatibility layer: legend-pure's metamodel and
# functions over next's, so legacy Pure code (legend-engine's) compiles and runs on next.
#
# Direct invocation: just <recipe>     (from pure/extensions/legacy/)
#
# What needs the pinned legend-pure and legend-engine sources: fetch them, generate from them, load them through
# the bridge, and run what was loaded and the use cases. The layer itself (legacy.pdb, the loader) is built and tested
# by Bazel (//pure/extensions/legacy/..., suites unit and loader); these recipes build what they use with Bazel
# (`_bazel`) and read it from its output tree.
#
# code/m3/m3.pure is GENERATED (`generate`) from legend-pure's m3.pure (fetched from the pinned
# legend-pure-m3-core jar), next's shared/specification/m3.pure and tools/m3-mapping.json. It is
# committed, so building needs neither the jar nor node. Hand-written legacy property bodies live in
# code/m3/overrides.pure.

set quiet := true
set shell := ["bash", "-c"]

legacy_root    := source_directory()
repo_root      := legacy_root / ".." / ".." / ".."
test_results   := repo_root / "test-results"
legacy_out     := legacy_root / "build"
# Bazel's output tree, and what these recipes use from it (built by `_bazel`).
bazel_bin      := `bazel info bazel-bin 2>/dev/null`
shared_out     := bazel_bin / "shared"
pure_bootstrap := bazel_bin / "bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli/pure-bootstrap"
pure_truffle   := bazel_bin / "platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-interfaces/legend-pure-next-platform-truffle-cli/pure-truffle"
tds_pdb        := bazel_bin / "pure/extensions/pure/tds/build/tds.pdb"
legacy_pdb     := bazel_bin / "pure/extensions/legacy/build/legacy.pdb"
loader_pdb     := bazel_bin / "pure/extensions/legacy/loader/build/legacy_loader.pdb"
m3_protocol    := bazel_bin / "bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-generators/generated-specification/protocol/m3_protocol.pure"
err_filter     := "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)"
# The legend-engine release whose Pure the bridge compiles (its function modules, then its core), and the
# legend-pure release it builds on: legend.pure.version in that release's pom.xml, which `_check-versions`
# reads back so the two cannot drift apart. Both are fetched as published jars, never vendored.
legend_engine_version := "5.0.3"
legend_pure_version   := "5.110.0"
legend_pure_dir       := legacy_out / "legend-pure-" + legend_pure_version
legend_engine_dir     := legacy_out / "legend-engine-" + legend_engine_version
# legend-pure's modules beyond its platform that legend-engine's need (their own jars)
legend_pure_modules   := "legend-pure-m2-dsl-tds-pure legend-pure-m3-precisePrimitives legend-pure-m2-dsl-store-pure legend-pure-m2-dsl-mapping-pure legend-pure-m2-dsl-path-pure legend-pure-m2-dsl-graph-pure legend-pure-m2-dsl-diagram-pure legend-pure-m2-store-relational-pure"
legend_engine_modules := "legend-engine-pure-functions-json-pure legend-engine-pure-functions-unclassified-pure legend-engine-pure-functions-variant-pure legend-engine-pure-functions-relation-pure legend-engine-pure-functions-standard-pure legend-engine-pure-code-compiled-core"

header := "h(){ s=\"[extensions-legacy::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"

default: load

# What these recipes run and load, built by Bazel.
_bazel:
    cd {{repo_root}} && bazel build //:shared //pure/extensions/legacy:pdbs //pure/extensions/legacy/loader:pdbs //pure/extensions/pure/tds:pdbs \
        //bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli:pure-bootstrap \
        //platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-interfaces/legend-pure-next-platform-truffle-cli:pure-truffle \
        //bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-generators:m3_protocol_pure

# Regenerate code/m3/m3.pure (the legacy metamodel as wrappers over next's), from the m3.pure of the
# pinned legend-pure-m3-core jar, and by the loader natives/legacy_platform.pure (legend-pure's natives next
# lacks, as functions failing when called), natives/legacy_platform.adapters.pure (its functions taking
# legacy functions, overloaded for next's) and natives/legacy_platform.nextAdapters.pure (next's functions
# taking metamodel objects, overloaded for legacy's), all compiled with the loaded legacy_platform.
generate: _check-versions _fetch-legend-pure _fetch-legend-engine _bazel
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'generate'
    node {{legacy_root}}/tools/generate-m3.mjs {{legend_pure_version}} {{legend_pure_dir}}/platform/pure/grammar/m3.pure
    node {{legacy_root}}/tools/load.mjs {{legend_pure_dir}}/platform/pure {{legend_engine_dir}} {{loaded_out}} legacy_platform
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{loader_pdb}} \
        --function "meta::pure::bridge::loader::generateStubs_String_1__String_1__String_1__String_1__String_1__String_1__String_1_" \
        --args "{{loaded_out}}/plan.txt" legacy_platform "{{legacy_root}}/natives/legacy_platform.pure" "{{legacy_root}}/natives/legacy_platform.adapters.pure" "{{legacy_root}}/natives/legacy_platform.nextAdapters.pure" "legend-pure {{legend_pure_version}} platform" {{err_filter}}

# Fetch the pinned legend-pure and legend-engine Pure sources into build/.
fetch: _check-versions _fetch-legend-pure _fetch-legend-engine

# legend_pure_version is the legend-pure release legend_engine_version builds on.
_check-versions:
    #!/usr/bin/env bash
    set -euo pipefail
    pom="{{legend_engine_dir}}/legend-engine-{{legend_engine_version}}.pom"
    mkdir -p "{{legend_engine_dir}}"
    test -f "$pom" || curl -sfL -o "$pom" "https://repo1.maven.org/maven2/org/finos/legend/engine/legend-engine/{{legend_engine_version}}/legend-engine-{{legend_engine_version}}.pom"
    declared=$(sed -n 's:.*<legend.pure.version>\(.*\)</legend.pure.version>.*:\1:p' "$pom")
    if [[ "$declared" != "{{legend_pure_version}}" ]]; then
        echo "ERROR: legend-engine {{legend_engine_version}} builds on legend-pure $declared, but legend_pure_version is {{legend_pure_version}}" >&2
        exit 1
    fi

# legend-engine's Pure jars (legend_engine_modules) at legend_engine_version, from the local Maven repository,
# else Maven Central, each unpacked into build/legend-engine-<version>/<artifact>/ (its .pure and definition files).
_fetch-legend-engine:
    #!/usr/bin/env bash
    set -euo pipefail
    for artifact in {{legend_engine_modules}}; do
        dir="{{legend_engine_dir}}/$artifact"
        test -d "$dir" && continue
        jar="$HOME/.m2/repository/org/finos/legend/engine/$artifact/{{legend_engine_version}}/$artifact-{{legend_engine_version}}.jar"
        if [[ ! -f "$jar" ]]; then
            jar="{{legend_engine_dir}}/$artifact-{{legend_engine_version}}.jar"
            curl -sfL -o "$jar" "https://repo1.maven.org/maven2/org/finos/legend/engine/$artifact/{{legend_engine_version}}/$artifact-{{legend_engine_version}}.jar"
        fi
        mkdir -p "$dir.part"
        # unzip exits 11 when a pattern matches nothing: a jar may hold no definition file
        rc=0; unzip -q -o "$jar" '*.pure' '*.definition.json' -d "$dir.part" || rc=$?
        if [[ $rc -ne 0 && $rc -ne 11 ]]; then echo "ERROR: unzip $jar failed ($rc)" >&2; exit 1; fi
        mv "$dir.part" "$dir"
        echo "  $artifact: $(find "$dir" -name '*.pure' | wc -l | tr -d ' ') Pure files"
    done

# legend-pure-m3-core <version> (its platform) and legend_pure_modules, from the local Maven repository, else
# Maven Central, unpacked into build/legend-pure-<version>/.
_fetch-legend-pure:
    #!/usr/bin/env bash
    set -euo pipefail
    jar="$HOME/.m2/repository/org/finos/legend/pure/legend-pure-m3-core/{{legend_pure_version}}/legend-pure-m3-core-{{legend_pure_version}}.jar"
    mkdir -p "{{legend_pure_dir}}"
    if [[ -f "{{legend_pure_dir}}/platform/pure/essential/meta/reflect/deactivate.pure" ]]; then
        :
    elif [[ ! -f "$jar" ]]; then
        jar="{{legend_pure_dir}}/legend-pure-m3-core-{{legend_pure_version}}.jar"
        curl -sfL -o "$jar" "https://repo1.maven.org/maven2/org/finos/legend/pure/legend-pure-m3-core/{{legend_pure_version}}/legend-pure-m3-core-{{legend_pure_version}}.jar"
        unzip -q -o "$jar" 'platform/pure/*' -d "{{legend_pure_dir}}"
    else
        unzip -q -o "$jar" 'platform/pure/*' -d "{{legend_pure_dir}}"
    fi
    # its modules beyond the platform, each unpacked into build/legend-pure-<version>/modules/<artifact>/
    for artifact in {{legend_pure_modules}}; do
        dir="{{legend_pure_dir}}/modules/$artifact"
        test -d "$dir" && continue
        jar="$HOME/.m2/repository/org/finos/legend/pure/$artifact/{{legend_pure_version}}/$artifact-{{legend_pure_version}}.jar"
        if [[ ! -f "$jar" ]]; then
            mkdir -p "{{legend_pure_dir}}/modules"
            jar="{{legend_pure_dir}}/modules/$artifact-{{legend_pure_version}}.jar"
            curl -sfL -o "$jar" "https://repo1.maven.org/maven2/org/finos/legend/pure/$artifact/{{legend_pure_version}}/$artifact-{{legend_pure_version}}.jar"
        fi
        mkdir -p "$dir.part"
        rc=0; unzip -q -o "$jar" '*.pure' '*.definition.json' -d "$dir.part" || rc=$?
        if [[ $rc -ne 0 && $rc -ne 11 ]]; then echo "ERROR: unzip $jar failed ($rc)" >&2; exit 1; fi
        mv "$dir.part" "$dir"
    done

# The legacy modules to load: legend-pure's platform and legend-engine's, by the names their definition
# files give them (with what they depend on).
load_modules := "legacy_platform core_functions_unclassified core_functions_variant core_functions_relation core_functions_standard platform_dsl_store platform_dsl_mapping platform_dsl_path platform_dsl_graph platform_dsl_diagram platform_store_relational"
loaded_out   := legacy_out / "loaded"

# Regenerate loader/code/rewrite.pure (the copy of a parsed source with its references rewritten), from
# next's protocol model.
generate-loader: _bazel
    @{{header}} 'generate-loader'
    node {{legacy_root}}/tools/generate-protocol-rewrite.mjs {{m3_protocol}}

# Load legacy sources into build/loaded/<module>/: staged (tools/load.mjs), then parsed by next's parser and
# placed on top of the bridge (the loader). Each is then compiled in order, on top of core.pdb, legacy.pdb
# and the modules before it -> build/loaded/<module>.pdb.
load: fetch _bazel
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'load'
    node {{legacy_root}}/tools/load.mjs {{legend_pure_dir}}/platform/pure {{legend_engine_dir}} {{loaded_out}} {{load_modules}}
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{loader_pdb}} \
        --function "meta::pure::bridge::loader::load_String_1__String_1_" \
        --args "{{loaded_out}}/plan.txt" {{err_filter}}
    # A module with islands (#TDS … #) is compiled by compiler-pure on Truffle: they need next's TDS extension,
    # whose handler is Pure (tds.pdb, on compiler.pdb). The others by the bootstrap compiler, much faster.
    # Each with its tests split out (<module>-tests.pdb), on next's and its dependencies' tests: test-loaded runs them.
    bases=(--base-pdb "{{shared_out}}/core.pdb" --base-pdb "{{shared_out}}/core-tests.pdb" --base-pdb "{{shared_out}}/parser-mappings.pdb" --base-pdb "{{shared_out}}/compiler.pdb" --base-pdb "{{tds_pdb}}" --base-pdb "{{legacy_pdb}}")
    while read -r module _; do
        if grep -rqE '#TDS' "{{loaded_out}}/$module/code"; then compiler="{{pure_truffle}}"; else compiler="{{pure_bootstrap}}"; fi
        echo "  compiling $module ($(basename "$compiler"))"
        "$compiler" compile "${bases[@]}" --source "{{loaded_out}}/$module" --output-dir "{{loaded_out}}" --tests split {{err_filter}}
        bases+=(--base-pdb "{{loaded_out}}/$module.pdb" --base-pdb "{{loaded_out}}/$module-tests.pdb")
    done < "{{loaded_out}}/modules.txt"

# The use cases (tests/usecases/): legacy Pure navigating the metamodel while it executes, staged after
# legacy_platform as legend-engine's modules are, and placed by the loader. What the loader makes of each is
# checked against tests/usecases/expected/<module>/ (update-usecases rewrites it); then each is compiled with its
# tests and run -> test-results/spec/legacy/usecases/<module>.json. A module that doesn't compile is reported
# and the next run.
usecase_modules  := "legacy_usecases_reflection legacy_usecases_functionValues"
usecases_out     := legacy_out / "usecases"
usecases_expected := legacy_root / "tests" / "usecases" / "expected"

_load-usecases: fetch _bazel
    #!/usr/bin/env bash
    set -euo pipefail
    node {{legacy_root}}/tools/load.mjs {{legend_pure_dir}}/platform/pure {{legacy_root}}/tests {{usecases_out}} legacy_platform {{usecase_modules}}
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{loader_pdb}} \
        --function "meta::pure::bridge::loader::load_String_1__String_1_" \
        --args "{{usecases_out}}/plan.txt" > "{{usecases_out}}/loader.log" {{err_filter}}

# Rewrite tests/usecases/expected/ from what the loader makes of the use cases now.
update-usecases: _load-usecases
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'update-usecases'
    for module in {{usecase_modules}}; do
        mkdir -p "{{usecases_expected}}/$module"
        rsync -a --delete "{{usecases_out}}/$module/code/" "{{usecases_expected}}/$module/"
        echo "  $module: $(ls "{{usecases_expected}}/$module" | wc -l | tr -d ' ') file(s)"
    done

test-usecases: _load-usecases
    #!/usr/bin/env bash
    set -uo pipefail
    {{header}} 'test-usecases'
    failed=0
    for module in {{usecase_modules}}; do
        if diff -ru "{{usecases_expected}}/$module" "{{usecases_out}}/$module/code"; then
            echo "  $module: placed as expected"
        else
            echo "  $module: placed differently from tests/usecases/expected/$module (just extensions::legacy::update-usecases)"; failed=1
        fi
    done
    mkdir -p {{test_results}}/spec/legacy/usecases
    bases=(--base-pdb "{{shared_out}}/core.pdb" --base-pdb "{{shared_out}}/parser-mappings.pdb" --base-pdb "{{shared_out}}/compiler.pdb" --base-pdb "{{tds_pdb}}" --base-pdb "{{legacy_pdb}}")
    pdbs=(--pdb "{{shared_out}}/core.pdb" --pdb "{{shared_out}}/core-tests.pdb" --pdb "{{shared_out}}/parser-mappings.pdb" --pdb "{{shared_out}}/compiler.pdb" --pdb "{{tds_pdb}}" --pdb "{{legacy_pdb}}")
    while read -r module _; do
        echo "  compiling $module"
        if [[ " {{usecase_modules}} " == *" $module "* ]]; then
            if ! {{pure_bootstrap}} compile "${bases[@]}" --source "{{usecases_out}}/$module" --output-dir "{{usecases_out}}" --tests with {{err_filter}}; then
                failed=1; continue
            fi
            pdb="{{usecases_out}}/$module-with-tests.pdb"
            {{pure_bootstrap}} execute "${pdbs[@]}" --pdb "$pdb" \
                --function "platform::pure::test::runTests_String_1__String_1__String_1_" \
                --args "usecases" "{{test_results}}/spec/legacy/usecases/$module.json" {{err_filter}} || failed=1
            pdbs+=(--pdb "$pdb"); bases+=(--base-pdb "$pdb")
        else
            {{pure_bootstrap}} compile "${bases[@]}" --source "{{usecases_out}}/$module" --output-dir "{{usecases_out}}" {{err_filter}} || exit 1
            pdbs+=(--pdb "{{usecases_out}}/$module.pdb"); bases+=(--base-pdb "{{usecases_out}}/$module.pdb")
        fi
    done < "{{usecases_out}}/modules.txt"
    exit $failed

# The use cases on legend-pure itself (tools/legacy-pure-runner, over legend-pure's interpreter, pinned): their
# expected values are legacy's answers, so they must pass there as they are.
legacy_runner_out := legacy_out / "legacy-pure-runner"

test-usecases-on-legacy: _check-versions
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'test-usecases-on-legacy'
    out="{{legacy_runner_out}}"
    mkdir -p "$out/lib" "$out/classes" "$out/source"
    if [[ ! -f "$out/lib/legend-pure-runtime-java-engine-interpreted-{{legend_pure_version}}.jar" ]]; then
        sed 's/5\.110\.0/{{legend_pure_version}}/g' {{legacy_root}}/tools/legacy-pure-runner/pom.xml > "$out/pom.xml"
        (cd "$out" && mvn -q dependency:copy-dependencies -DoutputDirectory="$out/lib")
    fi
    cp_="$(ls "$out"/lib/*.jar | tr '\n' ':')$out/classes"
    javac -d "$out/classes" -cp "$cp_" {{legacy_root}}/tools/legacy-pure-runner/src/RunLegacy.java
    rm -rf "{{legacy_runner_out}}/source" && mkdir -p "{{legacy_runner_out}}/source"
    find {{legacy_root}}/tests/usecases -path '*/expected' -prune -o -name '*.pure' -print | xargs -I{} cp {} "$out/source/"
    ids=$(grep -ohE '^function <<test.Test>> [a-zA-Z_:]+' "$out"/source/*.pure | sed 's/.* //; s/$/__Boolean_1_/' | tr '\n' ' ')
    java -cp "$cp_" RunLegacy "$out/source" usecases $ids | tee "$out/results.txt"
    ! grep -q ' !! \| => false' "$out/results.txt"

# Run the loaded modules' own tests (load first): their <<test.Test>> and <<PCT.test>> functions, on Truffle (whose
# runtime evaluates #TDS islands, as the TDS extension's tests do) -> test-results/spec/legacy/loaded/{tests,pct}.json.
test-loaded: _bazel
    #!/usr/bin/env bash
    set -uo pipefail
    {{header}} 'test-loaded'
    mkdir -p {{test_results}}/spec/legacy/loaded
    pdbs=(--pdb "{{shared_out}}/core.pdb" --pdb "{{shared_out}}/core-tests.pdb" --pdb "{{shared_out}}/parser-mappings.pdb" --pdb "{{shared_out}}/compiler.pdb" --pdb "{{tds_pdb}}" --pdb "{{legacy_pdb}}")
    while read -r module _; do
        pdbs+=(--pdb "{{loaded_out}}/$module.pdb" --pdb "{{loaded_out}}/$module-tests.pdb")
    done < "{{loaded_out}}/modules.txt"
    failed=0
    echo "  <<test.Test>>"
    {{pure_truffle}} execute "${pdbs[@]}" --function "platform::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta" "{{test_results}}/spec/legacy/loaded/tests.json" {{err_filter}} || failed=1
    echo "  <<PCT.test>>"
    {{pure_truffle}} execute "${pdbs[@]}" --function "platform::pure::test::runPCTTests_String_1__String_1__String_1_" \
        --args "meta" "{{test_results}}/spec/legacy/loaded/pct.json" {{err_filter}} || failed=1
    exit $failed

clean:
    rm -rf {{legacy_out}}
