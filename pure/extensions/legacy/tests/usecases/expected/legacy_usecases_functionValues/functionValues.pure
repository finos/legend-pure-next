function usecases::functionValues::writers(): meta::pure::metamodel::function::Function<Any>[*]
{
  [usecases::reflection::toJson_Any_1__String_1_, usecases::reflection::objectToJson_Any_1__String_1_]->map(x: Any[1]|meta::pure::bridge::m3::adapt($x))->cast(@meta::pure::metamodel::function::Function<Any>)
}

function <<test.Test>> usecases::functionValues::testFunctionReferences(): Boolean[1]
{
  assertEquals(['toJson', 'objectToJson'], usecases::functionValues::writers()->map(f|$f->cast(@meta::pure::metamodel::function::ConcreteFunctionDefinition<Any>).functionName->toOne()));
  assertEquals('"x"', usecases::functionValues::writers()->at(0)->cast(@platform::pure::metamodel::function::Function<{Any[1]->String[1]}>)->eval('x'));
}

function usecases::functionValues::firstStep(f: meta::pure::metamodel::function::FunctionDefinition<Any>[1]): meta::pure::metamodel::valuespecification::SimpleFunctionExpression[1]
{
  meta::pure::bridge::m3::adapt($f.expressionSequence->evaluateAndDeactivate()->toOne()->cast(@meta::pure::metamodel::valuespecification::SimpleFunctionExpression))->cast(@meta::pure::metamodel::valuespecification::SimpleFunctionExpression)
}

function <<test.Test>> usecases::functionValues::testALambdaAsAPlainFunctionDefinition(): Boolean[1]
{
  let call = meta::pure::bridge::m3::adapt(p: usecases::reflection::Person[1]|$p.firstName->toUpper())->cast(@meta::pure::metamodel::function::FunctionDefinition<Any>)->usecases::functionValues::firstStep();
  assertEquals('toUpper', $call.functionName);
}

function usecases::functionValues::all<T>(xs: T[*]): T[*]
{
  $xs
}

function usecases::functionValues::generics(): meta::pure::metamodel::function::Function<Any>[*]
{
  usecases::functionValues::all_T_MANY__T_MANY_->map(x: Any[1]|meta::pure::bridge::m3::adapt($x))->cast(@meta::pure::metamodel::function::Function<Any>)
}

function <<test.Test>> usecases::functionValues::testAGenericFunctionReference(): Boolean[1]
{
  assertEquals(['all'], usecases::functionValues::generics()->map(f|$f->cast(@meta::pure::metamodel::function::ConcreteFunctionDefinition<Any>).functionName->toOne()))
}
