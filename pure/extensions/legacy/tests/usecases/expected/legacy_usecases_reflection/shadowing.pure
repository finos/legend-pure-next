Class usecases::reflection::datatype::Integer
{
  size: String[1];

}

Class usecases::reflection::datatype::Column
{
  name: String[1];
  type: usecases::reflection::datatype::Integer[1];

}

function usecases::reflection::twice(i: platform::pure::metamodel::type::primitives::Integer[1]): platform::pure::metamodel::type::primitives::Integer[1]
{
  $i * 2
}

function <<test.Test>> usecases::reflection::testAPrimitiveNameIsThePrimitive(): Boolean[1]
{
  assertEquals(4, usecases::reflection::twice(2));
  assertEquals('Integer', usecases::reflection::twice(2)->meta::pure::functions::meta::type()->meta::pure::functions::string::toString());
  assertEquals('8', ^usecases::reflection::datatype::Column(name='c', type=^usecases::reflection::datatype::Integer(size='8')).type.size);
}
