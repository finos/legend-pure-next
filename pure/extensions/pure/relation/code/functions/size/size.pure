import platform::pure::metamodel::relation::*;
import platform::pure::functions::relation::*;
import platform::pure::test::pct::*;

// The number of rows in a relation: rows, not distinct values, whatever the columns — an empty relation
// gives 0, not nothing. Each platform implements it (the relation extension's natives).
native function <<PCT.function>> platform::pure::functions::relation::size<T>(rel:Relation<T>[1]):Integer[1];

function <<PCT.test>> platform::pure::functions::relation::tests::size::testSimpleSize<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                   val, str
                   1, a
                   3, ewe
                   4, qw
                 #->size();
              };

    let res =  $f->eval($expr)->toOne();

    assertEquals(3, $res);
}

function <<PCT.test>> platform::pure::functions::relation::tests::size::testSimpleSize_MultipleExpressions<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                let t = #TDS
                   val, str
                   1, a
                   3, ewe
                   4, qw
                 #;
                 $t->size();
              };

    let res =  $f->eval($expr)->toOne();

    assertEquals(3, $res);
}
