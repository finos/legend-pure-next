# The TDS extension: its FlatBuffer fragment, which the Truffle extension packages.

load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//tools/bazel:pure.bzl", "pure_extension_generated", "pure_module")

pure_extension_generated(
    name = "tds",
    ids = "tds-fbs-field-ids.txt",
    metamodel = "code/metamodel/metamodel.pure",
    metamodel_package = "platform::extensions::pure::tds::metamodel",
    writer_package = "platform::extensions::pure::tds::pdb::gen",
)

exports_files(
    [
        "language_tds.json",
        "tds-fbs-field-ids.txt",
    ],
    visibility = ["//visibility:public"],
)

pure_module(
    name = "tds",
    srcs = glob(["code/**/*.pure", "module.json"]),
    base_pdbs = ["//pure/specification:core-tests.pdb", "//pure/specification:compiler-tests.pdb"],
    bootstrap_base_pdbs = ["//pure/specification:core.pdb", "//pure/specification:compiler.pdb", "//pure/specification:core-tests.pdb", "//pure/specification:compiler-tests.pdb", "//pure/specification:core_metamodel_pdb_writer.pdb"],
    generated = {":generated/writer.pure": "generated/writer.pure"},
    sources = ["code", "generated"],
)

# The fixtures its suites read.
filegroup(
    name = "test_data",
    srcs = glob(["tests/**"]),
    visibility = ["//visibility:public"],
)

# The fixtures, in the output tree: the JavaScript platform tests read them by their path relative to their own.
copy_to_bin(
    name = "test_data_in_bin",
    srcs = [":test_data"],
    visibility = ["//visibility:public"],
)
