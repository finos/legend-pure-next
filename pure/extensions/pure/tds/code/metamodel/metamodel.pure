// A TDS literal, `#TDS{…}#`: a table written inline — a column specification, then CSV. The value IS the
// relation: an island value (a ValueSpecification of this extension) that evaluates to itself, typed
// TDS<(column:Type[m], …)>. The column types live in that relation type; `csv` keeps the text — the column
// names, then the rows as written — as legend-pure and Legend Engine keep it.
Class platform::extensions::pure::tds::metamodel::TDS<T>
   extends platform::pure::metamodel::relation::Relation<T>, platform::pure::metamodel::valuespecification::ValueSpecification
{
   csv : String[1];
}
