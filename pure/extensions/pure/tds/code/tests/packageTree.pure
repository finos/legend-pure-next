// The TDS tests are found by walking the package tree from `platform`, which core owns: the extension's PDB
// lists its `platform::extensions` there, and the host merges that at every depth.
function <<platform::pure::profiles::test.Test>> platform::extensions::pure::tds::tests::testTheTdsTestsAreReachableFromTheRoot(): Boolean[1]
{
   assert(platform::pure::test::reachableFromItsRoot(platform::pure::functions::meta::pathToElement('platform::extensions::pure::tds::tests::testTheTdsTestsAreReachableFromTheRoot__Boolean_1_')));
}
