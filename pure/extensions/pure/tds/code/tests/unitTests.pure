// The TDS value is written to a PDB by the writer generated from its metamodel: beside the class, the
// blob writer the archive writer finds by name (see writeExtensionValue).
function <<platform::pure::profiles::test.Test>> platform::extensions::pure::tds::tests::testTheTdsHasABlobWriter(): Boolean[1]
{
   assert(platform::pure::functions::meta::pathToElement('platform::extensions::pure::tds::metamodel::TDS_pdbValueBlob_Any_1__Binary_1_')->isNotEmpty());
}

// A function holding a TDS, compiled at run time by compileSource — which compiles with the runtime's
// languages, so with the TDS island handler (Truffle, the Java platform and JavaScript; bootstrap has no
// languages) — and evaluated.
function <<platform::pure::profiles::test.TestDependency>> platform::extensions::pure::tds::tests::evaluateTds(source: String[1]): platform::extensions::pure::tds::metamodel::TDS<Any>[1]
{
   let result = platform::pure::functions::meta::compileSource('tdsEval', $source, ['core', 'compiler', 'tds']);
   assert($result.errors->isEmpty(), | $result.errors->joinStrings('\n'));
   $result.elements->filter(e | $e->instanceOf(platform::pure::metamodel::function::PackageableFunction))
      ->cast(@platform::pure::metamodel::function::PackageableFunction<Any>)->toOne()->evaluate([])
      ->toOne()->cast(@platform::extensions::pure::tds::metamodel::TDS<Any>);
}

function <<platform::pure::profiles::test.Test>> platform::extensions::pure::tds::tests::testATdsEvaluatesToTheRelationItIs(): Boolean[1]
{
   let tds = platform::extensions::pure::tds::tests::evaluateTds('function cs::tds::table():Any[1] { #TDS{\n a:Integer[1], b\n 1, x\n}# }');
   assert($tds->instanceOf(platform::pure::metamodel::relation::Relation));
   assertEquals('a, b\n 1, x\n', $tds.csv);
}

function <<platform::pure::profiles::test.Test>> platform::extensions::pure::tds::tests::testATdsCarriesItsColumnTypes(): Boolean[1]
{
   let tds = platform::extensions::pure::tds::tests::evaluateTds('function cs::tds::types():Any[1] { #TDS{\n a:Integer[1], b, c\n 1, x, 2.5\n}# }');
   let columns = platform::extensions::pure::tds::compiler::columnsOf($tds.genericType);
   assertEquals(['a', 'b', 'c'], $columns.name);
   assertEquals(['Integer', 'String', 'Float'], $columns->map(c | platform::extensions::pure::tds::compiler::typeName(platform::extensions::pure::tds::compiler::typePath($c.genericType))));
}

// CRLF line endings read as LF: the rows are the same, and `csv` keeps no carriage return.
function <<platform::pure::profiles::test.Test>> platform::extensions::pure::tds::tests::testATdsWithCrlfLineEndingsReadsAsLf(): Boolean[1]
{
   let tds = platform::extensions::pure::tds::tests::evaluateTds('function cs::tds::crlf():Any[1] { #TDS{\r\n a, b\r\n 1, x\r\n}# }');
   assertEquals('a, b\n 1, x\n', $tds.csv);
}
