import platform::pure::metamodel::valuespecification::*;
import platform::pure::metamodel::type::*;
import platform::pure::metamodel::type::generics::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::structural::packageableFunctionCompiler::*;
import platform::pure::compiler::structural::functionTypeCompiler::*;
import platform::pure::compiler::*;

function platform::pure::compiler::structural::packageableFunctionCompiler::compileTypeParameters(typeParameters:platform::pure::protocol::grammar::type::generics::TypeParameter[*]):TypeParameter[*]
{
    $typeParameters->map(tp | buildTypeParameter($tp.name, false));
}

function platform::pure::compiler::structural::packageableFunctionCompiler::compileFunctionClassifierGenericType(functionMetaType:Type[1], parameters:VariableExpression[*], returnGenericType:GenericType[1], returnMultiplicity:Multiplicity[1]):UserDefinedGenericType[1]
{
    let funcType = compileFunctionType($parameters, $returnGenericType, $returnMultiplicity);
    ^UserDefinedGenericType(type = $functionMetaType, typeArguments = [^UserDefinedGenericType(type = $funcType)]);
}

function platform::pure::compiler::structural::packageableFunctionCompiler::validateDuplicateParameters(parameters:platform::pure::protocol::grammar::valuespecification::VariableExpression[*], context:CompilerContext[1], ownerCtx:String[1], siCtx:String[1]):CompilerContext[1]
{
    let dupNames = $parameters->map(p | $p.name)->filter(n | $parameters->filter(p | $p.name == $n)->size() > 1)->removeDuplicates();
    $dupNames->fold({d, c |
        ^$c(errors += 'Duplicate parameter name \'' + $d + '\' in ' + $ownerCtx + $siCtx);
    }, $context);
}

function platform::pure::compiler::structural::packageableFunctionCompiler::fullPath(fn:platform::pure::protocol::grammar::function::PackageableFunction[1]):String[1]
{
    let packagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().value);
    if($packagePath == '', | $fn.name, | $packagePath + '::' + $fn.name);
}
