import platform::pure::metamodel::valuespecification::*;
import platform::pure::compiler::resolution::valueSpecification::functionExpressionResolver::*;
import platform::pure::compiler::resolution::valueSpecification::collectionResolver::*;
import platform::pure::compiler::resolution::valueSpecification::variableExpressionResolver::*;
import platform::pure::compiler::resolution::valueSpecification::atomicValueResolver::*;
import platform::pure::compiler::resolution::valueSpecification::genericTypeAndMultiplicityHolderResolver::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::helper::multiplicity::*;
import platform::pure::compiler::*;

function platform::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::resolveValueSpecification(vs:ValueSpecification[1], scope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    debug($context, | 'VSR.resolve: ' + $vs->type()->toOne()->elementToPath()
        + if($vs->instanceOf(FunctionExpression), | ' fname=' + $vs->cast(@FunctionExpression).functionName->toOne(), | '')
        + ' gt=' + if($vs.genericType->isEmpty(), | '?', | printGenericType($vs.genericType->toOne()))
        + ' mul=' + if($vs.multiplicity->isEmpty(), | '?', | printMultiplicity($vs.multiplicity->toOne())));
    let deepCtx = $context->debugSpaceInc();
    let result = $vs->match([
        fi:FunctionExpression[1] |
            resolveFunctionExpression($fi, $scope, $deepCtx),
        col:Collection[1] |
            resolveCollection($col, $scope, $deepCtx),
        ve:VariableExpression[1] |
            resolveVariableExpression($ve, $scope, $deepCtx),
        av:AtomicValue[1] |
            resolveAtomicValue($av, $scope, $deepCtx),
        gm:GenericTypeAndMultiplicityHolder[1] |
            resolveGenericTypeAndMultiplicityHolder($gm, $deepCtx),
        // A language extension's value (an island compiled to its own class): its handler resolves it, or
        // it is kept as it is — never dropped (a caller that gets no value loses the expression).
        v:ValueSpecification[1] |
            let h = platform::pure::compiler::extension::islandHandlerOwning($deepCtx, $v);
            if($h->isEmpty() || $h.resolve->isEmpty(),
               | ^CompilerResult<ValueSpecification>(value = $v, context = $deepCtx),
               | $h.resolve->toOne()->eval($v, $deepCtx));,
        a:Any[1] | ^CompilerResult<ValueSpecification>(context = $deepCtx)
    ]);
    // Restore debug space on returned context so sibling calls in folds stay at the right level
    let resultCtx = $result.context;
    let restoredCtx = ^$resultCtx(debugState = $context.debugState);
    ^CompilerResult<ValueSpecification>(value = $result.value, context = $restoredCtx);
}
