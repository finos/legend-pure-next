import platform::pure::metamodel::valuespecification::*;
import platform::pure::metamodel::type::generics::*;
import platform::pure::compiler::structural::sourceInformationCompiler::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::helper::multiplicity::*;
import platform::pure::compiler::*;

// Count the leading tilde sequence of a variable name. Returns N for names
// matching the pattern `~(.~){N-1}` (so `~` → 1, `~.~` → 2, `~.~.~` → 3, …);
// returns 0 for any name that isn't a parent reference. Matches Java
// {@code PureLanguageCompilerContext.parentReferenceTildeCount}.
function platform::pure::compiler::resolution::valueSpecification::variableExpressionResolver::parentReferenceTildeCount(name:String[1]):Integer[1]
{
    if(!$name->startsWith('~'),
        | 0,
        | let trailing = $name->substring(1);
          // After the leading `~`, every subsequent char-pair must be `.~`.
          let parts = $trailing->split('.~');
          // split('.~') on `~`     → ['']           → trailing is ''        → depth 1
          //         on `~.~`   → ['', '']           → trailing is '.~'      → depth 2
          //         on `~.~.~` → ['', '', '']       → trailing is '.~.~'    → depth 3
          // Anything else (a property suffix after a tilde without dot, or `.` alone)
          // disqualifies the name from being a pure parent reference.
          if($parts->forAll(p | $p == ''),
              | $parts->size(),
              | 0
          );
    );
}

// Mirrors Java VariableExpressionResolver.resolveVariableExpression
function platform::pure::compiler::resolution::valueSpecification::variableExpressionResolver::resolveVariableExpression(ve:VariableExpression[1], scope:VariableExpression[*], context:platform::pure::compiler::CompilerContext[1]):platform::pure::compiler::CompilerResult<ValueSpecification>[1]
{
    // If genericType is CompilerNotSetGenericType (= Java null / not set), look up in scope (like Java line 16-23)
    if($ve.genericType->toOne()->instanceOf(CompilerNotSetGenericType),
        | // Parent-reference variable: `~` is the enclosing `^X(...)`, `~.~` is
          // the one out, etc. Resolved against the construction-type stack
          // pushed by the new()/copy() handler before walking key expressions.
          let tildeDepth = platform::pure::compiler::resolution::valueSpecification::variableExpressionResolver::parentReferenceTildeCount($ve.name);
          if($tildeDepth > 0,
              | let stack = $context.constructionTypeStack;
                let stackSize = $stack->size();
                if($tildeDepth <= $stackSize,
                    | // Top of stack = innermost construction = depth 0. Push order
                      // appends, so index from the end.
                      let ctorGT = $stack->at($stackSize - $tildeDepth);
                      let updatedVE = ^$ve(
                          genericType = asInferredGenericType($ctorGT),
                          multiplicity = asInferredMultiplicity(PureOne)
                      );
                      ^platform::pure::compiler::CompilerResult<ValueSpecification>(value = $updatedVE, context = $context);,
                    | // Depth out of bounds
                      let siCtxOob = formatMetamodelSourceInfo($ve.sourceInformation, $context);
                      ^platform::pure::compiler::CompilerResult<ValueSpecification>(
                          value = $ve,
                          context = ^$context(errors += 'Parent reference \'' + $ve.name + '\' is out of bounds: only ' + $stackSize->toString() + ' enclosing `^X(...)` construction(s) are visible here.' + $siCtxOob)
                      );
                );,
              | // Not a parent reference — fall back to the regular scope lookup.
                let inScope = $scope->filter(s | $s.name == $ve.name);
                if($inScope->isNotEmpty(),
                    | // Found in scope — update genericType and multiplicity from the scope match
                      let match = $inScope->at($inScope->size() - 1);
                      let updatedVE = ^$ve(
                          genericType = asInferredGenericType($match.genericType->toOne()),
                          multiplicity = asInferredMultiplicity($match.multiplicity->toOne())
                      );
                      ^platform::pure::compiler::CompilerResult<ValueSpecification>(value = $updatedVE, context = $context);,
                    | // Not found — error
                      let siCtx = formatMetamodelSourceInfo($ve.sourceInformation, $context);
                      ^platform::pure::compiler::CompilerResult<ValueSpecification>(
                          value = $ve,
                          context = ^$context(errors += 'The variable \'' + $ve.name + '\' is unknown!' + $siCtx)
                      );
                );
          );,
        | // Already has a concrete type — return as-is
          ^platform::pure::compiler::CompilerResult<ValueSpecification>(value = $ve, context = $context)
    );
}
