import platform::pure::compiler::structural::propertyCompiler::*;
import platform::pure::compiler::structural::qualifiedPropertyCompiler::*;
import platform::pure::compiler::structural::annotationCompiler::*;
import platform::pure::compiler::structural::generalizationCompiler::*;
import platform::pure::compiler::structural::constraintCompiler::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::*;
import platform::pure::metamodel::type::*;
import platform::pure::metamodel::function::property::*;
import platform::pure::metamodel::extension::*;

function platform::pure::compiler::elements::compileClass(protocolClass:platform::pure::protocol::grammar::type::Class[1], context:CompilerContext[1]):CompilerResult<Class<Any>>[1]
{
    let packagePath = if($protocolClass.package->isEmpty(), | '', | $protocolClass.package->toOne().value);
    let className = if($packagePath == '', | $protocolClass.name, | $packagePath + '::' + $protocolClass.name);
    let skeleton = $context->resolveElement($className)->toOne()->cast(@Class<Any>);

    // Push sub-element caller path so references in each property's type
    // attribute to {@code Class.propName} in the reverse index. Mirrors Java
    // ClassHandler.secondPass withCallerSubElement wrapping.
    let propertyAccum = $protocolClass.properties->fold({p, acc |
        let result = $acc.context->withCallerSubElement($p.name, {ctx | $p->compileProperty($ctx, $packagePath, $skeleton)});
        ^$acc(values += $result.value, context = $result.context);
    }, ^CompilerListResult<Property<Nil, Any|*>>(context = $context));
    let compiledProperties = $propertyAccum.values;
    let ctx1 = $propertyAccum.context;

    let ownerCtx = 'class \'' + $className + '\'';

    let genAccum = compileGeneralizations($protocolClass.generalizations, $skeleton, $ctx1, $packagePath, $ownerCtx);
    let compiledGeneralizations = $genAccum.values;
    let ctx2 = $genAccum.context;

    let stereoAccum = $protocolClass.stereotypes->fold({s, acc |
                                compileStereotype($s, $acc, $ownerCtx);
                            }, ^CompilerListResult<Stereotype>(context = $ctx2));
    let compiledStereotypes = $stereoAccum.values;
    let ctx3 = $stereoAccum.context;

    let tvAccum = $protocolClass.taggedValues->fold({t, acc |
                                compileTaggedValue($t, $acc, $ownerCtx);
                            }, ^CompilerListResult<TaggedValue>(context = $ctx3));
    let compiledTaggedValues = $tvAccum.values;
    let ctx4 = $tvAccum.context;

    let typeVariables = if($protocolClass.typeVariables->isEmpty(), | [],
        | $protocolClass.typeVariables->map(tv |
            let genType = $tv.genericType->toOne()->cast(@platform::pure::protocol::grammar::type::generics::GenericTypeValue).type->toOne()->cast(@platform::pure::protocol::grammar::type::Type_Pointer).value;
            let mMult = $tv.multiplicity->toOne()->platform::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();
            ^platform::pure::metamodel::valuespecification::VariableExpression(
                name = $tv.name,
                // Cross-element ref into a type being compiled — wrap as pointer.
                genericType = platform::pure::compiler::helper::genericType::buildCanonicalOrUserDefinedGenericType($ctx4->resolveElement($genType)->toOne()->cast(@platform::pure::metamodel::type::Type)->platform::pure::compiler::helper::pointer::toTypePointer(), $ctx4),
                multiplicity = $mMult
            );
        )
    );

    let ownerGenericType = $skeleton.classifierGenericType->toOne()->genericTypeTypeArguments()->at(0);
    // The class's type parameters are in scope in its constraints, and only there (class/constraints/typeParameterCast).
    let constraintAccum = compileConstraints($protocolClass.constraints, $ownerGenericType, $typeVariables, ^$ctx4(ownerTypeParams = $skeleton.typeParameters->cast(@TypeParameter)));
    let compiledConstraints = $constraintAccum.values;
    let constraintCtx = $constraintAccum.context;
    let ctx5 = ^$constraintCtx(ownerTypeParams = $ctx4.ownerTypeParams);

    // Compile qualified properties — sub-element caller scope so refs inside
    // each QP's type attribute to {@code Class.qpName}.
    let qpAccum = $protocolClass.qualifiedProperties->fold({qp, acc |
        let result = $acc.context->withCallerSubElement($qp.name, {ctx | $qp->compileQualifiedProperty($ctx, $packagePath, $skeleton)});
        ^$acc(values += $result.value, context = $result.context);
    }, ^CompilerListResult<QualifiedProperty<Any>>(context = $ctx5));
    let compiledQPs = $qpAccum.values;
    let ctx6 = $qpAccum.context;

    ^CompilerResult<Class<Any>>(
        value = ^$skeleton(
            stereotypes = $compiledStereotypes,
            taggedValues = $compiledTaggedValues,
            typeVariables = $typeVariables,
            generalizations = $compiledGeneralizations->map(g | ^$g(specific = ~.~)),
            properties = $compiledProperties->map(p | ^$p(owner = ~.~)),
            qualifiedProperties = $compiledQPs->map(qp | ^$qp(owner = ~.~)),
            constraints = $compiledConstraints
        ),
        context = $ctx6
    );
}


