import platform::pure::metamodel::type::generics::*;
import platform::pure::functions::lang::*;
import platform::pure::compiler::helper::column::*;
import platform::pure::compiler::helper::type::*;
import platform::pure::compiler::helper::genericType::*;

// Column helpers

function platform::pure::compiler::helper::column::buildColumn(name:String[1], owner:GenericType[1], genericType:GenericType[1], multiplicity:Multiplicity[1], nameWildCard:Boolean[1]):Column[1]
{
    // `new(...)` so the platform's preferCanonicalAnchor picks the packageable
    // variant (GenericType_UserDefinedPackageableGenericType) for the GT-of-GT
    // classifier, matching Java direct compile output. Classifier type is a
    // literal `Column` so no pointer deref is needed.
    let cgtype = ^UserDefinedGenericType(
        type = Column,
        typeArguments = [$owner, $genericType],
        multiplicityArguments = [$multiplicity]
    );
    let col = new($cgtype)->cast(@Column);
    ^$col(
        name = $name,
        nameWildCard = $nameWildCard,
        genericType = $genericType,
        multiplicity = $multiplicity
    );
}

// Tests

function <<test.Test>> platform::pure::compiler::helper::column::tests::testBuildColumn():Boolean[1]
{
    let ownerGT = buildInferredGenericType(String);
    let valueGT = buildInferredGenericType(Integer);
    let col = buildColumn('age', $ownerGT, $valueGT, PureOne, false);

    assertEquals('age', $col.name);
    assertEquals(false, $col.nameWildCard);
    assertEquals($valueGT, $col.genericType);
    assertEquals(PureOne, $col.multiplicity);
    
    let cgt = $col.classifierGenericType->toOne();
    assertEquals(Column, $cgt->rawType()->toOne());
    
    let ta = $cgt->genericTypeTypeArguments();
    assertEquals(2, $ta->size());
    assertEquals($ownerGT, $ta->at(0));
    assertEquals($valueGT, $ta->at(1));
    
    let ma = $cgt->genericTypeMultiplicityArguments();
    assertEquals(1, $ma->size());
    assertEquals(PureOne, $ma->at(0));
}
