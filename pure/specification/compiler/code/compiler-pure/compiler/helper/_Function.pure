import platform::pure::metamodel::type::generics::*;
import platform::pure::compiler::helper::function::*;
import platform::pure::compiler::helper::type::*;
import platform::pure::compiler::helper::multiplicity::*;
import platform::pure::compiler::helper::lambda::*;
import platform::pure::compiler::helper::genericType::*;

// Function helpers

function platform::pure::compiler::helper::function::resolveFunctionType(genericType:GenericType[1], context:platform::pure::compiler::CompilerContext[1]):FunctionType[0..1]
{
    let res = $genericType->resolveForTarget(Function, $context);
    let rt = if($res->isNotEmpty(), | $res->toOne()->genericTypeTypeArguments(), | []);
    if($rt->isNotEmpty(),
       | $rt->at(0)->rawType()->toOne()->cast(@FunctionType),
       | []
    );
}

function platform::pure::compiler::helper::function::getFunctionType(func:Function<Any>[1], context:platform::pure::compiler::CompilerContext[1]):FunctionType[1]
{
    $func.classifierGenericType->toOne()->resolveFunctionType($context)->toOne()
}

function platform::pure::compiler::helper::function::validateFunctionParameters(params:VariableExpression[*]):Boolean[1]
{
    let allNames = $params.name;
    let duplicates = $allNames->filter(n | $allNames->filter(x | $x == $n)->size() > 1)->removeDuplicates();
    assert($duplicates->isEmpty(), | 'Duplicate parameter name(s): ' + $duplicates->joinStrings(', '));
    true;
}

// Tests

function <<test.Test>> platform::pure::compiler::helper::function::tests::testResolveFunctionType():Boolean[1]
{
    let ctx = platform::pure::compiler::newPlainCompilerContext();
    let lambda = {a:String[1]| $a + 'ok'};
    let cgt = $lambda->getLambdaClassifierGenericType();

    let ft = $cgt->resolveFunctionType($ctx)->toOne();

    assert($ft.parameters->isNotEmpty());
    assertEquals('a', $ft.parameters->at(0).name);
    assertEquals(String, $ft.parameters->at(0).genericType->toOne()->rawType()->toOne());
}

function <<test.Test>> platform::pure::compiler::helper::function::tests::testGetFunctionType():Boolean[1]
{
    let ctx = platform::pure::compiler::newPlainCompilerContext();
    let func = platform::pure::compiler::helper::function::tests::testResolveFunctionType__Boolean_1_;
    let ft = $func->getFunctionType($ctx);

    assertEquals(Boolean, $ft.returnType->toOne()->rawType()->toOne());
    assertEquals(1, $ft.returnMultiplicity->toOne()->multiplicityLowerBound());
}

function <<test.Test>> platform::pure::compiler::helper::function::tests::testValidateFunctionParameters():Boolean[1]
{
    let params = [
        ^VariableExpression(name='a', genericType=buildInferredGenericType(String), multiplicity=PureOne),
        ^VariableExpression(name='b', genericType=buildInferredGenericType(Integer), multiplicity=PureOne)
    ];
    assert(validateFunctionParameters($params));
}
