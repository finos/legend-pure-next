import platform::pure::metamodel::type::generics::*;
import platform::pure::metamodel::multiplicity::*;
import platform::pure::metamodel::type::*;
import platform::pure::compiler::helper::multiplicity::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::helper::type::*;
import platform::pure::compiler::helper::functionType::*;
import platform::pure::compiler::helper::parametersBinding::*;

// FunctionType printing

function platform::pure::compiler::helper::functionType::newFunctionType():FunctionType[1]
{
    ^FunctionType(
        returnType = buildInferredGenericType(Any),
        returnMultiplicity = PureOne
    );
}


function platform::pure::compiler::helper::functionType::printFunctionType(ft:FunctionType[1]):String[1]
{
    $ft->printFunctionType(true)
}

function platform::pure::compiler::helper::functionType::printFunctionType(ft:FunctionType[1], fullPath:Boolean[1]):String[1]
{
    let params = $ft.parameters;
    let paramStr = $params->map(p |
        let gt = $p.genericType;
        let mul = $p.multiplicity;
        if($gt->isEmpty(),
            | 'Unknown',
            | $gt->toOne()->printGenericType($fullPath) + $mul->toOne()->printMultiplicity()
        );
    )->joinStrings(', ');
    let returnStr = if($ft.returnType->isEmpty(),
        | '',
        | $ft.returnType->toOne()->printGenericType($fullPath)
    );
    let returnMul = if($ft.returnMultiplicity->isEmpty(),
        | '',
        | $ft.returnMultiplicity->toOne()->printMultiplicity()
    );
    '{' + $paramStr + '->' + $returnStr + $returnMul + '}';
}


// FunctionType concreteness

function platform::pure::compiler::helper::functionType::isConcreteFunctionType(ft:FunctionType[1]):Boolean[1]
{
    let paramsOk = $ft.parameters->filter(p | !$p.genericType->toOne()->isConcreteGenericType())->isEmpty();
    if([pair(| !$paramsOk, | false),
        pair(| $ft.returnType->isEmpty(), | true)],
       | $ft.returnType->toOne()->isConcreteGenericType()
    );
}


// FunctionType referenced parameter names

function platform::pure::compiler::helper::functionType::collectFunctionTypeReferencedTypeParameterNames(ft:FunctionType[1]):String[*]
{
    let paramNames = $ft.parameters
        ->filter(p | $p.genericType->isNotEmpty())
        ->map(p | $p.genericType->toOne()->collectReferencedTypeParameterNames());
    let returnNames = if($ft.returnType->isEmpty(),
        | [],
        | $ft.returnType->toOne()->collectReferencedTypeParameterNames()
    );
    $paramNames->concatenate($returnNames)->removeDuplicates();
}

function platform::pure::compiler::helper::functionType::collectFunctionTypeReferencedMultiplicityParameterNames(ft:FunctionType[1]):String[*]
{
    let paramNames = $ft.parameters->map(p |
        let mulNames = $p.multiplicity->match(
            [
                mp : MultiplicityParameter[1] | $mp.name,
                a  : Any[1]                   | []->cast(@String)
            ]
        );
        let gtNames = if($p.genericType->isEmpty(),
            | [],
            | $p.genericType->toOne()->collectReferencedMultiplicityParameterNames()
        );
        $mulNames->concatenate($gtNames);
    );
    let returnMulNames = if($ft.returnMultiplicity->isEmpty(),
        | [],
        | $ft.returnMultiplicity->toOne()->match(
            [
                mp : MultiplicityParameter[1] | $mp.name,
                a  : Any[1]                   | []->cast(@String)
            ]
          )
    );
    let returnGtNames = if($ft.returnType->isEmpty(),
        | [],
        | $ft.returnType->toOne()->collectReferencedMultiplicityParameterNames()
    );
    $paramNames->concatenate($returnMulNames)->concatenate($returnGtNames)->removeDuplicates();
}

function platform::pure::compiler::helper::functionType::collectTypeParameterBindings(paramFT:FunctionType[1], argFT:FunctionType[1], bindings:ParametersBinding[1]):ParametersBinding[1]
{
    // Match parameters positionally
    let b1 = if($paramFT.parameters->isNotEmpty() && $argFT.parameters->isNotEmpty(),
        | $paramFT.parameters->zip($argFT.parameters)->fold({pair, bb | 
              let p1 = collectTypeParameterBindings($pair.first.genericType, $pair.second.genericType, $bb);
              collectMultiplicityParameterBindings($pair.first.multiplicity, $pair.second.multiplicity, $p1);
          }, $bindings),
        | $bindings
    );
    // Match return types
    let b2 = if($paramFT.returnType->isNotEmpty() && $argFT.returnType->isNotEmpty(),
        | collectTypeParameterBindings($paramFT.returnType->toOne(), $argFT.returnType->toOne(), $b1),
        | $b1
    );
    
    // Match return multiplicities
    if($paramFT.returnMultiplicity->isNotEmpty() && $argFT.returnMultiplicity->isNotEmpty(),
        | collectMultiplicityParameterBindings($paramFT.returnMultiplicity->toOne(), $argFT.returnMultiplicity->toOne(), $b2),
        | $b2
    );
}

function platform::pure::compiler::helper::functionType::makeAsConcreteAsPossible(genericType:GenericType[1], ft:FunctionType[1], bindings:ParametersBinding[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[0..1]
{
    let newParams = $ft.parameters->map(p |
        let rGT = makeAsConcreteAsPossible($p.genericType, $bindings, $context);
        let rMul = makeAsConcreteAsPossible($p.multiplicity, $bindings);
        if($rGT == $p.genericType && $rMul == $p.multiplicity,
            | $p,
            | ^$p(genericType = $rGT, multiplicity = $rMul)
        );
    );
    let rRetGT = if($ft.returnType->isEmpty(), | [], | makeAsConcreteAsPossible($ft.returnType->toOne(), $bindings, $context));
    let rRetMul = if($ft.returnMultiplicity->isEmpty(), | [], | makeAsConcreteAsPossible($ft.returnMultiplicity->toOne(), $bindings));
    
    if($newParams == $ft.parameters && $rRetGT == $ft.returnType && $rRetMul == $ft.returnMultiplicity,
        | [],
        | let typeArgs = $genericType->match([gtv : GenericTypeValue[1] | $gtv.typeArguments, a : Any[1] | []]);
          let mulArgs = $genericType->match([gtv : GenericTypeValue[1] | $gtv.multiplicityArguments, a : Any[1] | []]);
          let resultBase = buildInferredGenericType(^$ft(parameters = $newParams, returnType = $rRetGT->toOne(), returnMultiplicity = $rRetMul->toOne()));
          ^$resultBase(
              typeArguments = $typeArgs,
              multiplicityArguments = $mulArgs
          );
    );
}

function platform::pure::compiler::helper::functionType::findCommonFunctionType(functionTypes:FunctionType[*], context:platform::pure::compiler::CompilerContext[1]):FunctionType[0..1]
{
    if([pair(| $functionTypes->isEmpty(), | []),
        pair(| $functionTypes->size() == 1, | $functionTypes->at(0))],
       | let paramCount = $functionTypes->at(0).parameters->size();
         let allSame = $functionTypes->forAll(ft | $ft.parameters->size() == $paramCount);
         if(!$allSame,
             | [],
             | findCommonFunctionType_build($functionTypes, $paramCount, $context)
         );
    );
}

function platform::pure::compiler::helper::functionType::findCommonFunctionType_build(functionTypes:FunctionType[*], paramCount:Integer[1], context:platform::pure::compiler::CompilerContext[1]):FunctionType[0..1]
{
    let commonParams = if($paramCount > 0,
        | range($paramCount)->map({i |
              let paramTypesAtPos = $functionTypes
                  ->filter(ft | $ft.parameters->at($i).genericType->isNotEmpty())
                  ->map(ft | $ft.parameters->at($i).genericType->toOne());
              let commonParamType = if($paramTypesAtPos->isNotEmpty(),
                  | findCommonGenericType($paramTypesAtPos, true, $context),
                  | []
              );
              let paramMulsAtPos = $functionTypes
                  ->filter(ft | $ft.parameters->at($i).multiplicity->isNotEmpty())
                  ->map(ft | $ft.parameters->at($i).multiplicity);
              let commonParamMul = if($paramMulsAtPos->isNotEmpty(),
                  | findCommonMultiplicity($paramMulsAtPos),
                  | []
              );
              let pName = $functionTypes->at(0).parameters->at($i).name;
              ^VariableExpression(
                  // Unnamed source params stay unnamed — signature-level
                  // VariableExpressions are never resolved by name, and the
                  // wire should reflect the source (no synthesized p<idx>).
                  name = if($pName->isEmpty(), | '', | $pName->toOne()),
                  genericType = $commonParamType->toOne(),
                  multiplicity = if($commonParamMul->isEmpty(), | PureOne, | $commonParamMul->toOne())
              );
          }),
        | []
    );

    let returnTypes = $functionTypes->filter(ft | $ft.returnType->isNotEmpty())->map(ft | $ft.returnType->toOne());
    let commonReturnType = if($returnTypes->isNotEmpty(),
        | findCommonGenericType($returnTypes, false, $context),
        | []
    );
    let returnMuls = $functionTypes->filter(ft | $ft.returnMultiplicity->isNotEmpty())->map(ft | $ft.returnMultiplicity->toOne());
    let commonReturnMul = if($returnMuls->isNotEmpty(),
        | findCommonMultiplicity($returnMuls),
        | []
    );

    ^FunctionType(
        parameters = $commonParams,
        returnType = if($commonReturnType->isEmpty(), | ^UndefinedGenericType(), | $commonReturnType->toOne()),
        returnMultiplicity = if($commonReturnMul->isEmpty(), | PureOne, | $commonReturnMul->toOne())
    );
}

function platform::pure::compiler::helper::functionType::isCompatibleFunctionType(declared:FunctionType[1], actual:FunctionType[1], contravariant:Boolean[1], context:platform::pure::compiler::CompilerContext[1]):Boolean[1]
{
    let declaredParamCount = $declared.parameters->size();
    let actualParamCount = $actual.parameters->size();
    if($declaredParamCount != $actualParamCount,
        | false,
        | let paramsOk = if($declaredParamCount > 0,
              | range($declaredParamCount)->forAll({i |
                    let dp = $declared.parameters->at($i);
                    let ap = $actual.parameters->at($i);
                    let typeOk = if($dp.genericType->isNotEmpty() && $ap.genericType->isNotEmpty(),
                        | isCompatibleGenericType($dp.genericType->toOne(), $ap.genericType->toOne(), !$contravariant, $context),
                        | true
                    );
                    let mulOk = isCompatibleMultiplicity($dp.multiplicity, $ap.multiplicity, !$contravariant);
                    $typeOk && $mulOk;
                }),
              | true
          );
          if(!$paramsOk,
              | false,
              | let returnTypeOk = if($declared.returnType->isNotEmpty() && $actual.returnType->isNotEmpty(),
                    | isCompatibleGenericType($declared.returnType->toOne(), $actual.returnType->toOne(), $contravariant, $context),
                    | true
                );
                let returnMulOk = if($declared.returnMultiplicity->isNotEmpty() && $actual.returnMultiplicity->isNotEmpty(),
                    | isCompatibleMultiplicity($declared.returnMultiplicity->toOne(), $actual.returnMultiplicity->toOne(), $contravariant),
                    | true
                );
                $returnTypeOk && $returnMulOk;
          );
    );
}

// Mirrors Java _FunctionType.reconcileInferred
function platform::pure::compiler::helper::functionType::reconcileInferredFT(expected:FunctionType[1], actual:FunctionType[1], context:platform::pure::compiler::CompilerContext[1]):FunctionType[1]
{
    let newParams = if($expected.parameters->size() == $actual.parameters->size(),
        | $expected.parameters->zip($actual.parameters)->map(p |
            let actualParam = $p.second;
            let apGT = $actualParam.genericType->toOne();
            let epGT = $p.first.genericType;
            // Java does NOT recurse reconcileInferred into parameter generic
            // types — it keeps the actual's GT by reference (or takes
            // asInferred(expected) when the actual is Inferred and compatible).
            // Recursing here plants RelationType reconcile-copies inside
            // FunctionType params where Java's graph keeps the original
            // (wire: inline RelationTypeDef where Java has the AncestorRef
            // self-cycle). Only the RETURN type gets the full reconcile.
            let rGT = if($apGT->instanceOf(platform::pure::metamodel::Inferred)
                          && $epGT->isNotEmpty()
                          && platform::pure::compiler::helper::genericType::isCompatibleGenericType($epGT->toOne(), $apGT, $context),
                | platform::pure::compiler::helper::genericType::asInferredGenericType($epGT->toOne()),
                | $apGT
            );
            let apMul = $actualParam.multiplicity->toOne();
            let rMul = if($apMul->instanceOf(platform::pure::metamodel::Inferred)
                           && $p.first.multiplicity->isNotEmpty()
                           && platform::pure::compiler::helper::multiplicity::multiplicitySubsumes($p.first.multiplicity->toOne(), $apMul),
                | platform::pure::compiler::helper::multiplicity::asInferredMultiplicity($p.first.multiplicity->toOne()),
                | $apMul
            );
            // Build a fresh VE without sourceInformation, mirroring Java _FunctionType.reconcileInferred
            // which constructs `new VariableExpressionImpl(model)._name(...)._genericType(...)._multiplicity(...)`
            // — Java never carries SI through reconciliation, so Pure must not either.
            ^VariableExpression(
                name = $actualParam.name->toOne(),
                genericType = $rGT,
                multiplicity = $rMul
            )->cast(@VariableExpression);
        ),
        | $actual.parameters
    );
    let newReturnType = if($expected.returnType->isNotEmpty() && $actual.returnType->isNotEmpty(),
        | platform::pure::compiler::helper::genericType::reconcileInferred($expected.returnType->toOne(), $actual.returnType->toOne(), $context),
        | $actual.returnType
    );
    ^$actual(parameters = $newParams, returnType = $newReturnType->toOne());
}

// Mirrors Java FunctionIndexEntry.compareFunctionTypes — compare two FunctionTypes by parameter specificity.
// Returns -1 if f1 is more specific, 1 if f2 is more specific, 0 if equal.
function platform::pure::compiler::helper::functionType::compareFunctionTypes(f1:FunctionType[1], f2:FunctionType[1], context:platform::pure::compiler::CompilerContext[1]):Integer[1]
{
    compareFunctionTypes($f1, $f2, [], $context);
}

// As compareFunctionTypes for a call whose arguments have the given multiplicities (Java's
// FunctionIndexEntry.compareFunctionTypes with arguments): against a concrete argument multiplicity, a
// parameter's is ranked as legend-pure ranks them — an exact match, then a multiplicity parameter, then a
// concrete one containing the argument's, the closest first; the universal [*] aside, a parameter beating it.
function platform::pure::compiler::helper::functionType::compareFunctionTypes(f1:FunctionType[1], f2:FunctionType[1], arguments:Multiplicity[*], context:platform::pure::compiler::CompilerContext[1]):Integer[1]
{
    let params1 = $f1.parameters->cast(@VariableExpression);
    let params2 = $f2.parameters->cast(@VariableExpression);
    let count = if($params1->size() < $params2->size(), | $params1->size(), | $params2->size());
    range(0, $count)->fold({i, cmp |
        if($cmp != 0, | $cmp,
            | // Deref the raw type ONCE if it's a Class_Pointer etc. so the
              // `.name` read below sees a concrete Class rather than a pointer
              // subclass (which has no `name` slot). Single registry lookup,
              // no tree walk.
              let t1 = $params1->at($i).genericType->toOne()->rawType()->derefTypeIfPointer($context);
              let t2 = $params2->at($i).genericType->toOne()->rawType()->derefTypeIfPointer($context);
              let t1IsTP = if($t1->isEmpty(), | false, | $t1->toOne()->instanceOf(TypeParameter));
              let t2IsTP = if($t2->isEmpty(), | false, | $t2->toOne()->instanceOf(TypeParameter));
              let typeCmp = if([
                  pair(| $t1IsTP && !$t2IsTP && $t2->isNotEmpty(), | if(platform::pure::compiler::helper::type::isTopType($t2->toOne()), | -1, | 1)),
                  pair(| !$t1IsTP && $t1->isNotEmpty() && $t2IsTP, | if(platform::pure::compiler::helper::type::isTopType($t1->toOne()), | 1, | -1)),
                  pair(| !$t1IsTP && $t1->isNotEmpty() && !$t2IsTP && $t2->isNotEmpty() && !platform::pure::compiler::helper::type::typeEquals($t1->toOne(), $t2->toOne()),
                       | if(platform::pure::compiler::helper::type::subtypeOf($t1->toOne(), $t2->toOne(), $context), | -1,
                             | if(platform::pure::compiler::helper::type::subtypeOf($t2->toOne(), $t1->toOne(), $context), | 1,
                                 | let n1 = if($t1->toOne()->instanceOf(PackageableElement), | $t1->toOne()->cast(@PackageableElement).name->toOne(), | '');
                                   let n2 = if($t2->toOne()->instanceOf(PackageableElement), | $t2->toOne()->cast(@PackageableElement).name->toOne(), | '');
                                   // Same simple name, different types (two `Class`es in different packages): order by full path
                                   let p1 = if($t1->toOne()->instanceOf(PackageableElement), | $t1->toOne()->cast(@PackageableElement)->elementToPath(), | '');
                                   let p2 = if($t2->toOne()->instanceOf(PackageableElement), | $t2->toOne()->cast(@PackageableElement)->elementToPath(), | '');
                                   if($n1 != $n2, | $n1->compare($n2), | $p1->compare($p2));
                             );
                         );)],
                  | 0
              );
              if($typeCmp != 0, | $typeCmp,
                  | let m1 = $params1->at($i).multiplicity->toOne();
                    let m2 = $params2->at($i).multiplicity->toOne();
                    let argument = if($i < $arguments->size(), | $arguments->at($i), | []);
                    let rankCmp = if($argument->isNotEmpty() && $argument->toOne()->instanceOf(ConcreteMultiplicity)
                                        && !platform::pure::compiler::helper::multiplicity::isUniversalMultiplicity($m1) && !platform::pure::compiler::helper::multiplicity::isUniversalMultiplicity($m2),
                       | compareRanks(multiplicityRank($m1, $argument->toOne()), multiplicityRank($m2, $argument->toOne())),
                       | 0);
                    let m1IsParam = $m1->instanceOf(MultiplicityParameter);
                    let m2IsParam = $m2->instanceOf(MultiplicityParameter);
                    if($rankCmp != 0, | $rankCmp, | if([pair(| $m1IsParam && !$m2IsParam, | if(platform::pure::compiler::helper::multiplicity::isUniversalMultiplicity($m2), | -1, | 1)),
                        pair(| !$m1IsParam && $m2IsParam, | if(platform::pure::compiler::helper::multiplicity::isUniversalMultiplicity($m1), | 1, | -1)),
                        pair(| !$m1IsParam && !$m2IsParam,
                             | let s1 = platform::pure::compiler::helper::multiplicity::subsumesMultiplicity($m1, $m2);
                               let s2 = platform::pure::compiler::helper::multiplicity::subsumesMultiplicity($m2, $m1);
                               if($s1 && !$s2, | 1, | if($s2 && !$s1, | -1, | 0));)],
                       | 0
                    ));
              );
        );
    }, 0);
}

// A parameter multiplicity's rank against a concrete argument multiplicity, lower first (Java's
// FunctionIndexEntry.multiplicityRank): [0] an exact match, [1] a multiplicity parameter, [2, upper bound
// distance, lower bound distance] a concrete one containing the argument's, [3] another.
function platform::pure::compiler::helper::functionType::multiplicityRank(parameter:Multiplicity[1], argument:Multiplicity[1]):Integer[3]
{
    if($parameter->instanceOf(MultiplicityParameter), | [1, 0, 0], |
        if(!$parameter->instanceOf(ConcreteMultiplicity), | [3, 0, 0], |
            let pLower = platform::pure::compiler::helper::multiplicity::multiplicityLowerBound($parameter);
            let aLower = platform::pure::compiler::helper::multiplicity::multiplicityLowerBound($argument);
            let pUpper = platform::pure::compiler::helper::multiplicity::multiplicityUpperBound($parameter);
            let aUpper = platform::pure::compiler::helper::multiplicity::multiplicityUpperBound($argument);
            let containsUpper = $pUpper == -1 || ($aUpper != -1 && $aUpper <= $pUpper);
            if($pLower > $aLower || !$containsUpper, | [3, 0, 0], |
                let upperDistance = if($pUpper == -1, | if($aUpper == -1, | 0, | 9223372036854775807), | $pUpper - $aUpper);
                let lowerDistance = $aLower - $pLower;
                if($upperDistance == 0 && $lowerDistance == 0, | [0, 0, 0], | [2, $upperDistance, $lowerDistance]);
            );
        )
    );
}

function platform::pure::compiler::helper::functionType::compareRanks(r1:Integer[3], r2:Integer[3]):Integer[1]
{
    range(0, 3)->fold({i, cmp | if($cmp != 0, | $cmp, | $r1->at($i)->compare($r2->at($i)))}, 0);
}
