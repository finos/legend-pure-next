import platform::pure::metamodel::type::generics::*;
import platform::pure::functions::lang::*;
import platform::pure::compiler::helper::type::*;
import platform::pure::compiler::helper::multiplicity::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::helper::property::*;
import platform::pure::compiler::helper::parametersBinding::*;
import platform::pure::compiler::helper::class::*;

// Property helpers

function platform::pure::compiler::helper::property::resolveProperty(prop:Property<Nil,Any|*>[1], receiverType:GenericType[1], context:platform::pure::compiler::CompilerContext[1]):Property<Nil,Any|*>[1]
{
    let resolvedGenericType = $prop.genericType;
    let resolvedMultiplicity = $prop.multiplicity;
    let resolvedClassifierGenericType = $prop.classifierGenericType;

    let resolvedTuple = $receiverType->rawType()->toOne()->match(
        [
            ownerClass : Class<Any>[1] |
                let bindings = $ownerClass->buildBindingsFromGenericType($receiverType);
                if($bindings.typeBindings->isNotEmpty() || $bindings.multiplicityBindings->isNotEmpty(),
                    | pair(
                        $resolvedGenericType->makeAsConcreteAsPossible($bindings, $context),
                        pair(
                            $resolvedMultiplicity->makeAsConcreteAsPossible($bindings),
                            $resolvedClassifierGenericType->toOne()->makeAsConcreteAsPossible($bindings, $context)
                        )
                      ),
                    | pair($resolvedGenericType, pair($resolvedMultiplicity, $resolvedClassifierGenericType->toOne()))
                );,
            a : Any[1] | pair($resolvedGenericType, pair($resolvedMultiplicity, $resolvedClassifierGenericType->toOne()))
        ]
    );
    
    let resolvedProp = new($resolvedTuple.second.second)->cast(@Property<Nil,Any|*>);
    ^$resolvedProp(
        aggregation = AggregationKind.None,
        name = $prop.name,
        genericType = $resolvedTuple.first,
        multiplicity = $resolvedTuple.second.first,
        owner = $prop.owner
    );
}

// Tests

Class <<test.TestDependency>> platform::pure::compiler::helper::property::tests::MyClass<T, U|m>
{
}

Class <<test.TestDependency>> platform::pure::compiler::helper::property::tests::TestClass
{
    prop : platform::pure::compiler::helper::property::tests::MyClass<String, Integer | 1..*>[1];
}

function <<test.Test>> platform::pure::compiler::helper::property::tests::testResolveProperty():Boolean[1]
{
    let ctx = platform::pure::compiler::newPlainCompilerContext();
    let ownerClass = platform::pure::compiler::helper::property::tests::MyClass;
    let prop = platform::pure::compiler::helper::property::tests::TestClass.properties->filter(p | $p.name == 'prop')->toOne();
    let receiverType = $prop.genericType->toOne();

    let sourceProp = ^Property<Nil,Any|*>(
        aggregation = AggregationKind.None,
        name = 'mockProp',
        genericType = buildInferredGenericType(platform::pure::compiler::helper::property::tests::TestClass),
        multiplicity = PureOne,
        owner = $ownerClass
    );

    // TODO: A more comprehensive test that has type parameter references inside the source prop
    let resolvedProp = resolveProperty($sourceProp, $receiverType, $ctx);
    assertEquals('mockProp', $resolvedProp.name);
}
