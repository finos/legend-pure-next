import platform::pure::metamodel::valuespecification::*;
import platform::pure::metamodel::multiplicity::*;
import platform::pure::metamodel::type::generics::*;
import platform::pure::compiler::helper::functionExpression::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::helper::parametersBinding::*;

function platform::pure::compiler::helper::functionExpression::extractResolvedParametersBinding(expr:FunctionExpression[1]):ParametersBinding[1]
{
    let emptyBindings = newPlainParametersBinding();
    
    let withTypes = if($expr.resolvedTypeParameters->isEmpty(),
       | $emptyBindings,
       | $expr.resolvedTypeParameters->fold({param, bb | $bb->addTypeBinding(buildTypeParameter($param.name, false), $param.value)}, $emptyBindings->cast(@ParametersBinding))
    );
    
    let withMultiplicities = if($expr.resolvedMultiplicityParameters->isEmpty(),
       | $withTypes,
       | $expr.resolvedMultiplicityParameters->fold({param, bb | $bb->addMultiplicityBinding(buildInferredMultiplicityParameter($param.name), $param.value)}, $withTypes->cast(@ParametersBinding))
    );
    
    $withMultiplicities;
}

function platform::pure::compiler::helper::functionExpression::populateResolvedParameters(expr:FunctionExpression[1], bindings:ParametersBinding[1], context:platform::pure::compiler::CompilerContext[1]):FunctionExpression[1]
{
    populateResolvedParameters($expr, $bindings, [], [], $context);
}

function platform::pure::compiler::helper::functionExpression::populateResolvedParameters(expr:FunctionExpression[1], bindings:ParametersBinding[1], ownTypeParams:String[*], ownMulParams:String[*], context:platform::pure::compiler::CompilerContext[1]):FunctionExpression[1]
{
    let doFilterType = $ownTypeParams->isNotEmpty();
    let tbKeys = $bindings.typeBindings->keys();
    let rtp = fold($tbKeys, {k, resolved |
        let vals = get($bindings.typeBindings, $k)->toOne();
        if([pair(| $doFilterType && !$ownTypeParams->contains($k), | $resolved),
            pair(| $vals.values->size() == 1, | $resolved->concatenate(buildResolvedTypeParameter($k, $vals.values->at(0), $context))),
            pair(| $vals.values->size() > 1,
                 | let common = findCommonGenericType($vals.values, false, $context);
                   if($common->isNotEmpty(),
                       | $resolved->concatenate(buildResolvedTypeParameter($k, $common->toOne(), $context)),
                       | $resolved
                   );)],
           | $resolved
        );
    }, []->cast(@ResolvedTypeParameter));

    let doFilterMul = $ownMulParams->isNotEmpty();
    let mbKeys = $bindings.multiplicityBindings->keys();
    let rmp = fold($mbKeys, {k, resolved |
        let vals = get($bindings.multiplicityBindings, $k)->toOne();
        if([pair(| $doFilterMul && !$ownMulParams->contains($k), | $resolved),
            pair(| $vals.values->size() == 1, | $resolved->concatenate(buildResolvedMultiplicityParameter($k, $vals.values->at(0))))],
           | $resolved
        );
    }, []->cast(@ResolvedMultiplicityParameter));

    if($rtp->isEmpty() && $rmp->isEmpty(),
        | $expr,
        | ^$expr(
              resolvedTypeParameters = if($rtp->isEmpty(), | $expr.resolvedTypeParameters, | $rtp),
              resolvedMultiplicityParameters = if($rmp->isEmpty(), | $expr.resolvedMultiplicityParameters, | $rmp)
          )
    );
}

function <<test.Test>> platform::pure::compiler::helper::functionExpression::testExtractResolvedParametersBinding_empty():Boolean[1]
{
    let expr = ^FunctionInvocation(
        functionName = 'test',
        genericType = ^CompilerNotSetGenericType(),
        multiplicity = PureOne
    );
    
    let bindings = extractResolvedParametersBinding($expr);
    assertEquals('', toString($bindings));
}

function <<test.Test>> platform::pure::compiler::helper::functionExpression::testPopulateAndExtract():Boolean[1]
{
    let targetClass = String;
    let targetGT = buildInferredGenericType($targetClass);
    let mul = PureOne;
    
    let b1 = newPlainParametersBinding();
    let b2 = $b1->addTypeBinding(buildTypeParameter('T', false), $targetGT);
    let b3 = $b2->addTypeBinding(buildTypeParameter('Z', false), $targetGT);
    let bindings = $b3->addMultiplicityBinding(buildInferredMultiplicityParameter('m'), $mul);
    
    let expr = ^FunctionInvocation(
        functionName = 'test',
        genericType = ^CompilerNotSetGenericType(),
        multiplicity = PureOne
    );
    
    let populated = populateResolvedParameters($expr, $bindings, platform::pure::compiler::newPlainCompilerContext()); // no filter
    
    assertEquals(2, $populated.resolvedTypeParameters->size());
    assert($populated.resolvedTypeParameters->filter(t | $t.name == 'T')->isNotEmpty());
    assert($populated.resolvedTypeParameters->filter(t | $t.name == 'Z')->isNotEmpty());
    
    assertEquals(1, $populated.resolvedMultiplicityParameters->size());
    assertEquals('m', $populated.resolvedMultiplicityParameters->at(0).name);
    
    let extracted = extractResolvedParametersBinding($populated);
    assertEquals('{T=String, Z=String | m=[1]}', toString($extracted));
}

function <<test.Test>> platform::pure::compiler::helper::functionExpression::testPopulateWithOwnership():Boolean[1]
{
    let targetClass = String;
    let targetGT = buildInferredGenericType($targetClass);
    let mul = PureOne;
    
    let b1 = newPlainParametersBinding();
    let b2 = $b1->addTypeBinding(buildTypeParameter('T', false), $targetGT);
    let b3 = $b2->addTypeBinding(buildTypeParameter('Z', false), $targetGT);
    let b4 = $b3->addMultiplicityBinding(buildInferredMultiplicityParameter('m'), $mul);
    let bindings = $b4->addMultiplicityBinding(buildInferredMultiplicityParameter('n'), $mul);
    
    let expr = ^FunctionInvocation(
        functionName = 'test',
        genericType = ^CompilerNotSetGenericType(),
        multiplicity = PureOne
    );
    
    let populated = populateResolvedParameters($expr, $bindings, ['T'], ['m'], platform::pure::compiler::newPlainCompilerContext());
    
    assertEquals(1, $populated.resolvedTypeParameters->size());
    assertEquals('T', $populated.resolvedTypeParameters->at(0).name);
    
    assertEquals(1, $populated.resolvedMultiplicityParameters->size());
    assertEquals('m', $populated.resolvedMultiplicityParameters->at(0).name);
}
