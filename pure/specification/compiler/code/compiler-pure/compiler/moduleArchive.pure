// What every host's `compile` runs: a module's sources to its PDBs, the same code whatever the host, so that a difference
// between their PDBs is a difference between the hosts. The host gives the compiler passes of its languages.

import platform::pure::compiler::*;
import platform::pure::metamodel::*;


// The extensions with ###Pure's first, unless they already include it (by name): ###Pure is never optional, so a
// list that does not name pureExtension() still writes m3's elements, and a list that does is used as given.
function platform::pure::compiler::archive::withPureExtension(extensions:platform::pure::compiler::extension::CompilerExtension[*]):platform::pure::compiler::extension::CompilerExtension[*]
{
   let pure = platform::pure::compiler::extension::pureExtension();
   if($extensions->exists(x | $x.name == $pure.name), | $extensions, | $pure->concatenate($extensions));
}

// How the extensions write their elements, in the order the archive writer asks them.
function platform::pure::compiler::archive::serializations(extensions:platform::pure::compiler::extension::CompilerExtension[*]):platform::pure::pdb::PdbSerialization[*]
{
   platform::pure::compiler::archive::withPureExtension($extensions).pdb
}

// The archive of `elements`, written through the serializations of `extensions`.
function platform::pure::compiler::archive::writeArchive(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*]):Binary[1]
{
   platform::pure::pdb::archive::writeArchive($elements, platform::pure::compiler::archive::serializations($extensions), $moduleName, $packagePattern, $dependencies)
}

function platform::pure::compiler::archive::writeArchive(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*], referencedBy:Map<String, List<String>>[1]):Binary[1]
{
   platform::pure::pdb::archive::writeArchive($elements, platform::pure::compiler::archive::serializations($extensions), $moduleName, $packagePattern, $dependencies, $referencedBy)
}

// A Package holding only the children in `paths`: a lean Package must not point at the test elements below it.
function platform::pure::compiler::archive::withChildrenIn(element:PackageableElement[1], paths:Map<String, Boolean>[1]):PackageableElement[1]
{
   if($element->instanceOf(Package),
      | let package = $element->cast(@Package);
        ^$package(children = $package.children->filter(c | $paths->get($c->fullPath())->isNotEmpty()));,
      | $element);
}

// The Package of the module at `path`, holding only `children`: the test half's shadow of a Package of the lean half,
// which the registry folds into the lean one when both are loaded.
function platform::pure::compiler::archive::shadowPackages(tests:PackageableElement[*], lean:PackageableElement[*], testPaths:Map<String, Boolean>[1]):PackageableElement[*]
{
   let packages = newMap($lean->filter(e | $e->instanceOf(Package))->map(e | pair($e->fullPath(), $e->cast(@Package))));
   $tests->filter(t | $t.package->isNotEmpty())
      ->groupBy(t | $t.package->toOne()->fullPath())
      ->keyValues()
      ->filter(p | $testPaths->get($p.first)->isEmpty() && $packages->get($p.first)->isNotEmpty())
      ->map(p | let canonical = $packages->get($p.first)->toOne();
                ^$canonical(children = $p.second.values););
}

// The reverse index of the elements at `paths`: a target keeps only the callers among them, and goes with its last one.
function platform::pure::compiler::archive::referencedByIn(referencedBy:Map<String, List<String>>[1], paths:Map<String, Boolean>[1]):Map<String, List<String>>[1]
{
   newMap($referencedBy->keys()->map(target |
      let callers = $referencedBy->get($target)->toOne().values->filter(c | $paths->get($c)->isNotEmpty());
      if($callers->isEmpty(), | [], | pair($target, ^List<String>(values = $callers)));
   ));
}

function platform::pure::compiler::archive::pathSet(elements:PackageableElement[*]):Map<String, Boolean>[1]
{
   newMap($elements->map(e | pair($e->fullPath(), true)));
}

// The lean half: '<module>.pdb'.
function platform::pure::compiler::archive::leanArchive(result:CompilationResult[1], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*]):Binary[1]
{
   let lean = $result.elements->filter(e | !isTestElement($e));
   let paths = platform::pure::compiler::archive::pathSet($lean);
   platform::pure::compiler::archive::writeArchive(
      $lean->map(e | platform::pure::compiler::archive::withChildrenIn($e, $paths)),
      $extensions, $moduleName, $packagePattern, $dependencies,
      platform::pure::compiler::archive::referencedByIn($result.context->toOne().referencedBy, $paths));
}

// The test half: '<module>-tests.pdb', which depends on the lean half and on the test dependencies.
function platform::pure::compiler::archive::testsArchive(result:CompilationResult[1], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*], testDependencies:String[*]):Binary[1]
{
   let tests = $result.elements->filter(e | isTestElement($e));
   let lean = $result.elements->filter(e | !isTestElement($e));
   let paths = platform::pure::compiler::archive::pathSet($tests);
   platform::pure::compiler::archive::writeArchive(
      $tests->concatenate(platform::pure::compiler::archive::shadowPackages($tests, $lean, $paths)),
      $extensions, $moduleName + '-tests', $packagePattern,
      $dependencies->concatenate($testDependencies)->concatenate($moduleName)->removeDuplicates(),
      platform::pure::compiler::archive::referencedByIn($result.context->toOne().referencedBy, $paths));
}

// Both halves in one: '<module>-with-tests.pdb'. Its test elements are present, so their dependencies are its own.
function platform::pure::compiler::archive::withTestsArchive(result:CompilationResult[1], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*], testDependencies:String[*]):Binary[1]
{
   platform::pure::compiler::archive::writeArchive(
      $result.elements, $extensions, $moduleName, $packagePattern,
      $dependencies->concatenate($testDependencies)->removeDuplicates(),
      $result.context->toOne().referencedBy);
}

// The module.json of a module: at or above its first source directory.
function platform::pure::compiler::archive::moduleManifestPath(dir:String[1]):String[1]
{
   let manifest = $dir + '/module.json';
   if(platform::pure::functions::io::directoryTree($dir)->contains($manifest),
      | $manifest,
      | assert($dir->lastIndexOf('/') > 0, | 'no module.json at or above the sources');
        platform::pure::compiler::archive::moduleManifestPath($dir->substring(0, $dir->lastIndexOf('/'))););
}

// Compiles the .pure files below `sources` and writes the PDBs of the module to `outputDir`, returning their paths.
// `tests`: 'none' (the lean half), 'split' (both halves, each in its own PDB), or 'with' (both in '<module>-with-tests.pdb').
function platform::pure::compiler::archive::compileModule(sources:String[*], outputDir:String[1], tests:String[1], extensions:platform::pure::compiler::extension::CompilerExtension[*]):String[*]
{
   let manifest = platform::pure::functions::variant::convert::fromJson(platform::pure::functions::io::readFile(platform::pure::compiler::archive::moduleManifestPath($sources->at(0))));
   let name = $manifest->platform::pure::functions::variant::navigation::get('name')->platform::pure::functions::variant::convert::to(@String)->toOne();
   let packagePattern = $manifest->platform::pure::functions::variant::navigation::get('packagePattern')->platform::pure::functions::variant::convert::to(@String)->toOne();
   let dependencies = $manifest->platform::pure::functions::variant::navigation::get('dependencies')->platform::pure::functions::variant::convert::toMany(@String);
   let testDependencies = $manifest->platform::pure::functions::variant::navigation::get('testDependencies')->platform::pure::functions::variant::convert::toMany(@String);

   let result = platform::pure::compiler::compile(platform::pure::compiler::parseDirs($sources), $extensions, true);
   assert($result.errors->isEmpty(), | 'Pure compilation failed with ' + $result.errors->size()->toString() + ' error(s): ' + $result.errors->joinStrings('; '));

   let write = {file:String[1], content:Binary[1] | platform::pure::functions::io::writeFileBytes($outputDir + '/' + $file, $content)};
   if($tests == 'with',
      | $write->eval($name + '-with-tests.pdb', platform::pure::compiler::archive::withTestsArchive($result, $extensions, $name, $packagePattern, $dependencies, $testDependencies)),
      | assert($tests == 'none' || $tests == 'split', | 'unknown tests mode: ' + $tests);
        $write->eval($name + '.pdb', platform::pure::compiler::archive::leanArchive($result, $extensions, $name, $packagePattern, $dependencies))
           ->concatenate(if($tests == 'split',
              | $write->eval($name + '-tests.pdb', platform::pure::compiler::archive::testsArchive($result, $extensions, $name, $packagePattern, $dependencies, $testDependencies)),
              | []->cast(@String)));
     );
}
