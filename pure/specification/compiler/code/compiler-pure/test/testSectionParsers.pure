//
// Test-section parsers exposed to the top-level dispatch as a Pure list.
// The Pure interpreter (mapping_top.pure::parseDocument) walks this list
// to find the parser for each ###X section.
//
// The list is "the test-suite extensions" — bundled into the compiler-pure
// module since the section classes live here. Each entry is a Pair<name,
// (content, sourceId, lineOffset) -> PackageableElement[*]>.

import platform::pure::compiler::test::*;

// Compiler-test section parsers exposed as a registry the caller can append
// to whatever upstream Pure parser registry they already have (e.g.
// pureSectionParser() from parser-mappings for the ###Pure section).
// Composition happens at the caller — no cross-module dep here.
function platform::pure::compiler::test::testSectionParsers(): platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>[*]
{
   [
      ^platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>(
         first = 'CompiledGraph',
         second = {c:String[1], s:String[1], o:Integer[1] | buildCompiledGraphSection($c, $s, $o)}),
      ^platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>(
         first = 'CompilerStats',
         second = {c:String[1], s:String[1], o:Integer[1] | buildCompilerStatsSection($c, $s, $o)}),
      ^platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>(
         first = 'ReverseIndex',
         second = {c:String[1], s:String[1], o:Integer[1] | buildReverseIndexSection($c, $s, $o)}),
      ^platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>(
         first = 'File',
         second = {c:String[1], s:String[1], o:Integer[1] | buildTestFileSection($c, $s, $o)})
   ]
}
