import platform::pure::protocol::*;
import platform::pure::protocol::grammar::*;

Class platform::pure::compiler::test::ReverseIndex extends platform::pure::protocol::grammar::PackageableElement
{
    value : String[1];
}

// Section parser for ###ReverseIndex: wraps the raw section body in a
// ReverseIndex PDO. Consumed by the Pure-side section-dispatch table; see
// platform::pure::compiler::test::testSectionParsers.
function platform::pure::compiler::test::buildReverseIndexSection(
   content: String[1], sourceId: String[1], lineOffset: Integer[1]
): platform::pure::protocol::grammar::PackageableElement[*]
{
   ^platform::pure::compiler::test::ReverseIndex(
      name    = 'ReverseIndex',
      value   = $content,
      package = ^Package_Pointer(value = $sourceId)
   )
}
