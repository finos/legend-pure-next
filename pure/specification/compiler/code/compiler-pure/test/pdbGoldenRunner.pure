import platform::pure::compiler::test::*;
import platform::pure::functions::date::*;
import platform::pure::functions::io::*;
import platform::pure::functions::string::*;
import platform::pure::ui::progress::*;

// ---------------------------------------------------------------------------
// PDB wire contract: the Pure compiler and PDB writer against the Java reference.
//
//   pure-<platform> execute ... \
//       --function "platform::pure::compiler::test::pdb::runPdbGoldenTests_String_1__String_1__String_1__String_1__String_1_" \
//       --args pure/specification/compiler/tests/definition \
//              pure/specification/compiler/tests/pdb \
//              shared/specification/m3.fbs \
//              <report.json>
//
// Each golden <name>.pdb was written by the Java reference writer from the fixture
// <name>.pure. The fixture is compiled with the Pure compiler, written with the Pure
// writer, and both archives are decoded with the Pure reader (inflate.pure opens the
// golden's deflated entries) and compared, following the rules of the JavaScript
// platform's struct-diff.js:
//   - element entries: same type, then every schema field, recursively;
//     PointerRefs by kind and path, AncestorRefs by depth, set-like vectors
//     (children, resolved type and multiplicity parameters) as multisets;
//   - a Package entry only in the golden is skipped (the Java compiler registers
//     file-anchor packages that the Pure compile result doesn't include);
//   - other sections (manifest, functionIndex, reverseReferenceIndex) byte for byte,
//     and elementIndex too when both archives hold the same element entries.
// Those findings name what differs. An archive with none must then also match the golden
// byte for byte, entry by entry: the Pure writer lays a graph out as the Java writer does,
// and test_pdb_goldens_up_to_date__compiler keeps the goldens what the Java writer writes.
// ---------------------------------------------------------------------------

function <<test.TestDependency>> platform::pure::compiler::test::pdb::runPdbGoldenTests(testDir:String[1], goldenDir:String[1], schemaPath:String[1], reportPath:String[1]):String[1]
{
    // With the test package's island handlers, as the compiled-graph runner: valueSpecification/island has a golden too.
    // Their values are written with the test package's schema fragment, staged beside m3.fbs (islandTest.fbs).
    let dir = $schemaPath->substring(0, $schemaPath->lastIndexOf('/'));
    let fragment = directoryTree($dir)->filter(f | $f->endsWith('/islandTest.fbs'));
    platform::pure::compiler::test::pdb::runPdbGoldenTests($testDir, $goldenDir, $schemaPath->concatenate($fragment), $reportPath, platform::pure::compiler::test::islandTestExtension());
}

// With a language extension's compiler passes (which also write its elements): its fixtures compile and
// archive like any other. The schema files are read as ONE text — m3's, then the extension's fragment,
// which refers to m3's tables. The call above passes the test package's island handlers.
function <<test.TestDependency>> platform::pure::compiler::test::pdb::runPdbGoldenTests(testDir:String[1], goldenDir:String[1], schemaPaths:String[*], reportPath:String[1], extensions:platform::pure::compiler::extension::CompilerExtension[*]):String[1]
{
    let schema = platform::pure::pdb::schema::parseFbs($schemaPaths->map(p | readFile($p))->joinStrings('\n'));
    let goldens = directoryTree($goldenDir)->filter(f | $f->endsWith('.pdb'));
    let total = $goldens->size();
    startProgress('Comparing ' + $total->toString() + ' PDB archives with the Java goldens in ' + $goldenDir + '...');
    let start = currentTimeMillis();
    let results = range(0, $total)->map(i | platform::pure::compiler::test::pdb::goldenCase($testDir, $goldenDir, $schema, $goldens->at($i), $i, $total, $extensions));
    let elapsedMs = currentTimeMillis() - $start;
    finishProgress();

    let failures = $results->filter(r | $r.error->isNotEmpty());
    $failures->map(r |
        println('  FAIL: ' + $r.name);
        println('    ' + $r.error->toOne().message);
    );
    let failed = $failures->size();
    let summary = if($failed > 0,
        | 'FAIL: ' + ($total - $failed)->toString() + ' / ' + $total->toString() + ' archives match their golden (' + $failed->toString() + ' differ) in ' + $elapsedMs->toString() + ' ms',
        | 'OK: ' + $total->toString() + ' / ' + $total->toString() + ' archives match their golden in ' + $elapsedMs->toString() + ' ms');
    platform::pure::test::report::writeSuiteReport($reportPath, 'pdbGolden', $elapsedMs,
        $results->map(r | ^platform::pure::test::report::TestCaseReport(id = $r.name, durationMs = $r.durationMs, error = $r.error)));
    assert($failed == 0, $summary);
    $summary;
}

function <<test.TestDependency>> platform::pure::compiler::test::pdb::goldenCase(testDir:String[1], goldenDir:String[1], schema:platform::pure::pdb::schema::FbsSchema[1], goldenPath:String[1], i:Integer[1], total:Integer[1], extensions:platform::pure::compiler::extension::CompilerExtension[*]):platform::pure::compiler::test::CompiledGraphTestResult[1]
{
    let name = $goldenPath->substring($goldenDir->length() + 1, $goldenPath->length() - 4);
    tickProgress($i + 1, $total, $name);
    let caseStart = currentTimeMillis();
    let result = tryEval(| platform::pure::compiler::test::pdb::assertMatchesGolden(readFile($testDir + '/' + $name + '.pure'), $name, readFileBytes($goldenPath), $schema, $extensions));
    ^platform::pure::compiler::test::CompiledGraphTestResult(name = $name, error = $result.failure, durationMs = currentTimeMillis() - $caseStart);
}

function <<test.TestDependency>> platform::pure::compiler::test::pdb::assertMatchesGolden(content:String[1], sourceId:String[1], golden:Binary[1], schema:platform::pure::pdb::schema::FbsSchema[1], extensions:platform::pure::compiler::extension::CompilerExtension[*]):Boolean[1]
{
    let written = platform::pure::compiler::test::pdb::writeFixture($content, $sourceId, $extensions);
    let findings = platform::pure::pdb::diff::diffArchives($schema, $written, $golden);
    assert($findings->isEmpty(), | $findings->size()->toString() + ' difference(s) from the golden, first: ' + $findings->at(0));
    // Same nodes is not enough: the Pure writer must lay them out as the Java writer does, byte for byte (the
    // uncompressed bytes of each entry; the deflated ones depend on the deflater).
    let goldenEntries = platform::pure::pdb::archive::entryNames($golden);
    let writtenEntries = platform::pure::pdb::archive::entryNames($written);
    let differing = $goldenEntries->filter(n | !$writtenEntries->contains($n) || (platform::pure::pdb::archive::entryBytes($golden, $n)->platform::pure::functions::binary::binaryToHex() != platform::pure::pdb::archive::entryBytes($written, $n)->platform::pure::functions::binary::binaryToHex()));
    assert($differing->isEmpty() && ($goldenEntries->size() == $writtenEntries->size()),
        | 'same nodes as the golden but other bytes, in ' + $differing->joinStrings(', ') + ' (' + $writtenEntries->size()->toString() + ' entries written, ' + $goldenEntries->size()->toString() + ' in the golden)');
}

// The archive a fixture compiles to, as hex, with the specification's island handlers — how the island
// goldens (valueSpecification/island) are written: by the Pure writer, as the diagram's are, since the
// Java compiler cannot build the test package's island values (`bazel run //:update_pdb_goldens__island`).
function <<test.TestDependency>> platform::pure::compiler::test::pdb::goldenHexOf(testDir:String[1], name:String[1]):String[1]
{
    platform::pure::compiler::test::pdb::writeFixture(readFile($testDir + '/' + $name + '.pure'), $name, platform::pure::compiler::test::islandTestExtension())
       ->platform::pure::functions::binary::binaryToHex();
}

// The archive a fixture compiles to — what its golden holds. The writer asks the given extensions
// (pureExtension() is always among them) for each element's serializer.
function <<test.TestDependency>> platform::pure::compiler::test::pdb::writeFixture(content:String[1], sourceId:String[1], extensions:platform::pure::compiler::extension::CompilerExtension[*]):Binary[1]
{
    let result = platform::pure::compiler::test::pdb::compileFixture($content, $sourceId, $extensions);
    assert($result.errors->isEmpty(), | 'the fixture does not compile: ' + $result.errors->joinStrings('; '));
    if($result.context->isEmpty(),
        | platform::pure::compiler::archive::writeArchive($result.elements, platform::pure::compiler::extension::pureExtension()->concatenate($extensions), 'test', '*', ['core']),
        | platform::pure::compiler::archive::writeArchive($result.elements, platform::pure::compiler::extension::pureExtension()->concatenate($extensions), 'test', '*', ['core'], $result.context->toOne().referencedBy));
}

// Compiles a fixture as assertCompiledGraph does: lines before ###Pure are blanked so
// positions stay aligned, and each ###Pure / ###File chunk becomes its own file.
function <<test.TestDependency>> platform::pure::compiler::test::pdb::compileFixture(content:String[1], sourceId:String[1]):platform::pure::compiler::CompilationResult[1]
{
    platform::pure::compiler::test::pdb::compileFixture($content, $sourceId, []);
}

function <<test.TestDependency>> platform::pure::compiler::test::pdb::compileFixture(content:String[1], sourceId:String[1], extensions:platform::pure::compiler::extension::CompilerExtension[*]):platform::pure::compiler::CompilationResult[1]
{
    let pureStart = $content->indexOf('###' + 'Pure');
    let prepared = if($pureStart > 0,
        | $content->substring(0, $pureStart)->split('\n')->map(l | '')->joinStrings('\n') + $content->substring($pureStart),
        | $content);
    let files = manageFileSections(platform::pure::functions::meta::parse($sourceId, $prepared));
    if($extensions->isEmpty(),
        | platform::pure::compiler::compile($files, false, true),
        | platform::pure::compiler::compile($files, $extensions, false, true));
}
