###Pure
// Regression test for an ambiguity divergence between the Java compiler and
// the Pure compiler running on Truffle.
//
// When a short type name (e.g. `MyType`) is brought into scope via a single
// import (here `packA::*`), and ANOTHER package in the same source tree
// happens to define the same short name (`packB::MyType`), the resolver must
// only consider IMPORTS for ambiguity reporting, not every same-short-name
// element in the model.
//
// The Java compiler did this correctly (only iterates imports — see
// _PackageableElement.findElementOrReportError). The Pure compiler's
// resolveAllElements used to additionally include every elementMap key
// ending in `::MyType`, which falsely tripped ambiguity for any peer
// package's MyType — manifesting on real-world code as e.g.
// `meta::external::language::java::metamodel::Enumeration` colliding with
// the auto-imported `meta::pure::metamodel::type::Enumeration` even though
// the file under compilation only imported the latter.
import packA::*;

Class packA::MyType
{
  name: String[1];
}

Class packB::MyType
{
  label: String[1];
}

function packC::tst(value: MyType[1]): String[1]
{
  $value.name;
}

