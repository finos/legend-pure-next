// Tests `^expr(keys)` where the receiver has multiplicity [*].
// The compiler rewrites to `expr->map(_automap | ^$_automap(keys))`
// so the return type stays [*].
function test::copy::zeroMany::testCopyOfCollection(node:Node[1]): Any[*]
{
  let renamed = ^$node.children(name='renamed');
}

