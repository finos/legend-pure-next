###Pure
import test::copy::oneToOne::*;

// Tests the new `^expr(keys)` form where the receiver expression has
// multiplicity [1] — behaves identically to the variable-form `^$x(keys)`,
// resolving `copy(receiver, [keys])` against the
// `copy(T[1], KeyExpression[*]):T[1]` native.
function test::copy::oneToOne::testCopyFromFunctionCall(): Any[*]
{
  let a = ^buildOne()(name='from-call');
}

function test::copy::oneToOne::buildOne(): Node[1]
{
  ^Node(name='seed');
}

Class test::copy::oneToOne::Node
{
  name: String[1];
}

