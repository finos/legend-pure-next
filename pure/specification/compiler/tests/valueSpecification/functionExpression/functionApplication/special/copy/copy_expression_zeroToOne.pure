import test::copy::zeroToOne::*;

// Tests `^expr(keys)` where the receiver has multiplicity [0..1].
// The compiler rewrites to `expr->map(_automap | ^$_automap(keys))`
// so the return type stays [0..1].
function test::copy::zeroToOne::testCopyOfOptional(node:Node[1]): Any[*]
{
  let opt = ^$node.parent(name='copied');
}

