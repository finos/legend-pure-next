###Pure
// A call whose argument is itself a call taking a column spec (~id->ascending()): the relation's type binds
// sort's T all the same, so its result is the relation's.
native function sort<X,T>(rel: Relation<T>[1], sortInfo: SortInfo<X⊆T>[*]): Relation<T>[1];

native function ascending<T>(column: ColSpec<T>[1]): SortInfo<T>[1];

function f(rel: Relation<(id:Integer, name:String)>[1]): Relation<(id:Integer, name:String)>[1]
{
  $rel->sort(~id->ascending())
}

