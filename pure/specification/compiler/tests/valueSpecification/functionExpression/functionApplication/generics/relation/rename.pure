native function rename<T,Z,K,V|m>(r: Relation<T>[1], old: ColSpec<Z=(?:K[m])⊆T>[1], new: ColSpec<V=(?:K[m])>[1]): Relation<T-Z+V>[1];

function f(x: Relation<(legal:String, other:Integer[0..1], yeah:Float)>[1]): Any[*]
{
  $x->rename(~legal, ~newLegal);
  $x->rename(~other, ~newOther);
}

