###Pure
import test::*;

// A value of the caller's multiplicity parameter (Z[y], from an eval) given to an overloaded function twice: the
// first call's overload resolution must leave the second's value as it is (Z[y], not Z[*]).
Class test::LType
{
}

function test::check(instance: Any[1], type: LType[1]): Boolean[1]
{
  true
}

function test::check(instance: Any[1], type: String[1]): Boolean[1]
{
  true
}

function test::overloadedTwice<Z|y>(f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]): Boolean[1]
{
  check($f->eval(|1), ^LType());
  check($f->eval(|1), ^LType());
}

