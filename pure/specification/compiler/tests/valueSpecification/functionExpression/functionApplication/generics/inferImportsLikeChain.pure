  fieldType: TestType[1];
  annotations: TestType[*];
}

Class test::factory::TestMethod
{
  name: String[1];
  returnType: TestType[1];
  paramTypes: TestType[*];
  annotations: TestType[*];
}

Class test::factory::TestConstructor
{
  paramTypes: TestType[*];
  annotations: TestType[*];
}

Class test::factory::TestClass
{
  pkg: String[1];
  name: String[1];
  superType: TestType[0..1];
  interfaces: TestType[*];
  fields: TestField[*];
  methods: TestMethod[*];
  constructors: TestConstructor[*];
  annotations: TestType[*];
}

function test::factory::qualifiedName(t: TestType[1]): String[1]
{
  $t.pkg + '::' + $t.name
}

function test::factory::collectAnnotationTypes(c: TestClass[1]): TestType[*]
{
  $c.annotations->concatenate($c.fields.annotations)->concatenate($c.methods.annotations)->concatenate($c.constructors.annotations)
}

function test::factory::collectStructuralTypes(c: TestClass[1]): TestType[*]
{
  $c.interfaces->concatenate(if($c.superType->isEmpty(), |[], |$c.superType->toOne()))->concatenate($c.fields.fieldType)->concatenate($c.methods.returnType)->concatenate($c.methods.paramTypes)->concatenate($c.constructors.paramTypes)
}

function test::factory::inferImportsLike(c: TestClass[1]): String[*]
{
  let annotationsTypes = collectAnnotationTypes($c);
  let structuralTypes = collectStructuralTypes($c);
  let allTypes = $structuralTypes->concatenate($annotationsTypes)->removeDuplicatesBy(t|qualifiedName($t));
  let inSamePackage = $allTypes->filter(t|$t.pkg == $c.pkg);
  let toImport = $allTypes->filter(t|!$inSamePackage->exists(s|qualifiedName($s) == qualifiedName($t)));
  $toImport->map(t|qualifiedName($t))->sort();
}

