###Pure
function test::wrapAndPut<K,V>(map: Map<K, List<V>>[1], key: K[1], value: V[1]): Map<K, List<V>>[1]
{
  let nl = ^List<V>(values = [$value]);
  $map->put($key, $nl);
}

