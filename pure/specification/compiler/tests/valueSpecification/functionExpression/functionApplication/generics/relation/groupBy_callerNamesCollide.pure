###Pure
// As groupBy, in a function whose own type and multiplicity parameters are named like groupBy's (T, m):
// groupBy's T, unbound, is not taken for the caller's, and is still the relation's row.
native function groupBy<T,Z,K,V,R>(r: Relation<T>[1], cols: ColSpec<Z⊆T>[1], agg: AggColSpec<{T[1]->K[0..1]}, {K[*]->V[0..1]}, R>[1]): Relation<Z+R>[1];

native function groupBy<T,Z,R>(r: Relation<T>[1], cols: ColSpec<Z⊆T>[1], agg: FuncColSpec<{Relation<T>[1]->Any[0..1]}, R>[1]): Relation<Z+R>[1];

native function total(v: Integer[*]): Integer[1];

function f<T|m>(rel: Relation<(val:Integer, str:String)>[1]): Any[*]
{
  $rel->groupBy(~str, ~newCol : x|$x.val : y|$y->total())
}

