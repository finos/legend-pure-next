###Pure
// A window (over(~grp)) whose relation is known only from the extend taking it: its column spec is resolved
// once the extend's relation binds T, the aggregate's lambdas typed by the row and the window, and the new
// column read on the extended relation.
native function over<T>(cols: ColSpec<(?:?)⊆T>[1]): Window<T>[1];

native function extend<T,K,V,R>(r: Relation<T>[1], window: Window<T>[1], agg: AggColSpec<{Relation<T>[1],Window<T>[1],T[1]->K[0..1]}, {K[*]->V[0..1]}, R>[1]): Relation<T+R>[1];

native function filter<T>(rel: Relation<T>[1], f: Function<{T[1]->Boolean[1]}>[1]): Relation<T>[1];

native function total(v: Integer[*]): Integer[1];

function f(rel: Relation<(id:Integer, grp:Integer)>[1]): Any[*]
{
  $rel->extend(over(~grp), ~newCol : {p, w, r|$r.id} : y|$y->total())->filter(x|$x.newCol > 9)
}

