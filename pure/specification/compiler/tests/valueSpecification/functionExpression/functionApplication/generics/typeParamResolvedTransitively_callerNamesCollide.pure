import test::*;

// The caller's own type parameters named like the callee's (eval<T,V|m,n>): its T is bound by the call as
// a Z would be, the lambda's type, not taken for eval's T.

Class test::TPR_Person
{
  firstName: String[1];
  lastName: String[1];
}

function test::testTypeParamResolution<T|m>(f: Function<{Function<{->T[m]}>[1]->T[m]}>[1]): Any[*]
{
  $f->eval(|^TPR_Person(firstName = 'A', lastName = 'B')).lastName
}

