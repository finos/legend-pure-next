###Pure
// A column read by a quoted name ($row.'\'a\'') is read as a string literal is, its escapes processed: the
// column 'a', quotes included, as the relation type names it.
function f(row: (val:Integer, '\'a\'':String, 'b c':Integer)[1]): Any[*]
{
  [$row.'\'a\'', $row.'b c']
}

