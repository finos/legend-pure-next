// A call to a user function takes its summary: a function returning a fresh list gives a value updatable in place, and one
// returning its parameter gives a value as updatable in place as its argument was.
// A function calling itself has no summary while it is analysed: its recursive call gives a shared value, so its
// result is not updatable in place, and neither is a value bound to a call of it.
###Pure
import test::updatableInPlace::*;

function test::updatableInPlace::fresh(): Integer[*]
{
  [1, 2]->map(x|$x)
}

function test::updatableInPlace::same(xs: Integer[*]): Integer[*]
{
  $xs
}

function test::updatableInPlace::useFresh(): Integer[*]
{
  let a = fresh();
  $a->add(3);
}

function test::updatableInPlace::throughSame(): Integer[*]
{
  let a = [1, 2]->map(x|$x);
  let b = same($a);
  $b->add(3);
}

function test::updatableInPlace::recursive(n: Integer[1]): Integer[*]
{
  if($n == 0, |[1, 2]->map(x|$x), |recursive($n - 1))
}

function test::updatableInPlace::useRecursive(): Integer[*]
{
  let r = recursive(2);
  $r->add(1);
}

