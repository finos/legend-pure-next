// let b = $a at a's last use moves the value: b is as fresh as a was.
// A parameter may be shared by the caller: its last use is updatable in place only if the caller passed it updatable in place.
// The reducer returns a fresh list each step (its result is updatable in place) and may add to an accumulator passed updatable in place.
// The reducer hands its accumulator back: updatable in place when it was passed updatable in place.
###Pure
function test::updatableInPlace::move(): Integer[*]
{
  let a = [1, 2]->map(x|$x);
  let b = $a;
  $b->add(1);
}

function test::updatableInPlace::parameter(xs: Integer[*]): Integer[*]
{
  $xs->add(1)
}

function test::updatableInPlace::accumulate(start: Integer[*]): Integer[*]
{
  [1, 2, 3]->fold({e, acc|$acc->add($e)}, $start)
}

function test::updatableInPlace::identity(start: Integer[*]): Integer[*]
{
  [1, 2, 3]->fold({e, acc|$acc}, $start)
}

