// A call to a user function takes its summary: a function returning a fresh list gives a value updatable in place, and one
// returning its parameter gives a value as updatable in place as its argument was.
// A function calling itself has no summary while it is analysed: its recursive call gives a shared value, so its
// result is not updatable in place, and neither is a value bound to a call of it.
###Pure
import test::updatableInPlace::*;

// A call reads a receiver held by a variable once every argument is evaluated: a later argument only reading it is
// done with it by then. One keeping it, or passing it to the call as another argument (read while the call runs),
// still keeps it alive; a receiver computed by an expression is evaluated first, as any argument.

Class test::updatableInPlace::Counter
{
  count: Integer[1];
}

function test::updatableInPlace::addItsSize(): Integer[*]
{
  let xs = [1, 2]->map(x|$x);
  $xs->add($xs->size());
}

function test::updatableInPlace::copyReadingItsSource(): Counter[1]
{
  let c = ^Counter(count = 0);
  ^$c(count = $c.count + 1);
}

function test::updatableInPlace::concatenateToItself(): Integer[*]
{
  let ys = [1, 2]->map(x|$x);
  $ys->concatenate($ys);
}

function test::updatableInPlace::reverseThenConcatenate(): Integer[*]
{
  let zs = [1, 2]->map(x|$x);
  $zs->reverse()->concatenate($zs);
}

function test::updatableInPlace::countAll(): Counter[1]
{
  [1, 2, 3]->fold({e, acc|^$acc(count = $acc.count + $e)}, ^Counter(count = 0));
}
