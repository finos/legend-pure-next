###Pure
import test::updatableInPlace::*;

Class test::updatableInPlace::Item
{
  v: Integer[1];
}

function test::updatableInPlace::copyAnElementReadByAt(): Item[1]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let e = $xs->at(0);
  ^$e(v = 9);
}

function test::updatableInPlace::copyAnElementReadByHead(): Item[1]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let e = $xs->head()->toOne();
  ^$e(v = 9);
}

function test::updatableInPlace::singleValueReadAsAList(): Item[1]
{
  let b = ^Item(v = 1);
  let e = $b->at(0);
  ^$b(v = 2);
}

function test::updatableInPlace::foldCopyingElements(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let e = $xs->at(0);
  $xs->fold({x, acc|$acc->add(^$x(v = $x.v + 1))}, []->cast(@Item));
}

function test::updatableInPlace::foldStartingFromAnElement(): Item[1]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let e = $xs->at(0);
  $xs->fold({x, acc|^$acc(v = $acc.v + $x.v)}, $e);
}

