###Pure
import test::updatableInPlace::*;

Class test::updatableInPlace::Box
{
  v: Integer[1];
}

function test::updatableInPlace::sorted<T|m>(col: T[m]): T[m]
{
  $col->sort([], [])
}

function test::updatableInPlace::same<T|m>(col: T[m]): T[m]
{
  $col
}

function test::updatableInPlace::sortedMany(): Integer[*]
{
  let xs = [2, 1]->filter(x|$x > 0);
  let s = $xs->sorted();
  $s->add(3);
}

function test::updatableInPlace::sortedStillRead(): Integer[1]
{
  let xs = [2, 1]->filter(x|$x > 0);
  let s = $xs->sorted();
  let t = $s->add(3);
  $s->size();
}

function test::updatableInPlace::sortedOneIsTheElement(b: Box[1]): Box[1]
{
  let s = $b->sorted();
  ^$s(v = 2);
}

function test::updatableInPlace::sameMany(): Integer[*]
{
  let xs = [2, 1]->filter(x|$x > 0);
  let s = $xs->same();
  let t = $s->add(3);
  $xs->size();
  $t;
}

function test::updatableInPlace::sliceResult(): Integer[*]
{
  let xs = [2, 1]->filter(x|$x > 0);
  let r = $xs->tail();
  $r->add(3);
}

function test::updatableInPlace::sliceResultStillRead(): Integer[1]
{
  let xs = [2, 1]->filter(x|$x > 0);
  let r = $xs->take(1);
  let t = $r->add(3);
  $r->size();
}

function test::updatableInPlace::sliceDoesNotRetain(): Integer[*]
{
  let xs = [2, 1]->filter(x|$x > 0);
  let r = $xs->drop(1);
  let t = $xs->add(3);
  $r->concatenate($t);
}

function test::updatableInPlace::sliceArgumentStillRead(): Integer[1]
{
  let xs = [2, 1]->filter(x|$x > 0);
  let r = $xs->slice(0, 1);
  let t = $xs->add(3);
  $xs->size();
}

