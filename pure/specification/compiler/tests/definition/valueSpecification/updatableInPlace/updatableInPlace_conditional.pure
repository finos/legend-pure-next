// A reducer that adds to its accumulator in one branch and hands it back in the other: both uses are updatable in place if
// fold passed the accumulator updatable in place, and so is the reducer's result. fold may take the start value too.
// A move out of a parameter keeps the condition: y's last use is updatable in place if p was passed updatable in place.
// A parameter something else keeps (a new instance), one captured by a lambda run repeatedly, or one captured by a
// lambda that escapes, is never updatable in place.
###Pure
import test::updatableInPlace::*;

function test::updatableInPlace::keepLarge(values: Integer[*], start: Integer[*]): Integer[*]
{
  $values->fold({e, acc|if($e > 2, |$acc->add($e), |$acc)}, $start)
}

function test::updatableInPlace::moveParameter(p: Integer[*]): Integer[*]
{
  let y = $p;
  $y->add(1);
}

function test::updatableInPlace::kept(p: Integer[*]): Integer[*]
{
  let l = ^List<Integer>(values = $p);
  $p->add(2);
}

function test::updatableInPlace::captured(p: Integer[*]): Integer[*]
{
  [1, 2]->map(i|$p->add($i))
}

function test::updatableInPlace::escapes(p: Integer[*]): Function<{->Integer[*]}>[1]
{
  |$p->add(1)
}

