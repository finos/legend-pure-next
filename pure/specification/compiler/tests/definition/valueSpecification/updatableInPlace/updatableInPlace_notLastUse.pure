// xs is read again after add: add must copy. size is its last use, and add does not retain its receiver.
// A collection literal of several values is a new collection at each evaluation: it may be given away.
// A primitive is never annotated.
###Pure
function test::updatableInPlace::notLastUse(): Integer[1]
{
  let xs = [1, 2]->map(x|$x);
  let ys = $xs->add(2);
  $xs->size();
}

function test::updatableInPlace::literal(): Integer[*]
{
  let zs = [1, 2];
  $zs->add(3);
}

function test::updatableInPlace::primitive(): String[1]
{
  let n = 1 + 2;
  $n->toString();
}

