// if runs one branch, once: each add is a last use.
// ys is read after the if: the add in the branch must copy; size is the last use.
// The else branch moves zs into w: both branches end in a value updatable in place, so w is fresh.
###Pure
function test::updatableInPlace::bothBranches(c: Boolean[1]): Integer[*]
{
  let xs = [1, 2]->map(x|$x);
  if($c, |$xs->add(1), |$xs->add(2));
}

function test::updatableInPlace::oneBranch(c: Boolean[1]): Integer[1]
{
  let ys = [1, 2]->map(x|$x);
  if($c, |$ys->add(1), |[0]);
  $ys->size();
}

function test::updatableInPlace::moveFromBranch(c: Boolean[1]): Integer[*]
{
  let zs = [1, 2]->map(x|$x);
  let w = if($c, |$zs->add(1), |$zs);
  $w->add(3);
}

