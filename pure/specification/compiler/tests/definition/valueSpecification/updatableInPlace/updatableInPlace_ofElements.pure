###Pure
import test::updatableInPlace::*;

Class test::updatableInPlace::Item
{
  v: Integer[1];
}

function test::updatableInPlace::mapOverFresh(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::chained(): Item[*]
{
  [1, 2]->map(i|^Item(v = $i))->map(x|^$x(v = 9));
}

function test::updatableInPlace::throughFilter(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let ys = $xs->filter(x|$x.v > 0);
  $ys->map(x|^$x(v = 9));
}

function test::updatableInPlace::literalOfNew(): Item[*]
{
  let xs = [^Item(v = 1), ^Item(v = 2)];
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::foldOverFresh(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  $xs->fold({x, acc|$acc->add(^$x(v = 1))}, []->cast(@Item));
}

function test::updatableInPlace::readThenMap(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let n = $xs->size();
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::readingLambdaFirst(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let vs = $xs->map(x|$x.v);
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::identityAtLastUse(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let ys = $xs->map(e|$e);
  $ys->map(y|^$y(v = 9));
}

function test::updatableInPlace::returnsFresh(): Item[*]
{
  [1, 2]->map(i|^Item(v = $i));
}

function test::updatableInPlace::throughACall(): Item[*]
{
  let xs = returnsFresh();
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::addFresh(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let ys = $xs->add(^Item(v = 3));
  $ys->map(x|^$x(v = 9));
}

function test::updatableInPlace::sharedElementReadByAt(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let e = $xs->at(0);
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::identityThenListRead(): Integer[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let ys = $xs->map(e|$e);
  let zs = $ys->map(y|^$y(v = 9));
  $xs.v;
}

function test::updatableInPlace::listReadAfter(): Integer[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let ys = $xs->map(x|^$x(v = 9));
  $xs.v;
}

function test::updatableInPlace::filterLambdaCopies(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  $xs->filter(x|^$x(v = 0).v == 0);
}

function test::updatableInPlace::aParameter(xs: Item[*]): Item[*]
{
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::objectTwice(): Item[*]
{
  let a = ^Item(v = 1);
  let xs = [$a, $a];
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::lambdaReturnsCapture(): Item[*]
{
  let a = ^Item(v = 1);
  let xs = [1, 2]->map(i|$a);
  $xs->map(x|^$x(v = 9));
}

function test::updatableInPlace::elementAddedStillHeld(): Item[*]
{
  let a = ^Item(v = 1);
  let xs = [1, 2]->map(i|^Item(v = $i));
  let ys = $xs->add($a);
  let n = $a.v;
  $ys->map(x|^$x(v = 9));
}

function test::updatableInPlace::storedList(): Item[*]
{
  let xs = [1, 2]->map(i|^Item(v = $i));
  let l = ^List<Item>(values = $xs);
  $xs->map(x|^$x(v = 9));
}

