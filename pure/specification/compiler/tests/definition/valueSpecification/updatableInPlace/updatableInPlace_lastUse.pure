// xs is bound to a fresh list (map) and its only use is add's receiver: updatable in place. ys likewise.
###Pure
function test::updatableInPlace::lastUse(): Integer[*]
{
  let xs = [1, 2, 3]->map(x|$x);
  let ys = $xs->add(7);
  $ys->add(8);
}

