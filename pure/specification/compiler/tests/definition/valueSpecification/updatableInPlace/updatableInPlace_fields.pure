// A call to a user function takes its summary: a function returning a fresh list gives a value updatable in place, and one
// returning its parameter gives a value as updatable in place as its argument was.
// A function calling itself has no summary while it is analysed: its recursive call gives a shared value, so its
// result is not updatable in place, and neither is a value bound to a call of it.
###Pure
import test::updatableInPlace::*;

// A field's collection read from an object a copy consumes, in the key replacing that field, holds the only reference
// to it when the copy's source does, the read is the object's one read of that property, every other use of the
// object reads another property, and the read is outside any lambda. A key value that is a call is marked as updatable in place as
// it is. Anything else stays shared.

Class test::updatableInPlace::Bag
{
  items: Integer[*];
  count: Integer[1];
  label: String[1];
}

function test::updatableInPlace::collect(): Bag[1]
{
  [1, 2, 3]->fold({e, acc|^$acc(items = $acc.items->add($e), count = $acc.count + 1)}, ^Bag(items = [], count = 0, label = 'b'));
}

function test::updatableInPlace::storeFresh(): Bag[1]
{
  ^Bag(items = [1, 2]->map(x|$x), count = 2, label = 'f');
}

function test::updatableInPlace::readTwice(b: Bag[1]): Bag[1]
{
  ^$b(items = $b.items->add(1), count = $b.items->size());
}

function test::updatableInPlace::earlierReadKept(): Integer[*]
{
  let b = ^Bag(items = [1, 2]->map(x|$x), count = 2, label = 'k');
  let old = $b.items;
  let c = ^$b(items = $b.items->add(3));
  $old->concatenate($c.items);
}

function test::updatableInPlace::objectStillUsed(): String[1]
{
  let b = ^Bag(items = [1, 2]->map(x|$x), count = 2, label = 's');
  let c = ^$b(items = $b.items->add(3));
  $b.label + $c.label;
}

function test::updatableInPlace::objectPassedOn(): Bag[1]
{
  let b = ^Bag(items = [1, 2]->map(x|$x), count = 2, label = 'p');
  let empty = $b->isEmpty();
  ^$b(items = $b.items->add(3), count = if($empty, |0, |1));
}

function test::updatableInPlace::readInALambda(): Bag[1]
{
  let b = ^Bag(items = [1, 2]->map(x|$x), count = 2, label = 'l');
  ^$b(items = [1, 2]->map(i|$b.items->size()));
}

function test::updatableInPlace::appended(): Bag[1]
{
  let b = ^Bag(items = [1, 2]->map(x|$x), count = 2, label = 'a');
  ^$b(items += 3);
}

function test::updatableInPlace::singleValued(): Bag[1]
{
  let b = ^Bag(items = [1, 2]->map(x|$x), count = 2, label = 'v');
  ^$b(label = $b.label + 'x');
}
