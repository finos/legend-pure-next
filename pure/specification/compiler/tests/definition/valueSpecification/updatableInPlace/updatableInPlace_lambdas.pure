// map runs its lambda once per element: the captured xs is read again on the next one.
// A lambda kept in a variable may run at any time: nothing it captures is ever updatable in place.
// zs is stored in an instance inside the lambda: an alias outlives the call.
###Pure
import test::updatableInPlace::*;

Class test::updatableInPlace::Box
{
  values: Integer[*];
}

function test::updatableInPlace::insideMap(): Integer[1]
{
  let xs = [0, 0]->map(x|$x);
  let r = [1, 2]->map(i|$xs->add($i));
  $xs->size();
}

function test::updatableInPlace::escaping(): Integer[*]
{
  let ys = [0, 0]->map(x|$x);
  let f = i:Integer[1]|$ys->add($i);
  $ys->add(9);
}

function test::updatableInPlace::leakInsideMap(): Integer[*]
{
  let zs = [0, 0]->map(x|$x);
  [1]->map(i|^Box(values = $zs));
  $zs->add(1);
}

