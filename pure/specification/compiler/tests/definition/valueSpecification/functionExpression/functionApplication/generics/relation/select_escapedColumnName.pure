###Pure
// A column name in a relation type is read as a string literal is, its escapes processed: '\'a\'' is the
// column named 'a' with its quotes, the one ~'\'a\'' names.
native function select<T,Z>(r: Relation<T>[1], cols: ColSpec<Z⊆T>[1]): Relation<Z>[1];

function f(rel: Relation<(val:Integer, '\'a\'':String)>[1]): Any[*]
{
  $rel->select(~'\'a\'')
}

