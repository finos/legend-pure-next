###Pure
import pack::*;

native function pack::doStuff(a: String[1]): String[1];

native function pack::doStuff(a: Number[1]): Number[1];

function pack::test(a: Number[1], b: Number[1]): Number[1]
{
  $a->plus($b)
}

function pack::compute(x: Number[1], y: Number[1]): Number[1]
{
  $x->plus($y)->minus($x)
}

function pack::testOverloadNumber(n: Number[1]): Number[1]
{
  $n->doStuff()
}

function pack::testOverloadString(s: String[1]): String[1]
{
  $s->doStuff()
}

