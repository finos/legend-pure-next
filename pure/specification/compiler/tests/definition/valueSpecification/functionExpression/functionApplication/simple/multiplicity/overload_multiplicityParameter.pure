###Pure
import pack::*;

// Overloads differing in their parameter's multiplicity are ranked against the argument's: an exact match
// first, then a multiplicity parameter (it binds to the argument's exactly), then a concrete multiplicity
// containing the argument's (the closest first) — the universal [*] aside, a parameter beating it.
function pack::pick<T|m>(v: T[m]): String[1]
{
  'parameter'
}

function pack::pick<T>(v: T[0..1]): String[1]
{
  'zeroOne'
}

function pack::pick<T>(v: T[*]): String[1]
{
  'many'
}

// [m] binds to [1] exactly; [0..1] only contains it
function pack::one(s: String[1]): String[1]
{
  $s->pick()
}

// [0..1] is exact
function pack::zeroOne(s: String[0..1]): String[1]
{
  $s->pick()
}

// [m] still beats the universal [*]
function pack::many(s: String[*]): String[1]
{
  $s->pick()
}

