###Pure
// A column spec typed as a subset (ColSpec<(?:String)⊆T>) given where one is expected
// (ColSpec<(?:Z)⊆T>): each side binds the other's, Z to String, so eval's result is the column's type and
// the reduce's lambdas typed by it.
native function reduce<T,V,U|m>(rel: Relation<T>[1], map: Function<{T[1]->V[*]}>[1], agg: Function<{V[*]->U[m]}>[1]): U[m];

native function eval<Z,T>(col: ColSpec<(?:Z)⊆T>[1], row: T[1]): Z[0..1];

function joinS<T>(rel: Relation<T>[1], col: ColSpec<(?:String)⊆T>[1], separator: String[1]): String[1]
{
  $rel->reduce(x|eval($col, $x), y|$y->joinStrings($separator))
}

