function test::agg<K,L,M>(mapFn: FunctionDefinition<{K[1]->L[1]}>[1], aggregateFn: FunctionDefinition<{L[*]->M[1]}>[1]): AggregateValue<K, L, M>[1]
{
  ^AggregateValue<K, L, M>(mapFn = $mapFn, aggregateFn = $aggregateFn)
}

function test::groupBy<T,U,V>(set: T[*], functions: Function<{T[1]->Any[*]}>[*], aggValues: AggregateValue<T, V, U>[*], ids: String[*]): TabularDataSet[1]
{
  ^TabularDataSet()
}

function go(): Any[*]
{
  Trade->getAll()->groupBy([f|$f.quantity], [agg(f|$f.tradeId, c|$c->count()), agg(x|$x.quantity, x|$x->sum())], ['region', 'total', 'count'])
}

