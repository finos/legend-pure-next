import test::copy::parentRef::*;

function test::copy::parentRef::testCopySelfReference(): Any[*]
{
  let n = ^Node(value = 1);
  let c = ^$n(next = ~);
}

function test::copy::parentRef::testCopyPropertyAccess(): Any[*]
{
  let c = ^Container(name = 'outer', items = ['a', 'b']);
  ^$c(echoed = ~.items);
}

function test::copy::parentRef::testCopyPropertyArrow(): Any[*]
{
  let c = ^Container(name = 'outer', items = ['a', 'b']);
  ^$c(echoed = ~.items->map(s|$s));
}

