###Pure
import test::*;

// A groupBy whose reduce takes a generic class (Pair2<T, U>[*]) the map builds: the reduce's parameter is
// Pair2<String, Integer>, its T String, and so the new column.
Class test::Pair2<T,U>
{
  a: T[0..1];
  b: U[0..1];
}

native function test::pair2<T,U>(a: T[0..1], b: U[0..1]): Pair2<T, U>[1];

native function test::firstA<T,U>(v: Pair2<T, U>[*]): T[0..1];

native function test::groupBy<T,Z,K,V,R>(r: Relation<T>[1], cols: ColSpecArray<Z⊆T>[1], agg: AggColSpecArray<{T[1]->K[0..1]}, {K[*]->V[0..1]}, R>[1]): Relation<Z+R>[1];

function test::f(rel: Relation<(grp:Integer, name:String, n:Integer)>[1]): Relation<(grp:Integer, newCol:String[0..1])>[1]
{
  $rel->groupBy(~[grp], ~[newCol : x|pair2($x.name, $x.n) : y|$y->firstA()])
}

