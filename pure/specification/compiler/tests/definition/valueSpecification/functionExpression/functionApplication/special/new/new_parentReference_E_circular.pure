###Pure
import test::new::parentRefError::*;

// `a = ~.b` and `b = ~.a` form a cycle — neither can be built before the
// other. The compiler must reject this with a circular-dependency error
// instead of silently producing one or the other empty.
function test::new::parentRefError::testParentRefCircular(): Any[*]
{
  ^Cycle(a=~.b, b=~.a);
}

