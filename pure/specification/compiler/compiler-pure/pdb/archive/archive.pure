// PDB archive packaging: turns a list of PackageableElements into the bytes of
// a .pdb archive, mirroring the reference CompressedArchiveWriter +
// PureLanguageSerialization. Each element becomes one zip entry
// "elements/<path with '/'>.<TypeName>" holding a finished FlatBuffer whose
// root is the element's *Def table (there is no wrapper table on the wire —
// the type name travels in the entry name). The archive also carries an
// "elementIndex" section (ElementIndex FlatBuffer) and a "manifest" section
// (module.json text). The zip container uses STORED entries (method 0) with
// CRC-32 = 0: readers of .pdb archives do not validate CRCs, and the reference
// deflate container is a packaging choice, not part of the format contract —
// entry parity is byte-level per entry, not per archive.

import platform::pure::functions::binary::*;
import platform::pure::compiler::helper::packageableElement::*;
import platform::pure::ui::progress::*;

// --- element envelope ---------------------------------------------------------

// A single archive entry: name + raw bytes.
Class platform::pure::compiler::pdb::archive::ArchiveEntry
{
   name : String[1];
   data : Binary[1];
}

// Path + serialized type name for one written element (feeds the elementIndex).
Class platform::pure::compiler::pdb::archive::ElementEntryInfo
{
   path     : String[1];
   typeName : String[1];
   element  : Any[1];
   // The extension writer that claimed the element; empty for m3's own kinds.
   blob     : platform::pure::metamodel::function::Function<{Any[1]->Binary[1]}>[0..1];
}




// The two generated dispatches, behind names. Every mangled string in this file
// appears exactly once; callers — archive internals and archiveTests alike — see
// ordinary typed functions and carry no dependency on pdb::gen.
function platform::pure::compiler::pdb::archive::elementTypeName(e:Any[1]):String[0..1]
{
   // evaluate returns Any[*]; head() narrows to the declared [0..1] — the
   // generated dispatch yields [] for element kinds it has no arm for.
   platform::pure::functions::lang::eval(
      platform::pure::compiler::pdb::writerHelper::genFn('elementTypeName_Any_1__String_$0_1$_')
         ->cast(@platform::pure::metamodel::function::Function<{Any[1]->String[0..1]}>), $e);
}

function platform::pure::compiler::pdb::archive::writeElementBlob(e:Any[1]):Binary[1]
{
   platform::pure::functions::lang::eval(
      platform::pure::compiler::pdb::writerHelper::genFn('writeElementBlob_Any_1__Binary_1_')
         ->cast(@platform::pure::metamodel::function::Function<{Any[1]->Binary[1]}>), $e);
}

// "elements/platform/pure/metamodel/type/Any.Class" — the reference entry naming.
function platform::pure::compiler::pdb::archive::entryName(path:String[1], typeName:String[1]):String[1]
{
   'elements/' + $path->split('::')->joinStrings('/') + '.' + $typeName;
}

// The elements with their paths and type names, each written by the first extension whose `pdb`
// claims it — m3's own kinds by pureExtension(). ###Pure is never optional, so pureExtension() is put
// first when the list does not name it, and a list that does is used as given. One nobody claims FAILS —
// it used to be dropped silently, which left a PDB that compiled fine and was missing the element. Wire
// contract (mirrors CompressedArchiveWriter): entries SORTED by path — deterministic regardless of the
// producing compiler's registration order.
function platform::pure::compiler::pdb::archive::elementEntryInfos(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*]):platform::pure::compiler::pdb::archive::ElementEntryInfo[*]
{
   let all = platform::pure::compiler::pdb::archive::withPureExtension($extensions);
   $elements->map(e | platform::pure::compiler::pdb::archive::entryInfo($e, $all))
      ->sort({a, b | $a.path->compare($b.path)});
}

// The extensions with ###Pure's first, unless they already include it (by name).
function platform::pure::compiler::pdb::archive::withPureExtension(extensions:platform::pure::compiler::extension::CompilerExtension[*]):platform::pure::compiler::extension::CompilerExtension[*]
{
   let pure = platform::pure::compiler::extension::pureExtension();
   if($extensions->exists(x | $x.name == $pure.name), | $extensions, | $pure->concatenate($extensions));
}

function platform::pure::compiler::pdb::archive::entryInfo(e:Any[1], extensions:platform::pure::compiler::extension::CompilerExtension[*]):platform::pure::compiler::pdb::archive::ElementEntryInfo[1]
{
   let path  = $e->cast(@platform::pure::metamodel::PackageableElement)->fullPath();
   let claim = $extensions.pdb->filter(s | $s.elementTypeName->eval($e)->isNotEmpty())->head();
   if($claim->isEmpty(),
      | fail('PDB writer: no serializer for ' + $path + ' ('
             + platform::pure::functions::meta::type($e)->cast(@platform::pure::metamodel::PackageableElement)->fullPath() + ')');
        ^platform::pure::compiler::pdb::archive::ElementEntryInfo(path = $path, typeName = '', element = $e);,
      | ^platform::pure::compiler::pdb::archive::ElementEntryInfo(path = $path, element = $e,
           typeName = $claim->toOne().elementTypeName->eval($e)->toOne(),
           blob     = $claim->toOne().writeElementBlob));
}

// (Not `entryBytes`: that short name is the archive READ native, and the JavaScript translator binds
// natives by short name.)
function platform::pure::compiler::pdb::archive::elementBytes(info:platform::pure::compiler::pdb::archive::ElementEntryInfo[1]):Binary[1]
{
   if($info.blob->isEmpty(),
      | platform::pure::compiler::pdb::archive::writeElementBlob($info.element),
      | $info.blob->toOne()->eval($info.element));
}

// --- elementIndex section ------------------------------------------------------

// ElementIndex FlatBuffer: per entry, createString(path) then createString(type)
// (plain, NOT shared — the reference uses builder.createString here), then the
// entry table adding element_type (slot 1) BEFORE element_path (slot 0) — the
// flatc createElementIndexEntry add order — then the offset vector and the
// single-field ElementIndex root.
function platform::pure::compiler::pdb::archive::elementIndexBytes(infos:platform::pure::compiler::pdb::archive::ElementEntryInfo[*]):Binary[1]
{
   let acc = $infos->fold({info, acc |
      let po = $acc.builder->platform::pure::compiler::pdb::fbb::createString($info.path);
      let to = $po.builder->platform::pure::compiler::pdb::fbb::createString($info.typeName);
      let t  = $to.builder->platform::pure::compiler::pdb::fbb::startObject(2)
                          ->platform::pure::compiler::pdb::fbb::addFieldOffset(1, $to.offset)
                          ->platform::pure::compiler::pdb::fbb::addFieldOffset(0, $po.offset)
                          ->platform::pure::compiler::pdb::fbb::endObject();
      ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = $t.builder, offsets = $acc.offsets->concatenate($t.offset));
   }, ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = platform::pure::compiler::pdb::fbb::newBuilder(), offsets = []));
   let vec = platform::pure::compiler::pdb::writerHelper::createOffsetVector($acc.builder, $acc.offsets);
   let idx = $vec.builder->platform::pure::compiler::pdb::fbb::startObject(1)
                         ->platform::pure::compiler::pdb::fbb::addFieldOffset(0, $vec.offset)
                         ->platform::pure::compiler::pdb::fbb::endObject();
   $idx.builder->platform::pure::compiler::pdb::fbb::finish($idx.offset)->platform::pure::compiler::pdb::fbb::result();
}

// --- functionIndex section -------------------------------------------------------

// FunctionIndex FlatBuffer, mirroring the reference serializeFunctionIndex
// (bootstrap) / writeFunctionIndex (truffle): ONE builder for the whole
// section (cross-entry vtable dedup, unlike the per-element blobs); entries in
// element order. Per entry: createString(full_path), createString(function_name),
// the FunctionTypeDef table, then the entry table adding function_type (slot 2),
// function_name (slot 1), full_path (slot 0), is_native (slot 3, bool default
// false) — the flatc createFunctionIndexEntry add order — then the offset
// vector and the single-field FunctionIndex root.
function platform::pure::compiler::pdb::archive::functionIndexBytes(fnInfos:platform::pure::compiler::pdb::archive::ElementEntryInfo[*]):Binary[1]
{
   let acc = $fnInfos->fold(
      {info, acc | platform::pure::compiler::pdb::archive::functionIndexEntryStep($info, $acc)},
      ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = platform::pure::compiler::pdb::fbb::newBuilder(), offsets = []));
   let vec = platform::pure::compiler::pdb::writerHelper::createOffsetVector($acc.builder, $acc.offsets);
   let idx = $vec.builder->platform::pure::compiler::pdb::fbb::startObject(1)
                         ->platform::pure::compiler::pdb::fbb::addFieldOffset(0, $vec.offset)
                         ->platform::pure::compiler::pdb::fbb::endObject();
   $idx.builder->platform::pure::compiler::pdb::fbb::finish($idx.offset)->platform::pure::compiler::pdb::fbb::result();
}

function platform::pure::compiler::pdb::archive::functionIndexEntryStep(info:platform::pure::compiler::pdb::archive::ElementEntryInfo[1], acc:platform::pure::compiler::pdb::writerHelper::StringsAndBuilder[1]):platform::pure::compiler::pdb::writerHelper::StringsAndBuilder[1]
{
   let fn = $info.element->cast(@platform::pure::metamodel::function::PackageableFunction<Any>);
   let po = $acc.builder->platform::pure::compiler::pdb::fbb::createString($info.path);
   let no = $po.builder->platform::pure::compiler::pdb::fbb::createString($fn.functionName->toOne());
   // The FunctionType lives in slot 0 of the classifier's typeArguments —
   // Function<{params -> retType}> — same resolution as the reference
   // writeFunctionTypeOf. Fresh write stack: the reference writer's stack is
   // empty between top-level write calls.
   let ft = $fn.classifierGenericType->toOne().typeArguments->at(0)
               ->cast(@platform::pure::metamodel::type::generics::GenericTypeValue).type
               ->cast(@platform::pure::metamodel::type::FunctionType);
   let fo = platform::pure::compiler::pdb::writerHelper::evalGenWrite(
               'writeFunctionType_Builder_1__FunctionType_1__Any_MANY__BuilderAndOffset_1_',
               $no.builder, $ft, []);
   let t  = $fo.builder->platform::pure::compiler::pdb::fbb::startObject(4)
               ->platform::pure::compiler::pdb::fbb::addFieldOffset(2, $fo.offset)
               ->platform::pure::compiler::pdb::fbb::addFieldOffset(1, $no.offset)
               ->platform::pure::compiler::pdb::fbb::addFieldOffset(0, $po.offset)
               ->platform::pure::compiler::pdb::fbb::addFieldScalar(3, if($info.typeName == 'NativeFunction', | 1, | 0), 0, 1)
               ->platform::pure::compiler::pdb::fbb::endObject();
   ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = $t.builder, offsets = $acc.offsets->concatenate($t.offset));
}

// --- reverseReferenceIndex section -------------------------------------------------

// UTF-8 text, `target:` line then two-space-indented caller lines, targets and
// callers each sorted lexicographically — character-for-character the reference
// ReverseIndexSection.serialize (shared with the test ###ReverseIndex renderer).
// Callers are already unique (recordReference dedups on insert; the reference
// keeps them in a Set).
function platform::pure::compiler::pdb::archive::reverseIndexText(referencedBy:Map<String, List<String>>[1]):String[1]
{
   $referencedBy->keys()->sort()->map(target |
      $target + ':\n' +
      $referencedBy->get($target)->toOne().values->sort()->map(c | '  ' + $c + '\n')->joinStrings(''))
   ->joinStrings('');
}

// Adapter for hosts that carry the (already partition-filtered) reverse index
// as parallel primitive lists — targets[i] with its callers '\n'-joined — so
// they can call the Map-taking writeArchive without host-side Pure-Map
// construction. Paths never contain '\n', so the join is lossless.
function platform::pure::compiler::pdb::archive::referencedByFromLists(targets:String[*], joinedCallers:String[*]):Map<String, List<String>>[1]
{
   newMap($targets->zip($joinedCallers)->map(p |
      pair($p.first, ^List<String>(values = $p.second->split('\n')))));
}

// --- manifest section -----------------------------------------------------------

// One JSON string value, escaped as the reference ModuleManifest.quote does.
// (Control characters below 0x20 other than \n \r \t would need \u escapes;
// module names and package patterns never contain them.)
function platform::pure::compiler::pdb::archive::quoteJson(s:String[1]):String[1]
{
   '"' + $s->chunk(1)->map(c |
      if([pair(| $c == '\\', | '\\\\'),
          pair(| $c == '"',  | '\\"'),
          pair(| $c == '\n', | '\\n'),
          pair(| $c == '\r', | '\\r'),
          pair(| $c == '\t', | '\\t')],
         | $c))->joinStrings('') + '"';
}

// module.json text — character-for-character the reference ModuleManifest.toJson.
function platform::pure::compiler::pdb::archive::manifestJson(name:String[1], packagePattern:String[1], dependencies:String[*]):String[1]
{
   '{\n' +
   '  "name": ' + platform::pure::compiler::pdb::archive::quoteJson($name) + ',\n' +
   '  "packagePattern": ' + platform::pure::compiler::pdb::archive::quoteJson($packagePattern) + ',\n' +
   '  "dependencies": [' + $dependencies->map(d | platform::pure::compiler::pdb::archive::quoteJson($d))->joinStrings(', ') + ']\n' +
   '}\n';
}

// --- STORED zip container --------------------------------------------------------

function platform::pure::compiler::pdb::archive::u16(v:Integer[1]):Binary[1]
{
   intToLeBytes($v, 2);
}

function platform::pure::compiler::pdb::archive::u32(v:Integer[1]):Binary[1]
{
   intToLeBytes($v, 4);
}

// Minimal STORED zip: local header + data per entry, then the central
// directory, then EOCD. Method 0, flags 0, DOS timestamp 1980-01-01 (date
// 0x21, time 0), CRC-32 = 0 (not validated by .pdb readers). Field layout
// follows APPNOTE; sizes are exact since nothing is compressed.
//
// Assembly is O(n): local-header offsets are prefix sums over per-entry
// sizes (integers only), then each region is produced by ONE ->map whose
// per-entry lambdas return byte lists — map flattens, so the runtime
// assembles each region linearly. (An earlier fold that concatenated the
// accumulated locals per entry re-copied the whole archive once per entry —
// quadratic, minutes of copying on a full compiler.pdb write.)
function platform::pure::compiler::pdb::archive::zipStored(entries:platform::pure::compiler::pdb::archive::ArchiveEntry[*]):Binary[1]
{
   // Per-entry total size of (local header + name + data): 30 fixed + name + data.
   let sizes = $entries->map(e | 30 + stringToUtf8Bytes($e.name)->binarySize() + $e.data->binarySize());
   // offsets->at(i) = local-header offset of entry i; last value = central-dir offset.
   let offsets = $sizes->fold({s, acc | $acc->concatenate($acc->at($acc->size() - 1) + $s)}, [0]);
   let locals = range(0, $entries->size())->map(i |
      platform::pure::compiler::pdb::archive::zipLocalBytes($entries->at($i)))->binaryConcat();
   let central = range(0, $entries->size())->map(i |
      platform::pure::compiler::pdb::archive::zipCentralBytes($entries->at($i), $offsets->at($i)))->binaryConcat();
   let n = $entries->size();
   // disk number, central-dir start disk, entries on disk, entries total,
   // central dir size, central dir offset, comment length.
   let eocd = [0x504B0506]->concatenate(
      [pair(0, 2), pair(0, 2), pair($n, 2), pair($n, 2),
       pair($central->binarySize(), 4), pair($offsets->at($n), 4), pair(0, 2)]
         ->map(f | intToLeBytes($f.first, $f.second)))->binaryConcat();
   [$locals, $central, $eocd]->binaryConcat();
}

// One entry's local header + name + data. Header fields as (value, width)
// pairs mapped through intToLeBytes — map flattens, keeping both the
// expression tree shallow (a long ->concatenate chain trips the interpreter's
// protocol-conversion depth guard on the self-host parse) and the value list
// flat. Field order: version-needed, flags, method(stored), mod-time,
// mod-date(1980-01-01), crc-32(0), compressed size, uncompressed size,
// name len, extra len.
function platform::pure::compiler::pdb::archive::zipLocalBytes(e:platform::pure::compiler::pdb::archive::ArchiveEntry[1]):Binary[1]
{
   let nameBytes = stringToUtf8Bytes($e.name);
   let dataLen   = $e.data->binarySize();
   [0x504B0304]->concatenate(
      [pair(20, 2), pair(0, 2), pair(0, 2), pair(0, 2), pair(33, 2),
       pair(0, 4), pair($dataLen, 4), pair($dataLen, 4), pair($nameBytes->binarySize(), 2), pair(0, 2)]
         ->map(f | intToLeBytes($f.first, $f.second)))
      ->concatenate($nameBytes)
      ->concatenate($e.data)
      ->binaryConcat();
}

// One entry's central-directory record. Field order: version-made-by,
// version-needed, flags, method, mod-time, mod-date, crc-32, compressed size,
// uncompressed size, name len, extra len, comment len, disk start,
// internal attrs, external attrs, local offset.
function platform::pure::compiler::pdb::archive::zipCentralBytes(e:platform::pure::compiler::pdb::archive::ArchiveEntry[1], localOffset:Integer[1]):Binary[1]
{
   let nameBytes = stringToUtf8Bytes($e.name);
   let dataLen   = $e.data->binarySize();
   [0x504B0102]->concatenate(
      [pair(20, 2), pair(20, 2), pair(0, 2), pair(0, 2), pair(0, 2), pair(33, 2),
       pair(0, 4), pair($dataLen, 4), pair($dataLen, 4), pair($nameBytes->binarySize(), 2),
       pair(0, 2), pair(0, 2), pair(0, 2), pair(0, 2), pair(0, 4), pair($localOffset, 4)]
         ->map(f | intToLeBytes($f.first, $f.second)))
      ->concatenate($nameBytes)
      ->binaryConcat();
}

// --- whole archive ----------------------------------------------------------------

// All entries of a .pdb for the given elements: one element entry per
// serializable element (declaration order), then elementIndex (omitted when no
// element was written, as the reference does), then manifest, then functionIndex
// (omitted when no function was written), then reverseReferenceIndex (omitted
// when no reference was recorded) — the reference CompressedArchiveWriter
// section order (extension sections before caller-provided ones).
function platform::pure::compiler::pdb::archive::archiveEntries(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*], referencedBy:Map<String, List<String>>[1]):platform::pure::compiler::pdb::archive::ArchiveEntry[*]
{
   platform::pure::compiler::pdb::archive::archiveEntries($elements, $extensions, $moduleName, $packagePattern, $dependencies, $referencedBy, []);
}

// With a `progressLabel`, a progress bar counts the elements as their blobs are written: what a CLI
// compile shows while it writes a PDB. Without one nothing is printed, as tests need: they run inside
// a progress bar of their own.
function platform::pure::compiler::pdb::archive::archiveEntries(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*], referencedBy:Map<String, List<String>>[1], progressLabel:String[0..1]):platform::pure::compiler::pdb::archive::ArchiveEntry[*]
{
   let infos = platform::pure::compiler::pdb::archive::elementEntryInfos($elements, $extensions);
   let total = $infos->size();
   let shown = $progressLabel->isNotEmpty();
   if($shown, | startProgress($progressLabel->toOne() + ' (' + $total->toString() + ' elements)'), | true);
   let elementEntries = range(0, $total)->map(n |
      let i = $infos->at($n);
      if($shown, | tickProgress($n + 1, $total, $i.path), | true);
      ^platform::pure::compiler::pdb::archive::ArchiveEntry(
         name = platform::pure::compiler::pdb::archive::entryName($i.path, $i.typeName),
         data = platform::pure::compiler::pdb::archive::elementBytes($i));
   );
   if($shown, | finishProgress(), | true);
   let indexEntry = if($infos->isEmpty(),
      | [],
      | ^platform::pure::compiler::pdb::archive::ArchiveEntry(
           name = 'elementIndex',
           data = platform::pure::compiler::pdb::archive::elementIndexBytes($infos)));
   let manifestEntry = ^platform::pure::compiler::pdb::archive::ArchiveEntry(
      name = 'manifest',
      data = stringToUtf8Bytes(platform::pure::compiler::pdb::archive::manifestJson($moduleName, $packagePattern, $dependencies)));
   let fnInfos = $infos->filter(i | ['UserDefinedFunction', 'NativeFunction']->contains($i.typeName));
   let functionIndexEntry = if($fnInfos->isEmpty(),
      | [],
      | ^platform::pure::compiler::pdb::archive::ArchiveEntry(
           name = 'functionIndex',
           data = platform::pure::compiler::pdb::archive::functionIndexBytes($fnInfos)));
   let reverseEntry = if($referencedBy->keys()->isEmpty(),
      | [],
      | ^platform::pure::compiler::pdb::archive::ArchiveEntry(
           name = 'reverseReferenceIndex',
           data = stringToUtf8Bytes(platform::pure::compiler::pdb::archive::reverseIndexText($referencedBy))));
   $elementEntries->concatenate($indexEntry)->concatenate($manifestEntry)
      ->concatenate($functionIndexEntry)->concatenate($reverseEntry);
}

// No recorded references: the archive has no reverse index.
function platform::pure::compiler::pdb::archive::archiveEntries(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*]):platform::pure::compiler::pdb::archive::ArchiveEntry[*]
{
   platform::pure::compiler::pdb::archive::archiveEntries($elements, $extensions, $moduleName, $packagePattern, $dependencies,
      newMap([]->cast(@Pair<String, List<String>>)));
}

// A whole .pdb archive as bytes, language extensions' elements included.
function platform::pure::compiler::pdb::archive::writeArchive(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*], referencedBy:Map<String, List<String>>[1]):Binary[1]
{
   platform::pure::compiler::pdb::archive::zipStored(
      platform::pure::compiler::pdb::archive::archiveEntries($elements, $extensions, $moduleName, $packagePattern, $dependencies, $referencedBy));
}

// Same, with a progress bar labelled `progressLabel` while the elements are written (see archiveEntries).
function platform::pure::compiler::pdb::archive::writeArchive(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*], referencedBy:Map<String, List<String>>[1], progressLabel:String[1]):Binary[1]
{
   platform::pure::compiler::pdb::archive::zipStored(
      platform::pure::compiler::pdb::archive::archiveEntries($elements, $extensions, $moduleName, $packagePattern, $dependencies, $referencedBy, $progressLabel));
}

// A whole .pdb archive as bytes, without a reverse index.
function platform::pure::compiler::pdb::archive::writeArchive(elements:Any[*], extensions:platform::pure::compiler::extension::CompilerExtension[*], moduleName:String[1], packagePattern:String[1], dependencies:String[*]):Binary[1]
{
   platform::pure::compiler::pdb::archive::zipStored(
      platform::pure::compiler::pdb::archive::archiveEntries($elements, $extensions, $moduleName, $packagePattern, $dependencies));
}
