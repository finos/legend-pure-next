// A tiny metamodel the fbsgen tests generate a schema for — shaped like the diagram extension's:
// a PackageableElement root, a nested value class, a pointer to an m3 Type, a small taxonomy and
// Float fields.

Class platform::pure::compiler::pdb::fbsgen::tests::model::Spot
{
   x : Float[1];
   y : Float[1];
}

Class platform::pure::compiler::pdb::fbsgen::tests::model::Box
{
   id   : String[1];
   at   : platform::pure::compiler::pdb::fbsgen::tests::model::Spot[1];
   <<platform::pure::metamodel::ProtocolInfo.pointer>> type : platform::pure::metamodel::type::Type[0..1];
}

Class platform::pure::compiler::pdb::fbsgen::tests::model::Edge
{
   from : String[1];
   to   : String[1];
}

Class platform::pure::compiler::pdb::fbsgen::tests::model::LabelledEdge extends platform::pure::compiler::pdb::fbsgen::tests::model::Edge
{
   label : String[0..1];
}

Class platform::pure::compiler::pdb::fbsgen::tests::model::Sheet extends platform::pure::metamodel::PackageableElement
{
   width : Float[0..1];
   boxes : platform::pure::compiler::pdb::fbsgen::tests::model::Box[*];
   edges : platform::pure::compiler::pdb::fbsgen::tests::model::LabelledEdge[*];
}
