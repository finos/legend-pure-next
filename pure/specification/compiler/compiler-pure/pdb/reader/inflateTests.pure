// Tests for the Pure DEFLATE decoder (pdb/reader/inflate.pure). Each stream was produced by
// zlib (deflateRawSync) or taken from a Java-written golden archive, and must decode to the
// exact original bytes.

import meta::pure::functions::binary::*;

// Block type 0: raw bytes after a byte-aligned LEN/NLEN header.
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testStoredBlock():Boolean[1]
{
   let deflated = [
      1, 16, 0, 239, 255, 80, 68, 66, 32, 115, 116, 111, 114, 101, 100, 32, 98, 108, 111, 99, 107
   ];
   assertEquals('PDB stored block', utf8BytesToString(meta::pure::compiler::pdb::reader::inflate::inflate($deflated, 16)));
}

// Block type 1: the fixed code, with back-references.
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testFixedHuffman():Boolean[1]
{
   let deflated = [
      75, 76, 74, 78, 68, 66, 10, 25, 169, 57, 57, 249, 16, 18, 0
   ];
   assertEquals('abcabcabcabcabc hello hello', utf8BytesToString(meta::pure::compiler::pdb::reader::inflate::inflate($deflated, 27)));
}

// Block type 2: code-length code, repeat codes and dynamic literal/distance tables.
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testDynamicHuffman():Boolean[1]
{
   let deflated = [
      237, 144, 177, 10, 132, 48, 12, 134, 95, 197, 231, 200, 42, 14, 55, 136, 130, 219, 109, 229, 46, 72, 160, 73,
      75, 76, 135, 190, 253, 21, 78, 193, 161, 10, 206, 186, 133, 36, 255, 247, 193, 207, 104, 14, 32, 38, 69, 0,
      46, 51, 135, 47, 122, 0, 203, 177, 44, 38, 83, 146, 185, 79, 222, 40, 122, 250, 144, 229, 214, 187, 101, 105,
      222, 168, 161, 119, 146, 71, 13, 17, 213, 50, 159, 65, 94, 98, 56, 163, 142, 229, 58, 8, 118, 146, 24, 213,
      25, 5, 105, 14, 240, 107, 224, 146, 228, 143, 170, 56, 54, 202, 145, 101, 141, 92, 144, 236, 73, 53, 211, 134,
      170, 88, 118, 239, 252, 244, 126, 139, 222, 127
   ];
   assertEquals('meta::pure::metamodel::type::StringMultiplicityClass ZeroManyPropertymeta::pure::metamodel::type::IntegerPureOneEnumeration StringMultiplicityClassIntegerZeroManyPropertymeta::pure::metamodel::type::StringPureOneEnumeration ZeroManyMultiplicityClassIntegerPureOnePropertymeta::pure::metamodel::type::StringMultiplicityEnumeration ZeroManyPropertyClassIntegerPureOneEnumerationmeta::pure::metamodel::type::StringMultiplicityClass ZeroManyPropertymeta::pure::metamodel::type::IntegerPureOneEnumeration StringMultiplicityClassIntegerZeroManyPropertymeta::pure::metamodel::type::StringPureOneEnumeration ZeroManyMultiplicityClassIntegerPureOnePropertymeta::pure::metamodel::type::StringMultiplicityEnumeration ZeroManyPropertyClassIntegerPureOneEnumerationmeta::pure::metamodel::type::StringMultiplicityClass ZeroManyPropertymeta::pure::metamodel::type::IntegerPureOne', utf8BytesToString(meta::pure::compiler::pdb::reader::inflate::inflate($deflated, 864)));
}

// Two blocks separated by a sync flush (an empty stored block in between).
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testTwoBlocks():Boolean[1]
{
   let deflated = [
      74, 203, 44, 42, 46, 81, 72, 202, 201, 79, 206, 86, 200, 79, 83, 40, 73, 173, 40, 209, 81, 72, 195, 20,
      4, 0, 0, 0, 255, 255, 83, 40, 201, 72, 205, 3, 17, 10, 197, 169, 201, 249, 121, 41, 16, 89, 29, 20,
      30, 0
   ];
   assertEquals('first block of text, first block of text then the second block, second block', utf8BytesToString(meta::pure::compiler::pdb::reader::inflate::inflate($deflated, 76)));
}

// Matches whose distance is shorter than their length (runs and short periods).
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testOverlappingCopies():Boolean[1]
{
   let deflated = [
      171, 72, 36, 22, 36, 37, 147, 141, 0
   ];
   assertEquals('xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabc', utf8BytesToString(meta::pure::compiler::pdb::reader::inflate::inflate($deflated, 101)));
}

// An empty input: one final fixed block holding only end-of-block.
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testEmptyStream():Boolean[1]
{
   assertEmpty(meta::pure::compiler::pdb::reader::inflate::inflate([3, 0], 0));
}

// A golden archive manifest entry (fixed code), as the Java reference writer compressed it.
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testGoldenManifestEntry():Boolean[1]
{
   let deflated = [
      171, 230, 82, 80, 80, 202, 75, 204, 77, 85, 178, 82, 80, 42, 73, 45, 46, 81, 210, 1, 137, 20, 36, 38,
      103, 39, 166, 167, 6, 36, 150, 148, 164, 22, 229, 129, 228, 180, 32, 18, 41, 169, 5, 169, 121, 41, 169, 121,
      201, 153, 169, 197, 64, 225, 104, 165, 228, 252, 162, 84, 165, 88, 174, 90, 46, 0
   ];
   assertEquals('{\n  "name": "test",\n  "packagePattern": "*",\n  "dependencies": ["core"]\n}\n', utf8BytesToString(meta::pure::compiler::pdb::reader::inflate::inflate($deflated, 74)));
}

// The smallest dynamic-code golden entry: valueSpecification/genericTypeAndMultiplicityHolder/relation/simpleColumn.pdb!reverseReferenceIndex
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testGoldenDynamicEntry():Boolean[1]
{
   let deflated = [
      21, 140, 45, 14, 128, 48, 12, 70, 61, 167, 216, 21, 176, 159, 67, 129, 193, 16, 124, 179, 140, 66, 154, 148,
      178, 140, 78, 236, 246, 12, 253, 126, 110, 246, 8, 228, 90, 24, 56, 171, 37, 151, 199, 94, 64, 163, 93, 64,
      138, 175, 211, 100, 141, 110, 162, 153, 141, 139, 164, 189, 101, 158, 236, 88, 171, 186, 100, 149, 36, 222, 150, 71,
      15, 46, 52, 18, 237, 93, 196, 16, 130, 115, 239, 104, 99, 141, 255, 174, 147, 225, 3
   ];
   assertEquals('meta::pure::functions::lang::cast_Any_m__GenericTypeAndMultiplicityHolder_1__T_m_:\n  test__Relation_1_\n', utf8BytesToString(meta::pure::compiler::pdb::reader::inflate::inflate($deflated, 103)));
}

// A whole Java-written golden archive: every entry is DEFLATE-compressed, and zipEntryData inflates
// them to their central-directory sizes; the manifest reads back as text and an element entry decodes.
function <<test.Test>> meta::pure::compiler::pdb::reader::inflate::tests::testGoldenArchive():Boolean[1]
{
   let bytes   = meta::pure::compiler::pdb::reader::inflate::tests::primitiveSimpleArchive();
   let entries = meta::pure::compiler::pdb::reader::readZipEntries($bytes);
   assertEquals(['elements/protocol.Package', 'elements/protocol/Varchar.PrimitiveType', 'elementIndex', 'manifest'], $entries.name);
   assertEquals([8, 8, 8, 8], $entries.method);
   assertEquals([260, 816, 136, 74], $entries->map(e | meta::pure::compiler::pdb::reader::zipEntryData($bytes, $e)->size()));
   assertEquals('{\n  "name": "test",\n  "packagePattern": "*",\n  "dependencies": ["core"]\n}\n', utf8BytesToString(meta::pure::compiler::pdb::reader::zipEntryData($bytes, $entries->at(3))));
   let node = meta::pure::compiler::pdb::reader::elementNode(meta::pure::compiler::pdb::reader::zipEntryData($bytes, $entries->at(0)), 'Package');
   assertEquals('protocol', meta::pure::compiler::pdb::reader::readField(meta::pure::compiler::pdb::reader::tests::testSchema(), $node, 'name'));
}

