// PDB writer GENERATOR in Pure — walks (metamodel x parsed m3.fbs) and emits
// the type-specific writer, porting the reference RdfFbsJavaGenerator's
// decisions. This file: the two correctness-critical INPUT layers —
//   (1) property order (== the reference's field-ADD order, which determines
//       byte layout): Any's properties FIRST, then hierarchy DFS with parents
//       fully before self, each class's own properties in declaration order,
//       deduped by name keeping the first occurrence (ModelUtils.collectAllProperties);
//   (2) property name -> fbs field name (ModelUtils.toFbsFieldName): camelCase ->
//       snake_case; only `type`/`namespace` gain a trailing `_`.
import platform::pure::metamodel::type::*;
import platform::pure::metamodel::function::property::*;
import platform::pure::compiler::pdb::schema::*;
import platform::pure::compiler::pdb::generator::*;

// --- (1) property order -------------------------------------------------------

function platform::pure::compiler::pdb::generator::allWriterProperties(cls:Class<Any>[1]):Property<Nil, Any|*>[*]
{
   let anyCls  = platform::pure::functions::meta::pathToElement('platform::pure::metamodel::type::Any')->cast(@Class<Any>);
   let anyProps = if($cls == $anyCls, | [], | $anyCls.properties->cast(@Property<Nil, Any|*>));
   let rest = platform::pure::compiler::pdb::generator::hierarchyProperties($cls);
   // dedup by name, first occurrence wins (Any's first, then ancestors, then own);
   // skip <<ProtocolInfo.excluded>> properties (reference hasStereotype 'excluded').
   let all = $anyProps->concatenate($rest)
      ->filter(p | !$p.stereotypes->exists(s |
            if($s->instanceOf(platform::pure::metamodel::pointer::StereotypePointer),
               | $s->cast(@platform::pure::metamodel::pointer::StereotypePointer).element == 'excluded',
               | $s.value == 'excluded')));
   $all->fold({p, acc | if($acc.name->contains($p.name->toOne()), | $acc, | $acc->concatenate($p))},
              []->cast(@Property<Nil, Any|*>));
}

// DFS: parents fully before self; own properties in declaration order.
function platform::pure::compiler::pdb::generator::hierarchyProperties(cls:Class<Any>[1]):Property<Nil, Any|*>[*]
{
   let parents = $cls.generalizations.general
      ->map(g:platform::pure::metamodel::type::generics::GenericType[1] | $g->platform::pure::metamodel::type::rawType())
      ->filter(t:Type[1] | $t->instanceOf(Class) && ($t->cast(@Class<Any>)->elementToPath() != 'platform::pure::metamodel::type::Any'))
      ->map(t:Type[1] | $t->cast(@Class<Any>));
   $parents->map(p | platform::pure::compiler::pdb::generator::hierarchyProperties($p))
      ->concatenate($cls.properties->cast(@Property<Nil, Any|*>));
}

// --- (2) name mapping ----------------------------------------------------------

// camelCase -> snake_case; only fbs-reserved `type`/`namespace` gain `_`.
// (`p_tags` has no uppercase and passes through unchanged.)
function platform::pure::compiler::pdb::generator::toFbsFieldName(name:String[1]):String[1]
{
   let chars = $name->chunk(1);
   let snake = range(0, $chars->size())->map(i |
      let c = $chars->at($i);
      if(($c != $c->toLower()) && ($i > 0),
         | '_' + $c->toLower(),
         | $c->toLower());
   )->joinStrings('');
   if(($snake == 'type') || ($snake == 'namespace'), | $snake + '_', | $snake);
}

// Resolve an fbs field back to the class's property (generation-time, so the
// ambiguous reverse mapping — e.g. p_tags — is settled against real names).
function platform::pure::compiler::pdb::generator::propertyForFbsField(props:Property<Nil, Any|*>[*], fbsField:String[1]):Property<Nil, Any|*>[0..1]
{
   $props->filter(p | platform::pure::compiler::pdb::generator::toFbsFieldName($p.name->toOne()) == $fbsField)->head();
}

// --- (3) writer-class discovery ---------------------------------------------------

function platform::pure::compiler::pdb::generator::stereotypeName(s:Any[1]):String[1]
{
   if($s->instanceOf(platform::pure::metamodel::pointer::StereotypePointer),
      | $s->cast(@platform::pure::metamodel::pointer::StereotypePointer).element->toOne(),
      | $s->cast(@platform::pure::metamodel::extension::Stereotype).value->toOne());
}

function platform::pure::compiler::pdb::generator::hasClassStereotype(cls:Class<Any>[1], name:String[1]):Boolean[1]
{
   $cls.stereotypes->exists(s | stereotypeName($s) == $name);
}

function platform::pure::compiler::pdb::generator::classesInPackage(pkg:platform::pure::metamodel::Package[1]):Class<Any>[*]
{
   $pkg.children->map(c:platform::pure::metamodel::PackageableElement[1] |
      if($c->instanceOf(platform::pure::metamodel::Package),
         | classesInPackage($c->cast(@platform::pure::metamodel::Package)),
         | if($c->instanceOf(Class), | [$c->cast(@Class<Any>)], | []->cast(@Class<Any>))));
}

// WHAT a generated writer is for. m3's (generatedWriter.pure): the metamodel package, every table
// and union of m3.fbs, emitted into pdb::gen. A language extension's: its metamodel package, the
// tables and unions of the fragment pdb/fbsgen generated for it, emitted into the extension's own
// namespace — `schema` is then m3.fbs + the fragment, because the fragment's tables refer to m3's
// (SourceInformationDef, TypePropertyUnion, …) and the writer calls m3's generated functions for those.
Class platform::pure::compiler::pdb::generator::WriterTarget
{
   packages  : String[*];
   ns        : String[1];
   schema    : FbsSchema[1];
   ownTables : String[*];
   ownUnions : String[*];
   m3        : Boolean[1];
}

function platform::pure::compiler::pdb::generator::m3Ns():String[1]
{
   'platform::pure::compiler::pdb::gen';
}

function platform::pure::compiler::pdb::generator::m3Target(schema:FbsSchema[1]):WriterTarget[1]
{
   ^WriterTarget(packages = 'platform::pure::metamodel', ns = m3Ns(), schema = $schema,
                 ownTables = $schema.tables.name, ownUnions = $schema.unions.name, m3 = true);
}

// The namespace whose generated writeX / writeUnion_X serves a table or union: the target's own,
// or m3's for everything the target refers to but does not declare.
function platform::pure::compiler::pdb::generator::nsFor(target:WriterTarget[1], name:String[1]):String[1]
{
   if($target.ownTables->contains($name) || $target.ownUnions->contains($name), | $target.ns, | m3Ns());
}

// The classes the writer emits writeX for: mirror of the reference generator's
// class walk — skip <<typemodifiers.abstract>> and <<compiler.pointer>>, keep only
// classes with an XDef table the target owns, sorted by simple name.
function platform::pure::compiler::pdb::generator::writerClasses(target:WriterTarget[1]):Class<Any>[*]
{
   $target.packages
      ->map(p | platform::pure::compiler::pdb::fbsgen::classesUnder(platform::pure::functions::meta::pathToElement($p)->cast(@platform::pure::metamodel::Package)))
      ->filter(c | !hasClassStereotype($c, 'abstract')
                   && !hasClassStereotype($c, 'pointer')
                   && $target.ownTables->contains($c.name->toOne() + 'Def'))
      ->sort({a, b | $a.name->toOne()->compare($b.name->toOne())});
}

function platform::pure::compiler::pdb::generator::writerClasses(schema:FbsSchema[1]):Class<Any>[*]
{
   writerClasses(m3Target($schema));
}

function platform::pure::compiler::pdb::generator::classByName(classes:Class<Any>[*], name:String[1]):Class<Any>[1]
{
   let hit = $classes->filter(c | $c.name == $name)->head();
   if($hit->isEmpty(), | fail('PDB generator: no writer class named ' + $name); $classes->at(0);, | $hit->toOne());
}

// Type-argument suffix for using a generic class in a signature or cast:
// covariant params -> Any, contravariant -> Nil, multiplicity params -> *.
function platform::pure::compiler::pdb::generator::typeArgsSuffix(cls:Class<Any>[1]):String[1]
{
   let tps = $cls.typeParameters;
   let mps = $cls.multiplicityParameters;
   if($tps->isEmpty() && $mps->isEmpty(),
      | '',
      | '<' + $tps->map(tp | if($tp.contravariant == true, |'Nil', |'Any'))->joinStrings(', ')
            + if($mps->isEmpty(), |'', |'|' + $mps->map(m | '*')->joinStrings(','))
            + '>');
}

function platform::pure::compiler::pdb::generator::allSuperClasses(cls:Class<Any>[1]):Class<Any>[*]
{
   let parents = $cls.generalizations.general
      ->map(g:platform::pure::metamodel::type::generics::GenericType[1] | $g->platform::pure::metamodel::type::rawType())
      ->filter(t:Type[1] | $t->instanceOf(Class))
      ->map(t:Type[1] | $t->cast(@Class<Any>));
   $parents->concatenate($parents->map(p | allSuperClasses($p)));
}

// --- (4) union dispatch order (reference dispatchOrder) ---------------------------

function platform::pure::compiler::pdb::generator::stripDef(member:String[1]):String[1]
{
   if(!$member->endsWith('Def'), | fail('Expected Def-suffixed member: ' + $member); $member;, | $member->substring(0, $member->length() - 3));
}

Class platform::pure::compiler::pdb::generator::DefMemberInfo
{
   name  : String[1];
   slot  : Integer[1];
   count : Integer[1];
}

// How many other Def members are (transitive) supertypes of `member`.
function platform::pure::compiler::pdb::generator::defSupertypeCount(defMembers:String[*], member:String[1], classes:Class<Any>[*]):Integer[1]
{
   let supers = allSuperClasses(classByName($classes, stripDef($member))).name;
   $defMembers->filter(m | ($m != $member) && $supers->contains(stripDef($m)))->size();
}

// Concrete Def members permuted most-derived-first within their declaration
// slots; PointerRef/AncestorRef keep their original slots. Byte discriminants
// stay tied to DECLARATION order — dispatch order never touches the wire.
function platform::pure::compiler::pdb::generator::dispatchOrder(members:String[*], classes:Class<Any>[*]):String[*]
{
   let defIdx = range(0, $members->size())->filter(i | !['PointerRef','AncestorRef']->contains($members->at($i)));
   let defMembers = $defIdx->map(i | $members->at($i));
   let sorted = range(0, $defMembers->size())
      ->map(i | ^DefMemberInfo(name = $defMembers->at($i), slot = $i,
                  count = defSupertypeCount($defMembers, $defMembers->at($i), $classes)))
      ->sort({a, b | if($a.count != $b.count, | $b.count - $a.count, | $a.slot - $b.slot)});
   range(0, $members->size())->map(i |
      if(!['PointerRef','AncestorRef']->contains($members->at($i)),
         | $sorted->at($defIdx->indexOf($i)).name,
         | $members->at($i)));
}

// 1-based index in union DECLARATION order (reference byteFor).
function platform::pure::compiler::pdb::generator::unionByteFor(members:String[*], member:String[1]):Integer[1]
{
   let idx = $members->indexOf($member);
   if($idx < 0, | fail('No union member ' + $member); 0;, | $idx + 1);
}

// --- (5) the emitter ---------------------------------------------------------------
//
// EMISSION ORDER IS LOAD-BEARING — do not "tidy" it. Every phase below walks the
// properties in MODEL ORDER, which `allWriterProperties` defines exactly: Any's
// properties first, then a DFS of generalizations (parents fully before self),
// then the class's own properties in declaration order, deduped by name
// first-wins, minus <<ProtocolInfo.excluded>>. That order is deterministic — it
// is a pure function of the metamodel, with no set or map iteration — and
// regenerating twice always yields byte-identical output.
//
// It must stay MODEL order because it reproduces the reference
// GeneratedFlatBufferWriter's add order, and add order determines the FlatBuffers
// vtable layout and hence the serialized bytes. Ordering by fbs field id instead
// (tried, reverted) still produces a valid archive but different bytes, failing
// testWriteSourceInformationWireFormat, testElementEntryWireFormat,
// testReadArchiveRoundTrip and testArchiveEntriesVsJavaPdb — the last of which
// diffs entries against the Java-written PDB. Those four are what pin this.
//
// The cost of keying off the metamodel is that reordering or reparenting a class
// silently changes the generated writer. That is why the writer is regenerated on
// every build (`just bootstrap::generate-writer`, a prerequisite of
// build-compiler-pdb) rather than committed — it cannot fall out of date.
//
// Emits platform::pure::compiler::pdb::gen::* — one writeX/writeX_body per Def-table
// class and one writeUnion_X per union — mirroring the reference
// GeneratedFlatBufferWriter's phase structure exactly:
//   phase 1: per property IN MODEL ORDER, build child offsets (strings, pointer
//            refs, nested tables, union values, per-item list offsets);
//   phase 1.5 (AtomicValue only): the special `value` content union;
//   vectors: per many-property in model order, value vector THEN type vector;
//   table:   startObject(maxId+1), then per property in model order add fields
//            at their fbs slot ids (union: type byte at id-1 before value at id;
//            AtomicValue.value LAST), endObject.
// Emitted code is fully qualified (no imports) except system-imported primitives.

Class platform::pure::compiler::pdb::generator::PropPlan
{
   name      : String[1];
   id        : Integer[1];
   vector    : Boolean[1];
   kind      : String[1];      // union | pointer | table | string | bool | long | value
   unionName : String[0..1];
   castType  : String[0..1];   // full path + type args (table kind)
   writeName : String[0..1];   // simple class name (table kind)
   ns        : String[0..1];   // namespace of the called writeX / writeUnion_X (table, union kinds)
   idx       : Integer[1];
}

Class platform::pure::compiler::pdb::generator::EmitAcc
{
   code : String[1];
   prev : String[1];
}

function platform::pure::compiler::pdb::generator::buildPlan(target:WriterTarget[1], clsName:String[1], prop:Property<Nil, Any|*>[1], tbl:FbsTable[1], idx:Integer[1], classes:Class<Any>[*]):PropPlan[1]
{
   let schema = $target.schema;
   let pname = $prop.name->toOne();
   let fname = toFbsFieldName($pname);
   let fieldOpt = $tbl.fields->filter(f | $f.name == $fname)->head();
   if($fieldOpt->isEmpty(), | fail('PDB generator: no fbs field ' + $fname + ' on ' + $tbl.name), | true);
   let field = $fieldOpt->toOne();
   let cat = categorize($schema, $field.type);
   if(($clsName == 'AtomicValue') && ($pname == 'value'),
      | ^PropPlan(name = $pname, id = $field.id, vector = false, kind = 'value', idx = $idx),
      | if($cat == 'union',
         | ^PropPlan(name = $pname, id = $field.id, vector = $field.vector, kind = 'union', unionName = $field.type, ns = nsFor($target, $field.type), idx = $idx),
         | if($field.type == 'PointerRef',
            | ^PropPlan(name = $pname, id = $field.id, vector = $field.vector, kind = 'pointer', idx = $idx),
            | if($cat == 'table',
               | let simple = stripDef($field.type);
                 let targetCls = classByName($classes, $simple);
                 ^PropPlan(name = $pname, id = $field.id, vector = $field.vector, kind = 'table',
                           castType = $targetCls->elementToPath() + typeArgsSuffix($targetCls), writeName = $simple, ns = nsFor($target, $field.type), idx = $idx);,
               | if($field.type == 'string',
                  | ^PropPlan(name = $pname, id = $field.id, vector = $field.vector, kind = 'string', idx = $idx),
                  | if($field.type == 'bool',
                     | ^PropPlan(name = $pname, id = $field.id, vector = $field.vector, kind = 'bool', idx = $idx),
                     | if($field.type == 'long',
                        | ^PropPlan(name = $pname, id = $field.id, vector = $field.vector, kind = 'long', idx = $idx),
                        | platform::pure::compiler::pdb::generator::doublePlan($pname, $field, $tbl, $idx))))))));
}

// Float fields (an extension metamodel's; m3 has none). A vector of them is not written by any
// metamodel yet, so it is refused rather than guessed at.
function platform::pure::compiler::pdb::generator::doublePlan(pname:String[1], field:FbsField[1], tbl:FbsTable[1], idx:Integer[1]):PropPlan[1]
{
   if([
      pair(| ($field.type == 'double') && $field.vector,
           | fail('PDB generator: vectors of double are not supported (' + $tbl.name + '.' + $field.name + ')');
             ^PropPlan(name = $pname, id = $field.id, vector = true, kind = 'double', idx = $idx);),
      pair(| $field.type == 'double',
           | ^PropPlan(name = $pname, id = $field.id, vector = false, kind = 'double', idx = $idx))
   ],
      | fail('PDB generator: unsupported fbs field type ' + $field.type + ' for ' + $tbl.name + '.' + $field.name);
        ^PropPlan(name = $pname, id = $field.id, vector = $field.vector, kind = 'long', idx = $idx););
}

// Declared multiplicity of a property, by NAME of its (possibly pointered)
// packageable multiplicity — 'PureOne'/'OneMany' drive the emitted validations,
// ad-hoc multiplicities ([0..1], [2] ...) get none (mirrors the reference).
function platform::pure::compiler::pdb::generator::multiplicityName(prop:Property<Nil, Any|*>[1]):String[0..1]
{
   let m = $prop.multiplicity;
   if($m->isEmpty(), | [],
      | let mm = $m->toOne();
        if($mm->instanceOf(platform::pure::metamodel::pointer::TempCompilerPointer),
           | $mm->cast(@platform::pure::metamodel::pointer::TempCompilerPointer).path->split('::')->last(),
           | if($mm->instanceOf(platform::pure::metamodel::PackageableElement),
              | $mm->cast(@platform::pure::metamodel::PackageableElement).name,
              | [])););
}

function platform::pure::compiler::pdb::generator::emitValidation(p:PropPlan[1], prop:Property<Nil, Any|*>[1], clsName:String[1]):String[1]
{
   if($p.kind == 'value',
      | '',
      | let mname = multiplicityName($prop);
        let tail = ': \' + platform::pure::compiler::pdb::writerHelper::pointerPath($obj) + platform::pure::compiler::pdb::writerHelper::sourceInfo($obj)), | true);\n';
        if($mname == 'PureOne',
           | '   if($obj.' + $p.name + '->isEmpty(), | fail(\'Validation error: Property ' + $p.name + ' on ' + $clsName + ' has multiplicity [1] but is null' + $tail,
           | if($mname == 'OneMany',
              | '   if($obj.' + $p.name + '->isEmpty(), | fail(\'Validation error: Property ' + $p.name + ' on ' + $clsName + ' has multiplicity [1..*] but is null or empty' + $tail,
              | '')););
}

function platform::pure::compiler::pdb::generator::emitPhase1Step(p:PropPlan[1], prev:String[1]):EmitAcc[1]
{
   let i = $p.idx->toString();
   let r = '$r' + $i;
   let bo = ['^platform::pure::compiler::pdb::fbb::BuilderAndOffset(builder = ', $prev, ', offset = 0)']->joinStrings('');
   // Multi-arm if + joinStrings — see emitAddStep for the inference-cost
   // rationale (this one cost ~425k candidate evaluations to compile).
   if([
      pair(| ($p.kind == 'union') && ($p.vector == false),
           | ^EmitAcc(prev = $r + '.builder', code =
                ['   platform::pure::compiler::pdb::writerHelper::checkGtvAnchor($obj.', $p.name, ', $obj);\n',
                 '   let r', $i, ' = ', $p.ns->toOne(), '::writeUnion_', $p.unionName->toOne(), '(', $prev, ', $obj.', $p.name, ', $stack);\n']->joinStrings(''))),
      pair(| $p.kind == 'union',
           | ^EmitAcc(prev = $r + '.builder', code =
                ['   let r', $i, ' = $obj.', $p.name, '->fold({item, acc | let u = ', $p.ns->toOne(), '::writeUnion_', $p.unionName->toOne(), '($acc.builder, $item, $stack); ^platform::pure::compiler::pdb::writerHelper::UnionListAcc(builder = $u.builder, offsets = $acc.offsets->concatenate($u.offset), types = $acc.types->concatenate($u.typeByte));}, ^platform::pure::compiler::pdb::writerHelper::UnionListAcc(builder = ', $prev, ', offsets = [], types = []));\n']->joinStrings(''))),
      pair(| ($p.kind == 'pointer') && ($p.vector == false),
           | ^EmitAcc(prev = $r + '.builder', code =
                ['   let r', $i, ' = if($obj.', $p.name, '->isEmpty(), | ', $bo, ', | platform::pure::compiler::pdb::writerHelper::writePointerRefFor(', $prev, ', $obj.', $p.name, '->toOne()));\n']->joinStrings(''))),
      pair(| $p.kind == 'pointer',
           | ^EmitAcc(prev = $r + '.builder', code =
                ['   let r', $i, ' = $obj.', $p.name, '->fold({item, acc | let p = platform::pure::compiler::pdb::writerHelper::writePointerRefFor($acc.builder, $item); ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = $p.builder, offsets = $acc.offsets->concatenate($p.offset));}, ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = ', $prev, ', offsets = []));\n']->joinStrings(''))),
      pair(| ($p.kind == 'table') && ($p.vector == false),
           | ^EmitAcc(prev = $r + '.builder', code =
                ['   let r', $i, ' = if($obj.', $p.name, '->isEmpty() || ($obj.', $p.name, '->toOne() == $obj), | ', $bo, ', | ', $p.ns->toOne(), '::write', $p.writeName->toOne(), '(', $prev, ', $obj.', $p.name, '->toOne()->cast(@', $p.castType->toOne(), '), $stack));\n']->joinStrings(''))),
      pair(| $p.kind == 'table',
           | ^EmitAcc(prev = $r + '.builder', code =
                ['   let r', $i, ' = $obj.', $p.name, '->fold({item, acc | let t = ', $p.ns->toOne(), '::write', $p.writeName->toOne(), '($acc.builder, $item->cast(@', $p.castType->toOne(), '), $stack); ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = $t.builder, offsets = $acc.offsets->concatenate($t.offset));}, ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = ', $prev, ', offsets = []));\n']->joinStrings(''))),
      pair(| ($p.kind == 'string') && ($p.vector == false),
           | ^EmitAcc(prev = $r + '.builder', code =
                ['   let r', $i, ' = if($obj.', $p.name, '->isEmpty(), | ', $bo, ', | platform::pure::compiler::pdb::fbb::createSharedString(', $prev, ', platform::pure::compiler::pdb::writerHelper::asFbsString($obj.', $p.name, '->toOne())));\n']->joinStrings(''))),
      pair(| $p.kind == 'string',
           | ^EmitAcc(prev = $r + '.builder', code =
                ['   let r', $i, ' = $obj.', $p.name, '->fold({item, acc | let s = platform::pure::compiler::pdb::fbb::createSharedString($acc.builder, platform::pure::compiler::pdb::writerHelper::asFbsString($item)); ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = $s.builder, offsets = $acc.offsets->concatenate($s.offset));}, ^platform::pure::compiler::pdb::writerHelper::StringsAndBuilder(builder = ', $prev, ', offsets = []));\n']->joinStrings('')))
   ],
      // bool / long / value: nothing in phase 1
      | ^EmitAcc(prev = $prev, code = ''));
}

function platform::pure::compiler::pdb::generator::emitVectorStep(p:PropPlan[1], prev:String[1]):EmitAcc[1]
{
   let i = $p.idx->toString();
   if($p.vector == false,
      | ^EmitAcc(prev = $prev, code = ''),
      | let vecLet = '   let vec' + $i + ' = if($r' + $i + '.offsets->isEmpty(), | ^platform::pure::compiler::pdb::fbb::BuilderAndOffset(builder = ' + $prev + ', offset = 0), | platform::pure::compiler::pdb::writerHelper::createOffsetVector(' + $prev + ', $r' + $i + '.offsets));\n';
        if($p.kind == 'union',
           | ^EmitAcc(prev = '$tvec' + $i + '.builder', code = $vecLet +
                '   let tvec' + $i + ' = if($r' + $i + '.offsets->isEmpty(), | ^platform::pure::compiler::pdb::fbb::BuilderAndOffset(builder = $vec' + $i + '.builder, offset = 0), | platform::pure::compiler::pdb::writerHelper::createByteVector($vec' + $i + '.builder, $r' + $i + '.types));\n'),
           | ^EmitAcc(prev = '$vec' + $i + '.builder', code = $vecLet)););
}

function platform::pure::compiler::pdb::generator::emitAddStep(p:PropPlan[1], prev:String[1]):EmitAcc[1]
{
   let i = $p.idx->toString();
   let t = '$t' + $i;
   let fbb = 'platform::pure::compiler::pdb::fbb';
   let id = $p.id->toString();
   let tid = ($p.id - 1)->toString();
   // Multi-arm if + joinStrings (house style: no nested ifs, no long `+`
   // chains) — the previous nested-if/chained-plus form cost ~10.6M inference
   // candidate evaluations to COMPILE (left-deep plus chains re-infer the
   // whole left subtree per overload candidate; nested arms multiply it).
   if([
      pair(| $p.kind == 'value',
           | ^EmitAcc(prev = $prev, code = '')),   // added LAST by emitClass
      pair(| ($p.vector == true) && ($p.kind == 'union'),
           | ^EmitAcc(prev = $t, code = ['   let t', $i, ' = if($vec', $i, '.offset == 0, | ', $prev, ', | ', $prev, '->', $fbb, '::addFieldOffset(', $tid, ', $tvec', $i, '.offset)->', $fbb, '::addFieldOffset(', $id, ', $vec', $i, '.offset));\n']->joinStrings(''))),
      pair(| $p.vector == true,
           | ^EmitAcc(prev = $t, code = ['   let t', $i, ' = ', $prev, '->', $fbb, '::addFieldOffset(', $id, ', $vec', $i, '.offset);\n']->joinStrings(''))),
      pair(| $p.kind == 'union',
           | ^EmitAcc(prev = $t, code = ['   let t', $i, ' = if($r', $i, '.offset == 0, | ', $prev, ', | ', $prev, '->', $fbb, '::addFieldScalar(', $tid, ', $r', $i, '.typeByte, 0, 1)->', $fbb, '::addFieldOffset(', $id, ', $r', $i, '.offset));\n']->joinStrings(''))),
      pair(| ($p.kind == 'pointer') || ($p.kind == 'table') || ($p.kind == 'string'),
           | ^EmitAcc(prev = $t, code = ['   let t', $i, ' = ', $prev, '->', $fbb, '::addFieldOffset(', $id, ', $r', $i, '.offset);\n']->joinStrings(''))),
      pair(| $p.kind == 'double',
           | ^EmitAcc(prev = $t, code = ['   let t', $i, ' = if($obj.', $p.name, '->isEmpty(), | ', $prev, ', | ', $prev, '->', $fbb, '::addFieldFloatPresent(', $id, ', $obj.', $p.name, '->toOne()));\n']->joinStrings(''))),
      pair(| $p.kind == 'bool',
           | ^EmitAcc(prev = $t, code = ['   let t', $i, ' = if($obj.', $p.name, '->isEmpty(), | ', $prev, ', | ', $prev, '->', $fbb, '::addFieldScalar(', $id, ', if($obj.', $p.name, '->toOne(), | 1, | 0), 0, 1));\n']->joinStrings('')))
   ],
      // long
      | ^EmitAcc(prev = $t, code = ['   let t', $i, ' = if($obj.', $p.name, '->isEmpty(), | ', $prev, ', | ', $prev, '->', $fbb, '::addFieldScalar(', $id, ', $obj.', $p.name, '->toOne(), 0, 8));\n']->joinStrings('')));
}

function platform::pure::compiler::pdb::generator::emitClass(target:WriterTarget[1], cls:Class<Any>[1], classes:Class<Any>[*]):String[1]
{
   let schema = $target.schema;
   let clsName = $cls.name->toOne();
   let tblOpt = $schema.tables->filter(t | $t.name == ($clsName + 'Def'))->head();
   let tbl = $tblOpt->toOne();
   let props = allWriterProperties($cls);
   let plans = range(0, $props->size())->map(i | buildPlan($target, $clsName, $props->at($i), $tbl, $i, $classes));
   let objType = $cls->elementToPath() + typeArgsSuffix($cls);
   let fieldCount = $tbl.fields.id->fold({v, m | if($v > $m, |$v, |$m)}, -1) + 1;

   // Semantic validations first (reference order): declared-[1]/[1..*] null checks,
   // then the FunctionExpression unresolved-`func` check ('~' parent-ref chains exempt).
   let validations = $plans->map(p | emitValidation($p, $props->at($p.idx), $clsName))->joinStrings('');
   let funcCheck = if(allSuperClasses($cls).name->contains('FunctionExpression'),
      | '   if($obj.func->isEmpty() && ($obj.functionName != \'~\'), | fail(\'Validation error: Property func on resolved ' + $clsName + ' is null (functionName=\' + $obj.functionName->joinStrings(\'\') + \') - compile-pure left an unresolved call: \' + platform::pure::compiler::pdb::writerHelper::pointerPath($obj) + platform::pure::compiler::pdb::writerHelper::sourceInfo($obj)), | true);\n',
      | '');

   let phase1 = $plans->fold({p, acc | let step = emitPhase1Step($p, $acc.prev); ^EmitAcc(code = $acc.code + $step.code, prev = $step.prev);},
                             ^EmitAcc(code = $validations + $funcCheck, prev = '$b'));
   let withValue = if($clsName == 'AtomicValue',
      | ^EmitAcc(prev = '$rV.builder', code = $phase1.code +
           '   let rV = if($obj.value->isEmpty(), | ^platform::pure::compiler::pdb::writerHelper::UnionRes(builder = ' + $phase1.prev + ', offset = 0, typeByte = 0), | platform::pure::compiler::pdb::gen::writeAtomicValueContent(' + $phase1.prev + ', $obj.value->toOne(), $obj, $stack));\n'),
      | $phase1);
   let vectors = $plans->fold({p, acc | let step = emitVectorStep($p, $acc.prev); ^EmitAcc(code = $acc.code + $step.code, prev = $step.prev);}, $withValue);
   let start = ^EmitAcc(code = $vectors.code + '   let t = ' + $vectors.prev + '->platform::pure::compiler::pdb::fbb::startObject(' + $fieldCount->toString() + ');\n', prev = '$t');
   let adds = $plans->fold({p, acc | let step = emitAddStep($p, $acc.prev); ^EmitAcc(code = $acc.code + $step.code, prev = $step.prev);}, $start);
   let valuePlan = $plans->filter(p | $p.kind == 'value')->head();
   let withValueAdd = if($valuePlan->isEmpty(),
      | $adds,
      | ^EmitAcc(prev = '$tV', code = $adds.code +
           '   let tV = if($rV.offset == 0, | ' + $adds.prev + ', | ' + $adds.prev + '->platform::pure::compiler::pdb::fbb::addFieldScalar(' + ($valuePlan.id->toOne() - 1)->toString() + ', $rV.typeByte, 0, 1)->platform::pure::compiler::pdb::fbb::addFieldOffset(' + $valuePlan.id->toOne()->toString() + ', $rV.offset));\n'));
   let body = $withValueAdd.code + '   ' + $withValueAdd.prev + '->platform::pure::compiler::pdb::fbb::endObject();\n';

   'function ' + $target.ns + '::write' + $clsName + '(b:platform::pure::compiler::pdb::fbb::Builder[1], obj:' + $objType + '[1], stack:Any[*]):platform::pure::compiler::pdb::fbb::BuilderAndOffset[1]\n' +
   '{\n' +
   '   if(platform::pure::compiler::pdb::writerHelper::onStack($stack, $obj),\n' +
   '      | platform::pure::compiler::pdb::writerHelper::encodeAncestorRef($b, platform::pure::compiler::pdb::writerHelper::ancestorDepth($stack, $obj)),\n' +
   '      | ' + $target.ns + '::write' + $clsName + '_body($b, $obj, $stack->concatenate($obj)));\n' +
   '}\n' +
   '\n' +
   'function ' + $target.ns + '::write' + $clsName + '_body(b:platform::pure::compiler::pdb::fbb::Builder[1], obj:' + $objType + '[1], stack:Any[*]):platform::pure::compiler::pdb::fbb::BuilderAndOffset[1]\n' +
   '{\n' + $body + '}\n';
}

// Top-level element kinds — the writer classes that are metamodel
// PackageableElements. DERIVED, never listed: archive.pure used to carry two
// hand-written 11-arm match dispatches (elementTypeName + writeElementBlob) kept
// in sync only by a comment, and a forgotten arm either dropped the element from
// the archive silently (elementTypeName's Any catch-all) or failed at runtime
// (writeElementBlob has none). Same class of drift as a stale generated writer.
//
// writerClasses already restricts to non-abstract, non-pointer classes under
// platform::pure::metamodel that own a Def table, so the protocol/grammar
// PackageableElement extensions (compiler::test::CompiledGraph & co.) are
// excluded twice over: wrong package, and no Def table.
function platform::pure::compiler::pdb::generator::elementClasses(target:WriterTarget[1]):Class<Any>[*]
{
   writerClasses($target)->filter(c | allSuperClasses($c).name->contains('PackageableElement'));
}

// Arm types are disjoint concrete classes, so match order carries no meaning
// here — these emit in writerClasses order (alphabetical) rather than copying the
// reference's hand-authored instanceof order, which is not derivable from the
// schema. elementTypeName's `Any` catch-all must stay LAST; it is appended after
// the derived arms, never sorted among them.
function platform::pure::compiler::pdb::generator::emitElementTypeName(target:WriterTarget[1]):String[1]
{
   let arms = elementClasses($target)->map(c |
      '      v' + $c.name->toOne() + ' : ' + $c->elementToPath() + typeArgsSuffix($c)
         + '[1] | \'' + $c.name->toOne() + '\',\n');
   'function ' + $target.ns + '::elementTypeName(e:Any[1]):String[0..1]\n'
      + '{\n   $e->match([\n'
      + $arms->joinStrings('')
      + '      x : Any[1] | []\n   ]);\n}\n';
}

function platform::pure::compiler::pdb::generator::emitWriteElementBlob(target:WriterTarget[1]):String[1]
{
   let fbb = 'platform::pure::compiler::pdb::fbb';
   let arms = elementClasses($target)->map(c |
      '      v' + $c.name->toOne() + ' : ' + $c->elementToPath() + typeArgsSuffix($c)
         + '[1] | ' + $target.ns + '::write' + $c.name->toOne()
         + '(' + $fbb + '::newBuilder(), $v' + $c.name->toOne() + ', []),\n');
   'function ' + $target.ns + '::writeElementBlob(e:Any[1]):Binary[1]\n'
      + if($arms->isEmpty(),
           // An extension of values only (a language of islands): no element of it reaches the archive writer.
           | '{\n   fail(\'' + $target.ns + ': this extension writes no element\');\n   []->cast(@Binary)->toOne();\n}\n',
           | '{\n   let r = $e->match([\n'
               + $arms->joinStrings('')->substring(0, $arms->joinStrings('')->length() - 2) + '\n'
               + '   ]);\n'
               + '   $r.builder->' + $fbb + '::finish($r.offset)->' + $fbb + '::result();\n}\n');
}

function platform::pure::compiler::pdb::generator::emitUnion(target:WriterTarget[1], u:FbsUnion[1], classes:Class<Any>[*]):String[1]
{
   let members = $u.members;
   let ur = '^platform::pure::compiler::pdb::writerHelper::UnionRes(builder = $r.builder, offset = $r.offset, typeByte = ';
   // FLAT multi-arm dispatch (`if([pair(|cond,|then), ...], |else)`) rather
   // than nested ifs: a 56-member union (AnyUnion) as a nested-if chain nests
   // one FunctionExpression level per member and trips the interpreter's
   // ProtocolToDynamicInstance depth guard (100) when the SELF-HOST compiler
   // parses this generated file. The pair list is a flat collection literal;
   // conditions still evaluate lazily in dispatch order, first match wins.
   // ExtensionValueDef (a language extension's value) has no m3 class to dispatch on: it is what a value no
   // other arm takes falls to (writeUnionFallback).
   let arms = dispatchOrder($members->filter(m | $m != 'ExtensionValueDef'), $classes)->map({m |
      let byte = unionByteFor($members, $m)->toString();
      if($m == 'PointerRef',
         | 'pair(| $vv->instanceOf(platform::pure::metamodel::PackageableElement) || $vv->instanceOf(platform::pure::metamodel::function::property::AbstractProperty) || $vv->instanceOf(platform::pure::metamodel::extension::Stereotype) || $vv->instanceOf(platform::pure::metamodel::extension::Tag),\n' +
           '           | let r = platform::pure::compiler::pdb::writerHelper::writePointerRefFor($b, $vv); ' + $ur + $byte + ');)',
         | if($m == 'AncestorRef',
            | 'pair(| platform::pure::compiler::pdb::writerHelper::onStack($stack, $vv),\n' +
              '           | let r = platform::pure::compiler::pdb::writerHelper::encodeAncestorRef($b, platform::pure::compiler::pdb::writerHelper::ancestorDepth($stack, $vv)); ' + $ur + $byte + ');)',
            | let simple = stripDef($m);
              let cls = classByName($classes, $simple);
              let full = $cls->elementToPath();
              'pair(| $vv->instanceOf(' + $full + '),\n' +
              '           | let r = ' + nsFor($target, $m) + '::write' + $simple + '($b, $vv->cast(@' + $full + typeArgsSuffix($cls) + '), $stack); ' + $ur + $byte + ');)';));
   });
   // Where a language extension's value can stand, a value no arm takes is written as an ExtensionValueDef
   // (writerHelper::writeExtensionValue fails, naming its class, when its extension wrote no blob writer).
   let fallback = if($members->contains('ExtensionValueDef'),
      | 'let r = platform::pure::compiler::pdb::writerHelper::writeExtensionValue($b, $vv); ' + $ur + unionByteFor($members, 'ExtensionValueDef')->toString() + ');',
      | 'platform::pure::compiler::pdb::writerHelper::failUnion($b, \'' + $u.name + '\')');
   let inner = 'if([\n       ' + $arms->joinStrings(',\n       ') + '],\n      | ' + $fallback + ')';

   'function ' + $target.ns + '::writeUnion_' + $u.name + '(b:platform::pure::compiler::pdb::fbb::Builder[1], v:Any[0..1], stack:Any[*]):platform::pure::compiler::pdb::writerHelper::UnionRes[1]\n' +
   '{\n' +
   '   if($v->isEmpty(),\n' +
   '      | ^platform::pure::compiler::pdb::writerHelper::UnionRes(builder = $b, offset = 0, typeByte = 0),\n' +
   '      | ' + $target.ns + '::writeUnionValue_' + $u.name + '($b, $v->toOne(), $stack));\n' +
   '}\n' +
   '\n' +
   'function ' + $target.ns + '::writeUnionValue_' + $u.name + '(b:platform::pure::compiler::pdb::fbb::Builder[1], vv:Any[1], stack:Any[*]):platform::pure::compiler::pdb::writerHelper::UnionRes[1]\n' +
   '{\n   ' + $inner + ';\n}\n';
}

// AtomicValue.value content dispatch — the reference's hand-written special case:
// LambdaFunction, PackageableElement->PointerRef, Enum->StringValueDef(path.name),
// Integer, Decimal, Float (Decimal-typed -> DecimalValueDef; true floats deferred),
// Boolean, else String. Bytes from AtomicValueContentUnion declaration order.
function platform::pure::compiler::pdb::generator::emitAtomicValueContent(schema:FbsSchema[1], classes:Class<Any>[*]):String[1]
{
   let members = unionMembers($schema, 'AtomicValueContentUnion');
   let bInt    = unionByteFor($members, 'IntegerValueDef')->toString();
   let bFloat  = unionByteFor($members, 'FloatValueDef')->toString();
   let bBool   = unionByteFor($members, 'BooleanValueDef')->toString();
   let bStr    = unionByteFor($members, 'StringValueDef')->toString();
   let bLambda = unionByteFor($members, 'LambdaFunctionDef')->toString();
   let bPtr    = unionByteFor($members, 'PointerRef')->toString();
   let bDec    = unionByteFor($members, 'DecimalValueDef')->toString();
   let avPath  = classByName($classes, 'AtomicValue')->elementToPath();
   let lf      = classByName($classes, 'LambdaFunction');
   let lfCast  = $lf->elementToPath() + typeArgsSuffix($lf);
   let ur = '^platform::pure::compiler::pdb::writerHelper::UnionRes(builder = $r.builder, offset = $r.offset, typeByte = ';

   // Assembled from a FLAT parts list, and the EMITTED dispatch is the flat
   // multi-arm `if([pair(|cond,|then), ...], |else)` form — nested-if chains
   // (in this generator's own source or in what it emits) nest one
   // FunctionExpression per level and trip the interpreter's
   // protocol-conversion depth guard on the self-host parse.
   [
      'function platform::pure::compiler::pdb::gen::writeAtomicValueContent(b:platform::pure::compiler::pdb::fbb::Builder[1], vv:Any[1], obj:' + $avPath + '[1], stack:Any[*]):platform::pure::compiler::pdb::writerHelper::UnionRes[1]\n',
      '{\n',
      '   if([\n',
      '       pair(| $vv->instanceOf(platform::pure::metamodel::function::LambdaFunction),\n',
      '           | let r = platform::pure::compiler::pdb::gen::writeLambdaFunction($b, $vv->cast(@' + $lfCast + '), $stack); ' + $ur + $bLambda + ');),\n',
      '       pair(| $vv->instanceOf(platform::pure::metamodel::PackageableElement),\n',
      '           | let r = platform::pure::compiler::pdb::writerHelper::writePointerRefFor($b, $vv); ' + $ur + $bPtr + ');),\n',
      '       pair(| $vv->instanceOf(platform::pure::metamodel::type::Enum),\n',
      '           | let r = platform::pure::compiler::pdb::writerHelper::encodeStringishValueDef($b, platform::pure::compiler::pdb::writerHelper::atomicEnumPath($obj.genericType, $vv->cast(@platform::pure::metamodel::type::Enum).name->toOne())); ' + $ur + $bStr + ');),\n',
      '       pair(| $vv->instanceOf(Integer),\n',
      '           | let r = platform::pure::compiler::pdb::writerHelper::encodeIntegerValueDef($b, $vv->cast(@Integer)); ' + $ur + $bInt + ');),\n',
      '       pair(| $vv->instanceOf(Decimal),\n',
      '           | let r = platform::pure::compiler::pdb::writerHelper::encodeStringishValueDef($b, $vv->toString()); ' + $ur + $bDec + ');),\n',
      '       pair(| $vv->instanceOf(Float) && platform::pure::compiler::pdb::writerHelper::isDecimalTyped($obj.genericType),\n',
      '           | let r = platform::pure::compiler::pdb::writerHelper::encodeStringishValueDef($b, $vv->toString()); ' + $ur + $bDec + ');),\n',
      '       pair(| $vv->instanceOf(Float),\n',
      '           | let r = platform::pure::compiler::pdb::writerHelper::encodeFloatValueDef($b, $vv->cast(@Float)); ' + $ur + $bFloat + ');),\n',
      '       pair(| $vv->instanceOf(Boolean),\n',
      '           | let r = platform::pure::compiler::pdb::writerHelper::encodeBooleanValueDef($b, $vv->cast(@Boolean)); ' + $ur + $bBool + ');)],\n',
      '      | let r = platform::pure::compiler::pdb::writerHelper::encodeStringishValueDef($b, $vv->toString()); ' + $ur + $bStr + ');\n',
      '   );\n',
      '}\n'
   ]->joinStrings('');
}

function platform::pure::compiler::pdb::generator::generateWriter(fbsPath:String[1]):String[1]
{
   let header = '// AUTO-GENERATED by platform::pure::compiler::pdb::generator (from m3.fbs + the live\n' +
                '// metamodel) - DO NOT EDIT. Regenerate: see pdb/writer/generator.pure printGeneratedWriter.\n' +
                '// Byte-compatible with the reference bootstrap GeneratedFlatBufferWriter.\n\n';
   $header + emitAll(m3Target(parseFbs(platform::pure::functions::io::readFile($fbsPath))));
}

// A language extension's value specifications (island values), which m3's unions hold as ExtensionValueDef:
// for each, `<its package>::<Class>_pdbValueBlob(v):Binary[1]` — its table written as a finished FlatBuffer,
// with a fresh stack (everything pointing out of the blob is a PointerRef). Beside the class, so m3's writer
// finds it from the value alone (writerHelper::writeExtensionValue).
function platform::pure::compiler::pdb::generator::emitValueBlobs(target:WriterTarget[1]):String[1]
{
   let fbb = 'platform::pure::compiler::pdb::fbb';
   writerClasses($target)
      ->filter(c | allSuperClasses($c)->map(x | $x->elementToPath())->contains('platform::pure::metamodel::valuespecification::ValueSpecification'))
      ->map(c | 'function ' + $c.package->toOne()->elementToPath() + '::' + $c.name->toOne() + '_pdbValueBlob(v:Any[1]):Binary[1]\n'
                  + '{\n   let r = ' + $target.ns + '::write' + $c.name->toOne() + '(' + $fbb + '::newBuilder(), $v->cast(@' + $c->elementToPath() + typeArgsSuffix($c) + '), []);\n'
                  + '   $r.builder->' + $fbb + '::finish($r.offset)->' + $fbb + '::result();\n}\n')
      ->joinStrings('\n');
}

// Everything a target's writer holds: union dispatches, (m3 only) the AtomicValue content
// dispatch, one writeX per table class, then the element-level dispatches.
function platform::pure::compiler::pdb::generator::emitAll(target:WriterTarget[1]):String[1]
{
   let own     = writerClasses($target);
   let classes = if($target.m3, | $own, | $own->concatenate(writerClasses(m3Target($target.schema))));
   $target.schema.unions->filter(u | $target.ownUnions->contains($u.name) && ($u.name != 'AtomicValueContentUnion'))->map(u | emitUnion($target, $u, $classes))->joinStrings('\n')
      + if($target.m3, | '\n' + emitAtomicValueContent($target.schema, $classes), | '')
      + '\n' + $own->map(c | emitClass($target, $c, $classes))->joinStrings('\n')
      + '\n' + emitElementTypeName($target)
      + '\n' + emitWriteElementBlob($target)
      + if($target.m3, | '', | '\n' + emitValueBlobs($target));
}

// The generated function an extension's `CompilerExtension.pdb` points at.
function platform::pure::compiler::pdb::generator::emitSerialization(target:WriterTarget[1]):String[1]
{
   'function ' + $target.ns + '::serialization():platform::pure::compiler::extension::PdbSerialization[1]\n'
      + '{\n'
      + '   ^platform::pure::compiler::extension::PdbSerialization(\n'
      + '      elementTypeName  = e: Any[1] | ' + $target.ns + '::elementTypeName($e),\n'
      + '      writeElementBlob = e: Any[1] | ' + $target.ns + '::writeElementBlob($e));\n'
      + '}\n';
}

// A language extension's writer: its metamodel package, the fbs fragment pdb/fbsgen generated for
// it, emitted into `ns`. Run from the extension's build (see pure/extensions/diagram/Justfile).
function platform::pure::compiler::pdb::generator::generateExtensionWriter(m3FbsPath:String[1], fragmentPath:String[1], packagesCsv:String[1], ns:String[1]):String[1]
{
   let fragText = platform::pure::functions::io::readFile($fragmentPath);
   let fragment = parseFbs($fragText);
   let target   = ^WriterTarget(packages = $packagesCsv->split(','), ns = $ns,
                                schema = parseFbs(platform::pure::functions::io::readFile($m3FbsPath) + '\n' + $fragText),
                                ownTables = $fragment.tables.name, ownUnions = $fragment.unions.name, m3 = false);
   '// AUTO-GENERATED by platform::pure::compiler::pdb::generator from ' + $packagesCsv + '\n'
      + '// and its fbs fragment (pdb/fbsgen) - DO NOT EDIT. Regenerated by the extension build.\n\n'
      + emitAll($target) + '\n' + emitSerialization($target);
}

function platform::pure::compiler::pdb::generator::printExtensionWriter(m3FbsPath:String[1], fragmentPath:String[1], packagesCsv:String[1], ns:String[1]):Boolean[1]
{
   print('===GENWRITER-BEGIN===\n', 1);
   print(generateExtensionWriter($m3FbsPath, $fragmentPath, $packagesCsv, $ns), 1);
   print('\n===GENWRITER-END===\n', 1);
   true;
}

// Entry point for `pure-bootstrap execute` (run from the repo root):
// prints the generated writer between markers for extraction into
// pdb/writer/generated/generatedWriter.pure (the generated-code area of this module —
// committed, like shared/specification/m3.fbs, to break the self-host cycle).
function platform::pure::compiler::pdb::generator::printGeneratedWriter():Boolean[1]
{
   print('===GENWRITER-BEGIN===\n', 1);
   print(generateWriter('shared/specification/m3.fbs'), 1);
   print('\n===GENWRITER-END===\n', 1);
   true;
}

// --- tests ----------------------------------------------------------------------

// Pinned against the REFERENCE GeneratedFlatBufferWriter.writeSourceInformation
// add order (verified 2026-07-04): classifierGenericType, sourceInformation
// (Any's props), then endLine, sourceId, startColumn, endColumn, startLine —
// which is NOT the m3.fbs field-declaration order.
function <<test.Test>> platform::pure::compiler::pdb::generator::tests::testSourceInformationPropertyOrder():Boolean[1]
{
   let si = platform::pure::functions::meta::pathToElement('platform::pure::metamodel::SourceInformation')->cast(@Class<Any>);
   assertEquals(['classifierGenericType','sourceInformation','endLine','sourceId','startColumn','endColumn','startLine'],
      platform::pure::compiler::pdb::generator::allWriterProperties($si).name);
}

function <<test.Test>> platform::pure::compiler::pdb::generator::tests::testToFbsFieldName():Boolean[1]
{
   assertEquals('classifier_generic_type', platform::pure::compiler::pdb::generator::toFbsFieldName('classifierGenericType'));
   assertEquals('type_', platform::pure::compiler::pdb::generator::toFbsFieldName('type'));
   assertEquals('p_tags', platform::pure::compiler::pdb::generator::toFbsFieldName('p_tags'));
   assertEquals('name', platform::pure::compiler::pdb::generator::toFbsFieldName('name'));
   assertEquals('name_wild_card', platform::pure::compiler::pdb::generator::toFbsFieldName('nameWildCard'));
}