import meta::pure::compiler::helper::class::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::validateNewFromFI(fi:FunctionApplication[1], context:CompilerContext[1]):CompilerContext[1]
{
    // Extract class from the first argument (GenericTypeAndMultiplicityHolder), then look up
    // the fully compiled class from the context (the GTMH references the pass 1 skeleton)
    let skeletonCls = if($fi.parametersValues->isNotEmpty(),
        | extractClassFromGTMH($fi.parametersValues->at(0)),
        | extractClassFromGenericType($fi.genericType)
    );
    // Use the recording variant so `^Foo(...)` records {@code Foo} as a
    // target on the current caller. Mirrors Java's
    // RecordingMetadataAccess.getElement which records every lookup.
    let resolvedR = if($skeletonCls->isNotEmpty(),
        | $context->resolveElementR($skeletonCls->toOne()->fullPath()),
        | ^CompilerResult<PackageableElement>(value = [], context = $context)
    );
    let cls = if($resolvedR.value->isNotEmpty(),
        | $resolvedR.value->toOne()->match([
              c:Class<Any>[1] | $c,
              a:Any[1] | $skeletonCls
          ]),
        | $skeletonCls
    );
    let ctxAfterClassRecord = $resolvedR.context;
    // Extract provided property names from key expressions (second param is a Collection of keyExpression FIs)
    let providedNames = if($fi.parametersValues->size() >= 2,
        | $fi.parametersValues->at(1)->match([
              col:Collection[1] |
                  $col.values->map(v |
                      $v->match([
                          kfi:FunctionApplication[1] |
                              if($kfi.parametersValues->isNotEmpty(),
                                  | $kfi.parametersValues->at(0)->match([
                                        av:AtomicValue[1] | $av.value->cast(@String),
                                        a:Any[1] | []->cast(@String)
                                    ]),
                                  | []->cast(@String)
                              ),
                          a:Any[1] | []->cast(@String)
                      ])
                  ),
              a:Any[1] | []->cast(@String)
          ]),
        | []->cast(@String)
    );
    validateNew($fi, $cls, $providedNames, $ctxAfterClassRecord);
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::extractClassFromGTMH(vs:ValueSpecification[1]):Class<Any>[0..1]
{
    // The GTMH's genericType has typeArguments where the first one is the target class's GenericType
    $vs->match([
        gtmh:GenericTypeAndMultiplicityHolder[1] |
          let gtmhGT = if($gtmh.genericType->isNotEmpty() && !$gtmh.genericType->toOne()->instanceOf(CompilerNotSetGenericType), | $gtmh.genericType, | $gtmh->cast(@Any).classifierGenericType);
          if($gtmhGT->isNotEmpty(),
              | $gtmhGT->toOne()->match([
                    gtv:GenericTypeValue[1] |
                        let typeArgs = $gtv.typeArguments;
                        if($typeArgs->isNotEmpty(),
                            | extractClassFromGenericType($typeArgs->at(0)),
                            | []
                        );,
                    a:Any[1] | []
                ]),
              | []
          );,
        a:Any[1] | []
    ]);
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::extractClassFromGenericType(gt:GenericType[0..1]):Class<Any>[0..1]
{
    if($gt->isNotEmpty(),
        | $gt->toOne()->match([
              gtv:GenericTypeValue[1] |
                  if($gtv.type->isNotEmpty(),
                      | $gtv.type->toOne()->match([
                            c:Class<Any>[1] | $c,
                            a:Any[1] | []
                        ]),
                      | []
                  );,
              a:Any[1] | []
          ]),
        | []
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::validateNew(fi:FunctionApplication[1], compiledClass:Class<Any>[0..1], providedPropertyNames:String[*], context:CompilerContext[1]):CompilerContext[1]
{
    if($compiledClass->isEmpty(),
        | $context,
        | let cls = $compiledClass->toOne();
          // Class-level `<<compiler.pointer>>` stereotype declares the class an
          // indirect-reference subtype: instances are empty shells carrying only
          // a resolution key. Skip the abstract + required-property checks so
          // `^FooPointer(path = '...')` type-checks without supplying every
          // `[1]` field inherited from Foo.
          if($cls->isCompilerPointer(),
              | $context,
              | let ctx1 = checkAbstract($cls, $fi, $context);
                if($ctx1.errors->size() > $context.errors->size(),
                    | $ctx1,
                    | let ctx2 = checkMissingProperties($cls, $providedPropertyNames, $fi, $ctx1);
                      checkKeyExpressions($cls, $providedPropertyNames, $fi, $ctx2);
                );
          );
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::isCompilerPointer(cls:Class<Any>[1]):Boolean[1]
{
    $cls.stereotypes->exists(s | $s.value == 'pointer'
        && $s.profile->isNotEmpty()
        && $s.profile->toOne()->fullPath() == 'meta::pure::profiles::compiler');
}

// Matches Java NewResolver.validateCopyProperties — copy only checks key expressions, not abstract/missing
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::validateCopyFromFI(fi:FunctionApplication[1], context:CompilerContext[1]):CompilerContext[1]
{
    let cls = extractClassFromGenericType($fi.genericType);
    let compiledCls = if($cls->isNotEmpty(),
        | let path = $cls->toOne()->fullPath();
          let resolved = $context->resolveElement($path);
          if($resolved->isNotEmpty(),
              | $resolved->toOne()->match([
                    c:Class<Any>[1] | $c,
                    a:Any[1] | $cls
                ]),
              | $cls
          );,
        | $cls
    );
    let providedNames = if($fi.parametersValues->size() >= 2,
        | $fi.parametersValues->at(1)->match([
              col:Collection[1] |
                  $col.values->map(v |
                      $v->match([
                          kfi:FunctionApplication[1] |
                              if($kfi.parametersValues->isNotEmpty(),
                                  | $kfi.parametersValues->at(0)->match([
                                        av:AtomicValue[1] | $av.value->cast(@String),
                                        a:Any[1] | []->cast(@String)
                                    ]),
                                  | []->cast(@String)
                              ),
                          a:Any[1] | []->cast(@String)
                      ])
                  ),
              a:Any[1] | []->cast(@String)
          ]),
        | []->cast(@String)
    );
    if($compiledCls->isEmpty(),
        | $context,
        | checkKeyExpressions($compiledCls->toOne(), $providedNames, $fi, $context)
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::checkAbstract(cls:Class<Any>[1], fi:FunctionApplication[1], context:CompilerContext[1]):CompilerContext[1]
{
    let isAbstract = $cls.stereotypes->exists(s | $s.value == 'abstract' && $s.profile->toOne()->fullPath() == 'meta::pure::profiles::typemodifiers');
    if($isAbstract,
        | let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $context);
          ^$context(errors += 'Cannot instantiate abstract class \'' + $cls->fullPath() + '\'' + $siCtx);,
        | $context
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::checkMissingProperties(cls:Class<Any>[1], providedNames:String[*], fi:FunctionApplication[1], context:CompilerContext[1]):CompilerContext[1]
{
    let requiredProps = $cls.properties
        ->filter(p | $p.multiplicity->isNotEmpty() && multiplicityLowerBound($p.multiplicity->toOne()) >= 1)
        ->filter(p | $p.defaultValue->isEmpty())
        ->filter(p | !$p.stereotypes->exists(s | $s.value == 'inferred' || $s.value == 'excluded' || $s.value == 'pointer'))
        ->filter(p | !$providedNames->contains($p.name));
    $requiredProps->fold({p, ctx |
        let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $ctx);
        let typeName = if($p.genericType->isNotEmpty(),
            | printGenericType($p.genericType->toOne()),
            | 'Unknown'
        );
        ^$ctx(errors += 'Missing required property \'' + $p.name->toOne() + '\' of type ' + $typeName + ' in new expression' + $siCtx);
    }, $context);
}

// Matches Java NewResolver.checkKeyExpressions — validates unknown properties, multiplicity, type, and deep paths
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::checkKeyExpressions(cls:Class<Any>[1], providedNames:String[*], fi:FunctionApplication[1], context:CompilerContext[1]):CompilerContext[1]
{
    // Build class type parameter bindings from the new/copy expression's return type
    let classBindings = if($fi.genericType->isNotEmpty() && !$fi.genericType->toOne()->instanceOf(UndefinedGenericType) && !$fi.genericType->toOne()->instanceOf(CompilerNotSetGenericType),
        | $cls->buildBindingsFromGenericType($fi.genericType->toOne()),
        | newPlainParametersBinding()->cast(@ParametersBinding)
    );

    // Check unknown properties (including deep paths). Use the context-aware
    // findProperty from _Class.pure (matching Java _Class.findProperty): walking
    // generalizations through `rawType()` + resolveElement picks up
    // properties registered later (e.g. via associations) and handles deeper
    // inheritance chains. The previous local findPropertyOnClass missed
    // properties inherited via mid-chain classes like GenericDeclaration on
    // Method/Constructor (Method extends [AnnotatedElement, Member, GenericDeclaration]).
    let ctx1 = $providedNames->fold({name, ctx |
        if([pair(| $name->contains('.'), | validateDeepPropertyPath($cls, $name, $fi, $ctx)),
            pair(| $cls->findProperty($name, $ctx)->isEmpty(), | let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $ctx);
                    ^$ctx(errors += 'Unknown property \'' + $name + '\' in class \'' + $cls->fullPath() + '\'' + $siCtx);)],
           | $ctx
        );
    }, $context);

    // Check multiplicity and type for each key expression value
    if($fi.parametersValues->size() < 2,
        | $ctx1,
        | let keyParam = $fi.parametersValues->at(1);
          $keyParam->match([
              col:Collection[1] |
                $col.values->fold({v, ctx |
                    $v->match([
                        keyExpr:FunctionInvocation[1] |
                          if($keyExpr.parametersValues->size() < 2,
                              | $ctx,
                              | let keyNameVS = $keyExpr.parametersValues->at(0);
                                let keyValueVS = $keyExpr.parametersValues->at(1);
                                $keyNameVS->match([
                                    keyNameAV:AtomicValue[1] |
                                        let propName = $keyNameAV.value->toOne()->toString();
                                        // Context-aware findProperty so cross-file inherited
                                        // association properties (Organization.parent attached
                                        // by SubOrganization's pass 2, accessed via Department's
                                        // pre-association generalization reference) still
                                        // resolve here. Mirrors the deep-path lookup below.
                                        let prop = $cls->findProperty($propName, $ctx);
                                        if($prop->isEmpty(),
                                            | $ctx, // unknown — already reported above
                                            | let p = $prop->toOne();
                                              // Multiplicity check
                                              let ctx2 = if($p.multiplicity->isNotEmpty() && $keyValueVS.multiplicity->isNotEmpty() && !multiplicitySubsumes($p.multiplicity->toOne(), $keyValueVS.multiplicity->toOne()),
                                                  | let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $ctx);
                                                    ^$ctx(errors += 'Multiplicity mismatch for property \'' + $propName + '\': expected ' + printMultiplicity($p.multiplicity->toOne()) + ', got ' + printMultiplicity($keyValueVS.multiplicity->toOne()) + $siCtx);,
                                                  | $ctx
                                              );
                                              // Type check — resolve property type through class bindings (e.g., Z → String)
                                              if($p.genericType->isNotEmpty() && $keyValueVS.genericType->isNotEmpty(),
                                                  | let resolvedPropGT = makeAsConcreteAsPossible($p.genericType->toOne(), $classBindings, $context);
                                                    // Pull the raw type, then deref ONCE if it's a pointer —
                                                    // `.name` (read below) lives on the live target, not on
                                                    // the Class_Pointer / PrimitiveTypePointer / etc.
                                                    let propType = $resolvedPropGT->rawType()->derefTypeIfPointer($context);
                                                    let valType = $keyValueVS.genericType->toOne()->rawType()->derefTypeIfPointer($context);
                                                    if($propType->isNotEmpty() && $valType->isNotEmpty(),
                                                        | let pName = $propType->toOne()->cast(@PackageableElement).name->toOne();
                                                          let vName = $valType->toOne()->cast(@PackageableElement).name->toOne();
                                                          let skip = $pName == 'Any' || $vName == 'Any' || $vName == 'Nil'
                                                              || $pName == 'Unknown' || $vName == 'Unknown'
                                                              || $pName == $vName
                                                              || $propType->toOne()->instanceOf(TypeParameter)
                                                              || $valType->toOne()->instanceOf(TypeParameter);
                                                          if(!$skip && !isCompatibleType($resolvedPropGT, $keyValueVS.genericType->toOne(), $ctx2),
                                                              | let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $ctx2);
                                                                ^$ctx2(errors += 'Type mismatch for property \'' + $propName + '\': expected ' + $pName + ', got ' + $vName + $siCtx);,
                                                              | $ctx2
                                                          );,
                                                        | $ctx2
                                                    );,
                                                  | $ctx2
                                              );
                                        );,
                                    a:Any[1] | $ctx
                                ]);
                          );,
                        a:Any[1] | $ctx
                    ]);
                }, $ctx1);,
              a:Any[1] | $ctx1
          ]);
    );
}

// Validate deep property path like 'address.name' by traversing each segment
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::validateDeepPropertyPath(cls:Class<Any>[1], fullPath:String[1], fi:FunctionApplication[1], context:CompilerContext[1]):CompilerContext[1]
{
    let segments = $fullPath->split('.');
    validateDeepPropertyPathSegments($cls, $cls, $segments, 0, $fullPath, $fi, $context);
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::validateDeepPropertyPathSegments(rootCls:Class<Any>[1], currentType:Class<Any>[1], segments:String[*], index:Integer[1], fullPath:String[1], fi:FunctionApplication[1], context:CompilerContext[1]):CompilerContext[1]
{
    if($index >= $segments->size(),
        | $context,
        | let segment = $segments->at($index);
          // The Class instance reachable via prop.genericType.rawType may be a
          // pre-resolution stub with an empty .properties list. Look up the
          // canonical, fully-resolved version from the context.elementMap by
          // full path before searching for the property.
          let canonical = $context.elementMap->get($currentType->fullPath());
          let resolvedType = if($canonical->isNotEmpty() && $canonical->toOne()->instanceOf(Class),
              | $canonical->toOne()->cast(@Class<Any>),
              | $currentType
          );
          // Use the context-aware findProperty so each generalization is
          // re-resolved through elementMap. With the local findPropertyOnClass,
          // a multi-file compile where the Association declaring an inherited
          // property is processed AFTER the function file would leave the
          // generalization's stored superclass reference frozen at its
          // pre-association state — the association-attached properties would
          // be on the canonical superclass in elementMap but invisible through
          // the stale reference.
          let prop = $resolvedType->findProperty($segment, $context);
          if([pair(| $prop->isEmpty(), | let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $context);
                ^$context(errors += 'Unknown deep property path \'' + $fullPath + '\' in class \'' + $rootCls->fullPath() + '\': property \'' + $segment + '\' not found in class \'' + $resolvedType->fullPath() + '\'' + $siCtx);),
              pair(| $index < $segments->size() - 1 && $prop->toOne().genericType->isNotEmpty(), | let nextType = $prop->toOne().genericType->toOne()->rawType();
                      if($nextType->isNotEmpty(),
                          | $nextType->toOne()->match([
                                c:Class<Any>[1] | validateDeepPropertyPathSegments($rootCls, $c, $segments, $index + 1, $fullPath, $fi, $context),
                                a:Any[1] | $context
                            ]),
                          | $context
                      );)],
             | $context
          );
    );
}

// Simple type compatibility check: is actual a subtype of declared?
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::isCompatibleType(declared:GenericType[1], actual:GenericType[1], context:CompilerContext[1]):Boolean[1]
{
    let declaredType = $declared->rawType();
    let actualType = $actual->rawType();
    if($declaredType->isEmpty() || $actualType->isEmpty(),
        | true,
        | let declaredCanonical = resolveCanonicalType($declaredType->toOne(), $context);
          let actualCanonical = resolveCanonicalType($actualType->toOne(), $context);
          let declaredPath = $declaredCanonical->cast(@PackageableElement)->fullPath();
          $actualCanonical->linearize($context)->contains($declaredPath);
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::resolveCanonicalType(t:Type[1], context:CompilerContext[1]):Type[1]
{
    if($t->instanceOf(PackageableElement),
        | let path = $t->cast(@PackageableElement)->fullPath();
          let canonical = $context.elementMap->get($path);
          if($canonical->isNotEmpty() && $canonical->toOne()->instanceOf(Type),
              | $canonical->toOne()->cast(@Type),
              | $t
          );,
        | $t
    );
}
