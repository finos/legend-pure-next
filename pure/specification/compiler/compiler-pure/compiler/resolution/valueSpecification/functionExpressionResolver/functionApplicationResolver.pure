// ============================================================================
// Function resolution result
// ============================================================================

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::FunctionResolutionResult
{
    resolvedFunction: PackageableFunction<Any>[0..1];
    resolvedName: String[1];
    returnGenericType: GenericType[1];
    returnMultiplicity: Multiplicity[1];
    bindings: ParametersBinding[1];
    resolvedTypeParameters: ResolvedTypeParameter[*];
    resolvedMultiplicityParameters: ResolvedMultiplicityParameter[*];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::EnrichResult
{
    resolvedParams : ValueSpecification[*];
    bindings : ParametersBinding[1];
    context : CompilerContext[1];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::ParameterInfo
{
    resolved : Boolean[1];
    newParam : ValueSpecification[1];
    savedErrors : String[*];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::FixpointAccumulator
{
    infos : ParameterInfo[*];
    bindings : ParametersBinding[1];
    context : CompilerContext[1];
    madeProgress : Boolean[1];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::FixpointResult
{
    infos : ParameterInfo[*];
    bindings : ParametersBinding[1];
    context : CompilerContext[1];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::CandidateTryAccumulator
{
    resolved : Boolean[1];
    result : CompilerResult<ValueSpecification>[0..1];
    resolvedCandidate : PackageableFunction<Any>[0..1];
    tiedCandidates : PackageableFunction<Any>[*];
    context : CompilerContext[1];
    firstErrors : String[*];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::ResolveOneParamResult
{
    resolved : Boolean[1];
    newParam : ValueSpecification[1];
    bindings : ParametersBinding[1];
    context : CompilerContext[1];
    savedErrors : String[*];
}

// ============================================================================
// Entry point
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveFunctionApplication(fi:FunctionApplication[1], scope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    let functionName = $fi.functionName->toOne();
    let paramCount = $fi.parametersValues->size();
    debug($context, | 'resolveFunctionApplication: ' + $functionName + ' (' + $paramCount->toString() + ' args)');
    let deepCtx = $context->debugSpaceInc();

    // Find visible candidates by name and arity
    let candidates = $context->findAllFunctionsByNameAndArity($functionName, $paramCount);
    if([pair(| $candidates->isEmpty(),
             | // No visible candidates — build error with suggestions.
               // Mirrors Java: one error per failed call, regardless of how many
               // suggestion lines the printer adds. Splitting by '\n' inflates the
               // error count by ~N (one per suggestion candidate); concretely
               // ~6700 of the 8063 errors observed against language/java came from
               // this split.
               let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $context);
               debug($deepCtx, | 'no candidates found');
               let suggestions = buildFunctionSuggestions($context, $functionName, $paramCount);
               let mainError = 'The function \'' + $functionName + '\' with ' + $paramCount->toString() + ' parameter(s) can\'t be found' + $suggestions + $siCtx;
               ^CompilerResult<ValueSpecification>(
                   value = $fi,
                   context = ^$context(errors += $mainError)
               );),
        pair(| $candidates->size() == 1,
             | // Single candidate — resolve directly, errors are legitimate.
               // Mirrors Java line 75 (incrementCandidateEvaluationCount on the
               // single-candidate branch).
               debug($deepCtx, | '1 candidate');
               let singleBumpedCtx = ^$deepCtx(candidateEvaluations = $deepCtx.candidateEvaluations + 1);
               resolveFunctionApplicationUsingTemplateFunction($fi, $candidates->at(0), $scope, $singleBumpedCtx);)],
       | // Multiple candidates — sort most-specific-first, pre-resolve non-lambda params, then try each candidate
         // Sort most-specific-first: by parameter specificity, then fewer type/multiplicity params = more specific (mirrors Java mostSpecificFirst)
         let sorted = $candidates->sort({a, b |
             let cmp = compareFunctionTypes($a->getFunctionType($context), $b->getFunctionType($context), $context);
             if($cmp != 0, | $cmp,
                 | let tpCmp = $a.typeParameters->size() - $b.typeParameters->size();
                   if($tpCmp != 0, | $tpCmp,
                       | $a.multiplicityParameters->size() - $b.multiplicityParameters->size()
                   );
             );
         });
         debug($deepCtx, | $sorted->size()->toString() + ' candidates, pre-resolving non-lambda params');
         // Mirrors Java line 94 (rollbackErrorsTo(preResolveCheckpoint) ALWAYS
         // fires after pre-resolve speculative compilation): one inferenceRollback
         // bump per multi-candidate call accounts for that always-rollback.
         let preResolveBumpedCtx = $deepCtx->bumpRollbackSite('MULTI_CANDIDATE_PRE_RESOLVE');
         let preResolveBumpedCtxOuter = $context->bumpRollbackSite('MULTI_CANDIDATE_PRE_RESOLVE');
         resolveWithMultipleCandidates($fi, $sorted, $scope, $preResolveBumpedCtx, $preResolveBumpedCtxOuter);
    );
}

// Mirrors Java resolveFunctionApplication multi-candidate path
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveWithMultipleCandidates(fi:FunctionApplication[1], candidates:PackageableFunction<Any>[*], scope:VariableExpression[*], deepCtx:CompilerContext[1], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    // Step 1: Pre-resolve non-lambda params once (like Java lines 86-94).
    // Lambdas are excluded because their param types depend on the candidate's type-parameter bindings.
    //
    // Error handling: errors that fire while resolving a sub-expression that
    // *itself* came back surface-resolved (FunctionExpression with `func` set)
    // are *real* — they describe a problem inside that sub-expression's body
    // (e.g. an unresolved property access in a lambda inside the sub-call).
    // These must propagate up so the surrounding multi-candidate dispatch
    // doesn't silently mask them by picking a permissive cast variant
    // (e.g. `cast(Any[m])`) that treats the unresolved-internals
    // sub-expression as already-concrete and skips re-resolving it.
    //
    // Errors from sub-expressions that fail to surface-resolve (no `func`)
    // are speculative — the candidate trial will re-attempt them with
    // candidate-specific bindings, so we drop them here to avoid noise.
    let preResolvedAcc = $fi.parametersValues->fold({pv, acc |
        let pvRes = $pv->match([
            av : AtomicValue[1] |
                if($av.value->toOne()->instanceOf(LambdaFunction),
                    | ^CompilerResult<ValueSpecification>(value = $pv, context = $acc.context),
                    | resolveValueSpecification($pv, $scope, $acc.context)
                );,
            other : Any[1] |
                resolveValueSpecification($pv, $scope, $acc.context)
        ]);
        let resolvedValue = if($pvRes.value->isEmpty(), | $pv, | $pvRes.value->toOne());
        // Determine if the sub-expression came back FULLY surface-resolved:
        //   FunctionExpression with both `func` AND a concrete (non-NotSet)
        //   `genericType`. resolveFunctionApplicationUsingTemplateFunction
        //   sets `func` even on its partial-success path (when params remain
        //   unresolved or validation fails), but in those cases the
        //   genericType is left empty / NotSet — so checking just `func`
        //   would falsely classify a partially-resolved sub-expression as
        //   "surface-resolved" and let its body errors propagate. Only the
        //   full-success path (line ~449 of this file) sets both.
        //
        // When fully surface-resolved, any errors fired are real and must
        // propagate up so the surrounding multi-candidate dispatch can't
        // silently mask them by picking a permissive variant (e.g.
        // `cast(Any[m])`) that treats the sub-expression as already-concrete
        // and skips re-resolving. Otherwise (failure / partial), drop the
        // trial context — the candidate trial will re-attempt with
        // candidate-specific bindings and can produce its own diagnostics.
        let isSurfaceResolved = $resolvedValue->match([
            fe : FunctionExpression[1] |
                $fe.func->isNotEmpty()
                    && isConcreteInContext($fe.genericType, $fe.multiplicity, $context),
            a  : Any[1]                | false
        ]);
        let nextCtx = if($isSurfaceResolved, | $pvRes.context, | $acc.context);
        ^$acc(values = $acc.values->concatenate($resolvedValue), context = $nextCtx);
    }, ^CompilerListResult<ValueSpecification>(context = $context, values = []->cast(@ValueSpecification)));
    let preResolvedParams = $preResolvedAcc.values;
    let preResolveCtx = $preResolvedAcc.context;
    let preResolvedFI = ^$fi(parametersValues = $preResolvedParams);

    // Step 2: Try each candidate with the fixpoint — first clean resolution wins (like Java lines 97-126).
    // The candidate try uses ORIGINAL context (each attempt is independent); counters
    // accumulate in $acc.context so totals/per-element deltas survive across iterations.
    // The lambdaResolutionCache and lambdaFailureCache, however, MUST survive across
    // attempts: a lambda body resolved during candidate A is the same body when exploring
    // candidate B (the cache key already gates that). Without this threading, the cache
    // resets per candidate and never amortizes across the candidate explosion.
    let tryResult = $candidates->fold({candidate, acc |
        if($acc.resolved,
            | $acc,
            | debug($deepCtx, | 'trying candidate: ' + $candidate->elementToPath());
              let accCtx = $acc.context;
              let bumpedAccCtx = ^$accCtx(candidateEvaluations = $accCtx.candidateEvaluations + 1);
              // Use preResolveCtx as the baseline: errors that fire here are
              // those *added by this candidate trial*, not pre-existing
              // errors from pre-resolve (which are real and must not cause
              // a trial-rollback).
              let checkpoint = $preResolveCtx->errorCheckpoint();
              // Seed candidate try with preResolveCtx (which carries the
              // pre-resolve errors), but carry forward the cache state
              // accumulated by prior candidate attempts.
              let ctxWithCache1 = ^$preResolveCtx(lambdaResolutionCache = $accCtx.lambdaResolutionCache);
              let candidateCtx = ^$ctxWithCache1(lambdaFailureCache = $accCtx.lambdaFailureCache);
              let result = resolveFunctionApplicationUsingTemplateFunction($preResolvedFI, $candidate, $scope, $candidateCtx);
              let resultCtx = $result.context;
              if($resultCtx->errorCheckpoint() == $checkpoint,
                  | // Clean resolution — success. Merge accumulated counters into the
                    // resultCtx returned by the candidate try (which carries no counter
                    // bumps since we passed $context, not $acc.context).
                    debug($deepCtx, | 'candidate resolved cleanly');
                    let mergedResultCtx = ^$resultCtx(
                        candidateEvaluations = $resultCtx.candidateEvaluations + $bumpedAccCtx.candidateEvaluations - $context.candidateEvaluations,
                        inferenceRollbacks = $resultCtx.inferenceRollbacks + $bumpedAccCtx.inferenceRollbacks - $context.inferenceRollbacks
                    );
                    let mergedResult = ^$result(context = $mergedResultCtx);
                    ^$acc(resolved = true, result = $mergedResult, resolvedCandidate = $candidate, context = $bumpedAccCtx);,
                  | // Resolution produced errors — backtrack. Bump rollback counter,
                    // save first candidate's errors, try next. Carry the cache state
                    // from the failed attempt forward.
                    debug($deepCtx, | 'candidate produced errors, trying next');
                    let rollbackCtx1 = $bumpedAccCtx->bumpRollbackSite('CANDIDATE_FAILED');
                    let rollbackCtx2 = ^$rollbackCtx1(lambdaResolutionCache = $resultCtx.lambdaResolutionCache);
                    // Carry resultCtx's rollbackSites forward so failed-candidate site
                    // events accumulate across the fold (otherwise each next candidate
                    // try resets sites to bumpedAccCtx's snapshot and we under-report).
                    let rollbackCtx = ^$rollbackCtx2(lambdaFailureCache = $resultCtx.lambdaFailureCache, rollbackSites = $resultCtx.rollbackSites);
                    let savedErrors = if($acc.firstErrors->isEmpty(), | $resultCtx->snapshotErrors($checkpoint), | $acc.firstErrors);
                    ^$acc(firstErrors = $savedErrors, context = $rollbackCtx);
              );
        );
    }, ^CandidateTryAccumulator(resolved = false, context = $preResolveCtx));

    // Step 3: Return result or restore first candidate's errors (like Java lines 127-133)
    if($tryResult.resolved,
        | // Check for equally-specific ties (ambiguity detection — matches Java lines 104-115)
          // Use normalized function type comparison (ignores TypeParameter name differences between PDB and local functions)
          let resolvedCandidate = $tryResult.resolvedCandidate->toOne();
          let resolvedFT = $resolvedCandidate->getFunctionType($context);
          let resolvedNorm = normalizeFunctionTypeForComparison($resolvedFT);
          let tied = $candidates->filter(c |
              normalizeFunctionTypeForComparison($c->getFunctionType($context)) == $resolvedNorm
          );
          debug($deepCtx, | 'ambiguity check: tied=' + $tied->size()->toString() + ' for ' + $fi.functionName->toOne());
          if($tied->size() > 1,
              | // Ambiguous — multiple equally-specific candidates
                let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $context);
                let signatures = $tied->map(t | functionSignature($t, $context))->sort()->joinStrings(', ');
                let resolvedResult = $tryResult.result->toOne();
                let resolvedCtx = $resolvedResult.context;
                debug($deepCtx, | 'AMBIGUOUS: ' + $signatures + $siCtx + ' (errors before=' + $resolvedCtx.errors->size()->toString() + ')');
                // Return unresolved expression with resolved parametersValues — matches Java's resolved._func(null)
                // In Java (mutable), func is set to null on the resolved expression.
                // In Pure (immutable), we create from the original $fi (which has no func, no genericType)
                // and copy the resolved parametersValues. This ensures the expression gets re-resolved in candidate attempts.
                let resolvedFI = $resolvedResult.value->toOne()->cast(@FunctionApplication);
                let ambiguousValue = ^$fi(parametersValues = $resolvedFI.parametersValues);
                ^CompilerResult<ValueSpecification>(
                    value = $ambiguousValue,
                    context = ^$resolvedCtx(errors += 'Ambiguous function call: multiple equally-specific matches found [' + $signatures + ']' + $siCtx));,
              | $tryResult.result->toOne()
          );,
        | // No candidate resolved cleanly — restore first candidate's errors.
          // Use $tryResult.context (which carries the accumulated counter bumps
          // from every failed candidate try) so the rollback/candidate counters
          // aren't lost on the failure path.
          if($tryResult.firstErrors->isNotEmpty(),
              | ^CompilerResult<ValueSpecification>(
                    value = $fi,
                    context = ^$preResolveCtx(
                        errors += $tryResult.firstErrors,
                        inferenceRollbacks = $tryResult.context.inferenceRollbacks,
                        candidateEvaluations = $tryResult.context.candidateEvaluations
                    ));,
              | ^CompilerResult<ValueSpecification>(
                    value = $fi,
                    context = ^$preResolveCtx(
                        inferenceRollbacks = $tryResult.context.inferenceRollbacks,
                        candidateEvaluations = $tryResult.context.candidateEvaluations
                    ));
          );
    );
}

// ============================================================================
// Template function resolution with fixpoint
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveFunctionApplicationUsingTemplateFunction(fi:FunctionApplication[1], entry:PackageableFunction<Any>[1], scope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    // Path-keyed lookup is authoritative — no fallback to $entry.
    let entryPath = $entry->elementToPath();
    let resolvedEntry = $context->resolveElement($entryPath)->toOne()->cast(@Function<Any>);
    let ft = $resolvedEntry->getFunctionType($context);
    let funcParams = $ft.parameters->cast(@VariableExpression);

    debug($context, | 'resolveFunctionApplicationUsingTemplateFunction: ' + $entryPath + ' (' + $fi.parametersValues->size()->toString() + ' args)');

    // Push entry's type/multiplicity param names into scope (like Java FunctionIndexEntry constructor lines 95-102)
    // Extract referenced type param names from the FunctionType of the resolved function
    let entryTypeParams = $ft->collectFunctionTypeReferencedTypeParameterNames();
    let entryMulParams = $ft->collectFunctionTypeReferencedMultiplicityParameterNames();
    debug($context, | 'scope: pushing typeParams=[' + $entryTypeParams->joinStrings(',') + '] mulParams=[' + $entryMulParams->joinStrings(',') + ']');
    let scopedCtx = ^$context(
        scopeTypeParams = $context.scopeTypeParams->concatenate($entryTypeParams),
        scopeMulParams = $context.scopeMulParams->concatenate($entryMulParams)
    );
    let deepCtx = $scopedCtx->debugSpaceInc();

    // Clear stale resolved params — they've been seeded into the node (mirrors Java cleanExpr lines 152-154)
    // Clear stale resolved params — they've been seeded into the node (mirrors Java cleanExpr lines 152-154).
    let cleanFI = ^$fi(resolvedTypeParameters = [], resolvedMultiplicityParameters = []);

    // Initialize: all params start unresolved
    let initInfos = $cleanFI.parametersValues->map(pv | ^ParameterInfo(resolved = false, newParam = $pv, savedErrors = []));

    // Create FunctionCallParametersBinding with enclosingOwner (mirrors Java pushBindingNode line 149)
    let seedBindings = $fi.resolvedTypeParameters->fold({rtp, b |
        collectTypeParameterBindings(
            buildUserDefinedGenericType(buildTypeParameter($rtp.name)),
            $rtp.value,
            $b
        );
    }, newPlainParametersBinding()->cast(@ParametersBinding));
    let seedBindings2 = $fi.resolvedMultiplicityParameters->fold({rmp, b |
        collectMultiplicityParameterBindings(
            buildUserDefinedMultiplicityParameter($rmp.name),
            $rmp.value,
            $b
        );
    }, $seedBindings);
    let ownTypeParamNames = $entryTypeParams;
    let ownMulParamNames = $entryMulParams;
    let node = ^FunctionCallParametersBinding(
        expr = $fi,
        function = $entry,
        ownTypeParams = newMap($ownTypeParamNames->map(n | pair($n, buildTypeParameter($n, false)))),
        ownMulParams = newMap($ownMulParamNames->map(n | pair($n, buildUserDefinedMultiplicityParameter($n)->cast(@MultiplicityParameter)))),
        enclosingOwner = $deepCtx.enclosingOwnerBinding,
        typeBindings = $seedBindings2.typeBindings,
        multiplicityBindings = $seedBindings2.multiplicityBindings
    );

    // Fixpoint: resolve params iteratively until no more progress
    let fixpointResult = fixpointResolveParams($initInfos, $cleanFI, $funcParams, $node->cast(@ParametersBinding), $scope, $deepCtx, 1);
    let resolvedInfos = $fixpointResult.infos;
    // Unify: cross-match, transitive resolution, pre-reduction, common-type reduction (like Java unify())
    let bindings = $fixpointResult.bindings->match([
        fcpb:FunctionCallParametersBinding[1] | unify($fcpb, $context)->cast(@ParametersBinding),
        other:ParametersBinding[1] | $other
    ]);
    let ctx1 = $fixpointResult.context;

    // Propagate enclosing owner bindings back to context (mirrors Java mutable enclosingOwnerParametersBinding)
    let ctx1WithOwner = $bindings->match([
        fcpb:FunctionCallParametersBinding[1] |
            if($fcpb.enclosingOwner->isNotEmpty(),
                | ^$ctx1(enclosingOwnerBinding = $fcpb.enclosingOwner->toOne()),
                | $ctx1
            ),
        other:ParametersBinding[1] | $ctx1
    ]);

    // Push back saved errors from all unresolved args
    let unresolvedErrors = $resolvedInfos->filter(info | !$info.resolved)->map(info | $info.savedErrors);
    let ctx2 = ^$ctx1WithOwner(errors += $unresolvedErrors);

    // Assemble result
    let resolvedParams = $resolvedInfos->map(info | $info.newParam);
    let hasUnresolved = $resolvedInfos->exists(info | !$info.resolved);

    // Compiler-tracked enrichment: for relation column functions, the TypeHolder's RelationType
    // can't be inferred from bindings alone — mirrors Java RelationColumnResolver.enrichRelationTypeHolderForMagicalFunctions.
    // Must run regardless of hasUnresolved — Java calls this even when the TypeHolder is unresolved.
    let enrichResult = enrichRelationTypeHolderForMagicalFunctions($fi.functionName->toOne(), $resolvedParams, $ft, $bindings, $ctx2, $fi.sourceInformation);
    let enrichedParams = $enrichResult.resolvedParams;
    let enrichedBindings = $enrichResult.bindings;
    let enrichedCtx = $enrichResult.context;

    let entryPointer = $entry->toPackageableFunctionPointer();

    if($hasUnresolved,
        | ^CompilerResult<ValueSpecification>(
              value = ^$cleanFI(func = $entryPointer, parametersValues = $enrichedParams),
              context = $enrichedCtx),
        | // All resolved — validate arg types against param types. Mirrors Java
          // FunctionApplicationResolver.resolveFunctionApplicationUsingTemplateFunctionForInference
          // (lines 178-186): when all unresolved params have been processed, Java
          // unconditionally calls `validateAndPopulate` (which emits
          // "No matching function 'X' found for argument types (...)" if the
          // resolved arg type/multiplicity is incompatible with the candidate's
          // parameter signature). Pure previously short-circuited this when any
          // earlier error was produced during fixpoint (e.g. a lambda body's
          // missing property), suppressing the legit type-mismatch error that
          // would let the user see "lambda returns Boolean[*] but filter wants
          // Boolean[1]". Removing the guard recovers ~4 errors that match Java's
          // "No matching function" output for filter/map/j_code/plus.
          let fiSrcInfo = $fi.sourceInformation;
          let validationResult = validateParameterTypes($fi.functionName->toOne(), $enrichedParams, $funcParams, $enrichedBindings, $fiSrcInfo, $enrichedCtx);
          let validationCtx = $validationResult.context;
          let validatedParams = $validationResult.reconciledParams;
          let validatedBindings = $validationResult.bindings;
          if($validationCtx.errors->size() > $enrichedCtx.errors->size(),
              | // Preserve func on validation failure
                ^CompilerResult<ValueSpecification>(
                    value = ^$cleanFI(func = $entryPointer, parametersValues = $validatedParams->cast(@ValueSpecification)),
                    context = $validationCtx);,
              |
          // Build return type using validated bindings (includes reconciled inferred values)
          let returnGT = makeAsConcreteAsPossible($ft.returnType->toOne(), $validatedBindings, $context);
          let returnMul = makeAsConcreteAsPossible($ft.returnMultiplicity->toOne(), $validatedBindings);
          let inferredReturnGT = asInferredGenericType($returnGT);
          let inferredReturnMul = asInferredMultiplicity($returnMul);

          // Build resolved type/multiplicity parameters from validated bindings
          // Filter by ownTypeParamNames — only include this function's own params (mirrors Java populateResolvedParameters lines 97-99)
          // Use findCommonGenericType for multi-valued bindings (mirrors Java populateResolvedParameters)
          let resolvedTypeParams = $validatedBindings.typeBindings->keys()
              ->filter(k | $ownTypeParamNames->isEmpty() || $ownTypeParamNames->contains($k))
              ->map(k |
              let vals = $validatedBindings.typeBindings->get($k)->toOne().values;
              let boundGT = if($vals->size() == 1,
                  | $vals->at(0),
                  | let common = findCommonGenericType($vals, $context);
                    if($common->isEmpty(), | $vals->at(0), | $common->toOne());
              );
              buildResolvedTypeParameter($k, $boundGT);
          );
          let resolvedMulParams = $validatedBindings.multiplicityBindings->keys()
              ->filter(k | $ownMulParamNames->isEmpty() || $ownMulParamNames->contains($k))
              ->map(k |
              let vals = $validatedBindings.multiplicityBindings->get($k)->toOne().values;
              buildResolvedMultiplicityParameter($k, $vals->at(0));
          );

          ^CompilerResult<ValueSpecification>(
              value = ^$cleanFI(
                  func = $entryPointer,
                  parametersValues = $validatedParams->cast(@ValueSpecification),
                  genericType = $inferredReturnGT,
                  multiplicity = $inferredReturnMul,
                  resolvedTypeParameters = $resolvedTypeParams,
                  resolvedMultiplicityParameters = $resolvedMulParams
              ),
              context = $validationCtx
          );
          ); // end validation check
    );
}

// Mirrors Java validateParameterValuesToFunctionType
// Mirrors Java validateParameterValuesToFunctionType — validates AND reconciles arg types.
Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::ValidationResult
{
    reconciledParams: ValueSpecification[*];
    bindings: ParametersBinding[1];
    context: CompilerContext[1];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::ValidationAccumulator
{
    reconciledParams: ValueSpecification[*];
    bindings: ParametersBinding[1];
    failed: Boolean[1];
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::validateParameterTypes(
    functionName:String[1],
    resolvedParams:ValueSpecification[*],
    funcParams:VariableExpression[*],
    bindings:ParametersBinding[1],
    sourceInfo:SourceInformation[0..1],
    context:CompilerContext[1]
):ValidationResult[1]
{
    let siCtx = formatMetamodelSourceInfo($sourceInfo, $context);
    let result = range($resolvedParams->size())->fold({i, acc |
        if($acc.failed,
            | ^$acc(reconciledParams += $resolvedParams->at($i)),
            | let argVS = $resolvedParams->at($i);
              if($argVS.genericType->isEmpty(),
                  | ^$acc(reconciledParams += $argVS),
                  |
              let argGT = $argVS.genericType->toOne();
              let argMul = $argVS.multiplicity->toOne();
              if($argGT->instanceOf(UndefinedGenericType) || $argGT->instanceOf(CompilerNotSetGenericType),
                  | ^$acc(reconciledParams += $argVS),
                  | let expectedGT = makeAsConcreteAsPossible($funcParams->at($i).genericType->toOne(), $acc.bindings, $context);
                    let expectedMul = makeAsConcreteAsPossible($funcParams->at($i).multiplicity->toOne(), $acc.bindings);
                    // Reconcile expected with actual (mirrors Java reconcileInferred)
                    debug($context, | 'validateParam[' + $i->toString() + ']: expected=' + printGenericType($expectedGT) + ' actual=' + printGenericType($argGT));
                    let reconciledArgGT = reconcileInferred($expectedGT, $argGT, $context);
                    debug($context, | 'validateParam[' + $i->toString() + ']: reconciled=' + printGenericType($reconciledArgGT) + ' sameAsActual=' + ($reconciledArgGT == $argGT)->toString());
                    // Mirrors Java rebuildWithReconciledType: for lambdas, rebuild with reconciled FunctionType params
                    let reconciledVS = $argVS->match([
                        av:AtomicValue[1] |
                            if($av.value->toOne()->instanceOf(LambdaFunction),
                                | let lambda = $av.value->toOne()->cast(@LambdaFunction<Any>);
                                  let reconciledFT = $reconciledArgGT->genericTypeTypeArguments()->at(0)->match([
                                      ftGT:GenericTypeValue[1] | if($ftGT.type->isNotEmpty() && $ftGT.type->toOne()->instanceOf(FunctionType), | $ftGT.type->toOne()->cast(@FunctionType), | []),
                                      a:Any[1] | []
                                  ]);
                                  if($reconciledFT->isNotEmpty() && $reconciledFT->toOne().parameters->isNotEmpty(),
                                      | // Mirror Java rebuildWithReconciledType: also overwrite the lambda's
                                      // classifierGenericType with the reconciled GT so the inner FT.parameters
                                      // (with no SI) replace the original SI-bearing ones in both views.
                                      let newLambda = ^$lambda(
                                          parameters = $reconciledFT->toOne().parameters,
                                          classifierGenericType = $reconciledArgGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue)
                                      );
                                        ^$av(value = $newLambda, genericType = $reconciledArgGT);,
                                      | ^$argVS(genericType = $reconciledArgGT)
                                  );,
                                | ^$argVS(genericType = $reconciledArgGT)
                            ),
                        other:Any[1] | ^$argVS(genericType = $reconciledArgGT)
                    ]);
                    let updatedBindings = $acc.bindings;
                    let typeOk = isCompatibleGenericType($expectedGT, $reconciledArgGT, $context);
                    let mulOk = multiplicitySubsumes($expectedMul, $argMul);
                    if(!$typeOk || !$mulOk,
                        | ^$acc(reconciledParams += $reconciledVS, bindings = $updatedBindings, failed = true);,
                        | ^$acc(reconciledParams += $reconciledVS, bindings = $updatedBindings)
                    );
              );
              );
        );
    }, ^ValidationAccumulator(failed = false, bindings = $bindings));
    let finalCtx = if($result.failed,
        | let argDesc = $result.reconciledParams->map(vs | if($vs.genericType->isEmpty(), |'?', |printGenericType($vs.genericType->toOne())) + if($vs.multiplicity->isEmpty(), |'[?]', |printMultiplicity($vs.multiplicity->toOne())))->joinStrings(', ');
          ^$context(errors += 'No matching function \'' + $functionName + '\' found for argument types (' + $argDesc + ')' + $siCtx);,
        | $context
    );
    ^ValidationResult(reconciledParams = $result.reconciledParams, bindings = $result.bindings, context = $finalCtx);
}

// ============================================================================
// Fixpoint iteration
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::fixpointResolveParams(
    infos:ParameterInfo[*],
    expr:FunctionApplication[1],
    funcParams:VariableExpression[*],
    bindings:ParametersBinding[1],
    scope:VariableExpression[*],
    context:CompilerContext[1],
    iteration:Integer[1]
):FixpointResult[1]
{
    debug($context, | '--- fixpoint iteration ' + $iteration->toString() + ' ---');

    // One pass: try to resolve each unresolved param
    let passResult = range($infos->size())->fold({i, acc |
        let info = $infos->at($i);
        if($info.resolved,
            | ^$acc(infos += $info),
            | let parameterValue = $info.newParam;
              let paramGT = $funcParams->at($i).genericType->toOne();
              let paramMul = $funcParams->at($i).multiplicity->toOne();

              debug($acc.context, | 'parameterValue[' + $i->toString() + '] class=' + $parameterValue->type()->toOne()->elementToPath()
                  + ' paramGT=' + printGenericType($paramGT)
                  + ' bindings={' + $acc.bindings->meta::pure::compiler::helper::parametersBinding::toString() + '}');

              let resolveResult = resolveOneParam($parameterValue, $paramGT, $paramMul, $acc.bindings, $scope, $acc.context);

              if($resolveResult.resolved,
                  | debug($acc.context, | '=> RESOLVED gt=' + printGenericType($resolveResult.newParam.genericType->toOne())
                        + if($resolveResult.newParam.multiplicity->isEmpty(), | '', | ' mul=' + printMultiplicity($resolveResult.newParam.multiplicity->toOne())));
                    ^$acc(infos += ^ParameterInfo(resolved = true, newParam = $resolveResult.newParam, savedErrors = []),
                          bindings = $resolveResult.bindings,
                          context = $resolveResult.context,
                          madeProgress = true);,
                  | debug($acc.context, | '=> NOT RESOLVED');
                    ^$acc(infos += ^ParameterInfo(resolved = false, newParam = $resolveResult.newParam, savedErrors = $resolveResult.savedErrors),
                          context = $resolveResult.context);
              );
        );
    }, ^FixpointAccumulator(bindings = $bindings, context = $context, madeProgress = false));

    let updatedInfos = $passResult.infos;
    let updatedBindings = $passResult.bindings;
    let updatedCtx = $passResult.context;

    if($passResult.madeProgress,
        | fixpointResolveParams($updatedInfos, $expr, $funcParams, $updatedBindings, $scope, $updatedCtx, $iteration + 1),
        | ^FixpointResult(infos = $updatedInfos, bindings = $updatedBindings, context = $updatedCtx)
    );
}

// ============================================================================
// Single parameter resolution — two-function structure matching Java
// ============================================================================

// Mirrors Java resolveOneParam (lines 229-268)
// OUTER function: uniform checkpoint/snapshot/rollback for ALL dispatch paths
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveOneParam(
    parameterValue:ValueSpecification[1],
    paramGT:GenericType[1],
    paramMul:Multiplicity[1],
    bindings:ParametersBinding[1],
    scope:VariableExpression[*],
    context:CompilerContext[1]
):ResolveOneParamResult[1]
{
    let checkpoint = $context->errorCheckpoint();
    let result = resolveParameterValue($parameterValue, $paramGT, $paramMul, $bindings, $scope, $context);

    // TypeHolder (GenericTypeAndMultiplicityHolder) is always considered resolved — compiler-managed, enriched later
    // (mirrors Java isSuccessfullyProcessed line 683: parameterValue instanceof CompilerGenericTypeAndMultiplicityHolder)
    let isResolved = $result.resolved || $parameterValue->instanceOf(GenericTypeAndMultiplicityHolder);

    if($isResolved,
        | if($parameterValue->instanceOf(GenericTypeAndMultiplicityHolder),
              | debug($context, | '=> RESOLVED (TypeHolder = compiler-managed, enriched later)');,
              | debug($context, | '=> RESOLVED gt=' + if($result.newParam.genericType->isNotEmpty(), | printGenericType($result.newParam.genericType->toOne()), | '?'));
          );
          ^ResolveOneParamResult(resolved = true, newParam = $result.newParam, bindings = $result.bindings, context = $result.context, savedErrors = []);,
        | // Not resolved: snapshot errors and rollback (Java lines 263-266)
          let savedErrors = $result.context->snapshotErrors($checkpoint);
          let rolledBackCtx = $result.context->rollbackErrors($checkpoint, 'PARAM_UNRESOLVED');
          debug($context, | '=> NOT RESOLVED');
          ^ResolveOneParamResult(resolved = false, newParam = $result.newParam, bindings = $result.bindings, context = $rolledBackCtx, savedErrors = $savedErrors);
    );
}

// Mirrors Java resolveParameterValue (lines 406-497)
// INNER function: pure dispatch, no error handling — caller handles uniformly
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveParameterValue(
    parameterValue:ValueSpecification[1],
    paramGT:GenericType[1],
    paramMul:Multiplicity[1],
    bindings:ParametersBinding[1],
    scope:VariableExpression[*],
    context:CompilerContext[1]
):ResolveOneParamResult[1]
{
    let checkpoint = $context->errorCheckpoint();

    // If the arg already carries a concrete type and multiplicity, skip VSR (Java lines 422-425)
    let alreadyConcrete = $parameterValue.genericType->isNotEmpty()
        && $parameterValue.genericType->toOne()->isConcreteGenericType()
        && $parameterValue.multiplicity->isNotEmpty() && $parameterValue.multiplicity->toOne()->isConcreteMultiplicity();
    let r = if($alreadyConcrete,
        | ^CompilerResult<ValueSpecification>(value = $parameterValue, context = $context),
        | resolveValueSpecification($parameterValue, $scope, $context)
    );
    let processed = if($r.value->isEmpty(), | $parameterValue, | $r.value->toOne());
    let ctx1 = $r.context;

    let isConcrete = isConcreteInContext($processed.genericType, $processed.multiplicity, $context);

    if($isConcrete,
        | // CONCRETE: collect bindings (Java lines 427-440)
          debug($context, | 'resolveArg: CONCRETE gt=' + printGenericType($processed.genericType->toOne()));
          let rawArgGT = $processed.genericType->toOne();
          let argMul = $processed.multiplicity->toOne();
          // When arg type differs from param type, resolve to param's raw type level (Java lines 435-438)
          let paramRawType = $paramGT->match([gtv:GenericTypeValue[1] | $gtv.type, a:Any[1] | []]);
          let argRawType = $rawArgGT->match([gtv:GenericTypeValue[1] | $gtv.type, a:Any[1] | []]);
          let argGT = if($paramRawType->isNotEmpty() && !$paramRawType->toOne()->instanceOf(TypeParameter)
                         && $argRawType->isNotEmpty() && !typeEquals($paramRawType->toOne(), $argRawType->toOne()),
              | let resolved = resolveForTarget($rawArgGT, $paramRawType->toOne(), $context);
                if($resolved->isEmpty(), | $rawArgGT, | $resolved->toOne());,
              | $rawArgGT
          );
          let b1 = collectTypeParameterBindings($paramGT, $argGT, $bindings);
          let b2 = collectMultiplicityParameterBindings($paramMul, $argMul, $b1);
          ^ResolveOneParamResult(resolved = true, newParam = $processed, bindings = $b2, context = $ctx1, savedErrors = []);,
        | // Dispatch by type: LAMBDA / REVERSE_MATCH / COLLECTION / NO_MATCH
          $processed->match([
              av : AtomicValue[1] |
                  // Check if LAMBDA (Java line 442-448)
                  if($av.value->toOne()->instanceOf(LambdaFunction),
                      | let ctx2 = $ctx1->rollbackErrors($checkpoint, 'LAMBDA_DISPATCH');
                        debug($context, | 'resolveArg: LAMBDA');
                        let lambda = $av.value->toOne()->cast(@LambdaFunction<Any>);
                        let reprocessedLambda = setMissingLambdaParameterInformation($lambda, $paramGT, $bindings, $context);
                        let withReprocessedLambda = ^$av(value = $reprocessedLambda);
                        finishProcessing($paramGT, $paramMul, $bindings, $scope, $ctx2, $withReprocessedLambda);,
                      | // AtomicValue but not a lambda — NO_MATCH
                        debug($context, | 'resolveArg: NO_MATCH class=' + $processed->type()->toOne()->elementToPath());
                        ^ResolveOneParamResult(resolved = false, newParam = $processed, bindings = $bindings, context = $ctx1, savedErrors = []);
                  );,
              fi2 : FunctionInvocation[1] |
                  // Check if REVERSE_MATCH (Java line 450-454)
                  if($fi2.func->isNotEmpty(),
                      | let ctx2 = $ctx1->rollbackErrors($checkpoint, 'REVERSE_MATCH_DISPATCH');
                        debug($context, | 'resolveArg: REVERSE_MATCH func=' + $fi2.functionName->toOne()
                            + ' childGT=' + if($fi2.genericType->isEmpty(), | '?', | printGenericType($fi2.genericType->toOne())));
                        let reversedChild = reverseMatch($fi2, $paramGT, $paramMul, $bindings, $context);
                        finishProcessing($paramGT, $paramMul, $bindings, $scope, $ctx2, $reversedChild);,
                      | // FunctionInvocation without func — NO_MATCH
                        debug($context, | 'resolveArg: NO_MATCH class=' + $processed->type()->toOne()->elementToPath());
                        ^ResolveOneParamResult(resolved = false, newParam = $processed, bindings = $bindings, context = $ctx1, savedErrors = []);
                  );,
              col : Collection[1] |
                  // COLLECTION (Java line 456-494)
                  let ctx2 = $ctx1->rollbackErrors($checkpoint, 'COLLECTION_DISPATCH');
                  let resolvedParamGT = makeAsConcreteAsPossible($paramGT, $bindings, $context);
                  let resolvedParamMul = makeAsConcreteAsPossible($paramMul, $bindings);
                  debug($context, | 'resolveArg: COLLECTION (' + $col.values->size()->toString() + ' elements) resolvedParamGT=' + printGenericType($resolvedParamGT));
                  // Resolve each element via resolveParameterValue (not resolveOneParam) to match Java
                  // where resolveParameterValue calls itself recursively for collection elements.
                  // Errors accumulate on the mutable context — no snapshot/rollback per element.
                  let colResult = $col.values->fold({element, acc |
                      let elementResult = resolveParameterValue($element, $resolvedParamGT, $resolvedParamMul, $bindings, $scope, $acc.context);
                      ^$acc(values += $elementResult.newParam, context = $elementResult.context);
                  }, ^CompilerListResult<ValueSpecification>(context = $ctx2));
                  let newCol = ^$col(values = $colResult.values);
                  // Prevent finishProcessing's VSR.resolve from re-producing duplicate errors
                  let preFinishCheckpoint = $colResult.context->errorCheckpoint();
                  let fpResult = finishProcessing($paramGT, $paramMul, $bindings, $scope, $colResult.context, $newCol);
                  if($fpResult.context->errorCheckpoint() > $preFinishCheckpoint,
                      | ^$fpResult(context = $fpResult.context->rollbackErrors($preFinishCheckpoint, 'POST_FINISH_COLLECTION_ROLLBACK')),
                      | $fpResult
                  );,
              other : Any[1] |
                  // NO_MATCH (Java line 495-496)
                  debug($context, | 'resolveArg: NO_MATCH class=' + $processed->type()->toOne()->elementToPath());
                  ^ResolveOneParamResult(resolved = false, newParam = $processed, bindings = $bindings, context = $ctx1, savedErrors = []);
          ]);
    );
}

// Mirrors Java setMissingLambdaParameterInformation (lines 523-556)
// Sets lambda param types from the function parameter's expected type using current bindings
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::setMissingLambdaParameterInformation(
    lambda:LambdaFunction<Any>[1],
    paramGT:GenericType[1],
    bindings:ParametersBinding[1],
    context:CompilerContext[1]
):LambdaFunction<Any>[1]
{
    // Resolve the function parameter's Function<{FunctionType}> to concrete types using current bindings
    // e.g. Function<{T[1]->Boolean[1]}> with T=String => Function<{String[1]->Boolean[1]}>
    let concreteGT = makeAsConcreteAsPossible($paramGT, $bindings, $context);
    $concreteGT->match([
        concreteGTV : GenericTypeValue[1] |
            if($concreteGTV.typeArguments->isNotEmpty(),
                | $concreteGTV.typeArguments->at(0)->match([
                      innerGTV : GenericTypeValue[1] |
                          if($innerGTV.type->isNotEmpty() && $innerGTV.type->toOne()->instanceOf(FunctionType),
                              | let ft = $innerGTV.type->toOne()->cast(@FunctionType);
                                let lambdaParams = $lambda.parameters->cast(@VariableExpression);
                                let newParams = $ft.parameters->cast(@VariableExpression)->zip($lambdaParams)->map({pair |
                                    let ftParam = $pair.first;
                                    let lambdaParam = $pair.second;
                                    let resolvedType = makeAsConcreteAsPossible($ftParam.genericType->toOne(), $bindings, $context);
                                    let resolvedMul = makeAsConcreteAsPossible($ftParam.multiplicity->toOne(), $bindings);
                                    // Replace if param type is not concrete (CompilerNotSetGenericType = Java null = not concrete)
                                    let lambdaGT = $lambdaParam.genericType->toOne();
                                    let newGT = if(!$lambdaGT->isConcreteGenericType(), | asInferredGenericType($resolvedType), | $lambdaGT);
                                    let lambdaMul = $lambdaParam.multiplicity->toOne();
                                    let newMul = if(!$lambdaMul->isConcreteMultiplicity(), | asInferredMultiplicity($resolvedMul), | $lambdaMul);
                                    ^$lambdaParam(genericType = $newGT, multiplicity = $newMul);
                                });
                                ^$lambda(parameters = $newParams);,
                              | $lambda
                          );,
                      other : Any[1] | $lambda
                  ]);,
                | $lambda
            );,
        other : Any[1] | $lambda
    ]);
}

// Mirrors Java finishProcessing (lines 490-517)
// Re-resolve via VSR, then collect bindings
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::finishProcessing(
    paramGT:GenericType[1],
    paramMul:Multiplicity[1],
    bindings:ParametersBinding[1],
    scope:VariableExpression[*],
    context:CompilerContext[1],
    vs:ValueSpecification[1]
):ResolveOneParamResult[1]
{
    // Re-resolve via VSR (now lambda has concrete param types)
    let r = resolveValueSpecification($vs, $scope, $context);
    let reResolved = if($r.value->isEmpty(), | $vs, | $r.value->toOne());
    let ctx1 = $r.context;

    // Mark child's resolved parameters as inferred (mirrors Java finishProcessing lines 507-520)
    let resolved = $reResolved->match([
        fe:FunctionExpression[1] |
            let wrappedTP = $fe.resolvedTypeParameters->map(rtp | ^$rtp(value = asInferredGenericType($rtp.value)));
            let wrappedMP = $fe.resolvedMultiplicityParameters->map(rmp | ^$rmp(value = asInferredMultiplicity($rmp.value)));
            ^$fe(resolvedTypeParameters = $wrappedTP, resolvedMultiplicityParameters = $wrappedMP)->cast(@ValueSpecification);,
        a:Any[1] | $reResolved
    ]);

    // Collect bindings from the re-resolved type
    debug($context, | 'finishProcessing: paramGT=' + printGenericType($paramGT) + ' resolvedGT=' + if($resolved.genericType->isEmpty(), |'?', |printGenericType($resolved.genericType->toOne())));
    let b1 = if($resolved.genericType->isNotEmpty(),
        | collectTypeParameterBindings($paramGT, $resolved.genericType->toOne(), $bindings),
        | $bindings
    );
    let b2 = if($resolved.multiplicity->isNotEmpty(),
        | collectMultiplicityParameterBindings($paramMul, $resolved.multiplicity->toOne(), $b1),
        | $b1
    );

    // Use isConcreteInContext (owner-aware) — same pattern as
    // atomicValueResolver.pure for lambda parameters. A resolved type that
    // references the enclosing function's own TypeParameter (e.g.
    // `LambdaFunction<...T...>` inside `firstNonEmpty<T>`) is "concrete enough"
    // for the surrounding fixpoint — Java treats it as resolved. The previous
    // strict check (`isConcreteGenericType`) marked such results unresolved,
    // causing the multi-candidate path to take the early-exit branch and
    // never populate resolvedTypeParameters; finalize then read empty
    // bindings and left the function's V parameter unsubstituted, surfacing
    // as "Return type error: expected T, got V". See
    // known_issues/lambda_generic_inference_through_fold.
    let isResolved = isConcreteInContext($resolved.genericType, $resolved.multiplicity, $context);

    ^ResolveOneParamResult(resolved = $isResolved, newParam = $resolved, bindings = $b2, context = $ctx1, savedErrors = []);
}

// ============================================================================
// Reverse match — push parent bindings into child (Java lines 562-583)
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::reverseMatch(
    childExpr:FunctionInvocation[1],
    paramGT:GenericType[1],
    paramMul:Multiplicity[1],
    bindings:ParametersBinding[1],
    context:CompilerContext[1]
):FunctionInvocation[1]
{
    // Collect child bindings: child's return type → parent's resolved param type
    let argGT = $childExpr.genericType->toOne();
    let childBindings = newPlainParametersBinding()->cast(@ParametersBinding);
    let resolvedParamGT = makeAsConcreteAsPossible($paramGT, $bindings, $context);
    let b1 = collectTypeParameterBindings($argGT, $resolvedParamGT, $childBindings);
    let resolvedParamMul = makeAsConcreteAsPossible($paramMul, $bindings);
    let b2 = collectMultiplicityParameterBindings($childExpr.multiplicity->toOne(), $resolvedParamMul, $b1);

    // Make child bindings concrete using parent bindings, then push into child expr.
    // Push ALL values (not just the first) so that populateResolvedParameters can fold
    // them via findCommonGenericType — mirrors Java's replaceAll + populateResolvedParameters.
    let concreteChildTypeBindings = $b2.typeBindings->keys()->fold({k, acc |
        let vals = $b2.typeBindings->get($k)->toOne().values;
        let concreteVals = $vals->map(gt | asInferredGenericType(makeAsConcreteAsPossible($gt, $bindings, $context)));
        $concreteVals->fold({cv, a |
            collectTypeParameterBindings(
                buildUserDefinedGenericType(buildTypeParameter($k)),
                $cv,
                $a
            );
        }, $acc);
    }, newPlainParametersBinding()->cast(@ParametersBinding));
    // Also push multiplicity bindings
    let concreteChildBindings = $b2.multiplicityBindings->keys()->fold({k, acc |
        let vals = $b2.multiplicityBindings->get($k)->toOne().values;
        let concreteVals = $vals->map(m | asInferredMultiplicity(makeAsConcreteAsPossible($m, $bindings)));
        $concreteVals->fold({cv, a |
            collectMultiplicityParameterBindings(
                buildUserDefinedMultiplicityParameter($k),
                $cv,
                $a
            );
        }, $acc);
    }, $concreteChildTypeBindings);

    populateResolvedParameters($childExpr, $concreteChildBindings, $context)->cast(@FunctionInvocation);
}

// ============================================================================
// Candidate matching (multiple candidates)
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::isCandidateCompatible(
    candidate:PackageableFunction<Any>[1],
    argTypes:GenericType[*],
    argMuls:Multiplicity[*],
    context:CompilerContext[1]
):Boolean[1]
{
    let ft = $candidate->getFunctionType($context);
    let params = $ft.parameters->cast(@VariableExpression);

    // Collect bindings from arg types against param types
    let bindings = range($argTypes->size())->fold({i, b |
        let paramGT = $params->at($i).genericType->toOne();
        let argGT = $argTypes->at($i);
        let b2 = collectTypeParameterBindings($paramGT, $argGT, $b);
        let paramMul = $params->at($i).multiplicity->toOne();
        let argMul = $argMuls->at($i);
        collectMultiplicityParameterBindings($paramMul, $argMul, $b2);
    }, newPlainParametersBinding()->cast(@ParametersBinding));

    // Check arg type and multiplicity compatibility
    $argTypes->zip($params)->forAll({pair |
        let argGT = $pair.first;
        let paramGT = $pair.second.genericType->toOne();
        let resolvedParamGT = makeAsConcreteAsPossible($paramGT, $bindings, $context);
        let isUndefined = $resolvedParamGT->instanceOf(UndefinedGenericType) || $argGT->instanceOf(UndefinedGenericType) || $resolvedParamGT->instanceOf(CompilerNotSetGenericType) || $argGT->instanceOf(CompilerNotSetGenericType);
        let isTypeParam = $resolvedParamGT->instanceOf(GenericTypeValue) && $resolvedParamGT->cast(@GenericTypeValue).type->isNotEmpty() && $resolvedParamGT->cast(@GenericTypeValue).type->toOne()->instanceOf(TypeParameter);
        if($isUndefined || $isTypeParam,
            | true,
            | let paramStr = printGenericType($resolvedParamGT);
              let argStr = printGenericType($argGT);
              isCompatibleGenericType($resolvedParamGT, $argGT, $context) || isCompatibleGenericType($argGT, $resolvedParamGT, $context) || ($paramStr == $argStr);
        );
    }) && $argMuls->zip($params)->forAll({pair |
        let argMul = $pair.first;
        let paramMul = $pair.second.multiplicity->toOne();
        let resolvedParamMul = makeAsConcreteAsPossible($paramMul, $bindings);
        multiplicitySubsumes($resolvedParamMul, $argMul);
    });
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::buildResolutionResult(
    candidate:PackageableFunction<Any>[1],
    argTypes:GenericType[*],
    argMuls:Multiplicity[*],
    context:CompilerContext[1]
):FunctionResolutionResult[1]
{
    let ft = $candidate->getFunctionType($context);
    let params = $ft.parameters->cast(@VariableExpression);
    let bindings = range($argTypes->size())->fold({i, b |
        let paramGT = $params->at($i).genericType->toOne();
        let argGT = $argTypes->at($i);
        let b2 = collectTypeParameterBindings($paramGT, $argGT, $b);
        let paramMul = $params->at($i).multiplicity->toOne();
        let argMul = $argMuls->at($i);
        collectMultiplicityParameterBindings($paramMul, $argMul, $b2);
    }, newPlainParametersBinding()->cast(@ParametersBinding));

    let returnGT = makeAsConcreteAsPossible($ft.returnType->toOne(), $bindings, $context);
    let returnMul = makeAsConcreteAsPossible($ft.returnMultiplicity->toOne(), $bindings);

    let resolvedTypeParams = $bindings.typeBindings->keys()->map(k |
        let vals = $bindings.typeBindings->get($k)->toOne().values;
        buildResolvedTypeParameter($k, asInferredGenericType($vals->at(0)));
    );
    let resolvedMulParams = $bindings.multiplicityBindings->keys()->map(k |
        let vals = $bindings.multiplicityBindings->get($k)->toOne().values;
        buildResolvedMultiplicityParameter($k, asInferredMultiplicity($vals->at(0)));
    );

    ^FunctionResolutionResult(
        resolvedFunction = $candidate,
        resolvedName = $candidate.name->toOne(),
        returnGenericType = asInferredGenericType($returnGT),
        returnMultiplicity = asInferredMultiplicity($returnMul),
        bindings = $bindings,
        resolvedTypeParameters = $resolvedTypeParams,
        resolvedMultiplicityParameters = $resolvedMulParams
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::findAllMatchingCandidates(
    candidates:PackageableFunction<Any>[*],
    functionName:String[1],
    argTypes:GenericType[*],
    argMuls:Multiplicity[*],
    context:CompilerContext[1]
):FunctionResolutionResult[*]
{
    $candidates
        ->filter(c | isCandidateCompatible($c, $argTypes, $argMuls, $context))
        ->map(c | buildResolutionResult($c, $argTypes, $argMuls, $context));
}

// ============================================================================
// Error suggestions
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::functionSignature(f:PackageableFunction<Any>[1], context:CompilerContext[1]):String[1]
{
    // Used by buildFunctionSuggestions to render "did you mean" hints.
    // Stay defensive: a candidate's pass 2 may have errored upstream (leaving
    // its FunctionType partially populated — e.g. parameter genericType empty
    // because its own dependency types weren't resolvable), and we don't want
    // suggestion-rendering to crash the surrounding compile error report.
    // Substitute `?` for any field that's unexpectedly empty so the user
    // still gets a useful hint and the real errors flow through.
    let ft = $f->getFunctionType($context);
    let params = $ft.parameters->cast(@VariableExpression);
    let paramDesc = $params->map(p |
        let typeStr = if($p.genericType->isEmpty(), | '?', | printGenericType($p.genericType->toOne()));
        let mulStr = if($p.multiplicity->isEmpty(), | '', | printMultiplicity($p.multiplicity->toOne()));
        $p.name + ': ' + $typeStr + $mulStr;
    )->joinStrings(', ');
    let retTypeStr = if($ft.returnType->isEmpty(), | '?', | printGenericType($ft.returnType->toOne()));
    let retMulStr = if($ft.returnMultiplicity->isEmpty(), | '', | printMultiplicity($ft.returnMultiplicity->toOne()));
    let retDesc = $retTypeStr + $retMulStr;
    // Build path with short name: extract package from path, short name from mangled name
    let fullPath = $f->elementToPath();
    let mangledName = $f.name->toOne();
    // Short name is the part before the first '_' (type suffix)
    let shortName = if($mangledName->contains('_'), | $mangledName->substring(0, $mangledName->indexOf('_')), | $mangledName);
    let pkgPath = if($fullPath->contains('::'), | $fullPath->split('::')->init()->joinStrings('::') + '::', | '');
    $pkgPath + $shortName + '(' + $paramDesc + '): ' + $retDesc;
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::buildFunctionSuggestions(context:CompilerContext[1], functionName:String[1], paramCount:Integer[1]):String[1]
{
    // Look for functions with same name but different arity or visibility
    let allSameArity = findAllFunctionsByNameAndArityUnfiltered($context, $functionName, $paramCount);
    let inScope = $allSameArity->filter(f | $context->isElementVisible($f->elementToPath()));
    let outOfScope = $allSameArity->filter(f | !$context->isElementVisible($f->elementToPath()));

    // Functions with different arity (check a few common arities)
    let diffArity = range(5)->filter(a | $a != $paramCount)->map(a | findAllFunctionsByNameAndArityUnfiltered($context, $functionName, $a))->filter(f | $context->isElementVisible($f->elementToPath()));

    let parts = []
        ->concatenate(if($inScope->isNotEmpty(), | '. Possible matches with ' + $paramCount->toString() + ' parameter(s) in scope:\n    ' + $inScope->map(f | functionSignature($f, $context))->joinStrings('\n    '), | []))
        ->concatenate(if($outOfScope->isNotEmpty(), | '. Possible matches with ' + $paramCount->toString() + ' parameter(s) not in scope:\n    ' + $outOfScope->map(f | functionSignature($f, $context))->joinStrings('\n    '), | []))
        ->concatenate(if($diffArity->isNotEmpty(), | '. Possible matches with different number of parameters:\n    ' + $diffArity->map(f | functionSignature($f, $context))->joinStrings('\n    '), | []));
    $parts->joinStrings('');
}

// Normalizes a FunctionType to a canonical string for comparison.
// TypeParameter names are replaced with positional names (P0, P1, ...) so that
// functions with identical structure but different TypeParameter objects compare equal.
// This avoids false negatives from PDB-loaded vs locally-compiled TypeParameter name differences.
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::normalizeFunctionTypeForComparison(ft:FunctionType[1]):String[1]
{
    // Collect all type parameter names and assign canonical names
    let allTpNames = collectFunctionTypeReferencedTypeParameterNames($ft)->sort();
    let allMpNames = collectFunctionTypeReferencedMultiplicityParameterNames($ft)->sort();
    // Build the canonical FunctionType string using printFunctionType(false) then replace type param names
    let raw = printFunctionType($ft, false);
    // Replace each type parameter name with a canonical version
    let withTp = $allTpNames->fold({n, acc |
        let idx = $allTpNames->indexOf($n);
        $acc->replace($n, '_TP' + $idx->toString());
    }, $raw);
    let withMp = $allMpNames->fold({n, acc |
        let idx = $allMpNames->indexOf($n);
        $acc->replace($n, '_MP' + $idx->toString());
    }, $withTp);
    $withMp;
}

// Matches Java FunctionIndexEntry.compareFunctionTypes + mostSpecificFirst comparator
// Returns: -1 if f1 more specific, 1 if f2 more specific, 0 if equally specific
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::compareFunctionTypeSpecificity(f1:FunctionType[1], f2:FunctionType[1], context:CompilerContext[1]):Integer[1]
{
    let params1 = $f1.parameters->cast(@VariableExpression);
    let params2 = $f2.parameters->cast(@VariableExpression);
    let count = if($params1->size() < $params2->size(), | $params1->size(), | $params2->size());
    // Compare parameter types pairwise
    let paramCmp = range($count)->fold({i, acc |
        if($acc != 0,
            | $acc,
            | let gt1 = $params1->at($i).genericType->toOne();
              let gt2 = $params2->at($i).genericType->toOne();
              // Extract raw type — null (empty) for non-GenericTypeValue or empty type field
              let t1 = $gt1->match([gtv1 : GenericTypeValue[1] | if($gtv1.type->isNotEmpty(), | $gtv1.type, | []), other : Any[1] | []]);
              let t2 = $gt2->match([gtv2 : GenericTypeValue[1] | if($gtv2.type->isNotEmpty(), | $gtv2.type, | []), other : Any[1] | []]);
              let t1IsTp = $t1->isNotEmpty() && $t1->toOne()->instanceOf(TypeParameter);
              let t2IsTp = $t2->isNotEmpty() && $t2->toOne()->instanceOf(TypeParameter);
              if([pair(| $t1->isNotEmpty() && $t2->isEmpty(), | if(isTopType($t1->toOne()), | 1, | -1)),
                  pair(| $t1->isEmpty() && $t2->isNotEmpty(), | if(isTopType($t2->toOne()), | -1, | 1)),
                  pair(| $t1IsTp && !$t2IsTp, | if(isTopType($t2->toOne()), | -1, | 1)),
                  pair(| !$t1IsTp && $t2IsTp, | if(isTopType($t1->toOne()), | 1, | -1)),
                  pair(| $t1->isNotEmpty() && $t2->isNotEmpty() && !$t1IsTp && !$t2IsTp && !typeEquals($t1->toOne(), $t2->toOne()),
                       | if(subtypeOf($t1->toOne(), $t2->toOne(), $context),
                             | -1,
                             | if(subtypeOf($t2->toOne(), $t1->toOne(), $context), | 1, | 0)
                         );)],
                 | 0
              );
        );
    }, 0);
    if($paramCmp != 0,
        | $paramCmp,
        | // Tiebreaker: fewer type parameters = more constrained = more specific
          let tp1 = collectFunctionTypeReferencedTypeParameterNames($f1)->size();
          let tp2 = collectFunctionTypeReferencedTypeParameterNames($f2)->size();
          if($tp1 != $tp2,
              | if($tp1 < $tp2, | -1, | 1),
              | // Tiebreaker: fewer multiplicity parameters
                let mp1 = collectFunctionTypeReferencedMultiplicityParameterNames($f1)->size();
                let mp2 = collectFunctionTypeReferencedMultiplicityParameterNames($f2)->size();
                if($mp1 != $mp2, | if($mp1 < $mp2, | -1, | 1), | 0);
          );
    );
}

