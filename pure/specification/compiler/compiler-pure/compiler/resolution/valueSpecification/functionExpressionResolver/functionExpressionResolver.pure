import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::relation::*;
import meta::pure::metamodel::function::*;
import meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::dotApplicationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::functionExpression::*;
import meta::pure::compiler::helper::function::*;
import meta::pure::compiler::helper::pointer::*;
import meta::pure::metamodel::pointer::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::class::*;
