import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::relation::*;
import meta::pure::metamodel::function::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::dotApplicationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::functionExpression::*;
import meta::pure::compiler::helper::function::*;
import meta::pure::compiler::helper::pointer::*;
import meta::pure::metamodel::pointer::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::class::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::function::property::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::resolveFunctionExpression(fi:FunctionExpression[1], scope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    debug($context, | 'resolveFunctionExpression: ' + $fi.functionName->toOne() + ' (' + $fi->type()->toOne()->elementToPath() + ')');
    let deepCtx = $context->debugSpaceInc();
    let checkpoint = $context.errors->size();
    let result = match($fi, [
        dot:DotApplication[1] |
            if($dot.parametersValues->isNotEmpty(),
                | resolveDotApplication($dot, $scope, $deepCtx),
                | resolveFunctionApplication($dot->cast(@FunctionInvocation), $scope, $deepCtx)
            );,
        inv:FunctionApplication[1] |
            resolveFunctionApplication($inv, $scope, $deepCtx)
    ]);
    // Finalize all FunctionExpressions (mirrors Java FunctionExpressionResolver.finalizeFunctionExpression)
    if($result.value->isNotEmpty(),
        | match($result.value->toOne(), [
              fe:FunctionExpression[1] | meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::finalizeFunctionExpression($fe, $checkpoint, $result.context),
              a:Any[1] | $result
          ]),
        | $result
    );
}

// Mirrors Java FunctionExpressionResolver.finalizeFunctionExpression (lines 87-124)
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::finalizeFunctionExpression(fi:FunctionExpression[1], checkpoint:Integer[1], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    if($fi.func->isNotEmpty(),
        | // func resolved — compute return type from FunctionType + bindings.
          // Pointer values MUST be dereferenced through the registry (throws on
          // miss — a missing-target is a graph bug). Direct Function values are
          // already live; use them in place. The previous "registry lookup with
          // fallback" pattern was a defensive workaround for stale references
          // across compile passes — pointers are the proper mechanism for that
          // and remove the need for a fallback.
          let resolvedFunc = $fi.func->toOne()->match([
              ptr : TempCompilerPointer[1] | $ptr->dereferencePointer($context)->cast(@Function<Any>),
              f : Function<Any>[1] | $f
          ]);
          let ft = $resolvedFunc->getFunctionType($context);
          let baseBindings = extractResolvedParametersBinding($fi);
          // For class properties, enrich bindings with class type parameter bindings
          // from the receiver's generic type so that T resolves to the concrete type argument.
          // For non-class properties (e.g., Column on RelationType), keep DotApplicationResolver's type.
          let isProperty = $resolvedFunc->instanceOf(AbstractProperty) || $resolvedFunc->instanceOf(Column);
          let classBindingsAvailable = $isProperty
                              && $fi.parametersValues->isNotEmpty()
                              && $fi.parametersValues->at(0).genericType->isNotEmpty()
                              && !$fi.parametersValues->at(0).genericType->toOne()->instanceOf(CompilerNotSetGenericType)
                              && $fi.parametersValues->at(0).genericType->toOne()->genericTypeRawType()->isNotEmpty()
                              && $fi.parametersValues->at(0).genericType->toOne()->genericTypeRawType()->toOne()->instanceOf(Class);
          let bindings = if($classBindingsAvailable,
              | let receiverGT = $fi.parametersValues->at(0).genericType->toOne();
                buildBindingsFromGenericType($receiverGT->genericTypeRawType()->toOne()->cast(@Class<Any>), $receiverGT);,
              | $baseBindings
          );
          // For non-class properties where DotApplicationResolver already set the type, preserve it
          let alreadyResolved = $isProperty && !$classBindingsAvailable
                                && $fi.genericType->isNotEmpty() && !$fi.genericType->toOne()->instanceOf(CompilerNotSetGenericType);
          let returnGT = if($alreadyResolved,
              | asInferredGenericType($fi.genericType->toOne()),
              | asInferredGenericType(makeAsConcreteAsPossible($ft.returnType->toOne(), $bindings, $context))
          );
          let returnMul = if($alreadyResolved,
              | asInferredMultiplicity($fi.multiplicity->toOne()),
              | asInferredMultiplicity(makeAsConcreteAsPossible($ft.returnMultiplicity->toOne(), $bindings))
          );
          debug($context, | 'finalize: ' + $fi.functionName->toOne()
              + ' gt=' + printGenericType($returnGT)
              + ' mul=' + printMultiplicity($returnMul));
          let updated = ^$fi(genericType = $returnGT, multiplicity = $returnMul);

          // Validate required properties for new expressions
          let fnName = $fi.functionName->toOne();
          let ctx1 = if([pair(| $context.errors->size() > $checkpoint, | $context),
                         pair(| ($fnName == 'new' || $fnName->startsWith('new_')) && $fi->instanceOf(FunctionApplication), | validateNewFromFI($fi->cast(@FunctionApplication), $context)),
                         pair(| ($fnName == 'copy' || $fnName->startsWith('copy_')) && $fi->instanceOf(FunctionApplication), | validateCopyFromFI($fi->cast(@FunctionApplication), $context))],
                        | $context
                     );
          ^CompilerResult<ValueSpecification>(value = $updated, context = $ctx1);,
        | // func not resolved — set genericType AND multiplicity to NotSet markers,
          // mirroring Java FunctionExpressionResolver lines 161-163 which sets both
          // (`new CompilerNotSetGenericTypeImpl()` and `new CompilerNotSetMultiplicityImpl()`).
          // Pure was leaving the multiplicity at whatever the receiver/expected slot
          // started with — typically PureOne — which then propagated up: when this
          // expression appears as the body of a match-arm lambda, the lambda's
          // classifierGenericType becomes `LambdaFunction<{...->NotSet[1]}>` instead of
          // `LambdaFunction<{...->NotSet[*]}>`. The collection's common-type then
          // narrows to `[1]` instead of widening to `[*]`, and the outer function's
          // return-multiplicity validation no longer fires (because `m` binds to PureOne
          // rather than ZeroMany). Setting NotSet here keeps the Java-equivalent
          // "Return multiplicity error: expected [1], got [*]" surfacing for
          // functions like `isAssignment` whose match arms include unresolved
          // `$inf.op->in(...)` calls.
          let updated = ^$fi(genericType = ^CompilerNotSetGenericType(), multiplicity = ^CompilerNotSetMultiplicity());
          let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $context);
          let ctx1 = if($context.errors->size() == $checkpoint,
              | ^$context(errors += 'Can\'t resolve the function \'' + $fi.functionName->toOne() + '\'' + $siCtx),
              | $context
          );
          ^CompilerResult<ValueSpecification>(value = $updated, context = $ctx1);
    );
}
