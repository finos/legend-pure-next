// The seam a language extension compiles through.
//
// Each of the three passes dispatches on the element's type and ends in a catch-all arm that
// ignores anything it does not recognise — which is why a `###Diagram` section could be
// parsed but never became part of the graph. An extension fills that arm: it claims the
// elements it understands and compiles them with the same context every other element uses.
//
// THE DEPENDENCY RUNS ONE WAY. compiler-pure knows this shape and nothing else; it never
// references an extension module. Extensions are handed to `compile` by the host and travel
// on the CompilerContext, so adding a language needs no change here.
//
// An extension sees the passes for the same reason the built-in types do: pass 1 may only
// create a skeleton, because the elements it refers to might not exist yet; pass 2 fills
// structure; pass 3 resolves expressions. An extension that needs none of this can implement
// pass 1 alone.
//
// Below the element level, an extension can also compile expression islands (`#…#`): see IslandHandler.

import platform::pure::compiler::*;
import platform::pure::compiler::extension::*;

Class platform::pure::compiler::extension::CompilerExtension
{
   // For diagnostics and for telling two extensions apart in an error.
   name : String[1];

   // Whether this extension compiles that parsed element. The first extension to claim an
   // element gets it; the rest are not asked.
   handles : platform::pure::metamodel::function::Function<{platform::pure::protocol::grammar::PackageableElement[1] -> Boolean[1]}>[1];

   // Pass 1 — the element's skeleton, registered in the context's elementMap. Left empty,
   // the element contributes nothing and the following passes never see it.
   pass1 : platform::pure::metamodel::function::Function<{platform::pure::protocol::grammar::PackageableElement[1], CompilerContext[1] -> CompilerContext[1]}>[0..1];

   // Pass 2 — structure, appending the compiled element to the accumulator.
   pass2 : platform::pure::metamodel::function::Function<{platform::pure::protocol::grammar::PackageableElement[1], CompilerListResult<platform::pure::metamodel::PackageableElement>[1] -> CompilerListResult<platform::pure::metamodel::PackageableElement>[1]}>[0..1];

   // Pass 3 — resolution, over the COMPILED element rather than the parsed one.
   pass3 : platform::pure::metamodel::function::Function<{platform::pure::metamodel::PackageableElement[1], CompilerContext[1] -> CompilerContext[1]}>[0..1];

   // Whether this extension owns a compiled element, for pass 3. Left empty, pass 3 is not
   // offered to it.
   owns : platform::pure::metamodel::function::Function<{platform::pure::metamodel::PackageableElement[1] -> Boolean[1]}>[0..1];

   // How this extension's compiled elements are written to a PDB. Left empty, the extension has
   // nothing to persist — and an element of its that reaches the archive writer is an error.
   pdb : platform::pure::compiler::extension::PdbSerialization[0..1];

   // The expression islands (`#…#`) this extension compiles — see IslandHandler.
   islands : IslandHandler[*];
}

// How an extension's COMPILED elements are written to a PDB. Generated, never hand-written:
// pdb/writer/generator.pure emits `<ns>::serialization()` from the extension's metamodel and the
// schema fragment pdb/fbsgen generated for it. The archive writer asks each extension in the order
// given — m3's own is pureExtension() —; an element nobody claims fails the write instead of being left out.
Class platform::pure::compiler::extension::PdbSerialization
{
   // The entry's type name (`elements/<path>.<TypeName>`), or empty for an element this extension
   // does not write.
   elementTypeName  : platform::pure::metamodel::function::Function<{Any[1]->String[0..1]}>[1];
   // The entry's bytes: a finished FlatBuffer whose root is the element's <TypeName>Def table.
   writeElementBlob : platform::pure::metamodel::function::Function<{Any[1]->Binary[1]}>[1];
}

// An expression island inside Pure code: `#ECHO{hello}#`, `#TDS{…}#`, `#>{a::DB.t}#`. The parser keeps
// the text between the two `#`s; the compiler offers it to EVERY handler of every extension, and each
// decides — usually from its first characters — whether it takes the job. Exactly one must: none and
// several are both errors at the island.
//
// A handler parses its own text (string functions, or `parseAntlr` with its own grammar) and compiles it to
// a value specification: m3's own (an atomic value, a function invocation), or — the usual case — an
// instance of a class of its extension's metamodel extending ValueSpecification (a TDS literal, a store
// accessor). Such a value is the extension's to handle: the handler sets its genericType and multiplicity
// (what it evaluates to — an instance of its class), records the elements it points to (recordReference;
// m3 never walks into it), and answers for it after pass 2 through `owns`, `resolve`, `print` and
// `printGraph`. Its PDB form is generated from the extension's metamodel (pdb/writer/generator), and every
// backend evaluates it to the instance itself.
Class platform::pure::compiler::extension::IslandHandler
{
   // For diagnostics: errors name the handlers that were asked.
   name : String[1];

   // Whether this handler compiles the island whose text (between the `#`s) is given.
   claims : platform::pure::metamodel::function::Function<{String[1] -> Boolean[1]}>[1];

   // The island compiled in the enclosing expression's context and variable scope, as any other
   // value specification is (see compileValueSpecification).
   compile : platform::pure::metamodel::function::Function<{platform::pure::protocol::grammar::valuespecification::Island[1], CompilerContext[1], platform::pure::metamodel::valuespecification::VariableExpression[*] -> platform::pure::compiler::structural::valueSpecificationCompiler::ValueCompileResult[1]}>[1];

   // Whether a compiled value is one this handler produced — how everything after pass 2 finds the handler.
   owns : platform::pure::metamodel::function::Function<{platform::pure::metamodel::valuespecification::ValueSpecification[1] -> Boolean[1]}>[0..1];

   // Pass 3: resolution that must wait for the whole graph. Left empty, the value is kept as it is.
   resolve : platform::pure::metamodel::function::Function<{platform::pure::metamodel::valuespecification::ValueSpecification[1], CompilerContext[1] -> platform::pure::compiler::CompilerResult<platform::pure::metamodel::valuespecification::ValueSpecification>[1]}>[0..1];

   // The value as source — the island it came from — so compiled code prints back as written.
   print : platform::pure::metamodel::function::Function<{platform::pure::metamodel::valuespecification::ValueSpecification[1] -> String[1]}>[0..1];

   // The value's line in the specification's ###CompiledGraph format, at `indent`.
   printGraph : platform::pure::metamodel::function::Function<{platform::pure::metamodel::valuespecification::ValueSpecification[1], String[1], CompilerContext[1] -> String[1]}>[0..1];
}

// The handler of any extension that owns a compiled value, if one does.
function platform::pure::compiler::extension::islandHandlerOwning(ctx: CompilerContext[1], v: platform::pure::metamodel::valuespecification::ValueSpecification[1]): IslandHandler[0..1]
{
   $ctx.extensions.islands->filter(h | $h.owns->isNotEmpty() && $h.owns->toOne()->eval($v))->head();
}

// An island, compiled by the one handler that claims it. Unclaimed, or claimed by several, it compiles
// to nothing and leaves an error at the island.
function platform::pure::compiler::extension::compileIsland(
   island: platform::pure::protocol::grammar::valuespecification::Island[1],
   ctx: CompilerContext[1],
   scope: platform::pure::metamodel::valuespecification::VariableExpression[*]): platform::pure::compiler::structural::valueSpecificationCompiler::ValueCompileResult[1]
{
   let handlers = $ctx.extensions.islands;
   let claiming = $handlers->filter(h | $h.claims->eval($island.text));
   let shown = '\'#' + $island.text + '#\'';
   if([pair(| $claiming->size() == 1,
            | $claiming->toOne().compile->eval($island, $ctx, $scope)),
       pair(| $claiming->size() > 1,
            | islandError('The island ' + $shown + ' is claimed by several handlers: ' + $claiming.name->joinStrings(', '), $island, $ctx)),
       pair(| $handlers->isEmpty(),
            | islandError('No handler claims the island ' + $shown + ' (no island handlers)', $island, $ctx))],
      | islandError('No handler claims the island ' + $shown + ' (handlers: ' + $handlers.name->joinStrings(', ') + ')', $island, $ctx));
}

// Nothing in place of the island, and `message` at its location.
function platform::pure::compiler::extension::islandError(
   message: String[1],
   island: platform::pure::protocol::grammar::valuespecification::Island[1],
   ctx: CompilerContext[1]): platform::pure::compiler::structural::valueSpecificationCompiler::ValueCompileResult[1]
{
   islandErrorAt($message, $island.p_sourceInformation, $ctx);
}

// How a handler reports an error: nothing in place of the island, and `message` at `at` — usually a range
// INSIDE the island, from islandSourceInformation. Errors are worded like the compiler's own (a sentence,
// then ` (at <sourceId>:<line>c<col>-<line>c<col>)`), and name no enclosing element.
function platform::pure::compiler::extension::islandErrorAt(
   message: String[1],
   at: platform::pure::protocol::grammar::SourceInformation[0..1],
   ctx: CompilerContext[1]): platform::pure::compiler::structural::valueSpecificationCompiler::ValueCompileResult[1]
{
   let compiled = platform::pure::compiler::structural::sourceInformationCompiler::compileSourceInformation($at, $ctx);
   ^platform::pure::compiler::structural::valueSpecificationCompiler::ValueCompileResult(
      values        = [],
      openVariables = [],
      context       = ^$ctx(errors += $message + platform::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo($compiled, $ctx)));
}

// Where a range of the island's TEXT is in the file. A handler counts in its own text, 1-based: line 1 is
// the text's first line, and its column 1 is the character right after the opening `#`. Line `n` of the
// text is the island's line + n - 1; on the first line, columns are offset by the island's start
// column (the `#`), on later lines they are the file's.
function platform::pure::compiler::extension::islandSourceInformation(
   island: platform::pure::protocol::grammar::valuespecification::Island[1],
   line: Integer[1], column: Integer[1], endLine: Integer[1], endColumn: Integer[1]): platform::pure::protocol::grammar::SourceInformation[0..1]
{
   $island.p_sourceInformation->map(at |
      ^$at(startLine   = $at.startLine + $line - 1,
           startColumn = islandColumn($at, $line, $column),
           endLine     = $at.startLine + $endLine - 1,
           endColumn   = islandColumn($at, $endLine, $endColumn)));
}

function platform::pure::compiler::extension::islandColumn(
   at: platform::pure::protocol::grammar::SourceInformation[1], line: Integer[1], column: Integer[1]): Integer[1]
{
   if($line == 1, | $at.startColumn + $column, | $column);
}

// The extension that claims `element`, if any.
function platform::pure::compiler::extension::extensionFor(
   extensions: CompilerExtension[*], element: platform::pure::protocol::grammar::PackageableElement[1]): CompilerExtension[0..1]
{
   $extensions->filter(x | $x.handles->eval($element))->head();
}

// Pass 1 for an element none of the built-in arms matched. Unclaimed, the context is handed
// back untouched — exactly what the catch-all did before extensions existed.
function platform::pure::compiler::extension::runExtensionPass1(
   extensions: CompilerExtension[*],
   element: platform::pure::protocol::grammar::PackageableElement[1],
   ctx: CompilerContext[1]): CompilerContext[1]
{
   let owner = extensionFor($extensions, $element);
   if ($owner->isEmpty() || $owner->toOne().pass1->isEmpty(),
       | $ctx,
       | $owner->toOne().pass1->toOne()->eval($element, $ctx));
}

// Pass 2 for an unmatched element.
function platform::pure::compiler::extension::runExtensionPass2(
   extensions: CompilerExtension[*],
   element: platform::pure::protocol::grammar::PackageableElement[1],
   acc: CompilerListResult<platform::pure::metamodel::PackageableElement>[1]): CompilerListResult<platform::pure::metamodel::PackageableElement>[1]
{
   let owner = extensionFor($extensions, $element);
   if ($owner->isEmpty() || $owner->toOne().pass2->isEmpty(),
       | $acc,
       | $owner->toOne().pass2->toOne()->eval($element, $acc));
}

// Pass 3 for a compiled element none of the built-in arms matched. Claimed by `owns`, which
// sees metamodel elements rather than parsed ones.
function platform::pure::compiler::extension::runExtensionPass3(
   extensions: CompilerExtension[*],
   element: platform::pure::metamodel::PackageableElement[1],
   ctx: CompilerContext[1]): CompilerContext[1]
{
   let owner = $extensions->filter(x | $x.owns->isNotEmpty() && $x.owns->toOne()->eval($element))->head();
   if ($owner->isEmpty() || $owner->toOne().pass3->isEmpty(),
       | $ctx,
       | $owner->toOne().pass3->toOne()->eval($element, $ctx));
}
