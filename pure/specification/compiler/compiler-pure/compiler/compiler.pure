import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::*;
import meta::pure::compiler::elements::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::metamodel::relationship::*;
import meta::pure::metamodel::extension::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::functions::lang::*;
import meta::pure::functions::date::*;
import meta::pure::ui::progress::*;

// Per-file work bundle threaded across the three compile passes. Mirrors Java's
// LocalModule per-file structure: parse once, then run pass 1 over all files,
// pass 2 over all files, pass 3 over all files — so forward references between
// files (function in file A calling function in file B compiled later) resolve
// the same way Java does.
Class meta::pure::compiler::FileWorkItem
{
    sourceId : String[1];
    imports : String[*];
    grammarElements : meta::pure::protocol::grammar::PackageableElement[*];
    // Populated after pass 2 — the compiled (non-resolved) elements for this file,
    // in source order. Pass 3 iterates this list per file so each element gets
    // its own file's sourceId + imports applied to the context before resolution.
    compiledElements : meta::pure::metamodel::PackageableElement[*];
}

// Default imports applied to every file (mirrors Java's default-import set).
function meta::pure::compiler::defaultFileImports():String[*]
{
    [
        'meta::pure::metamodel::type::primitives',
        'meta::pure::metamodel',
        'meta::pure::metamodel::function::property',
        'meta::pure::metamodel::type',
        'meta::pure::metamodel::type::generics',
        'meta::pure::metamodel::function',
        'meta::pure::metamodel::multiplicity',
        'meta::pure::metamodel::relation',
        'meta::pure::metamodel::valuespecification',
        'meta::pure::functions::math',
        'meta::pure::functions::lang',
        'meta::pure::functions::string',
        'meta::pure::functions::collection',
        'meta::pure::functions::boolean',
        'meta::pure::functions::relation',
        'meta::pure::functions::multiplicity',
        'meta::pure::functions::asserts',
        'meta::pure::functions::meta',
        'meta::pure::functions::io',
        'meta::pure::profiles'
    ]
}

// Compute the full imports list for a parsed file: defaults + file-declared imports
// (with trailing '::*' stripped to match the package-path-only form used by
// {@link isElementVisible}).
function meta::pure::compiler::computeAllImports(file:meta::pure::protocol::PureFile[1]):String[*]
{
    let fileImports = $file.sections.imports->map(i | if($i->endsWith('::*'), | $i->substring(0, $i->length() - 3), | $i));
    defaultFileImports()->concatenate($fileImports)->removeDuplicates();
}

// Walk every `.pure` under `dir`, read and parse each, return the list of
// parsed PureFiles. Companion to {@link compile} for self-host CLI
// orchestrators (`pure-bootstrap compile-via-pure`, `pure-truffle compile`):
// Java side calls `parseDir($dir)` then `compile($files, $debug)`.
//
// Parses silently (no progress display) — typically completes in under a
// second even for the full compiler-pure tree, so the live readout would
// be more flicker than information. The compile phase that follows owns
// the progress bar.
function meta::pure::compiler::parseDir(dir:String[1]):meta::pure::protocol::PureFile[*]
{
    let files = directoryTree($dir)->filter(f | $f->endsWith('.pure'));
    let prefixLen = $dir->length() + 1;
    $files->map(f |
        let name = substring($f, $prefixLen, $f->length());
        meta::pure::functions::meta::parse($name, readFile($f));
    );
}

// Collapse per-pass duplicates into one row per element. Pass 2 and pass 3
// each append an ElementStatistics for the same elementPath; this rolls them
// up: totalMillis, inferenceRollbacks, candidateEvaluations are summed,
// elementType is taken from the first occurrence (stable across passes).
function meta::pure::compiler::aggregateElementStatistics(stats:ElementStatistics[*]):ElementStatistics[*]
{
    $stats->groupBy(s | $s.elementPath)
        ->keyValues()
        ->map({pair |
            let group = $pair.second.values;
            ^ElementStatistics(
                elementPath = $pair.first,
                elementType = $group->at(0).elementType,
                totalMillis = $group->fold({s, acc | $acc + $s.totalMillis}, 0),
                inferenceRollbacks = $group->fold({s, acc | $acc + $s.inferenceRollbacks}, 0),
                candidateEvaluations = $group->fold({s, acc | $acc + $s.candidateEvaluations}, 0)
            );
        });
}

// Format CompilationStatistics as a human-readable summary block — mirrors
// the layout produced by Java's CompilationStatistics.summary() so a side-by-side
// comparison of Java- vs Pure-built compiler output reads identically.
function meta::pure::compiler::printCompilationStatisticsSummary(s:CompilationStatistics[1]):String[1]
{
    let header = '  Compilation Statistics\n';
    let body = [
        '    Total time:       ' + padLeft($s.totalMillis->toString() + ' ms', 11),
        '      Parsing:        ' + padLeft($s.parsingMillis->toString() + ' ms', 11),
        '      First pass:     ' + padLeft($s.firstPassMillis->toString() + ' ms', 11),
        '      Second pass:    ' + padLeft($s.secondPassMillis->toString() + ' ms', 11),
        '      Third pass:     ' + padLeft($s.thirdPassMillis->toString() + ' ms', 11),
        '    Elements:         ' + padLeft($s.elementCount->toString(), 8),
        '    Source files:     ' + padLeft($s.sourceFileCount->toString(), 8),
        '    Inference rollbacks:     ' + $s.inferenceRollbackCount->toString(),
        '    Candidate evaluations:   ' + $s.candidateEvaluationCount->toString()
    ]->joinStrings('\n');
    let topHeader = if($s.elementStatistics->isEmpty(), | '', | '\n    Top 10 Elements by Compilation Time');
    let sortedElements = $s.elementStatistics->sort({a, b | $b.totalMillis - $a.totalMillis});
    let topN = if($sortedElements->size() > 10, | $sortedElements->take(10), | $sortedElements);
    let topRows = $topN->map(e |
        // padRight elementType to 20 to fit 'UserDefinedFunction' (19 chars)
        // without overflow; shorter labels (Class, Profile…) keep
        // rollbacks=/candidates= columns aligned.
        '      ' + padLeft($e.totalMillis->toString() + ' ms', 9)
            + '  ' + padRight($e.elementType, 20)
            + '  rollbacks=' + padRight($e.inferenceRollbacks->toString(), 6)
            + ' candidates=' + padRight($e.candidateEvaluations->toString(), 6)
            + '  ' + $e.elementPath
    )->joinStrings('\n');
    let siteEntries = $s.rollbackSites->keyValues();
    let siteHeader = if($siteEntries->isEmpty(), | '', | '\n    Rollback sites (count desc)');
    let siteSorted = $siteEntries->sort({a, b | $b.second - $a.second});
    let siteRows = $siteSorted->map(p |
        '      ' + padLeft($p.second->toString(), 8) + '  ' + $p.first
    )->joinStrings('\n');
    $header + $body
        + $topHeader + if($topN->isEmpty(), | '', | '\n' + $topRows)
        + $siteHeader + if($siteEntries->isEmpty(), | '', | '\n' + $siteRows);
}

function meta::pure::compiler::padLeft(s:String[1], width:Integer[1]):String[1]
{
    let pad = $width - $s->length();
    if($pad <= 0, | $s, | repeatString(' ', $pad) + $s);
}

function meta::pure::compiler::padRight(s:String[1], width:Integer[1]):String[1]
{
    let pad = $width - $s->length();
    if($pad <= 0, | $s, | $s + repeatString(' ', $pad));
}

function meta::pure::compiler::repeatString(s:String[1], n:Integer[1]):String[1]
{
    range(0, $n)->fold({i, acc | $acc + $s}, '');
}

function meta::pure::compiler::getOrCreatePackagePath(ctx:CompilerContext[1], packagePath:String[1]):CompilerResult<Package>[1]
{
    let rootPkg = ^Package(name = 'Root');
    let parts = if($packagePath == '', | []->cast(@String), | $packagePath->split('::'));
    let walked = $parts->fold({part, acc |
        let curCtx = $acc.first;
        let parentPkg = $acc.second.first;
        let parentPath = $acc.second.second;
        let curPath = if($parentPath == '', | $part, | $parentPath + '::' + $part);
        let existing = $curCtx.elementMap->get($curPath);
        if($existing->isNotEmpty(),
            | pair($curCtx, pair($existing->toOne()->cast(@Package), $curPath)),
            | let newPkg = ^Package(name = $part, package = $parentPkg);
              let newMap = if($parentPath == '',
                  | $curCtx.elementMap->put($curPath, $newPkg),
                  | let updatedParent = ^$parentPkg(children = $parentPkg.children->concatenate($newPkg));
                    $curCtx.elementMap->put($parentPath, $updatedParent)->put($curPath, $newPkg);
              );
              pair(^$curCtx(elementMap = $newMap), pair($newPkg, $curPath));
        );
    }, pair($ctx, pair($rootPkg, '')));
    ^CompilerResult<Package>(value = $walked.second.first, context = $walked.first);
}

function meta::pure::compiler::putElementUnderPackage(ctx:CompilerContext[1], elementPath:String[1], packagePath:String[1], element:PackageableElement[1]):CompilerContext[1]
{
    let pkgRes = getOrCreatePackagePath($ctx, $packagePath);
    let parentPkg = $pkgRes.value->toOne();
    let ctxWithPkg = $pkgRes.context;
    if($packagePath == '',
        | ^$ctxWithPkg(elementMap = $ctxWithPkg.elementMap->put($elementPath, $element)),
        | let updatedParent = ^$parentPkg(children = $parentPkg.children->concatenate($element));
          ^$ctxWithPkg(elementMap = $ctxWithPkg.elementMap->put($packagePath, $updatedParent)->put($elementPath, $element));
    );
}

function meta::pure::compiler::newCompilerContext(debugMode:Boolean[1]):CompilerContext[1]
{
    ^CompilerContext(
        debugState = ^DebugState(debug = $debugMode, space = ''),
        imports = [],
        elementMap = newMap([]->cast(@Pair<String, PackageableElement>)),
        localFunctionIndex = newMap([]->cast(@Pair<String, List<PackageableFunction<Any>>>)),
        linearizationCache = newMap([]->cast(@Pair<String, List<String>>)),
        lambdaResolutionCache = newMap([]->cast(@Pair<String, CachedLambdaOutcome>)),
        lambdaFailureCache = newMap([]->cast(@Pair<String, Boolean>)),
        inferenceRollbacks = 0,
        candidateEvaluations = 0,
        rollbackSites = newMap([]->cast(@Pair<String, Integer>)),
        referencedBy = newMap([]->cast(@Pair<String, List<String>>))
    );
}

// ============================================================================
// Per-element pass dispatch — used by compile() to run pass 1 across all
// files, then pass 2 across all files, then pass 3 across all files (matching
// Java's LocalModule orchestration).
// ============================================================================

function meta::pure::compiler::runCompilePass1(e:meta::pure::protocol::grammar::PackageableElement[1], ctx:CompilerContext[1]):CompilerContext[1]
{
    $e->match([
        c:meta::pure::protocol::grammar::type::Class[1] |
            let packagePath = if($c.package->isEmpty(), | '', | $c.package->toOne().value);
            let className = if($packagePath == '', | $c.name, | $packagePath + '::' + $c.name);
            let pkgRes = getOrCreatePackagePath($ctx, $packagePath);
            let typeParams = $c.typeParameters->map(tp | buildTypeParameter($tp.name, false));
            let mulParams = $c.multiplicityParameters->map(mp | buildUserDefinedMultiplicityParameter($mp.name)->cast(@MultiplicityParameter));
            let emptyClass = meta::pure::functions::meta::creation::newClass($typeParams, $mulParams);
            let skeleton = ^$emptyClass(
                name = $c.name,
                package = $pkgRes.value->toOne(),
                typeParameters = $typeParams,
                multiplicityParameters = $mulParams,
                sourceInformation = compileSourceInformation($c.p_sourceInformation, $ctx)
            );
            putElementUnderPackage($pkgRes.context, $className, $packagePath, $skeleton);,
        a:meta::pure::protocol::grammar::relationship::Association[1] |
            let packagePath = $a.package->toOne().value;
            let aName = $packagePath + '::' + $a.name;
            let pkgRes = getOrCreatePackagePath($ctx, $packagePath);
            let assocSkeleton = ^Association(
                name = $a.name,
                package = $pkgRes.value->toOne(),
                sourceInformation = compileSourceInformation($a.p_sourceInformation, $ctx)
            );
            putElementUnderPackage($pkgRes.context, $aName, $packagePath, $assocSkeleton);,
        en:meta::pure::protocol::grammar::type::Enumeration[1] |
            let packagePath = $en.package->toOne().value;
            let enName = $packagePath + '::' + $en.name;
            let pkgRes = getOrCreatePackagePath($ctx, $packagePath);
            let valueNames = $en.properties->map(p | $p.name);
            let enumSkeleton = meta::pure::functions::meta::creation::newEnumeration($en.name, $pkgRes.value->toOne(), $valueNames);
            putElementUnderPackage($pkgRes.context, $enName, $packagePath, $enumSkeleton);,
        pr:meta::pure::protocol::grammar::extension::Profile[1] |
            $pr->compileProfilePass1($ctx);,
        fn:meta::pure::protocol::grammar::function::NativeFunction[1] |
            $fn->compileNativeFunctionPass1($ctx);,
        fd:meta::pure::protocol::grammar::function::UserDefinedFunction[1] |
            $fd->compileUserDefinedFunctionPass1($ctx);,
        p:meta::pure::protocol::grammar::type::PrimitiveType[1] |
            let packagePath = $p.package->toOne().value;
            let pName = $packagePath + '::' + $p.name;
            let pkgRes = getOrCreatePackagePath($ctx, $packagePath);
            let primSkeleton = ^PrimitiveType(
                name = $p.name,
                package = $pkgRes.value->toOne(),
                sourceInformation = compileSourceInformation($p.p_sourceInformation, $ctx)
            );
            putElementUnderPackage($pkgRes.context, $pName, $packagePath, $primSkeleton);,
        a:meta::pure::protocol::grammar::PackageableElement[1] | $ctx
    ]);
}

function meta::pure::compiler::runCompilePass2(e:meta::pure::protocol::grammar::PackageableElement[1], acc:CompilerListResult<meta::pure::metamodel::PackageableElement>[1]):CompilerListResult<meta::pure::metamodel::PackageableElement>[1]
{
    let beforeT = currentTimeMillis();
    let beforeCtx = $acc.context;
    let beforeRb = $beforeCtx.inferenceRollbacks;
    let beforeCa = $beforeCtx.candidateEvaluations;
    let prevSize = $acc.values->size();
    // Establish caller scope for reverse-index recording. Each match arm
    // computes its own (packagePath, name) for elementMap insertion and
    // reuses the path as the caller. Mirrors Java TopLevelCompiler.pass2
    // setCurrentElement / clearCurrentElement.
    let newAcc = $e->match([
        c:meta::pure::protocol::grammar::type::Class[1] |
            let packagePath = if($c.package->isEmpty(), | '', | $c.package->toOne().value);
            let className = if($packagePath == '', | $c.name, | $packagePath + '::' + $c.name);
            let scopedCtx = $acc.context->setCurrentElement($className);
            let r = $c->compileClass($scopedCtx);
            let compiledClass = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
            let ctx = $r.context->clearCurrentElement();
            let newMap = $ctx.elementMap->put($className, $compiledClass);
            let updatedCtx = ^$ctx(elementMap = $newMap);
            ^$acc(values += $compiledClass, context = $updatedCtx);,
        p:meta::pure::protocol::grammar::type::PrimitiveType[1] |
            let primPackagePath = if($p.package->isEmpty(), | '', | $p.package->toOne().value);
            let primName = if($primPackagePath == '', | $p.name, | $primPackagePath + '::' + $p.name);
            let scopedCtx = $acc.context->setCurrentElement($primName);
            let r = $p->compilePrimitive($scopedCtx);
            let compiledPrim = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
            let primRCtx = $r.context->clearCurrentElement();
            let primNewMap = $primRCtx.elementMap->put($primName, $compiledPrim);
            let primCtx = ^$primRCtx(elementMap = $primNewMap);
            ^$acc(values += $compiledPrim, context = $primCtx);,
        assoc:meta::pure::protocol::grammar::relationship::Association[1] |
            let assocPackagePath = if($assoc.package->isEmpty(), | '', | $assoc.package->toOne().value);
            let assocName = if($assocPackagePath == '', | $assoc.name, | $assocPackagePath + '::' + $assoc.name);
            let scopedCtx = $acc.context->setCurrentElement($assocName);
            let r = $assoc->compileAssociation($scopedCtx);
            let compiledAssoc = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
            let assocRCtx = $r.context->clearCurrentElement();
            let assocNewMap = $assocRCtx.elementMap->put($assocName, $compiledAssoc);
            let assocCtx = ^$assocRCtx(elementMap = $assocNewMap);
            ^$acc(values += $compiledAssoc, context = $assocCtx);,
        en:meta::pure::protocol::grammar::type::Enumeration[1] |
            let enumPackagePath = if($en.package->isEmpty(), | '', | $en.package->toOne().value);
            let enumName = if($enumPackagePath == '', | $en.name, | $enumPackagePath + '::' + $en.name);
            let scopedCtx = $acc.context->setCurrentElement($enumName);
            let r = $en->compileEnumeration($scopedCtx);
            let compiledEnum = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
            let enumRCtx = $r.context->clearCurrentElement();
            let enumNewMap = $enumRCtx.elementMap->put($enumName, $compiledEnum);
            let enumCtx = ^$enumRCtx(elementMap = $enumNewMap);
            ^$acc(values += $compiledEnum, context = $enumCtx);,
        fn:meta::pure::protocol::grammar::function::NativeFunction[1] |
            let fnPackagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().value);
            let fnName = if($fnPackagePath == '', | $fn.name, | $fnPackagePath + '::' + $fn.name);
            let scopedCtx = $acc.context->setCurrentElement($fnName);
            let r = $fn->compileNativeFunctionPass2($scopedCtx);
            let compiledFn = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
            let fnRCtx = $r.context->clearCurrentElement();
            let fnNewMap = $fnRCtx.elementMap->put($fnName, $compiledFn);
            let fnCtx = ^$fnRCtx(elementMap = $fnNewMap);
            ^$acc(values += $compiledFn, context = $fnCtx);,
        fd:meta::pure::protocol::grammar::function::UserDefinedFunction[1] |
            let fdPackagePath = if($fd.package->isEmpty(), | '', | $fd.package->toOne().value);
            let fdName = if($fdPackagePath == '', | $fd.name, | $fdPackagePath + '::' + $fd.name);
            let scopedCtx = $acc.context->setCurrentElement($fdName);
            let r = $fd->compileUserDefinedFunctionPass2($scopedCtx);
            let compiledFd = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
            let fdRCtx = $r.context->clearCurrentElement();
            let fdNewMap = $fdRCtx.elementMap->put($fdName, $compiledFd);
            let fdCtx = ^$fdRCtx(elementMap = $fdNewMap);
            ^$acc(values += $compiledFd, context = $fdCtx);,
        pr:meta::pure::protocol::grammar::extension::Profile[1] |
            let packagePath = if($pr.package->isEmpty(), | '', | $pr.package->toOne().value);
            let prName = if($pr.package->isEmpty(), | '', | $packagePath + '::') + $pr.name;
            ^$acc(values += $acc.context.elementMap->get($prName)->toOne()->cast(@meta::pure::metamodel::PackageableElement));,
        a:meta::pure::protocol::grammar::PackageableElement[1] |
            $acc
    ]);
    let elapsed = currentTimeMillis() - $beforeT;
    let postCtx = $newAcc.context;
    if($newAcc.values->size() > $prevSize,
        | let lastEl = $newAcc.values->at($newAcc.values->size() - 1);
          let stat = ^ElementStatistics(
              elementPath = $lastEl->elementToPath(),
              elementType = elementSimpleType($lastEl),
              totalMillis = $elapsed,
              inferenceRollbacks = $postCtx.inferenceRollbacks - $beforeRb,
              candidateEvaluations = $postCtx.candidateEvaluations - $beforeCa
          );
          let updatedCtx = ^$postCtx(elementStatistics = $postCtx.elementStatistics->concatenate($stat));
          ^$newAcc(context = $updatedCtx);,
        | $newAcc
    );
}

function meta::pure::compiler::runCompilePass3(elem:meta::pure::metamodel::PackageableElement[1], ctx:CompilerContext[1]):CompilerContext[1]
{
    let beforeT = currentTimeMillis();
    let beforeRb = $ctx.inferenceRollbacks;
    let beforeCa = $ctx.candidateEvaluations;
    // Establish the caller scope for reverse-index recording. Mirrors Java
    // TopLevelCompiler.pass3 setCurrentElement / clearCurrentElement around
    // each element's resolution — every {@code recordReference} call that
    // fires inside the resolve* chain attributes back to this element.
    let scopedCtx = $ctx->setCurrentElement($elem->elementToPath());
    let newCtx = $elem->match([
        fn:UserDefinedFunction<Any>[1] |
            resolveFunctionDefinition($fn, $scopedCtx);,
        cls:Class<Any>[1] |
            resolveClass($cls, $scopedCtx);,
        assoc:Association[1] |
            resolveAssociation($assoc, $scopedCtx);,
        pt:PrimitiveType[1] |
            resolvePrimitive($pt, $scopedCtx);,
        a:Any[1] | $scopedCtx
    ])->clearCurrentElement();
    let elapsed = currentTimeMillis() - $beforeT;
    let stat = ^ElementStatistics(
        elementPath = $elem->elementToPath(),
        elementType = elementSimpleType($elem),
        totalMillis = $elapsed,
        inferenceRollbacks = $newCtx.inferenceRollbacks - $beforeRb,
        candidateEvaluations = $newCtx.candidateEvaluations - $beforeCa
    );
    ^$newCtx(elementStatistics = $newCtx.elementStatistics->concatenate($stat));
}

function meta::pure::compiler::compile(files:meta::pure::protocol::PureFile[*]):CompilationResult[1]
{
    meta::pure::compiler::compile($files, false);
}

// Default 2-arg form is verbose (CLI-friendly): live 3-line progress bar
// during the three passes, error lines printed before stats, then a stats
// summary. Tests/IDEs that want a clean stdout should call the 4-arg form
// with {@code silent=true}.
function meta::pure::compiler::compile(files:meta::pure::protocol::PureFile[*], debugMode:Boolean[1]):CompilationResult[1]
{
    meta::pure::compiler::compile($files, newCompilerContext($debugMode), $debugMode, false);
}

// Silent variant: same compile, no stdout side-effects. For programmatic
// callers (test harnesses, IDE compile-on-save) that pull structured
// statistics off {@link CompilationResult} rather than parsing stdout.
function meta::pure::compiler::compile(files:meta::pure::protocol::PureFile[*], debugMode:Boolean[1], silent:Boolean[1]):CompilationResult[1]
{
    meta::pure::compiler::compile($files, newCompilerContext($debugMode), $debugMode, $silent);
}

// Three-pass compile across a list of pre-parsed files. Mirrors Java's
// LocalModule.compile orchestration: pass 1 (skeletons), pass 2 (bodies),
// pass 3 (resolution), with the linearization cache + local-function index
// rebuilt between passes. Each file's grammar elements are processed under
// that file's sourceId + imports so forward references between files
// resolve the same way Java does.
//
// {@code silent} controls whether the function writes anything to stdout
// (progress bar, error lines, stats summary). Pass {@code false} for CLI
// orchestrators that want the live readout; pass {@code true} when calling
// programmatically and pulling structured statistics off the result.
function meta::pure::compiler::compile(files:meta::pure::protocol::PureFile[*], inputCtx:CompilerContext[1], debugMode:Boolean[1], silent:Boolean[1]):CompilationResult[1]
{
    let compileStart = currentTimeMillis();
    let total = $files->size();
    let dirLabel = $total->toString() + ' files';

    let workItems = range(0, $total)->map({i |
        let f = $files->at($i);
        ^FileWorkItem(
            // {@code PureFile.sourceId} is declared {@code String[0..1]}; in
            // practice both parser and test-constructed PureFiles always
            // populate it, so {@code toOne()} is safe and lets
            // {@code FileWorkItem.sourceId} stay {@code String[1]}.
            sourceId = $f.sourceId->toOne(),
            imports = computeAllImports($f),
            grammarElements = $f.sections.elements,
            compiledElements = []->cast(@meta::pure::metamodel::PackageableElement)
        );
    });

    let debugState = ^DebugState(debug = $debugMode, space = '');

    // 3-line live status (header / bar / current item) covers all three
    // passes. Header changes per phase so the user sees the bar reset and a
    // new label for pass 1 / 2 / 3 instead of going dark mid-compile.
    if($silent, | true, | startProgress3(); true;);

    // ============================================================================
    // Pass 1 across all files (skeleton building)
    // ============================================================================
    let pass1Start = currentTimeMillis();
    let pass1Ctx = range(0, $total)->fold({i, ctx |
        let fileItem = $workItems->at($i);
        if($silent, | true, | tickProgress3('  Pass 1/3 — Skeletons [1/3]: ' + $dirLabel, $i + 1, $total, $fileItem.sourceId));
        let fileCtx = ^$ctx(debugState = $debugState, sourceId = $fileItem.sourceId, imports = $fileItem.imports);
        $fileItem.grammarElements->fold({e, c | runCompilePass1($e, $c)}, $fileCtx);
    }, $inputCtx);
    let pass1Millis = currentTimeMillis() - $pass1Start;

    // Build linearization cache + local function index between pass 1 and pass 2 so
    // pass 2 body compilation has hits on universe types and pass-1 skeletons.
    let pass2StartCtx = $pass1Ctx->buildLinearizationCache()->buildLocalFunctionIndex();

    // ============================================================================
    // Pass 2 across all files (compile element bodies)
    // ============================================================================
    let pass2Start = currentTimeMillis();
    let pass2Result = range(0, $total)->fold({i, acc |
        let fileItem = $workItems->at($i);
        if($silent, | true, | tickProgress3('  Pass 2/3 — Bodies [2/3]: ' + $dirLabel, $i + 1, $total, $fileItem.sourceId));
        let priorCtx = $acc.context;
        let fileCtx = ^$priorCtx(sourceId = $fileItem.sourceId, imports = $fileItem.imports);
        let perFileResult = $fileItem.grammarElements->fold({e, fAcc | runCompilePass2($e, $fAcc)}, ^CompilerListResult<meta::pure::metamodel::PackageableElement>(context = $fileCtx, values = []->cast(@meta::pure::metamodel::PackageableElement)));
        let updatedFile = ^$fileItem(compiledElements = $perFileResult.values);
        ^CompilerListResult<FileWorkItem>(
            context = $perFileResult.context,
            values = $acc.values->concatenate($updatedFile)
        );
    }, ^CompilerListResult<FileWorkItem>(context = $pass2StartCtx, values = []->cast(@FileWorkItem)));
    let pass2Millis = currentTimeMillis() - $pass2Start;

    // Refresh linearization cache + local function index between pass 2 and
    // pass 3 — pass 2 fills in parameters/returnType on each FunctionDefinition,
    // and {@link buildLocalFunctionIndex} indexes by name from elementMap. Without
    // this rebuild, pass 3's `findAllFunctionsByNameAndArity` lookups still see
    // pass-1 skeletons (empty `parameters` list), so the `parameters.size() == arity`
    // filter rejects every locally-defined overload — every call site of a function
    // defined in the source then errors with "function not found", inflating the
    // total error count by the number of usage sites (e.g. ~300 cascade errors per
    // unresolved local function on the language/java compile).
    let pass3StartCtx = $pass2Result.context->buildLinearizationCache()->buildLocalFunctionIndex();
    let pass2Files = $pass2Result.values;

    // ============================================================================
    // Pass 3 across all files (resolution)
    // ============================================================================
    let pass3Start = currentTimeMillis();
    let pass3RawCtx = range(0, $total)->fold({i, ctx |
        let fileItem = $pass2Files->at($i);
        if($silent, | true, | tickProgress3('  Pass 3/3 — Resolution [3/3]: ' + $dirLabel, $i + 1, $total, $fileItem.sourceId));
        let fileCtx = ^$ctx(sourceId = $fileItem.sourceId, imports = $fileItem.imports);
        $fileItem.compiledElements->fold({elem, c | runCompilePass3($elem, $c)}, $fileCtx);
    }, $pass3StartCtx);
    // Derive function-reference edges from the compiled AST. Replaces the
    // in-flight function-/dot-application resolver recording hooks which were
    // prone to multi-candidate trial pollution (cached lambda outcomes from a
    // failed trial could leak deltas into the index when a later winning
    // trial reused the cache). Walking the final {@code func} slots is
    // structurally exact — recorded edges match what the PDB serialises.
    // Mirrors Java's {@code FunctionRefExtractor}. The walk runs over
    // {@code elementMap}'s values, which is the same source the PDB write
    // path uses, so the recorded edges are aligned with the serialised graph.
    let pass3CtxWithFuncRefs = extractFunctionRefsInto($pass3RawCtx, $pass3RawCtx.elementMap->values());

    // Lean-references validator (mirrors single-file compile path).
    let leanRefViolations = validateLeanReferences($pass3CtxWithFuncRefs);
    let pass3Ctx = ^$pass3CtxWithFuncRefs(errors = $pass3CtxWithFuncRefs.errors->concatenate($leanRefViolations));
    let pass3Millis = currentTimeMillis() - $pass3Start;
    if($silent, | true, | finishProgress3(); true;);

    // Pull all resolved elements from the final elementMap. Includes Packages
    // (which aren't in any file's compiledElements list) so the output PDB
    // has the full graph — matches Java's LocalModule.compile. Order is
    // elementMap iteration; the test printer sorts by sourceInfo for a
    // deterministic textual diff. The PDB write path doesn't care about list
    // order (diff-pdb compares path-set + per-element hash).
    let resolvedElements = $pass3Ctx.elementMap->values();

    // Print errors directly to stdout (before the stats summary) so they
    // appear in a single integrated output stream. Suppressed when {@code
    // silent} is true — callers extract errors structurally off the result.
    let errorCount = $pass3Ctx.errors->size();
    if($silent || $errorCount == 0, | true,
        | println('');
          println('  Compilation errors (' + $errorCount->toString() + ')');
          $pass3Ctx.errors->map(e | println('    ' + $e));
          true;
    );

    let totalMillis = currentTimeMillis() - $compileStart;
    let stats = ^CompilationStatistics(
        totalMillis = $totalMillis,
        parsingMillis = 0,
        firstPassMillis = $pass1Millis,
        secondPassMillis = $pass2Millis,
        thirdPassMillis = $pass3Millis,
        elementCount = $resolvedElements->size(),
        sourceFileCount = $total,
        // Per-file stats are a CONTRIBUTION (delta), not cumulative — see
        // [[per_file_stat_delta_not_cumulative]] memory for the quadratic
        // over-counting bug that motivated this.
        inferenceRollbackCount = $pass3Ctx.inferenceRollbacks - $inputCtx.inferenceRollbacks,
        candidateEvaluationCount = $pass3Ctx.candidateEvaluations - $inputCtx.candidateEvaluations,
        // Pass 2 and pass 3 each append a per-element ElementStatistics entry
        // so the raw list has the same elementPath twice. Aggregate per path
        // so the final stats and every downstream consumer (CLI summary, IDE
        // Compile tab) sees one row per element with cumulative timing.
        elementStatistics = $pass3Ctx.elementStatistics->aggregateElementStatistics(),
        rollbackSites = $pass3Ctx.rollbackSites
    );
    if($silent, | true, | println(printCompilationStatisticsSummary($stats)); true;);

    ^CompilationResult(
        elements = $resolvedElements,
        errors   = $pass3Ctx.errors,
        statistics = $stats,
        context  = $pass3Ctx
    );
}

// Extract a short element-type label (e.g. "UserDefinedFunction", "Class") from an
// element's runtime classifier — used by per-element statistics so the summary
// table can show what kind of element each row represents.
function meta::pure::compiler::elementSimpleType(elem:Any[1]):String[1]
{
    let t = $elem->type();
    if($t->isEmpty(),
        | 'Unknown',
        | $t->toOne()->elementToPath()->split('::')->last()->toOne()
    );
}

function meta::pure::compiler::resolveFunctionDefinition(fn:UserDefinedFunction<Any>[1], context:CompilerContext[1]):CompilerContext[1]
{
    if($fn.expressionSequence->isEmpty(),
        | $context,
        | debug($context, | 'resolveAndValidate: function \'' + $fn.functionName->toOne() + '\'');
          // Set ownerTypeParams/ownerMulParams for pass 3 — matches Java UserDefinedFunctionHandler.thirdPass setEnclosingOwner
          let enclosingBinding = ^EnclosingOwnerParametersBinding(owner = $fn, typeBindings = newMap([]->cast(@Pair<String,List<GenericType>>)), multiplicityBindings = newMap([]->cast(@Pair<String,List<Multiplicity>>)));
          let ctxWithOwner = ^$context(ownerTypeParams = $fn.typeParameters->cast(@TypeParameter), ownerMulParams = $fn.multiplicityParameters->cast(@MultiplicityParameter), enclosingOwnerBinding = $enclosingBinding);
          let result = meta::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence($fn.expressionSequence, $fn.parameters->cast(@VariableExpression), $ctxWithOwner->debugSpaceInc());
          let resultCtx = $result.context;
          // Validate return type and multiplicity of the last expression. Mirrors
          // Java FunctionDefinitionResolver.{validateReturnType, validateReturnMultiplicity}:
          // only skip when the resolved value's type/multiplicity is null. Earlier
          // errors during body resolution don't suppress this check — Java reports
          // "Return multiplicity error in function 'X': expected [1], got [*]" even
          // when the body had unrelated errors, and matching that lets Pure surface
          // a class of real bugs (functions whose declared return shape disagrees
          // with the inferred last-expr shape) that were silently swallowed before.
          let validatedCtx = if($result.resolvedSpecs->isEmpty(),
              | $resultCtx,
              | let lastExpr = $result.resolvedSpecs->at($result.resolvedSpecs->size() - 1);
                let fnName = $fn.name->toOne();
                let siCtx = meta::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo($lastExpr.sourceInformation, $resultCtx);
                // Type validation
                let ctx1 = if([pair(| $lastExpr.genericType->isEmpty() || $fn.returnGenericType->isEmpty()
                                     || $lastExpr.genericType->toOne()->instanceOf(UndefinedGenericType),
                                   | $resultCtx),
                              pair(| meta::pure::compiler::helper::genericType::isCompatibleGenericType($fn.returnGenericType->toOne(), $lastExpr.genericType->toOne(), $resultCtx),
                                   | $resultCtx)],
                             | ^$resultCtx(errors += 'Return type error in function \'' + $fnName + '\': expected ' + meta::pure::compiler::helper::genericType::printGenericType($fn.returnGenericType->toOne()) + ', got ' + meta::pure::compiler::helper::genericType::printGenericType($lastExpr.genericType->toOne()) + $siCtx)
                );
                // Multiplicity validation
                if([pair(| $lastExpr.multiplicity->isEmpty() || $fn.returnMultiplicity->isEmpty(),
                        | $ctx1),
                    pair(| meta::pure::compiler::helper::multiplicity::isCompatibleMultiplicity($fn.returnMultiplicity->toOne(), $lastExpr.multiplicity->toOne(), false),
                         | $ctx1)],
                   | ^$ctx1(errors += 'Return multiplicity error in function \'' + $fnName + '\': expected ' + meta::pure::compiler::helper::multiplicity::printMultiplicity($fn.returnMultiplicity->toOne()) + ', got ' + meta::pure::compiler::helper::multiplicity::printMultiplicity($lastExpr.multiplicity->toOne()) + $siCtx)
                );
          );
          // Resolve function constraints
          let preResult = meta::pure::compiler::structural::constraintCompiler::resolveConstraints($fn.preConstraints, $validatedCtx);
          let postResult = meta::pure::compiler::structural::constraintCompiler::resolveConstraints($fn.postConstraints, $preResult.context);
          // Store resolved function back into the map
          let resolvedFn = ^$fn(
              expressionSequence = $result.resolvedSpecs->cast(@ValueSpecification),
              preConstraints = $preResult.values,
              postConstraints = $postResult.values
          );
          let fnPath = $fn->elementToPath();
          let finalCtx = $postResult.context;
          let updatedCtx = ^$finalCtx(elementMap = $finalCtx.elementMap->put($fnPath, $resolvedFn));
          // Clear ownerTypeParams/ownerMulParams — matches Java clearEnclosingOwner
          ^$updatedCtx(debugState = $context.debugState, ownerTypeParams = [], ownerMulParams = [], enclosingOwnerBinding = []);
    );
}

function meta::pure::compiler::resolveClass(cls:Class<Any>[1], context:CompilerContext[1]):CompilerContext[1]
{
    // Read the current class from the map (may have propertiesFromAssociations set by association handler)
    let clsPath = $cls->elementToPath();
    let currentCls = $context.elementMap->get($clsPath)->toOne()->cast(@Class<Any>);
    // Set ownerTypeParams/ownerMulParams for pass 3 — matches Java ClassHandler.thirdPass setEnclosingOwner
    let enclosingBinding = ^EnclosingOwnerParametersBinding(owner = $currentCls, typeBindings = newMap([]->cast(@Pair<String,List<GenericType>>)), multiplicityBindings = newMap([]->cast(@Pair<String,List<Multiplicity>>)));
    let ctxWithOwner = ^$context(ownerTypeParams = $currentCls.typeParameters->cast(@TypeParameter), ownerMulParams = $currentCls.multiplicityParameters->cast(@MultiplicityParameter), enclosingOwnerBinding = $enclosingBinding);
    let qpResult = meta::pure::compiler::structural::qualifiedPropertyCompiler::compileQualifiedProperties($currentCls.qualifiedProperties, $currentCls.typeVariables->cast(@VariableExpression), $ctxWithOwner);
    let ctx2 = meta::pure::compiler::structural::qualifiedPropertyCompiler::compileQualifiedPropertyOverrides($currentCls, $qpResult.context);
    let constraintResult = meta::pure::compiler::structural::constraintCompiler::resolveConstraints($currentCls.constraints, $ctx2);
    let propResult = meta::pure::compiler::structural::propertyCompiler::resolvePropertyDefaultValues($currentCls.properties, $constraintResult.context);
    let ctx5 = meta::pure::compiler::structural::propertyCompiler::validatePropertyOverrides($currentCls, $propResult.context);
    // Store resolved class back into the map (preserving propertiesFromAssociations from currentCls)
    let resolvedCls = ^$currentCls(
        qualifiedProperties = $qpResult.values->map(qp | ^$qp(owner = ~.~)),
        constraints = $constraintResult.values,
        properties = $propResult.values->map(p | ^$p(owner = ~.~))
    );
    let updatedCtx = ^$ctx5(elementMap = $ctx5.elementMap->put($clsPath, $resolvedCls));
    // Clear ownerTypeParams/ownerMulParams — matches Java clearEnclosingOwner
    ^$updatedCtx(ownerTypeParams = [], ownerMulParams = [], enclosingOwnerBinding = []);
}

function meta::pure::compiler::resolveAssociation(assoc:Association[1], context:CompilerContext[1]):CompilerContext[1]
{
    if($assoc.qualifiedProperties->isEmpty(),
        | $context,
        | let qpResult = meta::pure::compiler::structural::qualifiedPropertyCompiler::compileQualifiedProperties($assoc.qualifiedProperties, $context);
          let resolvedAssoc = ^$assoc(
              qualifiedProperties = $qpResult.values->map(qp | ^$qp(owner = ~.~))
          );
          let assocPath = $assoc->elementToPath();
          let qpCtx = $qpResult.context;
          ^$qpCtx(elementMap = $qpCtx.elementMap->put($assocPath, $resolvedAssoc));
    );
}

function meta::pure::compiler::resolvePrimitive(pt:PrimitiveType[1], context:CompilerContext[1]):CompilerContext[1]
{
    let constraintResult = meta::pure::compiler::structural::constraintCompiler::resolveConstraints($pt.constraints, $context);
    let resolvedPt = ^$pt(constraints = $constraintResult.values);
    let ptPath = $pt->elementToPath();
    let crCtx = $constraintResult.context;
    ^$crCtx(elementMap = $crCtx.elementMap->put($ptPath, $resolvedPt));
}
