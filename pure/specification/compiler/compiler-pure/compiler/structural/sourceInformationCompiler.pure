import meta::pure::metamodel::*;
import meta::pure::compiler::*;
import meta::pure::functions::collection::*;

// Compile a grammar-level SourceInformation to a metamodel-level one,
// falling back to {@code context.sourceId} when the grammar SI has no
// sourceId. The grammar parser emits SourceInformation per-section
// without knowing the enclosing file; the file identity lives on the
// CompilerContext (set per file in every compile pass — see
// compiler.pure phases 2/3/4). Every compiled SI must carry the file —
// LSP go-to-definition, error reporting, and stack frames depend on it.
function meta::pure::compiler::structural::sourceInformationCompiler::compileSourceInformation(grammarSI:meta::pure::protocol::grammar::SourceInformation[0..1], context:CompilerContext[1]):SourceInformation[0..1]
{
    $grammarSI->map(si |
        let sid = if($si.sourceId->isNotEmpty(), | $si.sourceId, | $context.sourceId);
        ^SourceInformation(
            sourceId = $sid,
            startLine = $si.startLine,
            startColumn = $si.startColumn,
            endLine = $si.endLine,
            endColumn = $si.endColumn
        );
    )
}

// Unified source-location format used everywhere a Pure source position is
// rendered (compile errors, stack frames, validation messages):
//
//   (at <sourceId>:<line>c<col>-<endLine>c<endCol>)
//
// `c` separates line from column, matching bootstrap's call-stack format
// (ValueSpecificationEvaluator.formatSourceFrame) and Truffle's
// PureStackFormatter. A single IDE regex turns any of these into a clickable
// jump-to-source link.
function meta::pure::compiler::structural::sourceInformationCompiler::formatSourceInfo(si:meta::pure::protocol::grammar::SourceInformation[0..1], context:CompilerContext[1]):String[1]
{
    if($si->isEmpty(),
        | '',
        | let psi = $si->toOne();
          let sid = firstNonEmpty([
              | $psi.sourceId,
              | $context.sourceId
          ])->head();
          if($sid->isNotEmpty() && $sid->toOne()->length() > 0,
              | ' (at ' + $sid->toOne() + ':' + $psi.startLine->toOne()->toString() + 'c' + $psi.startColumn->toOne()->toString() + '-' + $psi.endLine->toOne()->toString() + 'c' + $psi.endColumn->toOne()->toString() + ')',
              | ''
          );
    );
}

function meta::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo(si:SourceInformation[0..1], context:CompilerContext[1]):String[1]
{
    if($si->isEmpty(),
        | '',
        | let msi = $si->toOne();
          let sid = firstNonEmpty([
              | $msi.sourceId,
              | $context.sourceId
          ])->head();
          if($sid->isNotEmpty() && $sid->toOne()->length() > 0,
              | ' (at ' + $sid->toOne() + ':' + $msi.startLine->toOne()->toString() + 'c' + $msi.startColumn->toOne()->toString() + '-' + $msi.endLine->toOne()->toString() + 'c' + $msi.endColumn->toOne()->toString() + ')',
              | ''
          );
    );
}
