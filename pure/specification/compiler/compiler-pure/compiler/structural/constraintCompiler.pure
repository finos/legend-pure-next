import platform::pure::metamodel::*;
import platform::pure::metamodel::valuespecification::*;
import platform::pure::metamodel::type::*;
import platform::pure::metamodel::type::generics::*;
import platform::pure::metamodel::function::*;
import platform::pure::metamodel::multiplicity::*;
import platform::pure::metamodel::constraint::*;
import platform::pure::functions::lang::*;
import platform::pure::compiler::structural::constraintCompiler::*;
import platform::pure::compiler::structural::valueSpecificationCompiler::*;
import platform::pure::compiler::structural::lambdaCompiler::*;
import platform::pure::compiler::structural::sourceInformationCompiler::*;
import platform::pure::compiler::helper::pointer::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::*;

function platform::pure::compiler::structural::constraintCompiler::compileConstraints(protocolConstraints:platform::pure::protocol::grammar::constraint::Constraint[*], ownerGenericType:GenericType[1], context:CompilerContext[1]):CompilerListResult<Constraint>[1]
{
    compileConstraints($protocolConstraints, $ownerGenericType, [], $context);
}

function platform::pure::compiler::structural::constraintCompiler::compileConstraints(protocolConstraints:platform::pure::protocol::grammar::constraint::Constraint[*], ownerGenericType:GenericType[1], extraScope:VariableExpression[*], context:CompilerContext[1]):CompilerListResult<Constraint>[1]
{
    let thisVar = ^VariableExpression(
        name = 'this',
        genericType = $ownerGenericType,
        multiplicity = PureOne
    );
    let scope = [$thisVar]->concatenate($extraScope);

    $protocolConstraints->fold({pc, acc |
        let result = compileConstraint($pc, $scope, $acc.context);
        ^$acc(values += $result.value, context = $result.context);
    }, ^CompilerListResult<Constraint>(context = $context));
}

function platform::pure::compiler::structural::constraintCompiler::compileConstraint(pc:platform::pure::protocol::grammar::constraint::Constraint[1], thisScope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<Any>[1]
{
    // Skeleton constraint — functionDefinition is populated below; new() allows
    // the mul-1 field to start null. Classifier is a literal so no deref needed.
    let emptyConstraint = new(
        ^UserDefinedGenericType(type = Constraint)
    )->cast(@Constraint);

    let funcDef = $pc.functionDefinition->cast(@platform::pure::protocol::grammar::function::LambdaFunction);
    let lambdaResult = $funcDef->compileLambda($context, $thisScope, [], []);
    let ctx1 = if($lambdaResult.context->isNotEmpty(), | $lambdaResult.context->toOne(), | $context);

    if($lambdaResult.values->isEmpty(),
        | ^CompilerResult<Any>(value = $emptyConstraint, context = $ctx1),
        | let lambda = $lambdaResult.values->at(0)->cast(@AtomicValue).value->toOne()->cast(@LambdaFunction<Any>);
          let compiledLambda = ^$lambda(parameters = $thisScope->concatenate($lambda.parameters));

          let msgResult = if($pc.messageFunction->isEmpty(),
              | ^CompilerResult<Any>(context = $ctx1),
              | let msgFunc = $pc.messageFunction->toOne()->cast(@platform::pure::protocol::grammar::function::LambdaFunction);
                let mr = $msgFunc->compileLambda($ctx1, $thisScope, [], []);
                let mCtx = if($mr.context->isNotEmpty(), | $mr.context->toOne(), | $ctx1);
                if($mr.values->isEmpty(),
                    | ^CompilerResult<Any>(context = $mCtx),
                    | let ml = $mr.values->at(0)->cast(@AtomicValue).value->toOne()->cast(@LambdaFunction<Any>);
                      ^CompilerResult<Any>(value = ^$ml(parameters = $thisScope->concatenate($ml.parameters)), context = $mCtx);
                );
          );
          let ctx2 = $msgResult.context;

          ^CompilerResult<Any>(
              value = ^$emptyConstraint(
                  name = $pc.name,
                  owner = $pc.owner,
                  externalId = $pc.externalId,
                  enforcementLevel = $pc.enforcementLevel,
                  functionDefinition = $compiledLambda,
                  messageFunction = $msgResult.value->cast(@FunctionDefinition<Any>),
                  sourceInformation = compileSourceInformation($pc.p_sourceInformation, $context)
              ),
              context = $ctx2
          );
    );
}

function platform::pure::compiler::structural::constraintCompiler::compileFunctionConstraints(protocolConstraints:platform::pure::protocol::grammar::constraint::Constraint[*], scope:VariableExpression[*], context:CompilerContext[1]):CompilerListResult<Constraint>[1]
{
    $protocolConstraints->fold({pc, acc |
        let result = compileConstraint($pc, $scope, $acc.context);
        ^$acc(values += $result.value, context = $result.context);
    }, ^CompilerListResult<Constraint>(context = $context));
}

function platform::pure::compiler::structural::constraintCompiler::compileFunctionConstraints(constraints:Constraint[*], context:CompilerContext[1]):CompilerContext[1]
{
    $constraints->fold({constraint, cCtx |
        if($constraint.functionDefinition->isEmpty(),
            | $cCtx,
            | let lambda = $constraint.functionDefinition->toOne()->cast(@LambdaFunction<Any>);
              platform::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence(
                  $lambda.expressionSequence,
                  $lambda.parameters->cast(@VariableExpression),
                  $cCtx
              ).context;
        );
    }, $context);
}

function platform::pure::compiler::structural::constraintCompiler::resolveConstraints(constraints:Constraint[*], context:CompilerContext[1]):CompilerListResult<Constraint>[1]
{
    $constraints->fold({constraint, acc |
        if($constraint.functionDefinition->isEmpty(),
            | ^$acc(values += $constraint),
            | // Push sub-element caller path so refs resolved inside the
              // constraint body attribute to {@code Owner.constraintName}.
              // Mirrors Java ConstraintCompiler.resolveConstraints
              // withCallerSubElement wrapping.
              let cname = if($constraint.name->isEmpty(), | '_unnamed_constraint', | $constraint.name->toOne());
              let resolved = $acc.context->withCallerSubElement($cname, {ctx |
                  let lambda = $constraint.functionDefinition->toOne()->cast(@LambdaFunction<Any>);
                  let result = platform::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence(
                      $lambda.expressionSequence,
                      $lambda.parameters->cast(@VariableExpression),
                      $ctx
                  );
                  let resolvedLambda = platform::pure::compiler::structural::lambdaCompiler::rebuildLambdaCGT(^$lambda(expressionSequence = $result.resolvedSpecs->cast(@ValueSpecification)));
                  let resolvedMsgFn = if($constraint.messageFunction->isEmpty(),
                      | [],
                      | let msgLambda = $constraint.messageFunction->toOne()->cast(@LambdaFunction<Any>);
                        let msgResult = platform::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence(
                            $msgLambda.expressionSequence,
                            $msgLambda.parameters->cast(@VariableExpression),
                            $result.context
                        );
                        platform::pure::compiler::structural::lambdaCompiler::rebuildLambdaCGT(^$msgLambda(expressionSequence = $msgResult.resolvedSpecs->cast(@ValueSpecification)));
                  );
                  let resolvedConstraint = ^$constraint(
                      functionDefinition = $resolvedLambda,
                      messageFunction = $resolvedMsgFn
                  );
                  ^CompilerResult<Constraint>(value = $resolvedConstraint, context = $result.context);
              });
              ^$acc(values += $resolved.value, context = $resolved.context);
        );
    }, ^CompilerListResult<Constraint>(context = $context));
}

function platform::pure::compiler::structural::constraintCompiler::compileConstraints(elem:Any[1], context:CompilerContext[1]):CompilerContext[1]
{
    let constraints = $elem->match(
        [
            c : Class<Any>[1]     | $c.constraints,
            p : PrimitiveType[1]  | $p.constraints,
            a : Any[1]            | []
        ]
    );
    resolveConstraints($constraints, $context).context;
}
