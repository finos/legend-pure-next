import meta::pure::metamodel::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::functions::lang::*;
import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::*;

// Rebuild a lambda's classifierGenericType from its resolved parameters and body.
// Called after pass-3 resolution to update the CGT with concrete types.
function meta::pure::compiler::structural::lambdaCompiler::rebuildLambdaCGT(lambda:LambdaFunction<Any>[1]):LambdaFunction<Any>[1]
{
    let params = $lambda.parameters->cast(@VariableExpression);
    let lastExpr = if($lambda.expressionSequence->isEmpty(), | [], | $lambda.expressionSequence->at($lambda.expressionSequence->size() - 1));
    let bodyReturnGT = if($lastExpr->isEmpty() || $lastExpr->toOne().genericType->isEmpty(),
        | ^CompilerNotSetGenericType(),
        | $lastExpr->toOne().genericType->toOne()
    );
    let bodyReturnMul = if($lastExpr->isEmpty() || $lastExpr->toOne().multiplicity->isEmpty(),
        | PureOne,
        | $lastExpr->toOne().multiplicity->toOne()
    );
    let ft = new(buildUserDefinedGenericType(FunctionType))->cast(@FunctionType);
    let rebuiltFT = ^$ft(parameters = $params, returnType = $bodyReturnGT, returnMultiplicity = $bodyReturnMul);
    let rebuiltCGTBase = buildInferredGenericType(LambdaFunction);
    let rebuiltCGT = ^$rebuiltCGTBase(typeArguments = [buildInferredGenericType($rebuiltFT)]);
    ^$lambda(classifierGenericType = $rebuiltCGT);
}

function meta::pure::compiler::structural::lambdaCompiler::compileLambda(l:meta::pure::protocol::grammar::function::LambdaFunction[1], ctx:CompilerContext[1], scope:VariableExpression[*], mGenType:GenericType[0..1], mMult:Multiplicity[0..1]): ValueCompileResult[1]
{
    let siCtx = if($l.p_sourceInformation->isNotEmpty(), | formatSourceInfo($l.p_sourceInformation->toOne()->cast(@meta::pure::protocol::grammar::SourceInformation), $ctx), | '');

    // Check for duplicate parameter names
    let dupNames = $l.parameters->map(p | $p.name)->filter(n | $l.parameters->filter(p | $p.name == $n)->size() > 1)->removeDuplicates();
    let ctx1 = $dupNames->fold({d, c |
        ^$c(errors += 'Duplicate parameter name \'' + $d + '\'' + $siCtx);
    }, $ctx);

    // NOTE: Java LambdaCompiler does NOT check for variable conflicts with outer scope.
    // Lambda parameters are allowed to shadow outer variables — the inner scope takes precedence.
    let ctx3 = $ctx1;

    if($ctx3.errors->size() > $ctx.errors->size(),
        | ^ValueCompileResult(values = [], openVariables = [], context = $ctx3),
        | // Compile params — match Java LambdaCompiler.compileParameter: only set genericType if present
          let compiledParams = $l.parameters->map(p |
              let hasType = $p.genericType->isNotEmpty() && $p.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue).type->isNotEmpty();
              let pmGenType = if($hasType,
                  | $p.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($ctx3, '', []).value->toOne(),
                  | ^CompilerNotSetGenericType()
              );
              // For untyped lambda params, use CompilerNotSetMultiplicity (matching Java null).
              // setMissingLambdaParameterInformation will fill the actual multiplicity from bindings.
              let pmMult = if($p.multiplicity->isEmpty(),
                  | ^CompilerNotSetMultiplicity(),
                  | $p.multiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity()
              );
              ^VariableExpression(
                  name = $p.name,
                  genericType = $pmGenType,
                  multiplicity = $pmMult,
                  sourceInformation = compileSourceInformation($p.p_sourceInformation)
              )->cast(@VariableExpression);
          );

          let innerScope = $scope->concatenate($compiledParams);
          let compiledSequence = compileExpressionSequence($l.expressionSequence, $ctx3, $innerScope);
          let ctx4 = if($compiledSequence.context->isNotEmpty(), | $compiledSequence.context->toOne(), | $ctx3);

          let openVariables = $compiledSequence.openVariables->filter(var |
              $innerScope->filter(s | $s.name == $var.name)->isEmpty()
          );

          let bodyReturnGT = if($compiledSequence.specs->isEmpty(),
              | ^CompilerNotSetGenericType(),
              | let lastExpr = $compiledSequence.specs->at($compiledSequence.specs->size() - 1);
                if($lastExpr.genericType->isEmpty(),
                    | ^CompilerNotSetGenericType(),
                    | asInferredGenericType($lastExpr.genericType->toOne())
                );
          );
          let bodyReturnMul = if($compiledSequence.specs->isEmpty(),
              | PureOne,
              | let lastExpr = $compiledSequence.specs->at($compiledSequence.specs->size() - 1);
                if($lastExpr.multiplicity->isEmpty(),
                    | PureOne,
                    | asInferredMultiplicity($lastExpr.multiplicity->toOne())
                );
          );

          let lambdaFunctionType = new(
              buildUserDefinedGenericType(FunctionType)
          )->cast(@FunctionType);
          let ft = ^$lambdaFunctionType(
              parameters = $compiledParams,
              returnType = $bodyReturnGT,
              returnMultiplicity = $bodyReturnMul
          );

          let lambdaCGTBase = buildInferredGenericType(LambdaFunction);
          let lambdaCGT = ^$lambdaCGTBase(typeArguments = [buildInferredGenericType($ft)]);

          let emptyLambda = new(
              buildUserDefinedGenericType(LambdaFunction)
          )->cast(@LambdaFunction<Any>);
          let m3Lambda = ^$emptyLambda(
              parameters = $compiledParams,
              expressionSequence = $compiledSequence.specs,
              openVariables = $openVariables,
              classifierGenericType = $lambdaCGT,
              sourceInformation = compileSourceInformationWithFallback($l.p_sourceInformation, $ctx)
          );

          let wrappedLambda = ^AtomicValue(
              value = $m3Lambda,
              genericType = $lambdaCGT,
              multiplicity = PureOne
          );
          ^ValueCompileResult(
              values = [$wrappedLambda],
              openVariables = $openVariables,
              context = $ctx4
          );
    );
}
