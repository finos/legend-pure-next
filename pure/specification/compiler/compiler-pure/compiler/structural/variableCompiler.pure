import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::multiplicityCompiler::*;
import meta::pure::compiler::structural::variableCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::structural::variableCompiler::compileParameter(p:meta::pure::protocol::grammar::valuespecification::VariableExpression[1], context:CompilerContext[1], packagePath:String[1], typeParameters:TypeParameter[*], ownerContext:String[1]):CompilerResult<VariableExpression>[1]
{
    let pType = $p.genericType->toOne()->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
    // Anonymous params (inner FunctionType slots like `{X[1]->Y[1]}`) carry no
    // name — skip the `parameter '<name>'` clause for them so the type-not-found
    // error doesn't end up with a bogus `in parameter ''` segment.
    let elementContext = if($p.name->isEmpty(), | '', | 'parameter \'' + $p.name->toOne() + '\'');
    let gtResult = $pType->compileGenericType($context, $packagePath, $typeParameters, $elementContext, $ownerContext);
    let mMult = $p.multiplicity->toOne()->compileMultiplicity();
    ^CompilerResult<VariableExpression>(
        value = ^VariableExpression(
            // Mirror Java VariableCompiler.compileParameter: anonymous params
            // (e.g. inner FunctionType `{X[1]->Y[1]}`) have no name in the
            // grammar; default to '' so the writer's [1] validation doesn't
            // reject the resulting VariableExpression.
            name = if($p.name->isEmpty(), | '', | $p.name->toOne()),
            genericType = $gtResult.value->toOne(),
            multiplicity = $mMult
        ),
        context = $gtResult.context
    );
}

function meta::pure::compiler::structural::variableCompiler::compileParameters(parameters:meta::pure::protocol::grammar::valuespecification::VariableExpression[*], context:CompilerContext[1], packagePath:String[1], typeParameters:TypeParameter[*], ownerContext:String[1]):CompilerListResult<VariableExpression>[1]
{
    $parameters->fold({p, acc |
        let result = compileParameter($p, $acc.context, $packagePath, $typeParameters, $ownerContext);
        ^$acc(
            values += $result.value->toOne(),
            context = $result.context
        );
    }, ^CompilerListResult<VariableExpression>(context = $context));
}
