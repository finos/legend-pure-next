import platform::pure::compiler::helper::genericType::*;
import platform::pure::metamodel::valuespecification::*;
import platform::pure::metamodel::type::*;
import platform::pure::metamodel::type::generics::*;
import platform::pure::functions::lang::*;
import platform::pure::compiler::structural::functionTypeCompiler::*;

function platform::pure::compiler::structural::functionTypeCompiler::compileFunctionType(parameters:VariableExpression[*], returnGenericType:GenericType[1], returnMultiplicity:Multiplicity[1]):FunctionType[1]
{
    let functionType = new(^UserDefinedGenericType(type = FunctionType))->cast(@FunctionType);
    ^$functionType(
        parameters = $parameters,
        returnType = $returnGenericType,
        returnMultiplicity = $returnMultiplicity
    );
}
