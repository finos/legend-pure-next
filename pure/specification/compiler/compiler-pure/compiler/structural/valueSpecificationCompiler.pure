Class meta::pure::compiler::structural::valueSpecificationCompiler::SequenceCompileResult
{
    specs: ValueSpecification[*];
    scope: VariableExpression[*];
    openVariables: VariableExpression[*];
    context: CompilerContext[0..1];
}

Class meta::pure::compiler::structural::valueSpecificationCompiler::ValueCompileResult
{
    values: ValueSpecification[*];
    openVariables: VariableExpression[*];
    context: CompilerContext[0..1];
}

// ============================================================================
// Expression sequence compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileExpressionSequence(expressions:meta::pure::protocol::grammar::valuespecification::ValueSpecification[*], ctx:CompilerContext[1], scope:VariableExpression[*]): SequenceCompileResult[1]
{
    let result = fold($expressions, {expr, acc |
        let currentCtx = if($acc.context->isNotEmpty(), | $acc.context->toOne(), | $ctx);
        let m3ExprResult = $expr->compileValueSpecification($currentCtx, $acc.scope);
        let updatedCtx = if($m3ExprResult.context->isNotEmpty(), | $m3ExprResult.context, | $acc.context);

        if($m3ExprResult.values->isEmpty(),
            | ^SequenceCompileResult(
                  specs = $acc.specs,
                  scope = $acc.scope,
                  openVariables = $acc.openVariables,
                  context = $updatedCtx
              ),
            | let m3Expr = $m3ExprResult.values->at(0);
              let exprOpenVars = $m3ExprResult.openVariables;
              // Expand scope for let bindings
              let newScope = match($expr, [
                  fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
                      if($fi.functionName == 'letFunction',
                          | let m3FI = $m3Expr->cast(@FunctionInvocation);
                            let args = $m3FI.parametersValues;
                            let varName = $args->at(0)->cast(@AtomicValue<String>).value->cast(@String);
                            let newVar = ^VariableExpression(
                                name = $varName,
                                genericType = $m3FI.genericType,
                                multiplicity = $m3FI.multiplicity
                            );
                            $acc.scope->concatenate($newVar);,
                          | $acc.scope
                      ),
                  a:Any[1] | $acc.scope
              ]);
              ^SequenceCompileResult(
                  specs = $acc.specs->concatenate($m3Expr),
                  scope = $newScope,
                  openVariables = $acc.openVariables->concatenate($exprOpenVars)->removeDuplicatesBy({v | $v.name->toOne()}),
                  context = $updatedCtx
              );
        );
    }, ^SequenceCompileResult(specs=[], scope=$scope, openVariables=[]));
    $result;
}

// ============================================================================
// Value specification compilation — dispatches by protocol type
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileValueSpecification(vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:CompilerContext[1], scope:VariableExpression[*]): ValueCompileResult[1]
{
    let mGenType = if($vs.genericType->isEmpty(), | [], | match($vs.genericType->toOne(), [g:meta::pure::protocol::grammar::type::generics::GenericTypeValue[1] | $g->compileGenericType($ctx, '', []).value, a:Any[1] | []]));
    let mMult = if($vs.multiplicity->isEmpty(), | [], | $vs.multiplicity->toOne()->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity());

    match($vs, [
        a:meta::pure::protocol::grammar::valuespecification::AtomicValue[1] |
            compileAtomicValue($a, $vs, $ctx, $scope, $mGenType, $mMult),

        v:meta::pure::protocol::grammar::valuespecification::VariableExpression[1] |
            compileVariableExpression($v, $vs, $ctx, $scope),

        fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
            compileFunctionInvocation($fi, $vs, $ctx, $scope),

        l:meta::pure::protocol::grammar::function::LambdaFunction[1] |
            $l->compileLambda($ctx, $scope, $mGenType, $mMult),

        c:meta::pure::protocol::grammar::valuespecification::Collection[1] |
            compileCollection($c, $ctx, $scope),

        arrow:meta::pure::protocol::grammar::valuespecification::ArrowInvocation[1] |
            compileArrowInvocation($arrow, $vs, $ctx, $scope),

        dot:meta::pure::protocol::grammar::valuespecification::DotApplication[1] |
            compileDotApplication($dot, $vs, $ctx, $scope),

        gmh:meta::pure::protocol::grammar::valuespecification::GenericTypeAndMultiplicityHolder[1] |
            compileGenericTypeAndMultiplicityHolder($gmh, $vs, $ctx),

        any:Any[1] |
            ^ValueCompileResult(values = [], openVariables = [])
    ]);
}

// ============================================================================
// AtomicValue compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileAtomicValue(a:meta::pure::protocol::grammar::valuespecification::AtomicValue[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:CompilerContext[1], scope:VariableExpression[*], mGenType:GenericType[0..1], mMult:Multiplicity[0..1]):ValueCompileResult[1]
{
    let rawValue = $a.value->toOne();
    match($rawValue, [
        lf:meta::pure::protocol::grammar::function::LambdaFunction[1] |
            let lambdaResult = $lf->compileLambda($ctx, $scope, $mGenType, $mMult);
            if($lambdaResult.values->isEmpty(),
                | $lambdaResult,
                | // Lambda is already wrapped in AtomicValue by compileLambda
                  let wrappedLambda = $lambdaResult.values->at(0)->cast(@AtomicValue);
                  let inferredGT = if($mGenType->isEmpty(), | ^CompilerNotSetGenericType(), | $mGenType->toOne());
                  ^ValueCompileResult(
                      values = [^$wrappedLambda(
                          genericType = $inferredGT,
                          multiplicity = if($mMult->isEmpty(), | PureOne, | $mMult->toOne()),
                          sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
                      )],
                      openVariables = $lambdaResult.openVariables,
                      context = $lambdaResult.context
                  );
            );,
        pp:meta::pure::protocol::grammar::Package_Pointer[1] |
            let resolved = $ctx->resolveElement($pp.value);
            if($resolved->isEmpty(),
                | // Defer the "element can't be found" error to pass 3 (atomicValueResolver).
                  // Mirrors Java: pass 2 keeps the Package_Pointer as the AtomicValue's value
                  // so pass 3 can re-attempt resolution INSIDE a candidate trial. When the
                  // surrounding function call has multiple candidates and they all fail, the
                  // resolver's snapshot/rollback discards these errors — they only stick if no
                  // other failure swallows them. Without this deferral, ~27 cascade errors fire
                  // permanently in pass 2 for prohibited-functions lists in language/java.
                  ^ValueCompileResult(
                      values = [^AtomicValue(
                          value = $pp,
                          genericType = ^CompilerNotSetGenericType(),
                          multiplicity = ^CompilerNotSetMultiplicity(),
                          sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
                      )],
                      openVariables = []
                  );,
                | let element = $resolved->toOne();
                  // Use classifierGenericType if available (includes FunctionType type args for functions)
                  // Otherwise fall back to InferredGenericType(element->type()) — mirrors Java where Package_Pointer gt=NotSet
                  // and pass-3 resolveAtomicValue refreshes it from the map
                  let elementCGT = $element->cast(@Any).classifierGenericType;
                  let elementGT = if($elementCGT->isNotEmpty(), | asInferredGenericType($elementCGT->toOne()), | buildInferredGenericType($element->type()));
                  ^ValueCompileResult(
                      values = [^AtomicValue(
                          value = $element,
                          genericType = $elementGT,
                          multiplicity = PureOne,
                          sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
                      )],
                      openVariables = []
                  );
            );,
        any:Any[1] |
            let parserGT = $a.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
            let compiledGT = $parserGT->compileGenericType($ctx, '', []);
            let inferredGT = if($compiledGT.value->isEmpty() || $compiledGT.value->toOne()->instanceOf(UndefinedGenericType),
                | if($mGenType->isEmpty(), | ^CompilerNotSetGenericType(), | $mGenType->toOne()),
                | $compiledGT.value->toOne()
            );
            // Unescape string literals and normalize date literals.
            // Uses genericType name to determine the type of the raw value.
            // (mirrors Java ValueSpecificationCompiler lines 197-249)
            let typeName = getGenericTypeName($inferredGT);
            let isString = $typeName == 'String';
            let isDate = $typeName == 'DateTime' || $typeName == 'StrictDate' || $typeName == 'Date' || $typeName == 'StrictTime';
            let processedValue = if($isString,
                | // Parser leaves escape sequences as literal two-char sequences;
                  // unescape via the native (chained replace can't handle `\\`
                  // without distorting its own patterns under self-host).
                  meta::pure::compiler::structural::valueSpecificationCompiler::unescapePureString($rawValue->cast(@String)),
                | if($isDate,
                    | normalizeDateString($rawValue->toString()),
                    | $rawValue
                )
            );
            let finalGT = if($isDate,
                | let ds = $processedValue->toString();
                  let dateTypePath = if($ds->contains('T'),
                      | 'meta::pure::metamodel::type::primitives::DateTime',
                      | if($ds->length() <= 7,
                          | 'meta::pure::metamodel::type::primitives::Date',
                          | 'meta::pure::metamodel::type::primitives::StrictDate'
                      )
                  );
                  let dateType = $ctx->resolveElement($dateTypePath);
                  if($dateType->isEmpty(),
                      | $inferredGT,
                      | buildUserDefinedGenericType($dateType->toOne()->cast(@Type))
                  );,
                | $inferredGT
            );
            ^ValueCompileResult(
                values = [^AtomicValue(
                    value = $processedValue,
                    genericType = $finalGT,
                    multiplicity = if($mMult->isEmpty(), | PureOne, | $mMult->toOne()),
                    sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
                )],
                openVariables = []
            );
    ]);
}

// ============================================================================
// VariableExpression compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileVariableExpression(v:meta::pure::protocol::grammar::valuespecification::VariableExpression[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:CompilerContext[1], scope:VariableExpression[*]):ValueCompileResult[1]
{
    let inScope = $scope->filter(s | $s.name == $v.name);
    if($inScope->isEmpty(),
        | ^ValueCompileResult(
              values = [^VariableExpression(
                  name = $v.name,
                  genericType = ^CompilerNotSetGenericType(),
                  multiplicity = PureOne,
                  sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
              )],
              openVariables = []
          ),
        | let varGT = $inScope->at(0).genericType->toOne();
          let varMul = $inScope->at(0).multiplicity->toOne();
          ^ValueCompileResult(
              values = [^VariableExpression(
                  name = $v.name,
                  genericType = asInferredGenericType($varGT),
                  multiplicity = asInferredMultiplicity($varMul),
                  sourceInformation = compileSourceInformation($vs.p_sourceInformation)
              )],
              openVariables = []
          );
    );
}

// ============================================================================
// FunctionInvocation compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileFunctionInvocation(fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:CompilerContext[1], scope:VariableExpression[*]):ValueCompileResult[1]
{
    // Structural compilation only — function resolution happens in pass 3
    let paramsCompilation = $fi.parametersValues->map(p | $p->compileValueSpecification($ctx, $scope));
    let errorContexts = $paramsCompilation.context->filter(c | $c.errors->size() > $ctx.errors->size());
    if($errorContexts->isNotEmpty(),
        | ^ValueCompileResult(values = [], openVariables = [], context = $errorContexts->at($errorContexts->size() - 1)),
        | let paramValues = $paramsCompilation.values;
          let openVars = $paramsCompilation.openVariables->removeDuplicatesBy({ov| $ov.name->toOne()});
          // Constant-fold unary minus on a numeric literal:
          //   minus(AtomicValue(N)) → AtomicValue(-N), preserving generic type/multiplicity.
          // Mirrors the symmetric fold in the Java ValueSpecificationCompiler. The
          // parser always emits FunctionInvocation("minus", [literal]) for `-1`; the
          // compiler folds it so the compiled graph stays as a plain literal.
          let folded = tryFoldUnaryMinus($fi, $paramValues, $vs, $ctx);
          // Arity-based name dispatch for column-spec builders: parser emits
          // the unsuffixed funcColSpec / aggColSpec / funcColSpecArray /
          // aggColSpecArray; the compiler rewrites to the *2 variant when the
          // lambda has 3 parameters (Relation, Window, U). Pure's function
          // mangling collapses Function<{...}> argument types so the two
          // variants can't share a name as overloads — name-rewrite is the
          // only path. Mirrors Java's ValueSpecificationCompiler.
          let effectiveName = dispatchColSpecArity($fi.functionName->toOne(), $paramValues);
          if($folded->isNotEmpty(),
              | ^ValueCompileResult(
                    values = $folded->cast(@ValueSpecification),
                    openVariables = $openVars
                ),
              | ^ValueCompileResult(
                    values = [^FunctionInvocation(
                        functionName = $effectiveName,
                        parametersValues = $paramValues->cast(@ValueSpecification),
                        genericType = ^CompilerNotSetGenericType(),
                        multiplicity = PureOne,
                        sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
                    )],
                    openVariables = $openVars
                )
          );
    );
}

function meta::pure::compiler::structural::valueSpecificationCompiler::tryFoldUnaryMinus(fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1], paramValues:ValueSpecification[*], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:CompilerContext[1]):AtomicValue[0..1]
{
    let av = if($fi.functionName == 'minus' && $paramValues->size() == 1 && $paramValues->at(0)->instanceOf(AtomicValue),
        | $paramValues->at(0)->cast(@AtomicValue),
        | []
    );
    let foldable = $av->isNotEmpty()
                   && $av->toOne().value->isNotEmpty()
                   && $av->toOne().value->toOne()->instanceOf(Number);
    if($foldable,
        | let avOne = $av->toOne();
          // Dispatch on the literal's runtime type so the negated value keeps
          // the same primitive (Integer→Integer, Float→Float, Decimal→Decimal).
          // Use unary `-x` rather than `minus(0, x)` to avoid a Number-typed
          // literal zero on the LHS, which would coerce the result to Number
          // and lose the original primitive type.
          let negated = $avOne.value->toOne()->match([
              i:Integer[1] | -$i,
              f:Float[1]   | -$f,
              d:Decimal[1] | -$d,
              n:Number[1]  | -$n
          ]);
          let folded = ^AtomicValue(
              value = $negated,
              genericType = $avOne.genericType,
              multiplicity = $avOne.multiplicity,
              sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
          );
          $folded;,
        | []
    );
}

// ----------------------------------------------------------------------------
// Column-spec arity dispatch
// ----------------------------------------------------------------------------

function meta::pure::compiler::structural::valueSpecificationCompiler::dispatchColSpecArity(name:String[1], paramValues:ValueSpecification[*]):String[1]
{
    if($paramValues->isEmpty(),
        | $name,
        | if($name == 'funcColSpec' || $name == 'aggColSpec',
              | if(firstParamIsLambdaOfArity($paramValues, 3), | $name + '2', | $name),
              | if($name == 'funcColSpecArray' || $name == 'aggColSpecArray',
                    | if(firstCollectionElementUsesArity2($paramValues), | $name + '2', | $name),
                    | $name
                )
          )
    )
}

function meta::pure::compiler::structural::valueSpecificationCompiler::firstParamIsLambdaOfArity(paramValues:ValueSpecification[*], arity:Integer[1]):Boolean[1]
{
    let first = $paramValues->at(0);
    let lambdaArity = if($first->instanceOf(AtomicValue),
        | let avVal = $first->cast(@AtomicValue).value;
          if($avVal->isNotEmpty() && $avVal->toOne()->instanceOf(LambdaFunction),
              | $avVal->toOne()->cast(@LambdaFunction<Any>).parameters->size(),
              | -1
          );,
        | -1
    );
    $lambdaArity == $arity;
}

function meta::pure::compiler::structural::valueSpecificationCompiler::firstCollectionElementUsesArity2(paramValues:ValueSpecification[*]):Boolean[1]
{
    let first = $paramValues->at(0);
    let innerName = if($first->instanceOf(Collection),
        | let coll = $first->cast(@Collection);
          if($coll.values->isNotEmpty() && $coll.values->at(0)->instanceOf(FunctionInvocation),
              | $coll.values->at(0)->cast(@FunctionInvocation).functionName->toOne(),
              | ''
          );,
        | ''
    );
    $innerName == 'funcColSpec2' || $innerName == 'aggColSpec2';
}

// ============================================================================
// ArrowInvocation compilation (same as FunctionInvocation but preserves type)
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileArrowInvocation(arrow:meta::pure::protocol::grammar::valuespecification::ArrowInvocation[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:CompilerContext[1], scope:VariableExpression[*]):ValueCompileResult[1]
{
    // Structural compilation only — function resolution happens in pass 3
    let paramsCompilation = $arrow.parametersValues->map(p | $p->compileValueSpecification($ctx, $scope));
    let errorContexts = $paramsCompilation.context->filter(c | $c.errors->size() > $ctx.errors->size());
    if($errorContexts->isNotEmpty(),
        | ^ValueCompileResult(values = [], openVariables = [], context = $errorContexts->at($errorContexts->size() - 1)),
        | let paramValues = $paramsCompilation.values;
          let openVars = $paramsCompilation.openVariables->removeDuplicatesBy({ov| $ov.name->toOne()});
          ^ValueCompileResult(
              values = [^ArrowInvocation(
                  functionName = $arrow.functionName,
                  parametersValues = $paramValues->cast(@ValueSpecification),
                  genericType = ^CompilerNotSetGenericType(),
                  multiplicity = PureOne,
                  sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
              )],
              openVariables = $openVars
          );
    );
}

// ============================================================================
// DotApplication compilation (pass 2 — structural only, resolution in pass 3)
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileDotApplication(dot:meta::pure::protocol::grammar::valuespecification::DotApplication[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:CompilerContext[1], scope:VariableExpression[*]):ValueCompileResult[1]
{
    let paramResults = $dot.parametersValues->map(p | $p->compileValueSpecification($ctx, $scope));
    let compiledParams = $paramResults->filter(r | $r.values->isNotEmpty())->map(r | $r.values->at(0))->cast(@ValueSpecification)->list();
    let newErrors = $paramResults.context->map(ec | $ec.errors)->filter(e | !$ctx.errors->contains($e));
    let updatedCtx = if($newErrors->isNotEmpty(), | ^$ctx(errors += $newErrors), | $ctx);

    ^ValueCompileResult(
        values = [^DotApplication(
            functionName = $dot.functionName,
            parametersValues = $compiledParams.values,
            genericType = ^CompilerNotSetGenericType(),
            multiplicity = PureOne,
            sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
        )],
        openVariables = $paramResults->map(r | $r.openVariables),
        context = $updatedCtx
    );
}

// ============================================================================
// Collection compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileCollection(c:meta::pure::protocol::grammar::valuespecification::Collection[1], ctx:CompilerContext[1], scope:VariableExpression[*]):ValueCompileResult[1]
{
    let elemResults = $c.values->map(v | $v->compileValueSpecification($ctx, $scope));
    let newErrors = $elemResults.context->map(ec | $ec.errors)->filter(e | !$ctx.errors->contains($e));
    if($newErrors->isNotEmpty(),
        | ^ValueCompileResult(values = [], openVariables = [], context = ^$ctx(errors += $newErrors)),
        | let collMult = $c.multiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();
          let collGenType = if($c.genericType->isNotEmpty(),
              | $c.genericType->toOne()->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($ctx, '', []).value->toOne(),
              | ^CompilerNotSetGenericType()
          );
          let compiledValues = $elemResults->filter(r | $r.values->isNotEmpty())->map(r | $r.values->at(0))->cast(@ValueSpecification)->list();
          ^ValueCompileResult(
              values = [^Collection(
                  values = $compiledValues.values,
                  genericType = $collGenType,
                  multiplicity = $collMult,
                  sourceInformation = compileSourceInformationWithFallback($c.p_sourceInformation, $ctx)
              )],
              openVariables = []
          );
    );
}

// ============================================================================
// GenericTypeAndMultiplicityHolder compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileGenericTypeAndMultiplicityHolder(gmh:meta::pure::protocol::grammar::valuespecification::GenericTypeAndMultiplicityHolder[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:CompilerContext[1]):ValueCompileResult[1]
{
    // Mirrors Java ValueSpecificationCompiler.compileGenericTypeAndMultiplicityHolder (lines 112-140):
    // CompilerGenericTypeAndMultiplicityHolder → bare instance (gt=null, compiler-managed, enriched later)
    // UserDefinedGenericTypeAndMultiplicityHolder → full compilation with genericType set
    if($gmh->instanceOf(meta::pure::protocol::grammar::valuespecification::CompilerGenericTypeAndMultiplicityHolder),
        | // Compiler-managed TypeHolder — bare instance with no genericType (matches Java line 118)
          let compilerCGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder);
          let holder = new($compilerCGT)->cast(@CompilerGenericTypeAndMultiplicityHolder);
          let holderWithProps = ^$holder(
              genericType = ^CompilerNotSetGenericType(),
              multiplicity = PureOne,
              sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
          );
          ^ValueCompileResult(values = [$holderWithProps], openVariables = []);,
        | // User-defined TypeHolder — compile held type (matches Java lines 120-140)
          let heldGT = if($gmh.genericType->isEmpty(), | []->cast(@GenericType), | match($gmh.genericType->toOne(), [
              g:meta::pure::protocol::grammar::type::generics::GenericTypeValue[1] | $g->compileGenericType($ctx, '', []).value->toOne(),
              u:meta::pure::protocol::grammar::type::generics::UndefinedGenericType[1] | ^UndefinedGenericType(),
              a:Any[1] | []->cast(@GenericType)
          ]));
          let heldMul = if($gmh.multiplicity->isNotEmpty(),
              | $gmh.multiplicity->toOne()->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity(),
              | []->cast(@Multiplicity)
          );
          let classifierGT = ^UserDefinedGenericType(type = UserDefinedGenericTypeAndMultiplicityHolder, typeArguments = $heldGT, multiplicityArguments = $heldMul);
          let holder = new($classifierGT)->cast(@UserDefinedGenericTypeAndMultiplicityHolder);
          let holderWithProps = ^$holder(
              genericType = $classifierGT,
              multiplicity = PureOne,
              sourceInformation = compileSourceInformationWithFallback($vs.p_sourceInformation, $ctx)
          );
          ^ValueCompileResult(values = [$holderWithProps], openVariables = []);
    );
}

// ============================================================================
// Date literal helpers
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::getGenericTypeName(gt:GenericType[1]):String[0..1]
{
    $gt->match([
        gtv:GenericTypeValue[1] |
            if($gtv.type->isEmpty(), | [],
                | $gtv.type->toOne()->match([
                    pe:PackageableElement[1] | $pe.name,
                    a:Any[1] | []
                ])
            ),
        a:Any[1] | []
    ]);
}

native function meta::pure::compiler::structural::valueSpecificationCompiler::normalizeDateString(dateStr:String[1]):String[1];

// Char-by-char unescape of Pure string-literal escape sequences. Implemented
// as a native because the chained-replace alternative is not self-host stable —
// each iteration of the Pure compiler re-compiling itself distorts the patterns
// it stores for the next iteration.
native function meta::pure::compiler::structural::valueSpecificationCompiler::unescapePureString(s:String[1]):String[1];
