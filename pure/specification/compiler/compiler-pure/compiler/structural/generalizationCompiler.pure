import platform::pure::metamodel::type::*;
import platform::pure::metamodel::type::generics::*;
import platform::pure::metamodel::relationship::*;
import platform::pure::compiler::structural::genericTypeCompiler::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::*;

function platform::pure::compiler::structural::generalizationCompiler::compileGeneralizations(protocolGeneralizations:platform::pure::protocol::grammar::relationship::Generalization[*], skeleton:Type[1], context:CompilerContext[1], packagePath:String[1], ownerContext:String[1]):CompilerListResult<Generalization>[1]
{
    let typeParams = $skeleton->match(
        [
            c : Class<Any>[1] | $c.typeParameters->cast(@TypeParameter),
            a : Any[1]        | []->cast(@TypeParameter)
        ]
    );
    // Platform fix in MetaNatives.new auto-anchors ^Generalization(...) classifier
    // at canonical GenericType_Generalization (UDPGT), matching Java's
    // GeneralizationImpl(model) ctor.
    if($protocolGeneralizations->isEmpty(),
        | ^CompilerListResult<Generalization>(
              values = [^Generalization(
                  general = ^UserDefinedGenericType(type = Any),
                  specific = $skeleton
              )],
              context = $context
          ),
        | $protocolGeneralizations->fold({g, acc |
              let gtResult = $g.general->cast(@platform::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($acc.context, $packagePath, $typeParams, 'super type', $ownerContext);
              ^$acc(
                  values += ^Generalization(
                      general = $gtResult.value->toOne(),
                      specific = $skeleton
                  ),
                  context = $gtResult.context
              );
          }, ^CompilerListResult<Generalization>(context = $context))
    );
}
