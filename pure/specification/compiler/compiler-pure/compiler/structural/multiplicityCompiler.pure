import platform::pure::metamodel::multiplicity::*;
import platform::pure::compiler::structural::multiplicityCompiler::*;
import platform::pure::compiler::helper::genericType::*;

function platform::pure::compiler::structural::multiplicityCompiler::compileMultiplicity(m:platform::pure::protocol::grammar::multiplicity::Multiplicity_Protocol[1]):Multiplicity[1]
{
    $m->match([
        mp:platform::pure::protocol::grammar::multiplicity::MultiplicityParameter[1] |
            buildUserDefinedMultiplicityParameter($mp.name),
        cm:platform::pure::protocol::grammar::multiplicity::ConcreteMultiplicity[1] |
            compileConcreteMultiplicity($cm),
        um:platform::pure::protocol::grammar::multiplicity::UndefinedMultiplicity[1] |
            buildUndefinedMultiplicity(),
        u:Any[1] |
            PureOne
    ]);
}

// A multiplicity as compileMultiplicity compiles it, a multiplicity parameter the one in scope of its name
// (its owner's, context.ownerMulParams) — mirrors Java MultiplicityCompiler.resolveOrCreateMultiplicityParameter.
function platform::pure::compiler::structural::multiplicityCompiler::compileMultiplicity(m:platform::pure::protocol::grammar::multiplicity::Multiplicity_Protocol[1], context:platform::pure::compiler::CompilerContext[1]):Multiplicity[1]
{
    $m->compileMultiplicity()->match([
        mp:MultiplicityParameter[1] |
            let fromOwner = $context.ownerMulParams->filter(p | $p.name == $mp.name);
            if($fromOwner->isNotEmpty(), | $fromOwner->toOne(), | $mp);,
        o:Multiplicity[1] | $o
    ]);
}

function platform::pure::compiler::structural::multiplicityCompiler::compileConcreteMultiplicity(pMult:platform::pure::protocol::grammar::multiplicity::ConcreteMultiplicity[1]):Multiplicity[1]
{
    if($pMult.upperBound->isEmpty(),
        | if($pMult.lowerBound.value == 0,
              | ZeroMany,
              | OneMany
          ),
        | let upper = $pMult.upperBound->toOne().value;
          if([pair(| $pMult.lowerBound.value == 1 && $upper == 1, | PureOne),
              pair(| $pMult.lowerBound.value == 0 && $upper == 1, | ZeroOne)],
             | buildUserDefinedAdHocMultiplicity($pMult.lowerBound.value->toOne(), $upper->toOne())
          );
    );
}
