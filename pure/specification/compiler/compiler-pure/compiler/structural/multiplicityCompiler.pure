import meta::pure::metamodel::multiplicity::*;
import meta::pure::compiler::structural::multiplicityCompiler::*;
import meta::pure::compiler::helper::genericType::*;

function meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity(m:meta::pure::protocol::grammar::multiplicity::Multiplicity_Protocol[1]):Multiplicity[1]
{
    $m->match([
        mp:meta::pure::protocol::grammar::multiplicity::MultiplicityParameter[1] |
            buildUserDefinedMultiplicityParameter($mp.name),
        cm:meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity[1] |
            compileConcreteMultiplicity($cm),
        um:meta::pure::protocol::grammar::multiplicity::UndefinedMultiplicity[1] |
            buildUndefinedMultiplicity(),
        u:Any[1] |
            PureOne
    ]);
}

function meta::pure::compiler::structural::multiplicityCompiler::compileConcreteMultiplicity(pMult:meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity[1]):Multiplicity[1]
{
    if($pMult.upperBound->isEmpty(),
        | if($pMult.lowerBound.value == 0,
              | ZeroMany,
              | OneMany
          ),
        | let upper = $pMult.upperBound->toOne().value;
          if([pair(| $pMult.lowerBound.value == 1 && $upper == 1, | PureOne),
              pair(| $pMult.lowerBound.value == 0 && $upper == 1, | ZeroOne)],
             | buildUserDefinedAdHocMultiplicity($pMult.lowerBound.value->toOne(), $upper->toOne())
          );
    );
}
