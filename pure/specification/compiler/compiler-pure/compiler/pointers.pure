// ---------------------------------------------------------------------------
// Pointer subtypes — compile-time indirection for cross-element references.
//
// The Pure compiler builds an element graph across multiple passes. Each pass
// creates new immutable element objects, so direct in-memory pointers between
// elements (e.g. FunctionExpression.func pointing at a Function) capture the
// referent's intermediate-pass state, not its final-pass state. Once pass 3
// finishes, those pointers are stale.
//
// Pointer subtypes fix this by storing a *path key into the elementMap* rather
// than an object reference. Each Pointer extends the type it indirects
// (e.g. ClassPointer extends Class), so existing m3 slot types — `func:
// Function[1]`, `rawType: Type[0..1]`, etc. — continue to type-check without
// change. Consumers resolve through the registry at read time, never see a
// stale snapshot.
//
// Each class carries the `<<meta::pure::profiles::compiler.pointer>>`
// stereotype so the compiler's `^X(...)` init-check accepts the partially
// populated `new` expressions used to construct these subtypes.
//
// Categorised by what's needed to resolve:
//   * single-path  : { path }                                  → look up in elementMap
//   * owner+name   : { ownerPath, name }                       → owner.member
//   * profile+name : { profilePath, name }                     → profile.stereotype/tag
//   * enum+name    : { enumerationPath, name }                 → enumeration.value
// ---------------------------------------------------------------------------

// ============================================================================
// Callable references — Function family
// ============================================================================

Class <<meta::pure::profiles::compiler.pointer>>
    meta::pure::compiler::pointer::FunctionPointer<T>
    extends meta::pure::metamodel::function::Function<T>
{
    path: String[1];
}

Class <<meta::pure::profiles::compiler.pointer>>
    meta::pure::compiler::pointer::PropertyPointer<U, V|m>
    extends meta::pure::metamodel::function::property::Property<U, V|m>
{
    ownerPath: String[1];
    name: String[1];
}

Class <<meta::pure::profiles::compiler.pointer>>
    meta::pure::compiler::pointer::QualifiedPropertyPointer<T>
    extends meta::pure::metamodel::function::property::QualifiedProperty<T>
{
    ownerPath: String[1];
    name: String[1];
}

Class <<meta::pure::profiles::compiler.pointer>>
    meta::pure::compiler::pointer::ColumnPointer<U, V|m>
    extends meta::pure::metamodel::relation::Column<U, V|m>
{
    ownerPath: String[1];
    name: String[1];
}

