import meta::pure::compiler::helper::packageableElement::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::multiplicity::*;

Class meta::pure::compiler::DebugState
{
    debug : Boolean[1];
    space : String[1];
}

function meta::pure::compiler::debug(context:CompilerContext[1], fn:FunctionDefinition<{->String[1]}>[1]):Any[*]
{
    if($context.debugState.debug,
        | println($context.debugState.space + $fn->eval()),
        | []
    );
}

// Skip the context rebuild when debug is off — both functions ran 80K+ times
// per self-host even when debug was disabled, costing 0.7s of profiler self-time
// for an unused string concat. Returning $context unchanged keeps the nesting
// chain a no-op for non-debug runs.
function meta::pure::compiler::debugSpaceInc(context:CompilerContext[1]):CompilerContext[1]
{
    if(!$context.debugState.debug,
        | $context,
        | let ds = $context.debugState;
          let newDs = ^$ds(space = $ds.space + '\t');
          ^$context(debugState = $newDs);
    );
}

function meta::pure::compiler::debugSpaceDec(context:CompilerContext[1]):CompilerContext[1]
{
    if(!$context.debugState.debug,
        | $context,
        | let ds = $context.debugState;
          let newDs = ^$ds(space = $ds.space->substring(1));
          ^$context(debugState = $newDs);
    );
}

Class meta::pure::compiler::CompilerContext
{
    debugState : DebugState[1];
    sourceId : String[0..1];
    imports : String[*];
    elementMap : Map<String, PackageableElement>[1];
    // Index of locally-compiled PackageableFunctions by simple name. Populated
    // once between pass 2 and pass 3 by buildLocalFunctionIndex (elementMap is
    // read-only across pass 3). Replaces the O(elementMap.size()) walk inside
    // findAllFunctionsByNameAndArityUnfiltered (180us/call × 13K calls = 2.4s
    // of self-host time before this index existed). Empty during pass 1/2; the
    // unfiltered lookup falls back to walking elementMap.values() when empty.
    localFunctionIndex : Map<String, List<PackageableFunction<Any>>>[1];
    // C3 linearization cache keyed by PackageableElement path. Built once between
    // pass 2 and pass 3 by {@link buildLinearizationCache} from elementMap +
    // ancestors reachable through generalizations. Looked up by {@code linearize}
    // — non-PE types and any path not in the cache fall back to walking, with the
    // miss reported via println so coverage gaps are visible.
    linearizationCache : Map<String, List<String>>[1];
    errors : String[*];
    scopeTypeParams : String[*];
    scopeMulParams : String[*];
    ownerTypeParams : TypeParameter[*];
    ownerMulParams : MultiplicityParameter[*];
    enclosingOwnerBinding : EnclosingOwnerParametersBinding[0..1];
    // Cumulative compilation telemetry. inferenceRollbacks is bumped centrally
    // in rollbackErrors plus at two explicit sites in resolveFunctionApplication
    // (pre-resolve always, failed-candidate backtrack). candidateEvaluations
    // is bumped at the single-candidate path and per candidate in the
    // multi-candidate fold. Per-site breakdowns below let us diagnose where
    // counts diverge from the Java compiler.
    inferenceRollbacks : Integer[1];
    candidateEvaluations : Integer[1];

    // Diagnostic: per-call-site rollback counts, keyed by tag matching Java's
    // FunctionApplicationResolver.<method>:<line> form so a Java-vs-Pure histogram
    // diff is callable without renaming.
    rollbackSites : Map<String, Integer>[1];

    // Per-element timing collected across pass 2 and pass 3. Each element compile
    // appends an ElementStatistics with wall time (millis) and the rollback /
    // candidate deltas for that element. compile() aggregates entries with the
    // same elementPath across passes when building the final summary.
    elementStatistics : ElementStatistics[*];

    // Memoizes lambda body resolution outcomes by (sourceInfo, paramShape, openVar-types).
    // The cached value is a CachedLambdaOutcome — the resolved AtomicValue plus any errors
    // that fired during body resolution. On a hit we return the AV and replay the errors
    // so callers (multi-candidate fold, fixpoint retries) see the same context delta they
    // would from a fresh walk.
    lambdaResolutionCache : Map<String, CachedLambdaOutcome>[1];

    // Memoizes the early-exit gate of resolveAtomicValue's lambda branch — i.e. visits
    // where the lambda's params aren't concrete and we addError + return AV unchanged.
    // Membership is O(1); the value is unused (Boolean true sentinel).
    lambdaFailureCache : Map<String, Boolean>[1];

    // Reverse reference index: target_path -> set of caller_paths. Mirrors Java
    // CompilationContext.referencedBy. Populated as a side-effect of element
    // resolution and explicit hook sites (annotation compiler, function-app /
    // dot-app resolvers). Sub-element granularity on both sides — targets like
    // {@code Foo.bar}, {@code MyEnum.VAL}, {@code Profile.flag}; callers
    // refined via {@code withCallerSubElement} (e.g. {@code Class.id} for a
    // ref made inside property "id").
    // Pure's {@code Map} is single-value, so callers are accumulated in
    // {@code List<String>} per target; downstream printers dedup + sort.
    referencedBy : Map<String, List<String>>[1];

    // Sub-element-aware caller path. Set by {@code setCurrentElement} once per
    // element compile (pass 2 and pass 3), pushed/popped by
    // {@code withCallerSubElement} when descending into properties / qualified
    // properties / constraints / enum values. Read by {@code recordReference}
    // to attribute the recorded reference to the current caller.
    currentElementPath : String[0..1];

    // Stack of GenericTypes for every enclosing `^X(...)` whose key
    // expressions we are currently resolving. Pushed before walking the
    // KeyExpression collection of `new`/`copy`, popped after. Read by the
    // VariableExpression resolver when the name is a parent reference
    // (`~`, `~.~`, …) to assign the construction's type to that variable
    // — mirrors {@code PureLanguageCompilerContext.constructionTypeStack} in
    // the Java compiler. Top-of-stack = innermost construction (depth 0).
    constructionTypeStack : meta::pure::metamodel::type::generics::GenericType[*];
}

Class meta::pure::compiler::CachedLambdaOutcome
{
    av : meta::pure::metamodel::valuespecification::AtomicValue[1];
    errorsFired : String[*];
    // Reverse-index edges added during the lambda body's resolution.
    // Replayed when the cache hits so cache-hit lambdas contribute the
    // same recording-density as the original (uncached) resolution.
    // Without this, every cache-hit lambda body silently drops its
    // type-lookup recordings — which leaves a ~50KB gap vs Java's
    // RecordingMetadataAccess.getElement-on-every-call behaviour.
    recordingsDelta : Pair<String, List<String>>[*];
}

// Build a minimal CompilerContext with no source state — used by helper-module
// unit tests that don't run a real compile but still need a context to thread
// through ctx-taking helpers like {@code subtypeOf} / {@code linearize}.
function meta::pure::compiler::newPlainCompilerContext():CompilerContext[1]
{
    let plain = ^CompilerContext(
        debugState = ^DebugState(debug=false, space=''),
        imports=[],
        elementMap=newMap([]->cast(@Pair<String, PackageableElement>)),
        localFunctionIndex=newMap([]->cast(@Pair<String, List<PackageableFunction<Any>>>)),
        linearizationCache=newMap([]->cast(@Pair<String, List<String>>)),
        lambdaResolutionCache=newMap([]->cast(@Pair<String, CachedLambdaOutcome>)),
        lambdaFailureCache=newMap([]->cast(@Pair<String, Boolean>)),
        inferenceRollbacks=0,
        candidateEvaluations=0,
        rollbackSites=newMap([]->cast(@Pair<String, Integer>)),
        referencedBy=newMap([]->cast(@Pair<String, List<String>>))
    );
    // Seed the cache with universe types so {@code linearize} can be called
    //   straight away — every helper-test that constructs a plain context
    //   relies on this for hits on built-ins like Integer/Number/Any.
    $plain->buildLinearizationCache();
}

function meta::pure::compiler::errorCheckpoint(context:CompilerContext[1]):Integer[1]
{
    $context.errors->size();
}

function meta::pure::compiler::rollbackErrors(context:CompilerContext[1], checkpoint:Integer[1], site:String[1]):CompilerContext[1]
{
    // Mirrors Java CompilationContext.rollbackErrorsTo: bump inferenceRollbacks
    // alongside the error-stack truncation so the Pure compiler's telemetry
    // tracks the same speculative-compile-discarded count as the Java bootstrap.
    // The {@code site} tag is bucketed into rollbackSites so per-call-site
    // counts can be diffed against Java's StackWalker-derived histogram.
    let prev = $context.rollbackSites->get($site);
    let newCount = if($prev->isEmpty(), | 1, | $prev->toOne() + 1);
    ^$context(
        errors = $context.errors->take($checkpoint),
        inferenceRollbacks = $context.inferenceRollbacks + 1,
        rollbackSites = $context.rollbackSites->put($site, $newCount)
    );
}

// Bump-only variant for the two direct-bump sites in resolveFunctionApplication
// (multi-candidate pre-resolve, candidate-failed) where the error stack is
// either separately rolled back or doesn't need truncation.
function meta::pure::compiler::bumpRollbackSite(context:CompilerContext[1], site:String[1]):CompilerContext[1]
{
    let prev = $context.rollbackSites->get($site);
    let newCount = if($prev->isEmpty(), | 1, | $prev->toOne() + 1);
    ^$context(
        inferenceRollbacks = $context.inferenceRollbacks + 1,
        rollbackSites = $context.rollbackSites->put($site, $newCount)
    );
}

// ============================================================================
// Reverse reference index — mirrors Java CompilationContext.recordReference /
// recordFunctionReference / withCallerSubElement / setCurrentElement.
// ============================================================================

// Set the caller for subsequent records. Called once per element-compile at
// the top of pass 2 and pass 3 dispatch. Returns the context with
// {@code currentElementPath} set; callers should restore the prior path on
// completion (mirrors Java's try/finally).
function meta::pure::compiler::setCurrentElement(context:CompilerContext[1], path:String[1]):CompilerContext[1]
{
    ^$context(currentElementPath = $path);
}

// Clear the current element path. Pair with {@code setCurrentElement} after
// each element finishes its pass 2 / pass 3 work.
function meta::pure::compiler::clearCurrentElement(context:CompilerContext[1]):CompilerContext[1]
{
    ^$context(currentElementPath = []);
}

// Record a reference: target_path -> currentElementPath. Filters out
// self-loops, callers with no path set, and noise (anything under
// {@code meta::pure::metamodel::}). Mirrors Java
// {@link CompilationContext#recordReference}.
function meta::pure::compiler::recordReference(context:CompilerContext[1], targetPath:String[1]):CompilerContext[1]
{
    if($context.currentElementPath->isEmpty()
            || $targetPath == $context.currentElementPath->toOne()
            || $targetPath->startsWith('meta::pure::metamodel::'),
        | $context,
        | let caller = $context.currentElementPath->toOne();
          let existing = $context.referencedBy->get($targetPath);
          let callers = if($existing->isEmpty(),
              | ^List<String>(values = [$caller]),
              | if($existing->toOne().values->contains($caller),
                  | $existing->toOne(),
                  | ^List<String>(values = $existing->toOne().values->concatenate($caller))
              )
          );
          ^$context(referencedBy = $context.referencedBy->put($targetPath, $callers));
    );
}

// Record a reference to a function. Dispatches by function flavour to produce
// the appropriate target path — property-functions use {@code Owner.name},
// and packageable functions use {@code elementToPath}. Mirrors Java
// {@link CompilationContext#recordFunctionReference}.
function meta::pure::compiler::recordFunctionReference(context:CompilerContext[1], fn:Function<Any>[1]):CompilerContext[1]
{
    if($fn->instanceOf(meta::pure::metamodel::function::property::AbstractProperty),
        | let prop = $fn->cast(@meta::pure::metamodel::function::property::AbstractProperty<Any>);
          let owner = $prop.owner;
          if($owner->isEmpty(),
              | $context,
              | let ownerPath = $owner->toOne()->cast(@PackageableElement)->elementToPath();
                $context->recordReference($ownerPath + '.' + $prop.name->toOne());
          );,
        | if($fn->instanceOf(PackageableElement),
              | $context->recordReference($fn->cast(@PackageableElement)->elementToPath()),
              | $context
          )
    );
}

// Push a sub-element name onto the caller path for the duration of an action.
// Pure has no Java-style try/finally — callers thread the modified context
// through their action and reset {@code currentElementPath} on return. The
// caller funcion takes (ctxWithSub) -> Pair<resultValue, newCtx> and returns
// Pair<resultValue, ctxWithRestoredCaller>.
//
// Used in element handlers to refine the caller from e.g. {@code Foo} to
// {@code Foo.bar} when descending into property/QP/constraint/enum-value
// compilation. Mirrors Java
// {@link CompilationContext#withCallerSubElement}.
function meta::pure::compiler::withCallerSubElement<T>(context:CompilerContext[1], subName:String[1], action:Function<{CompilerContext[1] -> CompilerResult<T>[1]}>[1]):CompilerResult<T>[1]
{
    let saved = $context.currentElementPath;
    let pushed = if($saved->isEmpty(),
        | $context,
        | ^$context(currentElementPath = $saved->toOne() + '.' + $subName)
    );
    let result = $action->eval($pushed);
    let innerCtx = $result.context;
    let restoredCtx = ^$innerCtx(currentElementPath = $saved);
    ^$result(context = $restoredCtx);
}

function meta::pure::compiler::snapshotErrors(context:CompilerContext[1], checkpoint:Integer[1]):String[*]
{
    $context.errors->drop($checkpoint);
}

Class meta::pure::compiler::ElementStatistics
{
    elementPath : String[1];
    elementType : String[1];
    totalMillis : Integer[1];
    inferenceRollbacks : Integer[1];
    candidateEvaluations : Integer[1];
}

Class meta::pure::compiler::CompilationStatistics
{
    totalMillis : Integer[1];
    parsingMillis : Integer[1];
    firstPassMillis : Integer[1];
    secondPassMillis : Integer[1];
    thirdPassMillis : Integer[1];
    elementCount : Integer[1];
    sourceFileCount : Integer[1];
    inferenceRollbackCount : Integer[1];
    candidateEvaluationCount : Integer[1];
    elementStatistics : ElementStatistics[*];
    rollbackSites : Map<String, Integer>[1];
}

Class meta::pure::compiler::CompilationResult
{
    elements : PackageableElement[*];
    errors : String[*];
    statistics : CompilationStatistics[0..1];
    context : CompilerContext[0..1];
}

Class meta::pure::compiler::CompilerResult<T>
{
    value : T[0..1];
    context : CompilerContext[1];
}

Class meta::pure::compiler::CompilerListResult<T>
{
    values : T[*];
    context : CompilerContext[1];
}

native function meta::pure::compiler::findFunctionsByNameAndArity(name:String[1], arity:Integer[1]):PackageableFunction<Any>[*];

// Enumerates every Type-typed PackageableElement across all loaded modules.
// Backed by a native that walks {@code TruffleMetadataAccess.elementPaths()},
// the union of every module's path index. Used by {@link buildLinearizationCache}
// to populate the universe-side of the cache without relying on package-tree
// traversal (which is split per module — walking {@code Package.children}
// from a single Root only reaches one module's contributions).
native function meta::pure::compiler::findAllTypes():Type[*];

function meta::pure::compiler::isElementVisible(context:CompilerContext[1], elementPath:String[1]):Boolean[1]
{
    if(!$elementPath->contains('::'),
        | true,
        | // Extract package path: everything before the last '::'
          let parts = $elementPath->split('::');
          let pkgPath = $parts->init()->joinStrings('::');
          $context.imports->exists(imp | $imp == $pkgPath);
    );
}

function meta::pure::compiler::findAllFunctionsByNameAndArity(context:CompilerContext[1], name:String[1], arity:Integer[1]):PackageableFunction<Any>[*]
{
    // Handle qualified names like 'test::if' — strip package for lookup, filter by prefix (like Java findCandidates)
    let isQualified = $name->contains('::');
    let lookupName = if($isQualified, | $name->split('::')->last()->toOne(), | $name);
    let all = findAllFunctionsByNameAndArityUnfiltered($context, $lookupName, $arity);
    if($isQualified,
        | let parts = $name->split('::');
          let prefix = $parts->init()->joinStrings('::');
          $all->filter(f | $f->elementToPath()->startsWith($prefix + '::'));,
        | $all->filter(f | $context->isElementVisible($f->elementToPath()))
    );
}

/**
 * Walk elementMap once and group {@link PackageableFunction}s by
 * {@code functionName}. Call between pass 2 and pass 3 (elementMap is
 * read-only across pass 3, so the index stays valid for all
 * {@link findAllFunctionsByNameAndArityUnfiltered} lookups in that
 * pass).
 */
/**
 * Walk every Type-typed element reachable from {@code elementMap} (source
 * types) and from the universe Root (built-ins like {@code Any}, {@code Number},
 * {@code Function} that live in the base PDB). For each PackageableElement Type,
 * compute its C3 linearization once and store the path list in
 * {@code linearizationCache}. Call between pass 2 and pass 3 — elementMap is
 * read-only across pass 3, so the cached lists stay valid for every
 * {@code linearize(t, ctx)} lookup that pass makes.
 *
 * Source types built during pass 1 use FRESH {@code Package} instances that
 * aren't connected to the universe Root, so we can't reach the built-ins by
 * walking up from a source type. We anchor the universe walk via
 * {@code lenientPathToElement} on a known canonical element.
 */
function meta::pure::compiler::buildLinearizationCache(context:CompilerContext[1]):CompilerContext[1]
{
    let sourceTypes = $context.elementMap->values()
        ->filter(e | $e->instanceOf(Type))
        ->cast(@Type)
        ->filter(t | $t->instanceOf(PackageableElement));
    // Universe types come from every loaded module via {@link findAllTypes} —
    //   the native enumerates {@code elementPaths()} across all modules and
    //   resolves each through the composite resolver. Bypasses package-tree
    //   traversal (which would only reach one module's children at a time;
    //   tried it with a {@code MergedPackage} resolver overlay and it still
    //   missed cross-module entries on the Java bootstrap path because that
    //   side has no merge step).
    let universeTypes = findAllTypes()->filter(t | $t->instanceOf(PackageableElement));
    let allTypes = $sourceTypes->concatenate($universeTypes)
        ->removeDuplicatesBy(t | $t->cast(@PackageableElement)->elementToPath());
    // Compute each type's linearization via the no-cache walk
    //   ({@code linearize(t, resolve, ctx)} with identity resolve), then store
    //   it as paths. The 1-arg overload is what hot callers use; it consults
    //   this map.
    let entries = $allTypes->map(t |
        let path = $t->cast(@PackageableElement)->elementToPath();
        let lin = $t->meta::pure::compiler::helper::type::linearizeWalk($context);
        pair($path, ^List<String>(values = $lin));
    );
    ^$context(linearizationCache = newMap($entries));
}

function meta::pure::compiler::buildLocalFunctionIndex(context:CompilerContext[1]):CompilerContext[1]
{
    let funcs = $context.elementMap->values()
        ->filter(e | $e->instanceOf(PackageableFunction))
        ->cast(@PackageableFunction<Any>)
        ->filter(f | $f.functionName->isNotEmpty());
    let pairs = $funcs->map(f | pair($f.functionName->toOne(), $f));
    // Group by name. Pure's `Map<K, V>` uses single-value put, so we accumulate
    // List<V> per key explicitly. Each key's list grows in elementMap iteration
    // order — we don't rely on inner order downstream (the arity filter is
    // applied at lookup time).
    let index = $pairs->fold({p, m |
        let existing = $m->get($p.first);
        let updated = if($existing->isEmpty(),
            | ^List<PackageableFunction<Any>>(values = [$p.second]),
            | ^List<PackageableFunction<Any>>(values = $existing->toOne().values->concatenate($p.second))
        );
        $m->put($p.first, $updated);
    }, newMap([]->cast(@Pair<String, List<PackageableFunction<Any>>>)));
    ^$context(localFunctionIndex = $index);
}

function meta::pure::compiler::findAllFunctionsByNameAndArityUnfiltered(context:CompilerContext[1], name:String[1], arity:Integer[1]):PackageableFunction<Any>[*]
{
    // Union: native index (base PDB functions, indexed by short name in
    //   {@code TruffleModuleRegistry.pathsByFunctionName}) + locally-defined
    //   functions from {@code localFunctionIndex} (built between pass 1 and
    //   pass 2 by {@link buildLocalFunctionIndex}). Both are O(1) lookups
    //   keyed by short name; no scan of {@code elementMap} or
    //   {@code elementPaths} happens on the hot path.
    let nativeCandidates = findFunctionsByNameAndArity($name, $arity);
    let indexedByName = $context.localFunctionIndex->get($name);
    let localCandidates = if($indexedByName->isEmpty(),
        | []->cast(@PackageableFunction<Any>),
        | $indexedByName->toOne().values->filter(f | $f.parameters->size() == $arity)
    );
    // Self-hosting: when the same fully qualified path appears in both the
    // base PDB and the current source, prefer the local definition. Without
    // this, recompiling a module against a base PDB that already contains
    // that module's functions yields AMBIGUOUS errors at every call site
    // (two candidates with identical signatures).
    let localPaths = $localCandidates->map(f | $f->elementToPath());
    let nativeFiltered = $nativeCandidates->filter(f | !$localPaths->contains($f->elementToPath()));
    // Belt-and-braces dedupe-by-path on the merged list — collapses any
    // duplicates with identical paths from either side.
    $nativeFiltered->concatenate($localCandidates)->removeDuplicatesBy(f | $f->elementToPath());
}

// Path → element using the freshest known version. The native
// `lenientPathToElement` walks the Package tree, which is frozen at the
// pass-1 skeleton state for local-module elements (pass 2 / pass 3 only
// update elementMap, not Package.children). So *always* check elementMap
// first; only fall through to the package-tree walk for elements that were
// never put into elementMap (i.e. base PDB universe types).
function meta::pure::compiler::pathToElementInContext(context:CompilerContext[1], path:String[1]):PackageableElement[0..1]
{
    firstNonEmpty([
        | $context.elementMap->get($path),
        | $path->lenientPathToElement()
    ])->head();
}

// Two-branch lookup:
//   1. Try the path as-given via `pathToElementInContext` (covers FQ paths;
//      with a short name this misses since elementMap keys are FQ and the
//      package tree has no top-level "Class"/"Number"/etc.).
//   2. For short names, qualify with each import in turn and try again.
//
// What we used to do but don't anymore:
//   * Suffix-match across all elementMap keys ending in "::Class" — that
//     bypassed scoping (returned a Java-metamodel `Class` even when the file
//     didn't import it) and tie-broke arbitrarily on map iteration order.
//     The correct lookup goes through imports.
//   * Hard-coded `meta::pure::metamodel::type::` fallback — already handled
//     by the imports loop since `defaultFileImports()` includes that package.
// Look up an element by short or fully-qualified path. Returns
// {@link PackageableElement} when found, empty when not.
//
// Does NOT record into the reverse index — for callsites that need recording
// (the vast majority during compilation), prefer {@code resolveElementR},
// which mirrors Java's {@code RecordingMetadataAccess.getElement} behaviour.
function meta::pure::compiler::resolveElement(context:CompilerContext[1], path:String[1]):PackageableElement[0..1]
{
    firstNonEmpty([
        | $context->pathToElementInContext($path),
        | $context.imports
              ->map(imp | $context->pathToElementInContext($imp + '::' + $path))
              ->filter(e | $e->isNotEmpty())
              ->head()
    ])->head();
}

// Recording variant of {@link resolveElement}: returns a {@link CompilerResult}
// whose {@code context} has the lookup recorded in the reverse reference
// index (filtered through the same noise rules as
// {@link recordReference} — {@code meta::pure::metamodel::} entries are
// skipped, self-references collapsed). Mirrors Java's
// {@code RecordingMetadataAccess.getElement}: every cross-element lookup
// during compilation becomes a {@code (target -> caller)} edge.
//
// Call this from compile-time call sites (handlers, resolvers, helpers
// that thread context). Use {@link resolveElement} when context cannot
// be threaded (e.g. pure read-only helpers invoked at runtime).
function meta::pure::compiler::resolveElementR(context:CompilerContext[1], path:String[1]):CompilerResult<PackageableElement>[1]
{
    let element = $context->resolveElement($path);
    let recordedCtx = if($element->isEmpty(),
        | $context,
        | $context->recordReference($element->toOne()->elementToPath())
    );
    ^CompilerResult<PackageableElement>(value = $element, context = $recordedCtx);
}

function meta::pure::compiler::resolveAllElements(context:CompilerContext[1], path:String[1]):String[*]
{
    // Mirrors Java _PackageableElement.findElementOrReportError (lines 95-98):
    // ambiguity is reported only when MULTIPLE IMPORTED packages define the
    // same short name. We must NOT include arbitrary same-short-name elements
    // from elsewhere in the source tree — that would falsely flag e.g.
    // `Enumeration` as ambiguous between `meta::pure::metamodel::type::Enumeration`
    // (the only one in scope via imports) and
    // `meta::external::language::java::metamodel::Enumeration` (a peer package
    // present in the source tree but not imported by the file under
    // compilation).
    if($context.elementMap->get($path)->isNotEmpty(),
        | [$path],
        | if($path->contains('::'),
            | if($context->pathToElementInContext($path)->isNotEmpty(), | [$path], | []),
            | $context.imports
                  ->map(imp | $imp + '::' + $path)
                  ->filter(candidate | $context->pathToElementInContext($candidate)->isNotEmpty())
                  ->removeDuplicates();
        )
    );
}
