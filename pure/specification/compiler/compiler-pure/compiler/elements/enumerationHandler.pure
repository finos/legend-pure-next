import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::annotationCompiler::*;
import meta::pure::compiler::helper::pointer::*;
import meta::pure::compiler::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::relationship::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::function::property::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::metamodel::extension::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::functions::lang::*;

// Pass-1 enumeration skeleton constructor used by compile-pure in lieu of the
// {@code newEnumeration} native. The native embeds direct PDO refs to the
// freshly-created enumeration into every property's classifierGenericType /
// owner / lambda body — those refs become stale when pass 2 rebuilds the
// enumeration via {@code ^$skeleton(...)} (a new PDO is emitted; the pass-1
// refs are orphaned). PointerGraphResolver at module construction can't
// canonicalise direct refs, only TempCompilerPointers — so we build the
// skeleton with {@link EnumerationPointer} for every self-reference. The
// pointer carries only the path; at module construction the resolver swaps
// it for the byPath winner, regardless of which pass emitted the live
// enumeration.
function meta::pure::compiler::elements::buildEnumerationSkeleton(name:String[1], pkg:meta::pure::metamodel::Package[1], valueNames:String[*]):Enumeration<Any>[1]
{
    // Step 1 — enumeration shell. Path-affecting slots (name, package) are
    // set now so {@code elementToPath} on the next line returns the canonical
    // path the pointer will carry. Package is wrapped as PackagePointer because
    // each {@code putElementUnderPackage} rebuilds the parent Package, so a
    // direct ref captured at skeleton creation goes stale as siblings land.
    let shell = ^Enumeration<Any>(name = $name, package = $pkg->toPackagePointer()->cast(@meta::pure::metamodel::Package));
    let enumPtr = $shell->toEnumerationPointer();

    // Step 2 — self-referencing classifierGenericType: Enumeration<self>.
    // The `<self>` slot uses the pointer, NOT the live shell — that's the
    // whole point of this helper.
    let selfRef = ^UserDefinedGenericType(type = $enumPtr->cast(@Type));
    let cgt = ^UserDefinedGenericType(type = Enumeration, typeArguments = [$selfRef]);

    // Step 3 — every user enumeration extends Enum. {@code specific} is the
    // Type, not the GenericType — anchor via the pointer so the same byPath
    // canonicalisation applies.
    let gen = ^Generalization(
        general = ^UserDefinedGenericType(type = Enum),
        specific = $enumPtr->cast(@Type)
    );

    // Step 4 — enum's value GenericType (Property.genericType, Enum.classifierGenericType,
    // lambda body's AtomicValue.genericType, FunctionType.returnType). Pointer-anchored
    // so all four slots converge on the byPath winner.
    let enumGT = ^UserDefinedGenericType(type = $enumPtr->cast(@Type));

    // Step 5 — one Property per value, each carrying a default-value lambda
    // that returns the matching Enum instance.
    let properties = $valueNames->map(valueName |
        let enumInstance = ^Enum(name = $valueName, classifierGenericType = $enumGT);
        let ft = ^FunctionType(returnType = $enumGT, returnMultiplicity = PureOne);
        let ftGT = ^InferredGenericType(type = $ft);
        let lambdaCGT = ^InferredGenericType(type = LambdaFunction, typeArguments = [$ftGT]);
        let atomicValue = ^AtomicValue(
            value = $enumInstance,
            genericType = $enumGT,
            multiplicity = PureOne
        );
        let lambda = ^LambdaFunction<Any>(
            classifierGenericType = $lambdaCGT,
            expressionSequence = [$atomicValue]
        );
        let propCGT = ^UserDefinedGenericType(
            type = Property,
            typeArguments = [$cgt, $enumGT],
            multiplicityArguments = [PureOne]
        );
        ^Property<Nil, Any|*>(
            name = $valueName,
            classifierGenericType = $propCGT,
            genericType = $enumGT,
            multiplicity = PureOne,
            owner = $enumPtr,
            aggregation = AggregationKind.None,
            defaultValue = $lambda
        );
    );

    ^$shell(
        classifierGenericType = $cgt,
        generalizations = [$gen],
        properties = $properties
    );
}

function meta::pure::compiler::elements::compileEnumeration(protocolEnum:meta::pure::protocol::grammar::type::Enumeration[1], context:CompilerContext[1]):CompilerResult<Enumeration<Any>>[1]
{
    let packagePath = $protocolEnum.package->toOne().value;
    let enumName = $packagePath + '::' + $protocolEnum.name;
    let skeleton = $context->resolveElement($enumName)->toOne()->cast(@Enumeration<Any>);

    let ownerCtx = 'enumeration \'' + $enumName + '\'';
    let siCtx = meta::pure::compiler::structural::sourceInformationCompiler::formatSourceInfo($protocolEnum->cast(@meta::pure::protocol::grammar::type::Any).p_sourceInformation, $context);

    // Check for duplicate enum value names
    let dupNames = $protocolEnum.properties->map(p | $p.name)->filter(n | $protocolEnum.properties->filter(p | $p.name == $n)->size() > 1)->removeDuplicates();
    let ctx0 = $dupNames->fold({d, c |
        ^$c(errors += 'Duplicate enum value \'' + $d + '\' in ' + $ownerCtx + $siCtx);
    }, $context);

    // Add stereotypes/taggedValues to existing enum value properties (created by newEnumeration in pass 1)
    let updatedProps = $skeleton.properties->map(prop |
        let protocolProp = $protocolEnum.properties->filter(p | $p.name == $prop.name);
        if($protocolProp->isEmpty(),
            | $prop,
            | let pp = $protocolProp->head()->toOne();
              let stereoResult = compilePropertyStereotypes($pp, $ctx0, $ownerCtx);
              let tvResult = compilePropertyTaggedValues($pp, $ctx0, $ownerCtx);
              let si = compileSourceInformation($pp.p_sourceInformation, $context);
              ^$prop(
                  stereotypes = $stereoResult.values,
                  taggedValues = $tvResult.values,
                  sourceInformation = $si
              );
        );
    );

    // Compile stereotypes and tagged values on the enumeration itself
    let stereoAccum = $protocolEnum.stereotypes->fold({s, acc |
                                compileStereotype($s, $acc, $ownerCtx);
                            }, ^CompilerListResult<Stereotype>(context = $ctx0));
    let tvAccum = $protocolEnum.taggedValues->fold({t, acc |
                                compileTaggedValue($t, $acc, $ownerCtx);
                            }, ^CompilerListResult<TaggedValue>(context = $stereoAccum.context));

    let si = compileSourceInformation($protocolEnum->cast(@meta::pure::protocol::grammar::type::Any).p_sourceInformation, $context);
    ^CompilerResult<Enumeration<Any>>(
        value = ^$skeleton(
            stereotypes = $stereoAccum.values,
            taggedValues = $tvAccum.values,
            properties = $updatedProps,
            sourceInformation = $si
        ),
        context = $tvAccum.context
    );
}

