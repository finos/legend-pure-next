import platform::pure::compiler::structural::generalizationCompiler::*;
import platform::pure::compiler::structural::constraintCompiler::*;
import platform::pure::compiler::structural::annotationCompiler::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::helper::pointer::*;
import platform::pure::compiler::*;
import platform::pure::metamodel::type::*;
import platform::pure::metamodel::type::generics::*;
import platform::pure::metamodel::valuespecification::*;
import platform::pure::metamodel::extension::*;

function platform::pure::compiler::elements::compilePrimitive(protocolPrimitive:platform::pure::protocol::grammar::type::PrimitiveType[1], context:CompilerContext[1]):CompilerResult<PrimitiveType>[1]
{
    let packagePath = if($protocolPrimitive.package->isEmpty(), | '', | $protocolPrimitive.package->toOne().value);
    let primitiveName = if($packagePath == '', | $protocolPrimitive.name, | $packagePath + '::' + $protocolPrimitive.name);
    let skeleton = $context->resolveElement($primitiveName)->toOne()->cast(@PrimitiveType);
    let ownerCtx = 'primitive type \'' + $primitiveName + '\'';

    let genAccum = compileGeneralizations($protocolPrimitive.generalizations, $skeleton, $context, $packagePath, $ownerCtx);
    let ctx1 = $genAccum.context;

    let typeVariables = if($protocolPrimitive.typeVariables->isEmpty(), | [],
        | $protocolPrimitive.typeVariables->map(tv |
            let genType = $tv.genericType->toOne()->cast(@platform::pure::protocol::grammar::type::generics::GenericTypeValue).type->toOne()->cast(@platform::pure::protocol::grammar::type::Type_Pointer).value;
            let mMult = $tv.multiplicity->toOne()->platform::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();
            ^VariableExpression(
                name = $tv.name,
                // Cross-element ref into a type being compiled — wrap as pointer.
                genericType = buildCanonicalOrUserDefinedGenericType($ctx1->resolveElement($genType)->toOne()->cast(@Type)->toTypePointer(), $ctx1),
                multiplicity = $mMult
            );
        )
    );

    // Build the compiled type with generalizations first, so constraints see the full type
    let compiledPrim = ^$skeleton(
        typeVariables = $typeVariables,
        generalizations = $genAccum.values->map(g | ^$g(specific = ~.~))
    );
    // The owner GT references the primitive being compiled — wrap as pointer.
    let ownerGenericType = buildUserDefinedGenericType($compiledPrim->toTypePointer());
    let constraintAccum = compileConstraints($protocolPrimitive.constraints, $ownerGenericType, $typeVariables, $ctx1);
    let ctx2 = $constraintAccum.context;

    // Compile stereotypes and tagged values
    let stereoAccum = $protocolPrimitive.stereotypes->fold({s, acc |
                                compileStereotype($s, $acc, $ownerCtx);
                            }, ^CompilerListResult<Stereotype>(context = $ctx2));
    let tvAccum = $protocolPrimitive.taggedValues->fold({t, acc |
                                compileTaggedValue($t, $acc, $ownerCtx);
                            }, ^CompilerListResult<TaggedValue>(context = $stereoAccum.context));
    let ctx3 = $tvAccum.context;

    ^CompilerResult<PrimitiveType>(
        value = ^$compiledPrim(
            stereotypes = $stereoAccum.values,
            taggedValues = $tvAccum.values,
            constraints = $constraintAccum.values
        ),
        context = $ctx3
    );
}
