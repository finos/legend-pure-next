import platform::pure::compiler::structural::sourceInformationCompiler::*;
import platform::pure::compiler::*;
import platform::pure::compiler::helper::genericType::*;
import platform::pure::compiler::helper::pointer::*;
import platform::pure::metamodel::*;
import platform::pure::metamodel::type::generics::*;
import platform::pure::metamodel::extension::*;
import platform::pure::functions::lang::*;

function platform::pure::compiler::elements::compileProfilePass1(pr:platform::pure::protocol::grammar::extension::Profile[1], ctx:CompilerContext[1]):CompilerContext[1]
{
    let packagePath = if($pr.package->isEmpty(), | '', | $pr.package->toOne().value);
    let prName = if($pr.package->isEmpty(), | '', | $packagePath + '::') + $pr.name;
    let pkgRes = getOrCreatePackagePath($ctx, $packagePath);
    let profileSkeletonInt = ^Profile(
        name = $pr.name,
        package = $pkgRes.value->toOne()->toPackagePointer()->cast(@platform::pure::metamodel::Package),
        p_stereotypes = $pr.p_stereotypes->map(s |
            ^Stereotype(value = $s.value, profile = ~.~);
        ),
        p_tags = $pr.p_tags->map(t |
            ^Tag(value = $t.value, profile = ~.~);
        ),
        sourceInformation = compileSourceInformation($pr.p_sourceInformation, $ctx)
    );

    // ^Profile(...) above already sets classifierGenericType to the canonical
    // GenericType_Profile UDPGT-PE via the platform new() native's
    // preferCanonicalAnchor. Don't override with a fresh inline UDGT — that
    // would lose the canonical reference and diverge from how Stereotype, Tag,
    // and other M3 elements are built (which don't override).
    putElementUnderPackage($pkgRes.context, $prName, $packagePath, $profileSkeletonInt);
}
