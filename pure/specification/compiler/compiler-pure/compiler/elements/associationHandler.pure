import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::pointer::*;
import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::qualifiedPropertyCompiler::*;
import meta::pure::compiler::structural::annotationCompiler::*;
import meta::pure::compiler::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::property::*;
import meta::pure::metamodel::relationship::*;
import meta::pure::metamodel::extension::*;
import meta::pure::functions::lang::*;

function meta::pure::compiler::elements::compileAssociation(protocolAssoc:meta::pure::protocol::grammar::relationship::Association[1], context:CompilerContext[1]):CompilerResult<Association>[1]
{
    let packagePath = $protocolAssoc.package->toOne().value;
    let assocName = $packagePath + '::' + $protocolAssoc.name;
    let skeleton = $context->resolveElement($assocName)->toOne()->cast(@Association);

    let p1Protocol = $protocolAssoc.properties->at(0);
    let p2Protocol = $protocolAssoc.properties->at(1);

    let ownerCtx = 'association \'' + $assocName + '\'';

    // Push sub-element caller path so type refs in each property's
    // genericType attribute to {@code Assoc.propName} in the reverse index.
    // Mirrors Java AssociationHandler.secondPass withCallerSubElement.
    let gt1Result = $context->withCallerSubElement($p1Protocol.name, {ctx |
        $p1Protocol.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)
            ->compileGenericType($ctx, $packagePath, [], 'property \'' + $p1Protocol.name + '\'', $ownerCtx);
    });
    let mGenType1 = $gt1Result.value->toOne();

    let gt2Result = $gt1Result.context->withCallerSubElement($p2Protocol.name, {ctx |
        $p2Protocol.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)
            ->compileGenericType($ctx, $packagePath, [], 'property \'' + $p2Protocol.name + '\'', $ownerCtx);
    });
    let mGenType2 = $gt2Result.value->toOne();

    let ctx1 = $gt2Result.context;

    if($ctx1.errors->size() > $context.errors->size(),
        | ^CompilerResult<Association>(value = $skeleton, context = $ctx1),
        | let mMult1 = meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity($p1Protocol.multiplicity);
          let mMult2 = meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity($p2Protocol.multiplicity);

          // Compile each property's stereotypes/tagged values with the caller
          // sub-element pushed (so annotation references attribute to
          // {@code Assoc.propName}) AND the recording context threaded forward.
          // Mirrors Java AssociationHandler.secondPass withCallerSubElement: the
          // Pure context is immutable, so discarding the returned context would
          // drop the recorded profile/stereotype/tag references entirely.
          let savedPath = $ctx1.currentElementPath;
          let p1Pushed = if($savedPath->isEmpty(), | $ctx1, | ^$ctx1(currentElementPath = $savedPath->toOne() + '.' + $p1Protocol.name->toOne()));
          let p1Stereo = compilePropertyStereotypes($p1Protocol, $p1Pushed, $ownerCtx);
          let p1Tag    = compilePropertyTaggedValues($p1Protocol, $p1Stereo.context, $ownerCtx);
          let p1TagCtx = $p1Tag.context;
          let ctxAfterP1Ann = ^$p1TagCtx(currentElementPath = $savedPath);
          let p2Pushed = if($savedPath->isEmpty(), | $ctxAfterP1Ann, | ^$ctxAfterP1Ann(currentElementPath = $savedPath->toOne() + '.' + $p2Protocol.name->toOne()));
          let p2Stereo = compilePropertyStereotypes($p2Protocol, $p2Pushed, $ownerCtx);
          let p2Tag    = compilePropertyTaggedValues($p2Protocol, $p2Stereo.context, $ownerCtx);
          let p2TagCtx = $p2Tag.context;
          let ctxAfterP2Ann = ^$p2TagCtx(currentElementPath = $savedPath);

          let propClassifierGT1 = ^UserDefinedGenericType(
              type = Property,
              typeArguments = [$mGenType2, $mGenType1],
              multiplicityArguments = [$mMult1]
          );
          let prop1 = new($propClassifierGT1)->cast(@Property<Nil, Any|*>);
          let builtProp1 = ^$prop1(
              name = $p1Protocol.name,
              aggregation = compileAggregationKind($p1Protocol),
              genericType = $mGenType1,
              multiplicity = $mMult1,
              stereotypes = $p1Stereo.values,
              taggedValues = $p1Tag.values,
              sourceInformation = compileSourceInformation($p1Protocol.p_sourceInformation, $context)
          );

          let propClassifierGT2 = ^UserDefinedGenericType(
              type = Property,
              typeArguments = [$mGenType1, $mGenType2],
              multiplicityArguments = [$mMult2]
          );
          let prop2 = new($propClassifierGT2)->cast(@Property<Nil, Any|*>);
          let builtProp2 = ^$prop2(
              name = $p2Protocol.name,
              aggregation = compileAggregationKind($p2Protocol),
              genericType = $mGenType2,
              multiplicity = $mMult2,
              stereotypes = $p2Stereo.values,
              taggedValues = $p2Tag.values,
              sourceInformation = compileSourceInformation($p2Protocol.p_sourceInformation, $context)
          );

          // Compile stereotypes and tagged values on the association itself —
          // thread from the property-annotation context so their recorded
          // references survive.
          let stereoAccum = $protocolAssoc.stereotypes->fold({s, acc |
                                      compileStereotype($s, $acc, $ownerCtx);
                                  }, ^CompilerListResult<Stereotype>(context = $ctxAfterP2Ann));
          let tvAccum = $protocolAssoc.taggedValues->fold({t, acc |
                                      compileTaggedValue($t, $acc, $ownerCtx);
                                  }, ^CompilerListResult<TaggedValue>(context = $stereoAccum.context));
          let ctx2 = $tvAccum.context;

          // Compile qualified properties — owner is the type of the second property
          // (the class that "owns" the first property, i.e. where QPs are accessible).
          // Deref pointer first so downstream `.name` / `.typeParameters` reads work
          // (Class_Pointer carries only path+element).
          let qpOwnerClass = $mGenType2->rawType()->meta::pure::compiler::helper::type::derefTypeIfPointer($ctx2)->toOne()->cast(@meta::pure::metamodel::type::Class<Any>);
          let qpAccum = $protocolAssoc.qualifiedProperties->fold({qp, acc |
              // Push the QP sub-element so its references attribute to
              // {@code Assoc.qpName} (mirrors Java AssociationHandler /
              // ClassHandler withCallerSubElement(qp._name())).
              let result = $acc.context->withCallerSubElement($qp.name, {ctx | $qp->compileQualifiedProperty($ctx, $packagePath, $qpOwnerClass)});
              ^$acc(values += $result.value, context = $result.context);
          }, ^CompilerListResult<QualifiedProperty<Any>>(context = $ctx2));
          let ctx3 = $qpAccum.context;

          let compiledAssoc = ^$skeleton(
              stereotypes = $stereoAccum.values,
              taggedValues = $tvAccum.values,
              properties = [
                  ^$builtProp1(owner = ~.~),
                  ^$builtProp2(owner = ~.~)
              ],
              qualifiedProperties = $qpAccum.values->map(qp | ^$qp(owner = ~.~))
          );

          // Register association properties on target classes (mirrors Java AssociationHandler.registerOnTargetClass)
          // prop1 (e.g. employees:Person[*]) goes on the class of prop2's type (e.g. Firm)
          // prop2 (e.g. employer:Firm[1]) goes on the class of prop1's type (e.g. Person)
          // Use the properties from the compiled association (they have owner set to the association)
          let registeredProp1 = $compiledAssoc.properties->at(0);
          let registeredProp2 = $compiledAssoc.properties->at(1);
          let class2Path = $mGenType2->rawType()->toOne()->cast(@PackageableElement)->elementToPath();
          let class1Path = $mGenType1->rawType()->toOne()->cast(@PackageableElement)->elementToPath();
          // Self-association (both ends point at the same class, e.g. `Package.parent`
          // / `Package.children`): apply BOTH property additions to the same instance
          // before writing back. The Java side mutates `class._propertiesFromAssociations()`
          // in place, so the two register calls naturally accumulate; the immutable
          // Pure equivalent here used to do two `put`s back-to-back, the second
          // overwriting the first and losing one property — which is what made
          // `Package.parent` errors appear in self-host that don't appear under Java.
          let isSelfAssoc = $class2Path == $class1Path;
          let ctx4 = if($isSelfAssoc,
              | let cls = $ctx3->resolveElement($class1Path)->toOne()->cast(@Class<Any>);
                let updatedCls = ^$cls(propertiesFromAssociations = $cls.propertiesFromAssociations->concatenate($registeredProp1)->concatenate($registeredProp2));
                ^$ctx3(elementMap = $ctx3.elementMap->put($class1Path, $updatedCls));,
              | let class2 = $ctx3->resolveElement($class2Path)->toOne()->cast(@Class<Any>);
                let class1 = $ctx3->resolveElement($class1Path)->toOne()->cast(@Class<Any>);
                let updatedClass2 = ^$class2(propertiesFromAssociations = $class2.propertiesFromAssociations->concatenate($registeredProp1));
                let updatedClass1 = ^$class1(propertiesFromAssociations = $class1.propertiesFromAssociations->concatenate($registeredProp2));
                ^$ctx3(elementMap = $ctx3.elementMap->put($class2Path, $updatedClass2)->put($class1Path, $updatedClass1));
          );

          ^CompilerResult<Association>(
              value = $compiledAssoc,
              context = $ctx4
          );
    );
}
