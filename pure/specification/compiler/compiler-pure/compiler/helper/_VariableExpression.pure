import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::functions::lang::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::compiler::helper::variableExpression::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::pointer::*;

function meta::pure::compiler::helper::variableExpression::newVariableExpression():VariableExpression[1]
{
    let ve = new(^InferredGenericType(type = VariableExpression))->cast(@VariableExpression);
    ^$ve(
        name = '',
        genericType = buildInferredGenericType(Any),
        multiplicity = PureOne
    );
}

function <<test.Test>> meta::pure::compiler::helper::variableExpression::tests::testNewVariableExpression():Boolean[1]
{
    let varExpr = newVariableExpression();
    assert(rawType($varExpr.classifierGenericType->toOne())->toOne() == VariableExpression);
    true;
}
