// GenericType helpers

// Helpers for constructing M3 metamodel instances. Classifier auto-derivation
// happens in MetaNatives.new (platform fix): when ^Type(...) has no type/mult
// args, the classifier is set to the canonical GenericType_<TypeName> UDPGT
// from core.pdb, matching Java's `new XxxImpl(model)` ctor pattern.
function platform::pure::compiler::helper::genericType::buildUserDefinedGenericType(rawType:Type[1]):UserDefinedGenericType[1]
{
    ^UserDefinedGenericType(type = $rawType);
}

// Canonical-anchor-aware variant of buildUserDefinedGenericType: when rawType
// is a named PackageableElement with a `GenericType_<name>` UDPGT-PE in
// core.pdb, returns that canonical anchor; otherwise returns a fresh UDGT.
// Mirrors Java GenericTypeCompiler.java's canonical-anchor swap (lines 99-117)
// for sites that build leaf UDGTs directly (e.g. typeVariable genericType).
function platform::pure::compiler::helper::genericType::buildCanonicalOrUserDefinedGenericType(rawType:Type[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[1]
{
    let fallback = buildUserDefinedGenericType($rawType)->cast(@GenericType);
    if(!$rawType->instanceOf(PackageableElement),
        | $fallback,
        | // Pointers have null `.name` — derive simple-name from `.path`. Same
          // for the equality check below: compare paths (pointer-aware) rather
          // than typeEquals which inspects internal fields and would diverge
          // between a pointer and its live target.
          let rawPath = $rawType->cast(@PackageableElement)->elementToPath();
          if($rawPath->isEmpty(),
              | $fallback,
              | // Anchor name encodes the type's full Pure path (`::` -> `_`)
                // so user modules whose simple names collide with platform
                // types don't pick up the wrong anchor.
                let canonicalPath = 'platform::pure::metamodel::type::generics::optimization::GenericType_' + $rawPath->replace('::', '_');
                let resolved = $context->resolveElement($canonicalPath);
                if($resolved->isEmpty() || !$resolved->toOne()->instanceOf(GenericTypeValue),
                    | $fallback,
                    | let canonicalGT = $resolved->toOne()->cast(@GenericTypeValue);
                      let canonicalRawPath = if($canonicalGT.type->isEmpty(),
                          | '',
                          | $canonicalGT.type->toOne()->match([
                                pe:PackageableElement[1] | $pe->elementToPath(),
                                a:Any[1] | ''
                            ])
                      );
                      if($canonicalRawPath != '' && $canonicalRawPath == $rawPath,
                          | $canonicalGT->cast(@GenericType),
                          | $fallback
                      );
                );
          );
    );
}

function platform::pure::compiler::helper::genericType::buildInferredGenericType(rawType:Type[1]):InferredGenericType[1]
{
    ^InferredGenericType(type = $rawType);
}

function platform::pure::compiler::helper::genericType::buildTypeParameter(name:String[1]):TypeParameter[1]
{
    ^TypeParameter(name = $name, contravariant = false);
}

function platform::pure::compiler::helper::genericType::buildTypeParameter(name:String[1], contravariant:Boolean[1]):TypeParameter[1]
{
    ^TypeParameter(name = $name, contravariant = $contravariant);
}

function platform::pure::compiler::helper::genericType::buildMultiplicityValue(value:Integer[1]):platform::pure::metamodel::multiplicity::MultiplicityValue[1]
{
    ^platform::pure::metamodel::multiplicity::MultiplicityValue(value = $value);
}

function platform::pure::compiler::helper::genericType::buildResolvedTypeParameter(name:String[1], value:platform::pure::metamodel::type::generics::GenericType[1], context:platform::pure::compiler::CompilerContext[1]):platform::pure::metamodel::type::generics::ResolvedTypeParameter[1]
{
    // Cross-element store: the receiving `value` slot may persist a Type ref
    // that points anywhere in the graph. When the rawType is currently being
    // compiled (`context.elementMap` holds it), wrap as a pointer so a later
    // PointerGraphResolver walk doesn't trip on a duplicate PDO produced by
    // multi-pass rebuild. Types loaded from a dep PDB (core, compiler) can't
    // duplicate — leave them direct so downstream consumers reading the raw
    // type (instanceOf, PDB writer, inference) keep working without per-site
    // deref.
    let wrapped = $value->platform::pure::compiler::helper::genericType::wrapGenericTypeWithPointer($context);
    ^platform::pure::metamodel::type::generics::ResolvedTypeParameter(name = $name, value = $wrapped);
}

// Wrap a GenericType's PE rawType (Class/Enumeration/PrimitiveType) as a pointer
// when that type is in the current compilation's element map — i.e. the
// compiler may rebuild it across passes and a direct ref to an earlier
// revision would later read as a duplicate PDO. Types absent from
// `context.elementMap` are dep-loaded (core / compiler PDB) — single canonical
// instance, no duplication risk, no wrap needed.
function platform::pure::compiler::helper::genericType::wrapGenericTypeWithPointer(gt:platform::pure::metamodel::type::generics::GenericType[1], context:platform::pure::compiler::CompilerContext[1]):platform::pure::metamodel::type::generics::GenericType[1]
{
    $gt->match([
        igt : platform::pure::metamodel::type::generics::InferredGenericType[1] |
            let currentType = $igt.type;
            if($currentType->isEmpty() || !$currentType->toOne()->platform::pure::compiler::helper::genericType::isLocallyCompiledType($context),
                | $igt,
                | let wrappedType = $currentType->toOne()->platform::pure::compiler::helper::pointer::toTypePointer();
                  if($wrappedType == $currentType->toOne(),
                      | $igt,
                      | ^$igt(type = $wrappedType)
                  );
            );,
        gtv : platform::pure::metamodel::type::generics::GenericTypeValue[1] |
            let currentType = $gtv.type;
            if($currentType->isEmpty() || !$currentType->toOne()->platform::pure::compiler::helper::genericType::isLocallyCompiledType($context),
                | $gtv,
                | let wrappedType = $currentType->toOne()->platform::pure::compiler::helper::pointer::toTypePointer();
                  if($wrappedType == $currentType->toOne(),
                      | $gtv,
                      | ^$gtv(type = $wrappedType)
                  );
            );,
        other : platform::pure::metamodel::type::generics::GenericType[1] | $gt
    ]);
}

// Returns true when `t` is in the current compilation's `elementMap` — i.e.
// it's being produced/rebuilt by this compile pass and therefore at risk of
// duplicate-PDO when persisted as a direct ref across element boundaries.
// Already-wrapped (TempCompilerPointer) and non-PE Types (FunctionType,
// RelationType, TypeParameter) short-circuit to false.
function platform::pure::compiler::helper::genericType::isLocallyCompiledType(t:platform::pure::metamodel::type::Type[1], context:platform::pure::compiler::CompilerContext[1]):Boolean[1]
{
    if($t->instanceOf(platform::pure::metamodel::pointer::TempCompilerPointer),
        | false,
        | if(!$t->instanceOf(platform::pure::metamodel::type::Class) && !$t->instanceOf(platform::pure::metamodel::type::Enumeration) && !$t->instanceOf(platform::pure::metamodel::type::PrimitiveType),
              | false,
              | let path = $t->cast(@platform::pure::metamodel::PackageableElement)->platform::pure::functions::meta::elementToPath();
                $context.elementMap->get($path)->isNotEmpty();
        );
    );
}

function platform::pure::compiler::helper::genericType::buildResolvedMultiplicityParameter(name:String[1], value:platform::pure::metamodel::multiplicity::Multiplicity[1]):platform::pure::metamodel::type::generics::ResolvedMultiplicityParameter[1]
