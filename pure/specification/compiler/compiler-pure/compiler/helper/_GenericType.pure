function platform::pure::compiler::helper::genericType::buildUserDefinedAdHocMultiplicity(lower:Integer[1], upper:Integer[1]):platform::pure::metamodel::multiplicity::UserDefinedAdHocMultiplicity[1]
{
    ^platform::pure::metamodel::multiplicity::UserDefinedAdHocMultiplicity(lowerBound = buildMultiplicityValue($lower), upperBound = buildMultiplicityValue($upper));
}

function platform::pure::compiler::helper::genericType::buildInferredAdHocMultiplicity(lower:Integer[1]):platform::pure::metamodel::multiplicity::InferredAdHocMultiplicity[1]
{
    ^platform::pure::metamodel::multiplicity::InferredAdHocMultiplicity(lowerBound = buildMultiplicityValue($lower));
}

function platform::pure::compiler::helper::genericType::buildInferredAdHocMultiplicity(lower:Integer[1], upper:Integer[1]):platform::pure::metamodel::multiplicity::InferredAdHocMultiplicity[1]
{
    ^platform::pure::metamodel::multiplicity::InferredAdHocMultiplicity(lowerBound = buildMultiplicityValue($lower), upperBound = buildMultiplicityValue($upper));
}

function platform::pure::compiler::helper::genericType::buildInferredAdHocMultiplicityFromValues(lowerBound:platform::pure::metamodel::multiplicity::MultiplicityValue[1], upperBound:platform::pure::metamodel::multiplicity::MultiplicityValue[0..1]):platform::pure::metamodel::multiplicity::InferredAdHocMultiplicity[1]
{
    ^platform::pure::metamodel::multiplicity::InferredAdHocMultiplicity(lowerBound = $lowerBound, upperBound = $upperBound);
}

function platform::pure::compiler::helper::genericType::printGenericType(genericType:GenericType[1]):String[1]
{
    $genericType->printGenericType(true)
}

function platform::pure::compiler::helper::genericType::printGenericType(genericType:GenericType[1], fullPath:Boolean[1]):String[1]
{
    $genericType->match(
        [
            ns  : CompilerNotSetGenericType[1] | 'NotSet',
            ugt : UndefinedGenericType[1] | '?',
            gto : GenericTypeOperation[1] | $gto->printGenericTypeOperation($fullPath),
            gtv : GenericTypeValue[1]     | $gtv->printGenericTypeValue($fullPath),
            a   : Any[1]                  | if($genericType->rawType()->isEmpty(),
                                               | 'Unknown',
                                               | $genericType->rawType()->toOne()->cast(@PackageableElement).name->toOne()
                                                 + if($genericType->genericTypeTypeArguments()->isEmpty(),
                                                      | '',
                                                      | '<' + $genericType->genericTypeTypeArguments()->map(t | $t->printGenericType($fullPath))->joinStrings(', ') + '>'
                                                   )
                                            )
        ]
    )
}

function platform::pure::compiler::helper::genericType::printGenericTypeValue(gtv:GenericTypeValue[1], fullPath:Boolean[1]):String[1]
{
    let rawType = $gtv.type;
    if($rawType->isEmpty(),
        | 'Unknown',
        | let t = $rawType->toOne();
          $t->match(
              [
                  tp : TypeParameter[1] | if($tp.name->isEmpty(), | '?', | $tp.name->toOne()),
                  ft : FunctionType[1]       | $ft->printFunctionType($fullPath),
                  rt : RelationType<Any>[1] | $rt->printRelationType($fullPath),
                  // Pointer arm — match BEFORE PackageableElement. Pointers have null
                  // `.name`/`.package`; read identity from `.path` instead.
                  ptr : platform::pure::metamodel::pointer::TempCompilerPointer[1] |
                      let pPath = $ptr.path->toOne();
                      let pName = $pPath->split('::')->last()->toOne();
                      let typeName = if($fullPath,
                          | if($pPath->startsWith('platform::pure::metamodel::') || $pPath->startsWith('platform::pure::functions::'),
                                | $pName,
                                | $pPath
                            );,
                          | $pName
                      );
                      let typeArgs = $gtv.typeArguments;
                      let mulArgs = $gtv.multiplicityArguments;
                      if($typeArgs->isEmpty() && $mulArgs->isEmpty(),
                          | $typeName,
                          | let typeArgStr = $typeArgs->map(a | $a->printGenericType($fullPath))->joinStrings(', ');
                            let mulArgStr = $mulArgs->map(m | '|' + $m->printMultiplicityBare())->joinStrings('');
                            $typeName + '<' + $typeArgStr + $mulArgStr + '>';
                      );,
                  pe : PackageableElement[1] |
                      let typeName = if($fullPath,
                          | let pPath = $pe->fullPath();
                            if($pPath->startsWith('platform::pure::metamodel::') || $pPath->startsWith('platform::pure::functions::'),
                                | $pe.name->toOne(),
                                | $pPath
                            );,
                          | $pe.name->toOne()
                      );
                      let typeArgs = $gtv.typeArguments;
                      let mulArgs = $gtv.multiplicityArguments;
                      if($typeArgs->isEmpty() && $mulArgs->isEmpty(),
                          | $typeName,
                          | let typeArgStr = $typeArgs->map(a | $a->printGenericType($fullPath))->joinStrings(', ');
                            let mulArgStr = $mulArgs->map(m | '|' + $m->printMultiplicityBare())->joinStrings('');
                            $typeName + '<' + $typeArgStr + $mulArgStr + '>';
                      );,
                  a  : Any[1]                | 'Unknown'
              ]);
    );
}



// GenericType accessors

function platform::pure::compiler::helper::genericType::genericTypeTypeArguments(gt:GenericType[1]):GenericType[*]
{
    $gt->match(
        [
            gtv : GenericTypeValue[1] | $gtv.typeArguments,
            a   : Any[1]             | []
        ]
    )
}

function platform::pure::compiler::helper::genericType::genericTypeMultiplicityArguments(gt:GenericType[1]):Multiplicity[*]
{
    $gt->match(
        [
            gtv : GenericTypeValue[1] | $gtv.multiplicityArguments,
            a   : Any[1]             | []
        ]
    )
}


// GenericType concreteness

function platform::pure::compiler::helper::genericType::isConcreteGenericType(genericType:GenericType[1]):Boolean[1]
{
    $genericType->match(
        [
            ns  : CompilerNotSetGenericType[1] | false,
            ugt : UndefinedGenericType[1] | true,
            gto : GenericTypeOperation[1] | $gto->isConcreteGenericTypeOperation(),
            gtv : GenericTypeValue[1]     | $gtv->isConcreteGenericTypeValue(),
            a   : Any[1]                  | true
        ]
    );
}

function platform::pure::compiler::helper::genericType::isConcreteGenericTypeValue(gtv:GenericTypeValue[1]):Boolean[1]
{
    if($gtv.type->isEmpty(),
        | true,
        | $gtv.type->toOne()->match(
              [
                  tp : TypeParameter[1] | false,
                  ft : FunctionType[1]  | if($ft->isConcreteFunctionType(), | $gtv.typeArguments->filter(arg | !$arg->isConcreteGenericType())->isEmpty(), | false),
                  a  : Any[1]           | $gtv.typeArguments->filter(arg | !$arg->isConcreteGenericType())->isEmpty()
              ]
          );
    );
}



// GenericType concreteness in context

function platform::pure::compiler::helper::genericType::isConcreteGenericTypeInContext(genericType:GenericType[1], scopeTypeParams:String[*]):Boolean[1]
{
    if($genericType->isConcreteGenericType(),
        | true,
        | let referencedParams = $genericType->collectReferencedTypeParameterNames();
          if($referencedParams->isEmpty(),
              | false,
              | $referencedParams->filter(n | $scopeTypeParams->filter(s | $s == $n)->isEmpty())->isEmpty()
          );
    )
}


// The key a type or multiplicity parameter is known by in a scope (isConcreteInContext): its owner's path and
// its name, so that a callee's T is not taken for its caller's; its name alone when it has no owner. A scope
// holds both forms of each parameter in it, so that an ownerless reference is in scope by its name — mirrors
// Java _GenericType.scopeKey.
function platform::pure::compiler::helper::genericType::scopeKey(owner:Any[0..1], name:String[1]):String[1]
{
    if($owner->isEmpty(),
        | $name,
        | $owner->toOne()->match([
              pe : PackageableElement[1] | $pe->elementToPath() + '#' + $name,
              a  : Any[1]                | $name
          ])
    );
}

// The type parameters referenced within a GenericType (its nested function and relation types and type
// arguments included).
function platform::pure::compiler::helper::genericType::collectReferencedTypeParameters(genericType:GenericType[1]):TypeParameter[*]
{
    $genericType->match([
        gto : GenericTypeOperation[1] | $gto.left->collectReferencedTypeParameters()->concatenate($gto.right->collectReferencedTypeParameters()),
        gtv : GenericTypeValue[1] |
            let own = if($gtv.type->isEmpty(), | [], | $gtv.type->toOne()->match([
                tp : TypeParameter[1] | $tp,
                ft : FunctionType[1] | $ft.parameters->filter(p | $p.genericType->isNotEmpty())->map(p | $p.genericType->toOne()->collectReferencedTypeParameters())
                                          ->concatenate(if($ft.returnType->isEmpty(), | [], | $ft.returnType->toOne()->collectReferencedTypeParameters())),
                rt : RelationType<Any>[1] | $rt.columns->cast(@Column<Any,Any|*>)->filter(c | $c.genericType->isNotEmpty())->map(c | $c.genericType->toOne()->collectReferencedTypeParameters()),
                a  : Any[1] | []->cast(@TypeParameter)
            ]));
            $own->concatenate($gtv.typeArguments->map(a | $a->collectReferencedTypeParameters()));,
        a : Any[1] | []->cast(@TypeParameter)
    ]);
}

// GenericType referenced parameter names

function platform::pure::compiler::helper::genericType::collectReferencedTypeParameterNames(genericType:GenericType[1]):String[*]
{
    $genericType->match(
        [
            ns  : CompilerNotSetGenericType[1] | [],
            ugt : UndefinedGenericType[1] | [],
            gto : GenericTypeOperation[1] |
                $gto->collectGenericTypeOperationReferencedTypeParameterNames(),
            gtv : GenericTypeValue[1]     |
                let rawType = $gtv.type;
                let tpNames = if($rawType->isEmpty(),
                    | [],
                    | $rawType->toOne()->match(
                        [
                            tp : TypeParameter[1]  | $tp.name,
                            ft : FunctionType[1]   | $ft->collectFunctionTypeReferencedTypeParameterNames(),
                            rt : RelationType<Any>[1] | $rt->collectRelationTypeReferencedTypeParameterNames(),
                            a  : Any[1]            | []->cast(@String)
                        ]
                      )
                );
                let argNames = $gtv.typeArguments->map(a | $a->collectReferencedTypeParameterNames());
                $tpNames->concatenate($argNames)->removeDuplicates();,
            a   : Any[1] | []
        ]
    )
}

function platform::pure::compiler::helper::genericType::collectReferencedMultiplicityParameterNames(genericType:GenericType[1]):String[*]
{
    $genericType->match(
        [
            ns  : CompilerNotSetGenericType[1] | [],
            ugt : UndefinedGenericType[1] | [],
            gto : GenericTypeOperation[1] |
                $gto.left->collectReferencedMultiplicityParameterNames()
                    ->concatenate($gto.right->collectReferencedMultiplicityParameterNames()),
            gtv : GenericTypeValue[1]     |
                let rawType = $gtv.type;
                let ftNames = if($rawType->isEmpty(),
                    | [],
                    | $rawType->toOne()->match(
                        [
                            ft : FunctionType[1] | $ft->collectFunctionTypeReferencedMultiplicityParameterNames(),
                            rt : RelationType<Any>[1] | $rt->collectRelationTypeReferencedMultiplicityParameterNames(),
                            a  : Any[1]          | []->cast(@String)
                        ]
                      )
                );
                let argNames = $gtv.typeArguments->map(a | $a->collectReferencedMultiplicityParameterNames());
                let mulArgNames = $gtv.multiplicityArguments->map(m |
                    $m->match(
                        [
                            mp : MultiplicityParameter[1] | $mp.name,
                            a  : Any[1]                   | []->cast(@String)
                        ]
                    )
                );
                $ftNames->concatenate($argNames)->concatenate($mulArgNames)->removeDuplicates();,
            a   : Any[1] | []
        ]
    )
}


// Tests

Class <<test.TestDependency>> platform::pure::compiler::helper::genericType::tests::MyClass<T>
{
    tpProp: T[1];
    nestedTpProp: Class<T>[1];
}

Class <<test.TestDependency>> platform::pure::compiler::helper::genericType::tests::TestClass
{
    intProp: Integer[1];
    strProp: String[1];
    listProp: Class<Integer>[1];
    myClassProp: platform::pure::compiler::helper::genericType::tests::MyClass<Integer>[1];
    classTpProp: Class<platform::pure::compiler::helper::genericType::tests::MyClass<String>>[1];
}

function <<test.TestDependency>> platform::pure::compiler::helper::genericType::tests::getPropGT(name:String[1]):GenericType[1]
{
    let tc = platform::pure::compiler::helper::genericType::tests::TestClass;
    let prop = $tc.properties->filter(p | $p.name == $name)->toOne();
    $prop.genericType;
}

function <<test.TestDependency>> platform::pure::compiler::helper::genericType::tests::getMyClassTpGT():GenericType[1]
{
    let mc = platform::pure::compiler::helper::genericType::tests::MyClass;
    let prop = $mc.properties->filter(p | $p.name == 'tpProp')->toOne();
    $prop.genericType;
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testPrintGenericTypeSimple():Boolean[1]
{
    let intGT = platform::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assertEquals('Integer', $intGT->printGenericType(true));
    assertEquals('Integer', $intGT->printGenericType(false));
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testPrintGenericTypeString():Boolean[1]
{
    let strGT = platform::pure::compiler::helper::genericType::tests::getPropGT('strProp');
    assertEquals('String', $strGT->printGenericType(false));
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testPrintGenericTypeUndefined():Boolean[1]
{
    let ugt = ^UndefinedGenericType();
    assertEquals('?', $ugt->printGenericType(false));
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testPrintGenericTypeTypeParameter():Boolean[1]
{
    let tpGT = platform::pure::compiler::helper::genericType::tests::getMyClassTpGT();
    let result = $tpGT->printGenericType(false);
    assert($result->length() > 0);
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testGenericTypeTypeArguments():Boolean[1]
{
    let listGT = platform::pure::compiler::helper::genericType::tests::getPropGT('listProp');
    assertEquals(1, $listGT->genericTypeTypeArguments()->size());
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testGenericTypeMultiplicityArguments():Boolean[1]
{
    let intGT = platform::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assert($intGT->genericTypeMultiplicityArguments()->isEmpty());
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testIsConcreteGenericType():Boolean[1]
{
    let intGT = platform::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assert($intGT->isConcreteGenericType());

    let tpGT = platform::pure::compiler::helper::genericType::tests::getMyClassTpGT();
    assertFalse($tpGT->isConcreteGenericType());

    let ugt = ^UndefinedGenericType();
    assert($ugt->isConcreteGenericType());
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testIsConcreteGenericTypeWithTypeArgs():Boolean[1]
{
    let classGT = platform::pure::compiler::helper::genericType::tests::getPropGT('listProp');
    assert($classGT->isConcreteGenericType());

    let tpClassProp = platform::pure::compiler::helper::genericType::tests::getPropGT('classTpProp');
    assert($tpClassProp->isConcreteGenericType());
    
    let mc = platform::pure::compiler::helper::genericType::tests::MyClass;
    let nPropGT = $mc.properties->filter(p | $p.name == 'nestedTpProp')->toOne().genericType;
    assertFalse($nPropGT->isConcreteGenericType());
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testCollectReferencedTypeParameterNames():Boolean[1]
{
    let intGT = platform::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assertEquals(0, $intGT->collectReferencedTypeParameterNames()->size());

    let tpGT = platform::pure::compiler::helper::genericType::tests::getMyClassTpGT();
    let names = $tpGT->collectReferencedTypeParameterNames();
    assertEquals(1, $names->size());
    assertEquals('T', $names->at(0));

    let myClassProp = platform::pure::compiler::helper::genericType::tests::getPropGT('myClassProp');
    assertEquals(0, $myClassProp->collectReferencedTypeParameterNames()->size());

    let mc = platform::pure::compiler::helper::genericType::tests::MyClass;
    let tpClassGT = $mc.properties->filter(p | $p.name == 'nestedTpProp')->toOne().genericType;
    let nestedNames = $tpClassGT->collectReferencedTypeParameterNames();
    assertEquals(1, $nestedNames->size());
    assertEquals('T', $nestedNames->at(0));

    let ugt = ^UndefinedGenericType();
    assertEquals(0, $ugt->collectReferencedTypeParameterNames()->size());
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testCollectReferencedMultiplicityParameterNames():Boolean[1]
{
    let intGT = platform::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assertEquals(0, $intGT->collectReferencedMultiplicityParameterNames()->size());

    let ugt = ^UndefinedGenericType();
    assertEquals(0, $ugt->collectReferencedMultiplicityParameterNames()->size());
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testIsConcreteGenericTypeInContext():Boolean[1]
{
    let intGT = platform::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assert($intGT->isConcreteGenericTypeInContext([]));

    let tpGT = platform::pure::compiler::helper::genericType::tests::getMyClassTpGT();
    assert($tpGT->isConcreteGenericTypeInContext(['T']));
    assertFalse($tpGT->isConcreteGenericTypeInContext([]));
    assertFalse($tpGT->isConcreteGenericTypeInContext(['V']));

    let mc = platform::pure::compiler::helper::genericType::tests::MyClass;
    let nestedTpProp = $mc.properties->filter(p | $p.name == 'nestedTpProp')->toOne().genericType;
    assert($nestedTpProp->isConcreteGenericTypeInContext(['T']));
    assertFalse($nestedTpProp->isConcreteGenericTypeInContext([]));
}

// ============================================================================
// findCommonGenericType tests
// ============================================================================

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testFindCommonGenericType_sameType():Boolean[1]
{
    let intGT1 = buildInferredGenericType(Integer);
    let intGT2 = buildInferredGenericType(Integer);
    let result = findCommonGenericType([$intGT1, $intGT2], platform::pure::compiler::newPlainCompilerContext());
    assert($result->isNotEmpty());
    assertEquals('Integer', $result->toOne()->printGenericType());
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testFindCommonGenericType_subtypes():Boolean[1]
{
    let intGT = buildInferredGenericType(Integer);
    let floatGT = buildInferredGenericType(Float);
    let result = findCommonGenericType([$intGT, $floatGT], platform::pure::compiler::newPlainCompilerContext());
    assert($result->isNotEmpty());
    assertEquals('Number', $result->toOne()->printGenericType());
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testFindCommonGenericType_lambdaWithSameFunctionType():Boolean[1]
{
    // LambdaFunction<{Integer[1]->Boolean[1]}> for both
    let ft = new(^UserDefinedGenericType(type = FunctionType))->cast(@FunctionType);
    let concretesFT = ^$ft(
        parameters = [^VariableExpression(name='x', genericType=buildInferredGenericType(Integer), multiplicity=PureOne)],
        returnType = buildInferredGenericType(Boolean),
        returnMultiplicity = PureOne
    );
    let lambdaBase1 = buildInferredGenericType(LambdaFunction);
    let lambdaGT1 = ^$lambdaBase1(typeArguments = [buildInferredGenericType($concretesFT)]);
    let lambdaBase2 = buildInferredGenericType(LambdaFunction);
    let lambdaGT2 = ^$lambdaBase2(typeArguments = [buildInferredGenericType($concretesFT)]);
    let result = findCommonGenericType([$lambdaGT1, $lambdaGT2], platform::pure::compiler::newPlainCompilerContext());
    assert($result->isNotEmpty());
    // The common type should preserve the FunctionType type argument
    let resultStr = $result->toOne()->printGenericType();
    assert($resultStr->startsWith('LambdaFunction'), | 'Expected LambdaFunction but got: ' + $resultStr);
    assert($resultStr->contains('Integer'), | 'Expected Integer in type args but got: ' + $resultStr);
    assert($resultStr->contains('Boolean'), | 'Expected Boolean in type args but got: ' + $resultStr);
}

function <<test.Test>> platform::pure::compiler::helper::genericType::tests::testFindCommonGenericType_lambdaWithDifferentFunctionTypeInstances():Boolean[1]
{
    // Two LambdaFunction<{Integer[1]->Integer[1]}> with DIFFERENT FunctionType objects
    let ft1 = new(^UserDefinedGenericType(type = FunctionType))->cast(@FunctionType);
    let concreteFT1 = ^$ft1(
        parameters = [^VariableExpression(name='x', genericType=buildInferredGenericType(Integer), multiplicity=PureOne)],
        returnType = buildInferredGenericType(Integer),
        returnMultiplicity = PureOne
    );
    let ft2 = new(^UserDefinedGenericType(type = FunctionType))->cast(@FunctionType);
    let concreteFT2 = ^$ft2(
        parameters = [^VariableExpression(name='y', genericType=buildInferredGenericType(Integer), multiplicity=PureOne)],
        returnType = buildInferredGenericType(Integer),
        returnMultiplicity = PureOne
    );
    let lambdaBase1 = buildInferredGenericType(LambdaFunction);
    let lambdaGT1 = ^$lambdaBase1(typeArguments = [buildInferredGenericType($concreteFT1)]);
    let lambdaBase2 = buildInferredGenericType(LambdaFunction);
    let lambdaGT2 = ^$lambdaBase2(typeArguments = [buildInferredGenericType($concreteFT2)]);
    let result = findCommonGenericType([$lambdaGT1, $lambdaGT2], platform::pure::compiler::newPlainCompilerContext());
    assert($result->isNotEmpty());
    let resultStr = $result->toOne()->printGenericType();
    // Should preserve the common FunctionType structure, not collapse to Any
    assert($resultStr->startsWith('LambdaFunction'), | 'Expected LambdaFunction but got: ' + $resultStr);
    assert($resultStr->contains('Integer'), | 'Expected Integer in type args but got: ' + $resultStr);
}

function platform::pure::compiler::helper::genericType::collectTypeParameterBindings(paramGT:GenericType[1], argGT:GenericType[1], bindings:ParametersBinding[1]):ParametersBinding[1]
{
    $paramGT->match([
        paramV : GenericTypeValue[1] |
            if($paramV.type->isEmpty(),
                | $bindings,
                | $paramV.type->toOne()->match([
                      tp : TypeParameter[1] |
                          $bindings->addTypeBinding($tp, $argGT),
                      otherParamType : Type[1] |
                          $argGT->match([
                              argV : GenericTypeValue[1] |
                                  let b1 = $otherParamType->match([
                                      paramFT : FunctionType[1] |
                                          if($argV.type->isNotEmpty(),
                                              | $argV.type->toOne()->match([
                                                    argFT : FunctionType[1] | collectTypeParameterBindings($paramFT, $argFT, $bindings),
                                                    other : Type[1] | $bindings
                                                ]);,
                                              | $bindings
                                          );,
                                      other : Type[1] | $bindings
                                  ]);
                                  // Recurse into RelationType columns for wildcard binding
                                  let b1rt = $otherParamType->match([
                                      paramRT : RelationType<Any>[1] |
                                          if($argV.type->isNotEmpty(),
                                              | $argV.type->toOne()->match([
                                                    argRT : RelationType<Any>[1] | collectRelationTypeParameterBindings($paramRT, $argRT, $b1),
                                                    other : Type[1] | $b1
                                                ]);,
                                              | $b1
                                          );,
                                      other : Type[1] | $b1
                                  ]);
                                  
                                  // Recurse into type arguments positionally
                                  let b2 = if($paramV.typeArguments->isNotEmpty() && $argV.typeArguments->isNotEmpty(),
                                      | $paramV.typeArguments->zip($argV.typeArguments)->fold({pair, bb | collectTypeParameterBindings($pair.first, $pair.second, $bb)}, $b1rt),
                                      | $b1rt
                                  );
                                  
                                  // Recurse into multiplicity arguments positionally
                                  if($paramV.multiplicityArguments->isNotEmpty() && $argV.multiplicityArguments->isNotEmpty(),
                                      | $paramV.multiplicityArguments->zip($argV.multiplicityArguments)->fold({pair, bb | collectMultiplicityParameterBindings($pair.first, $pair.second, $bb)}, $b2),
                                      | $b2
                                  );,
                              otherArgGT: GenericType[1] | $bindings
                          ])
                  ])
            ),
        gto : GenericTypeOperation[1] |
            $gto->collectGenericTypeOperationTypeParameterBindings($argGT, $bindings),
        otherParamGT : GenericType[1] | $bindings
    ])
}

function platform::pure::compiler::helper::genericType::resolveForTarget(sourceGenericType:GenericType[0..1], targetType:Type[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[0..1]
{
    if($sourceGenericType->isEmpty(),
        | [],
        | $sourceGenericType->toOne()->match([
              src : GenericTypeValue[1] | resolveForTarget_GenericTypeValue($src, $targetType, $context),
              undefined: UndefinedGenericType[1] | [],
              other: GenericType[1] | []
          ])
    )
}

function platform::pure::compiler::helper::genericType::resolveForTarget_GenericTypeValue(src:GenericTypeValue[1], targetType:Type[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[0..1]
{
    if($src.type->isEmpty(),
        | [],
        | // Dereference pointer types so structural reads below
          // ({@code cls.typeParameters}, {@code .generalizations}) hit the
          // live element. {@link buildInferredGenericType} /
          // {@link buildUserDefinedGenericType} wrap the raw type as a
          // {@code TempCompilerPointer} at construction; pointers carry only
          // {@code .path}, so reading interior slots through them returns
          // empty.
          let sourceType = $src.type->toOne()->platform::pure::compiler::helper::type::derefTypeIfPointer($context)->toOne();
          if(typeEquals($sourceType, $targetType),
              | $src,
              | let initialBindings = newPlainParametersBinding();
                let bindings = $sourceType->match([
                    cls : Class<Any>[1] |
                        let typeB = $cls.typeParameters->zip($src.typeArguments)->fold({pair, bb | $bb->addTypeBinding($pair.first, $pair.second)}, $initialBindings->cast(@ParametersBinding));
                        if($src.multiplicityArguments->isNotEmpty(),
                            | $cls.multiplicityParameters->zip($src.multiplicityArguments)->fold({pair, bb | $bb->addMultiplicityBinding($pair.first, $pair.second)}, $typeB->cast(@ParametersBinding)),
                            | $typeB
                        );,
                    other : Type[1] | $initialBindings
                ]);

                let validGens = $sourceType.generalizations->filter(g |
                    $g.general->match([
                        gtv : GenericTypeValue[1] | $gtv.type->isNotEmpty() && $gtv.type->toOne()->subtypeOf($targetType, $context),
                        other : GenericType[1] | false
                    ])
                );
                if($validGens->isNotEmpty(),
                    | // Upward: walk generalizations toward target (supertype)
                      let resolvedGT = makeAsConcreteAsPossible($validGens->at(0).general, $bindings, $context);
                      resolveForTarget($resolvedGT, $targetType, $context);,
                    | // Downward: target is a subtype of source (mirrors Java lines 908-946)
                      // Java checks: targetType instanceof Class. At runtime, M3 type objects for
                      // Class-defined types (like LambdaFunction, Function) are ClassImpl instances,
                      // so instanceof Class returns true. PrimitiveTypeImpl does not implement Class.
                      // In Pure, instanceOf(Class) matches the M3 meta-classifier, which is true for
                      // all Class-defined types but false for PrimitiveType instances.
                      let targetIsSubtype = $targetType->instanceOf(Class) && $targetType->subtypeOf($sourceType, $context);
                      if($targetIsSubtype,
                          | // $targetType may be a ClassPointer (recompile contexts where
                            // PointerGraphResolver hasn't run); deref before reading slots.
                            let targetCls = $targetType->derefTypeIfPointer($context)->toOne()->cast(@Class<Any>);
                            let templateTypeArgs = $targetCls.typeParameters->map(tp | buildUserDefinedGenericType($tp));
                            let templateMulArgs = $targetCls.multiplicityParameters->map(mp | $mp->cast(@Multiplicity));
                            let templateGT0 = buildUserDefinedGenericType($targetType);
                            let templateGT = ^$templateGT0(typeArguments = $templateTypeArgs, multiplicityArguments = $templateMulArgs);
                            let resolvedTemplate = resolveForTarget($templateGT, $sourceType, $context);
                            if($resolvedTemplate->isNotEmpty(),
                                | let downBindings = newPlainParametersBinding()->cast(@ParametersBinding);
                                  let db1 = collectTypeParameterBindings($resolvedTemplate->toOne(), $src, $downBindings);
                                  let db2 = if($resolvedTemplate->toOne()->instanceOf(GenericTypeValue) && $resolvedTemplate->toOne()->cast(@GenericTypeValue).multiplicityArguments->isNotEmpty() && $src.multiplicityArguments->isNotEmpty(),
                                      | $resolvedTemplate->toOne()->cast(@GenericTypeValue).multiplicityArguments->zip($src.multiplicityArguments)->fold({pair, bb | collectMultiplicityParameterBindings($pair.first, $pair.second, $bb)}, $db1),
                                      | $db1
                                  );
                                  makeAsConcreteAsPossible($templateGT, $db2, $context);,
                                | []
                            );,
                          | []
                      );
                );
          );
    );
}

function platform::pure::compiler::helper::genericType::findCommonGenericType(genericTypes:GenericType[*], context:platform::pure::compiler::CompilerContext[1]):GenericType[0..1]
{
    findCommonGenericType($genericTypes, false, $context);
}

function platform::pure::compiler::helper::genericType::findCommonGenericType(genericTypes:GenericType[*], resolve:Function<{Type[1]->Type[1]}>[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[0..1]
{
    findCommonGenericType($genericTypes, false, $resolve, $context);
}

function platform::pure::compiler::helper::genericType::findCommonGenericType_Args(resultType:GenericType[1], projectedValues:GenericTypeValue[*], withArgs:GenericTypeValue[*], common:Type[1], contravariant:Boolean[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[1]
{
    if($withArgs->size() == $projectedValues->size() && $withArgs->isNotEmpty(),
        | let argCount = $withArgs->at(0).typeArguments->size();
          if($withArgs->forAll(gt | $gt.typeArguments->size() == $argCount) && $argCount > 0,
              | // Deref pointer types — ClassPointer carries only `path`,
                // so `cls.typeParameters` trips the strict pointer guard.
                let typeParams = $common->derefTypeIfPointer($context)->toOne()->match([cls : Class<Any>[1] | $cls.typeParameters, other : Type[1] | []]);
                let commonArgs = range($argCount)->map({i |
                    let argsAtPos = $withArgs->map(gt | $gt.typeArguments->at($i));
                    let argContravariant = if($i < $typeParams->size() && $typeParams->at($i).contravariant == true, | !$contravariant, | $contravariant);
                    findCommonGenericType($argsAtPos, $argContravariant, $context);
                })->filter(a | $a->isNotEmpty())->map(a | $a->toOne());

                if($commonArgs->size() == $argCount,
                    | $resultType->match([
                          rtv : GenericTypeValue[1] | ^$rtv(typeArguments = $commonArgs),
                          other : GenericType[1] | $resultType
                      ]),
                    | $resultType
                );,
              | $resultType
          );,
        | $resultType
    );
}


function platform::pure::compiler::helper::genericType::findCommonGenericType(genericTypes:GenericType[*], contravariant:Boolean[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[0..1]
{
    findCommonGenericType($genericTypes, $contravariant, {x:Type[1] | $x}, $context);
}

function platform::pure::compiler::helper::genericType::findCommonGenericType(genericTypes:GenericType[*], contravariant:Boolean[1], resolve:Function<{Type[1]->Type[1]}>[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[0..1]
{
    if($genericTypes->isEmpty(),
        | buildInferredGenericType(Nil),
        | let nonNullValues = $genericTypes->filter(gt | $gt->instanceOf(GenericTypeValue))->cast(@GenericTypeValue);

          let firstName = if($nonNullValues->isNotEmpty() && $nonNullValues->at(0).type->isNotEmpty() && $nonNullValues->at(0).type->toOne()->instanceOf(TypeParameter),
              | $nonNullValues->at(0).type->toOne()->cast(@TypeParameter).name,
              | []
          );
          let allSameTp = if($firstName->isNotEmpty(),
              | $nonNullValues->forAll(gt | $gt.type->isNotEmpty() && $gt.type->toOne()->instanceOf(TypeParameter) && $gt.type->toOne()->cast(@TypeParameter).name == $firstName->toOne()),
              | false
          );
          if($allSameTp,
              | $nonNullValues->at(0),
              | let rawTypes = $nonNullValues->filter(gt | $gt.type->isNotEmpty() && !$gt.type->toOne()->instanceOf(TypeParameter))->map(gt | $gt.type->toOne());
                if($rawTypes->isEmpty(),
                    | [],
                    | // If all raw types are RelationType instances, use structural unification (like Java lines 177-182)
                      let rawRelationTypes = $rawTypes->filter(t | $t->instanceOf(RelationType))->cast(@RelationType<Any>);
                      if($rawRelationTypes->size() == $rawTypes->size() && $rawRelationTypes->isNotEmpty(),
                          | let common = platform::pure::compiler::helper::relationType::findCommonRelationType($rawRelationTypes, $contravariant, $context);
                            if($common->isNotEmpty(), | buildInferredGenericType($common->toOne()), | []);,
                          | // If all raw types are FunctionType instances, use structural unification (like Java lines 184-190)
                      let rawFunctionTypes = $rawTypes->filter(t | $t->instanceOf(FunctionType))->cast(@FunctionType);
                      if($rawFunctionTypes->size() == $rawTypes->size() && $rawFunctionTypes->isNotEmpty(),
                          | let common = findCommonFunctionType($rawFunctionTypes, $context);
                            if($common->isNotEmpty(), | buildInferredGenericType($common->toOne()), | []);,
                          |
                      let commonType = findCommonType($rawTypes, $contravariant, $resolve, $context);
                      if($commonType->isEmpty(),
                          | [],
                          | let common = $commonType->toOne();
                            let resultType = buildInferredGenericType($common);

                            let projected = if($rawTypes->forAll(t | typeEquals($t, $common)),
                                | $nonNullValues,
                                | $genericTypes->map(gt | resolveForTarget($gt, $common, $context))->filter(p | $p->isNotEmpty())->map(p | $p->toOne())
                            );

                            let projectedValues = $projected->filter(gt | $gt->instanceOf(GenericTypeValue))->cast(@GenericTypeValue);
                            let withArgs = $projectedValues->filter(gt | $gt.typeArguments->isNotEmpty());

                            findCommonGenericType_Args($resultType, $projectedValues, $withArgs, $common, $contravariant, $context);
                      );
                      ); // end FunctionType check
                      ); // end RelationType check
                );
          );
    );
}

function platform::pure::compiler::helper::genericType::makeAsConcreteAsPossible(genericType:GenericType[1], bindings:ParametersBinding[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[1]
{
    $genericType->match([
        ns : CompilerNotSetGenericType[1] | $genericType,
        undefined : UndefinedGenericType[1] | $genericType,
        gto : GenericTypeOperation[1] |
            $gto->makeGenericTypeOperationAsConcreteAsPossible($bindings, $context),
        gtv : GenericTypeValue[1] |
            if($gtv.type->isEmpty(),
                | let typeArgsResolved = $gtv.typeArguments->map(a | makeAsConcreteAsPossible($a, $bindings, $context));
                  let mulArgsResolved = $gtv.multiplicityArguments->map(m | makeAsConcreteAsPossible($m, $bindings));
                  if($typeArgsResolved == $gtv.typeArguments && $mulArgsResolved == $gtv.multiplicityArguments,
                      | $genericType,
                      | ^$gtv(typeArguments = $typeArgsResolved, multiplicityArguments = $mulArgsResolved)
                  );,
                | $gtv.type->toOne()->match([
                      tp : TypeParameter[1] |
                          let boundTypes = $bindings.typeBindings->get($tp.name);
                          if([pair(| $boundTypes->isEmpty(), | $genericType),
                              pair(| $boundTypes->toOne().values->size() == 1, | $boundTypes->toOne().values->at(0))],
                             | let common = findCommonGenericType($boundTypes->toOne().values, $context);
                               if($common->isEmpty(), | $genericType, | $common->toOne());
                          );,
                      ft : FunctionType[1] |
                          let ftResolved = makeAsConcreteAsPossible($genericType, $ft, $bindings, $context);
                          if($ftResolved->isNotEmpty(), | $ftResolved->toOne(), | $genericType);,
                      rt : RelationType<Any>[1] |
                          let rtResolved = makeRelationTypeAsConcreteAsPossible($rt, $bindings, $context);
                          if($rtResolved->isNotEmpty(), | $rtResolved->toOne(), | $genericType);,
                      other : Type[1] |
                          let typeArgsResolved = $gtv.typeArguments->map(a | makeAsConcreteAsPossible($a, $bindings, $context));
                          let mulArgsResolved = $gtv.multiplicityArguments->map(m | makeAsConcreteAsPossible($m, $bindings));
                          // Wrap as InferredGenericType when type args changed (mirrors Java line 761: new InferredGenericTypeImpl)
                          let resolvedBase = buildInferredGenericType($other);
                          if($typeArgsResolved == $gtv.typeArguments && $mulArgsResolved == $gtv.multiplicityArguments,
                              | $genericType,
                              | ^$resolvedBase(typeArguments = $typeArgsResolved, multiplicityArguments = $mulArgsResolved)
                          );
                  ])
            );,
        gto : GenericTypeOperation[1] |
            $gto->makeGenericTypeOperationAsConcreteAsPossible($bindings, $context),
        other : GenericType[1] | $genericType
    ])
}

function platform::pure::compiler::helper::genericType::isCompatibleGenericType(declared:GenericType[1], actual:GenericType[1], context:platform::pure::compiler::CompilerContext[1]):Boolean[1]
{
    isCompatibleGenericType($declared, $actual, false, $context);
}

function platform::pure::compiler::helper::genericType::isCompatibleGenericType(declared:GenericType[1], actual:GenericType[1], contravariant:Boolean[1], context:platform::pure::compiler::CompilerContext[1]):Boolean[1]
{
    $declared->match([
        declaredOp : GenericTypeOperation[1] | isCompatibleGenericTypeOperation($declaredOp, $actual, $contravariant, $context),
        declaredNotSet : CompilerNotSetGenericType[1] | true,
        declaredUndef : UndefinedGenericType[1] |
            $actual->match([
                au : UndefinedGenericType[1] | true,
                other : GenericType[1] | false
            ]),
        declaredV : GenericTypeValue[1] |
            $actual->match([
                actualOp : GenericTypeOperation[1] | isCompatibleGenericTypeOperation($actualOp, $declared, !$contravariant, $context),
                actualNotSet : CompilerNotSetGenericType[1] | true,
                actualUndef : UndefinedGenericType[1] | false,
                actualV : GenericTypeValue[1] | isCompatibleGenericTypeValue($declaredV, $actualV, $contravariant, $context),
                other : GenericType[1] | false
            ]),
        other : GenericType[1] |
            $actual->match([
                actualOp : GenericTypeOperation[1] | isCompatibleGenericTypeOperation($actualOp, $declared, !$contravariant, $context),
                actualNotSet : CompilerNotSetGenericType[1] | true,
                other2 : GenericType[1] | false
            ])
    ]);
}

function platform::pure::compiler::helper::genericType::isCompatibleGenericTypeValue(declared:GenericTypeValue[1], actual:GenericTypeValue[1], contravariant:Boolean[1], context:platform::pure::compiler::CompilerContext[1]):Boolean[1]
{
    // Unresolved type parameters — assume compatible
    if($declared.type->isEmpty() || $actual.type->isEmpty(),
        | true,
        | let declaredType = $declared.type->toOne();
          let actualType = $actual.type->toOne();
          $declaredType->match([
              declTP : TypeParameter[1] |
                  $actualType->match([
                      actTP : TypeParameter[1] | $declTP.name == $actTP.name,
                      other : Type[1] | true
                  ]),
              declFT : FunctionType[1] |
                  $actualType->match([
                      actTP : TypeParameter[1] | true,
                      actFT : FunctionType[1] | isCompatibleFunctionType($declFT, $actFT, $contravariant, $context),
                      other : Type[1] | isCompatibleGenericTypeValue_rawCheck($declared, $actual, $declaredType, $actualType, $contravariant, $context)
                  ]),
              declRT : RelationType<Any>[1] |
                  $actualType->match([
                      actTP : TypeParameter[1] | true,
                      actRT : RelationType<Any>[1] | isCompatibleRelationType($declRT, $actRT, $contravariant, $context),
                      other : Type[1] | isCompatibleGenericTypeValue_rawCheck($declared, $actual, $declaredType, $actualType, $contravariant, $context)
                  ]),
              other : Type[1] |
                  $actualType->match([
                      actTP : TypeParameter[1] | true,
                      other2 : Type[1] | isCompatibleGenericTypeValue_rawCheck($declared, $actual, $declaredType, $actualType, $contravariant, $context)
                  ])
          ]);
    );
}

function platform::pure::compiler::helper::genericType::isCompatibleGenericTypeValue_rawCheck(declared:GenericTypeValue[1], actual:GenericTypeValue[1], declaredType:Type[1], actualType:Type[1], contravariant:Boolean[1], context:platform::pure::compiler::CompilerContext[1]):Boolean[1]
{
    if($contravariant && $actualType->isBottomType(),
        | true,
        | let rawCompatible = if(!$contravariant,
              | $actualType->subtypeOf($declaredType, $context),
              | $declaredType->subtypeOf($actualType, $context)
          );
          if(!$rawCompatible,
              | false,
              | let resolvedActual = if(!typeEquals($declaredType, $actualType),
                    | resolveForTarget($actual, $declaredType, $context),
                    | $actual
                );
                if($resolvedActual->isEmpty(),
                    | true,
                    | isCompatibleGenericTypeValue_args($declared, $resolvedActual->toOne(), $declaredType, $contravariant, $context)
                );
          );
    );
}

function platform::pure::compiler::helper::genericType::isCompatibleGenericTypeValue_args(declared:GenericTypeValue[1], resolvedActual:GenericType[1], declaredType:Type[1], contravariant:Boolean[1], context:platform::pure::compiler::CompilerContext[1]):Boolean[1]
{
    let typeArgsOk = $resolvedActual->match([
        resolvedActualV : GenericTypeValue[1] |
            if($declared.typeArguments->isNotEmpty() && $resolvedActualV.typeArguments->isNotEmpty(),
                | if($declared.typeArguments->size() != $resolvedActualV.typeArguments->size(),
                      | false,
                      | // Deref pointer types — ClassPointer carries only `path`,
                        // so `cls.typeParameters` triggers the strict pointer guard.
                        // typeParameters lives on the live Class — fetch it via the
                        // canonical element.
                        let typeParams = $declaredType->derefTypeIfPointer($context)->toOne()->match([cls : Class<Any>[1] | $cls.typeParameters, other : Type[1] | []]);
                        range($declared.typeArguments->size())->forAll({i |
                            let argContravariant = if($i < $typeParams->size() && $typeParams->at($i).contravariant == true, | !$contravariant, | $contravariant);
                            isCompatibleGenericType($declared.typeArguments->at($i), $resolvedActualV.typeArguments->at($i), $argContravariant, $context);
                        });
                  );,
                | true
            );,
        other : GenericType[1] | true
    ]);

    if(!$typeArgsOk,
        | false,
        | // Check multiplicity arguments
          $resolvedActual->match([
              resolvedActualV : GenericTypeValue[1] |
                  if($declared.multiplicityArguments->isNotEmpty() && $resolvedActualV.multiplicityArguments->isNotEmpty(),
                      | if($declared.multiplicityArguments->size() != $resolvedActualV.multiplicityArguments->size(),
                            | false,
                            | $declared.multiplicityArguments->zip($resolvedActualV.multiplicityArguments)->forAll({pair |
                                  multiplicitySubsumes($pair.first, $pair.second);
                              })
                        );,
                      | true
                  );,
              other : GenericType[1] | true
          ])
    );
}


function platform::pure::compiler::helper::genericType::asInferredGenericType(gt:GenericType[1]):GenericType[1]
{
    $gt->match([
        igt : InferredGenericType[1] | $igt,
        gtv : GenericTypeValue[1] |
            ^InferredGenericType(
                type = $gtv.type,
                typeArguments = $gtv.typeArguments,
                multiplicityArguments = $gtv.multiplicityArguments
            ),
        other : GenericType[1] | $gt
    ]);
}

// Mirrors Java _GenericType.withUndefinedTypeParams (lines 474-493).
//
// Used when a PackageableElement is referenced as a value (e.g.
// {@code instanceOf(List)}, or {@code let g = MyClass;}) — the element's
// classifierGenericType has intrinsic type parameters (e.g.
// {@code Class<List<T>>}) that are not bound by the call site and should
// be treated as wildcards. Without this, an outer call's parameter binder
// sees the inner T as a "free" TypeParameter, fails to bind, and the
// surrounding type-parameter is left unbound — leaving the value typed
// as TypeParameter rather than the intended Class.
//
// The reproducer at
// {@code specification/compiler/tests/valueSpecification/atomicValue/element/classWithTypeParameter.pure}
// demonstrates the failure mode this fixes.
function platform::pure::compiler::helper::genericType::withUndefinedTypeParams(gt:GenericType[1]):GenericType[1]
{
    $gt->match([
        gtv : GenericTypeValue[1] |
            if($gtv.type->isNotEmpty() && $gtv.type->toOne()->instanceOf(TypeParameter),
                | ^UndefinedGenericType()->cast(@GenericType),
                | if($gtv.typeArguments->isNotEmpty() && $gtv.typeArguments->exists(arg | !$arg->isConcreteGenericType()),
                    | let newArgs = $gtv.typeArguments->map(arg | withUndefinedTypeParams($arg));
                      let inferred = asInferredGenericType($gtv)->cast(@InferredGenericType);
                      ^$inferred(typeArguments = $newArgs)->cast(@GenericType);,
                    | $gt
                )
            ),
        other : GenericType[1] | $gt
    ]);
}

// Mirrors Java isConcreteInContext + inScopeTypeParamKeys:
// A type is concrete in context if it is fully concrete OR all referenced type parameters
// belong to the enclosing owner (the function/class being compiled).
// Java uses enclosingOwnerParametersBinding.owner()._typeParameters() — NOT the accumulated
// scope from nested function resolutions.
function platform::pure::compiler::helper::genericType::isConcreteInContext(gt:GenericType[0..1], mul:Multiplicity[0..1], context:CompilerContext[1]):Boolean[1]
{
    if($gt->isEmpty() || $mul->isEmpty(),
        | false,
        | let gtConcrete = $gt->toOne()->isConcreteGenericType();
          let mulConcrete = $mul->toOne()->isConcreteMultiplicity();
          if($gtConcrete && $mulConcrete,
              | true,
              | // by scope key (scopeKey): a callee's T is not taken for the enclosing owner's
                let referencedTypeParams = collectReferencedTypeParameters($gt->toOne())->map(tp | scopeKey($tp.owner, $tp.name));
                let referencedMulParams = $mul->toOne()->match([mp:MultiplicityParameter[1] | [scopeKey($mp.owner, $mp.name)], a:Any[1] | []]);
                // Use ownerTypeParams (enclosing function/class being compiled), not scopeTypeParams (accumulated)
                let ownerTypeParamKeys = $context.ownerTypeParams->map(tp | [$tp.name, scopeKey($tp.owner, $tp.name)]);
                let ownerMulParamKeys = $context.ownerMulParams->map(mp | [$mp.name, scopeKey($mp.owner, $mp.name)]);
                let allTypeParamsInScope = $referencedTypeParams->forAll(n | $ownerTypeParamKeys->contains($n));
                let allMulParamsInScope = $referencedMulParams->forAll(n | $ownerMulParamKeys->contains($n));
                ($referencedTypeParams->isNotEmpty() || $referencedMulParams->isNotEmpty())
                    && $allTypeParamsInScope && $allMulParamsInScope;
          );
    );
}

function platform::pure::compiler::helper::genericType::inferLiteralType(value:Any[1], ctx:CompilerContext[1]):GenericType[1]
{
    let pureName = $value->genericType().type->cast(@NamedType).name;
    if($pureName->isNotEmpty(),
        | let resolved = $ctx->resolveElement($pureName->toOne())->toOne()->cast(@Type);
          buildInferredGenericType($resolved);,
        | ^UndefinedGenericType()
    );
}

// Mirrors Java _GenericType.reconcileInferred
// Reconciles expected type with actual type, preserving inferred markers from actual.
// Canonical-anchor preservation helper. Mirrors Java _GenericType.reconcileInferred
// lines 1219-1231. When a rebuild would produce a leaf GT (no type/mult/typeVar args)
// wrapping a named PE rawType with a `GenericType_<name>` UDPGT-PE in core.pdb,
// returns that canonical anchor (else empty). Skipped for Inferred to preserve
// inferred-marker semantics.
function platform::pure::compiler::helper::genericType::canonicalAnchorFor(newType:Type[1], reconciledTypeArgs:GenericType[*], mulArgs:Multiplicity[*], typeVarVals:ValueSpecification[*], actual:GenericType[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[0..1]
{
    // Pointer-aware path derivation: pointers carry only `.path`, with `.name`
    // unset. Derive the full Pure path so the canonical anchor lookup still
    // fires for pointer-wrapped leaf types (e.g. ClassPointer(test::String)
    // → lookup GenericType_<fullPath>). Anchor name encodes the full path
    // (`::` -> `_`) so user modules whose simple names collide with platform
    // types don't pick up the wrong anchor.
    let typePath = $newType->match([
        ptr : platform::pure::metamodel::pointer::TempCompilerPointer[1] | $ptr->cast(@PackageableElement)->elementToPath(),
        pe  : PackageableElement[1] | $pe->elementToPath(),
        other : Type[1] | []->cast(@String)
    ]);
    let isLeaf = !$actual->instanceOf(Inferred)
        && $reconciledTypeArgs->isEmpty()
        && $mulArgs->isEmpty()
        && $typeVarVals->isEmpty()
        && $newType->instanceOf(PackageableElement)
        && $typePath->isNotEmpty();
    if(!$isLeaf,
        | []->cast(@GenericType),
        | let canonicalPath = 'platform::pure::metamodel::type::generics::optimization::GenericType_' + $typePath->toOne()->replace('::', '_');
          let resolved = $context->resolveElement($canonicalPath);
          if($resolved->isEmpty() || !$resolved->toOne()->instanceOf(GenericTypeValue),
              | []->cast(@GenericType),
              | let canonicalGT = $resolved->toOne()->cast(@GenericTypeValue);
                if($canonicalGT.type->isNotEmpty() && typeEquals($canonicalGT.type->toOne(), $newType),
                    | $canonicalGT->cast(@GenericType),
                    | []->cast(@GenericType)
                );
          );
    );
}

// Java reconcileInferred's raw-type gate, ported: reference identity for
// anonymous types (FunctionType/RelationType instances — `is()`), path
// equality for PackageableElements (the JVM has one canonical object per
// element, so Java's `==` works there; compile-pure's pointer/live duality
// needs the path compare). Deliberately NOT structural: a reconcile copy is
// structurally equal to its original by construction.
function platform::pure::compiler::helper::genericType::reconcileTypeIdentical(t1:Type[1], t2:Type[1]):Boolean[1]
{
    if(is($t1, $t2),
        | true,
        | $t1->match([
              pa:PackageableElement[1] | $t2->match([pb:PackageableElement[1] | $pa->elementToPath() == $pb->elementToPath(), other:Any[1] | false]),
              other:Any[1] | false
          ])
    );
}

function platform::pure::compiler::helper::genericType::reconcileInferred(expected:GenericType[1], actual:GenericType[1], context:platform::pure::compiler::CompilerContext[1]):GenericType[1]
{
    $expected->match([
        expectedV:GenericTypeValue[1] |
            $actual->match([
                actualV:GenericTypeValue[1] |
                    let expectedType = $expectedV.type;
                    let actualType = $actualV.type;
                    if($expectedType->isEmpty() || $actualType->isEmpty(),
                        | $actual,
                        // Java's gate is REFERENCE inequality (expectedType !=
                        // actualType): the reconcile copy is made only when
                        // both sides hold the SAME Type object; a structurally
                        // equal but DISTINCT anonymous type (e.g. a substituted
                        // RelationType vs the original) takes the
                        // resolveForTarget branch and keeps `actual` — copying
                        // there would replace Java's self-wired original with
                        // a copy on the wire. PackageableElements compare by
                        // path (Pure's pointer/live duality stands in for the
                        // JVM's canonical element identity).
                        | if(!reconcileTypeIdentical($expectedType->toOne(), $actualType->toOne()),
                            | let resolvedExpected = resolveForTarget($expected, $actualType->toOne(), $context);
                              // Recurse only when resolution actually reached the
                              // actual's raw type (identity) — otherwise return
                              // actual, as Java does when resolveForTarget yields
                              // null. Without this, a structurally-equal-but-
                              // distinct anonymous type resolves to another
                              // distinct copy and the recursion never terminates
                              // (Java can't loop here: its reference gate and
                              // canonical elements make resolution converge).
                              let resolvedUsable = $resolvedExpected->isNotEmpty()
                                  && $resolvedExpected->toOne()->match([
                                        gtv:GenericTypeValue[1] | $gtv.type->isNotEmpty() && reconcileTypeIdentical($gtv.type->toOne(), $actualType->toOne()),
                                        other:GenericType[1] | true
                                     ]);
                              if($resolvedUsable,
                                  | reconcileInferred($resolvedExpected->toOne(), $actual, $context),
                                  | $actual
                              );,
                            | let newType = $actualType->toOne()->match([
                                  ft:FunctionType[1] |
                                      $expectedType->toOne()->match([
                                          eft:FunctionType[1] | platform::pure::compiler::helper::functionType::reconcileInferredFT($eft, $ft, $context),
                                          a:Any[1] | $ft
                                      ]),
                                  rt:RelationType<Any>[1] |
                                      $expectedType->toOne()->match([
                                          ert:RelationType<Any>[1] | reconcileInferredRT($ert, $rt, $context),
                                          a:Any[1] | $rt
                                      ]),
                                  a:Any[1] | $actualType->toOne()
                              ]);
                              let reconciledTypeArgs = if($expectedV.typeArguments->size() == $actualV.typeArguments->size(),
                                  | $expectedV.typeArguments->zip($actualV.typeArguments)->map(p | reconcileInferred($p.first, $p.second, $context)),
                                  | $actualV.typeArguments
                              );
                              // Preserve typeVariableValues from actual (mirrors Java line 1196)
                              let actualTVV = $actual->match([u:UserDefinedGenericType[1] | $u.typeVariableValues, a:Any[1] | []->cast(@ValueSpecification)]);
                              // Canonical-anchor preservation: when the rebuild would produce a
                              // leaf GT (no type/mult/typeVar args) wrapping a named PE rawType
                              // with a `GenericType_<name>` UDPGT-PE in core.pdb, return that
                              // canonical anchor. Mirrors Java _GenericType.reconcileInferred lines
                              // 1219-1231 — closes the lambda classifier's canonical drift exposed
                              // by `function/lambda/canonicalAnchor.pure`. Skipped for Inferred to
                              // preserve the inferred-marker semantics.
                              let canonicalAnchor = canonicalAnchorFor($newType, $reconciledTypeArgs, $actualV.multiplicityArguments, $actualTVV, $actual, $context);
                              if($canonicalAnchor->isNotEmpty(),
                                  | $canonicalAnchor->toOne(),
                                  | let baseGT = buildUserDefinedGenericType($newType);
                                    let userDefinedGT = ^$baseGT(typeArguments = $reconciledTypeArgs, multiplicityArguments = $actualV.multiplicityArguments, typeVariableValues = $actualTVV);
                                    let inferredBase = buildInferredGenericType($newType);
                                    let inferredGT = ^$inferredBase(typeArguments = $reconciledTypeArgs, multiplicityArguments = $actualV.multiplicityArguments);
                                    if($actual->instanceOf(Inferred),
                                        | $inferredGT,
                                        | $userDefinedGT
                                    );
                              );
                          );
                    );,
                other:GenericType[1] | $actual
            ]),
        other:GenericType[1] | $actual
    ]);
}

// Mirrors Java _RelationType.reconcileInferred (lines 274-307):
// Reconciles inferred markers in RelationType columns — when an actual column's type/multiplicity
// is Inferred, propagate that to the expected column's type/multiplicity.
function platform::pure::compiler::helper::genericType::reconcileInferredRT(expectedRT:RelationType<Any>[1], actualRT:RelationType<Any>[1], context:platform::pure::compiler::CompilerContext[1]):RelationType<Any>[1]
{
    let expectedCols = $expectedRT.columns->cast(@Column<Any,Any|*>);
    let actualCols = $actualRT.columns->cast(@Column<Any,Any|*>);
    if($expectedCols->isEmpty() || $actualCols->isEmpty(),
        | $actualRT,
        | let newCols = $expectedCols->zip($actualCols)->map(p |
              let expectedCol = $p.first;
              let actualCol = $p.second;
              let reconciledGT = if($actualCol.genericType->isNotEmpty() && $actualCol.genericType->toOne()->instanceOf(Inferred)
                                     && $expectedCol.genericType->isNotEmpty()
                                     && isCompatibleGenericType($expectedCol.genericType->toOne(), $actualCol.genericType->toOne(), $context),
                  | reconcileInferred($expectedCol.genericType->toOne(), asInferredGenericType($expectedCol.genericType->toOne()), $context),
                  | if($actualCol.genericType->isNotEmpty(), | $actualCol.genericType->toOne(), | $expectedCol.genericType->toOne())
              );
              let reconciledMul = if($actualCol.multiplicity->isNotEmpty() && $actualCol.multiplicity->toOne()->instanceOf(Inferred)
                                      && $expectedCol.multiplicity->isNotEmpty()
                                      && multiplicitySubsumes($expectedCol.multiplicity->toOne(), $actualCol.multiplicity->toOne()),
                  | asInferredMultiplicity($expectedCol.multiplicity->toOne()),
                  | if($actualCol.multiplicity->isNotEmpty(), | $actualCol.multiplicity->toOne(), | PureOne)
              );
              // Java's copy REUSES the original column's classifierGenericType
              // object (ColumnImpl()._classifierGenericType(actualCol._classifierGenericType()))
              // — the owner cycle back to the original RelationType travels with it.
              ^Column<Any,Any|*>(classifierGenericType = $actualCol.classifierGenericType, name = $actualCol.name, nameWildCard = if($actualCol.nameWildCard->isEmpty(), | false, | $actualCol.nameWildCard), genericType = $reconciledGT, multiplicity = $reconciledMul);
          );
          // Same for the RelationType copy: the original's classifier (with its
          // self-wired typeArgument) is shared by reference, not rebuilt.
          ^RelationType<Any>(classifierGenericType = $actualRT.classifierGenericType, columns = $newCols);
    );
}
