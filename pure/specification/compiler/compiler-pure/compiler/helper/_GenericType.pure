function platform::pure::compiler::helper::genericType::buildInferredMultiplicityParameter(name:String[1], owner:platform::pure::metamodel::type::generics::TypeAndMultiplicityParametersOwner[0..1]):platform::pure::metamodel::multiplicity::InferredMultiplicityParameter[1]
{
    ^platform::pure::metamodel::multiplicity::InferredMultiplicityParameter(name = $name, owner = $owner);
