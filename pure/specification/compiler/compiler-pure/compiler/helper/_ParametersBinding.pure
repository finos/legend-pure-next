import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::*;
import meta::pure::compiler::helper::packageableElement::*;
import meta::pure::functions::collection::*;


Class meta::pure::compiler::helper::parametersBinding::ParametersBinding
{
    typeBindings: Map<String, List<GenericType>>[1];
    multiplicityBindings: Map<String, List<Multiplicity>>[1];
}

Class meta::pure::compiler::helper::parametersBinding::PlainParametersBinding extends ParametersBinding
{
}

Class meta::pure::compiler::helper::parametersBinding::EnclosingOwnerParametersBinding extends ParametersBinding
{
    owner: TypeAndMultiplicityParametersOwner[1];
}

Class meta::pure::compiler::helper::parametersBinding::FunctionCallParametersBinding extends ParametersBinding
{
    expr: FunctionExpression[0..1];
    function: TypeAndMultiplicityParametersOwner[0..1]; // Corresponds to FunctionIndexEntry
    ownTypeParams: Map<String, TypeParameter>[1];
    ownMulParams: Map<String, MultiplicityParameter>[1];
    enclosingOwner: EnclosingOwnerParametersBinding[0..1];
}

function meta::pure::compiler::helper::parametersBinding::newPlainParametersBinding():PlainParametersBinding[1]
{
    ^PlainParametersBinding(
        typeBindings = newMap([]->cast(@Pair<String, List<GenericType>>)),
        multiplicityBindings = newMap([]->cast(@Pair<String, List<Multiplicity>>))
    );
}

function meta::pure::compiler::helper::parametersBinding::addTypeBinding(pb:ParametersBinding[1], typeParam:TypeParameter[1], argGT:GenericType[1]):ParametersBinding[1]
{
    $pb->match([
        fcpb : FunctionCallParametersBinding[1] |
            if($fcpb.enclosingOwner->isNotEmpty()
                  && $typeParam.owner->isNotEmpty()
                  && ownersMatch($typeParam.owner->toOne(), $fcpb.enclosingOwner->toOne().owner),
                | // Route to enclosing owner
                  ^$fcpb(
                      enclosingOwner = $fcpb.enclosingOwner->toOne()->addTypeBinding($typeParam, $argGT)->cast(@EnclosingOwnerParametersBinding)
                  ),
                | // Add locally
                  ^$fcpb(typeBindings = $fcpb.typeBindings->putMapList($typeParam.name, $argGT))
            ),
        other : ParametersBinding[1] |
            ^$other(typeBindings = $other.typeBindings->putMapList($typeParam.name, $argGT))
    ])
}

// Java's `addTypeBinding` does `typeParam._owner() == enclosingOwner.owner()` — pointer
// equality that works because Java mutates one canonical instance per owner. In
// Pure-on-Truffle each `^...(field = ...)` clones, so the same logical owner exists
// as multiple object instances during compilation (e.g. captured in scope when typeparams
// are minted vs. read back from elementMap when FCPB is built). Fall back to qualified-path
// comparison when both are PackageableElements so routing matches Java's intent.
function meta::pure::compiler::helper::parametersBinding::ownersMatch(a:Any[1], b:Any[1]):Boolean[1]
{
    if($a == $b,
        | true,
        | $a->match([
              peA : PackageableElement[1] | $b->match([
                  peB : PackageableElement[1] | $peA->elementToPath() == $peB->elementToPath(),
                  other : Any[1] | false
              ]),
              other : Any[1] | false
          ])
    )
}

function meta::pure::compiler::helper::parametersBinding::addMultiplicityBinding(pb:ParametersBinding[1], mulParam:MultiplicityParameter[1], argMul:Multiplicity[1]):ParametersBinding[1]
{
    ^$pb(multiplicityBindings = $pb.multiplicityBindings->putMapList($mulParam.name, $argMul))
}

function meta::pure::compiler::helper::parametersBinding::putMapList<K,V>(map:Map<K,List<V>>[1], key:K[1], value:V[1]):Map<K,List<V>>[1]
{
    let currentList = $map->get($key);
    let newList = if($currentList->isEmpty(),
        | ^List<V>(values = [$value]),
        | ^List<V>(values = $currentList->toOne().values->concatenate([$value]))
    );
    $map->put($key, $newList);
}

function meta::pure::compiler::helper::parametersBinding::unify_step1_pairwiseBind(fcpb:FunctionCallParametersBinding[1]):FunctionCallParametersBinding[1]
{
    $fcpb.typeBindings->keyValues()->fold({kv, b |
        if($kv.second.values->size() > 1,
            | let vals = $kv.second.values;
              range($vals->size())->fold({i, b2 |
                  range($i + 1, $vals->size())->fold({j, b3 |
                      let res1 = collectTypeParameterBindings($vals->at($i), $vals->at($j), $b3);
                      collectTypeParameterBindings($vals->at($j), $vals->at($i), $res1);
                  }, $b2)
              }, $b);,
            | $b
        )
    }, $fcpb->cast(@ParametersBinding))->match([
        f: FunctionCallParametersBinding[1] | $f,
        other: ParametersBinding[1] | $fcpb
    ]);
}

function meta::pure::compiler::helper::parametersBinding::unify_step2_transitiveType_Helper(tb:FunctionCallParametersBinding[1], changed:Boolean[1], kvName:String[1], gt:GenericType[1]):Pair<FunctionCallParametersBinding, Boolean>[1]
{
    $gt->match([
        gtv : GenericTypeValue[1] |
            if($gtv.type->isNotEmpty(),
                | $gtv.type->toOne()->match([
                      tp : TypeParameter[1] |
                          let targetName = $tp.name;
                          let targetBindingOptional = $tb.typeBindings->get($targetName);

                          let targetBinding = if(($targetBindingOptional->isEmpty() || $targetBindingOptional->toOne().values->isEmpty()) && $tb.enclosingOwner->isNotEmpty(),
                              | if($tp.owner->isNotEmpty() && ownersMatch($tp.owner->toOne(), $tb.enclosingOwner->toOne().owner),
                                    | $tb.enclosingOwner->toOne().typeBindings->get($targetName),
                                    | $targetBindingOptional
                                ),
                              | $targetBindingOptional
                          );

                          if($targetBinding->isNotEmpty() && $targetBinding->toOne().values->size() == 1,
                              | let resolved = $targetBinding->toOne().values->at(0);
                                $resolved->match([
                                    resV : GenericTypeValue[1] |
                                        if($resV.type->isNotEmpty(),
                                            | $resV.type->toOne()->match([
                                                  tp2 : TypeParameter[1] | pair($tb, $changed),
                                                  other2 : Type[1] | pair(^$tb(typeBindings = $tb.typeBindings->put($kvName, ^List<GenericType>(values=$resolved))), true)
                                              ]);,
                                            | pair(^$tb(typeBindings = $tb.typeBindings->put($kvName, ^List<GenericType>(values=$resolved))), true)
                                        );,
                                    other : GenericType[1] | pair(^$tb(typeBindings = $tb.typeBindings->put($kvName, ^List<GenericType>(values=$resolved))), true)
                                ]);,
                              | pair($tb, $changed)
                          );,
                      other : Type[1] | pair($tb, $changed)
                  ]);,
                | pair($tb, $changed)
            );,
        other : GenericType[1] | pair($tb, $changed)
    ]);
}

function meta::pure::compiler::helper::parametersBinding::unify_step2_transitiveType(fcpb:FunctionCallParametersBinding[1]):FunctionCallParametersBinding[1]
{
    let kvs = $fcpb.typeBindings->keyValues();
    let newState = fold($kvs, {kv, stateAndChanged |
         let tb = $stateAndChanged.first;
         let changed = $stateAndChanged.second;
         if($kv.second.values->size() == 1,
            | unify_step2_transitiveType_Helper($tb, $changed, $kv.first, $kv.second.values->at(0)),
            | pair($tb, $changed)
         );
    }, pair($fcpb, false));
    
    if($newState.second == true,
        | unify_step2_transitiveType($newState.first),
        | $newState.first
    );
}

function meta::pure::compiler::helper::parametersBinding::unify_step3_transitiveMul_Helper(tb:FunctionCallParametersBinding[1], changed:Boolean[1], kvName:String[1], mul:Multiplicity[1]):Pair<FunctionCallParametersBinding, Boolean>[1]
{
    $mul->match([
        mp : MultiplicityParameter[1] |
            let targetName = $mp.name;
            let targetBinding = $tb.multiplicityBindings->get($targetName);
            if($targetBinding->isNotEmpty() && $targetBinding->toOne().values->size() == 1,
                | let resolved = $targetBinding->toOne().values->at(0);
                  $resolved->match([
                      mp2 : MultiplicityParameter[1] | pair($tb, $changed),
                      other : Multiplicity[1] | pair(^$tb(multiplicityBindings = $tb.multiplicityBindings->put($kvName, ^List<Multiplicity>(values=$resolved))), true)
                  ]);,
                | pair($tb, $changed)
            );,
        other : Multiplicity[1] | pair($tb, $changed)
    ]);
}

function meta::pure::compiler::helper::parametersBinding::unify_step3_transitiveMul(fcpb:FunctionCallParametersBinding[1]):FunctionCallParametersBinding[1]
{
    let kvs = $fcpb.multiplicityBindings->keyValues();
    let newState = fold($kvs, {kv, stateAndChanged |
         let tb = $stateAndChanged.first;
         let changed = $stateAndChanged.second;
         if($kv.second.values->size() == 1,
            | unify_step3_transitiveMul_Helper($tb, $changed, $kv.first, $kv.second.values->at(0)),
            | pair($tb, $changed)
         );
    }, pair($fcpb, false));
    
    if($newState.second == true,
        | unify_step3_transitiveMul($newState.first),
        | $newState.first
    );
}

function meta::pure::compiler::helper::parametersBinding::unify_preReduce_Helper(fcpb:FunctionCallParametersBinding[1], kvName:String[1], kvValues:List<GenericType>[1]):FunctionCallParametersBinding[1]
{
    let newValsAndChanged = $kvValues.values->fold({gt, agg |
        let keepOriginal = pair(^List<GenericType>(values=$agg.first.values->concatenate($gt)), $agg.second);
        $gt->match([
            gtv : GenericTypeValue[1] |
                if($gtv.type->isNotEmpty(),
                    | $gtv.type->toOne()->match([
                          tp : TypeParameter[1] |
                              if($tp.owner->isNotEmpty() && ownersMatch($tp.owner->toOne(), $fcpb.enclosingOwner->toOne().owner),
                                  | let ownerBinding = $fcpb.enclosingOwner->toOne().typeBindings->get($tp.name);
                                    if($ownerBinding->isNotEmpty() && $ownerBinding->toOne().values->size() == 1,
                                        | let ownerResolved = $ownerBinding->toOne().values->at(0);
                                          $ownerResolved->match([
                                              resV : GenericTypeValue[1] |
                                                  if($resV.type->isNotEmpty(),
                                                      | $resV.type->toOne()->match([
                                                            tp2 : TypeParameter[1] | $keepOriginal,
                                                            other2 : Type[1] | pair(^List<GenericType>(values=$agg.first.values->concatenate($ownerResolved)), true)
                                                        ]);,
                                                      | pair(^List<GenericType>(values=$agg.first.values->concatenate($ownerResolved)), true)
                                                  );,
                                              other : GenericType[1] | pair(^List<GenericType>(values=$agg.first.values->concatenate($ownerResolved)), true)
                                          ]);,
                                        | $keepOriginal
                                    );,
                                  | $keepOriginal
                              );,
                          other : Type[1] | $keepOriginal
                      ]);,
                    | $keepOriginal
                );,
            other : GenericType[1] | $keepOriginal
        ]);
    }, pair(^List<GenericType>(), false));
    
    if($newValsAndChanged.second,
        | ^$fcpb(typeBindings = $fcpb.typeBindings->put($kvName, $newValsAndChanged.first)),
        | $fcpb
    );
}

function meta::pure::compiler::helper::parametersBinding::unify_step4_preReduceEnclosing(fcpb:FunctionCallParametersBinding[1]):FunctionCallParametersBinding[1]
{
    if($fcpb.enclosingOwner->isEmpty(),
        | $fcpb,
        | let kvs = $fcpb.typeBindings->keyValues();
          fold($kvs, {kv, b |
              if($kv.second.values->size() > 1,
                  | unify_preReduce_Helper($b, $kv.first, $kv.second),
                  | $b
              );
          }, $fcpb);
    );
}

function meta::pure::compiler::helper::parametersBinding::unify_step5_finalReduce(fcpb:FunctionCallParametersBinding[1], context:meta::pure::compiler::CompilerContext[1]):FunctionCallParametersBinding[1]
{
    let st1 = fold($fcpb.typeBindings->keyValues(), {kv, b |
        if($kv.second.values->size() > 1,
            | let common = findCommonGenericType($kv.second.values, false, $context);
              if($common->isEmpty(),
                  | $b,
                  | ^$b(typeBindings = $b.typeBindings->put($kv.first, ^List<GenericType>(values=$common->toOne())))
              );,
            | $b
        );
    }, $fcpb);

    fold($st1.multiplicityBindings->keyValues(), {kv, b |
        if($kv.second.values->size() > 1,
            | let common = findCommonMultiplicity($kv.second.values);
              if($common->isEmpty(),
                  | $b,
                  | ^$b(multiplicityBindings = $b.multiplicityBindings->put($kv.first, ^List<Multiplicity>(values=$common->toOne())))
              );,
            | $b
        );
    }, $st1);
}

function meta::pure::compiler::helper::parametersBinding::unify(fcpb:FunctionCallParametersBinding[1], context:meta::pure::compiler::CompilerContext[1]):FunctionCallParametersBinding[1]
{
    let step1 = unify_step1_pairwiseBind($fcpb);
    let step2 = unify_step2_transitiveType($step1);
    let step3 = unify_step3_transitiveMul($step2);
    let step4 = unify_step4_preReduceEnclosing($step3);
    unify_step5_finalReduce($step4, $context);
}

function meta::pure::compiler::helper::parametersBinding::toString(pb:ParametersBinding[1]):String[1]
{
    let typeKeys = $pb.typeBindings->keys();
    let typePart = if($typeKeys->isEmpty(), | '', | 
        $typeKeys->map(k | 
            $k + '=' + $pb.typeBindings->get($k)->toOne().values->map(t | $t->printGenericType(false))->joinStrings('/')
        )->joinStrings(', ')
    );
    
    let mulKeys = $pb.multiplicityBindings->keys();
    let mulPart = if($mulKeys->isEmpty(), | '', | 
        $mulKeys->map(k | 
            $k + '=' + $pb.multiplicityBindings->get($k)->toOne().values->map(m | $m->printMultiplicity())->joinStrings('/')
        )->joinStrings(', ')
    );
    
    if($typePart == '' && $mulPart == '',
        | '',
        | '{' + if($typePart != '',
              | if($mulPart != '', | $typePart + ' | ' + $mulPart, | $typePart),
              | $mulPart
          ) + '}'
    );
}
