import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::helper::packageableElement::*;
import meta::pure::compiler::helper::function::*;
import meta::pure::compiler::helper::relationType::*;
import meta::pure::compiler::helper::column::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::lambda::*;
import meta::pure::compiler::helper::functionExpression::*;
import meta::pure::compiler::helper::variableExpression::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::functionType::*;
import meta::pure::compiler::helper::property::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::class::*;
import meta::pure::metamodel::pointer::*;

// PackageableElement path helpers

function meta::pure::compiler::helper::packageableElement::fullPath(element:PackageableElement[1]):String[1]
{
    $element->match([
        // TempCompilerPointer carries its canonical path directly; package/name are unset.
        ptr : TempCompilerPointer[1] | $ptr.path,
        pe  : PackageableElement[1] |
            let pkg = $pe.package;
            let name = $pe.name->toOne();
            if($pkg->isEmpty(),
                | $name,
                | // Package may itself be a {@link PackagePointer} (compile-pure
                  // wraps parent Package refs as pointers so children's stale
                  // skeletons don't propagate). The pointer's {@code path}
                  // field carries the parent's full path directly — use it.
                  let p = $pkg->toOne();
                  let pkgPath = if($p->instanceOf(TempCompilerPointer),
                      | $p->cast(@TempCompilerPointer).path,
                      | $p->packagePath()
                  );
                  if($pkgPath == '',
                      | $name,
                      | $pkgPath + '::' + $name
                  );
            );
    ])
}

function meta::pure::compiler::helper::packageableElement::packagePath(pkg:Package[1]):String[1]
{
    if($pkg->instanceOf(TempCompilerPointer),
        | $pkg->cast(@TempCompilerPointer).path,
        | if($pkg.package->isEmpty() || $pkg.name->isEmpty(),
              | '',
              | let parentPath = $pkg.package->toOne()->packagePath();
                if($parentPath == '',
                    | $pkg.name->toOne(),
                    | $parentPath + '::' + $pkg.name->toOne()
                );
          );
    );
}


// Tests

function <<test.Test>> meta::pure::compiler::helper::packageableElement::tests::testFullPath():Boolean[1]
{
    // Verify that fullPath returns a non-empty string for known types
    assert(Integer->fullPath()->length() > 0);
    assert(String->fullPath()->length() > 0);
    // Verify the name is part of the path
    assertEquals('Integer', Integer.name->toOne());
    assertEquals('String', String.name->toOne());
    // Verify that the path equals elementToPath
    assertEquals(Integer->elementToPath(), Integer->fullPath());
    assertEquals(String->elementToPath(), String->fullPath());
}
