import platform::pure::compiler::test::*;
import platform::pure::functions::collection::*;
import platform::pure::functions::string::*;
import platform::pure::compiler::test::printer::*;

// Harness — single parse + single compile per test file, with all section
// assertions running over the shared result so the test suite's wall time
// stays linear in the number of tests rather than (#tests × #sections).
//
// A {@code .pure} file under the spec tree MUST carry a ###Pure section,
// otherwise it's a malformed test (or a misplaced fixture) and the harness
// fails loudly. Silently passing such files hid divergences in earlier
// iterations of this work.
//
// Parser support: ###CompiledGraph and ###CompilerStats are recognized via
// registered language extensions (CompiledGraphLanguageExtension /
// CompilerStatsLanguageExtension on bootstrap; the corresponding Truffle
// extensions on the Truffle path). No string-substring extraction needed —
// each section parses into a typed grammar element.
function <<test.TestDependency>> platform::pure::compiler::test::assertCompiledGraph(content:String[1], sourceId:String[1]):Boolean[1]
{
    platform::pure::compiler::test::assertCompiledGraph($content, $sourceId, [], []);
}

// With a language extension's compiler passes and graph printers: a fixture holding its section (a
// `###Diagram`, say) compiles and prints like any other. No extensions is exactly the call above.
function <<test.TestDependency>> platform::pure::compiler::test::assertCompiledGraph(content:String[1], sourceId:String[1], extensions:platform::pure::compiler::extension::CompilerExtension[*], printers:Function<{platform::pure::metamodel::PackageableElement[1], platform::pure::compiler::CompilerContext[1]->String[0..1]}>[*]):Boolean[1]
{
    if(!contains($content, '###' + 'Pure'),
        | assert(false, 'Test file has no ###Pure section: ' + $sourceId);,
        | // Every test must declare its expected outcome: either ###Error
          // (compile must produce the listed errors) or ###CompiledGraph
          // (compile must succeed and the AST must match). Without one of
          // those, a green test only proves "didn't throw" — which lets
          // silent semantic drift through.
          let hasError = contains($content, '###' + 'Error');
          let hasGraph = contains($content, '###' + 'CompiledGraph');
          let hasReverse = contains($content, '###' + 'ReverseIndex');
          let hasStats = contains($content, '###' + 'CompilerStats');
          if(!$hasError && !$hasGraph,
              | assert(false, 'Test file has neither ###Error nor ###CompiledGraph section (cannot verify outcome): ' + $sourceId);,
              | // Blank out lines preceding ###Pure (mirrors the original
                // assertCompilationError fixup) so ###Error blocks don't get
                // parsed as Pure code while line numbers stay aligned with
                // ###CompiledGraph references.
                let pureStart = $content->indexOf('###' + 'Pure');
                let preparedContent = if($pureStart > 0,
                    | let prefix = $content->substring(0, $pureStart)->split('\n')->map(l | '')->joinStrings('\n');
                      $prefix + $content->substring($pureStart);,
                    | $content
                );
                let parsedFile = platform::pure::functions::meta::parse($sourceId, $preparedContent);
                // {@code manageFileSections} turns one test-source PureFile into
                // one PureFile per logical file (primary ###Pure + each ###File
                // chunk). Single-file specs collapse to a 1-element list, so the
                // same call path covers both shapes.
                // silent=true — tests pull errors/stats structurally off the
                // result; the CLI progress bar + stats summary would flood the
                // 247-test run with noise.
                let files = manageFileSections($parsedFile);
                let result = if($extensions->isEmpty(),
                    | platform::pure::compiler::compile($files, false, true),
                    | platform::pure::compiler::compile($files, $extensions, false, true));

                // Mandatory-section rules (every test must pin BOTH its AST and
                // its reference telemetry): a success test (###CompiledGraph) must
                // carry a validated ###ReverseIndex; an error test (###Error) must
                // carry a validated ###CompilerStats. Without these the snapshot
                // only covers half the compiler's output and lets reference-index
                // / resolver-stat drift through unnoticed.
                let mandReverse = assert(!$hasGraph || $hasReverse, 'Success test (###CompiledGraph) is missing the mandatory ###ReverseIndex section: ' + $sourceId);
                let mandStats   = assert(!$hasError || $hasStats, 'Error test (###Error) is missing the mandatory ###CompilerStats section: ' + $sourceId);

                let errorCheck = if($hasError,
                                    | assertCompilationErrorOnResult($content, $result, $sourceId);,
                                    | true);
                let graphCheck = if($hasGraph,
                                    | assertCompiledGraphOnResult($parsedFile, $result, $sourceId, $printers);,
                                    | true);
                let reverseCheck = if($hasReverse,
                                    | assertReverseIndexOnResult($parsedFile, $result, $sourceId);,
                                    | true);
                let statsCheck = if($hasStats,
                                    | assertCompilerStatsOnResult($parsedFile, $result, $sourceId);,
                                    | true);
                $errorCheck && $graphCheck && $reverseCheck && $statsCheck;
          );
    );
}

// Back-compat shims for any external callers that still invoke the old
// per-section entry points. Each one re-runs the shared parse+compile path
// internally — the perf benefit only materialises when callers route through
// {@code assertCompiledGraph}.
function <<test.TestDependency>> platform::pure::compiler::test::assertCompilationError(content:String[1], sourceId:String[1]):Boolean[1]
{
    assertCompiledGraph($content, $sourceId);
}

function <<test.TestDependency>> platform::pure::compiler::test::assertCompiledGraphContent(content:String[1], sourceId:String[1]):Boolean[1]
{
    assertCompiledGraph($content, $sourceId);
}

function <<test.TestDependency>> platform::pure::compiler::test::assertCompilationErrorOnResult(content:String[1], result:platform::pure::compiler::CompilationResult[1], sourceId:String[1]):Boolean[1]
{
    let errorSection = $content->substring($content->indexOf('###' + 'Error') + 8);
    // Mirrors Java: each compiler error is a single (possibly multi-line) message.
    // Compare the joined-with-newline text rather than splitting per line — the
    // suggestion candidates beneath a "function not found" message are part of
    // the same error, not separate errors.
    let expectedText = $errorSection->substring(0, $errorSection->indexOf('\n\n'))->trim();
    assert($result.errors->isNotEmpty(), 'Expected compilation error but none occurred for ' + $sourceId);
    let actualText = $result.errors->joinStrings('\n');
    if($expectedText != $actualText, |println('EXPECTED:\n' + $expectedText), |[]);
    if($expectedText != $actualText, |println('ACTUAL:\n' + $actualText), |[]);
    assertEquals($expectedText, $actualText);
}

function <<test.TestDependency>> platform::pure::compiler::test::assertCompiledGraphOnResult(parsedFile:platform::pure::protocol::PureFile[1], result:platform::pure::compiler::CompilationResult[1], sourceId:String[1]):Boolean[1]
{
    platform::pure::compiler::test::assertCompiledGraphOnResult($parsedFile, $result, $sourceId, []);
}

function <<test.TestDependency>> platform::pure::compiler::test::assertCompiledGraphOnResult(parsedFile:platform::pure::protocol::PureFile[1], result:platform::pure::compiler::CompilationResult[1], sourceId:String[1], printers:Function<{platform::pure::metamodel::PackageableElement[1], platform::pure::compiler::CompilerContext[1]->String[0..1]}>[*]):Boolean[1]
{
    // Compilation must produce zero errors when ###CompiledGraph is asserted.
    // A compiler bug that still emits partial elements would otherwise pass
    // the printed-graph comparison silently.
    assert($result.errors->isEmpty(), 'Compilation errors for ' + $sourceId + ':\n  ' + $result.errors->joinStrings('\n  '));

    let allElements = $parsedFile.sections.elements;
    let expectedGraphElement = $allElements->filter(e | $e->instanceOf(platform::pure::compiler::test::CompiledGraph))->head();
    if($expectedGraphElement->isEmpty(),
       | assert(false, 'Test file contains ###CompiledGraph section but CompiledGraph element was not found in parsed output for ' + $sourceId);,
       | let expectedGraphValue = $expectedGraphElement->toOne()->cast(@platform::pure::compiler::test::CompiledGraph).value;
         let actualGraph = platform::pure::compiler::test::printer::printCompiledGraph($result.elements, $result.context->toOne(), $printers);

         let cleanedExpected = $expectedGraphValue->replace('\r', '')->split('\n')->map(s | $s->trim())->joinStrings('\n')->trim();
         let cleanedActual = $actualGraph->replace('\r', '')->split('\n')->map(s | $s->trim())->joinStrings('\n')->trim();
         if($cleanedExpected != $cleanedActual, | println('FAIL:' + $sourceId);, | []);
         assertEquals($cleanedExpected, $cleanedActual);
         true;
    );
}

function <<test.TestDependency>> platform::pure::compiler::test::assertReverseIndexOnResult(parsedFile:platform::pure::protocol::PureFile[1], result:platform::pure::compiler::CompilationResult[1], sourceId:String[1]):Boolean[1]
{
    let allElements = $parsedFile.sections.elements;
    let riElement = $allElements->filter(e | $e->instanceOf(platform::pure::compiler::test::ReverseIndex))->head();
    // An empty `###ReverseIndex` section (reference-free test) parses to no
    // element — treat that as an empty expected index, so it still validates
    // that the compiler produced no reverse references.
    let expectedRaw = if($riElement->isEmpty(), | '', | $riElement->toOne()->cast(@platform::pure::compiler::test::ReverseIndex).value);
    let expected = $expectedRaw->split('\n')->map(s | $s->trim())->filter(s | $s != '')->joinStrings('\n');

    let actualRaw = platform::pure::compiler::test::printer::printReverseIndex($result.context->toOne());
    let actual = $actualRaw->split('\n')->map(s | $s->trim())->filter(s | $s != '')->joinStrings('\n');
    if($expected != $actual, | println('FAIL ReverseIndex:' + $sourceId), | []);
    assertEquals($expected, $actual);
}

function <<test.TestDependency>> platform::pure::compiler::test::assertCompilerStatsOnResult(parsedFile:platform::pure::protocol::PureFile[1], result:platform::pure::compiler::CompilationResult[1], sourceId:String[1]):Boolean[1]
{
    // Pull expected text from the parsed ###CompilerStats element. Routed
    // through the registered parser extension (CompilerStatsLanguageExtension
    // / TruffleCompilerStatsLanguageExtension), so no string substring hack.
    let allElements = $parsedFile.sections.elements;
    let statsElement = $allElements->filter(e | $e->instanceOf(platform::pure::compiler::test::CompilerStats))->head();
    assert($statsElement->isNotEmpty(), '###CompilerStats parsed element not found for ' + $sourceId);
    let expectedRaw = $statsElement->toOne()->cast(@platform::pure::compiler::test::CompilerStats).value;
    let expected = $expectedRaw->split('\n')->map(s | $s->trim())->filter(s | $s != '')->joinStrings('\n');

    assert($result.statistics->isNotEmpty(), 'CompilationResult missing statistics for ' + $sourceId);
    let actualRaw = printCompilerStatsForTest($result.statistics->toOne());
    let actual = $actualRaw->split('\n')->map(s | $s->trim())->filter(s | $s != '')->joinStrings('\n');
    if($expected != $actual, | println('FAIL CompilerStats:' + $sourceId), | []);
    assertEquals($expected, $actual);
}

// Bulk dump of CompilerStats for every {@code .pure} test file under a directory.
// Used to bootstrap or refresh ###CompilerStats sections across the spec tree.
// Emits {@code @@@STATS_BEGIN <fullPath>} ... {@code @@@STATS_END} blocks to
// stdout for an external post-processor to inject back into the source files.
//
// Includes ###Error tests: the resolver telemetry is captured even when the
// compile itself produces errors, so the section reflects the work attempted
// before each candidate's error count tripped the rollback. This is exactly
// the behavior we want to lock in — error compiles ARE part of the resolver
// shape we're tracking.
function <<test.TestDependency>> platform::pure::compiler::test::dumpAllCompilerStats(testDir:String[1]):String[1]
{
    let files = platform::pure::functions::io::directoryTree($testDir)
        ->filter(f | $f->endsWith('.pure'));
    let total = $files->size();
    let prefixLen = $testDir->length() + 1;
    range(0, $total)->map(i |
        let f = $files->at($i);
        let name = $f->substring($prefixLen, $f->length() - 5);
        let raw = platform::pure::functions::io::readFile($f);
        println('@@@STATS_BEGIN ' + $f);
        if(!contains($raw, '###' + 'Pure'),
            | // Surface these — a {@code .pure} file under the spec tree
              // without a ###Pure section bypasses every assertion in
              // {@code assertCompiledGraph} (the harness defaults to
              // {@code true}). Either it's missing the marker by mistake,
              // or it's a fixture that should be relocated. We emit a
              // FAIL block so the post-processor flags it instead of
              // silently dropping it.
              println('STATUS: FAIL_NO_PURE_SECTION'),
            | // Pre-blank ###Error prefix lines (mirrors assertCompilationError's
              // parse fixup). The ###CompilerStats section is parsed by the
              // registered language extension — no strip needed.
              let pureStart = $raw->indexOf('###' + 'Pure');
              let prefix = $raw->substring(0, $pureStart)->split('\n')->map(l | '')->joinStrings('\n');
              let toCompile = $prefix + $raw->substring($pureStart);
              let parsedFile = platform::pure::functions::meta::parse($name, $toCompile);
              let result = platform::pure::compiler::compile($parsedFile, false, true);
              let stats = if($result.statistics->isEmpty(),
                  | 'inferenceRollbacks: 0\ncandidateEvaluations: 0',
                  | printCompilerStatsForTest($result.statistics->toOne())
              );
              println($stats);
        );
        println('@@@STATS_END');
    );
    'Dumped CompilerStats for ' + $total->toString() + ' files';
}

// Render the deterministic subset of CompilationStatistics — counts and the
// rollback-site histogram, but not wall-clock timings — so a Java run and a
// Pure run on the same source can be string-compared. Sites are emitted in
// descending count order; ties broken by site name for determinism.
function <<test.TestDependency>> platform::pure::compiler::test::printCompilerStatsForTest(stats:platform::pure::compiler::CompilationStatistics[1]):String[1]
{
    let header = 'inferenceRollbacks: ' + $stats.inferenceRollbackCount->toString() + '\n'
               + 'candidateEvaluations: ' + $stats.candidateEvaluationCount->toString();
    let entries = $stats.rollbackSites->keyValues();
    if($entries->isEmpty(),
        | $header,
        | let sorted = $entries->sort({a, b |
              let cmp = $b.second - $a.second;
              if($cmp != 0, | $cmp, | if($a.first < $b.first, | -1, | if($a.first > $b.first, | 1, | 0)));
          });
          let lines = $sorted->map(p | '  ' + $p.first + ' = ' + $p.second->toString())->joinStrings('\n');
          $header + '\nrollbackSites:\n' + $lines;
    );
}

// Assert that the resolver-telemetry section of the test file matches what the
// compiler actually produced. Captures: total inferenceRollbacks, total
// candidateEvaluations, and the per-call-site rollback histogram. Wall-clock
// fields are deliberately excluded — non-deterministic across runs.
//
// The expected text is whatever follows the ###CompilerStats marker until EOF
// (or the next ### section). Each line is trimmed and blank lines are dropped
// before comparison so indentation is forgiving.
// Back-compat shim. The single-pass entry point is {@code assertCompiledGraph};
// this routes to it so older callers keep working.
function <<test.TestDependency>> platform::pure::compiler::test::assertCompilerStats(content:String[1], sourceId:String[1]):Boolean[1]
{
    assertCompiledGraph($content, $sourceId);
}
