import meta::pure::compiler::*;
import meta::pure::functions::collection::*;
import meta::pure::functions::string::*;

// Render the compiler's reverse reference index (target -> callers) in the
// `###ReverseIndex` snapshot format: each target path on its own line ending
// with ':', followed by its callers indented two spaces. Targets and callers
// are sorted so the output is deterministic and diff-stable.
function <<test.TestDependency>> meta::pure::compiler::test::printer::printReverseIndex(context:CompilerContext[1]):String[1]
{
    $context.referencedBy->keyValues()
        ->sort({a, b | if($a.first < $b.first, | -1, | if($a.first > $b.first, | 1, | 0))})
        ->map(kv | $kv.first + ':\n' + $kv.second.values
            ->sort({a, b | if($a < $b, | -1, | if($a > $b, | 1, | 0))})
            ->map(c | '  ' + $c)->joinStrings('\n'))
        ->joinStrings('\n');
}
