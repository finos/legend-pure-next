import meta::pure::protocol::*;

// Pure-side type for the ###CompilerStats test section. Mirrors
// meta::pure::compiler::test::CompiledGraph; the Java parser extension
// (CompilerStatsLanguageExtension) creates a CompilerStatsImpl from the raw
// section text and the test harness's assertCompilerStatsOnResult reads its
// `value` to compare against the actual stats.
Class meta::pure::compiler::test::CompilerStats extends meta::pure::protocol::grammar::PackageableElement
{
    value : String[1];
}
