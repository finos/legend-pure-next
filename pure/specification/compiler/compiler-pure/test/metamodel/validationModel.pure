// Metamodel classes breaking, and keeping, the rules of platform::pure::compiler::metamodel::validation.

Class platform::pure::compiler::test::metamodel::validation::model::OptionalDefault
{
   label : String[0..1] = 'none';
}

Class platform::pure::compiler::test::metamodel::validation::model::ManyDefault
{
   tags : String[*] = ['a'];
}

Class platform::pure::compiler::test::metamodel::validation::model::RequiredDefault
{
   kind : String[1] = 'plain';
   names : String[1..*] = ['n'];
}
