// The test package's island values: what its island handlers (islandTestExtension) compile `#ECHO{…}#` and
// `#REF{…}#` to. Real value specifications of a language extension — not m3 — so they reach a PDB as an
// ExtensionValueDef, written and read with this package's generated fbs fragment (generated/islandTest.fbs)
// and writer (generated/writer.pure), both produced by `just bootstrap::generate-writer`. In a `…::metamodel`
// package, as a language extension's metamodel is: the JavaScript translator relies on it to give a
// metamodel instance the concrete classifier the PDB writer needs.

Class platform::pure::compiler::test::islands::metamodel::EchoLiteral extends platform::pure::metamodel::valuespecification::ValueSpecification
{
   text : String[1];
}

Class platform::pure::compiler::test::islands::metamodel::RefLiteral extends platform::pure::metamodel::valuespecification::ValueSpecification
{
   <<platform::pure::metamodel::ProtocolInfo.pointer>> target : platform::pure::metamodel::PackageableElement[1];
}
