// The test island values have their generated blob writers, beside their classes, where m3's writer looks
// for them (writerHelper::writeExtensionValue).
function <<test.Test>> platform::pure::compiler::test::islands::testIslandValuesHaveBlobWriters():Boolean[1]
{
   assert(platform::pure::functions::meta::pathToElement('platform::pure::compiler::test::islands::metamodel::EchoLiteral_pdbValueBlob_Any_1__Binary_1_')->isNotEmpty());
   assert(platform::pure::functions::meta::pathToElement('platform::pure::compiler::test::islands::metamodel::RefLiteral_pdbValueBlob_Any_1__Binary_1_')->isNotEmpty());
}
