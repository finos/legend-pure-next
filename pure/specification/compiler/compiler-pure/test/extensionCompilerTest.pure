// The compiler's extension seam, exercised with a toy language.
//
// `###CompiledGraph` already parses into a carried-text element that every pass ignores, so
// it is the honest subject: the point of the seam is that an extension can turn such an
// element into something real. The extension here claims those elements and registers a
// Class for each, which is enough to prove the delegation reaches pass 1 and that the result
// lands in the graph.

import platform::pure::compiler::*;
import platform::pure::compiler::extension::*;
import platform::pure::compiler::helper::pointer::*;
import platform::pure::compiler::test::*;
import platform::pure::metamodel::*;

// Claims the carried-text elements that `###CompiledGraph` produces.
function platform::pure::compiler::test::extensionTestHandles(e: platform::pure::protocol::grammar::PackageableElement[1]): Boolean[1]
{
   $e->instanceOf(platform::pure::compiler::test::CompiledGraph);
}

// Registers one Class per claimed element, named after the section it came from.
function platform::pure::compiler::test::extensionTestPass1(
   e: platform::pure::protocol::grammar::PackageableElement[1], ctx: CompilerContext[1]): CompilerContext[1]
{
   let path = 'extensionTest::Claimed';
   let pkgRes = getOrCreatePackagePath($ctx, 'extensionTest');
   let shell = ^platform::pure::metamodel::type::Class<Any>(
      name = 'Claimed',
      package = $pkgRes.value->toOne()->toPackagePointer()->cast(@platform::pure::metamodel::Package)
   );
   putElementUnderPackage($pkgRes.context, $path, 'extensionTest', $shell);
}

function platform::pure::compiler::test::extensionTestExtension(): CompilerExtension[1]
{
   ^CompilerExtension(
      name    = 'extensionTest',
      handles = e: platform::pure::protocol::grammar::PackageableElement[1] | extensionTestHandles($e),
      pass1   = {e: platform::pure::protocol::grammar::PackageableElement[1], ctx: CompilerContext[1] |
                   extensionTestPass1($e, $ctx)}
   );
}

function <<test.Test>> platform::pure::compiler::test::testExtensionCompilesAnUnknownSection(): Boolean[1]
{
   let file = platform::pure::functions::meta::parse('extTest',
      '###Pure\nClass a::B {}\n\n###CompiledGraph\nanything at all\n');
   let withExt = platform::pure::compiler::compile($file, extensionTestExtension(), true);
   let paths = $withExt.elements->map(e | $e->elementToPath());
   assert($paths->contains('a::B'), | 'the ordinary class still compiles: ' + $paths->joinStrings(', '));
   assert($paths->contains('extensionTest::Claimed'),
          | 'the extension\'s element reached the graph: ' + $paths->joinStrings(', '));
   true;
}

function <<test.Test>> platform::pure::compiler::test::testWithoutExtensionTheSectionIsIgnored(): Boolean[1]
{
   // The behaviour that was there before the seam existed, and must still be there: with no
   // extension registered, the carried-text element contributes nothing at all.
   let file = platform::pure::functions::meta::parse('extTest',
      '###Pure\nClass a::B {}\n\n###CompiledGraph\nanything at all\n');
   let plain = platform::pure::compiler::compile($file, [], true);
   let paths = $plain.elements->map(e | $e->elementToPath());
   assert($paths->contains('a::B'), | 'the ordinary class compiles');
   assert(!$paths->contains('extensionTest::Claimed'), | 'nothing was claimed');
   true;
}
