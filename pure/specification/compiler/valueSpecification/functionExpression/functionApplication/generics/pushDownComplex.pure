###Pure
// Push-down with nested generic-binding: the outer groupBy needs to bind
// {T,U,V} from the resolved types of an inner collection of agg<K,L,M>
// invocations. Each agg call's K/L/M flow into the outer's V/U binding.
// Exercises multi-candidate dispatch + reverse-match on nested function
// applications + collection-element type unification.

Class test::AggregateValue<A, B, C>
{
   mapFn : FunctionDefinition<{A[1]->B[1]}>[1];
   aggregateFn : FunctionDefinition<{B[*]->C[1]}>[1];
}

Class test::TabularDataSet
{
}

Class Trade
{
   tradeId : Integer[1];
   quantity : Float[1];
}

native function sum(s:Number[*]):Number[1];

native function count(s:Any[*]):Integer[1];

function test::agg<K, L, M>(mapFn:FunctionDefinition<{K[1]->L[1]}>[1], aggregateFn:FunctionDefinition<{L[*]->M[1]}>[1]):test::AggregateValue<K, L, M>[1]
{
   ^test::AggregateValue<K, L, M>(mapFn=$mapFn, aggregateFn=$aggregateFn)
}

function test::groupBy<T, U, V>(set:T[*], functions:Function<{T[1]->Any[*]}>[*], aggValues:test::AggregateValue<T, V, U>[*], ids:String[*]):test::TabularDataSet[1]
{
   ^test::TabularDataSet()
}

function go():Any[*]
{
   Trade->getAll()
        ->test::groupBy([f | $f.quantity],
                        [test::agg(f | $f.tradeId, c | $c->count()),
                         test::agg(x | $x.quantity, x | $x->sum())],
                        ['region', 'total', 'count'])
}

