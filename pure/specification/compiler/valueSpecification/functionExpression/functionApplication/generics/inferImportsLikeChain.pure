###Pure
// Distilled from legend-pure-next/pure/language/java/pure/metamodel_factories.pure ::inferImports.
// Reproduces the structural shape that makes that function the dominant pass-3 cost for the
// Pure compiler on Truffle (~60% of total compile time on the metamodel-factories build) without
// depending on the language/java metamodel — uses self-contained classes and core stdlib only so
// it can stand alone as a parity test.
//
// The cost driver is the wide fluent chain
//   `->concatenate(...)->concatenate(...)->...->filter(lambda)->exists(lambda)`
// over heterogeneous property types (Field/Method/Constructor), where each chain link's
// type-parameter binding depends on the resolved type of the previous link, and the inner
// lambdas use `removeDuplicatesBy` / `filter` / `exists` overloads that drive the multi-candidate
// resolution path. This is the same shape that produced 21 candidate-failed rollbacks on Java
// and 0 on Pure-on-Truffle while both still produce identical compiled graphs — i.e. exercises
// the divergent rollback distribution we want to track in regression.
import test::factory::*;

Class test::factory::TestType
{
    pkg : String[1];
    name : String[1];
}

Class test::factory::TestField
{
    name : String[1];
    fieldType : TestType[1];
    annotations : TestType[*];
}

Class test::factory::TestMethod
{
    name : String[1];
    returnType : TestType[1];
    paramTypes : TestType[*];
    annotations : TestType[*];
}

Class test::factory::TestConstructor
{
    paramTypes : TestType[*];
    annotations : TestType[*];
}

Class test::factory::TestClass
{
    pkg : String[1];
    name : String[1];
    superType : TestType[0..1];
    interfaces : TestType[*];
    fields : TestField[*];
    methods : TestMethod[*];
    constructors : TestConstructor[*];
    annotations : TestType[*];
}

function test::factory::qualifiedName(t : TestType[1]) : String[1]
{
    $t.pkg + '::' + $t.name
}

function test::factory::collectAnnotationTypes(c : TestClass[1]) : TestType[*]
{
    $c.annotations
        ->concatenate($c.fields.annotations)
        ->concatenate($c.methods.annotations)
        ->concatenate($c.constructors.annotations)
}

function test::factory::collectStructuralTypes(c : TestClass[1]) : TestType[*]
{
    $c.interfaces
        ->concatenate(if($c.superType->isEmpty(), | [], | $c.superType->toOne()))
        ->concatenate($c.fields.fieldType)
        ->concatenate($c.methods.returnType)
        ->concatenate($c.methods.paramTypes)
        ->concatenate($c.constructors.paramTypes)
}

function test::factory::inferImportsLike(c : TestClass[1]) : String[*]
{
    let annotationsTypes = collectAnnotationTypes($c);
    let structuralTypes = collectStructuralTypes($c);
    let allTypes = $structuralTypes
                       ->concatenate($annotationsTypes)
                       ->removeDuplicatesBy(t | qualifiedName($t));
    let inSamePackage = $allTypes->filter(t | $t.pkg == $c.pkg);
    let toImport = $allTypes->filter(t | !$inSamePackage->exists(s | qualifiedName($s) == qualifiedName($t)));
    $toImport->map(t | qualifiedName($t))->sort();
}

