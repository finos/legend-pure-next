###Pure
// Regression test for nested-typeArgument binding: when a generic function (here `put<U,V>`)
// is called with a typed argument `List<V_outer>`, the resolved binding for V should preserve
// the inner typeArgument [V_outer] — i.e. `typeParam V -> #List<V_outer>#`, not `typeParam V -> #List#`.
//
// As of writing, Pure fails this test (V binding loses inner typeArgument); Java passes.
// Reproduces the self-host parity diff at:
//   ...putMapList.expressionSequence[2].resolvedTypeParameters[name=V].value.typeArguments.size

function test::wrapAndPut<K,V>(map:Map<K,List<V>>[1], key:K[1], value:V[1]):Map<K,List<V>>[1]
{
    let nl = ^List<V>(values=[$value]);
    $map->put($key, $nl);
}

