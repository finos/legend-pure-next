    :package :meta_pure_metamodel_pointer ;
    :generalizations [ a :Generalization ; :classifierGenericType :GenericType_meta_pure_metamodel_relationship_Generalization ; :specific :TempCompilerPointer ; :general :GenericType_meta_pure_metamodel_type_Any ] .

:TempCompilerPointer_path a :Property ;
    :abstractProperty_name [ :classifierGenericType :GenericType_meta_pure_metamodel_type_primitives_String ; :data "path" ] ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_meta_pure_metamodel_type_generics_UserDefinedGenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_meta_pure_metamodel_type_generics_UserDefinedGenericType ; :type :TempCompilerPointer ] :GenericType_meta_pure_metamodel_type_primitives_String ) ; :multiplicityArguments :PureOne ] ;
    :owner :TempCompilerPointer ;
    :genericType :GenericType_meta_pure_metamodel_type_primitives_String ;
    :multiplicity :PureOne .

