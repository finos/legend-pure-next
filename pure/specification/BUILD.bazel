load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/bazel:pure.bzl", "pure_bootstrap_compile", "pure_compile")

# The M3 specification the generators read, and the field-ID registry they keep.

exports_files(
    [
        "m3.ttl",
        "m3-fbs-field-ids.txt",
        "m3_fbs_addition.fbs",
        "m3_protocol_addition.ttl",
        "module.json",
        "compiler/compiler-pure/module.json",
        "compiler/compiler-pure/test/islands/islandTest-fbs-field-ids.txt",
        "language_pure.json",
        "language_test.json",
        "grammar/antlr/m3/M3Lexer.g4",
    ],
    visibility = ["//visibility:public"],
)

# The ANTLR grammars, laid out by package: m3/ is the package below the top-level one.
filegroup(
    name = "grammar_antlr",
    srcs = glob(["grammar/antlr/**/*.g4"]),
    visibility = ["//visibility:public"],
)

# The parser round-trip fixtures: a .pure source and its protocol .json per case.
filegroup(
    name = "grammar_tests",
    srcs = glob(["grammar/tests/**"]),
    visibility = ["//visibility:public"],
)

# The Pure sources of core.pdb and core-tests.pdb.
filegroup(
    name = "runtime_sources",
    srcs = glob(["runtime/**"]),
    visibility = ["//visibility:public"],
)

# Every file of the specification: what the bootstrap tests read, by walking up to pure/specification.
filegroup(
    name = "all",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

# The Pure sources of parser-mappings.pdb: the visitor mappings of the grammar.
filegroup(
    name = "parser_mappings_sources",
    srcs = glob(["grammar/mapping/mappings-pure/**"]),
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------------------------------------------------
# compiler.pdb and compiler-tests.pdb (bootstrap/Justfile: generate-writer, build-compiler-pdb).
#
# compiler-pure needs its generated writer (pdb/writer/generated/generatedWriter.pure), which a compiled compiler-pure
# generates: pass 1 compiles it without the generated sources, runs the generators, and pass 2 compiles it with them.
# The generated sources are outputs here, never written to the source tree (where they are gitignored).

_CLI = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli:pure-bootstrap"

_CORE_PDB = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-compiler:core.pdb"

_CORE_TESTS_PDB = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-compiler:core-tests.pdb"

_M3_FBS = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-generators:generated-specification/m3.fbs"

# The licence header of a generated source: the generators emit only their AUTO-GENERATED banner.
_LICENSE_HEADER = " ".join(["printf '%s\\n'"] + ["'%s'" % line for line in [
    "// ©2026 JP Morgan Chase & Co. All rights reserved.",
    "//",
    "// Licensed under the Apache License, Version 2.0 (the \"License\");",
    "// you may not use this file except in compliance with the License.",
    "// You may obtain a copy of the License at",
    "//",
    "//      http://www.apache.org/licenses/LICENSE-2.0",
    "//",
    "// Unless required by applicable law or agreed to in writing, software",
    "// distributed under the License is distributed on an \"AS IS\" BASIS,",
    "// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.",
    "// See the License for the specific language governing permissions and",
    "// limitations under the License.",
]])

# Runs 'pure-bootstrap execute' over core and pass 1, from a directory holding shared/specification/m3.fbs: the
# generator reads it there, relative to its working directory. Its standard output goes to $$OUT.
_EXECUTE_ON_PASS1 = """
    set -e
    R=$$PWD
    W=$$(mktemp -d)
    mkdir -p $$W/shared/specification
    cp $(execpath {m3_fbs}) $$W/shared/specification/m3.fbs
    M3_FBS=$$W/shared/specification/m3.fbs
    OUT=$$W/stdout
    run() {{
        (cd $$W && $$R/$(execpath {cli}) execute \\
            --pdb $$R/$(execpath {core}) --pdb $$R/$(execpath {core_tests}) \\
            --pdb $$R/$(execpath :pass1/compiler.pdb) --pdb $$R/$(execpath :pass1/compiler-tests.pdb) "$$@") > $$OUT 2> $$W/stderr \\
            || {{ cat $$W/stderr >&2; exit 1; }}
    }}
""".format(m3_fbs = _M3_FBS, cli = _CLI, core = _CORE_PDB, core_tests = _CORE_TESTS_PDB)

_PASS1_INPUTS = [
    _CORE_PDB,
    _CORE_TESTS_PDB,
    _M3_FBS,
    ":pass1/compiler.pdb",
    ":pass1/compiler-tests.pdb",
]

filegroup(
    name = "compiler_sources",
    srcs = glob([
        "compiler/compiler-pure/**/*.pure",
        "compiler/compiler-pure/module.json",
    ]),
)

pure_bootstrap_compile(
    name = "compiler_pass1",
    srcs = [":compiler_sources"],
    base_pdbs = [_CORE_PDB],
    outs = [
        "pass1/compiler.pdb",
        "pass1/compiler-tests.pdb",
    ],
    source_dir = "pure/specification/compiler/compiler-pure",
    split_tests = True,
)

genrule(
    name = "generated_writer",
    srcs = _PASS1_INPUTS,
    outs = ["compiler/generated/generatedWriter.pure"],
    cmd = _EXECUTE_ON_PASS1 + """
        run --function "platform::pure::compiler::pdb::generator::printGeneratedWriter__Boolean_1_"
        awk '/===GENWRITER-BEGIN===/{f=1;next} /===GENWRITER-END===/{f=0} f' $$OUT > $$W/body
        test -s $$W/body || { echo "printGeneratedWriter produced no output between its markers" >&2; exit 1; }
        { %s; cat $$W/body; } > $@
    """ % _LICENSE_HEADER,
    tools = [_CLI],
)

# The test island values: their FlatBuffer fragment, and the registry of its field IDs it was generated with (the
# tracked registry is an input: //tools/bazel:island_fbs_ids_up_to_date checks it is current).
genrule(
    name = "island_fbs",
    srcs = _PASS1_INPUTS + ["compiler/compiler-pure/test/islands/islandTest-fbs-field-ids.txt"],
    outs = [
        "compiler/generated/islandTest.fbs",
        "compiler/generated/islandTest-fbs-field-ids.txt",
    ],
    cmd = _EXECUTE_ON_PASS1 + """
        run --function "platform::pure::compiler::pdb::fbsgen::printFbs_String_1__String_1__String_1__Boolean_1_" \\
            --args "platform::pure::compiler::test::islands::metamodel" $$M3_FBS \\
            $$R/$(execpath compiler/compiler-pure/test/islands/islandTest-fbs-field-ids.txt)
        awk '/^===FBS-BEGIN===$$/{f=1;next} /^===FBS-END===$$/{f=0} f' $$OUT > $(execpath compiler/generated/islandTest.fbs)
        awk '/^===IDS-BEGIN===$$/{f=1;next} /^===IDS-END===$$/{f=0} f' $$OUT > $(execpath compiler/generated/islandTest-fbs-field-ids.txt)
        test -s $(execpath compiler/generated/islandTest.fbs) || { echo "printFbs produced nothing for the test island values" >&2; exit 1; }
    """,
    tools = [_CLI],
    visibility = ["//visibility:public"],
)

genrule(
    name = "island_writer",
    srcs = _PASS1_INPUTS + ["compiler/generated/islandTest.fbs"],
    outs = ["compiler/generated/islandWriter.pure"],
    cmd = _EXECUTE_ON_PASS1 + """
        run --function "platform::pure::compiler::pdb::generator::printExtensionWriter_String_1__String_1__String_1__String_1__Boolean_1_" \\
            --args $$M3_FBS $$R/$(execpath compiler/generated/islandTest.fbs) \\
            "platform::pure::compiler::test::islands::metamodel" "platform::pure::compiler::test::islands::pdb::gen"
        { %s; awk '/^===GENWRITER-BEGIN===$$/{f=1;next} /^===GENWRITER-END===$$/{f=0} f' $$OUT; } > $@
        grep -q '_pdbValueBlob' $@ || { echo "printExtensionWriter produced no value writers for the test island values" >&2; exit 1; }
    """ % _LICENSE_HEADER,
    tools = [_CLI],
)

pure_bootstrap_compile(
    name = "compiler_pdbs",
    srcs = [":compiler_sources"],
    base_pdbs = [_CORE_PDB],
    generated = {
        ":compiler/generated/generatedWriter.pure": "pdb/writer/generated/generatedWriter.pure",
        ":compiler/generated/islandWriter.pure": "test/islands/generated/writer.pure",
    },
    outs = [
        "compiler.pdb",
        "compiler-tests.pdb",
    ],
    source_dir = "pure/specification/compiler/compiler-pure",
    split_tests = True,
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------------------------------------------------
# Self-host (just: truffle::spec-compiler-selfhost): compiler-pure compiled by the Truffle CLI, the compiler written in
# Pure, which must be the compiler the bootstrap compiles, element for element. Run on demand (tags 'manual',
# 'selfhost'); the Truffle host runs the compiler corpus on it (//platforms/truffle:compiler_compiler_selfhost).

pure_compile(
    name = "compiler_pdbs_truffle",
    srcs = [":compiler_sources"],
    base_pdbs = [
        _CORE_PDB,
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-grammar/legend-pure-next-bootstrap-grammar-validation:parser-mappings.pdb",
        _CORE_TESTS_PDB,
        ":compiler.pdb",
    ],
    generated = {
        ":compiler/generated/generatedWriter.pure": "pdb/writer/generated/generatedWriter.pure",
        ":compiler/generated/islandWriter.pure": "test/islands/generated/writer.pure",
    },
    outs = [
        "selfhost/compiler.pdb",
        "selfhost/compiler-tests.pdb",
    ],
    source_dir = "pure/specification/compiler/compiler-pure",
    split_tests = True,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

[sh_test(
    name = "compiler_selfhost_matches_bootstrap" + suffix,
    srcs = ["//tools/bazel:pdb-diff.sh"],
    args = [
        "$(rootpath %s)" % _CLI,
        "$(rootpath %s)" % _CORE_PDB,
        "$(rootpath :%s)" % pdb,
        "$(rootpath :selfhost/%s)" % pdb,
    ],
    data = [
        _CLI,
        _CORE_PDB,
        ":" + pdb,
        ":selfhost/" + pdb,
    ],
    tags = [
        "manual",
        "selfhost",
    ],
) for suffix, pdb in [
    ("", "compiler.pdb"),
    ("_tests", "compiler-tests.pdb"),
]]

# The same self-host check for the native image (just: truffle::native::spec-compiler-selfhost).

pure_compile(
    name = "compiler_pdbs_truffle_native",
    srcs = [":compiler_sources"],
    base_pdbs = [
        _CORE_PDB,
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-grammar/legend-pure-next-bootstrap-grammar-validation:parser-mappings.pdb",
        _CORE_TESTS_PDB,
        ":compiler.pdb",
    ],
    generated = {
        ":compiler/generated/generatedWriter.pure": "pdb/writer/generated/generatedWriter.pure",
        ":compiler/generated/islandWriter.pure": "test/islands/generated/writer.pure",
    },
    outs = [
        "selfhost-native/compiler.pdb",
        "selfhost-native/compiler-tests.pdb",
    ],
    source_dir = "pure/specification/compiler/compiler-pure",
    split_tests = True,
    tags = ["manual"],
    tool = "truffle-native",
    visibility = ["//visibility:public"],
)

[sh_test(
    name = "compiler_selfhost_native_matches_bootstrap" + suffix,
    srcs = ["//tools/bazel:pdb-diff.sh"],
    args = [
        "$(rootpath %s)" % _CLI,
        "$(rootpath %s)" % _CORE_PDB,
        "$(rootpath :%s)" % pdb,
        "$(rootpath :selfhost-native/%s)" % pdb,
    ],
    data = [
        _CLI,
        _CORE_PDB,
        ":" + pdb,
        ":selfhost-native/" + pdb,
    ],
    tags = [
        "manual",
        "selfhost",
    ],
) for suffix, pdb in [
    ("", "compiler.pdb"),
    ("_tests", "compiler-tests.pdb"),
]]

# The specification in the output tree, where the JavaScript platform tests read it, by its path relative to their own.
copy_to_bin(
    name = "all_in_bin",
    srcs = [":all"],
    visibility = ["//visibility:public"],
)

# The bootstrap self-host check (just: bootstrap::spec-compiler-selfhost): compiler-pure compiled by the compiler
# written in Pure, run on the bootstrap (compile-via-pure), against the one the bootstrap compiles in Java.
pure_compile(
    name = "compiler_pdbs_bootstrap_via_pure",
    srcs = [":compiler_sources"],
    base_pdbs = [
        _CORE_PDB,
        _CORE_TESTS_PDB,
        ":compiler.pdb",
    ],
    command = "compile-via-pure",
    generated = {
        ":compiler/generated/generatedWriter.pure": "pdb/writer/generated/generatedWriter.pure",
        ":compiler/generated/islandWriter.pure": "test/islands/generated/writer.pure",
    },
    outs = [
        "selfhost-bootstrap/compiler.pdb",
        "selfhost-bootstrap/compiler-tests.pdb",
    ],
    source_dir = "pure/specification/compiler/compiler-pure",
    split_tests = True,
    tags = ["manual"],
    tool = "bootstrap",
    visibility = ["//visibility:public"],
)

[sh_test(
    name = "compiler_selfhost_bootstrap_matches_bootstrap" + suffix,
    srcs = ["//tools/bazel:pdb-diff.sh"],
    args = [
        "$(rootpath %s)" % _CLI,
        "$(rootpath %s)" % _CORE_PDB,
        "$(rootpath :%s)" % pdb,
        "$(rootpath :selfhost-bootstrap/%s)" % pdb,
    ],
    data = [
        _CLI,
        _CORE_PDB,
        ":" + pdb,
        ":selfhost-bootstrap/" + pdb,
    ],
    tags = [
        "bootstrap",
        "manual",
        "selfhost",
    ],
) for suffix, pdb in [
    ("", "compiler.pdb"),
    ("_tests", "compiler-tests.pdb"),
]]

# The bootstrap host checks (Section 2.2), on demand: the M3 schema the compiler written in Pure generates against the
# one the bootstrap generates (just: check-fbs-parity), and the metamodel validation (just: check-metamodel).
[sh_test(
    name = name,
    srcs = ["//tools/bazel:runs.sh"],
    args = [
        "$(rootpath %s)" % _CLI,
        "execute",
        "--pdb",
        "$(rootpath %s)" % _CORE_PDB,
    ] + extra_pdbs + [
        "--pdb",
        "$(rootpath :compiler.pdb)",
    ] + tests_pdbs + [
        "--function",
        function,
        "--args",
    ] + args,
    data = [
        _CLI,
        _CORE_PDB,
        _CORE_TESTS_PDB,
        ":compiler.pdb",
        ":compiler-tests.pdb",
        ":m3-fbs-field-ids.txt",
        "//:shared/specification/m3.fbs",
    ],
    tags = [
        "bootstrap",
        "manual",
    ],
) for name, extra_pdbs, tests_pdbs, function, args in [
    (
        "check_fbs_parity",
        [],
        [],
        "platform::pure::compiler::pdb::fbsgen::printFbsParity_String_1__String_1__Boolean_1_",
        ["$(rootpath //:shared/specification/m3.fbs)", "$(rootpath :m3-fbs-field-ids.txt)"],
    ),
    (
        "check_metamodel",
        ["--pdb", "$(rootpath %s)" % _CORE_TESTS_PDB],
        ["--pdb", "$(rootpath :compiler-tests.pdb)"],
        "platform::pure::compiler::metamodel::validation::printMetamodelValidation_String_1__Boolean_1_",
        ["platform::pure::metamodel,platform::pure::compiler::test::islands::metamodel"],
    ),
]]
