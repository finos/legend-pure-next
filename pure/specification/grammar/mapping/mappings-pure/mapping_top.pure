// Top-level parser visitor (TopParser, not M3).
//
// Walks the document/section/importStatement context tree produced by the
// bootstrap TopParser ANTLR grammar and builds a `PureFile` PDO with its
// `Section` children. Section content is dispatched through a single
// Pure-side registry of (name, parserLambda) pairs supplied by the caller;
// a section name with no matching entry is a hard error.
//
// Replaces the bespoke `top-mappings.dsl` text DSL and its Java codegen.

import platform::pure::functions::meta::antlr::*;
import platform::pure::parser::mappings::interpreter::*;
import platform::pure::protocol::grammar::*;

// Entry point. Called from every host with:
//   ctx              - the TopParser.DocumentContext (opaque AntlrContext)
//   sourceId         - the source identifier (e.g. file path)
//   registry         - Pure-side Pair<name, parserLambda>[*]. Every section
//                      name found in the document must have a matching entry
//                      here; missing entries throw.
//
// The text before the first `###` header is the document's implicit section,
// which is Pure — unless it is only comments and blank lines above a header
// (a licence header), which is no section at all. A file naming no section is
// always one Pure section, even an empty one.
function platform::pure::parser::mappings::interpreter::parseDocument(
   ctx: AntlrContext[1],
   sourceId: String[1],
   registry: platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>[*]
): platform::pure::protocol::PureFile[1]
{
   let implicit = $ctx->getChild('implicitSection')->toOne();
   let sections = $ctx->getChildren('section');
   let keepImplicit = $sections->isEmpty() || $implicit->getChildren('importStatement')->isNotEmpty() || (sectionText($implicit) != '');
   ^platform::pure::protocol::PureFile(
      sourceId = $sourceId,
      sections = if($keepImplicit, | buildSectionBody('Pure', $implicit, $sourceId, $registry), | [])
                    ->concatenate($sections->map(s | buildSection($s, $sourceId, $registry)))
   );
}

// One section: `###Name (import …)* sectionBody?`.
function platform::pure::parser::mappings::interpreter::buildSection(
   ctx: AntlrContext[1],
   sourceId: String[1],
   registry: platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>[*]
): platform::pure::protocol::Section[1]
{
   let header = $ctx->getTokenText('SECTION_HEADER')->toOne();
   buildSectionBody($header->substring(3, $header->length()), $ctx, $sourceId, $registry);
}

// The imports and body of a section or of the implicit section (both rules end in
// `importStatement* sectionContent?`). The body's text is dispatched to the
// registry entry matching the section name.
function platform::pure::parser::mappings::interpreter::buildSectionBody(
   sectionName: String[1],
   ctx: AntlrContext[1],
   sourceId: String[1],
   registry: platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>[*]
): platform::pure::protocol::Section[1]
{
   let content = sectionText($ctx);
   let elements = if($content == '',
                     | [],
                     | dispatchSection($registry, $sectionName, $content, $sourceId, computeFirstNonNewlineLine($ctx->getChild('sectionContent'))));
   ^platform::pure::protocol::Section(
      parserName = $sectionName,
      imports    = $ctx->getChildren('importStatement')->map(i | buildImport($i)),
      elements   = $elements
   );
}

// A section's body text, trimmed; '' when it has none.
function platform::pure::parser::mappings::interpreter::sectionText(ctx: AntlrContext[1]): String[1]
{
   let sectionContent = $ctx->getChild('sectionContent');
   if($sectionContent->isNotEmpty(),
      | $sectionContent->toOne()->getChildren('contentToken')
                                ->map(t | $t->getText())
                                ->joinStrings('')->trim(),
      | '');
}

// Pure-side section dispatch: look up `name` in the registry, evaluate the
// matching lambda, throw if no entry. There is no host-side fallback —
// every section type must be in the registry.
function platform::pure::parser::mappings::interpreter::dispatchSection(
   registry: platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>[*],
   name: String[1],
   content: String[1],
   sourceId: String[1],
   lineOffset: Integer[1]
): platform::pure::protocol::grammar::PackageableElement[*]
{
   let match = $registry->filter(p | $p.first == $name)->head();
   if($match->isNotEmpty(),
      | $match->toOne().second->eval($content, $sourceId, $lineOffset),
      | let thrown = fail('No parser registered for section: ###' + $name);
        []->cast(@platform::pure::protocol::grammar::PackageableElement););
}

// `import x::y::z` (no semicolon — IMPORT_STATEMENT captures the full literal).
// Strip the leading `import ` and trim trailing whitespace.
function platform::pure::parser::mappings::interpreter::buildImport(ctx: AntlrContext[1]): String[1]
{
   let raw = $ctx->getTokenText('IMPORT_STATEMENT')->toOne();
   $raw->substring(7, $raw->length())->trim();
}

// Built-in section parser for `###Pure`: parses the section body with the
// M3 grammar via parseAntlr and dispatches to the Pure interpreter
// (parseElements / allRules from the M3 mapping rules). Bundled into the
// default registry by callers that want vanilla Pure-source parsing.
function platform::pure::parser::mappings::interpreter::pureSectionParser():
   platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>[1]
{
   ^platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>(
      first  = 'Pure',
      second = {c:String[1], s:String[1], o:Integer[1] |
                  platform::pure::parser::mappings::interpreter::parseElements(
                     platform::pure::functions::meta::antlr::parseAntlr($c, 'M3Parser', $s, $o),
                     platform::pure::parser::mappings::allRules(),
                     $o)});
}

// No-op section parser: matches `name` and produces zero elements. Useful for
// callers that want to acknowledge a section type without parsing its body
// (e.g. structural validators that only need the top-level shape).
function platform::pure::parser::mappings::interpreter::noOpSectionParser(name: String[1]):
   platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>[1]
{
   ^platform::pure::functions::collection::Pair<String, platform::pure::metamodel::function::Function<{String[1], String[1], Integer[1] -> platform::pure::protocol::grammar::PackageableElement[*]}>>(
      first  = $name,
      second = {c:String[1], s:String[1], o:Integer[1] |
                  []->cast(@platform::pure::protocol::grammar::PackageableElement)});
}
