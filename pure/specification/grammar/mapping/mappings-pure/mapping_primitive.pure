// Mapping for the `Primitive` top-level element.
//
// Grammar: primitiveDefinition: PRIMITIVE stereotypes? taggedValues? qualifiedName
//                               typeVariableParameters? EXTENDS type constraints?
//
// Initial scope: name + package + stereotypes/taggedValues + single
// generalization (extends T). typeVariableParameters + constraints deferred
// (need typeVariable + lambda machinery).

import platform::pure::parser::mappings::*;
import platform::pure::functions::meta::antlr::*;
import platform::pure::parser::mappings::interpreter::*;
import platform::pure::protocol::grammar::*;

function platform::pure::parser::mappings::primitiveDefinition(): Rule[1]
{
   ^Rule(name='primitiveDefinition', alts = [
      ^Alt(returnExpr = {ctx: AntlrContext[1], o: Integer[1] |
         let qn = $ctx->getChild('qualifiedName')->toOne()->getText();
         ^platform::pure::protocol::grammar::type::PrimitiveType(
            p_sourceInformation = buildSourceInfo($ctx, $o),
            name                = simpleNameOf($qn),
            package             = packagePtrOf($qn),
            typeVariables       = $ctx->getChild('typeVariableParameters')
                                       ->map(t | $t->getChildren('functionVariableExpression')
                                                   ->map(v | buildFunctionVariableExpression($v, $o))),
            generalizations     = $ctx->getChild('type')->map(t | buildClassGeneralization($t, $o)),
            constraints         = $ctx->getChild('constraints')
                                       ->map(c | $c->getChildren('constraint')->map(con | buildConstraint($con, $o))),
            stereotypes         = collectStereotypes($ctx, $o),
            taggedValues        = collectTaggedValues($ctx, $o)
         );
      })
   ])
}
