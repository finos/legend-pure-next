// Shared helpers used by all mapping_<packageableElement>.pure files.
//
// `buildSourceInfo` mirrors the offsets the .dsl's `buildSourceInfo($ctx)` computes:
//   start = (line + lineOffset, charPositionInLine + 1)        // 1-based column
//   end   = (line + lineOffset, charPositionInLine + textLength)
// `lineOffset` is the line number (within the original source file) of the
// section body the ANTLR parser saw — added so source info ends up
// file-relative instead of section-relative. Both pipelines must agree on
// these or the validator will diff every test case.

import platform::pure::parser::mappings::*;
import platform::pure::functions::meta::antlr::*;
import platform::pure::parser::mappings::interpreter::*;
import platform::pure::protocol::grammar::*;
import platform::pure::protocol::grammar::extension::*;

function platform::pure::parser::mappings::buildSourceInfo(ctx: AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::SourceInformation[1]
{
   ^platform::pure::protocol::grammar::SourceInformation(
      startLine   = $ctx->getStartLine() + $lineOffset,
      startColumn = $ctx->getStartColumn(),
      endLine     = $ctx->getStopLine() + $lineOffset,
      endColumn   = $ctx->getStopColumn()
   )
}

// `foo::bar::Baz` → simple name `Baz`. Bare `Baz` → `Baz`.
function platform::pure::parser::mappings::simpleNameOf(qualifiedName: String[1]): String[1]
{
   $qualifiedName->split('::')->last()->toOne()
}

// `foo::bar::Baz` → `^Package_Pointer(value='foo::bar')`; bare `Baz` → empty.
// Mirrors `ifPresent(hasPackagePrefix(qn), newImpl(Package_Pointer, value=packagePrefix(qn)))`.
function platform::pure::parser::mappings::packagePtrOf(qualifiedName: String[1]): Package_Pointer[0..1]
{
   let parts = $qualifiedName->split('::');
   if($parts->size() > 1,
      | ^Package_Pointer(value = $parts->init()->joinStrings('::')),
      | []);
}

// Mirrors the `.dsl`'s stripQuotes: removes the leading + trailing `'`.
function platform::pure::parser::mappings::stripQuotes(text: String[1]): String[1]
{
   $text->substring(1, $text->length() - 1)
}

// -----------------------------------------------------------------------
// Per-application stereotype + taggedValue helpers. Used by every element
// that supports `<<…>>` / `{…}` decorations (Class, Enum, Profile element,
// Property, QualifiedProperty, enum value, etc.). Mirrors the .dsl's
// `stereotype` / `taggedValue` rules.
//
// Grammar (per .dsl):
//   stereotype:   qualifiedName DOT identifier
//   taggedValue:  qualifiedName DOT identifier EQUAL STRING (PLUS STRING)*
// -----------------------------------------------------------------------

function platform::pure::parser::mappings::buildStereotypeApp(ctx: platform::pure::functions::meta::antlr::AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::extension::Stereotype_Pointer[1]
{
   let qn = $ctx->getChild('qualifiedName')->toOne();
   let id = $ctx->getChild('identifier')->toOne();
   ^platform::pure::protocol::grammar::extension::Stereotype_Pointer(
      p_sourceInformation = buildSourceInfo($qn, $lineOffset),
      value              = $qn->getText(),
      extraPointerValues = [^platform::pure::protocol::grammar::PointerValue(
         p_sourceInformation = buildSourceInfo($id, $lineOffset),
         value             = $id->getText()
      )]
   );
}

function platform::pure::parser::mappings::buildTaggedValueApp(ctx: platform::pure::functions::meta::antlr::AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::extension::TaggedValue[1]
{
   let qn = $ctx->getChild('qualifiedName')->toOne();
   let id = $ctx->getChild('identifier')->toOne();
   ^platform::pure::protocol::grammar::extension::TaggedValue(
      tag = ^platform::pure::protocol::grammar::extension::Tag_Pointer(
         p_sourceInformation = buildSourceInfo($qn, $lineOffset),
         value              = $qn->getText(),
         extraPointerValues = [^platform::pure::protocol::grammar::PointerValue(
            p_sourceInformation = buildSourceInfo($id, $lineOffset),
            value             = $id->getText()
         )]
      ),
      value = $ctx->getTokenTexts('STRING')->map(s | stripQuotes($s))->joinStrings('')
   );
}

// `getChild('stereotypes')` returns the optional `<<…>>` wrapper context, which
// itself contains a list of `stereotype` ctxs. Helper collapses the lookup.
function platform::pure::parser::mappings::collectStereotypes(ctx: platform::pure::functions::meta::antlr::AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::extension::Stereotype_Pointer[*]
{
   $ctx->getChild('stereotypes')
        ->map(s | $s->getChildren('stereotype')->map(c | buildStereotypeApp($c, $lineOffset)))
}

function platform::pure::parser::mappings::collectTaggedValues(ctx: platform::pure::functions::meta::antlr::AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::extension::TaggedValue[*]
{
   $ctx->getChild('taggedValues')
        ->map(t | $t->getChildren('taggedValue')->map(c | buildTaggedValueApp($c, $lineOffset)))
}
