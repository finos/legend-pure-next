// Column-builder grammar: `~col`, `~col : T[m]`, `~col : lambda`,
// `~col : lambda : aggLambda`, plus their array forms `~[a, b, c]`.
//
// Dispatch (mirrors the .dsl rule `columnBuilders`):
//   - Array form with any aggregator (`extraFunction`): aggColSpecArray
//   - Array form with any map-only lambda (`anyLambda`): funcColSpecArray
//   - Array form otherwise: colSpecArray (names + combined RelationType holder)
//   - Single column: delegate to oneColSpec
//
// Each `oneColSpec` produces a FunctionInvocation named `colSpec` /
// `funcColSpec` / `aggColSpec` based on which lambdas are present.

import platform::pure::parser::mappings::*;
import platform::pure::functions::meta::antlr::*;
import platform::pure::parser::mappings::interpreter::*;
import platform::pure::protocol::grammar::*;

function platform::pure::parser::mappings::buildColumnBuilders(ctx: AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   let isArray = $ctx->hasToken('BRACKET_OPEN');
   let oneCols = $ctx->getChildren('oneColSpec');
   if($isArray,
      | if(anyHasChild($oneCols, 'extraFunction'),
           | buildColSpecArrayCall($ctx, $oneCols, 'aggColSpecArray', $lineOffset),
        | if(anyHasChild($oneCols, 'anyLambda'),
             | buildColSpecArrayCall($ctx, $oneCols, 'funcColSpecArray', $lineOffset),
             | buildColSpecArrayNamed($ctx, $oneCols, $lineOffset))),
      | buildOneColSpec($oneCols->at(0), $lineOffset));
}

function platform::pure::parser::mappings::anyHasChild(ctxs: AntlrContext[*], childName: String[1]): Boolean[1]
{
   $ctxs->fold({c, acc | $acc || $c->hasChild($childName)}, false)
}

function platform::pure::parser::mappings::anyHasAnyOfTwo(ctxs: AntlrContext[*], a: String[1], b: String[1]): Boolean[1]
{
   $ctxs->fold({c, acc | $acc || $c->hasChild($a) || $c->hasChild($b)}, false)
}

// Array form with at least one lambda (or aggregator).
function platform::pure::parser::mappings::buildColSpecArrayCall(ctx: AntlrContext[1], oneCols: AntlrContext[*], funcName: String[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   let n = $oneCols->size();
   ^platform::pure::protocol::grammar::valuespecification::FunctionInvocation(
      p_sourceInformation = buildSourceInfo($ctx, $lineOffset),
      functionName        = $funcName,
      parametersValues    = [
         ^platform::pure::protocol::grammar::valuespecification::Collection(
            values       = $oneCols->map(c | buildOneColSpec($c, $lineOffset)),
            multiplicity = ^platform::pure::protocol::grammar::multiplicity::UserDefinedAdHocMultiplicity(
               lowerBound = ^platform::pure::protocol::grammar::multiplicity::MultiplicityValue(value = $n),
               upperBound = ^platform::pure::protocol::grammar::multiplicity::MultiplicityValue(value = $n)
            )),
         ^platform::pure::protocol::grammar::valuespecification::CompilerGenericTypeAndMultiplicityHolder()
      ]
   );
}

// Array form with no lambdas: emits names + a combined per-column RelationType holder.
function platform::pure::parser::mappings::buildColSpecArrayNamed(ctx: AntlrContext[1], oneCols: AntlrContext[*], lineOffset: Integer[1]): platform::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   let n = $oneCols->size();
   ^platform::pure::protocol::grammar::valuespecification::FunctionInvocation(
      p_sourceInformation = buildSourceInfo($ctx, $lineOffset),
      functionName        = 'colSpecArray',
      parametersValues    = [
         ^platform::pure::protocol::grammar::valuespecification::Collection(
            values       = $oneCols->map(c | buildColumnNameAtomic($c, $lineOffset)),
            multiplicity = ^platform::pure::protocol::grammar::multiplicity::UserDefinedAdHocMultiplicity(
               lowerBound = ^platform::pure::protocol::grammar::multiplicity::MultiplicityValue(value = $n),
               upperBound = ^platform::pure::protocol::grammar::multiplicity::MultiplicityValue(value = $n)
            )),
         buildColSpecArrayHolder($ctx, $oneCols, $lineOffset)
      ]
   );
}

// A single column spec: `~col` / `~col:T` / `~col:lambda` / `~col:lambda:aggLambda`.
function platform::pure::parser::mappings::buildOneColSpec(ctx: AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   let hasLambda = $ctx->hasChild('anyLambda');
   let hasExtra  = $ctx->hasChild('extraFunction');
   let fnName    = if($hasLambda,
                      | if($hasExtra, |'aggColSpec', |'funcColSpec'),
                      | 'colSpec');
   ^platform::pure::protocol::grammar::valuespecification::FunctionInvocation(
      p_sourceInformation = buildSourceInfo($ctx, $lineOffset),
      functionName        = $fnName,
      parametersValues    = buildOneColSpecParams($ctx, $hasLambda, $hasExtra, $lineOffset)
   );
}

function platform::pure::parser::mappings::buildOneColSpecParams(ctx: AntlrContext[1], hasLambda: Boolean[1], hasExtra: Boolean[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::valuespecification::ValueSpecification[*]
{
   let nameAtomic = buildColumnNameAtomic($ctx, $lineOffset);
   let typeHolder = buildOneColSpecHolder($ctx, $lineOffset);
   if($hasLambda,
      | if($hasExtra,
           | [buildAnyLambda($ctx->getChild('anyLambda')->toOne(), $lineOffset),
              buildAnyLambda($ctx->getChild('extraFunction')->toOne()->getChild('anyLambda')->toOne(), $lineOffset),
              $nameAtomic,
              $typeHolder],
           | [buildAnyLambda($ctx->getChild('anyLambda')->toOne(), $lineOffset), $nameAtomic, $typeHolder]),
      | [$nameAtomic, $typeHolder]);
}

// String AtomicValue holding the column name — used in colSpecArray names slot.
function platform::pure::parser::mappings::buildColumnNameAtomic(ctx: AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   let cn = $ctx->getChild('columnName')->toOne();
   ^platform::pure::protocol::grammar::valuespecification::AtomicValue(
      p_sourceInformation = buildSourceInfo($cn, $lineOffset),
      genericType         = primitiveType('String'),
      value               = $cn->getText()
   );
}

// Per-column type holder: either a UserDefinedGenericTypeAndMultiplicityHolder
// wrapping a 1-column RelationType, or a CompilerHolder when no type/multiplicity
// is given on this column.
function platform::pure::parser::mappings::buildOneColSpecHolder(ctx: AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   if($ctx->hasChild('type') || $ctx->hasChild('multiplicity'),
      | ^platform::pure::protocol::grammar::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder(
           genericType = ^platform::pure::protocol::grammar::type::generics::UserDefinedGenericType(
              type = ^platform::pure::protocol::grammar::relation::RelationType(
                 columns = [buildOneColSpecColumn($ctx, $lineOffset)]
              )
           )),
      | ^platform::pure::protocol::grammar::valuespecification::CompilerGenericTypeAndMultiplicityHolder())
}

// The combined holder for colSpecArray (no lambdas): a RelationType containing
// all columns that have explicit types/multiplicities.
function platform::pure::parser::mappings::buildColSpecArrayHolder(ctx: AntlrContext[1], oneCols: AntlrContext[*], lineOffset: Integer[1]): platform::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   if(anyHasAnyOfTwo($oneCols, 'type', 'multiplicity'),
      | ^platform::pure::protocol::grammar::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder(
           genericType = ^platform::pure::protocol::grammar::type::generics::UserDefinedGenericType(
              type = ^platform::pure::protocol::grammar::relation::RelationType(
                 columns = $oneCols->filter(c | $c->hasChild('type') || $c->hasChild('multiplicity'))
                                   ->map(c | buildOneColSpecColumn($c, $lineOffset))
              )
           )),
      | ^platform::pure::protocol::grammar::valuespecification::CompilerGenericTypeAndMultiplicityHolder())
}

// A single Column for a RelationType, derived from a oneColSpec ctx.
// genericType and multiplicity are [0..1] in protocol (optionalInProtocol);
// emit [] when the grammar omits them so compile-pure substitutes defaults.
function platform::pure::parser::mappings::buildOneColSpecColumn(ctx: AntlrContext[1], lineOffset: Integer[1]): platform::pure::protocol::grammar::relation::Column[1]
{
   ^platform::pure::protocol::grammar::relation::Column(
      name         = $ctx->getChild('columnName')->toOne()->getText(),
      nameWildCard = false,
      genericType  = if($ctx->hasChild('type'),
                        | buildGenericType($ctx->getChild('type')->toOne(), $lineOffset),
                        | []),
      multiplicity = if($ctx->hasChild('multiplicity'),
                        | buildMultiplicity($ctx->getChild('multiplicity')->toOne()),
                        | [])
   )
}
