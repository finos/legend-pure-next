{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pure",
  "scopeName": "source.pure",
  "fileTypes": ["pure"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#parser-marker" },
    { "include": "#strings" },
    { "include": "#dates" },
    { "include": "#colors" },
    { "include": "#numbers" },
    { "include": "#keywords-element" },
    { "include": "#keywords-language" },
    { "include": "#keywords-control" },
    { "include": "#constants" },
    { "include": "#primitives" },
    { "include": "#let-binding" },
    { "include": "#variable-reference" },
    { "include": "#package-path" },
    { "include": "#type-with-multiplicity" },
    { "include": "#multiplicity" },
    { "include": "#generics" },
    { "include": "#function-descriptor" },
    { "include": "#property-access" },
    { "include": "#property-assignment" },
    { "include": "#parameter-binding" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.pure",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/"
        },
        {
          "name": "comment.block.pure",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.pure",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.pure",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.single.pure",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pure",
              "match": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
            },
            {
              "name": "invalid.illegal.unknown-escape.pure",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "parser-marker": {
      "name": "keyword.other.parser-section.pure",
      "match": "^\\s*###\\w+"
    },
    "dates": {
      "patterns": [
        {
          "name": "constant.other.date.latest.pure",
          "match": "%latest\\b"
        },
        {
          "name": "constant.other.date.pure",
          "match": "%-?\\d+(?:-\\d+(?:-\\d+(?:T\\d+(?::\\d+(?::\\d+(?:\\.\\d+)?)?)?(?:[+-][0-9]{4})?)?)?)?"
        },
        {
          "name": "constant.other.time.pure",
          "match": "%\\d+(?::\\d+(?::\\d+(?:\\.\\d+)?)?)?"
        }
      ]
    },
    "colors": {
      "name": "constant.other.color.pure",
      "match": "#[0-9a-fA-F]{6}\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pure",
          "match": "\\b0[xX][0-9a-fA-F]+(?:_+[0-9a-fA-F]+)*[Ll]?\\b"
        },
        {
          "name": "constant.numeric.binary.pure",
          "match": "\\b0[bB][01]+(?:_+[01]+)*[Ll]?\\b"
        },
        {
          "name": "constant.numeric.float.pure",
          "match": "\\b\\d+(?:_+\\d+)*\\.\\d+(?:_+\\d+)*(?:[eE][-+]?\\d+(?:_+\\d+)*)?[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.float.pure",
          "match": "\\b\\d+(?:_+\\d+)*[eE][-+]?\\d+(?:_+\\d+)*[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.float.pure",
          "match": "\\b\\d+(?:_+\\d+)*[fFdD]\\b"
        },
        {
          "name": "constant.numeric.integer.pure",
          "match": "\\b\\d+(?:_+\\d+)*[lL]?\\b"
        }
      ]
    },
    "keywords-element": {
      "name": "storage.type.element.pure",
      "match": "\\b(Class|Association|Enum|Measure|Profile|function|Mapping|Runtime|Connection|FileGeneration|GenerationSpecification|Data|ExecutionEnvironment|Service|FlatData|Database|Schema|Table|Join|View)\\b"
    },
    "keywords-language": {
      "name": "keyword.other.pure",
      "match": "\\b(import|native|extends|projects|include|primaryKey|groupBy|mainTable|EnumerationMapping|AssociationMapping|AggregationAware|XStore|Pure|Relational|JsonModelConnection|XmlModelConnection|ModelChainConnection|RelationalDatabaseConnection|FlatDataConnection)\\b"
    },
    "keywords-control": {
      "name": "keyword.control.pure",
      "match": "\\b(let|if|else)\\b"
    },
    "constants": {
      "name": "constant.language.pure",
      "match": "\\b(true|false)\\b"
    },
    "primitives": {
      "name": "support.type.primitive.pure",
      "match": "\\b(StrictDate|StrictTime|DateTime|Date|String|Integer|Float|Decimal|Number|Boolean|Any|Nil)\\b"
    },
    "let-binding": {
      "match": "\\b(let)\\s+([a-zA-Z_$][\\w$]*)(?=\\s*=)",
      "captures": {
        "1": { "name": "keyword.control.pure" },
        "2": { "name": "variable.other.declaration.pure" }
      }
    },
    "variable-reference": {
      "name": "variable.other.dollar.pure",
      "match": "\\$[a-zA-Z_$][\\w$]*"
    },
    "package-path": {
      "match": "((?:[a-zA-Z_]\\w*::)+)([a-zA-Z_]\\w*)?",
      "captures": {
        "1": { "name": "entity.name.namespace.pure" },
        "2": { "name": "entity.name.type.pure" }
      }
    },
    "type-with-multiplicity": {
      "match": "\\b([A-Z][\\w$]*)\\s*(\\[(?:[a-zA-Z0-9]+(?:\\.\\.(?:[a-zA-Z0-9]+|\\*))?|\\*)\\])",
      "captures": {
        "1": { "name": "entity.name.type.pure" },
        "2": { "name": "support.other.multiplicity.pure" }
      }
    },
    "multiplicity": {
      "name": "support.other.multiplicity.pure",
      "match": "\\[(?:[a-zA-Z0-9]+(?:\\.\\.(?:[a-zA-Z0-9]+|\\*))?|\\*)\\](?!\\w)"
    },
    "generics": {
      "name": "support.other.generics.pure",
      "match": "<(?:\\w+|[^:.@^()<>]+[^-<>])>"
    },
    "function-descriptor": {
      "name": "entity.name.function.pure",
      "match": "\\b[a-zA-Z_$][\\w$]*(?:_(?:[a-zA-Z0-9]+|\\$[a-zA-Z0-9]+_[a-zA-Z0-9]+\\$))+_\\b"
    },
    "property-access": {
      "match": "(\\.)\\s*([a-zA-Z_$][\\w$]*)",
      "captures": {
        "1": { "name": "punctuation.accessor.pure" },
        "2": { "name": "variable.other.property.pure" }
      }
    },
    "property-assignment": {
      "match": "([a-zA-Z_$][\\w$]*)(?=\\s*=(?!=))",
      "captures": {
        "1": { "name": "variable.other.property.pure" }
      }
    },
    "parameter-binding": {
      "match": "([a-zA-Z_$][\\w$]*)(?=\\s*:(?!:))",
      "captures": {
        "1": { "name": "variable.parameter.pure" }
      }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.pure",      "match": "->" },
        { "name": "keyword.operator.namespace.pure",  "match": "::" },
        { "name": "keyword.operator.tag.pure",        "match": "#\\{|\\}#" },
        { "name": "keyword.operator.constructor.pure","match": "\\^" },
        { "name": "keyword.operator.profile.pure",    "match": "@" },
        { "name": "keyword.operator.comparison.pure", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.pure",    "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.pure", "match": "=" },
        { "name": "keyword.operator.arithmetic.pure", "match": "\\+|\\-|\\*|/|%" }
      ]
    }
  }
}
