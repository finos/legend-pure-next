@prefix : <https://finos.org/legend/pure/m3#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# PROTOCOL CONCEPTS (depends on m3.ttl)
# =============================================================================

:meta_pure_protocol a :Package ;
    :name [ :classifierGenericType :GenericType_String ; :data "meta::pure::protocol" ] .

# --- Section ---

:Section a :Class ;
    :name [ :classifierGenericType :GenericType_String ; :data "Section" ] ;
    :classifierGenericType [ :type :Class ; :typeArguments [ :type :Section ] ] ;
    :package :meta_pure_protocol ;
    :generalizations [ :general [ :type :Any ] ] .

:Section_elements a :Property ;
    :stereotypes :ProtocolInfo_nonPointer ;
    :name [ :classifierGenericType :GenericType_String ; :data "elements" ] ;
    :classifierGenericType [ :type :Property ; :typeArguments ( [ :type :Section ] [ :type :PackageableElement ] ) ; :multiplicityArguments :ZeroMany ] ;
    :owner :Section ;
    :genericType [ :type :PackageableElement ] ;
    :multiplicity :ZeroMany .

:Section_imports a :Property ;
    :name [ :classifierGenericType :GenericType_String ; :data "imports" ] ;
    :classifierGenericType [ :type :Property ; :typeArguments ( [ :type :Section ] [ :type :String ] ) ; :multiplicityArguments :ZeroMany ] ;
    :owner :Section ;
    :genericType [ :type :String ] ;
    :multiplicity :ZeroMany .

:Section_parserName a :Property ;
    :name [ :classifierGenericType :GenericType_String ; :data "parserName" ] ;
    :classifierGenericType [ :type :Property ; :typeArguments ( [ :type :Section ] [ :type :String ] ) ; :multiplicityArguments :PureOne ] ;
    :owner :Section ;
    :genericType [ :type :String ] ;
    :multiplicity :PureOne .

# --- PureFile ---

:PureFile a :Class ;
    :name [ :classifierGenericType :GenericType_String ; :data "PureFile" ] ;
    :classifierGenericType [ :type :Class ; :typeArguments [ :type :PureFile ] ] ;
    :package :meta_pure_protocol ;
    :generalizations [ :general [ :type :Any ] ] .

:PureFile_sections a :Property ;
    :name [ :classifierGenericType :GenericType_String ; :data "sections" ] ;
    :classifierGenericType [ :type :Property ; :typeArguments ( [ :type :PureFile ] [ :type :Section ] ) ; :multiplicityArguments :ZeroMany ] ;
    :owner :PureFile ;
    :genericType [ :type :Section ] ;
    :multiplicity :ZeroMany .

:PureFile_sourceId a :Property ;
    :name [ :classifierGenericType :GenericType_String ; :data "sourceId" ] ;
    :classifierGenericType [ :type :Property ; :typeArguments ( [ :type :PureFile ] [ :type :String ] ) ; :multiplicityArguments :ZeroOne ] ;
    :owner :PureFile ;
    :genericType [ :type :String ] ;
    :multiplicity :ZeroOne .

# --- Enum_Pointer ---
# Protocol pointer for Enumeration values. pointerValue is the Enumeration path,
# extraPointerValues[0].value is the enum value name.
# Example: pointerValue="AggregationKind", extraPointerValues=[PointerValue("Composite")]

:Enum_Pointer a :Class ;
    :name [ :classifierGenericType :GenericType_String ; :data "Enum_Pointer" ] ;
    :classifierGenericType [ :type :Class ; :typeArguments [ :type :Enum_Pointer ] ] ;
    :package :meta_pure_protocol_grammar ;
    :generalizations [ :general [ :type :PointerValue ] ] .

## value is inherited from PointerValue

:Enum_Pointer_extraPointerValues a :Property ;
    :name [ :classifierGenericType :GenericType_String ; :data "extraPointerValues" ] ;
    :classifierGenericType [ :type :Property ; :typeArguments ( [ :type :Enum_Pointer ] [ :type :PointerValue ] ) ; :multiplicityArguments :ZeroMany ] ;
    :owner :Enum_Pointer ;
    :genericType [ :type :PointerValue ] ;
    :multiplicity :ZeroMany .
