// A pointer slot holding what nothing addresses fails the write: writing anything would lose the value, and
// the reader would never know.
function <<test.Test>> platform::pure::pdb::writer::tests::pointers::testAPointerToWhatNothingAddressesFailsTheWrite():Boolean[1]
{
   assertError(| platform::pure::pdb::writerHelper::writePointerRefFor(platform::pure::pdb::fbb::newBuilder(),
                    ^platform::pure::metamodel::type::generics::TypeParameter(name = 'T')),
               'PDB writer: cannot write a pointer to a platform::pure::metamodel::type::generics::TypeParameter');
}
