// The self-hosted PDB READER — format tools only. Stateless decoders over
// (bytes, position) node handles: FlatBuffer table/vtable/field/string/vector/
// union access, PointerRef/AncestorRef descriptions, *ValueDef unwrapping and
// zip directory parsing (STORED entries, and DEFLATE ones through inflate.pure). Deliberately NOT here: element identity,
// caching, PointerRef resolution against a registry, and AncestorRef cycle
// closure — those live in each platform's wiring (the JVM's generated
// *FlatBufferWrapper keeps per-property caches, resolves pointers through
// MetadataAccess and walks its _fbParent chain for AncestorRefs; the JS host
// does the same in its bridge). A reader here can stay lazy for the same
// reason the wrappers are: every decode is O(field) from the handle, so the
// host materializes exactly what it touches.
//
// The schema (field slot ids, union member order, enum value order) comes from
// the parsed m3.fbs (pdb/schema/parser.pure) — reading has no add-order concerns,
// so a generic schema-driven reader replaces the writer's generated code.

import platform::pure::functions::binary::*;
import platform::pure::pdb::schema::*;

// --- little-endian integer decoding ------------------------------------------
//
// NATIVE. Assembled in Pure these were `range(0, $width)->reverse()->fold(...)`,
// which allocates a list per scalar read — and every vtable slot, offset and
// scalar in a .pdb goes through them. On a backend that interprets the reader
// rather than compiling it ahead of time that dominated decoding.

// Unsigned little-endian integer of `width` bytes at absolute `pos`.
function platform::pure::pdb::reader::leUInt(bytes:Binary[1], pos:Integer[1], width:Integer[1]):Integer[1]
{
   $bytes->binaryLeUInt($pos, $width);
}

// Signed (two's-complement) little-endian integer of `width` bytes: the top
// byte is applied signed so the magnitude never exceeds the value itself.
function platform::pure::pdb::reader::leInt(bytes:Binary[1], pos:Integer[1], width:Integer[1]):Integer[1]
{
   $bytes->binaryLeInt($pos, $width);
}

// --- FlatBuffer node handles ---------------------------------------------------

// A table position in a finished FlatBuffer, tagged with its schema table name.
Class platform::pure::pdb::reader::FbsNode
{
   bytes : Binary[1];
   pos   : Integer[1];
   type  : String[1];
}

// The root table of a finished buffer (uoffset at position 0).
function platform::pure::pdb::reader::rootNode(bytes:Binary[1], rootType:String[1]):platform::pure::pdb::reader::FbsNode[1]
{
   ^platform::pure::pdb::reader::FbsNode(
      bytes = $bytes,
      pos   = platform::pure::pdb::reader::leUInt($bytes, 0, 4),
      type  = $rootType);
}

// Absolute position of field `id`'s data in the table, or -1 when absent.
// (table pos holds a SIGNED soffset to the vtable; vtable = [len, tableSize,
// field slots...] of u16s; a 0 slot — or an id beyond the trimmed vtable —
// means the field was elided.)
function platform::pure::pdb::reader::fieldPos(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1]):Integer[1]
{
   let bytes = $node.bytes;
   let vtPos = $node.pos - platform::pure::pdb::reader::leInt($bytes, $node.pos, 4);
   let vtLen = platform::pure::pdb::reader::leUInt($bytes, $vtPos, 2);
   let slot  = 4 + (2 * $id);
   if($slot >= $vtLen,
      | -1,
      | let off = platform::pure::pdb::reader::leUInt($bytes, $vtPos + $slot, 2);
        if($off == 0, | -1, | $node.pos + $off););
}

// Integer scalar field (present-or-default). `signed` selects two's-complement.
function platform::pure::pdb::reader::readIntField(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1], width:Integer[1], signed:Boolean[1], default:Integer[1]):Integer[1]
{
   let fp = platform::pure::pdb::reader::fieldPos($node, $id);
   if($fp == -1,
      | $default,
      | if($signed,
           | platform::pure::pdb::reader::leInt($node.bytes, $fp, $width),
           | platform::pure::pdb::reader::leUInt($node.bytes, $fp, $width)));
}

function platform::pure::pdb::reader::readBoolField(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1], default:Boolean[1]):Boolean[1]
{
   let fp = platform::pure::pdb::reader::fieldPos($node, $id);
   if($fp == -1, | $default, | $node.bytes->binaryAt($fp) != 0);
}

// fbs `double` field (present-or-0.0), via the leBytesToFloat native.
function platform::pure::pdb::reader::readFloatField(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1]):Float[1]
{
   let fp = platform::pure::pdb::reader::fieldPos($node, $id);
   if($fp == -1, | 0.0, | leBytesToFloat($node.bytes->binarySlice($fp, $fp + 8)));
}

// fbs `double` field of a metamodel PROPERTY: absent means empty. The generated writers write a
// double whenever the property has a value (fbb::addFieldFloatPresent), so an absent field is an
// empty Float[0..1], never 0.0.
function platform::pure::pdb::reader::readOptionalFloatField(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1]):Float[0..1]
{
   let fp = platform::pure::pdb::reader::fieldPos($node, $id);
   if($fp == -1, | [], | leBytesToFloat($node.bytes->binarySlice($fp, $fp + 8)));
}

// Decode the string whose uoffset lives at absolute position `p`.
function platform::pure::pdb::reader::stringAt(bytes:Binary[1], p:Integer[1]):String[1]
{
   let sPos = $p + platform::pure::pdb::reader::leUInt($bytes, $p, 4);
   let len  = platform::pure::pdb::reader::leUInt($bytes, $sPos, 4);
   $bytes->binaryUtf8($sPos + 4, $len);
}

function platform::pure::pdb::reader::readStringField(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1]):String[0..1]
{
   let fp = platform::pure::pdb::reader::fieldPos($node, $id);
   if($fp == -1, | [], | platform::pure::pdb::reader::stringAt($node.bytes, $fp));
}

// Nested table field: follow the uoffset indirection.
function platform::pure::pdb::reader::readTableField(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1], typeName:String[1]):platform::pure::pdb::reader::FbsNode[0..1]
{
   let fp = platform::pure::pdb::reader::fieldPos($node, $id);
   if($fp == -1,
      | [],
      | ^platform::pure::pdb::reader::FbsNode(
           bytes = $node.bytes,
           pos   = $fp + platform::pure::pdb::reader::leUInt($node.bytes, $fp, 4),
           type  = $typeName));
}

// Vector plumbing: a vector field's data is [u32 count, elements...].
function platform::pure::pdb::reader::vectorPositions(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1], elemSize:Integer[1]):Integer[*]
{
   let fp = platform::pure::pdb::reader::fieldPos($node, $id);
   if($fp == -1,
      | [],
      | let vecPos = $fp + platform::pure::pdb::reader::leUInt($node.bytes, $fp, 4);
        let count  = platform::pure::pdb::reader::leUInt($node.bytes, $vecPos, 4);
        range(0, $count)->map(i | $vecPos + 4 + ($i * $elemSize)););
}

function platform::pure::pdb::reader::readStringVector(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1]):String[*]
{
   platform::pure::pdb::reader::vectorPositions($node, $id, 4)
      ->map(p | platform::pure::pdb::reader::stringAt($node.bytes, $p));
}

function platform::pure::pdb::reader::readTableVector(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1], typeName:String[1]):platform::pure::pdb::reader::FbsNode[*]
{
   platform::pure::pdb::reader::vectorPositions($node, $id, 4)
      ->map(p | ^platform::pure::pdb::reader::FbsNode(
                   bytes = $node.bytes,
                   pos   = $p + platform::pure::pdb::reader::leUInt($node.bytes, $p, 4),
                   type  = $typeName));
}

// A [ubyte] vector is a contiguous run inside the buffer, so it is one slice
// rather than a mapped list: the previous shape allocated a boxed Integer per
// byte, on the path every union discriminant vector takes.
// [0..1], not [1]: an ABSENT field must stay distinguishable from a present
// but empty one. `0x` is a value, so returning it for an absent field would
// make readField report a missing vector as present — which is what an
// `isEmpty()` check on an unwritten field relies on.
function platform::pure::pdb::reader::readByteVector(node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1]):Binary[0..1]
{
   let fp = platform::pure::pdb::reader::fieldPos($node, $id);
   if($fp == -1,
      | [],
      | let vecPos = $fp + platform::pure::pdb::reader::leUInt($node.bytes, $fp, 4);
        let count  = platform::pure::pdb::reader::leUInt($node.bytes, $vecPos, 4);
        $node.bytes->binarySlice($vecPos + 4, $vecPos + 4 + $count););
}

// Single union field: the discriminant byte lives in the implicit `<field>_type`
// slot at id-1 (1-based member index, 0 = absent); the value table at `id`.
function platform::pure::pdb::reader::readUnionField(s:platform::pure::pdb::schema::FbsSchema[1], node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1], unionName:String[1]):platform::pure::pdb::reader::FbsNode[0..1]
{
   let typeByte = platform::pure::pdb::reader::readIntField($node, $id - 1, 1, false, 0);
   if($typeByte == 0,
      | [],
      | platform::pure::pdb::reader::readTableField($node, $id,
           platform::pure::pdb::schema::unionMembers($s, $unionName)->at($typeByte - 1)));
}

// Union vector: parallel [ubyte] discriminants at id-1 and value tables at id.
function platform::pure::pdb::reader::readUnionVector(s:platform::pure::pdb::schema::FbsSchema[1], node:platform::pure::pdb::reader::FbsNode[1], id:Integer[1], unionName:String[1]):platform::pure::pdb::reader::FbsNode[*]
{
   let types   = platform::pure::pdb::reader::readByteVector($node, $id - 1);
   let members = platform::pure::pdb::schema::unionMembers($s, $unionName);
   let values  = platform::pure::pdb::reader::vectorPositions($node, $id, 4);
   range(0, $values->size())->map(i |
      ^platform::pure::pdb::reader::FbsNode(
         bytes = $node.bytes,
         pos   = $values->at($i) + platform::pure::pdb::reader::leUInt($node.bytes, $values->at($i), 4),
         type  = $members->at($types->toOne()->binaryAt($i) - 1)));
}

// --- reference descriptions -----------------------------------------------------

// A decoded PointerRef: kind discriminant (m3.fbs PointerKind, 0 = Element)
// and UNSPLIT path segments. Resolution against an element registry is wiring.
Class platform::pure::pdb::reader::ReadPointerRef
{
   kind : Integer[1];
   segs : String[*];
}

// A decoded AncestorRef: a back-reference `depth` levels up the WRITE stack of
// this element's blob. Closing the cycle (returning the ancestor instance) is
// wiring — the host resolves it against its parent chain, as the JVM wrapper
// walks _fbParent; an immutable Pure reader cannot (and must not) materialize
// cyclic instances.
Class platform::pure::pdb::reader::ReadAncestorRef
{
   depth : Integer[1];
}

// A language extension's value (an ExtensionValueDef): its blob, a finished FlatBuffer, rooted at the table
// `kind` names — declared in the extension's schema fragment, which `s` must include.
function platform::pure::pdb::reader::decodeExtensionValue(s:platform::pure::pdb::schema::FbsSchema[1], node:platform::pure::pdb::reader::FbsNode[1]):platform::pure::pdb::reader::FbsNode[1]
{
   platform::pure::pdb::reader::rootNode(
      platform::pure::pdb::reader::readField($s, $node, 'blob')->cast(@Binary)->toOne(),
      platform::pure::pdb::reader::readField($s, $node, 'kind')->cast(@String)->toOne());
}

// PointerRef/AncestorRef nodes become descriptions; everything else stays a node.
function platform::pure::pdb::reader::decodeNode(node:platform::pure::pdb::reader::FbsNode[1]):Any[1]
{
   if($node.type == 'PointerRef',
      | ^platform::pure::pdb::reader::ReadPointerRef(
           kind = platform::pure::pdb::reader::readIntField($node, 0, 1, false, 0),
           segs = platform::pure::pdb::reader::readStringVector($node, 1)),
      | if($node.type == 'AncestorRef',
           | ^platform::pure::pdb::reader::ReadAncestorRef(
                depth = platform::pure::pdb::reader::readIntField($node, 0, 4, true, 0)),
           | $node));
}

// --- schema-driven field access --------------------------------------------------

// Read a field by its fbs name, decoding by the schema-declared category:
// scalars surface their defaults when elided (bool false / int 0 / double 0.0 /
// enum first value); strings, tables and unions are [0..1]; vectors are [*].
// Table and union results pass through decodeNode, so PointerRef/AncestorRef
// surface as descriptions. (Pure-property→fbs-field naming — toFbsFieldName +
// the p_tags quirk — lives with the generator; wiring composes the two.)
function platform::pure::pdb::reader::readField(s:platform::pure::pdb::schema::FbsSchema[1], node:platform::pure::pdb::reader::FbsNode[1], fbsFieldName:String[1]):Any[*]
{
   let tdef  = platform::pure::pdb::schema::table($s, $node.type);
   if($tdef->isEmpty(), | fail('unknown table: ' + $node.type), | true);
   let field = $tdef->toOne().fields->filter(f | $f.name == $fbsFieldName)->head();
   if($field->isEmpty(), | fail('unknown field ' + $fbsFieldName + ' on ' + $node.type), | true);
   let f   = $field->toOne();
   let cat = platform::pure::pdb::schema::categorize($s, $f.type);
   if([pair(| $f.vector && ($cat == 'union'),     | platform::pure::pdb::reader::readUnionVector($s, $node, $f.id, $f.type)->map(n | platform::pure::pdb::reader::decodeNode($n))),
       pair(| $f.vector && ($cat == 'table'),     | platform::pure::pdb::reader::readTableVector($node, $f.id, $f.type)->map(n | platform::pure::pdb::reader::decodeNode($n))),
       pair(| $f.vector && ($f.type == 'string'), | platform::pure::pdb::reader::readStringVector($node, $f.id)),
       pair(| $f.vector,                          | platform::pure::pdb::reader::readByteVector($node, $f.id)),
       pair(| $cat == 'union',                    | platform::pure::pdb::reader::readUnionField($s, $node, $f.id, $f.type)->map(n | platform::pure::pdb::reader::decodeNode($n))),
       pair(| $cat == 'table',                    | platform::pure::pdb::reader::readTableField($node, $f.id, $f.type)->map(n | platform::pure::pdb::reader::decodeNode($n))),
       pair(| $cat == 'enum',                     | platform::pure::pdb::schema::enumValues($s, $f.type)->at(platform::pure::pdb::reader::readIntField($node, $f.id, 1, false, 0))),
       pair(| $f.type == 'string',                | platform::pure::pdb::reader::readStringField($node, $f.id)),
       pair(| $f.type == 'bool',                  | platform::pure::pdb::reader::readBoolField($node, $f.id, false)),
       pair(| $f.type == 'double',                | platform::pure::pdb::reader::readOptionalFloatField($node, $f.id))],
      | platform::pure::pdb::reader::readIntField($node, $f.id, platform::pure::pdb::schema::scalarWidth($f.type), true, 0)
   );
}

// The root Def node of one `elements/<path>.<TypeName>` entry's bytes.
function platform::pure::pdb::reader::elementNode(bytes:Binary[1], typeName:String[1]):platform::pure::pdb::reader::FbsNode[1]
{
   platform::pure::pdb::reader::rootNode($bytes, $typeName + 'Def');
}

// Unwrap a scalar `*ValueDef` (the FlatBuffer encoding of an AtomicValue's raw
// payload) back to the bare value; `val` is field id 0 in all five.
function platform::pure::pdb::reader::unwrapValueDef(node:platform::pure::pdb::reader::FbsNode[1]):Any[1]
{
   if([pair(| $node.type == 'IntegerValueDef', | platform::pure::pdb::reader::readIntField($node, 0, 8, true, 0)),
       pair(| $node.type == 'FloatValueDef',   | platform::pure::pdb::reader::readFloatField($node, 0)),
       pair(| $node.type == 'BooleanValueDef', | platform::pure::pdb::reader::readBoolField($node, 0, false)),
       pair(| ($node.type == 'StringValueDef') || ($node.type == 'DecimalValueDef'),
            | let s = platform::pure::pdb::reader::readStringField($node, 0);
              if($s->isEmpty(), | '', | $s->toOne());)],
      | fail('not a ValueDef: ' + $node.type); 0;
   );
}

