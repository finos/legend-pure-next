import meta::pure::test::pct::*;
import meta::pure::functions::meta::tests::model::*;

// Creates a fully constructed Enumeration with all enum values.
// Each value becomes a Property with a defaultValue lambda returning the Enum instance.
// The Enumeration gets a self-referencing CGT (Enumeration<self>) and each Enum
// instance gets CGT pointing to the Enumeration.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::meta::creation::newEnumeration(name:String[1], package:Package[1], valueNames:String[*]):Enumeration<Any>[1];

function <<test.Test>> meta::pure::functions::meta::tests::creation::testNewEnumeration():Boolean[1]
{
    let en = meta::pure::functions::meta::creation::newEnumeration('TestEnum', ^Package(name='test', package=^Package(name='Root')), ['A', 'B', 'C']);
    assert($en->instanceOf(Enumeration));
    assertEquals('TestEnum', $en.name);

    // Should have 3 properties (one per value)
    assertEquals(3, $en.properties->size());
    assertEquals('A', $en.properties->at(0).name);
    assertEquals('B', $en.properties->at(1).name);
    assertEquals('C', $en.properties->at(2).name);

    // CGT should be Enumeration<self>
    let cgt = $en.classifierGenericType->toOne()->cast(@GenericTypeValue);
    assertIs(Enumeration, $cgt.type->toOne());
    let selfGT = $cgt.typeArguments->at(0)->cast(@GenericTypeValue);
    assertIs($en, $selfGT.type->toOne());
}

function <<test.Test>> meta::pure::functions::meta::tests::creation::testNewEnumerationValueCGT():Boolean[1]
{
    let en = meta::pure::functions::meta::creation::newEnumeration('TestEnum2', ^Package(name='test', package=^Package(name='Root')), ['X', 'Y']);
    let prop = $en.properties->at(0);

    // The default value should be an Enum instance
    assert($prop.defaultValue->isNotEmpty());
    let lambda = $prop.defaultValue->toOne();
    let exprSeq = $lambda.expressionSequence;
    assert($exprSeq->size() == 1);
    let av = $exprSeq->at(0)->cast(@AtomicValue);
    let enumVal = $av.value->toOne();
    assert($enumVal->instanceOf(Enum), 'value should be an Enum');

    // The Enum's CGT should point to the Enumeration
    let enumCGT = $enumVal->cast(@Any).classifierGenericType->toOne()->cast(@GenericTypeValue);
    assertIs($en, $enumCGT.type->toOne());
}
