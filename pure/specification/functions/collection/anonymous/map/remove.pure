import meta::pure::test::pct::*;

native function <<PCT.function>>
    {doc.doc = 'Returns a new map containing all the entries of the given map except the entry with the given key. If the map does not contain that key, the result is the same map.'}
meta::pure::functions::collection::remove<U,V>(m:Map<U,V>[1], key:U[1]):Map<U,V>[1];

function <<PCT.test>> meta::pure::functions::collection::tests::remove::testRemove_existingKey<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(newMap(pair('key2', 1)), $f->eval(|newMap([pair('key1', 0), pair('key2', 1)])->remove('key1')));
}

function <<PCT.test>> meta::pure::functions::collection::tests::remove::testRemove_missingKey<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(newMap(pair('key1', 0)), $f->eval(|newMap(pair('key1', 0))->remove('key2')));
}

function <<PCT.test>> meta::pure::functions::collection::tests::remove::testRemove_emptyMap<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(newMap([]->cast(@Pair<String, Integer>)), $f->eval(|newMap([]->cast(@Pair<String, Integer>))->remove('key1')));
}
