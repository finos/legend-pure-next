                                                           ])))
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchWithFunctionsAsParam<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let lambdas = [{a:Integer[1]|1}, {a:String[1]|[1,2]}, {a:Date[1]|[4,5,6]}];
    assertEquals([1], $f->eval(|1->match($lambdas)));
    assertEquals([1,2], $f->eval(|'1'->match($lambdas)));
    assertEquals([4,5,6], $f->eval(|%2005->match($lambdas)));
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchWithFunctionsAsParamManyMatch<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let lambdas = [{a:Integer[1]|1}, {a:String[1]|[6,7,1,2]}, {a:String[*]|$a}, {a:Date[1]|[4,5,6]}];
    assertEquals([1], $f->eval(|1->match($lambdas)));
    assertEquals(['1','2'], $f->eval(|['1','2']->match($lambdas)));
    assertEquals([6,7,1,2], $f->eval(|'1'->match($lambdas)));
    assertEquals([4,5,6], $f->eval(|%2005->match($lambdas)));

    let lambdas2 = [{a:Integer[1]|1}, {a:String[*]|$a}, {a:String[1]|[6,7,1,2]}, {a:Date[1]|[4,5,6]}];
    assertEquals([1], $f->eval(|1->match($lambdas2)));
    assertEquals(['1','2'], $f->eval(|['1','2']->match($lambdas2)));
    assertEquals('1', $f->eval(|'1'->match($lambdas2)));
    assertEquals([4,5,6], $f->eval(|%2005->match($lambdas2)));
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchWithFunctions<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals([1], $f->eval(|1->match([{a:Integer[1]|1}, {a:String[1]|[1,2]}, {a:Date[1]|[4,5,6]}])));
    assertEquals([1,2], $f->eval(|'1'->match([{a:Integer[1]|1}, {a:String[1]|[1,2]}, {a:Date[1]|[4,5,6]}])));
    assertEquals([4,5,6], $f->eval(|%2005->match([{a:Integer[1]|1}, {a:String[1]|[1,2]}, {a:Date[1]|[4,5,6]}])));
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchWithFunctionsManyMatch<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{

    assertEquals([1], $f->eval(|1->match([{a:Integer[1]|1}, {a:String[1]|[6,7,1,2]}, {a:String[*]|$a}, {a:Date[1]|[4,5,6]}])));
    assertEquals(['1','2'], $f->eval(|['1','2']->match([{a:Integer[1]|1}, {a:String[1]|[6,7,1,2]}, {a:String[*]|$a}, {a:Date[1]|[4,5,6]}])));
    assertEquals([6,7,1,2], $f->eval(|'1'->match([{a:Integer[1]|1}, {a:String[1]|[6,7,1,2]}, {a:String[*]|$a}, {a:Date[1]|[4,5,6]}])));
    assertEquals([4,5,6], $f->eval(|%2005->match([{a:Integer[1]|1}, {a:String[1]|[6,7,1,2]}, {a:String[*]|$a}, {a:Date[1]|[4,5,6]}])));


    assertEquals([1], $f->eval(|1->match([{a:Integer[1]|1}, {a:String[*]|$a}, {a:String[1]|[6,7,1,2]}, {a:Date[1]|[4,5,6]}])));
    assertEquals(['1','2'], $f->eval(|['1','2']->match([{a:Integer[1]|1}, {a:String[*]|$a}, {a:String[1]|[6,7,1,2]}, {a:Date[1]|[4,5,6]}])));
    assertEquals('1', $f->eval(|'1'->match([{a:Integer[1]|1}, {a:String[*]|$a}, {a:String[1]|[6,7,1,2]}, {a:Date[1]|[4,5,6]}])));
    assertEquals([4,5,6], $f->eval(|%2005->match([{a:Integer[1]|1}, {a:String[*]|$a}, {a:String[1]|[6,7,1,2]}, {a:Date[1]|[4,5,6]}])));
}

Class meta::pure::functions::lang::tests::match::Geo
{
    type : MA_GeographicEntityType[1];
}

Class meta::pure::functions::lang::tests::match::MA_Address extends Geo
{
    name : String[1];
}

Class meta::pure::functions::lang::tests::match::MA_Person
{
    firstName : String[1];
    lastName : String[1];
}

Class meta::pure::functions::lang::tests::match::MA_Location extends Geo
{
    place : String[1];
}

Enum meta::pure::functions::lang::tests::match::MA_GeographicEntityType
{
    CITY
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatch<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('address', $f->eval(|^MA_Address(name='Hoboken, NJ', type=MA_GeographicEntityType.CITY)->match([a:MA_Address[1] | 'address', l:MA_Location[1] | 'location', a:Any[1] | 'Any1'])));
    assertEquals('location', $f->eval(|^MA_Location(place='Hoboken, NJ', type=MA_GeographicEntityType.CITY)->match([a:MA_Address[1] | 'address', l:MA_Location[1] | 'location', a:Any[1] | 'Any1'])));
    assertEquals('Any1', $f->eval(|^MA_Person(firstName='Pierre', lastName='Doe')->match([a:MA_Address[1] | 'address', l:MA_Location[1] | 'location', a:Any[1] | 'Any1'])));
    assertEquals('Any*', $f->eval(|^MA_Person(firstName='Pierre', lastName='Doe')->match([a:MA_Address[1] | 'address', l:MA_Location[1] | 'location', a:Any[*] | 'Any*'])));
    assertEquals('Any*', $f->eval(|[^MA_Person(firstName='Pierre', lastName='Doe'), ^MA_Person(firstName='Fabrice', lastName='Smith')]->match([a:MA_Address[1] | 'address', l:MA_Location[1] | 'location', a:Any[*] | 'Any*'])));
}




function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchWithExtraParam<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
   assertEquals('good_other', $f->eval(|[1]->match([{i:Integer[1], b:String[1]|'good_'+$b},
                                          {s:String[1], b:String[1]|'bad'}
                                         ],'other'))
   );

   assertEquals('good_otheryo', $f->eval(|[1]->match([{i:Integer[1], b:String[*]|'good_'+$b->joinStrings('', '', '');},
                                            {s:String[1], b:String[*]|'bad'}
                                         ],['other', 'yo']))
   );
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchWithExtraParamsAndFunctionsAsParam<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let lambdas = [{a:String[1],b:String[1]|'1'+$b},{a:Integer[1],b:String[1]|$b},{a:Date[1],b:String[1]|'5'+$b}];
    assertEquals('11', $f->eval(|'1'->match($lambdas, '1')));
    assertEquals('2', $f->eval(|1->match($lambdas, '2')));
    assertEquals('53', $f->eval(|%2005->match($lambdas, '3')));
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchWithMixedReturnType<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let z = $f->eval(|^LA_Location(place='Hoboken, NJ', type=LA_GeographicEntityType.CITY)->match([a:LA_Address[1] | 'address', l:LA_Location[1] | 1, a:Any[1] | 'Any1']));
    assertIs(Integer, $z->genericType().type->toOne());
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchEnumValue<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('enum:CITY', $f->eval(|LA_GeographicEntityType.CITY->match(
                                                [
                                                    e:LA_GeographicEntityType[1] | 'enum:' + $e->toString(),
                                                    a:Any[1] | 'other'
                                                ]
                                            )
                                  )
    );
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchUserDefinedGenericType<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('gtv', $f->eval(|
        let cgt = meta::pure::metamodel::type::generics::UserDefinedGenericType.classifierGenericType->toOne()
                    ->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).typeArguments->at(0);
        $cgt->match([
            gtv : meta::pure::metamodel::type::generics::GenericTypeValue[1] | 'gtv',
            u   : meta::pure::metamodel::type::generics::UndefinedGenericType[1] | 'undefined',
            a   : meta::pure::metamodel::type::generics::GenericType[1] | 'gt-other'
        ]);
    ));
}

// Repro for the match [1]-arm leakage bug. The [1] arm of match dispatches
// to the lambda with the raw input (a sequence-of-1); the lambda body `| $n`
// returns that sequence unchanged. When the result is then passed to a
// function expecting `T[1]`, the receiver gets the wrapper instead of the
// scalar. Without caller-driven shape coercion at the function-call binding,
// property access inside that function fails because the receiver is a
// sequence wrapper, not a PDO.
Class meta::pure::functions::lang::tests::match::M_Node
{
    name : String[1];
}

function <<test.TestDependency>> meta::pure::functions::lang::tests::match::useNodeAsScalar(node: M_Node[1]): String[1]
{
    $node.name;
}

// Produces a runtime PureSequence-of-1 via filter — vs an inline `[X]`
// literal, which Truffle's RawCollectionNode constant-folds to a bare scalar
// at parse time.
function <<test.TestDependency>> meta::pure::functions::lang::tests::match::singleNodeNamed(name: String[1]): M_Node[*]
{
    [^M_Node(name=$name), ^M_Node(name='_decoy_')]->filter(n | $n.name == $name);
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchOneArmFeedsScalarParam<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('alpha', $f->eval(|useNodeAsScalar(singleNodeNamed('alpha')->match(
                                                [
                                                    n0 : M_Node[0] | ^M_Node(name='missing'),
                                                    n  : M_Node[1] | $n
                                                ]
                                            )
                                        )
                                   )
   );
}

// Repro for Truffle AST-build NPE: lowerBody reads expressionSequence as null
// on this function. Bootstrap compiles + executes it fine; only Truffle's
// PureASTBuilder.lowerBody chokes ("Cannot invoke PureSequence.size() because
// seq is null").
Class meta::pure::functions::lang::tests::match::MA_Node
{
    name : String[1];
}

function <<test.TestDependency>> meta::pure::functions::lang::tests::match::useAsScalar(node: MA_Node[1]): String[1]
{
    $node.name;
}

function <<test.TestDependency>> meta::pure::functions::lang::tests::match::singletonSeq(name: String[1]): MA_Node[*]
{
    [^MA_Node(name=$name), ^MA_Node(name='_other_')]->filter(n | $n.name == $name);
}

function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchOneArmPassedToScalarParam<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('alpha', $f->eval(|useAsScalar(singletonSeq('alpha')->match([
        n0 : MA_Node[0] | ^MA_Node(name='missing'),
        n  : MA_Node[1] | $n
    ]))));
}

// Match-on-LambdaFunction should hit the LambdaFunction case, not fall through
// to the Any catch-all. Sister regression to `testGenericTypeOnLambda` /
// `testGenericTypeOnCapturingLambda` in meta/type/genericType.pure — both
// stem from the same root: `classifierGenericType` must be stamped on a
// lambda PDO for downstream dispatch.
function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchOnLambda<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('lambda',
                 $f->eval(|let lambda = {| 1 + 2}; $lambda->match([
                    lf : meta::pure::metamodel::function::LambdaFunction<Any>[1] | 'lambda',
                    a  : Any[1] | 'other'
                 ]);));
}

// REGRESSION: capturing-lambda match. Currently fails — the runtime path
// that captures open variables produces a value without classifierGenericType,
// so the LambdaFunction case is skipped and we hit the Any catch-all.
function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchOnCapturingLambda<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('lambda',
                 $f->eval(|let a = 5; let lambda = {| $a + 1}; $lambda->match([
                    lf : meta::pure::metamodel::function::LambdaFunction<Any>[1] | 'lambda',
                    any: Any[1] | 'other'
                 ]);));
}
