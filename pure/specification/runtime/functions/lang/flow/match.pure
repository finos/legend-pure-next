function <<PCT.test>> meta::pure::functions::lang::tests::match::testMatchZeroWithMany<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
   assertEquals('address', $f->eval(|[]->cast(@String)->match([
