import meta::pure::functions::asserts::*;
import meta::pure::functions::collection::*;
import meta::pure::test::pct::*;

function meta::pure::functions::collection::orElse<T>(value:T[0..1], default:T[1]): T[1]
{
    if($value->isEmpty(), | $default, | $value->toOne());
}

function <<PCT.test>> meta::pure::functions::collection::tests::orElse::testOrElseWithPresent<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(5, $f->eval(|5->orElse(99)));
}

function <<PCT.test>> meta::pure::functions::collection::tests::orElse::testOrElseWithEmpty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(99, $f->eval(|
        let empty = []->cast(@Integer);
        $empty->orElse(99);
    ));
}

function <<PCT.test>> meta::pure::functions::collection::tests::orElse::testOrElseWithStringPresent<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('hello', $f->eval(|'hello'->orElse('default')));
}

function <<PCT.test>> meta::pure::functions::collection::tests::orElse::testOrElseWithStringEmpty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('default', $f->eval(|
        let empty = []->cast(@String);
        $empty->orElse('default');
    ));
}

// `orElse` returns T[1] — ONE value, not a collection that happens to hold one. The four tests
// above cannot see that difference: equality treats a single value and a one-element collection as
// the same, so a host may hand back the wrong shape and still pass all four.
//
// `instanceOf` can see it, because it takes its instance as `Any[1]`: ask whether the result is a
// String and a result still wearing the collection shape says no.
//
// The input has to come from a REAL [0..1] expression — `head()` here. A literal written into the
// call (`'present'->orElse(…)`) is already one value, so it comes back unchanged whatever the host
// does with the shape, and would pin nothing.
function <<PCT.test>> meta::pure::functions::collection::tests::orElse::testOrElsePresentResultIsOneValue<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|
        let present = ['present', 'other']->head();
        $present->orElse('fallback')->instanceOf(String);
    ));
}

// And the defaulted arm has to come back in the same shape as the present one.
function <<PCT.test>> meta::pure::functions::collection::tests::orElse::testOrElseDefaultedResultIsOneValue<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|
        let missing = []->cast(@String)->head();
        $missing->orElse('fallback')->instanceOf(String);
    ));
}
