{
  val : P8[1];
}

function <<PCT.test>> meta::pure::functions::lang::tests::cast::testPrimitiveExtensionCast<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
  assertEquals(1, $f->eval(|^Container(val=1->cast(@P8)).val));
}

