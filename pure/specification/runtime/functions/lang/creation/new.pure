}

function <<test.Test>> meta::pure::functions::lang::tests::new::testClassifierGenericType():Boolean[1]
{
    let x = ^LA_Person(firstName='Pierre', lastName='Doe');
    assertIs (LA_Person, $x.classifierGenericType->cast(@GenericTypeValue).type);
}

function <<test.Test>> meta::pure::functions::lang::tests::new::testCantSetClassifierGenericType():Boolean[1]
{
    // The classifier's *raw type* is system-managed (it identifies the
    // metaclass — `LA_Person` here). User-supplied classifierGenericType
    // values must wrap the same raw type; only typeArguments,
    // multiplicityArguments and typeVariableValues are user-customizable.
    // Wrapping `Any` instead of `LA_Person` is rejected.
    assertError(|^LA_Person(classifierGenericType = ^UserDefinedGenericType(type=Any), firstName='Pierre', lastName='Doe')
                , 'Cannot change classifierGenericType.type from \'meta::pure::functions::lang::tests::model::LA_Person\' to \'meta::pure::metamodel::type::Any\'. The classifier\'s raw type is system-managed (derived from the instance\'s metaclass) — only typeArguments, multiplicityArguments and typeVariableValues are user-customizable. Use meta::pure::functions::lang::new(GenericType[1]) to construct an instance with a different metaclass.');
}

function <<test.Test>> meta::pure::functions::lang::tests::new::testNewSelfReferenceLoop():Boolean[1]
{
    let n = ^LA_Node(value=1, next=~);
    assertEquals(1, $n.value);
    assertIs($n, $n.next->toOne());
}

function <<test.Test>> meta::pure::functions::lang::tests::new::testNewNestedBackReference():Boolean[1]
{
    // Outer node's next is an inner node whose next points back to the outer via ~.~
    let outer = ^LA_Node(value=1, next=^LA_Node(value=2, next=~.~));
    assertEquals(1, $outer.value);
    let inner = $outer.next->toOne();
    assertEquals(2, $inner.value);
    assertIs($outer, $inner.next->toOne());
}

// Platform-level invariant: ^Type(...) with no <> type-args anchors the new
// instance's classifierGenericType at the canonical GenericType_<TypeName>
// UDPGT-PE from core.pdb (when one exists). This keeps PDB output byte-equivalent
// across Java direct, Truffle, and compile-via-pure platforms.
function <<test.Test>> meta::pure::functions::lang::tests::new::testNewAnchorsAtCanonicalUDPGT():Boolean[1]
{
    let ft = ^meta::pure::metamodel::type::FunctionType(
        returnType = ^meta::pure::metamodel::type::generics::InferredGenericType(type = meta::pure::metamodel::type::Any),
        returnMultiplicity = meta::pure::metamodel::multiplicity::PureOne
    );
    let cgt = $ft.classifierGenericType->toOne();
    // The classifier must be a PackageableElement (canonical UDPGT-PE),
    // not a fresh inline UDGT.
    assert($cgt->instanceOf(meta::pure::metamodel::PackageableElement),
        'Expected classifierGenericType to be a canonical UDPGT-PE but got ' + $cgt.classifierGenericType->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type->toOne()->cast(@meta::pure::metamodel::PackageableElement)->elementToPath()
    );
    // The path must be GenericType_<TypeName>
    assertEquals(
        'meta::pure::metamodel::type::generics::optimization::GenericType_meta_pure_metamodel_type_FunctionType',
        $cgt->cast(@meta::pure::metamodel::PackageableElement)->elementToPath()
    );
}

function <<test.Test>> meta::pure::functions::lang::tests::new::testNewGenericTypeAnchorsAtCanonical():Boolean[1]
{
    // new(buildUserDefinedGenericType(SomeType)) should also anchor at canonical
    // UDPGT-PE — mirrors the ^Type(...) syntax behavior. Tests the
    // new(GenericType[1]) native specifically.
    let varExpr = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
            type = meta::pure::metamodel::valuespecification::VariableExpression
        )
    );
    let cgt = $varExpr->cast(@meta::pure::metamodel::type::Any).classifierGenericType->toOne();
    assert($cgt->instanceOf(meta::pure::metamodel::PackageableElement),
        'Expected new(GenericType) result classifier to be canonical UDPGT-PE'
    );
    assertEquals(
        'meta::pure::metamodel::type::generics::optimization::GenericType_meta_pure_metamodel_valuespecification_VariableExpression',
        $cgt->cast(@meta::pure::metamodel::PackageableElement)->elementToPath()
    );
}

// Cross-platform invariant: when a `| Nil` lambda body resolves to the canonical
// `Nil` PackageableElement (via processPackagePointer), the lambda's classifier
// hierarchy should bottom out at the canonical GenericType_Nil UDPGT-PE for the
// inner Nil_GT typeArg. This is the platform-divergent case observed in
// findCommonType's nested `if([pair, pair], ...)` structure: compile-via-pure
// preserves canonical UDPGT-PE here, but Java direct's `_GenericType.reconcileInferred`
// converts the canonical reference to a fresh inline UDGT during type
// reconciliation. This test pins down the canonical-preservation expectation.
function <<test.Test>> meta::pure::functions::lang::tests::new::testNilLambdaPreservesCanonicalAnchor():Boolean[1]
{
    let nilLambda = {|Nil};
    let classifier = $nilLambda->genericType();
    // classifier = LambdaFunction<{->Class<Nil>[1]}>
    // typeArguments[0] = {->Class<Nil>[1]} GT (FunctionType wrapper)
    // .type = FunctionType — .returnType = Class<Nil>[1] GT
    // .typeArguments[0] = Nil_GT  ← the position we care about
    let ftGT = $classifier.typeArguments->at(0)->cast(@GenericTypeValue);
    let ft = $ftGT.type->toOne()->cast(@FunctionType);
    let returnTypeGT = $ft.returnType->toOne()->cast(@GenericTypeValue);
    let nilGT = $returnTypeGT.typeArguments->at(0);
    // Nil_GT should be a canonical UDPGT-PE (same canonical reference as
    // model.getElement("...GenericType_Nil"))
    assert($nilGT->instanceOf(PackageableElement),
        'Expected | Nil lambda inner Nil_GT to be canonical UDPGT-PE'
    );
    assertEquals(
        'meta::pure::metamodel::type::generics::optimization::GenericType_meta_pure_metamodel_type_Nil',
        $nilGT->cast(@PackageableElement)->elementToPath()
    );
}

// Same invariant as testNilLambdaPreservesCanonicalAnchor but for `| Any`.
function <<test.Test>> meta::pure::functions::lang::tests::new::testAnyLambdaPreservesCanonicalAnchor():Boolean[1]
{
    let anyLambda = {|Any};
    let classifier = $anyLambda->genericType();
    let ftGT = $classifier.typeArguments->at(0)->cast(@GenericTypeValue);
    let ft = $ftGT.type->toOne()->cast(@FunctionType);
    let returnTypeGT = $ft.returnType->toOne()->cast(@GenericTypeValue);
    let anyGT = $returnTypeGT.typeArguments->at(0);
    assert($anyGT->instanceOf(PackageableElement),
        'Expected | Any lambda inner Any_GT to be canonical UDPGT-PE'
    );
    assertEquals(
        'meta::pure::metamodel::type::generics::optimization::GenericType_meta_pure_metamodel_type_Any',
        $anyGT->cast(@PackageableElement)->elementToPath()
    );
}

// new(holder) (no keys) — same canonical-anchor invariant as ^Type(...).
function <<test.Test>> meta::pure::functions::lang::tests::new::testNewHolderNoKeysAnchor():Boolean[1]
{
    let inst = meta::pure::functions::lang::new(@meta::pure::metamodel::valuespecification::VariableExpression|1);
    let cgt = $inst->cast(@meta::pure::metamodel::type::Any).classifierGenericType->toOne();
    assert($cgt->instanceOf(PackageableElement),
        'Expected new(holder) result classifier to be canonical UDPGT-PE'
    );
    assertEquals(
        'meta::pure::metamodel::type::generics::optimization::GenericType_meta_pure_metamodel_valuespecification_VariableExpression',
        $cgt->cast(@PackageableElement)->elementToPath()
    );
}