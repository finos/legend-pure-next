function <<PCT.test>> meta::pure::functions::math::tests::evaluate::divide::testNumberDivide<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(1.75, $f->eval(|
        let lambda = {a:Number[1], b:Number[1] | $a / $b};
        $lambda->eval(3.5, 2);
    ));
}

function <<PCT.test>> meta::pure::functions::string::tests::evaluate::plus::testPlusInLambda<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('Hoboken, NJ; Jersey City, NJ', $f->eval(|
        let hoboken = ^LA_Location(place='Hoboken, NJ', type=LA_GeographicEntityType.CITY);
        let jc = ^LA_Location(place='Jersey City, NJ', type=LA_GeographicEntityType.CITY);
        {x, y | $x.place + '; ' + $y.place}->eval($hoboken, $jc);
    ));
}
