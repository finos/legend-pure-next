import meta::pure::functions::lang::tests::model::*;
import meta::pure::test::pct::*;

native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::lang::evaluate(func:Function<Any>[1], params:List<Any>[*]):Any[*];


function <<PCT.test>> meta::pure::functions::lang::tests::evaluate::testEvaluateOne<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('name', $f->eval(|
        let p = ^LA_Person(firstName='name', lastName='name');
        LA_Person.properties->filter(x|$x.name == 'lastName')->toOne()->eval($p);
    ));
}

function <<PCT.test>> meta::pure::functions::lang::tests::evaluate::testEvaluateInheritance<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(LA_GeographicEntityType.CITY, $f->eval(|
        let lambda = {p:LA_GeographicEntity[1] | $p.type};
        $lambda->eval(^LA_Address(type=LA_GeographicEntityType.CITY, name='Jersey City'));
    ));
}

function <<PCT.test>>   meta::pure::functions::lang::tests::evaluate::testEvaluateAnyWithMultiplicities<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let lambda = {s:String[1], p:String[*] | $s + ' \/\/ ' + $p->joinStrings(',')};
    assertEquals(['ok \/\/ ok1'], $f->eval(|
        $lambda->evaluate([^List<String>(values='ok'), ^List<String>(values='ok1')]);
    ));
    assertEquals(['ok \/\/ ok1,ok2'], $f->eval(|
        $lambda->evaluate([^List<String>(values='ok'), ^List<String>(values=['ok1', 'ok2'])]);
    ));
}

function <<PCT.test>> meta::pure::functions::lang::tests::eval::testEvalOne<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('Hoboken, NJ', $f->eval(|
        let address = ^LA_Address(name='Hoboken, NJ', type=LA_GeographicEntityType.CITY);
        {a | $a.name}->eval($address);
    ));
}

function <<PCT.test>> meta::pure::functions::lang::tests::evaluate::testEvaluateWithNoParams<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
   assertEquals('Something else', $f->eval(|
       let lambda = { | 'Something' + ' else'};
       $lambda->evaluate([]);
   ));
}

function <<PCT.test>> meta::pure::functions::lang::tests::evaluate::testEvaluateQualifier<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('Joe Bloggs', $f->eval(|
        let p = ^LA_Person(firstName='Joe', lastName='Bloggs');
        LA_Person.qualifiedProperties->filter(x | $x.name == 'name')->toOne()->evaluate(^List<Any>(values=$p));
    ));
}

function <<PCT.test>> meta::pure::functions::lang::tests::evaluate::testEvaluateQualifierWithParam<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('Mr Joe Bloggs', $f->eval(|
        let p = ^LA_Person(firstName='Joe', lastName='Bloggs');
        LA_Person.qualifiedProperties->filter(x | $x.name == 'nameWithTitle')->toOne()->evaluate([^List<Any>(values=$p), ^List<Any>(values='Mr')]);
    ));
}

