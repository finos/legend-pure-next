import meta::pure::test::pct::*;

// Returns the formatted string it just wrote (value + trailing newline) so
// tests can assert on the exact rendering without intercepting stdout.
// Implementation is two `print` calls — `print` returns the formatted
// string, so println simply concatenates the two returns.
function <<PCT.function, PCT.platformOnly>> meta::pure::functions::io::println(param:Any[*], max:Integer[1]):String[1]
{
    print($param, $max) + print('\n', $max);
}

function <<PCT.function, PCT.platformOnly>> meta::pure::functions::io::println(param:Any[*]):String[1]
{
    println($param, 1);
}

// =============================================================================
// Tests — reuses TestPerson / TestNested classes defined in `print.pure`.
// =============================================================================

function <<PCT.test>> meta::pure::functions::io::tests::testPrintlnInteger<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('42\n', $f->eval(|println(42)));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintlnString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('hello\n', $f->eval(|println('hello')));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintlnBoolean<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('true\n', $f->eval(|println(true)));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintlnList<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        '''
        1
        2
        3
        ''',
        $f->eval(|println([1, 2, 3]))
    );
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintlnObject<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        'TestPerson\n' +
        '  name: \'Carol\'\n' +
        '  age: 40\n',
        $f->eval(|println(^meta::pure::functions::io::tests::TestPerson(name='Carol', age=40))));
}
