import meta::pure::test::pct::*;

// Returns all regular file paths (recursively) under the given directory, sorted.
native function <<functionType.SideEffectFunction, PCT.function, PCT.platformOnly>> meta::pure::functions::io::directoryTree(path:String[1]):String[*];

// Reads a file's contents as a string.
//
// Defined in Pure rather than natively: now that readFileBytes hands back a
// Binary — a host byte array, not a boxed list — decoding it here costs nothing
// and removes four platform implementations.
//
// One behaviour change from the native `Files.readString`: malformed UTF-8 is
// replaced with U+FFFD rather than raising. A file that is not valid UTF-8 now
// reads as replacement characters instead of failing.
function <<functionType.SideEffectFunction>> meta::pure::functions::io::readFile(path:String[1]):String[1]
{
   $path->meta::pure::functions::io::readFileBytes()->meta::pure::functions::binary::utf8BytesToString();
}

// Reads a file's raw bytes, for binary files such as PDB archives. Returns a
// Binary so the bytes stay a host array: as Integer[*] a multi-megabyte .pdb
// became millions of boxed values at the native boundary.
native function <<functionType.SideEffectFunction, PCT.function, PCT.platformOnly>> meta::pure::functions::io::readFileBytes(path:String[1]):Binary[1];

// Writes content to a file, creating parent directories and replacing any existing file. Returns the path.
native function <<functionType.SideEffectFunction, PCT.function, PCT.platformOnly>> meta::pure::functions::io::writeFile(path:String[1], content:String[1]):String[1];
