import meta::pure::test::pct::*;

// `print` writes the value to stdout AND returns the formatted string. The
// caller almost always discards the return, but having it available lets
// tests assert on the exact rendering and lets {@code println} compose
// (`println` is just `print + print('\n')` with concatenated returns).
//
// `max` is the recursion-depth bound used when formatting nested objects;
// current backends ignore it.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::io::print(param:Any[*], max:Integer[1]):String[1];

function <<PCT.function, PCT.platformOnly>> meta::pure::functions::io::print(param:Any[*]):String[1]
{
    print($param, 1);
}

// =============================================================================
// Tests — shared with `println.pure` via the test class graph defined here.
// =============================================================================

// Test class graph. <<test.TestDependency>> keeps these out of regular
// compile output but compiled when tests run; the println tests reuse them.
Class <<test.TestDependency>> meta::pure::functions::io::tests::TestPerson
{
    name : String[1];
    age : Integer[1];
}

Class <<test.TestDependency>> meta::pure::functions::io::tests::TestNested
{
    label : String[1];
    person : meta::pure::functions::io::tests::TestPerson[1];
}

Enum <<test.TestDependency>> meta::pure::functions::io::tests::Color
{
    RED, GREEN, BLUE
}

// Three-level deep type — exercises nesting beyond the simple 2-level case.
Class <<test.TestDependency>> meta::pure::functions::io::tests::TestBox
{
    title : String[1];
    inner : meta::pure::functions::io::tests::TestNested[1];
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintInteger<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('42', $f->eval(|print(42)));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // Top-level strings render without surrounding quotes — matches what
    // stdout receives.
    assertEquals('hello', $f->eval(|print('hello')));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintBoolean<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('true', $f->eval(|print(true)));
    assertEquals('false', $f->eval(|print(false)));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintFloat<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('3.14', $f->eval(|print(3.14)));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintEmpty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|print([]->cast(@Integer))));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintListPrimitives<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        '''
        1
        2
        3''',
        $f->eval(|print([1, 2, 3]))
    );
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintListStrings<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        '''
        a
        b
        c''',
        $f->eval(|print(['a', 'b', 'c']))
    );
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintObject<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        'TestPerson\n' +
        '  name: \'Alice\'\n' +
        '  age: 30',
        $f->eval(|print(^meta::pure::functions::io::tests::TestPerson(name='Alice', age=30))));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintListObjects<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        'TestPerson\n' +
        '  name: \'Alice\'\n' +
        '  age: 30\n' +
        'TestPerson\n' +
        '  name: \'Bob\'\n' +
        '  age: 25',
        $f->eval(|print([
            ^meta::pure::functions::io::tests::TestPerson(name='Alice', age=30),
            ^meta::pure::functions::io::tests::TestPerson(name='Bob', age=25)
        ])));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintNestedObject<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        'TestNested\n' +
        '  label: \'wrapper\'\n' +
        '  person: TestPerson\n' +
        '    name: \'Bob\'\n' +
        '    age: 25',
        $f->eval(|print(^meta::pure::functions::io::tests::TestNested(
            label='wrapper',
            person=^meta::pure::functions::io::tests::TestPerson(name='Bob', age=25)
        ))));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintDeeplyNestedObject<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // 3-level nesting (TestBox → TestNested → TestPerson) — verifies the
    // indent grows two spaces per level beyond the top level.
    assertEquals(
        'TestBox\n' +
        '  title: \'outer\'\n' +
        '  inner: TestNested\n' +
        '    label: \'inner\'\n' +
        '    person: TestPerson\n' +
        '      name: \'Dave\'\n' +
        '      age: 22',
        $f->eval(|print(^meta::pure::functions::io::tests::TestBox(
            title='outer',
            inner=^meta::pure::functions::io::tests::TestNested(
                label='inner',
                person=^meta::pure::functions::io::tests::TestPerson(name='Dave', age=22)
            )
        ))));
}

function <<PCT.test>> meta::pure::functions::io::tests::testPrintEnumValue<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // Enum value rendering diverges between backends today: Java-direct
    // walks the metaclass and prints `Color\n  name: 'RED'`, while Truffle
    // resolves the enum literal to a String of its qualified path. Pin only
    // the stable bit — the case name 'RED' appears in the output.
    assert($f->eval(|print(meta::pure::functions::io::tests::Color.RED)->contains('RED')));
}
