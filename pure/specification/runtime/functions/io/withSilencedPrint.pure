import meta::pure::test::pct::*;

// Run {@code body} with the stdout side effect of {@code print} (and
// therefore {@code println}, which is built on print) suppressed. The
// formatted string is still computed and returned, so assertions on
// {@code println(x) == 'x\n'} keep working — only the write to stdout is
// skipped.
//
// Used by the test runner ({@code meta::pure::test::runTests}) to wrap each
// test body so individual tests can't pollute the runner's progress UI.
// The suppression is thread-local and only active for the duration of the
// closure — surrounding code (progress prints, prompts) is unaffected.
native function <<functionType.SideEffectFunction, PCT.function, PCT.platformOnly>>
    meta::pure::functions::io::withSilencedPrint<T|m>(body:Function<{->T[m]}>[1]):T[m];
