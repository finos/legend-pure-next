import meta::pure::functions::asserts::*;
import meta::pure::functions::boolean::*;

function meta::pure::functions::boolean::isTrue(b:Boolean[0..1]): Boolean[1]
{
    !$b->isEmpty() && $b->toOne();
}

function <<test.Test>> meta::pure::functions::boolean::tests::isTrue::testIsTrueOnTrue():Boolean[1]
{
    assert(isTrue(true));
}

function <<test.Test>> meta::pure::functions::boolean::tests::isTrue::testIsTrueOnFalse():Boolean[1]
{
    assertFalse(isTrue(false));
}

function <<test.Test>> meta::pure::functions::boolean::tests::isTrue::testIsTrueOnEmpty():Boolean[1]
{
    assertFalse(isTrue([]));
}
