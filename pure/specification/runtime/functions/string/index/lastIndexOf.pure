import platform::pure::test::pct::*;
import platform::pure::functions::string::*;

native function <<PCT.function>> platform::pure::functions::string::lastIndexOf(str:String[1], toFind:String[1]):Integer[1];


function <<PCT.test>> platform::pure::functions::string::tests::lastIndexOf::testSimple<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let string = 'the quick brown fox jumps over the lazy dog';

    assertEquals(31, $f->eval(|$string->lastIndexOf('the')));
    assertEquals(16, $f->eval(|$string->lastIndexOf('fox')));
    assertEquals(-1, $f->eval(|$string->lastIndexOf('happy')));
}

function <<PCT.test>> platform::pure::functions::string::tests::lastIndexOf::testEmptySubstring<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let string = 'abc';
    assertEquals(3, $f->eval(|$string->lastIndexOf('')));
}

function <<PCT.test>> platform::pure::functions::string::tests::lastIndexOf::testSingleChar<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(6, $f->eval(|'meta::pure'->lastIndexOf('p')));
    assertEquals(5, $f->eval(|'meta::pure'->lastIndexOf(':')));
}
