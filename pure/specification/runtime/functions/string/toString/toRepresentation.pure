function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testClassToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('meta::pure::functions::string::tests::toRepresentation::ST_Person', $f->eval(|ST_Person->toRepresentation()));
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testFunctionToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('meta::pure::functions::string::toRepresentation_Any_1__String_1_', $f->eval(|meta::pure::functions::string::toRepresentation_Any_1__String_1_->toRepresentation()));
}

Class <<test.TestDependency>> meta::pure::functions::string::tests::toRepresentation::ST_List<T>
{
    values : T[*];
}

Class <<test.TestDependency>> meta::pure::functions::string::tests::toRepresentation::ST_Person
{
    firstName : String[1];
    lastName : String[1];
}
