import meta::pure::functions::string::tests::toRepresentation::*;
import meta::pure::test::pct::*;

function <<PCT.function, PCT.platformOnly>> meta::pure::functions::string::toRepresentation(any:Any[1]):String[1]
{
    $any->match([
                 s:String[1] | '\'' + $s->replace('\\', '\\\\')->replace('\'', '\\\'')->replace('\n', '\\n') + '\'',
                 t:StrictTime[1] | '%' + $t->toString(),
                 d:Date[1] | '%' + $d->toString(),
                 d:Decimal[1] | $d->toString() + 'D',
                 n:Number[1] | $n->toString(),
                 b:Boolean[1] | $b->toString(),
                 p:PackageableElement[1] | $p->elementToPath(),
                 a:Any[1] | '<' + $a->toString() + ' instanceOf ' + $a->type()->elementToPath() + '>'
                ])
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testIntegerToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['1', '-1'], $f->eval(|[1, -1]->map(v | $v->toRepresentation())));
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testFloatToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['3.14', '3.14159'], $f->eval(|[3.14, 3.14159]->map(v | $v->toRepresentation())));
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testFloatToRepresentationWithExcessTrailingZeros<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['17.0', '17.0'], $f->eval(|[17.0, 17.000]->map(v | $v->toRepresentation())));
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testFloatToRepresentationWithNoLeadingZero<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['0.01', '0.01'], $f->eval(|[0.01, .01]->map(v | $v->toRepresentation())));
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testFloatToRepresentationWithPositiveExponent<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['134210000.0', '134210000.0', '134210000.0', '134210000.0'],
                 $f->eval(|[134.21e6, 1.3421e8, 0.13421e9, 134210000.0]->map(v | $v->toRepresentation())));
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testFloatToRepresentationWithNegativeExponent<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['0.000000013421', '0.000000013421', '0.000000013421', '0.000000013421'],
                 $f->eval(|[134.21e-10, 1.3421e-8, 0.13421e-7, 0.000000013421]->map(v | $v->toRepresentation())));
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testBooleanToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['true', 'false'], $f->eval(|[true, false]->map(v | $v->toRepresentation())));
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testStringToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        ['\'the quick brown fox jumps over the lazy dog\'',
         '\'\'',
         '\'\\\\\'',
         '\'\\n\'',
         '\'the quick brown fox jumps over the lazy \\\\ \\\'dog\\\'\''],
        $f->eval(|['the quick brown fox jumps over the lazy dog', '', '\\', '\n', 'the quick brown fox jumps over the lazy \\ \'dog\'']->map(v | $v->toRepresentation()))
    );
}

function <<PCT.test>> meta::pure::functions::string::tests::toRepresentation::testSimpleDateToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('%2014-01-02T01:54:27.352', $f->eval(|%2014-01-01T20:54:27.352-0500->toRepresentation()));
}

function <<PCT.test>>  meta::pure::functions::string::tests::toRepresentation::testDateTimeWithTimezoneToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        ['%2014-01-01T00:00:00.0000', '%2014-01-01T00:00:00.0000',
         '%2014-01-01T00:00:00.000', '%2014-01-01T00:00:00.000',
         '%2014-01-01T00:00:00.0', '%2014-01-01T00:00:00.0',
         '%2014-01-01T00:00', '%2014-01-01T00:00'],
        $f->eval(|[
            %2014-01-01T00:00:00.0000+0000, %2014-01-01T00:00:00.0000-0000,
            %2014-01-01T00:00:00.000+0000, %2014-01-01T00:00:00.000-0000,
            %2014-1-1T0:00:00.0+0000, %2014-1-1T0:00:00.0-0000,
            %2014-1-1T0:00+0000, %2014-1-1T0:00-0000
        ]->map(d | $d->toRepresentation()))
    );
}

function <<PCT.test>>  meta::pure::functions::string::tests::toRepresentation::testDateTimeToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        ['%2014-01-01T00:00:00.000', '%2014-01-01T00:00:00.00', '%2014-01-01T00:00:00.0', '%2014-01-01T00:00:00'],
        $f->eval(|[%2014-01-01T00:00:00.000, %2014-01-01T00:00:00.00, %2014-1-1T0:00:00.0, %2014-1-1T0:00:00]->map(d | $d->toRepresentation()))
    );
}

function <<PCT.test>>  meta::pure::functions::string::tests::toRepresentation::testDateToRepresentation<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(
        ['%2014-01-01', '%2014-01-01', '%2014-01', '%2014-01', '%2014'],
        $f->eval(|[%2014-01-01, %2014-1-1, %2014-01, %2014-1, %2014]->map(d | $d->toRepresentation()))
    );
}

