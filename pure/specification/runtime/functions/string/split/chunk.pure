import meta::pure::test::pct::*;
import meta::pure::functions::string::*;

// Splits a String into consecutive pieces of at most `chunkSize` characters
// each. The last piece may be shorter. An empty string yields no chunks.
native function <<PCT.function>> meta::pure::functions::string::chunk(str:String[1], chunkSize:Integer[1]):String[*];


function <<PCT.test>> meta::pure::functions::string::tests::chunk::testEvenSplit<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['abcd', 'efgh'], $f->eval(|'abcdefgh'->chunk(4)));
}

function <<PCT.test>> meta::pure::functions::string::tests::chunk::testUnevenSplit<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['abc', 'def', 'g'], $f->eval(|'abcdefg'->chunk(3)));
}

function <<PCT.test>> meta::pure::functions::string::tests::chunk::testChunkSizeLargerThanString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['abc'], $f->eval(|'abc'->chunk(99)));
}

function <<PCT.test>> meta::pure::functions::string::tests::chunk::testChunkSizeOne<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['a', 'b', 'c'], $f->eval(|'abc'->chunk(1)));
}

function <<PCT.test>> meta::pure::functions::string::tests::chunk::testEmptyString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals([], $f->eval(|''->chunk(3)));
}
