import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::test::pct::*;

// Construct an anonymous Class<Any> with the given type/multiplicity parameters,
// a self-referencing classifierGenericType (Class<self<TPs, MPs>>) and the
// parameters' `owner` slots wired back to the new class via `~` notation.
//
// `~.~` inside the typeParameters / multiplicityParameters list resolves to
// the outer ^Class<Any> being built, so each parameter copy's owner points at
// the surviving class instance rather than the input. `~.~.~` inside the
// nested selfGT does the same for the self-reference in the CGT.
function <<PCT.function>> meta::pure::functions::meta::creation::newClass(typeParameters:meta::pure::metamodel::type::generics::TypeParameter[*], multiplicityParameters:meta::pure::metamodel::multiplicity::MultiplicityParameter[*]): Class<Any>[1]
{
    ^Class<Any>(
        name = '',
        typeParameters = $typeParameters->map(tp | ^$tp(owner = ~.~)),
        multiplicityParameters = $multiplicityParameters->map(mp | ^$mp(owner = ~.~))->cast(@MultiplicityParameter),
        // The CGT slot reads ~.~.~.typeParameters / ~.~.~.multiplicityParameters
        // to share the *wired* parameter instances (with owner=this class) between
        // `cls.typeParameters` and `cls.cgt.typeArgs[0].typeArgs[i].type`. The
        // platform `new()` native evaluates and APPLIES key expressions in source
        // order, so the typeParameters / multiplicityParameters slots are set
        // BEFORE this slot's expression runs.
        classifierGenericType = ^UserDefinedGenericType(
            type = Class,
            typeArguments = [^UserDefinedGenericType(
                type = ~.~.~,
                typeArguments = ~.~.~.typeParameters->map(tp | ^UserDefinedGenericType(type = $tp))->cast(@meta::pure::metamodel::type::generics::GenericType),
                multiplicityArguments = ~.~.~.multiplicityParameters->cast(@Multiplicity)
            )]
        )
    );
}

function <<PCT.test>> meta::pure::functions::meta::tests::creation::testNewClassEmpty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|
        let cls = meta::pure::functions::meta::creation::newClass([], []);
        // Should be a Class
        assert($cls->instanceOf(Class));
        // Self-referencing CGT: Class<cls>
        let cgt = $cls.classifierGenericType->toOne()->cast(@GenericTypeValue);
        assertIs(Class, $cgt.type->toOne());
        assertIs($cls, $cgt.typeArguments->at(0)->cast(@GenericTypeValue).type->toOne());
        // No type parameters or multiplicity parameters
        assertEquals(0, $cls.typeParameters->size());
        assertEquals(0, $cls.multiplicityParameters->size());
    ));
}

function <<PCT.test>> meta::pure::functions::meta::tests::creation::testNewClassWithTypeParameter<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|
        let tp = ^TypeParameter(name='T', contravariant=false);
        let cls = meta::pure::functions::meta::creation::newClass([$tp], []);
        // Type parameters should be set
        assertEquals(1, $cls.typeParameters->size());
        // TypeParameter owner should be the created class
        assert($cls.typeParameters->at(0).owner->isNotEmpty(), 'TypeParameter owner should be set');
        assertIs($cls, $cls.typeParameters->at(0).owner->toOne());
        // Self-referencing CGT should include the type parameter
        let selfGT = $cls.classifierGenericType->toOne()->cast(@GenericTypeValue).typeArguments->at(0)->cast(@GenericTypeValue);
        assertIs($cls, $selfGT.type->toOne());
        assertEquals(1, $selfGT.typeArguments->size());
        assertIs($cls.typeParameters->at(0), $selfGT.typeArguments->at(0)->cast(@GenericTypeValue).type->toOne());
    ));
}

function <<PCT.test>> meta::pure::functions::meta::tests::creation::testNewClassWithMultipleTypeParameters<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|
        let tp1 = ^TypeParameter(name='T', contravariant=false);
        let tp2 = ^TypeParameter(name='U', contravariant=false);
        let cls = meta::pure::functions::meta::creation::newClass([$tp1, $tp2], []);
        assertEquals(2, $cls.typeParameters->size());
        // Both TypeParameters should have owner set to cls
        assertIs($cls, $cls.typeParameters->at(0).owner->toOne());
        assertIs($cls, $cls.typeParameters->at(1).owner->toOne());
    ));
}

function <<PCT.test>> meta::pure::functions::meta::tests::creation::testNewClassWithMultiplicityParameter<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|
        let tp = ^TypeParameter(name='K', contravariant=false);
        let mp = ^UserDefinedMultiplicityParameter(name='m');
        let cls = meta::pure::functions::meta::creation::newClass([$tp], [$mp]);
        assertEquals(1, $cls.typeParameters->size());
        assertEquals(1, $cls.multiplicityParameters->size());
        // MultiplicityParameter owner should be the created class
        assertIs($cls, $cls.multiplicityParameters->at(0).owner->toOne());
        // Self-referencing CGT should include both type arg and multiplicity arg
        let selfGT = $cls.classifierGenericType->toOne()->cast(@GenericTypeValue).typeArguments->at(0)->cast(@GenericTypeValue);
        assertIs($cls, $selfGT.type->toOne());
        assertEquals(1, $selfGT.typeArguments->size(), 'selfGT should have 1 type arg');
        assertEquals(1, $selfGT.multiplicityArguments->size(), 'selfGT should have 1 multiplicity arg');
    ));
}

