import meta::pure::functions::asserts::*;
import meta::pure::functions::meta::*;
import meta::pure::functions::meta::tests::value4Tag::*;
import meta::pure::metamodel::extension::*;

// Returns the TaggedValue on `element` matching the given (`profile`, `tag`)
// pair, or empty if none. Argument order mirrors legend-pure: element is the
// receiver (`$elt->value4Tag('tagName', SomeProfile)`).
function meta::pure::functions::meta::value4Tag(element:meta::pure::metamodel::extension::AnnotatedElement[1], tag:String[1], profile:meta::pure::metamodel::extension::Profile[1]): meta::pure::metamodel::extension::TaggedValue[0..1]
{
    $element.taggedValues->filter(tv | $tv.tag.profile == $profile && $tv.tag.value == $tag)->head();
}

Profile <<test.TestDependency>> meta::pure::functions::meta::tests::value4Tag::TagProfile
{
    tags: [doc, owner];
}

Class <<test.TestDependency>>
{
    TagProfile.doc   = 'sample class',
    TagProfile.owner = 'pierre'
}
meta::pure::functions::meta::tests::value4Tag::TaggedClass
{
}

function <<test.Test>> meta::pure::functions::meta::tests::value4Tag::testValue4TagPresent():Boolean[1]
{
    let tv = TaggedClass->value4Tag('doc', TagProfile);
    assertEquals('sample class', $tv->toOne().value);
}

function <<test.Test>> meta::pure::functions::meta::tests::value4Tag::testValue4TagDistinguishesTags():Boolean[1]
{
    assertEquals('pierre', TaggedClass->value4Tag('owner', TagProfile)->toOne().value);
}

function <<test.Test>> meta::pure::functions::meta::tests::value4Tag::testValue4TagMissing():Boolean[1]
{
    assert(TaggedClass->value4Tag('nonexistent', TagProfile)->isEmpty());
}
