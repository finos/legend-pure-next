import platform::pure::functions::asserts::*;
import platform::pure::functions::meta::*;
import platform::pure::functions::meta::tests::value4Tag::*;
import platform::pure::metamodel::extension::*;
import platform::pure::test::pct::*;

// Returns the TaggedValue on `element` matching the given (`profile`, `tag`)
// pair, or empty if none. Argument order mirrors legend-pure: element is the
// receiver (`$elt->value4Tag('tagName', SomeProfile)`).
function platform::pure::functions::meta::value4Tag(element:platform::pure::metamodel::extension::AnnotatedElement[1], tag:String[1], profile:platform::pure::metamodel::extension::Profile[1]): platform::pure::metamodel::extension::TaggedValue[0..1]
{
    $element.taggedValues->filter(tv | $tv.tag.profile == $profile && $tv.tag.value == $tag)->head();
}

Profile <<test.TestDependency>> platform::pure::functions::meta::tests::value4Tag::TagProfile
{
    tags: [doc, owner];
}

Class <<test.TestDependency>>
{
    TagProfile.doc   = 'sample class',
    TagProfile.owner = 'pierre'
}
platform::pure::functions::meta::tests::value4Tag::TaggedClass
{
}

function <<PCT.test>> platform::pure::functions::meta::tests::value4Tag::testValue4TagPresent<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('sample class', $f->eval(|TaggedClass->value4Tag('doc', TagProfile)->toOne().value));
}

function <<PCT.test>> platform::pure::functions::meta::tests::value4Tag::testValue4TagDistinguishesTags<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('pierre', $f->eval(|TaggedClass->value4Tag('owner', TagProfile)->toOne().value));
}

function <<PCT.test>> platform::pure::functions::meta::tests::value4Tag::testValue4TagMissing<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|TaggedClass->value4Tag('nonexistent', TagProfile)->isEmpty()));
}
