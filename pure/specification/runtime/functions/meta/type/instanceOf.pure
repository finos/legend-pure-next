import meta::pure::functions::meta::tests::model::*;
import meta::pure::test::pct::*;

native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::meta::instanceOf(instance:Any[1], type:Type[1]):Boolean[1];

function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfPrimitive<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|1->instanceOf(Integer)));
    assertEquals(true, $f->eval(|1->instanceOf(Number)));
    assertEquals(true, $f->eval(|1->instanceOf(Any)));
    assertEquals(false, $f->eval(|1->instanceOf(String)));
    assertEquals(false, $f->eval(|1->instanceOf(Boolean)));
    assertEquals(false, $f->eval(|1->instanceOf(Date)));
    assertEquals(false, $f->eval(|1->instanceOf(Float)));

    assertEquals(true, $f->eval(|'the quick brown fox jumps over the lazy dog'->instanceOf(String)));
    assertEquals(true, $f->eval(|'the quick brown fox jumps over the lazy dog'->instanceOf(Any)));
    assertEquals(false, $f->eval(|'the quick brown fox jumps over the lazy dog'->instanceOf(Integer)));
    assertEquals(false, $f->eval(|'the quick brown fox jumps over the lazy dog'->instanceOf(Number)));
    assertEquals(false, $f->eval(|'the quick brown fox jumps over the lazy dog'->instanceOf(Boolean)));
    assertEquals(false, $f->eval(|'the quick brown fox jumps over the lazy dog'->instanceOf(Date)));
    assertEquals(false, $f->eval(|'the quick brown fox jumps over the lazy dog'->instanceOf(Float)));

    assertEquals(true, $f->eval(|true->instanceOf(Boolean)));
    assertEquals(true, $f->eval(|true->instanceOf(Any)));
    assertEquals(false, $f->eval(|true->instanceOf(Integer)));
    assertEquals(false, $f->eval(|true->instanceOf(Number)));
    assertEquals(false, $f->eval(|true->instanceOf(String)));
    assertEquals(false, $f->eval(|true->instanceOf(Date)));
    assertEquals(false, $f->eval(|true->instanceOf(Float)));
}

function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfPrimitiveType<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|Boolean->instanceOf(PrimitiveType)));
    assertEquals(true, $f->eval(|Date->instanceOf(PrimitiveType)));
    assertEquals(true, $f->eval(|Integer->instanceOf(PrimitiveType)));
    assertEquals(true, $f->eval(|Float->instanceOf(PrimitiveType)));
    assertEquals(true, $f->eval(|Number->instanceOf(PrimitiveType)));
    assertEquals(true, $f->eval(|String->instanceOf(PrimitiveType)));
}

function <<PCT.test>>   meta::pure::functions::meta::tests::instanceOf::testInstanceOfDate<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|%2015-01-01->instanceOf(Date)));
    assertEquals(false, $f->eval(|1->instanceOf(Date)));
}

function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfInstance<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|let a = ^CC_Address(name='Jersey City', type=CC_GeographicEntityType.CITY); $a->instanceOf(CC_Address);));
    assertEquals(true, $f->eval(|let a = ^CC_Address(name='Jersey City', type=CC_GeographicEntityType.CITY); $a->instanceOf(CC_GeographicEntity);));
    assertEquals(true, $f->eval(|let a = ^CC_Address(name='Jersey City', type=CC_GeographicEntityType.CITY); $a->instanceOf(Any);));
    assertEquals(false, $f->eval(|let a = ^CC_Address(name='Jersey City', type=CC_GeographicEntityType.CITY); $a->instanceOf(CC_Person);));
    assertEquals(false, $f->eval(|let a = ^CC_Address(name='Jersey City', type=CC_GeographicEntityType.CITY); $a->instanceOf(Integer);));
}

function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfClass<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|CC_Person->instanceOf(Class)));
    assertEquals(true, $f->eval(|CC_Person->instanceOf(Type)));
    assertEquals(true, $f->eval(|CC_Person->instanceOf(Any)));
}

function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfEnum<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|CC_GeographicEntityType->instanceOf(Type)));
    assertEquals(true, $f->eval(|CC_GeographicEntityType->instanceOf(Any)));
    assertEquals(false, $f->eval(|CC_GeographicEntityType->instanceOf(Class)));
}

function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfFromEnumVal<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|CC_GeographicEntityType.CITY->instanceOf(CC_GeographicEntityType)));
    assertEquals(true, $f->eval(|CC_GeographicEntityType.CITY->instanceOf(Enum)));
    assertEquals(true, $f->eval(|CC_GeographicEntityType.CITY->instanceOf(Any)));
    assertEquals(false, $f->eval(|CC_GeographicEntityType.CITY->instanceOf(Enumeration)));
    assertEquals(false, $f->eval(|CC_GeographicEntityType.CITY->instanceOf(Type)));
    assertEquals(false, $f->eval(|CC_GeographicEntityType.CITY->instanceOf(Integer)));
}

// Pins the runtime-type-preservation expectation across platforms: when a
// Java primitive value is extracted from a property whose declared type is
// `Any[*]` (e.g. AtomicValue.value), `instanceOf` must use the value's
// runtime type rather than the property's declared `Any` type. Otherwise
// `subtypeOf(Any, Integer)` is false and `instanceOf(Integer)` returns false.
//
// This is the bug exposed by `_CompiledGraphPrinter.formatLiteral` when it
// switched from declared-type strings to value-based `instanceOf` checks —
// Truffle handled it correctly, Pure-on-Java did not.
Class <<test.TestDependency>> meta::pure::functions::meta::tests::instanceOf::AnyHolder
{
    value: Any[1];
}

Class <<test.TestDependency>> meta::pure::functions::meta::tests::instanceOf::NumberHolder
{
    value: Number[1];
}

function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfFromAnyProperty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|let h1 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = 42); $h1.value->instanceOf(Integer);));
    assertEquals(true, $f->eval(|let h1 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = 42); $h1.value->instanceOf(Number);));
    assertEquals(true, $f->eval(|let h1 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = 42); $h1.value->instanceOf(Any);));
    assertEquals(false, $f->eval(|let h1 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = 42); $h1.value->instanceOf(String);));

    assertEquals(true, $f->eval(|let h2 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = 'hello'); $h2.value->instanceOf(String);));
    assertEquals(true, $f->eval(|let h2 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = 'hello'); $h2.value->instanceOf(Any);));
    assertEquals(false, $f->eval(|let h2 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = 'hello'); $h2.value->instanceOf(Integer);));

    assertEquals(true, $f->eval(|let h3 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = true); $h3.value->instanceOf(Boolean);));
    assertEquals(false, $f->eval(|let h3 = ^meta::pure::functions::meta::tests::instanceOf::AnyHolder(value = true); $h3.value->instanceOf(Integer);));
}

// Pins runtime-type narrowing through a non-Any supertype property: a Number
// property holding an Integer must report as Integer when checked, not just
// Number. Without this, `instanceOf(Integer)` on a value extracted from a
// Number-typed field would return false even though the runtime value IS an
// Integer.
function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfFromSupertypeProperty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|let n = ^meta::pure::functions::meta::tests::instanceOf::NumberHolder(value = 7); $n.value->instanceOf(Integer);));
    assertEquals(true, $f->eval(|let n = ^meta::pure::functions::meta::tests::instanceOf::NumberHolder(value = 7); $n.value->instanceOf(Number);));
    assertEquals(true, $f->eval(|let n = ^meta::pure::functions::meta::tests::instanceOf::NumberHolder(value = 7); $n.value->instanceOf(Any);));

    assertEquals(true, $f->eval(|let nf = ^meta::pure::functions::meta::tests::instanceOf::NumberHolder(value = 3.14); $nf.value->instanceOf(Float);));
    assertEquals(true, $f->eval(|let nf = ^meta::pure::functions::meta::tests::instanceOf::NumberHolder(value = 3.14); $nf.value->instanceOf(Number);));
    assertEquals(false, $f->eval(|let nf = ^meta::pure::functions::meta::tests::instanceOf::NumberHolder(value = 3.14); $nf.value->instanceOf(Integer);));
}

// Pins that a property declared with a more-specific type than the Java
// representation is honored over the runtime type: `%2015-03-14` is stored as
// a Java String, but its declared type is StrictDate (or the property type
// might be Date). `instanceOf` must return StrictDate, not String.
function <<PCT.test>> meta::pure::functions::meta::tests::instanceOf::testInstanceOfDateLiteralKeepsDateType<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(true, $f->eval(|%2015-03-14->instanceOf(StrictDate)));
    assertEquals(true, $f->eval(|%2015-03-14->instanceOf(Date)));
    assertEquals(true, $f->eval(|%2015-03-14->instanceOf(Any)));
    assertEquals(false, $f->eval(|%2015-03-14->instanceOf(String)));
    assertEquals(false, $f->eval(|%2015-03-14->instanceOf(Integer)));
}
