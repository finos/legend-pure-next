import meta::pure::functions::asserts::*;
import meta::pure::metamodel::type::*;

// Returns the underlying Type carried by a GenericType, or empty if none.
// Currently only GenericTypeValue carries a concrete `.type`; other GenericType
// shapes (Inferred, TypeParameter binding, etc.) yield empty.
function meta::pure::metamodel::type::rawType(gt:GenericType[1]):Type[0..1]
{
    $gt->match([
        gtv : GenericTypeValue[1] | $gtv.type,
        a   : Any[1]              | []
    ]);
}

function <<test.Test>> meta::pure::metamodel::type::tests::rawType::testRawTypeOnGenericTypeValue():Boolean[1]
{
    let gt = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type=String);
    assertEquals(String, $gt->rawType()->toOne());
}

function <<test.Test>> meta::pure::metamodel::type::tests::rawType::testRawTypeOnUndefinedGenericType():Boolean[1]
{
    let gt = ^meta::pure::metamodel::type::generics::UndefinedGenericType();
    assert($gt->rawType()->isEmpty());
}
