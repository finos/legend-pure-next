import meta::pure::functions::asserts::*;
import meta::pure::functions::meta::*;
import meta::pure::functions::meta::tests::enumValues::*;
import meta::pure::metamodel::type::*;

// Returns the values of an enumeration as Enum instances.
//
// Legend-pure-next stores enum values on `Enumeration.properties[*]` as
// Property objects (one per value); each Property's `defaultValue` is a
// LambdaFunction whose first expression is an AtomicValue holding the
// actual Enum instance. Both `MyEnum.SOME_VALUE` and the values returned
// here are the same Enum instances.
function meta::pure::functions::meta::enumValues<E>(enumeration:Enumeration<E>[1]): meta::pure::metamodel::type::Enum[*]
{
    $enumeration.properties->map(p |
        $p.defaultValue->toOne().expressionSequence->at(0)->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->toOne()->cast(@meta::pure::metamodel::type::Enum)
    );
}

Enum meta::pure::functions::meta::tests::enumValues::TestColor
{
    RED, GREEN, BLUE
}

function <<test.Test>> meta::pure::functions::meta::tests::enumValues::testEnumValuesReturnsAllInOrder():Boolean[1]
{
    let vs = TestColor->enumValues();
    assertEquals(3, $vs->size());
    assertEquals('RED', $vs->at(0).name);
    assertEquals('GREEN', $vs->at(1).name);
    assertEquals('BLUE', $vs->at(2).name);
}

function <<test.Test>> meta::pure::functions::meta::tests::enumValues::testEnumValuesMatchLiterals():Boolean[1]
{
    assertEquals([TestColor.RED, TestColor.GREEN, TestColor.BLUE], TestColor->enumValues());
}
