import platform::pure::functions::asserts::*;
import platform::pure::functions::meta::*;
import platform::pure::functions::meta::tests::enumValues::*;
import platform::pure::metamodel::type::*;
import platform::pure::test::pct::*;

// Returns the values of an enumeration as Enum instances.
//
// Legend-pure-next stores enum values on `Enumeration.properties[*]` as
// Property objects (one per value); each Property's `defaultValue` is a
// LambdaFunction whose first expression is an AtomicValue holding the
// actual Enum instance. Both `MyEnum.SOME_VALUE` and the values returned
// here are the same Enum instances.
function platform::pure::functions::meta::enumValues<E>(enumeration:Enumeration<E>[1]): platform::pure::metamodel::type::Enum[*]
{
    $enumeration.properties->map(p |
        $p.defaultValue->toOne().expressionSequence->at(0)->cast(@platform::pure::metamodel::valuespecification::AtomicValue).value->toOne()->cast(@platform::pure::metamodel::type::Enum)
    );
}

Enum <<test.TestDependency>> platform::pure::functions::meta::tests::enumValues::TestColor
{
    RED, GREEN, BLUE
}

// Values named like keywords of the languages Pure is translated to, or like what a translation may
// itself declare on an enumeration.
Enum <<test.TestDependency>> platform::pure::functions::meta::tests::enumValues::TestKeywordNames
{
    default, class, value, name, VALUES
}

function <<PCT.test>> platform::pure::functions::meta::tests::enumValues::testEnumValuesReturnsAllInOrder<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['RED', 'GREEN', 'BLUE'], $f->eval(|TestColor->enumValues().name));
}

function <<PCT.test>> platform::pure::functions::meta::tests::enumValues::testEnumValuesMatchLiterals<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals([TestColor.RED, TestColor.GREEN, TestColor.BLUE], $f->eval(|TestColor->enumValues()));
}

// The enumeration as a value: no host can see which one it is when compiling the call.
function <<test.TestDependency>> platform::pure::functions::meta::tests::enumValues::valuesOf(e: Enumeration<Any>[1]): platform::pure::metamodel::type::Enum[*]
{
    $e->enumValues()
}

// An enumeration known only at run time has the same values: the instances its literals name.
function <<PCT.test>> platform::pure::functions::meta::tests::enumValues::testEnumValuesOfAnEnumerationKnownAtRunTime<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let values = $f->eval(|valuesOf(TestColor));
    assertIs(TestColor.RED, $values->at(0));
    assertIs(TestColor.BLUE, $values->at(2));
    assert($values->at(0)->instanceOf(TestColor));
}

// Where an enumeration keeps a value — its property's default value — holds that value itself.
function <<PCT.test>> platform::pure::functions::meta::tests::enumValues::testEnumValuePropertyDefaultValueIsTheValue<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertIs(TestColor.GREEN, $f->eval(|TestColor->cast(@Enumeration<Any>).properties->at(1).defaultValue->toOne()->eval()));
}

// A value's name is the one it was declared with, whatever it is.
function <<PCT.test>> platform::pure::functions::meta::tests::enumValues::testEnumValueNamesAreAsDeclared<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['default', 'class', 'value', 'name', 'VALUES'], $f->eval(|TestKeywordNames->enumValues().name));
    assertEquals(['default', 'class', 'value', 'name', 'VALUES'], $f->eval(|valuesOf(TestKeywordNames).name));
    assertEquals('name', $f->eval(|TestKeywordNames.name.name));
    assertEquals('default', $f->eval(|TestKeywordNames.default.name));
    assertEquals('class', $f->eval(|TestKeywordNames.class->toString()));
}
