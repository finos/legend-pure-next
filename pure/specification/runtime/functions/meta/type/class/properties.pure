import meta::pure::functions::meta::tests::model::*;
import meta::pure::test::pct::*;

function <<PCT.function, PCT.platformOnly>> meta::pure::functions::meta::properties(genericType:GenericType[1]):Property<Nil,Any|*>[*]
{
    // TODO use this once problems with compiled execution are fixed
//    $genericType.type->toOne()->generalizations()->map(cls | $cls->cast(@Class<Any>).properties->concatenate($cls->cast(@Class<Any>).propertiesFromAssociations))

    let theClass = $genericType->cast(@GenericTypeValue).type->toOne()->cast(@Class<Any>);
    let result = ^List<Property<Nil,Any|*>>(values = $theClass.properties);
    let resultWithAssoProps = ^$result(values += $theClass.propertiesFromAssociations);
    ^$resultWithAssoProps(values += $theClass.generalizations->map(generalization | properties($generalization.general))).values;
}

function <<PCT.test>>  meta::pure::functions::meta::tests::properties::testProperties<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let allProps = $f->eval(|^CC_Address(name='Hoboken', type=CC_GeographicEntityType.CITY)->genericType()->properties());
    assertEquals(CC_Address.properties->concatenate(CC_Address.propertiesFromAssociations)->concatenate(CC_GeographicEntity.properties)->concatenate(Any.properties), $allProps);
    assertSize($allProps, 8);
}