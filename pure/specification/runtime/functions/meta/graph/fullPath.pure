import platform::pure::metamodel::pointer::*;

// PackageableElement path helpers

// The path of `element`, once per element object for the execution: an element is immutable, so, like
// memoizedPackagePath, memoizing by identity cannot go stale.
function platform::pure::functions::meta::fullPath(element:PackageableElement[1]):String[1]
{
    memoize(platform::pure::functions::meta::computeFullPath_PackageableElement_1__String_1_, $element)
}

function platform::pure::functions::meta::computeFullPath(element:PackageableElement[1]):String[1]
{
    $element->match([
        // TempCompilerPointer carries its canonical path directly; package/name are unset.
        // PackagePointer for the root carries {@code path=''} (per toPackagePointer's
        // parentless special case which keeps child-path composition clean). For display
        // purposes the root's full path is '::', matching the live root Package's name.
        ptr : TempCompilerPointer[1] | if($ptr.path == '', | '::', | $ptr.path),
        pe  : PackageableElement[1] |
            let pkg = $pe.package;
            let name = $pe.name->toOne();
            if($pkg->isEmpty(),
                | $name,
                | // Package may itself be a {@link PackagePointer} (compile-pure
                  // wraps parent Package refs as pointers so children's stale
                  // skeletons don't propagate). The pointer's {@code path}
                  // field carries the parent's full path directly — use it.
                  let p = $pkg->toOne();
                  let pkgPath = if($p->instanceOf(TempCompilerPointer),
                      | $p->cast(@TempCompilerPointer).path,
                      | $p->memoizedPackagePath()
                  );
                  if($pkgPath == '',
                      | $name,
                      | $pkgPath + '::' + $name
                  );
            );
    ])
}

// packagePath, once per package object for the execution. A package is immutable, so its path is a function of the
// object alone: memoizing by identity cannot go stale, however the compiler context changes around it. The walk up the
// package chain, once per call, was 12% of the self-host compile.
function platform::pure::functions::meta::memoizedPackagePath(pkg:Package[1]):String[1]
{
    memoize(platform::pure::functions::meta::packagePath_Package_1__String_1_, $pkg)
}

function platform::pure::functions::meta::packagePath(pkg:Package[1]):String[1]
{
    if($pkg->instanceOf(TempCompilerPointer),
        | $pkg->cast(@TempCompilerPointer).path,
        | if($pkg.package->isEmpty() || $pkg.name->isEmpty(),
              | '',
              | let parentPath = $pkg.package->toOne()->memoizedPackagePath();
                if($parentPath == '',
                    | $pkg.name->toOne(),
                    | $parentPath + '::' + $pkg.name->toOne()
                );
          );
    );
}


// Tests

function <<test.Test>> platform::pure::functions::meta::tests::fullPath::testFullPath():Boolean[1]
{
    // Verify that fullPath returns a non-empty string for known types
    assert(Integer->fullPath()->length() > 0);
    assert(String->fullPath()->length() > 0);
    // Verify the name is part of the path
    assertEquals('Integer', Integer.name->toOne());
    assertEquals('String', String.name->toOne());
    // Verify that the path equals elementToPath
    assertEquals(Integer->elementToPath(), Integer->fullPath());
    assertEquals(String->elementToPath(), String->fullPath());
}
