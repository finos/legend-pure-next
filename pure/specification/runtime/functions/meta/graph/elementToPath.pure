import platform::pure::functions::meta::tests::model::*;
import platform::pure::test::pct::*;

function <<PCT.function, PCT.platformOnly>> platform::pure::functions::meta::elementToPath(element:Function<Any>[1]):String[1]
{
    $element->match(
        [
            p : PackageableElement[1] | $p->elementToPath('::'),
            p : AbstractProperty<Any>[1] | $p.name->toOne(),
            c : platform::pure::metamodel::relation::Column<Nil,Any|*>[1] | $c.name->toOne()
        ]
    )
}

function platform::pure::functions::meta::elementToPath(element:Type[1]):String[1]
{
    $element->cast(@PackageableElement)->elementToPath('::')
}

function platform::pure::functions::meta::elementToPath(element:PackageableElement[1]):String[1]
{
    $element->elementToPath('::')
}

native function platform::pure::functions::meta::elementToPath(element:PackageableElement[1], separator:String[1]):String[1];

native function platform::pure::functions::meta::elementPath(element:PackageableElement[1]):PackageableElement[1..*];




function <<test.Test>> platform::pure::functions::meta::tests::elementToPath::testElementToPath():Boolean[1]
{
    assertEquals('platform::pure::functions::meta', elementToPath('platform::pure::functions::meta'->pathToElement()));
    assertEquals('platform::pure::functions::meta', elementToPath(platform::pure::functions::meta));
}

function <<test.Test>> platform::pure::functions::meta::tests::elementToPath::testTopLevelElementToPath():Boolean[1]
{
    assertEquals('platform::pure::metamodel::Package', elementToPath(Package));
    assertEquals('platform::pure::metamodel::Package', elementToPath(Package, '::'));
    assertEquals('platform::pure::metamodel::type::primitives::Number', elementToPath(Number));
    assertEquals('platform::pure::metamodel::type::primitives::Number', elementToPath(Number, '::'));
    assertEquals('platform::pure::metamodel::type::primitives::Boolean', elementToPath(Boolean));
    assertEquals('platform::pure::metamodel::type::primitives::Boolean', elementToPath(Boolean, '::'));
    assertEquals('platform::pure::metamodel::type::primitives::Date', elementToPath(Date));
    assertEquals('platform::pure::metamodel::type::primitives::Date', elementToPath(Date, '::'));
    assertEquals('platform::pure::metamodel::type::primitives::Float', elementToPath(Float));
    assertEquals('platform::pure::metamodel::type::primitives::Float', elementToPath(Float, '::'));
    assertEquals('platform::pure::metamodel::type::primitives::Integer', elementToPath(Integer));
    assertEquals('platform::pure::metamodel::type::primitives::Integer', elementToPath(Integer, '::'));
    assertEquals('platform::pure::metamodel::type::primitives::String', elementToPath(String));
    assertEquals('platform::pure::metamodel::type::primitives::String', elementToPath(String, '::'));
}

function <<test.Test>> platform::pure::functions::meta::tests::elementToPath::testRootElementToPath():Boolean[1]
{
    assertEquals('', elementToPath(::));
    assertEquals('', elementToPath(::, '.'));
    assertEquals('', elementToPath(::, '::'));
}

function <<test.Test>> platform::pure::functions::meta::tests::elementToPath::testPackageablesToPath():Boolean[1]
{
    assertEquals('platform::pure::functions::meta::tests::model::CC_Person', elementToPath(CC_Person));
    assertEquals('platform.pure.functions.meta.tests.model.CC_Person', elementToPath(CC_Person, '.'));
    assertEquals('platform_pure_functions_meta_tests_model_CC_Person', elementToPath(CC_Person, '_'));
    assertEquals('platform::pure::functions::meta::tests::model', elementToPath(CC_Person.package->at(0)));
    assertEquals('platform_pure_functions_meta_tests_model', elementToPath(CC_Person.package->at(0), '_'));
    assertEquals('platform$pure$functions$meta$tests$model', elementToPath(CC_Person.package->at(0), '$'));
}

function <<test.Test>> platform::pure::functions::meta::tests::elementToPath::testEnumerationToPath():Boolean[1]
{
    assertEquals('platform::pure::functions::meta::tests::model::CC_GeographicEntityType', elementToPath(CC_GeographicEntityType));
    assertEquals('platform_pure_functions_meta_tests_model_CC_GeographicEntityType', elementToPath(CC_GeographicEntityType, '_'));
    assertEquals('platform.pure.functions.meta.tests.model.CC_GeographicEntityType', elementToPath(CC_GeographicEntityType, '.'));
    assertEquals('platform::pure::functions::meta::tests::model', elementToPath(CC_GeographicEntityType->cast(@PackageableElement).package->at(0)));
    assertEquals('platform.pure.functions.meta.tests.model', elementToPath(CC_GeographicEntityType->cast(@PackageableElement).package->at(0), '.'));
    assertEquals('platform&pure&functions&meta&tests&model', elementToPath(CC_GeographicEntityType->cast(@PackageableElement).package->at(0), '&'));
}



function <<test.Test>> platform::pure::functions::meta::tests::elementToPath::testEphemeralPackageableElements():Boolean[1]
{
    assertEquals('pkg::MyElement', ^platform::pure::metamodel::extension::Profile(name='MyElement', package=^Package(name='pkg', package=^Package(name='Root')))->elementToPath());
    assertEquals('pkg::MyElement', ^platform::pure::metamodel::extension::Profile(name='MyElement', package=^Package(name='pkg', package=^Package(name='Other')))->elementToPath());

    assertEquals('', ^platform::pure::metamodel::extension::Profile(name='')->elementToPath());
}

// `TempCompilerPointer`s carry the canonical path in their `.path` field and
// leave inherited PackageableElement fields (.name, .package) unset — they're
// opaque, must be dereferenced before any field read. `elementToPath` on a
// pointer must short-circuit to the `.path` field rather than walking the
// (null) package chain, otherwise it would NPE or produce a garbage path.
function <<test.Test>> platform::pure::functions::meta::tests::elementToPath::testCompilerPointerElementToPath():Boolean[1]
{
    // PE-style pointer: single `path` carries the full canonical path.
    assertEquals('test::pkg::myFn__String_1_',
        ^platform::pure::metamodel::pointer::PackageableFunctionPointer<Any>(path='test::pkg::myFn__String_1_')->elementToPath());

    // ClassPointer through the same elementToPath dispatcher.
    assertEquals('test::pkg::MyClass',
        ^platform::pure::metamodel::pointer::ClassPointer<Any>(path='test::pkg::MyClass')->elementToPath());

    // Custom separator on a pointer — the separator argument applies to the
    // pointer's stored path the same way it does to a walked path.
    assertEquals('test.pkg.MyClass',
        ^platform::pure::metamodel::pointer::ClassPointer<Any>(path='test::pkg::MyClass')->elementToPath('.'));
}

function <<test.Test>> platform::pure::functions::meta::tests::elementPath::testTopLevelElementPath():Boolean[1]
{
    assertEquals([platform, platform::pure, platform::pure::metamodel, platform::pure::metamodel::Package], elementPath(Package));
    assertEquals([platform, platform::pure, platform::pure::metamodel, platform::pure::metamodel::type, platform::pure::metamodel::type::primitives, platform::pure::metamodel::type::primitives::Number], elementPath(Number));
    assertEquals([platform, platform::pure, platform::pure::metamodel, platform::pure::metamodel::type, platform::pure::metamodel::type::primitives, platform::pure::metamodel::type::primitives::Boolean], elementPath(Boolean));
    assertEquals([platform, platform::pure, platform::pure::metamodel, platform::pure::metamodel::type, platform::pure::metamodel::type::primitives, platform::pure::metamodel::type::primitives::Date], elementPath(Date));
    assertEquals([platform, platform::pure, platform::pure::metamodel, platform::pure::metamodel::type, platform::pure::metamodel::type::primitives, platform::pure::metamodel::type::primitives::Float], elementPath(Float));
    assertEquals([platform, platform::pure, platform::pure::metamodel, platform::pure::metamodel::type, platform::pure::metamodel::type::primitives, platform::pure::metamodel::type::primitives::Integer], elementPath(Integer));
    assertEquals([platform, platform::pure, platform::pure::metamodel, platform::pure::metamodel::type, platform::pure::metamodel::type::primitives, platform::pure::metamodel::type::primitives::String], elementPath(String));
}

function <<test.Test>> platform::pure::functions::meta::tests::elementPath::testRootElementPath():Boolean[1]
{
    assertEquals([]->cast(@PackageableElement), elementPath(::));
}

function <<test.Test>> platform::pure::functions::meta::tests::elementPath::testElementPath():Boolean[1]
{
    assertEquals(
        [
         platform,
         platform::pure,
         platform::pure::functions,
         platform::pure::functions::meta,
         platform::pure::functions::meta::tests,
         platform::pure::functions::meta::tests::model,
         platform::pure::functions::meta::tests::model::CC_Person
        ],
        elementPath(CC_Person));
    assertEquals(
        [
         platform,
         platform::pure,
         platform::pure::functions,
         platform::pure::functions::meta,
         platform::pure::functions::meta::tests,
         platform::pure::functions::meta::tests::model,
         platform::pure::functions::meta::tests::model::CC_GeographicEntityType
        ],
        elementPath(CC_GeographicEntityType));
    assertEquals(
        [
         platform,
         platform::pure,
         platform::pure::functions
        ],
        elementPath(platform::pure::functions));
    assertEquals(
        [
         platform
        ],
        elementPath(platform));
}

function <<test.Test>> platform::pure::functions::meta::tests::elementPath::testEphemeralPackageableElement():Boolean[1]
{
    let rootPkg = ^Package(name='Root');
    let pkgPkg = ^Package(name='pkg', package=$rootPkg);
    let element = ^platform::pure::metamodel::extension::Profile(name='MyElement', package=$pkgPkg);
    assertEquals([$rootPkg], $rootPkg->elementPath());
    assertEquals([$rootPkg, $pkgPkg], $pkgPkg->elementPath());
    assertEquals([$rootPkg, $pkgPkg, $element], $element->elementPath());

    let otherRootPkg = ^Package(name='Other');
    let otherPkgPkg = ^Package(name='pkg', package=$otherRootPkg);
    let otherElement = ^platform::pure::metamodel::extension::Profile(name='MyElement', package=$otherPkgPkg);
    assertEquals([$otherRootPkg], $otherRootPkg->elementPath());
    assertEquals([$otherRootPkg, $otherPkgPkg], $otherPkgPkg->elementPath());
    assertEquals([$otherRootPkg, $otherPkgPkg, $otherElement], $otherElement->elementPath());
}
