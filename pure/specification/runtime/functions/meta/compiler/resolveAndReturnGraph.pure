import platform::pure::test::pct::*;

// Deep-copies every PackageableElement in {@code elements} and resolves every
// TempCompilerPointer it encounters to a live element — by-path lookup in
// {@code elements} first, then cross-module resolver. The input Map and its
// element PDOs are left untouched; the returned list contains fresh copies
// with pointer slots rewritten to live targets.
//
// Parallel to PointerGraphResolver.resolveAll (the Java-side, in-place
// equivalent invoked at InMemoryModule construction). This function
// gives compile-pure a way to materialize a resolved graph without mutating
// the compilation result.
native function platform::pure::functions::meta::resolveAndReturnGraph(elements:Map<String, platform::pure::metamodel::PackageableElement>[1]):platform::pure::metamodel::PackageableElement[*];

function <<PCT.test>> platform::pure::functions::meta::testResolveAndReturnGraphEmpty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let result = $f->eval(|platform::pure::functions::meta::resolveAndReturnGraph(newMap([]->cast(@Pair<String, platform::pure::metamodel::PackageableElement>))));
    assertEquals(0, $result->size());
}

function <<PCT.test>> platform::pure::functions::meta::testResolveAndReturnGraphPassthrough<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // No pointers in the graph — resolveAndReturnGraph still produces a
    // fresh deep copy with the same shape. Use a live element (Class)
    // looked up via pathToElement so the input has no TempCompilerPointers.
    let result = $f->eval(|
        let cls = pathToElement('platform::pure::metamodel::type::Class', '::')->cast(@platform::pure::metamodel::PackageableElement);
        let map = newMap([pair('platform::pure::metamodel::type::Class', $cls)]);
        platform::pure::functions::meta::resolveAndReturnGraph($map);
    );
    assertEquals(1, $result->size());
    assertEquals('Class', $result->at(0).name);
}

// Pointer-rewriting branch: manufacture a PrimitiveTypePointer (a
// TempCompilerPointer subtype) whose `.path` slot names a real PE, drop it
// into the input map as the sole value, and verify resolveAndReturnGraph
// replaces the pointer in the output list with the live target element
// (looked up via the resolver since 'platform::pure::metamodel::type::primitives::String'
// isn't itself a key in the map). PrimitiveTypePointer is non-parameterized,
// which sidesteps a TS-translator bug in parameterized-class construction
// (^ClassPointer<T>(...) emits a bogus classifierGenericType path) while
// still exercising the same pointer-detection + resolution path.
function <<PCT.test>> platform::pure::functions::meta::testResolveAndReturnGraphRewritesPrimitiveTypePointer<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let result = $f->eval(|
        let ptr = ^platform::pure::metamodel::pointer::PrimitiveTypePointer(
            path = 'platform::pure::metamodel::type::primitives::String'
        )->cast(@platform::pure::metamodel::PackageableElement);
        let map = newMap([pair('myPtr', $ptr)]);
        platform::pure::functions::meta::resolveAndReturnGraph($map);
    );
    assertEquals(1, $result->size());
    // Rewriting succeeded if the entry's `.name` is 'String' — the pointer
    // itself has no name, the live target does.
    assertEquals('String', $result->at(0).name);
}

// Enum values reachable from the graph keep their identity: the resolved copy's
// enum-valued slots hold the same values, so they still carry their enumeration
// type and compare equal to the literal. (A host that types enum singletons by
// identity loses both if it copies the value instead.)
function <<PCT.test>> platform::pure::functions::meta::testResolveAndReturnGraphPreservesEnumValues<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let aggregation = $f->eval(|
        let property = ^platform::pure::metamodel::function::property::Property<Nil,Any|*>(
            name = 'p',
            aggregation = platform::pure::metamodel::function::property::AggregationKind.None,
            genericType = ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = String),
            multiplicity = platform::pure::metamodel::multiplicity::PureOne
        );
        let cls = ^platform::pure::metamodel::type::Class<Any>(name = 'B', properties = $property);
        let resolved = platform::pure::functions::meta::resolveAndReturnGraph(newMap([pair('B', $cls->cast(@platform::pure::metamodel::PackageableElement))]));
        $resolved->at(0)->cast(@platform::pure::metamodel::type::Class<Any>).properties->toOne().aggregation->toOne();
    );
    assertEquals(platform::pure::metamodel::function::property::AggregationKind, $aggregation->genericType().type);
    assert($aggregation == platform::pure::metamodel::function::property::AggregationKind.None);
}

// A pointer to an element of the graph resolves to that element's RESOLVED copy — the one returned —
// so the result is self-consistent: a stereotype's profile is the returned profile, a property's owner
// the returned class (not the input element they were copied from).
function <<PCT.test>> platform::pure::functions::meta::testResolveAndReturnGraphPointsIntoTheResolvedGraph<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|
        let profile = ^platform::pure::metamodel::extension::Profile(name = 'RG_P',
            package = ^platform::pure::metamodel::pointer::PackagePointer(path = 'platform::pure::functions::meta'),
            p_stereotypes = ^platform::pure::metamodel::extension::Stereotype(value = 's',
                profile = ^platform::pure::metamodel::pointer::ProfilePointer(path = 'platform::pure::functions::meta::RG_P')));
        let resolvedProfile = platform::pure::functions::meta::resolveAndReturnGraph(newMap([pair('platform::pure::functions::meta::RG_P', $profile->cast(@platform::pure::metamodel::PackageableElement))]))
            ->toOne()->cast(@platform::pure::metamodel::extension::Profile);
        assertIs($resolvedProfile, $resolvedProfile.p_stereotypes->toOne().profile);

        let cls = ^platform::pure::metamodel::type::Class<Any>(name = 'RG_C',
            package = ^platform::pure::metamodel::pointer::PackagePointer(path = 'platform::pure::functions::meta'),
            properties = ^platform::pure::metamodel::function::property::Property<Nil,Any|*>(name = 'p',
                aggregation = platform::pure::metamodel::function::property::AggregationKind.None,
                genericType = ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = String),
                multiplicity = platform::pure::metamodel::multiplicity::PureOne,
                owner = ^platform::pure::metamodel::pointer::ClassPointer<Any>(path = 'platform::pure::functions::meta::RG_C')));
        let resolvedClass = platform::pure::functions::meta::resolveAndReturnGraph(newMap([pair('platform::pure::functions::meta::RG_C', $cls->cast(@platform::pure::metamodel::PackageableElement))]))
            ->toOne()->cast(@platform::pure::metamodel::type::Class<Any>);
        assertIs($resolvedClass, $resolvedClass.properties->toOne().owner);
    ));
}

// Every slot is resolved, an object's own classifier included, however deep the object sits: here an enum
// value inside the default value of an enumeration's property, classified by a pointer to that enumeration.
function <<PCT.test>> platform::pure::functions::meta::testResolveAndReturnGraphResolvesNestedClassifiers<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|
        let value = ^platform::pure::metamodel::type::Enum(name = 'V', classifierGenericType = ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = ^platform::pure::metamodel::pointer::EnumerationPointer<Any>(path = 'platform::pure::functions::meta::RG_E')));
        let defaultValue = ^platform::pure::metamodel::function::LambdaFunction<{->Any[1]}>(
            expressionSequence = ^platform::pure::metamodel::valuespecification::AtomicValue(value = $value, genericType = ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = ^platform::pure::metamodel::pointer::EnumerationPointer<Any>(path = 'platform::pure::functions::meta::RG_E')), multiplicity = platform::pure::metamodel::multiplicity::PureOne));
        let enumeration = ^platform::pure::metamodel::type::Enumeration<Any>(name = 'RG_E',
            package = ^platform::pure::metamodel::pointer::PackagePointer(path = 'platform::pure::functions::meta'),
            // As the compiler emits it: every enumeration extends Enum.
            generalizations = ^platform::pure::metamodel::relationship::Generalization(specific = ~.~,
                general = ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = platform::pure::metamodel::type::Enum)),
            properties = ^platform::pure::metamodel::function::property::Property<Nil,Any|*>(name = 'V',
                aggregation = platform::pure::metamodel::function::property::AggregationKind.None,
                genericType = ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = String),
                multiplicity = platform::pure::metamodel::multiplicity::PureOne,
                owner = ^platform::pure::metamodel::pointer::EnumerationPointer<Any>(path = 'platform::pure::functions::meta::RG_E'),
                defaultValue = $defaultValue));
        let resolved = platform::pure::functions::meta::resolveAndReturnGraph(newMap([pair('platform::pure::functions::meta::RG_E', $enumeration->cast(@platform::pure::metamodel::PackageableElement))]))
            ->toOne()->cast(@platform::pure::metamodel::type::Enumeration<Any>);
        let resolvedValue = $resolved.properties->toOne().defaultValue->toOne().expressionSequence->toOne()->cast(@platform::pure::metamodel::valuespecification::AtomicValue).value->toOne();
        assertIs($resolved, $resolvedValue->genericType().type->toOne());
    ));
}

// The resolved copy keeps the graph's shape: an object reached from two places is still one object.
function <<PCT.test>> platform::pure::functions::meta::testResolveAndReturnGraphKeepsSharedObjectsShared<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|
        let shared = ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = String);
        let property = {name:String[1] | ^platform::pure::metamodel::function::property::Property<Nil,Any|*>(name = $name,
            aggregation = platform::pure::metamodel::function::property::AggregationKind.None, genericType = $shared,
            multiplicity = platform::pure::metamodel::multiplicity::PureOne)};
        let cls = ^platform::pure::metamodel::type::Class<Any>(name = 'S', properties = [$property->eval('a'), $property->eval('b')]);
        let resolved = platform::pure::functions::meta::resolveAndReturnGraph(newMap([pair('S', $cls->cast(@platform::pure::metamodel::PackageableElement))]))
            ->toOne()->cast(@platform::pure::metamodel::type::Class<Any>);
        assertIs($resolved.properties->at(0).genericType->toOne(), $resolved.properties->at(1).genericType->toOne());
    ));
}

// A pointer that names nothing — neither an element of the graph nor one already loaded — is an error: the
// graph handed back must hold no pointers.
function <<PCT.test>> platform::pure::functions::meta::testResolveAndReturnGraphFailsOnAnUnresolvablePointer<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertError(| $f->eval(|
        let cls = ^platform::pure::metamodel::type::Class<Any>(name = 'RG_Dangling',
            package = ^platform::pure::metamodel::pointer::PackagePointer(path = 'platform::pure::functions::meta'),
            properties = ^platform::pure::metamodel::function::property::Property<Nil,Any|*>(name = 'p',
                aggregation = platform::pure::metamodel::function::property::AggregationKind.None,
                genericType = ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = ^platform::pure::metamodel::pointer::ClassPointer<Any>(path = 'resolveTest::Missing')),
                multiplicity = platform::pure::metamodel::multiplicity::PureOne,
                owner = ^platform::pure::metamodel::pointer::ClassPointer<Any>(path = 'platform::pure::functions::meta::RG_Dangling')));
        platform::pure::functions::meta::resolveAndReturnGraph(newMap([pair('platform::pure::functions::meta::RG_Dangling', $cls->cast(@platform::pure::metamodel::PackageableElement))]));
    ), 'resolveAndReturnGraph: cannot resolve the pointer to \'resolveTest::Missing\'');
}
