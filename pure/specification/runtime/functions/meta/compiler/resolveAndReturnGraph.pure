import meta::pure::test::pct::*;

// Deep-copies every PackageableElement in {@code elements} and resolves every
// TempCompilerPointer it encounters to a live element — by-path lookup in
// {@code elements} first, then cross-module resolver. The input Map and its
// element PDOs are left untouched; the returned list contains fresh copies
// with pointer slots rewritten to live targets.
//
// Parallel to PointerGraphResolver.resolveAll (the Java-side, in-place
// equivalent invoked at TruffleInMemoryModule construction). This function
// gives compile-pure a way to materialize a resolved graph without mutating
// the compilation result.
native function meta::pure::functions::meta::resolveAndReturnGraph(elements:Map<String, meta::pure::metamodel::PackageableElement>[1]):meta::pure::metamodel::PackageableElement[*];

function <<PCT.test>> meta::pure::functions::meta::testResolveAndReturnGraphEmpty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let result = $f->eval(|meta::pure::functions::meta::resolveAndReturnGraph(newMap([]->cast(@Pair<String, meta::pure::metamodel::PackageableElement>))));
    assertEquals(0, $result->size());
}

function <<PCT.test>> meta::pure::functions::meta::testResolveAndReturnGraphPassthrough<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // No pointers in the graph — resolveAndReturnGraph still produces a
    // fresh deep copy with the same shape. Use a live element (Class)
    // looked up via pathToElement so the input has no TempCompilerPointers.
    let result = $f->eval(|
        let cls = pathToElement('meta::pure::metamodel::type::Class', '::')->cast(@meta::pure::metamodel::PackageableElement);
        let map = newMap([pair('meta::pure::metamodel::type::Class', $cls)]);
        meta::pure::functions::meta::resolveAndReturnGraph($map);
    );
    assertEquals(1, $result->size());
    assertEquals('Class', $result->at(0).name);
}
