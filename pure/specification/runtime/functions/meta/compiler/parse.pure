import meta::pure::protocol::*;
import meta::pure::test::pct::*;

native function meta::pure::functions::meta::parse(sourceId:String[1], content:String[1]):PureFile[1];

function <<PCT.test>> meta::pure::functions::meta::testParseNativeIntegration<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let file = $f->eval(|meta::pure::functions::meta::parse('testSource', 'Class pkg::MyClass { name:String[1]; }'));
    let cls = $file.sections->at(0).elements->at(0)->cast(@meta::pure::protocol::grammar::type::Class);
    assertEquals('testSource', $file.sourceId);
    assertEquals(1, $file.sections->size());
    assertEquals(1, $file.sections->at(0).elements->size());
    assertEquals('MyClass', $cls.name);
    assertEquals('pkg', $cls.package->cast(@meta::pure::protocol::grammar::Package_Pointer).value);
    assertEquals(1, $cls.properties->size());
    assertEquals('name', $cls.properties->at(0).name);
}

function <<PCT.test>> meta::pure::functions::meta::testParseUnknownSectionThrows<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertError(
        | $f->eval(|meta::pure::functions::meta::parse(
            'test',
            '''
            ###Pure
            Class a::A {}

            ###Unknown
            stuff
            '''
        )),
        'No parser registered for section: ###Unknown'
    );
}

function <<PCT.test>> meta::pure::functions::meta::testParseEnumPropertyValues<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // The composite property's aggregation should be an Enum_Pointer referencing the metamodel enum
    let enumPtr = $f->eval(|meta::pure::functions::meta::parse('testSource', 'Class pkg::MyClass { (composite) child:String[*]; name:String[1]; }').sections->at(0).elements->at(0)->cast(@meta::pure::protocol::grammar::type::Class).properties->filter(p | $p.name == 'child')->at(0).aggregation->cast(@meta::pure::protocol::grammar::Enum_Pointer));
    assertEquals('meta::pure::metamodel::function::property::AggregationKind', $enumPtr.value);
    assertEquals('Composite', $enumPtr.extraPointerValues->at(0).value);
}
