import meta::pure::functions::meta::antlr::*;

// 0-based source line of the first non-NEWLINE child of {@code ctx} (the
// {@code sectionContent} rule's first content token). Subtracts 1 when
// {@code syntheticHeader} is true (the caller prepended {@code ###Pure\n}
// and the header line shouldn't count toward the offset). Empty {@code ctx}
// → 0.
//
// Used by the top-level parser to compute section bodies' line offsets so
// nested parse errors report file-relative coordinates. Host-side because
// Pure can't easily walk ParseTree-level children and distinguish
// TerminalNode vs RuleContext at the child level. No PCT test: requires a
// hand-constructed sectionContent context that's only producible through
// top-level parsing.
native function meta::pure::functions::meta::antlr::computeFirstNonNewlineLine(
   ctx: AntlrContext[0..1],
   syntheticHeader: Boolean[1]
): Integer[1];
