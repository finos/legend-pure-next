import meta::pure::functions::meta::antlr::*;
import meta::pure::test::pct::*;

// True iff the named terminal token matched in this alternative.
// Predicate used in alt guards.
native function <<PCT.function>>
   meta::pure::functions::meta::antlr::hasToken(
      ctx: AntlrContext[1], name: String[1]
   ): Boolean[1];

function <<PCT.test>> meta::pure::functions::meta::antlr::tests::hasToken::testStarVsInteger<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   let star = $f->eval(|
      parseAntlr('Class p::C{ x: String[*]; }', 'M3Parser', 's', 0)
         ->getTopLevelChildren()->at(0)
         ->getChild('classBody')->toOne()->getChild('properties')->toOne()
         ->getChildren('property')->at(0)
         ->getChild('propertyReturnType')->toOne()->getChild('multiplicity')->toOne()
         ->getChild('multiplicityArgument')->toOne()->getChild('toMultiplicity')->toOne()
         ->hasToken('STAR')
   );
   assertEquals(true, $star);
   let integer = $f->eval(|
      parseAntlr('Class p::C{ x: String[*]; }', 'M3Parser', 's', 0)
         ->getTopLevelChildren()->at(0)
         ->getChild('classBody')->toOne()->getChild('properties')->toOne()
         ->getChildren('property')->at(0)
         ->getChild('propertyReturnType')->toOne()->getChild('multiplicity')->toOne()
         ->getChild('multiplicityArgument')->toOne()->getChild('toMultiplicity')->toOne()
         ->hasToken('INTEGER')
   );
   assertEquals(false, $integer);
}
