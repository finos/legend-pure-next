import meta::pure::functions::meta::antlr::*;
import meta::pure::test::pct::*;

// Text of a terminal token (INTEGER, STRING, DATE, …). Returns empty when
// the token wasn't matched in this alternative.
native function <<PCT.function>>
   meta::pure::functions::meta::antlr::getTokenText(
      ctx: AntlrContext[1], name: String[1]
   ): String[0..1];

function <<PCT.test>> meta::pure::functions::meta::antlr::tests::getTokenText::testInteger<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   // Walk into a property's INTEGER multiplicity token: `x: Integer[42]`.
   let text = $f->eval(|
      parseAntlr('Class p::C{ x: Integer[42]; }', 'M3Parser', 's', 0)
         ->getTopLevelChildren()->at(0)              // classDefinition
         ->getChild('classBody')->toOne()
         ->getChild('properties')->toOne()
         ->getChildren('property')->at(0)
         ->getChild('propertyReturnType')->toOne()
         ->getChild('multiplicity')->toOne()
         ->getChild('multiplicityArgument')->toOne()
         ->getChild('toMultiplicity')->toOne()
         ->getTokenText('INTEGER')->toOne()
   );
   assertEquals('42', $text);
}
