import meta::pure::functions::meta::antlr::*;
import meta::pure::test::pct::*;

// Raw text of the entire matched span for this context.
native function <<PCT.function>>
   meta::pure::functions::meta::antlr::getText(
      ctx: AntlrContext[1]
   ): String[1];

function <<PCT.test>> meta::pure::functions::meta::antlr::tests::getText::testRoot<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   let text = $f->eval(|
      parseAntlr('Enum p::E { V }', 'M3Parser', 's', 0)->getText()
   );
   // The root concatenates all matched tokens with no separators; whitespace
   // is on the HIDDEN channel and dropped.
   assertEquals('Enump::E{V}<EOF>', $text);
}
