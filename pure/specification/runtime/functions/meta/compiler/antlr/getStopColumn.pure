import meta::pure::functions::meta::antlr::*;
import meta::pure::test::pct::*;

// End column of the context's last matched token: ANTLR's 0-based
// {@code getCharPositionInLine() + tokenText.length()}. Pairs with
// {@code getStartColumn} (1-based start) to give the existing parser's
// source-info shape.
native function <<PCT.function>>
   meta::pure::functions::meta::antlr::getStopColumn(
      ctx: AntlrContext[1]
   ): Integer[1];

function <<PCT.test>> meta::pure::functions::meta::antlr::tests::getStopColumn::testTrailingBrace<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   // `Class p::C{}` — closing `}` sits at 0-based col 11, +1 (length) → 12.
   assertEquals(12,
                $f->eval(|parseAntlr('Class p::C{}', 'M3Parser', 's', 0)
                            ->getTopLevelChildren()->at(0)->getStopColumn()));
}
