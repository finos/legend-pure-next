import meta::pure::functions::meta::antlr::*;
import meta::pure::test::pct::*;

// Plural-arity child accessor: invokes {@code ctx.name()} which returns a
// {@code List<...Context>}. Used for {@code +} and {@code *} quantified
// sub-rules.
native function <<PCT.function>>
   meta::pure::functions::meta::antlr::getChildren(
      ctx: AntlrContext[1], name: String[1]
   ): AntlrContext[*];

function <<PCT.test>> meta::pure::functions::meta::antlr::tests::getChildren::testEnumValues<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   let count = $f->eval(|
      parseAntlr('Enum p::E { A, B, C }', 'M3Parser', 's', 0)
         ->getTopLevelChildren()->at(0)
         ->getChildren('enumValue')->size()
   );
   assertEquals(3, $count);
}
