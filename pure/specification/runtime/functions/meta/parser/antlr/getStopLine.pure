import meta::pure::functions::meta::antlr::*;
import meta::pure::test::pct::*;

// 1-based source line of the context's last matched token.
native function <<PCT.function>>
   meta::pure::functions::meta::antlr::getStopLine(
      ctx: AntlrContext[1]
   ): Integer[1];

function <<PCT.test>> meta::pure::functions::meta::antlr::tests::getStopLine::testMultiLine<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   // `Class p::C\n{\n}` — closing brace is on line 3.
   assertEquals(3,
                $f->eval(|parseAntlr('Class p::C\n{\n}', 'M3Parser', 's', 0)
                            ->getTopLevelChildren()->at(0)->getStopLine()));
}
