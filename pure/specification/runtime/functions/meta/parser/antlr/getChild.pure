import platform::pure::functions::meta::antlr::*;
import platform::pure::test::pct::*;

// Single-arity child accessor: invokes the ANTLR accessor {@code ctx.name()}.
// Returns empty when the rule didn't match (ANTLR returns null in that case).
native function <<PCT.function>>
   platform::pure::functions::meta::antlr::getChild(
      ctx: AntlrContext[1], name: String[1]
   ): AntlrContext[0..1];

function <<PCT.test>> platform::pure::functions::meta::antlr::tests::getChild::testPresent<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   let name = $f->eval(|
      parseAntlr('Class p::C{}', 'M3Parser', 's', 0)
         ->getTopLevelChildren()->at(0)
         ->getChild('qualifiedName')->toOne()
         ->grammarRuleName()
   );
   assertEquals('qualifiedName', $name);
}
