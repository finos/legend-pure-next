import meta::pure::functions::meta::antlr::*;
import meta::pure::test::pct::*;

// The grammar rule name this context represents (e.g. {@code 'classDefinition'}).
// Resolved by walking up to the context's enclosing parser class and reading
// its {@code public static final String[] ruleNames} field.
native function <<PCT.function>>
   meta::pure::functions::meta::antlr::grammarRuleName(
      ctx: AntlrContext[1]
   ): String[1];

function <<PCT.test>> meta::pure::functions::meta::antlr::tests::grammarRuleName::testRoot<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   assertEquals('definition',
                $f->eval(|parseAntlr('Class p::C{}', 'M3Parser', 's', 0)->grammarRuleName()));
   assertEquals('document',
                $f->eval(|parseAntlr('###Pure\nClass p::C{}', 'TopParser', 's', 0)->grammarRuleName()));
}
