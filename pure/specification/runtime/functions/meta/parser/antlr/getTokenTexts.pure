import meta::pure::functions::meta::antlr::*;
import meta::pure::test::pct::*;

// Texts of a list of repeated tokens, e.g. {@code STRING (PLUS STRING)*}.
// ANTLR's {@code ctx.NAME()} returns {@code List<TerminalNode>}; we collect
// each {@code .getText()}.
native function <<PCT.function>>
   meta::pure::functions::meta::antlr::getTokenTexts(
      ctx: AntlrContext[1], name: String[1]
   ): String[*];

function <<PCT.test>> meta::pure::functions::meta::antlr::tests::getTokenTexts::testTaggedValueStrings<Z|y>(
   f: Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]
): Boolean[1]
{
   // {@code taggedValue: qualifiedName DOT identifier EQUAL STRING (PLUS STRING)*}
   // — concatenated STRING tokens are repeated, accessible as a list.
   let texts = $f->eval(|
      parseAntlr('Class {p::pr.t = \'a\' + \'b\'} p::C {}', 'M3Parser', 's', 0)
         ->getTopLevelChildren()->at(0)
         ->getChild('taggedValues')->toOne()
         ->getChildren('taggedValue')->at(0)
         ->getTokenTexts('STRING')
   );
   assertEquals(2, $texts->size());
}
