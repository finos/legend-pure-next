import meta::pure::test::pct::*;
import meta::pure::functions::binary::*;

// Decode `length` UTF-8 bytes starting at `pos` as a String.
//
// The range form matters: decoding a substring of a buffer otherwise means
// slicing a copy first, and the PDB reader reads a string for almost every
// element name, path and pointer segment.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::binary::binaryUtf8(b:Binary[1], pos:Integer[1], length:Integer[1]):String[1];

function <<PCT.test>> meta::pure::functions::binary::tests::binaryUtf8::testRange<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('a::b', $f->eval(|0x613A3A62->binaryUtf8(0, 4)));
    assertEquals('::', $f->eval(|0x613A3A62->binaryUtf8(1, 2)));
    assertEquals('', $f->eval(|0x613A3A62->binaryUtf8(2, 0)));
}

function <<PCT.test>> meta::pure::functions::binary::tests::binaryUtf8::testMultiByte<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // U+20AC EURO SIGN, offset past a leading ASCII byte
    assertEquals('€', $f->eval(|0x61E282AC->binaryUtf8(1, 3)));
}
