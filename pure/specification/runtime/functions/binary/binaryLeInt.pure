import meta::pure::test::pct::*;
import meta::pure::functions::binary::*;

// Signed (two's-complement) little-endian integer of `width` bytes at `pos`:
// the top byte carries the sign. The counterpart of binaryLeUInt, and native
// for the same reason.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::binary::binaryLeInt(b:Binary[1], pos:Integer[1], width:Integer[1]):Integer[1];

function <<PCT.test>> meta::pure::functions::binary::tests::binaryLeInt::testNegative<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // -64 as an int32 — the backward-vtable soffset the FlatBuffer layer emits.
    assertEquals(-64, $f->eval(|0xC0FFFFFF->binaryLeInt(0, 4)));
    assertEquals(-1, $f->eval(|0xFFFF->binaryLeInt(0, 2)));
}

function <<PCT.test>> meta::pure::functions::binary::tests::binaryLeInt::testPositive<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(3, $f->eval(|0x000300000000000000->binaryLeInt(1, 8)));
    assertEquals(513, $f->eval(|0x0102->binaryLeInt(0, 2)));
}
