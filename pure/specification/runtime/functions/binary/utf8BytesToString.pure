import meta::pure::test::pct::*;
import meta::pure::functions::binary::*;

// Decode UTF-8 bytes (each 0..255) to a String — the inverse of
// stringToUtf8Bytes. Byte-level primitive backing binary deserialization
// (the self-hosted PDB reader); identity across platforms is the contract.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::binary::utf8BytesToString(bytes:Integer[*]):String[1];

function <<PCT.test>> meta::pure::functions::binary::tests::utf8BytesToString::testAscii<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('a::b', $f->eval(|[97, 58, 58, 98]->utf8BytesToString()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::utf8BytesToString::testEmpty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|[]->utf8BytesToString()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::utf8BytesToString::testTwoByte<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // U+00E9 LATIN SMALL LETTER E WITH ACUTE
    assertEquals('é', $f->eval(|[195, 169]->utf8BytesToString()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::utf8BytesToString::testThreeByte<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // U+20AC EURO SIGN
    assertEquals('€', $f->eval(|[226, 130, 172]->utf8BytesToString()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::utf8BytesToString::testRoundTrip<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('meta::pure – é€', $f->eval(|'meta::pure – é€'->stringToUtf8Bytes()->utf8BytesToString()));
}
