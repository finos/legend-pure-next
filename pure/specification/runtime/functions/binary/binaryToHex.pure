import meta::pure::test::pct::*;
import meta::pure::functions::binary::*;

// Uppercase hex text of a Binary, with no `0x` prefix — the inverse of the
// binary literal's payload. Exists for assertions and diagnostics: it is the
// readable form of a value that is otherwise opaque.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::binary::binaryToHex(b:Binary[1]):String[1];

function <<PCT.test>> meta::pure::functions::binary::tests::binaryToHex::testRoundTripsLiteral<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('1F8B08', $f->eval(|0x1F8B08->binaryToHex()));
    assertEquals('FF', $f->eval(|0xFF->binaryToHex()));
    assertEquals('', $f->eval(|0x->binaryToHex()));
}

// Low bytes keep their leading zero — hex is fixed-width per byte, so a
// 3-byte Binary is always 6 characters.
function <<PCT.test>> meta::pure::functions::binary::tests::binaryToHex::testPadsLowBytes<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('000108', $f->eval(|0x000108->binaryToHex()));
}
