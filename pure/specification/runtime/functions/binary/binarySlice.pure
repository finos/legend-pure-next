import meta::pure::test::pct::*;
import meta::pure::functions::binary::*;

// The half-open byte range `[from, toExclusive)` as a new Binary. Only ever
// feeds a decoder, so it never needs to alias the source.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::binary::binarySlice(b:Binary[1], from:Integer[1], toExclusive:Integer[1]):Binary[1];

function <<PCT.test>> meta::pure::functions::binary::tests::binarySlice::testRange<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('8B', $f->eval(|0x1F8B08->binarySlice(1, 2)->binaryToHex()));
    assertEquals('8B08', $f->eval(|0x1F8B08->binarySlice(1, 3)->binaryToHex()));
    assertEquals('1F8B08', $f->eval(|0x1F8B08->binarySlice(0, 3)->binaryToHex()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::binarySlice::testEmptyRange<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|0x1F8B08->binarySlice(1, 1)->binaryToHex()));
    assertEquals(0, $f->eval(|0x1F8B08->binarySlice(3, 3)->binarySize()));
}
