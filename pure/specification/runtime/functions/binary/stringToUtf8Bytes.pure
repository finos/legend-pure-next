import meta::pure::test::pct::*;
import meta::pure::functions::binary::*;

// UTF-8 bytes (each 0..255) of a string. Byte-level primitive backing binary
// serialization (the self-hosted PDB writer); byte-identity across platforms
// is the contract.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::binary::stringToUtf8Bytes(s:String[1]):Integer[*];

function <<PCT.test>> meta::pure::functions::binary::tests::stringToUtf8Bytes::testAscii<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals([97, 58, 58, 98], $f->eval(|'a::b'->stringToUtf8Bytes()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::stringToUtf8Bytes::testEmpty<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEmpty($f->eval(|''->stringToUtf8Bytes()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::stringToUtf8Bytes::testTwoByte<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // U+00E9 LATIN SMALL LETTER E WITH ACUTE
    assertEquals([195, 169], $f->eval(|'é'->stringToUtf8Bytes()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::stringToUtf8Bytes::testThreeByte<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // U+20AC EURO SIGN
    assertEquals([226, 130, 172], $f->eval(|'€'->stringToUtf8Bytes()));
}
