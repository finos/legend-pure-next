import meta::pure::test::pct::*;
import meta::pure::functions::binary::*;

// IEEE-754 double bits of a Float, little-endian — exactly the 8 bytes
// FlatBufferBuilder.addDouble writes for an fbs `double`. Byte-level
// primitive backing binary serialization (the self-hosted PDB writer);
// byte-identity across platforms is the contract.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::binary::floatToLeBytes(value:Float[1]):Binary[1];

function <<PCT.test>> meta::pure::functions::binary::tests::floatToLeBytes::testZero<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('0000000000000000', $f->eval(|0.0->floatToLeBytes()->binaryToHex()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::floatToLeBytes::testOne<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // 1.0 = 0x3FF0000000000000
    assertEquals('000000000000F03F', $f->eval(|1.0->floatToLeBytes()->binaryToHex()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::floatToLeBytes::testPi<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // the reference-writer pin for AtomicValue{value=3.14}
    assertEquals('1F85EB51B81E0940', $f->eval(|3.14->floatToLeBytes()->binaryToHex()));
}

function <<PCT.test>> meta::pure::functions::binary::tests::floatToLeBytes::testNegative<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    // -1.5 = 0xBFF8000000000000
    assertEquals('000000000000F8BF', $f->eval(|(-1.5)->floatToLeBytes()->binaryToHex()));
}
