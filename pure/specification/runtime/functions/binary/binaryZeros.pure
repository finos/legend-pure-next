import meta::pure::test::pct::*;
import meta::pure::functions::binary::*;

// `n` zero bytes — the padding the FlatBuffers builder aligns with. A native
// so that padding is one allocation rather than a mapped collection.
native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::binary::binaryZeros(n:Integer[1]):Binary[1];

function <<PCT.test>> meta::pure::functions::binary::tests::binaryZeros::testPadding<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('000000', $f->eval(|3->binaryZeros()->binaryToHex()));
    assertEquals(4, $f->eval(|4->binaryZeros()->binarySize()));
    assertEquals('', $f->eval(|0->binaryZeros()->binaryToHex()));
}
