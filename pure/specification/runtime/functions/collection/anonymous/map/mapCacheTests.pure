import platform::pure::test::pct::*;

// A Pure map is immutable: getIfAbsentPutWithKey computes the value of a missing key without storing it,
// replaceAll is a new map of the pairs given, and a map keeps no statistics.

function <<PCT.test>> platform::pure::functions::collection::tests::map::testGetIfAbsentPutWithKeyGetsAPresentKey<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('one', $f->eval(|newMap([pair(1, 'one')])->getIfAbsentPutWithKey(1, k:Integer[1] | 'computed ' + $k->toString())));
}

function <<PCT.test>> platform::pure::functions::collection::tests::map::testGetIfAbsentPutWithKeyComputesAMissingKey<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('computed 2', $f->eval(|newMap([pair(1, 'one')])->getIfAbsentPutWithKey(2, k:Integer[1] | 'computed ' + $k->toString())));
}

function <<PCT.test>> platform::pure::functions::collection::tests::map::testReplaceAllIsAMapOfThePairs<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let m = $f->eval(|newMap([pair(1, 'one'), pair(2, 'two')])->replaceAll([pair(3, 'three')]));
    assertEquals([3], $m->keys());
    assertEquals('three', $m->get(3));
}

function <<PCT.test>> platform::pure::functions::collection::tests::map::testAMapKeepsNoStatistics<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|newMap([pair(1, 'one')])->getMapStats())->isEmpty());
}
