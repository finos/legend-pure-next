import platform::pure::test::pct::*;

native function <<PCT.function>>
    {doc.doc = 'Returns a new map, with all the entries of the given map plus a new entry with the given key and value.  If the input map previously contained a mapping for the key, the old value is replaced by the specified value.'}
platform::pure::functions::collection::put<U,V>(m:Map<U,V>[1], key:U[1], value:V[1]):Map<U,V>[1];
//{
//   let filtered = if($m._func->isEmpty(),
//                           |$m._values->filter(v|$v.first != $key),
//                           |$m._values->filter(v|!$m._func->toOne()->eval($v.first, $key))
//                        );
//   ^$m(_values = $filtered->concatenate(pair($key, $value)));
//}

function <<PCT.test>> platform::pure::functions::collection::tests::put::testPut_emptyMap<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(newMap(pair('key1', 1)), $f->eval(|newMap([]->cast(@Pair<String, Integer>))->put('key1', 1)));
}

function <<PCT.test>> platform::pure::functions::collection::tests::put::testPut_addsEntry<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(newMap([pair('key1', 0), pair('key2', 1)]), $f->eval(|newMap(pair('key1', 0))->put('key2', 1)));
}

function <<PCT.test>> platform::pure::functions::collection::tests::put::testPut_overridesEntry<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(newMap(pair('key1', 1)), $f->eval(|newMap(pair('key1', 0))->put('key1', 1)));
}
// A replaced key keeps its position in the map's order; only its value changes.
function <<PCT.test>> platform::pure::functions::collection::tests::put::testPut_overridesEntryKeepsItsPosition<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(['key1', 'key2', 'key3'], $f->eval(|newMap([pair('key1', 1), pair('key2', 2), pair('key3', 3)])->put('key1', 10)->keys()));
    assertEquals([10, 2, 3], $f->eval(|newMap([pair('key1', 1), pair('key2', 2), pair('key3', 3)])->put('key1', 10)->values()));
}

// A Pure map is a value: every map keeps its entries, whatever is put into or removed from the maps made from it.
// Hosts share structure between a map and the maps made from it, so this pins that nothing is ever shared mutably.
function <<PCT.test>> platform::pure::functions::collection::tests::put::testPut_leavesEarlierMapsUnchanged<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(range(0, 41)->concatenate([10, 20, -1, 19]), $f->eval(|
        let versions = range(1, 41)->fold({i, acc | ^$acc(values = $acc.values->concatenate($acc.values->last()->toOne()->put($i, $i * 10)))},
                                          list(newMap([]->cast(@Pair<Integer, Integer>)))).values;
        let changed = $versions->at(20)->put(1, -1)->remove(2);
        $versions->map(m | $m->keys()->size())
            ->concatenate([$versions->at(20)->get(1)->toOne(), $versions->at(20)->get(2)->toOne(), $changed->get(1)->toOne(), $changed->keys()->size()]);
    ));
}
