import platform::pure::test::pct::*;
import platform::pure::metamodel::relation::*;
import platform::pure::functions::relation::*;

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    {
        doc.doc='Create a Relation typed column containing a name and a function with 2 parameters',
        PCT.grammarDoc='~col : {p,f,r|$r.val+3}',
        PCT.grammarCharacters='~:'
    }
    platform::pure::functions::relation::funcColSpec2<U,T>(f:Function<{Relation<U>[1], Window<U>[1], U[1]->Any[*]}>[1], s:String[1], cl:CompilerGenericTypeAndMultiplicityHolder<T|1>[1]):FuncColSpec<{Relation<U>[1], Window<U>[1], U[1]->Any[1]}, T>[1]
{
    ^FuncColSpec<{Relation<U>[1], Window<U>[1], U[1]->Any[1]}, T>
    (
        name = $s,
        function = $f
    );
}