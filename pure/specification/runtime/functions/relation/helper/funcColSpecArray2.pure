import platform::pure::test::pct::*;
import platform::pure::metamodel::relation::*;

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    {
        doc.doc='Create a Relation typed column array, each containing a name and a function',
        PCT.grammarDoc='~[col : {p,f,r|$r.val+3}, other : {p,f,r|$r.ww+4}]',
        PCT.grammarCharacters='~[:,:]'
    }
    platform::pure::functions::relation::funcColSpecArray2<U,T,P>(funcSpecs:FuncColSpec<{Relation<U>[1], Window<U>[1], U[1]->Any[*]}, T>[*], cl:CompilerGenericTypeAndMultiplicityHolder<P|1>[1]):FuncColSpecArray<{Relation<U>[1], Window<U>[1], U[1]->Any[*]}, P>[1]
{
    ^FuncColSpecArray<{Relation<U>[1], Window<U>[1], U[1]->Any[*]}, P>
    (
        funcSpecs = $funcSpecs
    );
}
