import platform::pure::test::pct::*;
import platform::pure::metamodel::relation::*;

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    {
        doc.doc='Create a Relation typed column array, each containing a name',
        PCT.grammarDoc='~[col, other]',
        PCT.grammarCharacters='~[,]'
    }
    platform::pure::functions::relation::colSpecArray<T>(s:String[*], cl:GenericTypeAndMultiplicityHolder<T|1>[1]):ColSpecArray<T>[1]
{
    ^ColSpecArray<T>
    (
        names = $s
    );
}