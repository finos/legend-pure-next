import meta::pure::test::pct::*;

Profile meta::pure::test::pct::PCT
{
    // `requiresCompiler` marks tests that dynamically compile source
    // (compileSource): they need the compiler module loaded, which some
    // harnesses cannot provide (e.g. the bootstrap surefire PCT runner —
    // compiler.pdb is built AFTER the maven reactor). Harnesses without a
    // compiler module SKIP these tests visibly rather than erroring.
    stereotypes : [test, adapter, function, platformOnly, testQualifierProfile, requiresCompiler];
    tags: [grammarDoc, grammarCharacters, adapterName];
}

Profile <<meta::pure::test::pct::PCT.testQualifierProfile>> meta::pure::test::pct::PCTCoreQualifier
{
    stereotypes : [variant, needsImplementation];

}

function
    <<PCT.adapter>>
    {
        PCT.adapterName='In-Memory'
    }
    meta::pure::test::pct::testAdapterForInMemoryExecution<X|o>(f:Function<{->X[o]}>[1]):X[o]
{
  $f->eval();
}