import meta::pure::functions::asserts::*;
import meta::pure::test::pct::*;

native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::asserts::assertError(f:Function<{->Any[*]}>[1], message:String[1], line:Integer[0..1], column:Integer[0..1]):Boolean[1];

function <<PCT.function, PCT.platformOnly>> meta::pure::functions::asserts::assertError(f:Function<{->Any[*]}>[1], message:String[1]):Boolean[1]
{
    assertError($f, $message, [], []);
}

function <<PCT.test>> meta::pure::functions::asserts::testSimpleAssertError<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|assertError(|[1,2]->at(3),'The system is trying to get an element at offset 3 where the collection is of size 2')));
}

function <<PCT.test>> meta::pure::functions::asserts::testSimpleAssertErrorLine<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|assertError(|[1,2]->at(3),'The system is trying to get an element at offset 3 where the collection is of size 2', 36, [])));
}

function <<PCT.test>> meta::pure::functions::asserts::testSimpleAssertErrorLineColumn<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|assertError(|[1,2]->at(3),'The system is trying to get an element at offset 3 where the collection is of size 2', 44, 29)));
}

function <<PCT.test>> meta::pure::functions::asserts::testSimpleAssertErrorColumn<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assert($f->eval(|assertError(|[1,2]->at(3),'The system is trying to get an element at offset 3 where the collection is of size 2', [], 29)));
}

// ----------------------------------------------------------------------------
// Cross-engine Pure-stack-trace format test
//
// Every engine (bootstrap = Java direct, Truffle, future native) must embed
// the same `Pure stack trace:\n    at <fn> (<sourceId>:<line>c<col>)` body
// into the exception message returned to assertError.
//
// Support functions below build a 3-deep call chain that triggers a `toOne`
// failure; the test asserts the resulting message contains the unified-format
// stack header + a frame with the unified `(<sid>:<line>c<col>)` location
// syntax. Substring match keeps the test resilient to line-number shifts —
// only the header + frame syntax is pinned.
// ----------------------------------------------------------------------------

function meta::pure::functions::asserts::tests::stackTrace::inner():String[1]
{
    []->cast(@String)->toOne();
}

function meta::pure::functions::asserts::tests::stackTrace::middle():String[1]
{
    meta::pure::functions::asserts::tests::stackTrace::inner();
}

function meta::pure::functions::asserts::tests::stackTrace::outer():String[1]
{
    meta::pure::functions::asserts::tests::stackTrace::middle();
}

// Full-stack assertion — both engines must emit byte-identical text from the
// error line through the lambda frame. The pinned substring covers:
//   1. The native-throw line
//   2. The `Pure stack trace:` header
//   3. inner / middle / outer user frames + the `|outer()` arg lambda frame,
//      each with exact line:col in the unified `(at <sid>:<line>c<col>)` form
//
// We stop at the lambda frame because the immediate caller — the 2-arg
// `meta::pure::functions::asserts::assertError` overload — has its source
// location stripped on Truffle: AssertErrorNode is annotated
// `@TruffleBoundary`, and Truffle drops `frame.getLocation()` for any Pure
// function whose body is mid-evaluation through a Java boundary. Bootstrap
// keeps the location (no boundary equivalent), so the engines diverge from
// this frame upward. Everything pinned below this point is identical between
// engines.
//
// The cross-engine alignment that lets the substring above match byte-for-byte:
//   - the unified `(at <sid>:<line>c<col>)` source-location syntax
//   - bootstrap's `executingFnStack` (mirrors Truffle's RootNode chain) so the
//     name on each frame is the executing function, not the callee
//   - Truffle's `getFunctionName` returning `_functionName` (unmangled) so it
//     matches bootstrap's `_functionName`-based path
//   - normalizing Truffle's anonymous lambda name from `lambda@<file>:<l>:<c>`
//     down to bare `lambda`
//
// Stays `<<test.Test>>` (not PCT) on purpose: the pinned substring includes
// exact `:line:col` offsets of the lambda frame, and wrapping the body in
// `$f->eval(|outer())` would (a) shift columns and (b) inject extra runner
// frames between `outer()` and the test, making the stack trace adapter-
// specific. PCT tests must be backend-agnostic; this one validates the
// in-process Pure stack-trace format itself, which is inherently bound to
// the in-memory adapter.
function <<test.Test>> meta::pure::functions::asserts::tests::stackTrace::testFullPureStackTrace():Boolean[1]
{
    assertError(
        | meta::pure::functions::asserts::tests::stackTrace::outer(),
        '''
        toOne expected exactly 1 element, got 0
        Pure stack trace:
            at meta::pure::functions::asserts::tests::stackTrace::inner (asserts/assertError.pure:61c7)
            at meta::pure::functions::asserts::tests::stackTrace::middle (asserts/assertError.pure:66c5)
            at meta::pure::functions::asserts::tests::stackTrace::outer (asserts/assertError.pure:71c5)
            at lambda (asserts/assertError.pure:109c11)'''
    );
}

