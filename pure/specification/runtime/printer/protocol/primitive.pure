import meta::pure::functions::asserts::*;
import meta::pure::functions::printer::protocol::*;
import meta::pure::protocol::*;

// Protocol printer for `PrimitiveType` elements.
//   Primitive pkg::Varchar extends String
// PrimitiveType collides with M3, so it stays FQN inline.
function meta::pure::functions::printer::protocol::printProtocolPrimitive(p: meta::pure::protocol::grammar::type::PrimitiveType[1]): String[1]
{
    'Primitive ' + printAnnotations($p.stereotypes, $p.taggedValues) + printPackagePointer($p.package) + $p.name +
        if ($p.typeVariables->isEmpty(),   | '', | $p.typeVariables->map(tv | printFunctionParameter($tv))->joinStrings('(', ', ', ')')) +
        if ($p.generalizations->isEmpty(), | '', | $p.generalizations->map(g | printGenericType($g.general->toOne()))->joinStrings(' extends ', ', ', '')) +
        printElementConstraints($p.constraints) +
    '\n';
}
