import meta::pure::functions::asserts::*;
import meta::pure::functions::printer::protocol::*;
import meta::pure::protocol::*;

// Protocol printer for `Association` elements. Same shape as Class minus
// `Class`/`Association` keyword. Reuses printProperty from class.pure for
// each of the two assoc-prop sides. Association collides with M3, so FQN
// inline.
function meta::pure::functions::printer::protocol::printProtocolAssociation(a: meta::pure::protocol::grammar::relationship::Association[1]): String[1]
{
    'Association ' + printAnnotations($a.stereotypes, $a.taggedValues) + printPackagePointer($a.package) + $a.name +
    '\n{\n' +
        [
            $a.properties->map(p | '  ' + printProperty($p))->joinStrings('\n'),
            $a.qualifiedProperties->map(qp | '  ' + printQualifiedProperty($qp))->joinStrings('\n')
        ]->joinStrings('\n') + '\n' +
    '}\n';
}
