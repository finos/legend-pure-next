import meta::pure::functions::asserts::*;
import meta::pure::functions::printer::protocol::*;
import meta::pure::protocol::*;

// Protocol printer for `Profile` elements.
//   Profile pkg::P
//   {
//     stereotypes: [s1, s2];
//     tags: [t1, t2];
//   }
// Profile collides with M3, so FQN inline.
function meta::pure::functions::printer::protocol::printProtocolProfile(p: meta::pure::protocol::grammar::extension::Profile[1]): String[1]
{
    'Profile ' + printPackagePointer($p.package) + $p.name +
    '\n{\n' +
        if ($p.p_stereotypes->isEmpty(), | [], | [$p.p_stereotypes->map(s | $s.value)->joinStrings('  stereotypes: [', ', ', '];')])->concatenate(
        if ($p.p_tags->isEmpty(), | [], | [$p.p_tags->map(t | $t.value)->joinStrings('  tags: [', ', ', '];')]))
        ->joinStrings('\n') + '\n' +
    '}\n';
}
