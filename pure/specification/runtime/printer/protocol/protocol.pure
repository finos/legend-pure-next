import meta::pure::functions::asserts::*;
import meta::pure::functions::printer::protocol::*;
import meta::pure::protocol::*;

// Top-level entry points for the protocol-side printer. printProtocolFile
// walks a PureFile and emits each section with its `###<parser>` header,
// then dispatches each element to its per-kind printer.
//
// Almost every protocol element kind name (Class, Enumeration, Association,
// Profile, PrimitiveType, UserDefinedFunction, NativeFunction, PackageableElement)
// collides with the auto-imported M3 metamodel, so they stay FQN inline.

// Emit a full PureFile: each section gets a `###<parserName>` header, then
// each element printed on its own line (with blank line between elements).
function meta::pure::functions::printer::protocol::printProtocolFile(file: PureFile[1]): String[1]
{
    $file.sections->map(s | printProtocolSection($s))->joinStrings('');
}

// EXPLICIT-mode variant. Walks the file's elements and rewrites every
// function body's expressions via `wrapExplicit` (which injects synthetic
// `__paren__` markers around operator operands), then delegates to the
// regular printer. The printer's `__paren__` arm renders markers as `(...)`.
// Matches the form expected by `grammar_compare_explicit.pure` overrides.
function meta::pure::functions::printer::protocol::printProtocolFileExplicit(file: PureFile[1]): String[1]
{
    let transformedSections = $file.sections->map(s |
        ^$s(elements = $s.elements->map(e | transformElementExplicit($e))->cast(@meta::pure::protocol::grammar::PackageableElement))
    );
    let transformed = ^$file(sections = $transformedSections);
    printProtocolFile($transformed);
}

function meta::pure::functions::printer::protocol::transformElementExplicit(e: meta::pure::protocol::grammar::PackageableElement[1]): meta::pure::protocol::grammar::PackageableElement[1]
{
    $e->match([
        udf: meta::pure::protocol::grammar::function::UserDefinedFunction[1] |
            ^$udf(expressionSequence = $udf.expressionSequence->map(es | wrapExplicit($es))->cast(@meta::pure::protocol::grammar::valuespecification::ValueSpecification)),
        any: meta::pure::protocol::grammar::PackageableElement[1] | $e
    ]);
}

function meta::pure::functions::printer::protocol::printProtocolSection(s: Section[1]): String[1]
{
    let header = '###' + $s.parserName + '\n';
    let imports = if ($s.imports->isEmpty(), | '', | $s.imports->map(i | 'import ' + $i + ';')->joinStrings('\n') + '\n\n');
    let body = $s.elements->map(e | printProtocolElement($e))->joinStrings('\n');
    $header + $imports + $body;
}

// Dispatch a PackageableElement to its per-kind printer. Unsupported kinds
// emit a sentinel comment marking what's missing — running the printer over
// a wide corpus surfaces TODO shapes in test diffs without crashing the run,
// so one missing kind doesn't hide the rest.
function meta::pure::functions::printer::protocol::printProtocolElement(elem: meta::pure::protocol::grammar::PackageableElement[1]): String[1]
{
    $elem->match([
        c:   meta::pure::protocol::grammar::type::Class[1] | printProtocolClass($c),
        e:   meta::pure::protocol::grammar::type::Enumeration[1] | printProtocolEnum($e),
        a:   meta::pure::protocol::grammar::relationship::Association[1] | printProtocolAssociation($a),
        pf:  meta::pure::protocol::grammar::extension::Profile[1] | printProtocolProfile($pf),
        pt:  meta::pure::protocol::grammar::type::PrimitiveType[1] | printProtocolPrimitive($pt),
        udf: meta::pure::protocol::grammar::function::UserDefinedFunction[1] | printProtocolUserDefinedFunction($udf),
        nf:  meta::pure::protocol::grammar::function::NativeFunction[1] | printProtocolNativeFunction($nf),
        any: meta::pure::protocol::grammar::PackageableElement[1] | '/* UNSUPPORTED ELEMENT KIND: ' + $any->genericType().type->toOne()->elementToPath() + ' name=' + $any.name + ' */\n'
    ]);
}
