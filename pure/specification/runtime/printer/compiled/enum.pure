import meta::pure::functions::asserts::*;
import meta::pure::functions::printer::compiled::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::extension::*;
import meta::pure::metamodel::function::property::*;
import meta::pure::metamodel::type::*;

// Compiled-side printer for `Enumeration`. Enum values live as `properties`
// on the enumeration; each property's stereotypes/taggedValues are emitted
// inline before the value name when present.
function meta::pure::functions::printer::compiled::printCompiledEnum(e: Enumeration<Any>[1], ctx: PrintContext[1]): String[1]
{
    let pkgPrefix = printPackagePrefix($e.package);
    let annotations = printCompiledAnnotations($e.stereotypes, $e.taggedValues, $ctx);
    let values = $e.properties->map(p | '  ' + printCompiledEnumValue($p, $ctx))->joinStrings(',\n');
    let body = if ($e.properties->isEmpty(), | '', | $values + '\n');
    'Enum ' + $annotations + $pkgPrefix + $e.name->toOne() + '\n{\n' + $body + '}\n';
}

function meta::pure::functions::printer::compiled::printCompiledEnumValue(p: Property<Nil, Any|*>[1], ctx: PrintContext[1]): String[1]
{
    printCompiledAnnotations($p.stereotypes, $p.taggedValues, $ctx) + $p.name->toOne();
}