import meta::pure::functions::asserts::*;
import meta::pure::functions::printer::compiled::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::type::*;

// Compiled-side printer for `PrimitiveType`. `Primitive pkg::Name(typeVars) extends SuperType [constraints]`.
function meta::pure::functions::printer::compiled::printCompiledPrimitiveType(p: PrimitiveType[1], ctx: PrintContext[1]): String[1]
{
    'Primitive ' + printCompiledAnnotations($p.stereotypes, $p.taggedValues, $ctx) + printPackagePrefix($p.package) + $p.name->toOne() +
        if ($p.typeVariables->isEmpty(),   | '', | $p.typeVariables->map(tv | printCompiledFunctionParameter($tv, $ctx))->joinStrings('(', ', ', ')')) +
        if ($p.generalizations->isEmpty(), | '', | $p.generalizations->map(g | printGenericType($g.general->toOne(), $ctx))->joinStrings(' extends ', ', ', '')) +
        printCompiledElementConstraints($p.constraints, $ctx) +
    '\n';
}
