import meta::pure::functions::collection::*;
import meta::pure::functions::date::*;
import meta::pure::functions::io::*;
import meta::pure::functions::lang::*;
import meta::pure::functions::meta::*;
import meta::pure::functions::string::*;
import meta::pure::metamodel::extension::*;
import meta::pure::metamodel::function::*;
import meta::pure::ui::progress::*;

// ---------------------------------------------------------------------------
// Pure-native runner for <<test.Test>> functions.
//
// Walks the package tree under a given root, finds every
// UserDefinedFunction annotated with <<test.Test>> that takes zero
// parameters, invokes each, and reports pass/fail.
//
// Invocation:
//   pure-truffle execute --pdb core.pdb --pdb compiler.pdb \
//       --function "meta::pure::test::runTests_String_1__String_1_" \
//       --args "meta::pure::functions"
//
// Returns true iff every discovered test returns true.
// Skips parametrized tests (e.g. PCT tests) — those go through runPCTTests.
// ---------------------------------------------------------------------------

// Recursively collect zero-arg <<test.Test>> functions under a package.
function <<test.TestDependency>> meta::pure::test::collectFunctionTests(pkg:Package[1]):UserDefinedFunction<Any>[*]
{
    let directTests = $pkg.children
        ->filter(e | $e->instanceOf(UserDefinedFunction)
                     && meta::pure::test::hasTestStereotype($e)
                     && meta::pure::test::isZeroArg($e->cast(@UserDefinedFunction<Any>)))
        ->cast(@UserDefinedFunction<Any>);

    let subPackages = $pkg.children
        ->filter(e | $e->instanceOf(Package))
        ->cast(@Package);
    let subTests = $subPackages->map(p | meta::pure::test::collectFunctionTests($p));

    concatenate($directTests, $subTests);
}

// PackageableElement → AnnotatedElement → ElementWithStereotypes, so stereotypes
// is available directly on any PackageableElement. We still check via a cast
// that's always-true so the type system doesn't complain about non-inherited
// access.
function <<test.TestDependency>> meta::pure::test::hasTestStereotype(el:PackageableElement[1]):Boolean[1]
{
    $el.stereotypes
        ->exists(s | $s.value == 'Test' && $s.profile.name == 'test');
}

function <<test.TestDependency>> meta::pure::test::isZeroArg(fn:UserDefinedFunction<Any>[1]):Boolean[1]
{
    $fn.parameters->isEmpty();
}

function <<test.TestDependency>> meta::pure::test::runTests(rootPackagePath:String[1]):String[1]
{
    let root = pathToElement($rootPackagePath)->cast(@Package);
    let tests = meta::pure::test::collectFunctionTests($root);
    let total = $tests->size();
    startProgress('Running ' + $total->toString() + ' <<test.Test>> tests from ' + $rootPackagePath + '...');

    let start = currentTimeMillis();

    range(0, $total)->map(i |
        let fn = $tests->at($i);
        let name = $fn->elementToPath();
        tickProgress($i + 1, $total, $name);
        // Each zero-arg <<test.Test>> returns Boolean[1]. An assertion failure
        // throws, unwinding the whole run — the progress display already shows
        // which test was executing.
        //
        // withSilencedPrint suppresses the stdout side effect of `print`/
        // `println` calls inside the test body (assertions on their return
        // values keep working). The runner's tickProgress prints stay
        // visible because they run outside the closure.
        withSilencedPrint(| $fn->evaluate([]));
    );

    let elapsedMs = currentTimeMillis() - $start;
    finishProgress();
    'OK: ' + $total->toString() + ' / ' + $total->toString() + ' <<test.Test>> tests passed in ' + $elapsedMs->toString() + ' ms';
}
