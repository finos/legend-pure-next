// Whether `element` is where its path says when the package tree is WALKED: from its root package down
// `children`, one name at a time, never resolving a path — how the test runners find tests. Every module
// contributing to a package must be seen at every depth: a module adding an element below a package another
// module owns has to list it there (a shadow package, which the registry merges), and the registry has to
// merge them all the way down, not only at the path it was asked for.
function <<test.TestDependency>> platform::pure::test::reachableFromItsRoot(element:PackageableElement[1]):Boolean[1]
{
    let names = $element->elementToPath()->split('::');
    let root = pathToElement($names->at(0))->cast(@Package);
    platform::pure::test::walkChildren($root, $names->tail())->exists(e | $e->is($element));
}

// The elements at `names` below `pkg`, reached through `children` only.
function <<test.TestDependency>> platform::pure::test::walkChildren(pkg:Package[1], names:String[*]):PackageableElement[*]
{
    let named = $pkg.children->map(c | platform::pure::test::resolveChild($c))->filter(c | $c.name == $names->at(0));
    if($names->size() == 1,
       | $named,
       | $named->filter(c | $c->instanceOf(Package))->cast(@Package)->map(p | platform::pure::test::walkChildren($p, $names->tail())));
}
