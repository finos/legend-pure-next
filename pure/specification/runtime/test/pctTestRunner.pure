import meta::pure::functions::collection::*;
import meta::pure::functions::date::*;
import meta::pure::functions::lang::*;
import meta::pure::functions::meta::*;
import meta::pure::functions::string::*;
import meta::pure::metamodel::extension::*;
import meta::pure::metamodel::function::*;
import meta::pure::test::pct::*;
import meta::pure::ui::progress::*;

// ---------------------------------------------------------------------------
// <<PCT.test>> runner — Platform Conformance Tests, parametrized by an
// adapter function. Uses the in-memory adapter already defined in the stdlib
// at meta::pure::test::pct::testAdapterForInMemoryExecution: it simply
// evaluates the passed-in closure in the current runtime.
// ---------------------------------------------------------------------------

function <<test.TestDependency>> meta::pure::test::hasPctTestStereotype(el:PackageableElement[1]):Boolean[1]
{
    $el.stereotypes
        ->exists(s | $s.value == 'test' && $s.profile.name == 'PCT');
}

function <<test.TestDependency>> meta::pure::test::collectPCTTests(pkg:Package[1]):UserDefinedFunction<Any>[*]
{
    // See {@link meta::pure::test::resolveChild} — derefs in-memory pointer
    // children to canonical elements; non-pointer children pass through.
    let resolvedChildren = $pkg.children->map(c | meta::pure::test::resolveChild($c));
    let directTests = $resolvedChildren
        ->filter(e | $e->instanceOf(UserDefinedFunction)
                     && meta::pure::test::hasPctTestStereotype($e))
        ->cast(@UserDefinedFunction<Any>);

    let subPackages = $resolvedChildren
        ->filter(e | $e->instanceOf(Package))
        ->cast(@Package);
    let subTests = $subPackages->map(p | meta::pure::test::collectPCTTests($p));

    concatenate($directTests, $subTests);
}

// Single-arg overload: runs every PCT test under the given package through
// the stdlib in-memory adapter (`$f->eval()` — interpret directly on the
// current runtime). Back-compat shim around the 2-arg form below.
function <<test.TestDependency>> meta::pure::test::runPCTTests(rootPackagePath:String[1]):String[1]
{
    meta::pure::test::runPCTTests(
        $rootPackagePath,
        meta::pure::test::pct::testAdapterForInMemoryExecution_Function_1__X_o_
    );
}

// Two-arg overload: callers supply the adapter — e.g. a translator-backed
// adapter that compiles each PCT lambda to another language, runs it, and
// returns the result. Each backend (Truffle in-memory, java translator,
// future sql/typescript translators) provides its own adapter; the runner
// itself only knows how to hand the adapter to each PCT closure.
function <<test.TestDependency>> meta::pure::test::runPCTTests(rootPackagePath:String[1], adapter:Function<Any>[1]):String[1]
{
    let root = pathToElement($rootPackagePath)->cast(@Package);
    let tests = meta::pure::test::collectPCTTests($root);
    let total = $tests->size();
    // Fail loudly on 0: same rationale as runTests above — 0 PCT tests under
    // a real path almost always means the test PDB isn't loaded or the
    // package's children list is missing the test sub-packages.
    assert($total > 0, |'runPCTTests: found 0 <<PCT.test>> tests under ' + $rootPackagePath + ' — check that the relevant test PDB is loaded and that the path is correct.');
    startProgress('Running ' + $total->toString() + ' <<PCT.test>> tests from ' + $rootPackagePath + '...');

    let start = currentTimeMillis();

    // tryEval wraps each test invocation so a single failure doesn't abort
    // the whole run. Collect (testPath, errorOrEmpty) pairs for a final
    // summary that shows every failure (not just the first).
    //
    // We use the dynamic `evaluate(Function<Any>, List<Any>)` instead of
    // typed `eval(...)` because `$adapter` is `Function<Any>` (the runner
    // doesn't know its specific signature) — `evaluate` accepts any
    // function + a heterogeneous parameter list and dispatches at runtime.
    let results = range(0, $total)->map(i:Integer[1] |
        let fn = $tests->at($i);
        let name = $fn->elementToPath();
        tickProgress($i + 1, $total, $name);
        let result = tryEval(| withSilencedPrint(| meta::pure::functions::lang::evaluate($fn, meta::pure::functions::collection::list($adapter))));
        ^meta::pure::test::TestResult(name = $name, error = $result.failure);
    );

    let elapsedMs = currentTimeMillis() - $start;
    finishProgress();

    let failures = $results->filter(r:meta::pure::test::TestResult[1] | $r.error->isNotEmpty());
    let failed = $failures->size();
    let passed = $total - $failed;

    $failures->map(r:meta::pure::test::TestResult[1] |
        let err = $r.error->toOne();
        println('  FAIL: ' + $r.name);
        println('    ' + $err.message);
        $err.stack->map(frame:String[1] | println('      at ' + $frame));
    );
    let summary = if($failed > 0,
        | 'FAIL: ' + $passed->toString() + ' / ' + $total->toString() + ' <<PCT.test>> tests passed (' + $failed->toString() + ' failed) in ' + $elapsedMs->toString() + ' ms',
        | 'OK: ' + $total->toString() + ' / ' + $total->toString() + ' <<PCT.test>> tests passed in ' + $elapsedMs->toString() + ' ms'
    );
    // Throw on any failure so the CLI's exit code reflects test status —
    // returning the summary string lets the bootstrap CLI swallow failures
    // (it just prints the result), so callers never see a non-zero exit.
    assert($failed == 0, $summary);
    $summary;
}
