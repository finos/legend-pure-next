// A module whose PDB holds ###Diagram elements. `pure-truffle compile` writes it (truffle::spec-compile-languages,
// golden in expected/roundtrip.pdb); every host then reads the golden back and runs m::describe, whose one
// printed line is the cross-host check:
//     DESCRIBE 800.0 tv_person m::Person 40.0,60.0 E:0:0
// m::E has no size and no views: absent optional fields must read back as empty, not as 0.0.
###Pure
Class m::Person
{
    name: String[1];
}

function m::describe():Boolean[1]
{
   let d  = platform::pure::functions::meta::pathToElement('m::D')->cast(@platform::extensions::pure::diagram::metamodel::Diagram);
   let e  = platform::pure::functions::meta::pathToElement('m::E')->cast(@platform::extensions::pure::diagram::metamodel::Diagram);
   let tv = $d.typeViews->at(0);
   print('DESCRIBE ' + $d.width->toOne()->toString() + ' ' + $tv.id + ' '
         + $tv.type->toOne()->elementToPath() + ' '
         + $tv.position.x->toString() + ',' + $tv.position.y->toString()
         + ' E:' + $e.width->size()->toString() + ':' + $e.typeViews->size()->toString() + '\n', 1);
   true;
}

###Diagram
Diagram m::D(width=800.0, height=600.0)
{
    TypeView tv_person(type=m::Person, position=(40.0, 60.0), width=200.0, height=90.0)
}

Diagram m::E
{
}
