function <<access.private>> platform::extensions::language::java::translation::endsWithCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'endsWithCoder expects exactly 2 arguments');
   let s = $conv->translateExpression($fe.parametersValues->at(0));
