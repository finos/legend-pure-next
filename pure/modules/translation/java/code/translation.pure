// matches Pure's `replace` semantics. {@code regexpReplace} is the regex variant.
function <<access.private>> platform::extensions::language::java::translation::replaceCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'replaceCoder expects exactly 3 arguments');
   let s   = $conv->translateExpression($fe.parametersValues->at(0));
   let old = $conv->translateExpression($fe.parametersValues->at(1));
   let new = $conv->translateExpression($fe.parametersValues->at(2));
