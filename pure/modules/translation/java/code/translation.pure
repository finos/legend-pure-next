function <<access.private>> meta::external::language::java::translation::dateExtractor(conv: Conventions[1], fe: FunctionExpression[1], javaMethod: String[1], label: String[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | $label + ' expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let date = $conv->translateExpression($fe.parametersValues->at(0))->j_castWithoutChecks($conv->javaPureDateType());
   $date->j_invoke($javaMethod, [], javaLong());
}

// A DurationUnit argument as its name (`"DAYS"`): a literal enum value, the
// `DurationUnit.DAYS` access form, or any enum-valued expression at run time.
function <<access.private>> meta::external::language::java::translation::durationUnitName(conv: Conventions[1], unitArg: ValueSpecification[1]): Code[1]
{
   let literal = if ($unitArg->instanceOf(AtomicValue), | $unitArg->cast(@AtomicValue).value->filter(v | $v->instanceOf(meta::pure::metamodel::type::Enum))->cast(@meta::pure::metamodel::type::Enum), | []->cast(@meta::pure::metamodel::type::Enum));
   let access  = $unitArg->instanceOf(FunctionExpression)
                 && $unitArg->cast(@FunctionExpression).parametersValues->size() == 1
                 && $unitArg->cast(@FunctionExpression).parametersValues->at(0)->enumerationLiteral()->isNotEmpty();
   if ($literal->size() == 1, | j_string($literal->toOne().name->toOne()),
   |if ($access,              | j_string($unitArg->cast(@FunctionExpression).functionName->toOne()),
                              | $conv->translateExpression($unitArg)->j_castWithoutChecks(javaClass('java.lang.Enum'))->j_invoke('name', [], javaString())));
}


// `pathToElement(path)` and `lenientPathToElement(path)` — Pure's runtime
// path resolver. The translator can't actually resolve elements at Java
// runtime (no metamodel registry available), so emit the path string
// itself. Downstream uses that compare against `elementToPath` or just
// stringify the result will work; uses that need a real PE will fail.
//
// On the Java platform (`metadataElements`) the element is resolved in the
// installed PDBs: Metadata.element / Metadata.lenientElement.
function <<access.private>> meta::external::language::java::translation::pathToElementCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'pathToElementCoder expects at least 1 argument, got ' + $fe.parametersValues->size()->toString());
   let path   = $conv->translateExpression($fe.parametersValues->at(0));
   let method = if ($fe->coderName() == 'lenientPathToElement', | 'lenientElement', | 'element');
   // The path may be written with another separator: `pathToElement('a.b', '.')`.
   let args   = $path->j_castWithoutChecks(javaString())
                   ->concatenate(if ($fe.parametersValues->size() == 2,
                                     | $conv->translateExpression($fe.parametersValues->at(1))->j_castWithoutChecks(javaString()),
                                     | []->cast(@Code)));
   if ($conv.metadataElements,
      | j_invoke(javaClass('org.finos.legend.pure.platform.java.pdb.Metadata'), $method, $args, javaObject())
           ->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed()),
      | $path);
}

// `rem(a, b)` — Pure's modulo. Java `%` works for both long and double via
// j_remHelper (no j_mod factory exists in the metamodel). Result type
// follows Pure's `Number[1]` return — emit as double which Number-typed
// callers accept after auto-widening.
function <<access.private>> meta::external::language::java::translation::remCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'remCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   if ($fe.parametersValues->exists(p | $p->isDecimalTyped()),
      | $conv->asBigDecimal($fe.parametersValues->at(0))->j_invoke('remainder', [$conv->asBigDecimal($fe.parametersValues->at(1))], javaBigDecimal()),
      | $conv->primitiveRem($fe));
}

function <<access.private>> meta::external::language::java::translation::primitiveRem(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let a = $conv->translateExpression($fe.parametersValues->at(0));
   let b = $conv->translateExpression($fe.parametersValues->at(1));
   ^meta::external::language::java::metamodel::InfixExpression(left=$a, op='%', right=$b, type=javaDouble());
}

// `toRepresentation(x)` — same shape as toString for non-string types;
// strings round-trip with quotes in real Pure but tests that depend on the
// quoted form will diverge here. Good enough for non-string toRepresentation
// cases (Integer, Float, Boolean, Date, ...) and a clean step beyond
// silently failing.
function <<access.private>> meta::external::language::java::translation::toRepresentationCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'toRepresentationCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let element = $fe.parametersValues->at(0)->match([
      a: AtomicValue[1]            | $a.value->filter(v | $v->instanceOf(meta::pure::metamodel::PackageableElement))->cast(@meta::pure::metamodel::PackageableElement),
      other: ValueSpecification[1] | []->cast(@meta::pure::metamodel::PackageableElement)
   ]);
   // A class or function literal is represented by its full path, known now.
   if ($element->size() == 1, | j_string($element->toOne()->elementToPath()), | $conv->valueRepresentation($fe));
}

function <<access.private>> meta::external::language::java::translation::valueRepresentation(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   // Pure literal syntax, as the JS runtime's __toRepresentation: a String is
   // single-quoted with \ ' newline tab and CR escaped, a date gets its `%`,
   // a Float prints as {@link pureFloatStringJava}. The escape characters are
   // built with (char) codes to keep backslashes out of this Pure string.
   valueIife(
      $conv->translateExpression($fe.parametersValues->at(0)),
      javaObject(),
      javaString(),
      [j_code('if (pureIifeIn == null) { return ""; } '
         + 'if (pureIifeIn instanceof String) { '
         + 'String pureRepB = String.valueOf((char) 92); String pureRepQ = String.valueOf((char) 39); '
         + 'return pureRepQ + ((String) pureIifeIn).replace(pureRepB, pureRepB + pureRepB).replace(pureRepQ, pureRepB + pureRepQ)'
         + '.replace(String.valueOf((char) 10), pureRepB + "n").replace(String.valueOf((char) 9), pureRepB + "t")'
         + '.replace(String.valueOf((char) 13), pureRepB + "r") + pureRepQ; } '
         + 'if (pureIifeIn instanceof java.time.temporal.Temporal || pureIifeIn.getClass().getSimpleName().equals("PureDate")) { return "%" + pureIifeIn; } '
         + pureFloatStringJava('pureIifeIn')
         + 'return String.valueOf(pureIifeIn);', javaVoid())]);
}

// `cast(value, type)` — Pure's runtime type assertion. Java's type system
// already erases generics at runtime; we treat cast as identity at the
// translation level (the Pure type checker has already validated the static
// shape). Emit only the operand expression — the unused `type` arg is
// dropped.
// The parameters that witness type parameters, by the name of the parameter they
// witness. A parameter declared `T[m]` witnesses both T and m; the first such
// parameter wins, as the call site binds them all to the same thing.
function <<access.private>> meta::external::language::java::translation::witnessesOfTypeParameters(parameters: meta::pure::metamodel::valuespecification::VariableExpression[*]): Map<String, TypeVarWitness>[0..1]
{
   let witnesses = $parameters->map(p | $p->witnessOfParameter())->filter(w | $w->isNotEmpty());
   if ($witnesses->isEmpty(),
      | []->cast(@Map<String, TypeVarWitness>),
      | newMap($witnesses));
}

function <<access.private>> meta::external::language::java::translation::witnessOfParameter(parameter: meta::pure::metamodel::valuespecification::VariableExpression[1]): Pair<String, TypeVarWitness>[0..1]
{
   let raw = $parameter.genericType->rawType();
   if ($raw->isEmpty() || !$raw->toOne()->instanceOf(meta::pure::metamodel::type::generics::TypeParameter),
      | []->cast(@Pair<String, TypeVarWitness>),
      | let mul = $parameter.multiplicity;
        let mulName = if ($mul->instanceOf(meta::pure::metamodel::multiplicity::ConcreteMultiplicity),
                          | []->cast(@String),
                          | $mul->cast(@meta::pure::metamodel::multiplicity::MultiplicityParameter).name);
        pair($raw->toOne()->cast(@meta::pure::metamodel::type::generics::TypeParameter).name->toOne(),
             ^TypeVarWitness(parameter = $parameter.name->meta::external::language::java::translation::safeJavaName(),
                             mulParameter = $mulName));
   );
}

function <<access.private>> meta::external::language::java::translation::castCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'castCoder expects at least 1 argument, got ' + $fe.parametersValues->size()->toString());
   let value  = $conv->translateExpression($fe.parametersValues->at(0));
   let raw    = $fe.genericType->rawType();
   let target = if ($raw->isNotEmpty() && $raw->toOne()->isCheckedCastTarget(), | $raw->toOne(), | []->cast(@meta::pure::metamodel::type::Type));
   // Any other class (the metamodel's, a function type) is cast unchecked to
   // its Java type, so the value is typed as the Pure expression is.
   let typed  = $raw->isNotEmpty() && $raw->toOne()->instanceOf(meta::pure::metamodel::type::Class) && $raw->toOne() != Any;
   // `cast(@T)` — the type parameter is whatever the call site bound it to, so
   // the check reads it off the argument that witnesses it.
   let witnessed = if ($raw->isNotEmpty() && $raw->toOne()->instanceOf(meta::pure::metamodel::type::generics::TypeParameter),
                       | $conv->witnessFor($raw->toOne()->cast(@meta::pure::metamodel::type::generics::TypeParameter)),
                       | []->cast(@TypeVarWitness));
   if ($witnessed->isNotEmpty(), | $conv->witnessedCast($value, $witnessed->toOne(), $fe),
   |if ($target->isNotEmpty(), | $conv->withConstraints($conv->checkedCast($value, $target->toOne(), $fe), $target->toOne(), $fe),
   |if ($typed,               | $value->toObjectCode()->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe->resolvedMultiplicity())->toBoxed()),
                              | $value)));
}

// The witness recorded for `t`, if the function being translated has one.
function <<access.private>> meta::external::language::java::translation::witnessFor(conv: Conventions[1], t: meta::pure::metamodel::type::generics::TypeParameter[1]): TypeVarWitness[0..1]
{
   if ($conv.typeVarWitness->isEmpty() || $t.name->isEmpty(),
      | []->cast(@TypeVarWitness),
      | $conv.typeVarWitness->toOne()->get($t.name->toOne()));
}

// `Metadata.castTo(value, Metadata.witnessType(witness))`, and when the cast
// names the multiplicity parameter the same witness binds (`cast(@T|m)`), the
// check covers the count too.
function <<access.private>> meta::external::language::java::translation::witnessedCast(conv: Conventions[1], value: Code[1], witness: TypeVarWitness[1], fe: FunctionExpression[1]): Code[1]
{
   let metadata  = javaClass('org.finos.legend.pure.platform.java.pdb.Metadata');
   let witnessed = j_variable(javaObject(), $witness.parameter);
   let bindsMul  = $witness.mulParameter->isNotEmpty()
                   && !$fe.multiplicity->instanceOf(meta::pure::metamodel::multiplicity::ConcreteMultiplicity)
                   && $fe.multiplicity->cast(@meta::pure::metamodel::multiplicity::MultiplicityParameter).name == $witness.mulParameter;
   if ($bindsMul,
      | j_invoke($metadata, 'castToWitness', [$value->toObjectCode(), $witnessed], javaObject()),
      | j_invoke($metadata, 'castTo', [$value->toObjectCode(),
                 j_invoke($metadata, 'witnessType', [$witnessed], javaObject())], javaObject()));
}

// `cast(@P(8))` where P carries constraints: each is checked on the value, with
// `$this` bound to it and the type variables to the values the target names.
// Failing one throws as Pure does: "Constraint :[id] violated in the Class P".
function <<access.private>> meta::external::language::java::translation::withConstraints(conv: Conventions[1], code: Code[1], target: meta::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[1]
{
   let owner       = $target->filter(t | $t->instanceOf(meta::pure::metamodel::extension::ElementWithConstraints))
                        ->cast(@meta::pure::metamodel::extension::ElementWithConstraints);
   let constraints = $owner->map(o | $o.constraints);
   // Only when every type variable the constraints may mention is bound by the
   // cast (`@P(8)`): a check over an unbound one would not compile.
   let variables = $target->filter(t | $t->instanceOf(meta::pure::metamodel::type::PrimitiveType))
                      ->cast(@meta::pure::metamodel::type::PrimitiveType).typeVariables;
   let bound     = $conv->typeVariableBindings($target, $fe);
   if (!$conv.metadataElements,                                                   | $code,
   |if ($constraints->isNotEmpty() && $bound->size() == $variables->size(),        | $conv->constraintChecks($code, $constraints, $target, $fe),
   |if ($constraints->isEmpty(),                                                   | $conv->inheritedConstraintChecks($code, $target, $fe),
                                                                                   | $code)));
}

// A primitive may carry its constraints through its parent, binding the parent's
// type variables as it extends it (`OP8 extends OP(8)`): the check is the
// PARENT's, with the values written there, and it names the parent.
function <<access.private>> meta::external::language::java::translation::inheritedConstraintChecks(conv: Conventions[1], code: Code[1], target: meta::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[1]
{
   let parents = $target.generalizations->map(g | $g.general)
                    ->filter(g | $g->instanceOf(meta::pure::metamodel::type::generics::GenericTypeValue))
                    ->cast(@meta::pure::metamodel::type::generics::GenericTypeValue)
                    ->filter(g | $g->rawType()->constraintsOf()->isNotEmpty());
   if ($parents->isEmpty(), | $code, | $conv->boundParentConstraints($code, $parents->at(0), $fe));
}

function <<access.private>> meta::external::language::java::translation::boundParentConstraints(conv: Conventions[1], code: Code[1], parent: meta::pure::metamodel::type::generics::GenericTypeValue[1], fe: FunctionExpression[1]): Code[1]
{
   let owner     = $parent->rawType()->toOne();
   let variables = $owner->filter(t | $t->instanceOf(meta::pure::metamodel::type::PrimitiveType))
                      ->cast(@meta::pure::metamodel::type::PrimitiveType).typeVariables;
   let values    = $parent.typeVariableValues;
   let bindings  = range($variables->size())->filter(i | $i < $values->size())->map(i |
                      j_declare($conv->pureTypeToJavaType($variables->at($i).genericType, $variables->at($i).multiplicity),
                                $variables->at($i).name->meta::external::language::java::translation::safeJavaName(),
                                $conv->translateExpression($values->at($i))));
   if ($bindings->size() != $variables->size(),
      | $code,
      | $conv->constraintChecksBound($code, $owner->constraintsOf(), $owner, $fe, $bindings));
}

// The constraints an element carries, if it carries any.
function <<access.private>> meta::external::language::java::translation::constraintsOf(t: meta::pure::metamodel::type::Type[*]): meta::pure::metamodel::constraint::Constraint[*]
{
   $t->filter(x | $x->instanceOf(meta::pure::metamodel::extension::ElementWithConstraints))
      ->cast(@meta::pure::metamodel::extension::ElementWithConstraints).constraints;
}

// The value, checked against each constraint before it is returned.
function <<access.private>> meta::external::language::java::translation::constraintChecks(conv: Conventions[1], code: Code[1], constraints: meta::pure::metamodel::constraint::Constraint[*], target: meta::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[1]
{
   $conv->constraintChecksBound($code, $constraints, $target, $fe, $conv->typeVariableBindings($target, $fe));
}

function <<access.private>> meta::external::language::java::translation::constraintChecksBound(conv: Conventions[1], code: Code[1], constraints: meta::pure::metamodel::constraint::Constraint[*], target: meta::pure::metamodel::type::Type[1], fe: FunctionExpression[1], typeBindings: Code[*]): Code[1]
{
   // Its own parameter name: a constraint's message may itself be an IIFE over
   // `pureIifeIn`, which would clash.
   let valueType = $conv->pureTypeToJavaType($fe.genericType, PureOne)->toBoxed();
   let bindThis  = j_declare($valueType, 'this_', j_variable(javaObject(), 'pureConstrainedV')->j_castWithoutChecks($valueType));
   let bindings  = $typeBindings->concatenate($bindThis);
   let checks    = $constraints->map(c | $conv->constraintCheck($c, $target));
   let body      = $bindings->concatenate($checks)->concatenate(j_code('return pureConstrainedV;', javaVoid()));
   let checked   = j_lambda([j_parameter(javaObject(), 'pureConstrainedV')], j_block($body))
                      ->j_cast(javaFunction(javaObject(), javaObject()))
                      ->j_invoke('apply', [$code->toObjectCode()], javaObject());
   $checked->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe->resolvedMultiplicity())->toBoxed());
}

// `<type> x = <value>;` for each type variable the cast target binds (`@P(8)`).
function <<access.private>> meta::external::language::java::translation::typeVariableBindings(conv: Conventions[1], target: meta::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[*]
{
   let variables = $target->filter(t | $t->instanceOf(meta::pure::metamodel::type::PrimitiveType))
                      ->cast(@meta::pure::metamodel::type::PrimitiveType).typeVariables;
   // `cast(@P(8))`: the target's generic type is the holder argument's type
   // argument, and it carries the values (see extractNameFromGenericTypeAndMultiplicityHolder).
   let fromHolder = $fe.parametersValues->slice(1, $fe.parametersValues->size())
                       ->filter(p | $p->instanceOf(meta::pure::metamodel::valuespecification::GenericTypeAndMultiplicityHolder))
                       ->cast(@meta::pure::metamodel::valuespecification::GenericTypeAndMultiplicityHolder)
                       ->map(h | $h.classifierGenericType.typeArguments);
   let values    = $fe.genericType->concatenate($fromHolder)
                      ->filter(g | $g->instanceOf(meta::pure::metamodel::type::generics::GenericTypeValue))
                      ->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).typeVariableValues;
   range($variables->size())->filter(i | $i < $values->size())->map(i |
      j_declare($conv->pureTypeToJavaType($variables->at($i).genericType, $variables->at($i).multiplicity),
                $variables->at($i).name->meta::external::language::java::translation::safeJavaName(),
                $conv->translateExpression($values->at($i))));
}

// `if (!(<constraint>)) { throw ... }` for one constraint.
function <<access.private>> meta::external::language::java::translation::constraintCheck(conv: Conventions[1], constraint: meta::pure::metamodel::constraint::Constraint[1], target: meta::pure::metamodel::type::Type[1]): Code[1]
{
   let className = $target->cast(@meta::pure::metamodel::PackageableElement).name->toOne();
   let name      = if ($constraint.name->isEmpty(), | '0', | $constraint.name->toOne());
   let condition = $conv->translateExpression($constraint.functionDefinition.expressionSequence->toOne())->asBooleanCode();
   let prefix    = j_string('Constraint :[' + $name + '] violated in the Class ' + $className);
   let message   = $constraint.messageFunction->map(m |
                      j_string(', Message: ')->j_plus($conv->translateExpression($m.expressionSequence->toOne())->j_castWithoutChecks(javaString())));
   let text      = $message->fold({m, acc | $acc->j_plus($m)}, $prefix);
   j_if(j_not($condition), j_throw(j_new(javaClass('java.lang.RuntimeException'), [$text])));
}

// A cast target whose Java class can check a value: a primitive, a primitive
// extension, a user class or an enumeration. Not a type parameter (erased), a
// metamodel type or Any.
function <<access.private>> meta::external::language::java::translation::isCheckedCastTarget(t: meta::pure::metamodel::type::Type[1]): Boolean[1]
{
   ($t->instanceOf(meta::pure::metamodel::type::PrimitiveType) || $t->instanceOf(meta::pure::metamodel::type::Enumeration) || $t->isUserClassType())
      && $t != Any;
}

// `value->cast(@T)` checked at runtime: every value must be an instance of T's
// Java class, or it fails with Pure's message — `Cast exception: String cannot
// be cast to CR_Sub`, the value's type named as Pure names it.
function <<access.private>> meta::external::language::java::translation::checkedCast(conv: Conventions[1], value: Code[1], target: meta::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[1]
{
   let javaType = $conv->pureTypeToJavaType($target->typeGenericType(), PureOne)->toBoxed();
   let name     = $target->cast(@meta::pure::metamodel::PackageableElement).name->toOne();
   valueIife($value->toObjectCode(), javaObject(), javaObject(), [
      j_code('for (Object pureCastV : pureIifeIn instanceof java.util.List ? (java.util.List<?>) pureIifeIn : java.util.Collections.singletonList(pureIifeIn)) { '
           + 'if (pureCastV != null && !(pureCastV instanceof ' + $javaType->meta::external::language::java::serialization::typeToString() + ')) { '
           + 'String pureCastT = pureCastV instanceof Long ? "Integer" : pureCastV instanceof Double ? "Float" : pureCastV instanceof java.math.BigDecimal ? "Decimal" : pureCastV.getClass().getSimpleName().equals("PureDate") ? (pureCastV.toString().contains("T") ? "DateTime" : pureCastV.toString().length() >= 10 ? "StrictDate" : "Date") : pureCastV.getClass().getSimpleName(); '
           + 'throw new RuntimeException("Cast exception: " + pureCastT + " cannot be cast to ' + $name + '"); } } '
           + 'return pureIifeIn;', javaVoid())
   ])->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe->resolvedMultiplicity())->toBoxed());
}

// A GenericType for `t`.
function <<access.private>> meta::external::language::java::translation::typeGenericType(t: meta::pure::metamodel::type::Type[1]): meta::pure::metamodel::type::generics::GenericType[1]
{
   ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = $t);
}

// True for a user primitive extending another primitive, e.g. `Primitive P8 extends Integer`.
function <<access.private>> meta::external::language::java::translation::isPrimitiveExtension(t: meta::pure::metamodel::type::Type[1]): Boolean[1]
{
   $t->instanceOf(meta::pure::metamodel::type::PrimitiveType)
      && !$t->cast(@meta::pure::metamodel::PackageableElement)->elementToPath()->startsWith('meta::pure::metamodel::type::primitives::')
      && !$t->extendedPrimitiveOpt()->isEmpty();
}

function <<access.private>> meta::external::language::java::translation::extendedPrimitiveOpt(t: meta::pure::metamodel::type::Type[1]): meta::pure::metamodel::type::Type[*]
{
   $t.generalizations->map(g | $g.general->rawType())->filter(s | $s->instanceOf(meta::pure::metamodel::type::PrimitiveType));
}

function <<access.private>> meta::external::language::java::translation::extendedPrimitive(t: meta::pure::metamodel::type::Type[1]): meta::pure::metamodel::type::Type[1]
{
   $t->extendedPrimitiveOpt()->at(0);
}

// `coll->fold({elt, acc | body}, init)` — left fold. Stream.reduce expects the
// accumulator as `(acc, elt) -> newAcc` (acc first) but Pure's fold lambda is
// `(elt, acc) -> newAcc` (elt first). Wrap the translated lambda in a flip
// lambda before passing to reduce. The combiner is required by reduce's
// signature for parallel streams; since `.stream()` is sequential, our
// combiner is never invoked — just return the first operand.
function <<access.private>> meta::external::language::java::translation::foldCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'foldCoder expects exactly 3 arguments (collection, lambda, init), got ' + $fe.parametersValues->size()->toString());
   let coll      = $conv->translateAsList($fe.parametersValues->at(0));
   let lambdaArg = $fe.parametersValues->at(1);
   // Cast init to Object so Stream.reduce's generic U infers consistently
   // — the reducer's lambda return type is Object (β-inlined body or
   // BiFunction<Object,Object,Object>), so init must agree or Java fails
   // type inference ("inference variable U has incompatible bounds").
   let init      = $conv->translateExpression($fe.parametersValues->at(2))->toObjectCode();
   // The reducer (Object, Object) → Object around the translated lambda.
   let reducer = $conv->buildFoldReducer($lambdaArg);
   // Prefixed names: a lambda parameter may not shadow one of the enclosing
   // method's, and a Pure function is free to call its own parameters a and b.
   let combiner = j_lambda(
      [j_parameter(javaObject(), 'pureFoldA'), j_parameter(javaObject(), 'pureFoldB')],
      j_variable(javaObject(), 'pureFoldA')
   );
   let reduceCall = $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('reduce', [$init, $reducer, $combiner], javaObject());
   // Cast the Object reduce result to the FE's expected type so the
   // surrounding context (return statement, assignment, arg position)
   // typechecks. For primitive targets, route through the boxed type
   // so {@code j_cast}'s primitive proxy handles auto-unboxing.
   let feRetType = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity);
   $reduceCall->j_castWithoutChecks($feRetType->toBoxed());
}

// The `(Object acc, Object elt) -> ...` reducer: the translated fold lambda
// cast to {@code BiFunction<Object,Object,Object>} and applied as
// {@code .apply(elt, acc)} (note the flip: Pure puts elt first, Stream.reduce
// passes the accumulator first). The lambda's `var` parameters are rebound to
// their Pure types (see {@link translateLambdaValue}), so its body reads
// properties and copies objects through the generated classes. An earlier
// version inlined the body with Object-typed `_acc`/`_elt`, which lost those
// types. The reducer's own parameters are prefixed so they can't collide with
// a local of the enclosing method, and suffixed with the Pure lambda's
// parameter names so a fold nested in the lambda doesn't redeclare them.
function <<access.private>> meta::external::language::java::translation::buildFoldReducer(conv: Conventions[1], lambdaArg: ValueSpecification[1]): Code[1]
{
   let f      = $conv->translateExpression($lambdaArg);
   let bif    = $f->j_castWithoutChecks(javaBiFunction(javaObject(), javaObject(), javaObject()));
   let names  = $lambdaArg->match([
                   av: AtomicValue[1] | $av.value->filter(v | $v->instanceOf(LambdaFunction))->map(l | $l->cast(@LambdaFunction<Any>).parameters->map(p | $p.name)),
                   other: ValueSpecification[1] | []->cast(@String)
                ]);
   let suffix = $names->map(n | '_' + $n)->joinStrings('');
   j_lambda(
      [j_parameter(javaObject(), 'pureFoldAcc' + $suffix), j_parameter(javaObject(), 'pureFoldElt' + $suffix)],
      $bif->j_invoke('apply', [j_variable(javaObject(), 'pureFoldElt' + $suffix), j_variable(javaObject(), 'pureFoldAcc' + $suffix)], javaObject())
   );
}

// `compare(a, b)` — Pure's 3-way compare, returns Integer (Java long).
// Java's `((Comparable) a).compareTo(b)` returns int; cast up to long.
function <<access.private>> meta::external::language::java::translation::compareCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'compareCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   if ($fe.parametersValues->exists(p | $p->isDecimalTyped()) || $fe.parametersValues->mixesNumberTypes(),
      | j_cast($conv->asBigDecimal($fe.parametersValues->at(0))->j_invoke('compareTo', [$conv->asBigDecimal($fe.parametersValues->at(1))], javaInt()), javaLong()),
      | let a = $conv->translateExpression($fe.parametersValues->at(0));
        let b = $conv->translateExpression($fe.parametersValues->at(1));
        if ($fe.parametersValues->at(0).genericType->rawType() != $fe.parametersValues->at(1).genericType->rawType(),
           | // Values of unrelated types order by their Java class name first, as
             // on the Truffle runtime; same-class values by their natural order.
             valueIife(j_invoke(javaArrays(), 'asList', [$a->toObjectCode(), $b->toObjectCode()], javaList()), javaList(), javaLongBoxed(), [
                j_code('Object pureCmpX = pureIifeIn.get(0); Object pureCmpY = pureIifeIn.get(1); '
                     + 'int pureCmpC = pureCmpX.getClass().getName().compareTo(pureCmpY.getClass().getName()); '
                     + 'if (pureCmpC == 0) { pureCmpC = ((Comparable) pureCmpX).compareTo(pureCmpY); } '
                     + 'return (long) Integer.signum(pureCmpC);', javaVoid())
             ])->j_cast(javaLong()),
           | j_cast(j_invoke($a->j_cast(javaClass('java.lang.Comparable')), 'compareTo', [$b], javaInt()), javaLong())););
}

// `value->match([p1:T1[m1]|body1, p2:T2[m2]|body2, ...])` and the 3-argument
// `value->match(lambdas, extra)` — dispatch on type AND multiplicity: the first
// lambda whose parameter accepts the value (its size within the multiplicity's
// bounds, every element an instance of the type) runs. The dispatch lives in
// the generated PureMatch class (see {@link pureMatchHelperClass}); the call
// site only passes the value, the translated lambdas, each parameter's bounds
// and Java class. Doing it inline would need locals, and a match nested in an
// arm's body would redeclare them — javac rejects a lambda parameter or local
// that shadows an enclosing one.
function <<access.private>> meta::external::language::java::translation::matchCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2 || $fe.parametersValues->size() == 3, | 'matchCoder expects 2 or 3 arguments, got ' + $fe.parametersValues->size()->toString());
   let withExtra = $fe.parametersValues->size() == 3;
   if (!$fe.parametersValues->at(1)->hasLiteralMatchLambdas(),
      | $conv->dynamicMatch($fe, $withExtra),
      | $conv->literalMatch($fe, $withExtra));
}

// `$x->match($lambdas)` — the arms are a value, so each is asked for its own
// parameter type and bounds when the match runs.
function <<access.private>> meta::external::language::java::translation::dynamicMatch(conv: Conventions[1], fe: FunctionExpression[1], withExtra: Boolean[1]): Code[1]
{
   let arms  = $conv->translateAsList($fe.parametersValues->at(1));
   let extra = if ($withExtra, | $conv->translateExpression($fe.parametersValues->at(2))->toObjectCode(), | j_null());
   let many  = if ($fe.multiplicity->holdsManyValues(), | j_true(), | j_false());
   j_invoke(javaClass(meta::external::language::java::translation::runtimeClass('PureMatch')), 'matchDynamic',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode(), $arms, $extra,
             if ($withExtra, | j_true(), | j_false()), $many], javaObject())
      ->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed());
}

// True when the match arms are written out, so their types are known here.
function <<access.private>> meta::external::language::java::translation::hasLiteralMatchLambdas(vs: ValueSpecification[1]): Boolean[1]
{
   $vs->match([
      c: Collection[1]  | $c.values->forAll(v | $v->hasLiteralMatchLambdas()),
      a: AtomicValue[1] | $a.value->forAll(v | $v->instanceOf(LambdaFunction)),
      x: ValueSpecification[1] | false
   ]);
}

function <<access.private>> meta::external::language::java::translation::literalMatch(conv: Conventions[1], fe: FunctionExpression[1], withExtra: Boolean[1]): Code[1]
{
   let lambdas   = $fe.parametersValues->at(1)->matchLambdas();
   let fnType    = if ($withExtra, | javaClass('java.util.function.BiFunction'), | javaClass('java.util.function.Function'));
   let arms      = j_invoke(javaArrays(), 'asList', $lambdas->map(l | $conv->translateLambdaValue($l)->j_castWithoutChecks($fnType)), javaList());
   let params    = $lambdas->map(l | $l.parameters->at(0));
   let bounds    = j_code('new long[]{' + $params->map(p | $p.multiplicity->matchBounds())->joinStrings(', ') + '}', javaObject());
