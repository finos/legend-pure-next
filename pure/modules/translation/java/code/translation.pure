// True for two numeric operands of different Pure types (Integer and Float),
// which Java can't compare directly.
function <<access.private>> platform::extensions::language::java::translation::mixesNumberTypes(operands: ValueSpecification[*]): Boolean[1]
{
   let numeric = [Integer, Float, Number, platform::pure::metamodel::type::primitives::Decimal];
   let types   = $operands->map(o | $o.genericType->rawType());
   $types->size() == 2 && $types->forAll(t | $numeric->contains($t)) && $types->at(0) != $types->at(1);
