   // must report `toOne expected exactly 1 element, got 0` as the other three
   // backends do, and `[1,2]->toOne()` must fail rather than silently yield the
   // first element. Left alone below: a multiplicity PARAMETER (`TryResult.value`
   // is `V[m]`) is not statically a collection, so strictness there is not
   // justified by the declared type.
   let extracted = if ($arg.multiplicity->toOne()->holdsManyValues(),
      | j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureValues')), 'toOne',
                 [$conv->translateAsList($arg)->toObjectCode()], javaObject()),
   |if (!$arg.multiplicity->toOne()->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity),
      | $code->singleValueOfAny($conv),
      | $code
   ));
   let feRetType = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity);
   // fitToType, not a cast: a scalar Pure multiplicity can still arrive as a
   // Java List (an automapped property read builds one), and `(Long) aList`
   // is not a cast Java accepts.
   $extracted->fitToType($feRetType->toBoxed(), $conv);
}

// Collection slice + transform — Pure's `take`/`drop`/`map` over `[*]` map
// onto Java `Stream` ops with `.toList()` (Java 16+ shortcut for
// `.collect(Collectors.toList())`). The 4-arg j_invoke variant carries an
// explicit return type since these stream methods aren't in apiKnowledge.
function <<access.private>> platform::extensions::language::java::translation::takeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'takeCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   // A negative count takes nothing; Stream.limit would throw on it.
   let n    = j_invoke(javaMath(), 'max', [j_long(0), $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaLong())], javaLong());
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('limit',  [$n], javaStream(javaObject()))
        ->j_invoke('toList', [], javaList(javaObject()));
}

function <<access.private>> platform::extensions::language::java::translation::dropCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'dropCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   // A negative count drops nothing; Stream.skip would throw on it.
   let n    = j_invoke(javaMath(), 'max', [j_long(0), $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaLong())], javaLong());
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('skip',   [$n], javaStream(javaObject()))
        ->j_invoke('toList', [], javaList(javaObject()));
}

// map's second arg is an AtomicValue holding a LambdaFunction; the scalar
// dispatch in translateScalarAtomicValue lifts it into a Java lambda via
// translateLambdaValue, which becomes the Function passed to Stream.map.
// A function ARGUMENT as something `Stream.map` can take. A lambda already
// translates to a `java.util.function.Function`; a function held as metadata
// does not — `$vals->map($property)`, where `$property` came from
// `M_Person.properties->...->toOne()`, is a PropertyImpl typed Object, and
// `.map(property)` does not compile. Adapt it through `Metadata.invoke`, which
// knows how to apply a property (it reads it) as well as any other function
// value.
//
// Keyed off the PURE argument, not the Java type: a Pure `Property` IS a
// `Function`, so `$f.type` claims `java.util.function.Function` while the local
// is emitted as `Object`. Only a function reached through a VARIABLE needs the
// adapter; an inline lambda already translates to a real Java lambda.
function <<access.private>> platform::extensions::language::java::translation::asJavaFunctionValue(conv: Conventions[1], f: Code[1], adapt: Boolean[1]): Code[1]
{
   if (!$adapt,
      | $f,
      | j_lambda([j_parameter(javaObject(), 'pureFnArg')],
           j_block([j_return(
              j_invoke(javaClass($conv->pdbClass('Metadata')), 'invoke',
                 [$f->toObjectCode(),
                  j_invoke(javaClass('java.util.List'), 'of', [j_variable(javaObject(), 'pureFnArg')], javaList())],
                 javaObject()))]))
           ->j_castWithoutChecks(javaClass('java.util.function.Function')));
}

function <<access.private>> platform::extensions::language::java::translation::mapCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'mapCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   let fnArg = $fe.parametersValues->at(1);
   let f    = $conv->platform::extensions::language::java::translation::asJavaFunctionValue(
                  $conv->translateExpression($fnArg),
                  $fnArg->instanceOf(platform::pure::metamodel::valuespecification::VariableExpression));
   // Pure's map concatenates the results: a to-many result is flattened and an
   // empty one (null) dropped.
   let mapped = $conv->runtimeCall('PureCollections', 'map', [$coll, $f], javaList());
   // PureCollections.map always produces a List, but map's OWN multiplicity decides how
   // the result is represented: `$x->map(f)` where both are [0..1] is [0..1], a
   // single value, so the declared type is the element type and the List has to
   // be unwrapped. Without this the body returned a List from a method declared
   // `String` — javac rejected it, and the to-many path (the common one) is
   // left untouched so its emitted text does not move.
   if ($fe.multiplicity->holdsManyValues(),
      | $mapped,
      | $mapped->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed(), $conv));
}

// `$lambda->eval(args...)` — invoke a Pure lambda. The lambda was translated
// via translateLambdaValue into a Java lambda expression; cast it to the
// arity-matched functional interface (Supplier/Function/BiFunction) and
// dispatch through `.get()`/`.apply(...)`. Arities > 2 are uncommon in PCT
// and fall through with a clear diagnostic — Java doesn't ship a built-in
// TriFunction so each would need its own ad-hoc interface.
function <<access.private>> platform::extensions::language::java::translation::evalCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'evalCoder expects at least 1 argument (the lambda)');
   let lambdaArg = $fe.parametersValues->at(0);
   let argVals   = $fe.parametersValues->slice(1, $fe.parametersValues->size());
   // β-reduction fast path. Pure compiles `someFn_Number_1__Float_1_->eval(x)`
   // by η-expanding the function reference into a lambda `(a -> someFn($a))`.
   // The default cast-to-Function path then emits
   // {@code ((Function<Object,Object>)(Number a) -> Math.someFn(a.doubleValue())).apply(x)}
   // which javac rejects because Function is invariant and `(Number a) -> ...`
   // doesn't satisfy `Function<Object, Object>`. By β-reducing — substituting
   // the eval args for the lambda's parameter references — we collapse to
   // {@code Math.someFn(((Number) x).doubleValue())} and let the inner
   // coder generate idiomatic Java. Works for any function with a coder
   // (cbrt, sqrt, sin, cos, log, ...) AND for UDF refs (helper-class call).
   // `evaluate` wraps each argument in a Pure List, so its arguments cannot be
   // substituted into the callee: only `eval` gets the inlining fast path.
   let inlined = if ($fe->coderName() == 'evaluate', | []->cast(@Code), | $conv->tryInlineLambdaAtomicValue($lambdaArg, $argVals));
   // fitToType, not a cast: what a called function returns is a single value or
   // a list at run time, whatever the call's multiplicity says.
   let type = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed();
   // The call is built inside the arms: `let` is eager, and the fallback
   // refuses arities the inlining fast path handles happily.
   if ($inlined->isNotEmpty(),
      | $inlined->toOne()->fitToType($type, $conv),
   |if ($fe->coderName() == 'evaluate' && $conv.metadataElements,
      | $conv->evaluateCoder($lambdaArg, $argVals)->fitToType($type, $conv),
      | $conv->evalCoderFallback($lambdaArg, $argVals)->fitToType($type, $conv)
   ));
}

// `evaluate(f, [^List(values=a), ^List(values=b)])` — the arity is the size of
// that ONE collection, not the number of arguments the expression has, so the
// platform is handed the collection and unwraps it (a no-argument call is an
// empty collection, which `eval`'s by-argument path would read as one argument).
function <<access.private>> platform::extensions::language::java::translation::evaluateCoder(
   conv: Conventions[1],
   lambdaArg: ValueSpecification[1],
   argVals: ValueSpecification[*]
): Code[1]
{
   let lambdaCode = $conv->translateExpression($lambdaArg)->typedFunctionValue();
   let argsCode   = if ($argVals->isEmpty(),
                       | j_null(),
                       | $conv->translateExpression($argVals->toOne())->toObjectCode());
   j_invoke(javaClass($conv->pdbClass('Metadata')), 'evaluate',
            [$lambdaCode, $argsCode], javaObject());
}

// Original evalCoder path — cast the lambda to Supplier / Function /
// BiFunction by arity and invoke .get / .apply. Used when β-reduction
// can't apply (non-literal lambda, multi-statement body, arity mismatch).
function <<access.private>> platform::extensions::language::java::translation::evalCoderFallback(
   conv: Conventions[1],
   lambdaArg: ValueSpecification[1],
   argVals: ValueSpecification[*]
): Code[1]
{
   let lambdaCode = $conv->translateExpression($lambdaArg);
   let evalArgs   = $argVals->map(p | $conv->translateExpression($p));
   // On the platform the callee may be a function of the metadata (a test the
   // runner discovered), which is called through its translated class.
   if ($conv.metadataElements,
      | j_invoke(javaClass($conv->pdbClass('Metadata')), 'invoke',
                 [$lambdaCode->typedFunctionValue(),
                  j_invoke(javaArrays(), 'asList', $evalArgs->map(a | $a->typedFunctionValue()), javaList())], javaObject()),
   |if ($evalArgs->isEmpty(),
       | $lambdaCode->j_cast(javaSupplier(javaObject()))->j_invoke('get', [], javaObject()),
       |if ($evalArgs->size() == 1,
            | $lambdaCode->j_cast(javaFunction(javaObject(), javaObject()))->j_invoke('apply', $evalArgs, javaObject()),
            |if ($evalArgs->size() == 2,
                 | $lambdaCode->j_cast(javaBiFunction(javaObject(), javaObject(), javaObject()))->j_invoke('apply', $evalArgs, javaObject()),
            |if ($evalArgs->size() == 3,
                 | $lambdaCode->j_cast(javaClass(platform::extensions::language::java::translation::pureFunction3Class()))->j_invoke('apply', $evalArgs, javaObject()),
                 | fail('evalCoder: arities > 3 not yet supported, got ' + $evalArgs->size()->toString()); j_null();
             ))
        )
   ));
}

// β-reduction fast path. If `lambdaArg` is an {@link AtomicValue} wrapping a
// {@link LambdaFunction} with N parameters that match N eval args, substitute
// each {@code VariableExpression($paramName)} in the lambda body with the
// corresponding eval arg and translate the substituted body directly. Returns
// empty if the shape doesn't match.
function <<access.private>> platform::extensions::language::java::translation::tryInlineLambdaAtomicValue(
   conv: Conventions[1],
   lambdaArg: ValueSpecification[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if (!$lambdaArg->instanceOf(AtomicValue),
      | []->cast(@Code),
      | $conv->tryInlineLambdaFromAV($lambdaArg->cast(@AtomicValue), $evalArgs)
   );
}

function <<access.private>> platform::extensions::language::java::translation::tryInlineLambdaFromAV(
   conv: Conventions[1],
   av: AtomicValue[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if ($av.value->isEmpty(),
      | []->cast(@Code),
      | $conv->tryInlineFuncValue($av.value->toOne(), $evalArgs)
   );
}

// Dispatch on the AV's wrapped value: literal LambdaFunction → β-reduce
// via parameter substitution. {@link PackageableFunction} reference (e.g.
// {@code tan_Number_1__Float_1_}) → synthesise a {@link FunctionExpression}
// with the function's short name and route through the coder map. Other
// values: skip (evalCoder falls back to its Function-cast path).
function <<access.private>> platform::extensions::language::java::translation::tryInlineFuncValue(
   conv: Conventions[1],
   v: Any[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if ($v->instanceOf(LambdaFunction),
      | $conv->tryInlineLambda($v->cast(@LambdaFunction<Any>), $evalArgs),
      | if ($v->instanceOf(platform::pure::metamodel::function::PackageableFunction),
           | $conv->tryInlinePackageableFunction($v->cast(@platform::pure::metamodel::function::PackageableFunction<Any>), $evalArgs),
           | []->cast(@Code)
        )
   );
}

// A function passed by name (`contains($x, myComparator_A_1__A_1__Boolean_1_)`)
// as a Java lambda that calls it: `(var a0_pureArg, ...) -> { A a0 = (A) a0_pureArg;
// ...; return fn(a0, ...); }`, the call translated like one written in the body.
function <<access.private>> platform::extensions::language::java::translation::translateFunctionReference(conv: Conventions[1], fn: platform::pure::metamodel::function::PackageableFunction<Any>[1]): Code[1]
{
   let fnType = $fn.classifierGenericType.typeArguments->at(0)->rawType()->toOne()->cast(@platform::pure::metamodel::type::FunctionType);
   let vars   = range($fnType.parameters->size())->map(i |
      ^platform::pure::metamodel::valuespecification::VariableExpression(
         name = 'pureFnA' + $i->toString(),
         genericType = $fnType.parameters->at($i).genericType,
         multiplicity = $fnType.parameters->at($i).multiplicity));
   let call   = $conv->tryInlinePackageableFunction($fn, $vars);
   assert($call->isNotEmpty(), | 'translateFunctionReference: no coder or helper for ' + $fn.functionName->toOne());
   let lambda = j_lambda($vars->map(v | j_parameter(javaTypeVar('var'), $v.name + '_pureArg')),
                         j_block($vars->map(v | $conv->rebindLambdaParameter($v))->concatenate(j_return($call->toOne()))));
   $conv->withElementIdentity($lambda, $fn, $vars->size());
}

// A function reference IS the element it names, as well as something to call:
// `assertIs(toString_Any_1__String_1_, pathToElement('...'))` compares the two.
// The wrapper keeps the lambda's Java type, so it still fits where a functional
// interface is expected; an arity the platform cannot call stays a plain lambda.
function <<access.private>> platform::extensions::language::java::translation::withElementIdentity(conv: Conventions[1], code: Code[1], fn: platform::pure::metamodel::function::PackageableFunction<Any>[1], arity: Integer[1]): Code[1]
{
   let type = if ($arity == 0, | [javaClass('java.util.function.Supplier')],
              |if ($arity == 1, | [javaClass('java.util.function.Function')],
              |if ($arity == 2, | [javaClass('java.util.function.BiFunction')],
                                | []->cast(@platform::extensions::language::java::metamodel::Type))));
   if (!$conv.metadataElements || $type->isEmpty(),
      | $code,
      | j_invoke(javaClass($conv->pdbClass('PureLambda')), 'ofElement',
                 [$code->j_castWithoutChecks($type->toOne()), j_string($fn->elementToPath())], javaObject())
           ->j_castWithoutChecks($type->toOne()));
}

// Function reference: build a synthetic {@code FunctionExpression(functionName=...,
// parametersValues=[args])} and translate via the coder map. Mirrors what
// would have been emitted if the user had written `fn(args)` directly.
// Returns empty when no coder OR no UDF helper-class match — caller
// falls back to the typed-lambda cast path which usually fails javac.
function <<access.private>> platform::extensions::language::java::translation::tryInlinePackageableFunction(
   conv: Conventions[1],
   fn: platform::pure::metamodel::function::PackageableFunction<Any>[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let shortName = $fn.functionName->toOne();
   // Synthetic FE genericType is required but inconsequential for translation
   // (coders read it for type-aware emit but eval-routed natives don't need
   // it). Use an empty {@code CompilerNotSetGenericType} placeholder.
   let synthetic = ^platform::pure::metamodel::valuespecification::FunctionInvocation(
      functionName     = $shortName,
      parametersValues = $evalArgs,
      func             = $fn,
      multiplicity     = platform::pure::metamodel::multiplicity::PureOne,
      genericType      = ^platform::pure::metamodel::type::generics::CompilerNotSetGenericType()
   );
   // Route through the coder map when present; otherwise check UDF helper
   // class dispatch (translateUdfCall handles UserDefinedFunction targets).
   let coderOpt = $conv->coderFor($fn, $shortName);
   if ($coderOpt->isNotEmpty(),
      | [$coderOpt->toOne()->eval($synthetic, $conv)],
      | if ($fn->instanceOf(platform::pure::metamodel::function::UserDefinedFunction),
           | [$conv->translateUdfCall($synthetic)],
           | []->cast(@Code)
        )
   );
}

function <<access.private>> platform::extensions::language::java::translation::tryInlineLambda(
   conv: Conventions[1],
   lambda: LambdaFunction<Any>[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let params = $lambda.parameters;
   let body   = $lambda.expressionSequence;
   // Match arity AND single-expression body — multi-statement bodies need
   // a Block wrapper which doesn't fit cleanly into expression position.
   if ($params->size() != $evalArgs->size() || $body->size() != 1,
      | []->cast(@Code),
      | $conv->inlineLambdaBody($params, $body->at(0), $evalArgs)
   );
}

function <<access.private>> platform::extensions::language::java::translation::inlineLambdaBody(
   conv: Conventions[1],
   params: platform::pure::metamodel::valuespecification::VariableExpression[*],
   body: ValueSpecification[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let subs = range(0, $params->size())->map(i |
      ^platform::extensions::pure::translation::canonical::ParamSub(name = $params->at($i).name, value = $evalArgs->at($i))
   );
   let substituted = $body->platform::extensions::pure::translation::canonical::substituteVariables($subs);
   [$conv->translateExpression($substituted)];
}

// `format(fmt, args)` -> `String.format(fmt, args.toArray())`. Pure's format
// strings (`%s`, `%d`, etc.) share syntax with java.util.Formatter, so we
// can pass the format string through unchanged. List.toArray() returns
// Object[] which satisfies String.format's varargs.
function <<access.private>> platform::extensions::language::java::translation::formatCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'formatCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   // Pure's printf dialect isn't Java's (%r, %t{pattern}, Pure toString of each
   // value), so it runs in the generated PureFormat class.
   let fmt  = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString());
   let args = $conv->translateExpression($fe.parametersValues->at(1))->toObjectCode();
   j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureFormat')), 'format', [$fmt, $args], javaString());
}

// `print(x)` — Pure writes the formatted representation of x to stdout and returns it.
function <<access.private>> platform::extensions::language::java::translation::printCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n == 1 || $n == 2, | 'printCoder expects 1 or 2 arguments, got ' + $n->toString());
   // print(value) and print(value, maxChars): written and returned (PureStrings.print); maxChars is ignored.
   $conv->runtimeCall('PureStrings', 'print', [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaString());
}

// `coll->sort()` — natural-order sort. Stream.sorted() on natural order
// requires the elements implement Comparable; PCT tests typically sort
// Number/String collections so this is fine. The 2-arg form (custom
// comparator) is more involved and currently fails through to the
// arity assert.
function <<access.private>> platform::extensions::language::java::translation::sortCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n >= 1 && $n <= 3, | 'sortCoder expects 1, 2, or 3 arguments, got ' + $n->toString());
   // Raw list, so the raw toList() fits whatever list type the caller declares
   // (a mixed literal infers List<Number & Comparable<...>>, not List<Number>).
   let stream = $conv->translateAsList($fe.parametersValues->at(0))
                  ->j_invoke('stream', [], javaStream(javaObject()));
   // Natural order compares mixed numbers by value (see PureCollections.naturalOrder).
   let naturalOrder = $conv->runtimeCall('PureCollections', 'naturalOrder', [], javaClass('java.util.Comparator'));
   let sorted = if ($n == 1,
      | $stream->j_invoke('sorted', [$naturalOrder], javaStream(javaObject())),
      | $conv->sortStreamWithArgs($stream, $fe.parametersValues)
   );
   $sorted->j_invoke('toList', [], javaList(javaObject()));
}

// Apply the comparator/key-extractor args to a stream. 2-arg form: cast the
// 2nd arg to {@code Comparator} and hand to {@code Stream.sorted}. 3-arg
// form (key + comparator): compose via {@code Comparator.comparing(key, comp)}.
function <<access.private>> platform::extensions::language::java::translation::sortStreamWithArgs(conv: Conventions[1], stream: Code[1], args: ValueSpecification[*]): Code[1]
{
   let cmpClass = javaClass('java.util.Comparator');
   let fnClass  = javaClass('java.util.function.Function');
   // Raw casts for Function / Comparator targets — the factory's lambda-cast
   // path only whitelists Function/Supplier and trips its assert on
   // Comparator; for Function it inserts a body rewrite that's overly strict
   // for typed Pure lambdas like {@code {String s -> s}}.
   let cmp = if ($args->size() == 2,
      | $conv->pureComparator($args->at(1)),
      | j_invoke($cmpClass, 'comparing',
           [$conv->translateExpression($args->at(1))->j_castWithoutChecks($fnClass),
            $conv->pureComparator($args->at(2))],
           $cmpClass)
   );
   $stream->j_invoke('sorted', [$cmp], javaStream(javaObject()));
}

// A Pure predicate value as a java.util.function.Predicate. Casting works for a
// lambda literal, but a lambda already created as a Function — a let-bound
// `func` — throws ClassCastException when cast to Predicate at runtime, so
// adapt through Function.apply in both cases.
function <<access.private>> platform::extensions::language::java::translation::asPredicate(fn: Code[1]): Code[1]
{
   // A method reference, not a lambda: a lambda's parameter name would clash
   // with the same wrapper in a nested exists/filter (javac rejects a lambda
   // parameter shadowing an enclosing one).
   j_methodReference($fn->j_castWithoutChecks(javaFunction(javaObject(), javaClass('java.lang.Boolean'))), 'apply', javaFunctionType([javaObject()], javaBoolean()))
      ->j_castWithoutChecks(javaClass('java.util.function.Predicate'));
}

// A Pure comparison function `{a, b | ...}` as a java.util.Comparator. Pure's
// result is an Integer (a long here) but Comparator.compare must return int,
// so a direct cast fails javac with "bad return type in lambda expression";
// the translated function is called as a BiFunction and folded to -1 / 0 / 1.
function <<access.private>> platform::extensions::language::java::translation::pureComparator(conv: Conventions[1], fn: ValueSpecification[1]): Code[1]
{
   let biFn = $conv->translateExpression($fn)->j_castWithoutChecks(javaClass('java.util.function.BiFunction'));
   let result = $biFn->j_invoke('apply', [j_variable(javaObject(), 'pureCmpA'), j_variable(javaObject(), 'pureCmpB')], javaObject());
   j_lambda(
      [j_parameter(javaTypeVar('var'), 'pureCmpA'), j_parameter(javaTypeVar('var'), 'pureCmpB')],
      j_invoke(javaClass('java.lang.Long'), 'signum', [$result->j_cast(javaNumber())->j_invoke('longValue', [], javaLong())], javaInt())
   )->j_castWithoutChecks(javaClass('java.util.Comparator'));
}

// `if(cond, |thenLambda, |elseLambda)` — Pure's lazy conditional. Pure
// represents the branches as zero-arg thunks so only one is evaluated.
// We emit a Java ternary `cond ? thenBody : elseBody` and inline the
// lambda bodies when they're literal thunks (the common case) so the
// emitted Java stays compact. If a branch is a non-literal expression
// yielding a Function (rare), we fall back to `((Supplier) f).get()`.
function <<access.private>> platform::extensions::language::java::translation::ifCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2 || $fe.parametersValues->size() == 3, | 'ifCoder expects 2 or 3 arguments, got ' + $fe.parametersValues->size()->toString());
   if ($fe.parametersValues->size() == 2, | $conv->multiIf($fe), | $conv->simpleIf($fe));
}

// `if([pair(|c1, |v1), pair(|c2, |v2)], |else)` — the first pair whose condition
// holds gives the value: `c1 ? v1 : c2 ? v2 : else`.
function <<access.private>> platform::extensions::language::java::translation::multiIf(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let pairsVS = $fe.parametersValues->at(0);
   let pairs   = if ($pairsVS->instanceOf(Collection), | $pairsVS->cast(@Collection).values, | $pairsVS)->filter(v | $v->instanceOf(FunctionExpression))->cast(@FunctionExpression);
   assert($pairs->forAll(p | $p.functionName == 'pair' && $p.parametersValues->size() == 2), | 'ifCoder: the conditions of a multi-if must be written as pair(|condition, |value)');
   let n = $pairs->size();
   range(0, $n)->fold({i, acc |
      let pr = $pairs->at($n - 1 - $i);
      $conv->typedConditional($fe, $conv->thunkArgToBody($pr.parametersValues->at(0))->j_castWithoutChecks(javaClass('java.lang.Boolean'))->j_cast(javaBoolean()), $conv->thunkArgToBody($pr.parametersValues->at(1)), $acc);
   }, $conv->thunkArgToBody($fe.parametersValues->at(1)));
}

function <<access.private>> platform::extensions::language::java::translation::simpleIf(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let cond = $conv->translateExpression($fe.parametersValues->at(0));
   let thenBody = $conv->thunkArgToBody($fe.parametersValues->at(1));
   let elseBody = $conv->thunkArgToBody($fe.parametersValues->at(2));
   $conv->typedConditional($fe, $cond, $thenBody, $elseBody);
}

// `test ? then : else`. When the branches' Java types differ in more than
// boxing (a raw `List` and a `List<Long>`, say), the factory can't infer the
// conditional's type: both branches are then cast to the Java type of the
// `if` call's own Pure type, which is passed explicitly.
function <<access.private>> platform::extensions::language::java::translation::typedConditional(conv: Conventions[1], fe: FunctionExpression[1], test: Code[1], then: Code[1], else: Code[1]): Code[1]
{
   // A `null` branch doesn't make it inferable: `c ? null : (Object) x` is an
   // Object where the conditional may need to be a BiFunction.
   let inferable = $then.type == $else.type;
   // A branch that is a collection makes the conditional one: `if(c, | [], | [$n])`
   // is typed String by its element type, but both branches are lists.
   let listBranch = $then.type->platform::extensions::language::java::serialization::typeToString()->startsWith('java.util.List')
                    || $else.type->platform::extensions::language::java::serialization::typeToString()->startsWith('java.util.List');
   let many = !$fe->resolvedMultiplicity()->isSingleValued() || $listBranch;
   let type = if ($many, | javaList(), | $conv->pureTypeToJavaType($fe.genericType, $fe->resolvedMultiplicity())->toBoxed());
   let conditional = if ($inferable,
      | j_conditional($test, $then, $else),
      | j_conditional($test, $then->conditionalBranch($type, $many, $conv), $else->conditionalBranch($type, $many, $conv), $type));
   // A list branch makes the whole conditional a list, even where Pure says the
   // `if` yields one value (`if($c, | $x, | [])`): take that value back out, so
   // an empty branch reads as no value rather than as an empty list the caller
   // would try to cast.
   if ($many && $fe->resolvedMultiplicity()->isSingleValued(),
      | $conditional->singleValueOfAny($conv),
      | $conditional);
}

// One branch of {@link typedConditional}, fitted to the conditional's type:
// - many-valued: a List stays one (cast raw — `List<String>` isn't a
//   `List<Object>`), a single value becomes a list;
// - single-valued: `[]` is null, a list its only value (or null: an empty
//   `[]->cast(@T)`), a primitive is left for Java to box (a cast would turn
//   `-1L` into a subtraction: `(Long) -1L`), anything else is cast.
function <<access.private>> platform::extensions::language::java::translation::conditionalBranch(code: Code[1], type: platform::extensions::language::java::metamodel::Type[1], many: Boolean[1], conv: Conventions[1]): Code[1]
{
   let isList       = $code.type->platform::extensions::language::java::serialization::typeToString()->startsWith('java.util.List');
   let isEmptyList  = $code->instanceOf(platform::extensions::language::java::metamodel::StaticMethodCall)
                      && $code->cast(@platform::extensions::language::java::metamodel::StaticMethodCall).methodName == 'emptyList';
   if ($many && $isList, | $code->j_castWithoutChecks(javaList()),
   |if ($many,           | $conv->runtimeCall('PureValues', 'list', [$code->toObjectCode()], javaList()),
   |if ($isEmptyList,    | j_null(),
   |if ($isList,         | $code->singleValueOf($conv)->j_castWithoutChecks($type),
   |if ($code.type->platform::extensions::language::java::metamodel::isJavaPrimitive(), | $code,
                         | $code->j_castWithoutChecks($type))))));
}

// The only value of an expression that may be a list at run time (a multiplicity
// parameter), or the value itself.
function <<access.private>> platform::extensions::language::java::translation::singleValueOfAny(code: Code[1], conv: Conventions[1]): Code[1]
{
   j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureValues')), 'one', [$code->toObjectCode()], javaObject());
}

// A list-typed expression where one value is expected: its only value, or null
// (`$x->head()->map(c | ...)` is [0..1] but translates to a list).
function <<access.private>> platform::extensions::language::java::translation::singleValueOf(code: Code[1], conv: Conventions[1]): Code[1]
{
   $code->singleValueOfAny($conv);
}

// `code` fitted to `type`: a list where a single value is expected becomes its
// only value; anything else is left as it is (casts are the callers').
function <<access.private>> platform::extensions::language::java::translation::fitToType(code: Code[1], type: platform::extensions::language::java::metamodel::Type[1], conv: Conventions[1]): Code[1]
{
   let isList     = $code.type->platform::extensions::language::java::serialization::typeToString()->startsWith('java.util.List');
   let wantsList  = $type->platform::extensions::language::java::serialization::typeToString()->startsWith('java.util.List');
   // Otherwise a value typed more loosely than the declaration (an `if` whose
   // branches are Supplier IIFEs is an Object) is cast to it. Primitives are
   // left alone: `(Long) -1L` parses as a subtraction.
   let looser     = $code.type != $type
                    && !$code.type->platform::extensions::language::java::metamodel::isJavaPrimitive()
                    && !$type->platform::extensions::language::java::metamodel::isJavaPrimitive();
   if ($isList && !$wantsList, | $code->singleValueOf($conv)->j_castWithoutChecks($type->toBoxed()),
   // A value where a collection is expected becomes one at run time: it may be
   // a single value (what a compiled method returned, say), not a List.
   |if (!$isList && $wantsList,
      | j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureValues')), 'list', [$code->toObjectCode()], javaList()),
   // Two list types: through the raw List, since Java generics are invariant
   // (a List<CO_FirmImpl> is not a List<CO_Firm>, and neither casts to the other).
   |if ($isList && $wantsList && $code.type != $type, | $code->j_castWithoutChecks(javaList()),
   // An Object where one value is expected may hold a list at run time (a
   // function whose own return type is a type parameter): take its only value.
   |if ($looser && $code.type == javaObject(), | $code->singleValueOfAny($conv)->j_castWithoutChecks($type),
   |if ($looser,               | $code->j_castWithoutChecks($type),
                               | $code)))));
}

function <<access.private>> platform::extensions::language::java::translation::thunkArgToBody(conv: Conventions[1], vs: ValueSpecification[1]): Code[1]
{
   if ($vs->instanceOf(AtomicValue),
      | let val = $vs->cast(@AtomicValue).value;
        if ($val->size() == 1 && $val->toOne()->instanceOf(LambdaFunction),
           | let lambda = $val->toOne()->cast(@LambdaFunction<Any>);
             let exprs = $lambda.expressionSequence;
             // Several expressions (`| let x = ...; $x + 1`) are statements, which
             // a conditional branch can't hold: run them as a Supplier.
             if ($exprs->size() == 1,
                | $conv->translateExpression($exprs->toOne()),
                | j_lambda([], j_block($conv->buildJavaBody($exprs->toOneMany())))
                     ->j_castWithoutChecks(javaSupplier(javaObject()))
                     ->j_invoke('get', [], javaObject())
             );,
           | // Non-lambda atomic value — translate and treat as Supplier.
             $conv->translateExpression($vs)->j_cast(javaSupplier(javaObject()))->j_invoke('get', [], javaObject())
        );,
      | $conv->translateExpression($vs)->j_cast(javaSupplier(javaObject()))->j_invoke('get', [], javaObject())
   );
}

// `isEmpty(x)` — Pure's `[0..1]` "is the value empty?" check. Multi-valued
// args route through Collection.isEmpty; scalar nullable args route through
// `x == null`. The dispatch uses the arg's compile-time multiplicity.
function <<access.private>> platform::extensions::language::java::translation::isEmptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'isEmptyCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   // translateAsList covers every representation: a List, a null standing for
   // an empty collection, and a lone value (never empty).
   $conv->translateAsList($fe.parametersValues->at(0))->j_invoke('isEmpty', [], javaBoolean());
}

// `size(coll)` — Pure's size returns Integer (Java long); Collection.size
// returns int, so cast the result. Multi-valued only; scalar args have
// size = 1 conceptually but Pure rarely calls size on scalars.
function <<access.private>> platform::extensions::language::java::translation::sizeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'sizeCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   j_cast($coll->j_cast(javaClass('java.util.Collection'))->j_invoke('size', [], javaInt()), javaLong());
}

// `length(str)` — String.length() returns int; Pure's length returns
// Integer (Java long), so cast.
function <<access.private>> platform::extensions::language::java::translation::lengthCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'lengthCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let s = $conv->translateExpression($fe.parametersValues->at(0));
   j_cast($s->j_cast(javaString())->j_invoke('length', [], javaInt()), javaLong());
}

// `isNotEmpty(x)` — inverse of {@link isEmptyCoder}. Multi-value -> Collection.isEmpty
// negated; scalar [0..1] -> non-null check. The two shapes don't collapse to
// `size > 0` because the scalar branch must avoid casting to Collection.
function <<access.private>> platform::extensions::language::java::translation::isNotEmptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'isNotEmptyCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   // See {@link isEmptyCoder}.
   j_not($conv->translateAsList($fe.parametersValues->at(0))->j_invoke('isEmpty', [], javaBoolean()));
}

// `empty()` (0-arg) — returns Pure's empty collection. Java equivalent is
// {@code java.util.Collections.emptyList()}.
function <<access.private>> platform::extensions::language::java::translation::emptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->isEmpty(), | 'emptyCoder expects 0 arguments, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaCollections(), 'emptyList', [], javaList(javaObject()));
}

// `head(coll)` — Pure: first element (or empty if list is empty). Java:
// {@code coll.isEmpty() ? null : coll.get(0)}. Cast through Collection→List
// so the index-based accessor is available; Pure callers receive {@code [0..1]}.
function <<access.private>> platform::extensions::language::java::translation::headCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'headCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   // The element is cast to the expression's boxed type: from a raw List,
   // get() is Object, and `cond ? null : x` must not force null into a primitive.
   let elemType = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed();
   let list     = j_variable(javaList(), 'pureIifeIn');
   valueIife(
      $conv->translateAsList($fe.parametersValues->at(0)),
      javaList(),
      $elemType,
      [j_return(j_conditional(
         $list->j_invoke('isEmpty', [], javaBoolean()),
         j_null(),
         $list->j_invoke('get', [j_int(0)], javaObject())->j_cast($elemType)))]);
}

// `last(coll)` — mirror of {@link headCoder} from the other end. Empty list
// returns empty (null); otherwise {@code coll.get(coll.size() - 1)}.
function <<access.private>> platform::extensions::language::java::translation::lastCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'lastCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   // Same shape as {@link headCoder}.
   let elemType = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed();
   let list     = j_variable(javaList(), 'pureIifeIn');
   valueIife(
      $conv->translateAsList($fe.parametersValues->at(0)),
      javaList(),
      $elemType,
      [j_return(j_conditional(
         $list->j_invoke('isEmpty', [], javaBoolean()),
         j_null(),
         $list->j_invoke('get', [j_minus($list->j_invoke('size', [], javaInt()), j_int(1))], javaObject())->j_cast($elemType)))]);
}

// `tail(coll)` — everything except the first element. Empty stays empty.
// Wraps the {@code subList} view in a fresh ArrayList because Pure-side
// equality unwraps standard collections but doesn't recognise AbstractList
// SubList views, so {@code assertEquals(expected, tail([a,b,c]))} would
// report a spurious mismatch on visually-identical lists. Uses RAW
// {@code ArrayList} (not {@code ArrayList<Object>}) so the conditional
// flows into a method whose inferred return type is e.g. {@code List<String>}
// without triggering Java's invariant-generics check.
function <<access.private>> platform::extensions::language::java::translation::tailCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'tailCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   $conv->runtimeCall('PureCollections', 'tail', [$conv->translateAsList($fe.parametersValues->at(0))], javaList());
}

// `init(coll)` — everything except the last element. Same SubList→ArrayList
// wrap (and raw-type rationale) as {@link tailCoder}.
function <<access.private>> platform::extensions::language::java::translation::initCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'initCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   $conv->runtimeCall('PureCollections', 'init', [$conv->translateAsList($fe.parametersValues->at(0))], javaList());
}

// `reverse(coll)` — Pure: returns a fresh reversed list. {@code Collections.reverse}
// mutates in place, so we wrap in a copy first via {@code new ArrayList<>(coll)}.
// Pass the raw listCode (no Collection cast) into the ArrayList ctor; Java's
// {@code <? extends T>} ArrayList(Collection) overload accepts any List
// directly. Casting to {@code Collection<Object>} would flip the variance
// rules and fail to compile.
function <<access.private>> platform::extensions::language::java::translation::reverseCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'reverseCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let listCode = $conv->translateExpression($fe.parametersValues->at(0));
   // Raw ArrayList / raw List throughout the Supplier IIFE — same rationale
   // as {@link tailCoder}'s raw-type choice: the result threads into method
   // signatures whose return type is e.g. {@code List<String>}, which raw
   // List flows into without an invariant-generics rejection.
   let rawList = javaList();
   let copy = j_new(javaArrayList(), [$listCode]);
   let reverseCall = j_invoke(javaCollections(), 'reverse', [j_variable($rawList, 'list')], javaVoid());
   let supplierBody = j_block([
      j_declare($rawList, 'list', $copy),
      j_expressionStatement($reverseCall),
      j_return(j_variable($rawList, 'list'))
   ]);
   j_lambda([], $supplierBody)
      ->j_cast(javaSupplier($rawList))
      ->j_invoke('get', [], $rawList);
}

