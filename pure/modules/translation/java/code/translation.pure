// long. Both Pure overloads (string-in-string and value-in-collection)
// share the Java method name.
function <<access.private>> meta::external::language::java::translation::indexOfCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2 || $fe.parametersValues->size() == 3, | 'indexOfCoder expects 2 or 3 arguments, got ' + $fe.parametersValues->size()->toString());
   let receiver = $conv->translateExpression($fe.parametersValues->at(0));
   let val      = $conv->translateExpression($fe.parametersValues->at(1));
   let from     = $fe.parametersValues->slice(2, 3)->map(v | $conv->translateExpression($v)->j_cast(javaLong())->j_cast(javaInt()));
   j_cast($receiver->j_invoke('indexOf', $val->concatenate($from), javaInt()), javaLong());
}

function <<access.private>> meta::external::language::java::translation::parseBooleanCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'parseBooleanCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaClass('java.lang.Boolean'), 'parseBoolean', [$conv->translateExpression($fe.parametersValues->at(0))], javaBoolean());
}

// `parseDecimal(s)` and `parseDecimal(s, precision, scale)` — a BigDecimal,
// the 3-argument form rounded HALF_UP to `scale` digits.
function <<access.private>> meta::external::language::java::translation::parseDecimalCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1 || $fe.parametersValues->size() == 3, | 'parseDecimalCoder expects 1 or 3 arguments, got ' + $fe.parametersValues->size()->toString());
   // A trailing d / D (Pure's Decimal literal suffix) is accepted.
   let text   = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString())->j_invoke('trim', [], javaString())
                   ->j_invoke('replaceFirst', [j_string('[dD]$'), j_string('')], javaString());
   let parsed = j_new(javaBigDecimal(), [$text]);
   if ($fe.parametersValues->size() == 1,
      | $parsed,
      | $parsed->j_invoke('setScale', [
           $conv->translateExpression($fe.parametersValues->at(2))->j_cast(javaLong())->j_cast(javaInt()),
           j_field(javaClass('java.math.RoundingMode'), 'HALF_UP', javaClass('java.math.RoundingMode'))], javaBigDecimal()));
}

// `regexpLike(s, pattern)` — partial match. Two overloads; the 3-arg form
// adds optional regex parameters (case-sensitivity, multi-line, ...) that
// we ignore for now and still compile with default flags. Tests sensitive
// to the parameters will diverge.
function <<access.private>> meta::external::language::java::translation::regexpLikeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 2, | 'regexpLikeCoder expects at least 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let s     = $conv->translateExpression($fe.parametersValues->at(0));
   let pat   = $conv->translateExpression($fe.parametersValues->at(1));
   let flags = if ($fe.parametersValues->size() > 2, | $fe.parametersValues->at(2)->enumLiteralNames()->javaRegexFlags(), | 0);
   j_invoke(javaClass('java.util.regex.Pattern'), 'compile', [$pat, j_int($flags)], javaClass('java.util.regex.Pattern'))
      ->j_invoke('matcher', [$s], javaClass('java.util.regex.Matcher'))
      ->j_invoke('find', [], javaBoolean());
}

// Names of the enum literals in `vs`, read statically, in the shapes
// {@link extractChronoUnitRef} handles: an AtomicValue holding Enums, the
// `Enumeration.VALUE` access expression, or a Collection of either.
function <<access.private>> meta::external::language::java::translation::enumLiteralNames(vs: ValueSpecification[1]): String[*]
{
   $vs->match([
      a: AtomicValue[1] | $a.value->filter(v | $v->instanceOf(meta::pure::metamodel::type::Enum))->cast(@meta::pure::metamodel::type::Enum)->map(e | $e.name->toOne()),
      c: Collection[1]  | $c.values->map(v | $v->enumLiteralNames()),
      fe: FunctionExpression[1] | $fe.functionName,
      other: ValueSpecification[1] | []->cast(@String)
   ]);
}

// Pure RegexpParameter names -> java.util.regex.Pattern flag bits, matching
// the JS runtime's i / m / s: CASE_INSENSITIVE, MULTILINE, and
// NON_NEWLINE_SENSITIVE (`.` also matches a line terminator, i.e. DOTALL).
function <<access.private>> meta::external::language::java::translation::javaRegexFlags(names: String[*]): Integer[1]
{
   $names->removeDuplicates()
      ->map(n | if ($n == 'CASE_INSENSITIVE',      | 2,
               |if ($n == 'MULTILINE',             | 8,
               |if ($n == 'NON_NEWLINE_SENSITIVE', | 32,
                                                   | 0))))
      ->fold({flag, acc | $acc + $flag}, 0);
}

// Assertion coders — Pure's assert* natives THROW on failure. For
// PCT-via-translator we don't need real throws: the inner `$f->eval(|...)`
// is wrapped by an outer `assert(...)` in every PCT test, so returning
// the Boolean result of the check propagates the right signal (true =
// passed, false = outer assert fails the test).
function <<access.private>> meta::external::language::java::translation::assertEqualsCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 2, | 'assertEqualsCoder expects at least 2 arguments, got ' + $fe.parametersValues->size()->toString());
   $conv->pureAssertion($fe, true);
}

// assertEquals / assertIs (expectEqual) and assertIsNot: compare the two values
// as Pure's equality does — an absent value (null) is [], a one-element list its
// element — and fail when the outcome isn't the expected one; true otherwise.
function <<access.private>> meta::external::language::java::translation::pureAssertion(conv: Conventions[1], fe: FunctionExpression[1], expectEqual: Boolean[1]): Code[1]
{
   let a = $conv->translateExpression($fe.parametersValues->at(0))->toObjectCode();
   let b = $conv->translateExpression($fe.parametersValues->at(1))->toObjectCode();
   valueIife(j_invoke(javaArrays(), 'asList', [$a, $b], javaList()), javaList(), javaBooleanBoxed(), [
      j_code('Object[] pureAsV = pureIifeIn.toArray(); '
           + 'for (int pureAsI = 0; pureAsI < 2; pureAsI++) { '
           + 'if (pureAsV[pureAsI] == null) { pureAsV[pureAsI] = java.util.Collections.emptyList(); } '
           + 'else if (pureAsV[pureAsI] instanceof java.util.List && ((java.util.List<?>) pureAsV[pureAsI]).size() == 1) { pureAsV[pureAsI] = ((java.util.List<?>) pureAsV[pureAsI]).get(0); } } '
           + if ($expectEqual,
                // PureValues.equal, not Objects.equals: Pure has one zero, and
                // -0.0 must equal the literal 0.0 here as it does anywhere else.
                | 'if (!' + equalCall() + ') { throw new RuntimeException("\\nexpected: " + pureAsV[0] + "\\nactual:   " + pureAsV[1]); } ',
                | 'if (' + equalCall() + ') { throw new RuntimeException("Objects are the same: " + pureAsV[0]); } ')
           + 'return true;', javaVoid())
   ])->j_cast(javaBoolean());
}

function <<access.private>> meta::external::language::java::translation::assertFalseCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'assertFalseCoder expects at least 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_not($conv->translateExpression($fe.parametersValues->at(0))->asBooleanCode());
}

// `assertIsNot(a, b)` — Pure's negated identity check. Translate as
// `!Objects.equals(a, b)` since j_eq routes objects through Objects.equals.
function <<access.private>> meta::external::language::java::translation::assertIsNotCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 2, | 'assertIsNotCoder expects at least 2 arguments, got ' + $fe.parametersValues->size()->toString());
   $conv->pureAssertion($fe, false);
}

// `assert(cond[, message...])` — identity on the boolean condition. For
// PCT-via-translator the outer test runner catches the boolean signal;
// throw-on-false semantics aren't needed.
// Pure `assert(condition[, message])`: throws when the condition is false — a
// tryEval around it relies on that — and is true otherwise. The message may be
// a String or a `{-> String}` thunk (cast to Supplier: a bare lambda can't sit
// in List.of); a format string with arguments is reported unformatted.
function <<access.private>> meta::external::language::java::translation::assertCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n >= 1, | 'assertCoder expects at least 1 argument, got ' + $n->toString());
   let cond = $conv->translateExpression($fe.parametersValues->at(0));
   let msg  = if ($n == 1,                                         | j_string('Assert failed'),
              |if ($fe.parametersValues->at(1)->isLambdaLiteral(), | $conv->translateExpression($fe.parametersValues->at(1))->j_castWithoutChecks(javaClass('java.util.function.Supplier')),
                                                                   | $conv->translateExpression($fe.parametersValues->at(1))));
   valueIife(
      j_invoke(javaClass('java.util.List'), 'of', [$cond, $msg], javaList()),
      javaList(),
      javaBoolean(),
      [j_code('if (!(Boolean) pureIifeIn.get(0)) { '
         + 'Object pureAssertM = pureIifeIn.get(1); '
         + 'if (pureAssertM instanceof java.util.function.Supplier) { pureAssertM = ((java.util.function.Supplier) pureAssertM).get(); } '
         + 'throw new RuntimeException(String.valueOf(pureAssertM)); } '
         + 'return true;', javaVoid())]);
}

// `exists(coll, predicate)` — Stream.anyMatch with the translated predicate.
function <<access.private>> meta::external::language::java::translation::existsCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'existsCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   let pred = $conv->translateExpression($fe.parametersValues->at(1));
   $coll->j_invoke('stream',    [], javaStream(javaObject()))
        ->j_invoke('anyMatch',  [$pred->asPredicate()], javaBoolean());
}

// `assertEqWithinTolerance(expected, actual, tolerance)` — numeric closeness.
// Emit `Math.abs((double)actual - (double)expected) <= (double)tolerance`.
function <<access.private>> meta::external::language::java::translation::assertEqWithinToleranceCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 3, | 'assertEqWithinToleranceCoder expects at least 3 arguments, got ' + $fe.parametersValues->size()->toString());
   let expected  = $conv->translateExpression($fe.parametersValues->at(0));
   let actual    = $conv->translateExpression($fe.parametersValues->at(1));
   let tolerance = $conv->translateExpression($fe.parametersValues->at(2));
   // Both sides are compared as doubles: either may be Object-typed (a called
   // function's result), which has no `-`.
   let diff      = ^meta::external::language::java::metamodel::InfixExpression(
                      left  = $actual->asDoubleCode(),
                      op    = '-',
                      right = $expected->asDoubleCode(),
                      type  = javaDouble());
   let absDiff   = j_invoke(javaMath(), 'abs', [$diff], javaDouble());
   j_le($absDiff, $tolerance);
}

// `value->instanceOf(SomeType)` — Pure runtime type check. Two cases:
//   - User-defined Class: our runtime model is `Map` with a `__class__`
//     marker, so check `"Foo".equals(((Map)v).get("__class__"))`.
//   - Primitive (Integer/Number/Any/Date/etc.): box the value to Object
//     and use Java `instanceof BoxedType`. `Any` -> always-true since
//     anything in Pure is an Object in Java.
// The type arg must be a static literal type reference (the common case);
// dynamic type values aren't supported here.
function <<access.private>> meta::external::language::java::translation::instanceOfCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'instanceOfCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let value   = $conv->translateExpression($fe.parametersValues->at(0));
   let typeArg = $fe.parametersValues->at(1);
   // A type known only at run time (`$instance->instanceOf($type)`) is answered
   // from the metadata: the value's type, or one of its generalizations, is it.
   assert($typeArg->instanceOf(AtomicValue) || $conv.metadataElements, | 'instanceOfCoder: type arg must be a literal AtomicValue, got non-AtomicValue');
   if (!$typeArg->instanceOf(AtomicValue),
      | j_invoke(javaClass('org.finos.legend.pure.platform.java.pdb.Metadata'), 'instanceOf',
                 [$value->toObjectCode(), $conv->translateExpression($typeArg)->toObjectCode()], javaBoolean()),
      | $conv->literalInstanceOf($value, $typeArg->cast(@AtomicValue).value->toOne()));
}

// Any enum value, whatever enumeration it belongs to: a generated platform enum
// is marked with PureEnumValue, and one read from a PDB is a metamodel Enum.
function <<access.private>> meta::external::language::java::translation::enumValueInstanceOf(conv: Conventions[1], value: Code[1]): Code[1]
{
   j_or(j_instanceof($value->j_cast(javaObject()), javaClass('org.finos.legend.pure.platform.java.pdb.PureEnumValue')),
        j_instanceof($value->j_cast(javaObject()), javaClass(meta::pure::metamodel::type::Enum->meta::external::language::java::translation::platform::platformTypeName(meta::external::language::java::translation::platform::platformRoot()))));
}

function <<access.private>> meta::external::language::java::translation::literalInstanceOf(conv: Conventions[1], value: Code[1], tval: Any[1]): Code[1]
{
   // An enumeration is the generated Java enum; Any is anything present (it is
   // a Pure Class, and would otherwise emit a non-existent `instanceof Any`).
   if ($tval->instanceOf(meta::pure::metamodel::type::Enumeration),
      | j_instanceof($value->j_cast(javaObject()), $conv->javaEnumType($tval->cast(@meta::pure::metamodel::type::Enumeration<Any>))),
   // `Enum` is ANY enum value, whatever enumeration it belongs to: on the
   // platform that is what PureEnumValue marks (a generated enum implements it;
   // a value read from a PDB is the metamodel Enum itself).
   |if ($tval == meta::pure::metamodel::type::Enum,
      | $conv->enumValueInstanceOf($value),
   |if ($tval == Any,
      | j_ne($value->j_cast(javaObject()), j_null()),
   |if ($tval->instanceOf(meta::pure::metamodel::type::Class),
      | $conv->classInstanceOf($value, $tval->cast(@meta::pure::metamodel::PackageableElement)),
      | $conv->primitiveInstanceOf($value, $tval->cast(@meta::pure::metamodel::type::Type))
   ))));
}

// User-defined class check — our generated helper Java classes share the
// Pure class's short name in the conventions package, so a plain Java
// `instanceof GeneratedClass` works directly.
function <<access.private>> meta::external::language::java::translation::classInstanceOf(conv: Conventions[1], value: Code[1], cls: meta::pure::metamodel::PackageableElement[1]): Code[1]
{
   j_instanceof($value->j_cast(javaObject()), javaClass($cls->meta::external::language::java::translation::platform::platformTypeName(meta::external::language::java::translation::platform::platformRoot())));
}

// Primitive-side instanceOf: box the value to Object then use Java
// `instanceof BoxedType`. Pure's `Any` maps to Object, which everything in
// Java is — `instanceof Object` is always true.
function <<access.private>> meta::external::language::java::translation::primitiveInstanceOf(conv: Conventions[1], value: Code[1], raw: meta::pure::metamodel::type::Type[1]): Code[1]
{
   if ($raw->isDateOrTimeType() && $raw != meta::pure::metamodel::type::primitives::StrictTime,
      | // A PureDate's kind tells StrictDate from DateTime; any PureDate is a Date.
        let kind = if ($raw == meta::pure::metamodel::type::primitives::StrictDate, | 'StrictDate', |if ($raw == meta::pure::metamodel::type::primitives::DateTime, | 'DateTime', | 'Date'));
        j_invoke($conv->javaPureDateType(), 'is', [$value->toObjectCode(), j_string($kind)], javaBoolean());,
      | $conv->primitiveClassInstanceOf($value, $raw));
}

function <<access.private>> meta::external::language::java::translation::primitiveClassInstanceOf(conv: Conventions[1], value: Code[1], raw: meta::pure::metamodel::type::Type[1]): Code[1]
{
   let boxed = if ($raw == Integer, | javaClass('java.lang.Long'),
               |if ($raw == Float,   | javaClass('java.lang.Double'),
               |if ($raw == Boolean, | javaClass('java.lang.Boolean'),
               |if ($raw == String,  | javaClass('java.lang.String'),
               |if ($raw == Number,  | javaClass('java.lang.Number'),
               |if ($raw == Any,     | javaObject(),
               |if ($raw == Nil,     | javaObject(),
               |if ($raw == meta::pure::metamodel::type::primitives::Decimal, | javaBigDecimal(),
               |if ($raw->isDateOrTimeType(), | javaClass('java.time.LocalTime'),
                  | javaObject()
               )))))))));
   j_instanceof($value->j_cast(javaObject()), $boxed);
}

// `dateDiff(d1, d2, unit)` and `adjust(date, n, unit)` — PureDate.dateDiff /
// PureDate.adjust, the unit passed by its Pure DurationUnit name.
function <<access.private>> meta::external::language::java::translation::dateDiffCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'dateDiffCoder expects exactly 3 arguments (d1, d2, unit), got ' + $fe.parametersValues->size()->toString());
   let d1   = $conv->translateExpression($fe.parametersValues->at(0))->j_castWithoutChecks($conv->javaPureDateType());
   let d2   = $conv->translateExpression($fe.parametersValues->at(1))->j_castWithoutChecks($conv->javaPureDateType());
   j_invoke($conv->javaPureDateType(), 'dateDiff', [$d1, $d2, $conv->durationUnitName($fe.parametersValues->at(2))], javaLong());
}

function <<access.private>> meta::external::language::java::translation::adjustCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'adjustCoder expects exactly 3 arguments (date, n, unit), got ' + $fe.parametersValues->size()->toString());
   let date = $conv->translateExpression($fe.parametersValues->at(0))->j_castWithoutChecks($conv->javaPureDateType());
   let n    = $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaLong());
   j_invoke($conv->javaPureDateType(), 'adjust', [$date, $n, $conv->durationUnitName($fe.parametersValues->at(2))], $conv->javaPureDateType());
}

// Date extractors — the matching PureDate method, returning long as Pure's Integer.
function <<access.private>> meta::external::language::java::translation::yearCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'year', 'yearCoder');
}

function <<access.private>> meta::external::language::java::translation::monthNumberCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'monthNumber', 'monthNumberCoder');
