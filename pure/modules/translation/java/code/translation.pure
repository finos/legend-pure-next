// `regexpReplace(s, regex, repl)` and the 4-arg form with explicit
// replaceAll flag. Java's String.replaceAll/replaceFirst pick the right
// global-vs-first behaviour. Skip the 5-arg + RegexpParameter overloads;
// flag translation isn't trivial.
function <<access.private>> platform::extensions::language::java::translation::regexpReplaceCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n == 3 || $n == 4, | 'regexpReplaceCoder expects 3 or 4 arguments, got ' + $n->toString());
   let s    = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString());
   let r    = $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaString());
   let repl = $conv->translateExpression($fe.parametersValues->at(2))->j_cast(javaString());
   // 3-arg form defaults to replace-first (matches Pure's contract that
   // `replaceAll` is the trailing-Boolean form with `true`). When the 4-arg
   // form passes a literal Boolean, dispatch statically; otherwise emit a
   // runtime ternary.
