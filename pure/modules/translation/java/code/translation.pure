import platform::extensions::language::java::factory::*;
import platform::extensions::language::java::metamodel::*;
import platform::extensions::language::java::translation::*;
import platform::pure::metamodel::function::*;
import platform::pure::metamodel::type::*;
import platform::pure::metamodel::valuespecification::*;

// Ultra-minimal Pure -> Java translator. Models legend-engine's strategy:
//   - `Conventions` carries config + per-Pure-function coders
//   - `translateFunction` produces a `FunctionSignature` (owning Java class + method)
//   - `translateExpression` walks a Pure ValueSpecification, dispatching FunctionExpression
//     calls through the conventions' coder map.
// Only enough surface to translate `add(a, b) { $a + $b }` end-to-end.

Class platform::extensions::language::java::translation::Conventions
{
   basePackageName : String[1];
   // Root package of the HOST's support classes — the generated code calls into
   // `<platformPackage>.runtime.PureValues`, `<platformPackage>.pdb.Metadata`
   // and friends. Parameterised so a host other than the Java platform (Truffle,
   // which generates its own copy of the PDB reader) can own those classes
   // instead of depending on the Java platform's.
   platformPackage : String[1];
   // Where the host keeps the two groups of support class: the metadata hooks
   // generated code calls (`Metadata`, `LazyObject`, `PureLambda`, `PureNew`, ...)
   // and the runtime helpers the translator emits (`PureValues`, `PureDate`, ...).
   // `conventionsFor` defaults them to `<platformPackage>.pdb` and
   // `<platformPackage>.runtime`, which is the Java platform's own layout. A host
   // whose support surface is small enough to live in one package beside its only
   // consumer — Truffle, whose four hooks sit with the PDB reader that calls them —
   // sets both to that package.
   pdbPackage      : String[1];
   runtimePkg      : String[1];
   // Element literals (`NativeFunction`, `PureOne`) as the metamodel objects of
   // the Java platform's installed PDBs (Metadata.element), rather than their names.
   metadataElements : Boolean[1];
   // The function being translated, when its lambdas need an address into the
   // metadata (see lambdasInFunction).
   owner            : String[0..1];
   // The Pure variables bound at this point (parameters, enclosing lambdas'
   // parameters, lets already emitted): what a lambda here can capture.
   scope            : String[*];
   // Java names for Pure variables that had to be renamed: a lambda body may not
   // redeclare a local of the enclosing method, so a parameter shadowing one
   // already in `scope` is bound under a fresh name (see translateLambdaValue).
   renames          : Pair<String, String>[*];
   // The Java locals the enclosing method has declared. Java scopes a local from
   // its declarator on, so `let x = <lambda>` already binds `x` inside the
   // lambda — unlike `scope`, which follows Pure's binding order.
   javaLocals       : String[*];
   functionCoders  : Map<String, platform::pure::metamodel::function::Function<{FunctionExpression[1], Conventions[1] -> Code[1]}>>[1];
   // Which parameter of the function being translated witnesses each of its
   // type parameters: `castAsHint<T>(value:Any[1], hint:T[1])` casts to T, and
   // only the argument passed for `hint` says what T is. Read at the cast site.
   typeVarWitness  : Map<String, TypeVarWitness>[0..1];
}

// A function parameter that witnesses a type parameter, and the multiplicity
// parameter it binds at the same time (`witness:T[m]` binds both T and m).
Class platform::extensions::language::java::translation::TypeVarWitness
{
   parameter    : String[1];
   mulParameter : String[0..1];
}

Class platform::extensions::language::java::translation::FunctionSignature
{
   class       : platform::extensions::language::java::metamodel::Class[1];
   method      : platform::extensions::language::java::metamodel::Method[1];
   // Additional class definitions (as full Java source strings) to be
   // concatenated alongside the main class in the same compilation unit.
   // Populated by the `new` coder path: every Pure user-defined Class
   // referenced via `^X(props)` gets a generated nested-style Java class
   // with fluent `_propName(value)` setters and a `type()` accessor so
   // expressions like `^X(...).type()` reconstruct Pure's type-of behavior.
   extraClasses: platform::extensions::language::java::metamodel::Class[*];
   // Java platform types (interfaces, implementations, enums) of the Pure
   // classes and enumerations the program uses, each a `//// FILE <path>`
   // block: they are public types in their own packages, so separate units.
   files       : String[*];
}

// A body being built: the statements so far, and the conventions carrying the
// variables bound by them.
Class platform::extensions::language::java::translation::BodyScope
{
   conv  : platform::extensions::language::java::translation::Conventions[1];
   codes : platform::extensions::language::java::metamodel::Code[*];
}

// What a translated program needs besides its own class (see {@link supportClasses}).
Class platform::extensions::language::java::translation::SupportCode
{
   classes : platform::extensions::language::java::metamodel::Class[*];
   files   : String[*];
}

// ----------------------------------------------------------------------------
// Conventions construction — built-in arithmetic coders only for now.
// ----------------------------------------------------------------------------

// Sanitize a Pure identifier for use as a Java identifier. Pure allows names
// that are reserved keywords in Java (e.g. `default`, `class`, `int`, `for`)
// and tests like {@code orElse(value, default)} use them as parameter names.
// Suffix `_` so the emitted Java compiles; the user-facing name stays close
// enough to debug from.
function platform::extensions::language::java::translation::safeJavaName(name: String[1]): String[1]
{
   if (javaReservedWords()->contains($name), | $name + '_', | $name);
}

function <<access.private>> platform::extensions::language::java::translation::javaReservedWords(): String[*]
{
   ['abstract','assert','boolean','break','byte','case','catch','char','class','const',
    'continue','default','do','double','else','enum','extends','final','finally','float',
    'for','goto','if','implements','import','instanceof','int','interface','long','native',
    'new','package','private','protected','public','return','short','static','strictfp',
    'super','switch','synchronized','this','throw','throws','transient','try','void',
    'volatile','while']
}

// The Java package of the platform's runtime classes (PureValues, PureMap, PureMatch, Variant, PureDate,
// PureFormat, PureBytes, PureOut): the handwritten library every translated program calls, in the Java
// platform's own sources (platforms/java/…/runtime).
// The default host: the Java platform. A generator targeting another host
// passes its own root to defaultConventions.
function platform::extensions::language::java::translation::defaultPlatformPackage(): String[1]
{
   'org.finos.legend.pure.platform.java'
}

function platform::extensions::language::java::translation::runtimePackage(conv: Conventions[1]): String[1]
{
   $conv.runtimePkg
}

// Where a host keeps the two groups of support class unless it says otherwise. ONE
// definition each: `conventionsFor` and every entry point that defaults them read these,
// so a host layout change is a single edit (it was three, and two of them were missed).
function platform::extensions::language::java::translation::defaultPdbPackage(platformPackage: String[1]): String[1]
{
   $platformPackage + '.compiler.module.pdbModule'
}

function platform::extensions::language::java::translation::defaultRuntimePackage(platformPackage: String[1]): String[1]
{
   $platformPackage + '.runtime'
}

function platform::extensions::language::java::translation::runtimeClass(conv: Conventions[1], simpleName: String[1]): String[1]
{
   $conv->runtimePackage() + '.' + $simpleName
}

// A host support class under `<platformPackage>.<suffix>`, e.g. 'PureStack'.
function platform::extensions::language::java::translation::platformClass(conv: Conventions[1], suffix: String[1]): String[1]
{
   $conv.platformPackage + '.' + $suffix
}

// One of the metadata hooks, in whichever package the host keeps them in. Callers
// name the class only — `pdbClass('Metadata')`, not `pdbClass('Metadata')` —
// so a host that does not use a `.pdb` sub-package needs no change here.
function platform::extensions::language::java::translation::pdbClass(conv: Conventions[1], simpleName: String[1]): String[1]
{
   $conv.pdbPackage + '.' + $simpleName
}

function platform::extensions::language::java::translation::defaultConventions(basePackageName: String[1]): Conventions[1]
{
   platform::extensions::language::java::translation::conventionsFor($basePackageName, defaultPlatformPackage());
}

// Conventions targeting a specific HOST: `platformPackage` is the root of the
// support classes the generated code calls into. Truffle generates its own copy
// of the PDB reader and passes its own root, so nothing it emits reaches into
// the Java platform's packages.
function platform::extensions::language::java::translation::conventionsFor(basePackageName: String[1], platformPackage: String[1]): Conventions[1]
{
   ^Conventions(
      basePackageName = $basePackageName,
      platformPackage = $platformPackage,
      pdbPackage      = platform::extensions::language::java::translation::defaultPdbPackage($platformPackage),
      runtimePkg      = platform::extensions::language::java::translation::defaultRuntimePackage($platformPackage),
      metadataElements = false,
      owner            = [],
      scope            = [],
      functionCoders  = newMap([
         pair('plus',             plusCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('minus',            minusCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('times',            timesCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('divide',           divideCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('equal',            equalCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('lessThan',         lessThanCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('greaterThan',      greaterThanCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('lessThanEqual',    lessThanEqualCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('greaterThanEqual', greaterThanEqualCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('and',              andCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('or',               orCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('not',              notCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('toString',         toStringCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('round',            roundCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('floor',            floorCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('ceiling',          ceilingCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('toOne',            toOneCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('take',             takeCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('drop',             dropCoder_FunctionExpression_1__Conventions_1__Code_1_),
         pair('map',              mapCoder_FunctionExpression_1__Conventions_1__Code_1_),
