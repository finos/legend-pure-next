      ->addField(javaField(['public'], javaInt(), 'offset'))
      ->addField(javaField(['public'], javaInt(), 'length'))
      ->addMethod(javaMethod(['public', 'static'], $bytesType, 'of', [j_parameter(javaArray(javaByte()), 'data'), j_parameter(javaInt(), 'offset'), j_parameter(javaInt(), 'length')],
           'PureBytes b = new PureBytes();\nb.data = data;\nb.offset = offset;\nb.length = length;\nreturn b;'))
      ->addMethod(javaMethod(['public', 'static'], $bytesType, 'read', [j_parameter(javaString(), 'path')],
           'try {\n    byte[] bytes = java.nio.file.Files.readAllBytes(java.nio.file.Path.of(path));\n    return of(bytes, 0, bytes.length);\n} catch (java.io.IOException e) {\n    throw new java.io.UncheckedIOException(e);\n}'))
      ->addMethod(javaMethod(['public'], $longType, 'get', [j_parameter(javaInt(), 'i')],
           'if (i < 0 || i >= length) { throw new IndexOutOfBoundsException("Index " + i + " out of bounds for length " + length); }\nreturn (long) (data[offset + i] & 0xFF);'))
      ->addMethod(javaMethod(['public'], javaInt(), 'size', [], 'return length;'))
      ->addMethod(javaMethod(['public'], javaParameterizedType(javaClass('java.util.List'), [$longType]), 'subList', [j_parameter(javaInt(), 'from'), j_parameter(javaInt(), 'to')],
           'if (from < 0 || to > length || from > to) { throw new IndexOutOfBoundsException("fromIndex = " + from + ", toIndex = " + to); }\nreturn of(data, offset + from, to - from);'));
