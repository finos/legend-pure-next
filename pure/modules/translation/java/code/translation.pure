// global-vs-first behaviour. Skip the 5-arg + RegexpParameter overloads;
// flag translation isn't trivial.
function <<access.private>> meta::external::language::java::translation::regexpReplaceCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n == 3 || $n == 4, | 'regexpReplaceCoder expects 3 or 4 arguments, got ' + $n->toString());
   let s    = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString());
   let r    = $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaString());
   let repl = $conv->translateExpression($fe.parametersValues->at(2))->j_cast(javaString());
   // 3-arg form defaults to replace-first (matches Pure's contract that
   // `replaceAll` is the trailing-Boolean form with `true`). When the 4-arg
   // form passes a literal Boolean, dispatch statically; otherwise emit a
   // runtime ternary.
   if ($n == 3,
      | $s->j_invoke('replaceFirst', [$r, $repl], javaString()),
      | $conv->regexpReplaceWithFlag($fe.parametersValues->at(3), $s, $r, $repl)
   );
}

// Pick replaceAll / replaceFirst based on the 4th-arg Boolean flag. When
// the flag is a literal we dispatch statically (no extra runtime branch);
// otherwise emit a Java ternary so dynamic-flag callers still work.
function <<access.private>> meta::external::language::java::translation::regexpReplaceWithFlag(
   conv: Conventions[1],
   flag: ValueSpecification[1],
   s: Code[1],
   r: Code[1],
   repl: Code[1]
): Code[1]
{
   if ($flag->instanceOf(AtomicValue) && $flag->cast(@AtomicValue).value->toOne()->instanceOf(Boolean),
      | if ($flag->cast(@AtomicValue).value->toOne()->cast(@Boolean),
           | $s->j_invoke('replaceAll',   [$r, $repl], javaString()),
           | $s->j_invoke('replaceFirst', [$r, $repl], javaString())
        ),
      | j_conditional(
           $conv->translateExpression($flag),
           $s->j_invoke('replaceAll',   [$r, $repl], javaString()),
           $s->j_invoke('replaceFirst', [$r, $repl], javaString())
        )
   );
}

function <<access.private>> meta::external::language::java::translation::powCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'powCoder expects exactly 2 arguments');
   let b = $conv->translateExpression($fe.parametersValues->at(0));
   let e = $conv->translateExpression($fe.parametersValues->at(1));
   // Math.pow takes/returns double; Pure's Number maps to Java Number (any),
   // so explicitly coerce both args to double before dispatch.
   j_invoke(javaClass('java.lang.Math'), 'pow',
      [$b->j_cast(javaDouble()), $e->j_cast(javaDouble())], javaDouble());
}

// `mod(dividend, divisor)` — Pure: mathematical modulo (result always
// non-negative). Java's {@code Math.floorMod(long,long)} matches.
function <<access.private>> meta::external::language::java::translation::modCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'modCoder expects exactly 2 arguments');
   let a = $conv->translateExpression($fe.parametersValues->at(0));
   let b = $conv->translateExpression($fe.parametersValues->at(1));
   j_invoke(javaClass('java.lang.Math'), 'floorMod',
      [$a->j_cast(javaLong()), $b->j_cast(javaLong())], javaLong());
}

function <<access.private>> meta::external::language::java::translation::atan2Coder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'atan2Coder expects exactly 2 arguments');
   let y = $conv->translateExpression($fe.parametersValues->at(0));
   let x = $conv->translateExpression($fe.parametersValues->at(1));
   j_invoke(javaClass('java.lang.Math'), 'atan2',
      [$y->j_cast(javaDouble()), $x->j_cast(javaDouble())], javaDouble());
}

// One-arg math intrinsics that route to {@code java.lang.Math.<name>(double)}
// returning double. Pure: Number[1] -> Float[1]. Caller passes the double-
// cast operand; we centralise the {@code Math.X(d)} pattern so each
// function-specific coder stays a one-liner.
function <<access.private>> meta::external::language::java::translation::mathDoubleCoder(conv: Conventions[1], fe: FunctionExpression[1], methodName: String[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | $methodName + 'Coder expects exactly 1 argument');
   let n = $conv->translateExpression($fe.parametersValues->at(0));
   j_invoke(javaClass('java.lang.Math'), $methodName, [$n->j_cast(javaDouble())], javaDouble());
}

function <<access.private>> meta::external::language::java::translation::sqrtCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->mathDoubleCoder($fe, 'sqrt') }
function <<access.private>> meta::external::language::java::translation::cbrtCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->mathDoubleCoder($fe, 'cbrt') }
function <<access.private>> meta::external::language::java::translation::expCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]    { $conv->mathDoubleCoder($fe, 'exp') }
function <<access.private>> meta::external::language::java::translation::logCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]    { $conv->mathDoubleCoder($fe, 'log') }
function <<access.private>> meta::external::language::java::translation::log10Coder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]  { $conv->mathDoubleCoder($fe, 'log10') }
function <<access.private>> meta::external::language::java::translation::sinCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]    { $conv->mathDoubleCoder($fe, 'sin') }
function <<access.private>> meta::external::language::java::translation::cosCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]    { $conv->mathDoubleCoder($fe, 'cos') }
function <<access.private>> meta::external::language::java::translation::tanCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]    { $conv->mathDoubleCoder($fe, 'tan') }
function <<access.private>> meta::external::language::java::translation::asinCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->mathDoubleCoder($fe, 'asin') }
function <<access.private>> meta::external::language::java::translation::acosCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->mathDoubleCoder($fe, 'acos') }
function <<access.private>> meta::external::language::java::translation::atanCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->mathDoubleCoder($fe, 'atan') }
function <<access.private>> meta::external::language::java::translation::cotCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   // Java's Math has no cot; emit {@code 1.0 / Math.tan(x)}.
   assert($fe.parametersValues->size() == 1, | 'cotCoder expects exactly 1 argument');
   let n = $conv->translateExpression($fe.parametersValues->at(0));
   let tan = j_invoke(javaClass('java.lang.Math'), 'tan', [$n->j_cast(javaDouble())], javaDouble());
   j_divide(j_double(1.0), $tan);
}

// `abs(n)` — Math.abs is overloaded for long/double; the Pure→Java type
// mapping uses long for Integer, double for Float/Number. We branch on the
// rawType so an Integer arg stays a long round-trip (matches Pure's
// {@code abs(Integer)->Integer}).
function <<access.private>> meta::external::language::java::translation::absCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'absCoder expects exactly 1 argument');
   let arg = $fe.parametersValues->at(0);
   let n   = $conv->translateExpression($arg);
   let rawOpt = $arg.genericType->rawType();
   let isInt  = $rawOpt->isNotEmpty() && $rawOpt->toOne() == meta::pure::metamodel::type::primitives::Integer;
   if ($arg->isDecimalTyped(), | $n->j_castWithoutChecks(javaBigDecimal())->j_invoke('abs', [], javaBigDecimal()),
   |if ($isInt,
      | j_invoke(javaClass('java.lang.Math'), 'abs', [$n->j_cast(javaLong())], javaLong()),
      | j_invoke(javaClass('java.lang.Math'), 'abs', [$n->j_cast(javaDouble())], javaDouble())
   ));
}

// `sign(n)` — Pure: returns Integer (-1/0/+1). Java: {@code Math.signum} returns
// a double matching the input sign — cast to long since Pure's return is Integer.
function <<access.private>> meta::external::language::java::translation::signCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'signCoder expects exactly 1 argument');
   let n = $conv->translateExpression($fe.parametersValues->at(0));
   j_cast(
      j_invoke(javaClass('java.lang.Math'), 'signum', [$n->j_cast(javaDouble())], javaDouble()),
      javaLong()
   );
}

// String case / trim intrinsics — direct String methods. Note: Pure's trim
// strips ASCII whitespace; Java's String.strip() strips Unicode whitespace
// (close enough for PCT tests). {@code stripLeading} / {@code stripTrailing}
// give the one-side variants.
function <<access.private>> meta::external::language::java::translation::stringUnaryCoder(conv: Conventions[1], fe: FunctionExpression[1], methodName: String[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | $methodName + 'Coder expects exactly 1 argument');
   let s = $conv->translateExpression($fe.parametersValues->at(0));
   $s->j_cast(javaString())->j_invoke($methodName, [], javaString());
}

function <<access.private>> meta::external::language::java::translation::toLowerCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1] { $conv->stringUnaryCoder($fe, 'toLowerCase') }
function <<access.private>> meta::external::language::java::translation::toUpperCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1] { $conv->stringUnaryCoder($fe, 'toUpperCase') }
function <<access.private>> meta::external::language::java::translation::trimCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]    { $conv->stringUnaryCoder($fe, 'strip') }
function <<access.private>> meta::external::language::java::translation::ltrimCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->stringUnaryCoder($fe, 'stripLeading') }
function <<access.private>> meta::external::language::java::translation::rtrimCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]  { $conv->stringUnaryCoder($fe, 'stripTrailing') }

// Numeric conversions — Pure's `toFloat` accepts {@code Number|String}, returns
// Float. Same shape as `toDecimal`. Emit a {@code Double.parseDouble(s)} for
// String inputs, else cast to double. Detect String at translate-time via the
// arg's rawType; fall back to runtime cast otherwise.
function <<access.private>> meta::external::language::java::translation::toFloatCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'toFloatCoder expects exactly 1 argument');
   let arg = $fe.parametersValues->at(0);
   let n   = $conv->translateExpression($arg);
   let raw = $arg.genericType->rawType();
   let isStr = $raw->isNotEmpty() && $raw->toOne() == meta::pure::metamodel::type::primitives::String;
   if ($isStr,
      | j_invoke(javaClass('java.lang.Double'), 'parseDouble', [$n->j_cast(javaString())], javaDouble()),
      | $n->j_cast(javaDouble())
   );
}

// `toDecimal(n)` — the number as a BigDecimal.
function <<access.private>> meta::external::language::java::translation::toDecimalCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'toDecimalCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   $conv->asBigDecimal($fe.parametersValues->at(0));
}

// `assertEmpty(coll)` — equivalent to {@code assert(coll.isEmpty())}. The
// existing assertCoder pattern returns the boolean expression directly;
// callers (test bodies) treat a false return as a test failure. Match that
// shape so assertEmpty plugs into the same surrounding assertion harness.
function <<access.private>> meta::external::language::java::translation::assertEmptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'assertEmptyCoder expects at least 1 argument');
   // translateAsList covers every representation: a List, a null standing for
   // an empty collection, and a lone value (never empty).
   $conv->translateAsList($fe.parametersValues->at(0))->j_invoke('isEmpty', [], javaBoolean());
}

// `in(value, coll)` — collection contains. Pure's `in` is identity-ish; we
// route through {@code Collection.contains} which uses {@code .equals}.
function <<access.private>> meta::external::language::java::translation::inCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'inCoder expects exactly 2 arguments');
   let v    = $conv->translateExpression($fe.parametersValues->at(0));
   let coll = $conv->translateExpression($fe.parametersValues->at(1));
   $coll->j_cast(javaClass('java.util.Collection'))->j_invoke('contains', [$v->j_box()], javaBoolean());
}

// `elementToPath(el)` — Pure returns the canonical `::`-joined path of a
// PackageableElement. Our translator currently emits PE values as their
// short-name String literal — so the runtime "path" is just that String,
// without the leading namespace. Best-effort: passthrough the string when
// arg is already a String, else fall back to {@code String.valueOf}.
// `genericType(value)` — the value's classifier, which only the Java platform
// can answer: the metamodel object the value carries (or one over its type).
function <<access.private>> meta::external::language::java::translation::genericTypeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'genericTypeCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: genericType');
   j_invoke(javaClass('org.finos.legend.pure.platform.java.pdb.Metadata'), 'genericType',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaObject())
      ->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed());
}

function <<access.private>> meta::external::language::java::translation::elementToPathCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n >= 1 && $n <= 2, | 'elementToPathCoder expects 1 or 2 arguments, got ' + $n->toString());
   let el = $conv->translateExpression($fe.parametersValues->at(0));
   let separator = if ($n == 2, | $conv->translateExpression($fe.parametersValues->at(1)), | j_string('::'));
   if ($conv.metadataElements,
      | j_invoke(javaClass('org.finos.legend.pure.platform.java.pdb.Metadata'), 'path', [$el->toObjectCode(), $separator], javaString()),
      | j_invoke(javaString(), 'valueOf', [$el], javaString()));
}

// `concatenate(a, b)` — return a new List combining both. Use
// {@code Stream.concat(a.stream(), b.stream()).toList()} (mutable-safe;
// returns an unmodifiable List which Pure handles fine).
function <<access.private>> meta::external::language::java::translation::concatenateCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'concatenateCoder expects exactly 2 arguments');
   // Raw lists: concatenating typed lists of different element types
   // (List<Long> with List<String>) infers an intersection element type that
   // isn't List<Object>. translateAsList also lifts a lone value and turns a
   // null into an empty list.
   let sa = $conv->translateAsList($fe.parametersValues->at(0))->j_invoke('stream', [], javaStream(javaObject()));
   let sb = $conv->translateAsList($fe.parametersValues->at(1))->j_invoke('stream', [], javaStream(javaObject()));
   j_invoke(javaClass('java.util.stream.Stream'), 'concat', [$sa, $sb], javaStream(javaObject()))
      ->j_invoke('toList', [], javaList(javaObject()));
}

function <<access.private>> meta::external::language::java::translation::collectionStream(conv: Conventions[1], code: Code[1]): Code[1]
{
   if ($code.type == javaObject(),
      | $code->j_castWithoutChecks(javaClass('java.util.Collection'))->j_invoke('stream', [], javaStream(javaObject())),
      | $code->j_invoke('stream', [], javaStream(javaObject()))
   );
}

// `firstNonEmpty(thunks)` — Pure: walk a list of 0-arg suppliers, return the
// first non-empty {@code .get()} result, or empty if all are empty. Wraps in
// a Supplier IIFE so the multi-statement walk stays expression-shaped.
// Treats null and {@code Collection.isEmpty()} as empty (matches Pure's
// `[0..*]` semantics — a scalar non-collection result is always non-empty).
// Special-case the literal Collection-of-thunks shape: emit
// {@code Arrays.<Supplier>asList(s1, s2, ...)} with the typed varargs so
// Java's type inference doesn't blow up on bare lambdas inside asList.
function <<access.private>> meta::external::language::java::translation::firstNonEmptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'firstNonEmptyCoder expects exactly 1 argument');
   let thunksCode = $conv->translateFirstNonEmptyThunks($fe.parametersValues->at(0));
   let rawList = javaList();
   let body = j_block([
      j_declare(javaList(), 'thunks', $thunksCode),
      j_code('for (Object t : thunks) {\n'
         + '   Object r = ((java.util.function.Supplier<?>) t).get();\n'
         + '   if (r == null) continue;\n'
         + '   if (r instanceof java.util.Collection && ((java.util.Collection<?>) r).isEmpty()) continue;\n'
         + '   return r instanceof java.util.List ? (java.util.List) r : java.util.Collections.singletonList(r);\n'
         + '}\n'
         + 'return java.util.Collections.emptyList();', javaVoid())
   ]);
   j_lambda([], $body)->j_castWithoutChecks(javaSupplier($rawList))->j_invoke('get', [], $rawList);
}

// When the arg is a literal {@code [| ..., | ..., ...]} Collection of 0-arg
// lambdas, emit each lambda explicitly with a {@code (Supplier) ...} cast
// to satisfy Java's varargs type inference. Otherwise translate normally
// — the runtime value should already be a List of Suppliers.
function <<access.private>> meta::external::language::java::translation::translateFirstNonEmptyThunks(conv: Conventions[1], arg: ValueSpecification[1]): Code[1]
{
   if ($arg->instanceOf(meta::pure::metamodel::valuespecification::Collection),
      | $conv->translateThunkCollection($arg->cast(@meta::pure::metamodel::valuespecification::Collection)),
      | $conv->translateExpression($arg)
   );
}

function <<access.private>> meta::external::language::java::translation::translateThunkCollection(conv: Conventions[1], coll: meta::pure::metamodel::valuespecification::Collection[1]): Code[1]
{
   // Emit `Arrays.<Supplier>asList(s1, s2, ...)` with an explicit type
   // parameter so Java's varargs inference doesn't fail on the bare-lambda
   // elements. Each lambda inherits the explicit type-parameter context
   // through SAM inference — no per-element cast needed.
   let suplType = javaSupplier(javaObject());
   let thunks   = $coll.values->map(v | $conv->translateExpression($v));
   j_invoke(javaArrays(), [$suplType], 'asList', $thunks, javaList($suplType));
}

// `slice(coll, start, end)` — Pure: returns elements [start, end). Java:
// {@code coll.subList(start, end)} wrapped in {@code new ArrayList(...)} for
// the same Pure-equality reason as {@link tailCoder} (SubList views aren't
// recognised by the Pure-side equality unwrap).
function <<access.private>> meta::external::language::java::translation::sliceCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'sliceCoder expects exactly 3 arguments');
   // Bounds are clamped to the collection, as in Pure: slice past the end or
   // before the start yields what overlaps, possibly nothing.
   let coll  = $conv->translateAsList($fe.parametersValues->at(0))->toObjectCode();
   // No (Object) cast on the bounds: `(Object) -1L` parses as a subtraction.
   let start = $conv->translateExpression($fe.parametersValues->at(1));
   let end   = $conv->translateExpression($fe.parametersValues->at(2));
   valueIife(j_invoke(javaArrays(), 'asList', [$coll, $start, $end], javaList()), javaList(), javaList(), [
      j_code('java.util.List<?> pureSlL = (java.util.List<?>) pureIifeIn.get(0); '
           + 'int pureSlS = (int) Math.min(Math.max(0L, ((Number) pureIifeIn.get(1)).longValue()), pureSlL.size()); '
           + 'int pureSlE = (int) Math.min(Math.max(pureSlS, ((Number) pureIifeIn.get(2)).longValue()), pureSlL.size()); '
           + 'return new java.util.ArrayList<Object>(pureSlL.subList(pureSlS, pureSlE));', javaVoid())
   ]);
}

// `find(coll, predicate)` — first element matching the predicate, or empty.
// {@code coll.stream().filter(p).findFirst().orElse(null)}; Pure callers
// see [0..1] (null = empty).
function <<access.private>> meta::external::language::java::translation::findCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'findCoder expects exactly 2 arguments');
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   let pred = $conv->translateExpression($fe.parametersValues->at(1));
   let optType = javaClass('java.util.Optional');
   // orElse on a raw stream is Object; cast back to the element's boxed type.
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('filter', [$pred->asPredicate()], javaStream(javaObject()))
        ->j_invoke('findFirst', [], $optType)
        ->j_invoke('orElse', [j_null()], javaObject())
        ->j_cast($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed());
}

// `forAll(coll, predicate)` — Stream.allMatch is the direct mirror.
function <<access.private>> meta::external::language::java::translation::forAllCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'forAllCoder expects exactly 2 arguments');
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   let pred = $conv->translateExpression($fe.parametersValues->at(1));
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('allMatch', [$pred->asPredicate()], javaBoolean());
}

// `add(set, val)` and `add(set, offset, val)` — return a new list with val
// appended (2-arg) or inserted at offset (3-arg). Pure semantics are
// immutable so copy first; same raw-List rationale as {@link tailCoder} to
// keep return-type inference quiet.
function <<access.private>> meta::external::language::java::translation::addCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n == 2 || $n == 3, | 'addCoder expects 2 or 3 arguments, got ' + $n->toString());
   // translateAsList: inside fold's reducer the collection is an Object-typed
   // accumulator, and `new ArrayList(Object)` has no matching constructor.
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   let copy = j_new(javaArrayList(), [$coll]);
   // Wrap in a Supplier IIFE so the multi-statement (copy + add + return)
   // stays expression-shaped — Java won't accept it inline otherwise.
   let rawList = javaList();
   let addStmt = if ($n == 2,
      | let v = $conv->translateExpression($fe.parametersValues->at(1));
        j_expressionStatement(j_invoke(j_variable($rawList, 'list'), 'add', [$v], javaBoolean()));,
      | let off = $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaInt());
        let v   = $conv->translateExpression($fe.parametersValues->at(2));
        j_expressionStatement(j_invoke(j_variable($rawList, 'list'), 'add', [$off, $v], javaVoid()));
   );
   let body = j_block([
      j_declare($rawList, 'list', $copy),
      $addStmt,
      j_return(j_variable($rawList, 'list'))
   ]);
   j_lambda([], $body)->j_cast(javaSupplier($rawList))->j_invoke('get', [], $rawList);
}

// `chunk(s, n)` — split a String into fixed-size pieces. Emit an IntStream
// IIFE since Java has no built-in n-char chunking. Returns
// {@code List<String>} matching Pure's String[*].
// Run `body` once with `arg` bound to the lambda parameter `pureIifeIn`, for
// coders whose loops have to sit in expression position.
//
// A Function IIFE rather than {@link addCoder}'s Supplier with a block local:
// here the argument is evaluated outside the lambda body, so nesting these
// coders — the round trip utf8BytesToString(stringToUtf8Bytes(s)) — can't
// redeclare a name from an enclosing scope, which javac rejects even across
// lambdas. `argType` must be a reference type to match Function<T, R>. Locals
// in `body` should carry a coder-specific prefix so they can't shadow user variables.
function <<access.private>> meta::external::language::java::translation::valueIife(arg: Code[1], argType: meta::external::language::java::metamodel::Type[1], resultType: meta::external::language::java::metamodel::Type[1], body: Code[*]): Code[1]
{
   j_lambda([j_parameter($argType, 'pureIifeIn')], j_block($body))
      ->j_cast(javaFunction($argType, $resultType))
      ->j_invoke('apply', [$arg], $resultType);
}

// `vs` as a raw java.util.List, whatever it is at runtime. A plain cast is
// wrong twice over: Pure lifts a single value into a collection argument
// (`'a'->head()` would emit `((List) "a")`), and an empty collection can arrive
// as null (an empty AtomicValue translates to null, so `((List) null).isEmpty()`
// throws). Decided at runtime rather than from the static multiplicity so an
// unresolved multiplicity parameter (`T[m]` in a generic helper) still works.
function <<access.private>> meta::external::language::java::translation::translateAsList(conv: Conventions[1], vs: ValueSpecification[1]): Code[1]
{
