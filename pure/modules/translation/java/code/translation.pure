// Shared shape for binary arithmetic: translate the two operand expressions,
// then hand them to a Java infix factory (j_plus, j_minus, ...).
function <<access.private>> meta::external::language::java::translation::binaryInfix(
   fe: FunctionExpression[1],
   conv: Conventions[1],
   factory: Function<{Code[1], Code[1] -> Code[1]}>[1]
): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'binary coder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let left  = $conv->translateExpression($fe.parametersValues->at(0));
   let right = $conv->translateExpression($fe.parametersValues->at(1));
   // When an operand is Object-typed (came through fold's β-substituted
   // reducer or similar), cast to the FE's expected result type so the
   // infix factory doesn't emit {@code Object + Object}. Typed operands
   // (the common case) pass through unchanged.
   let resultTypeOpt = $fe.genericType->rawType();
   let leftCast  = if ($resultTypeOpt->isEmpty() || $left.type != javaObject(),  | $left,  | $left ->binaryOperandCast($resultTypeOpt->toOne()));
   let rightCast = if ($resultTypeOpt->isEmpty() || $right.type != javaObject(), | $right, | $right->binaryOperandCast($resultTypeOpt->toOne()));
   $factory->eval($leftCast, $rightCast);
}

// Operand-coercion helper for {@link binaryInfix}. Maps Pure rawType to the
// Java type that fits the infix factory (long for Integer, double for
// Float/Number, String for String). Uses {@link j_cast}'s primitive proxy
// which auto-unboxes Object→Long/Double via {@code longValue()/doubleValue()}.
function <<access.private>> meta::external::language::java::translation::binaryOperandCast(expr: Code[1], rawType: meta::pure::metamodel::type::Type[1]): Code[1]
{
   let deref = $rawType->derefTempPointer();
   // For primitive targets, cast through the boxed equivalent first so
   // {@code j_cast(javaLong())}'s boxed-to-primitive proxy fires (emitting
   // {@code ((Long) x).longValue()}). A direct {@code (long) someObject}
   // doesn't compile.
   if ($deref == meta::pure::metamodel::type::primitives::Integer,
      | $expr->j_castWithoutChecks(javaClass('java.lang.Long'))->j_cast(javaLong()),
   |if ($deref == meta::pure::metamodel::type::primitives::Float
      || $deref == meta::pure::metamodel::type::primitives::Decimal
      || $deref == meta::pure::metamodel::type::primitives::Number,
      | $expr->j_castWithoutChecks(javaClass('java.lang.Double'))->j_cast(javaDouble()),
   |if ($deref == meta::pure::metamodel::type::primitives::String,
      | $expr->j_castWithoutChecks(javaString()),
   |if ($deref == meta::pure::metamodel::type::primitives::Boolean,
      | $expr->j_castWithoutChecks(javaClass('java.lang.Boolean'))->j_cast(javaBoolean()),
      | $expr
   ))));
}

function <<access.private>> meta::external::language::java::translation::plusCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   binaryInfix($fe, $conv, j_plus_Code_1__Code_1__Code_1_);
}

function <<access.private>> meta::external::language::java::translation::minusCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   // minus is overloaded: binary `a - b` and unary `-a`. Dispatch on arity.
   if ($fe.parametersValues->size() == 1,
       | j_minus($conv->translateExpression($fe.parametersValues->at(0))),
       | binaryInfix($fe, $conv, j_minus_Code_1__Code_1__Code_1_)
   );
}

function <<access.private>> meta::external::language::java::translation::timesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   binaryInfix($fe, $conv, j_multiply_Code_1__Code_1__Code_1_);
}

function <<access.private>> meta::external::language::java::translation::divideCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   binaryInfix($fe, $conv, j_divide_Code_1__Code_1__Code_1_);
}

// j_eq handles primitive (==) vs object (Objects.equals) dispatch internally
// based on the operand types it sees, so we can just delegate.
function <<access.private>> meta::external::language::java::translation::equalCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   binaryInfix($fe, $conv, j_eq_Code_1__Code_1__Code_1_);
}

// `String.valueOf(x)` — works for any primitive overload and renders `null`
// for null references (matches Pure's `toString` over scalar values). Use the
// 4-arg j_invoke form with explicit return type: String's apiKnowledge table
// doesn't list `valueOf`, so the 3-arg form's auto-lookup fails.
function <<access.private>> meta::external::language::java::translation::toStringCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'toStringCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaString(), 'valueOf', [$conv->translateExpression($fe.parametersValues->at(0))], javaString());
}

// Type-aware comparison dispatch — Pure's lessThan/greaterThan accept any
// totally-ordered operand (Number, String, Date, Boolean) but Java's `<`/`>`
// only work on primitives. For non-primitive operands, route through
// Comparable.compareTo (or Boolean.compare for booleans) and compare the
// result against 0 using the matching Java infix operator.
function <<access.private>> meta::external::language::java::translation::typeAwareCompare(fe: FunctionExpression[1], conv: Conventions[1], numericFactory: Function<{Code[1], Code[1] -> Code[1]}>[1], cmpVsZero: Function<{Code[1], Code[1] -> Code[1]}>[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'comparison coder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let leftRaw = $fe.parametersValues->at(0).genericType->toOne()->rawType()->toOne();
   let a       = $conv->translateExpression($fe.parametersValues->at(0));
   let b       = $conv->translateExpression($fe.parametersValues->at(1));
   if ($leftRaw == Boolean,
      | $cmpVsZero->eval(j_invoke(javaClass('java.lang.Boolean'), 'compare', [$a, $b], javaInt()), j_int(0)),
   |if ($leftRaw == String || $leftRaw == meta::pure::metamodel::type::primitives::StrictDate || $leftRaw == meta::pure::metamodel::type::primitives::Date,
      | $cmpVsZero->eval($a->j_invoke('compareTo', [$b], javaInt()), j_int(0)),
      | $numericFactory->eval($a, $b)
   ));
}

function <<access.private>> meta::external::language::java::translation::lessThanCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   typeAwareCompare($fe, $conv, j_lt_Code_1__Code_1__Code_1_, j_lt_Code_1__Code_1__Code_1_);
}

function <<access.private>> meta::external::language::java::translation::greaterThanCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   typeAwareCompare($fe, $conv, j_gt_Code_1__Code_1__Code_1_, j_gt_Code_1__Code_1__Code_1_);
}

function <<access.private>> meta::external::language::java::translation::lessThanEqualCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   typeAwareCompare($fe, $conv, j_le_Code_1__Code_1__Code_1_, j_le_Code_1__Code_1__Code_1_);
}

function <<access.private>> meta::external::language::java::translation::greaterThanEqualCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   typeAwareCompare($fe, $conv, j_ge_Code_1__Code_1__Code_1_, j_ge_Code_1__Code_1__Code_1_);
}

function <<access.private>> meta::external::language::java::translation::andCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   binaryInfix($fe, $conv, j_and_Code_1__Code_1__Code_1_);
}

function <<access.private>> meta::external::language::java::translation::orCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   binaryInfix($fe, $conv, j_or_Code_1__Code_1__Code_1_);
}

function <<access.private>> meta::external::language::java::translation::notCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'notCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_not($conv->translateExpression($fe.parametersValues->at(0)));
}

// Math.round / floor / ceiling — single-arg form only. Pure's 2-arg
// round(decimal, scale) requires BigDecimal-style precision control with no
// direct java.lang.Math equivalent; those fall through with the standard
// "No coder" diagnostic.
function <<access.private>> meta::external::language::java::translation::roundCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n == 1 || $n == 2, | 'roundCoder expects 1 or 2 arguments, got ' + $n->toString());
   if ($n == 1,
      | j_invoke(javaMath(), 'round', [$conv->translateExpression($fe.parametersValues->at(0))], javaLong()),
      | $conv->roundWithScale($fe.parametersValues->at(0), $fe.parametersValues->at(1))
   );
}

// {@code round(value, scale)} — route through {@code BigDecimal.setScale}
// with HALF_UP (Pure's default rounding) to honour the scale argument.
// Pure returns Float/Decimal; both map to Java double via
// {@link pureTypeToJavaType}, so emit the doubleValue.
function <<access.private>> meta::external::language::java::translation::roundWithScale(conv: Conventions[1], valueArg: ValueSpecification[1], scaleArg: ValueSpecification[1]): Code[1]
{
   let v = $conv->translateExpression($valueArg);
   let s = $conv->translateExpression($scaleArg);
   let bd = javaClass('java.math.BigDecimal');
   j_invoke($bd, 'valueOf', [$v->j_cast(javaDouble())], $bd)
      ->j_invoke('setScale', [$s->j_cast(javaInt()),
                              j_code('java.math.RoundingMode.HALF_UP', javaClass('java.math.RoundingMode'))],
                  $bd)
      ->j_invoke('doubleValue', [], javaDouble());
}

// Pure's floor/ceiling return Integer (java long). Math.floor/ceil return
// double — wrap in a long cast so the method return type matches the
// pureTypeToJavaType mapping. The double-to-long narrowing matches Pure's
// "exact integer result" semantics: floor(3.7) == 3, ceiling(3.2) == 4.
function <<access.private>> meta::external::language::java::translation::floorCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'floorCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_cast(j_invoke(javaMath(), 'floor', [$conv->translateExpression($fe.parametersValues->at(0))], javaDouble()), javaLong());
}

function <<access.private>> meta::external::language::java::translation::ceilingCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'ceilingCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_cast(j_invoke(javaMath(), 'ceil', [$conv->translateExpression($fe.parametersValues->at(0))], javaDouble()), javaLong());
}

// toOne(x) — Pure's multiplicity narrower. For scalar values it's a pure
// passthrough at the value level (Java doesn't carry Pure's multiplicity at
// runtime); the type erasure already matches what the caller expects.
function <<access.private>> meta::external::language::java::translation::toOneCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'toOneCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let arg  = $fe.parametersValues->at(0);
   let code = $conv->translateExpression($arg);
   // When the source is multi-valued, extract the first element via
   // {@code .get(0)} so the result type matches Pure's `[1]` shape. Pure
   // scalars (`[1]` or `[0..1]`) pass through unchanged — the runtime
   // value is already the single element. Cast the result to the FE's
   // expected type (boxed when primitive — Java auto-unboxes in context).
   let extracted = if ($arg.multiplicity->toOne()->meta::pure::functions::meta::isToMany(),
      | $code->j_cast(javaList(javaObject()))->j_invoke('get', [j_int(0)], javaObject()),
      | $code
   );
   let feRetType = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity);
   $extracted->j_castWithoutChecks($feRetType->toBoxed());
}

// Collection slice + transform — Pure's `take`/`drop`/`map` over `[*]` map
// onto Java `Stream` ops with `.toList()` (Java 16+ shortcut for
// `.collect(Collectors.toList())`). The 4-arg j_invoke variant carries an
// explicit return type since these stream methods aren't in apiKnowledge.
function <<access.private>> meta::external::language::java::translation::takeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'takeCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateExpression($fe.parametersValues->at(0));
   let n    = $conv->translateExpression($fe.parametersValues->at(1));
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('limit',  [$n], javaStream(javaObject()))
        ->j_invoke('toList', [], javaList(javaObject()));
}

function <<access.private>> meta::external::language::java::translation::dropCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'dropCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateExpression($fe.parametersValues->at(0));
   let n    = $conv->translateExpression($fe.parametersValues->at(1));
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('skip',   [$n], javaStream(javaObject()))
        ->j_invoke('toList', [], javaList(javaObject()));
}

// map's second arg is an AtomicValue holding a LambdaFunction; the scalar
// dispatch in translateScalarAtomicValue lifts it into a Java lambda via
// translateLambdaValue, which becomes the Function passed to Stream.map.
function <<access.private>> meta::external::language::java::translation::mapCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'mapCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateExpression($fe.parametersValues->at(0));
   let f    = $conv->translateExpression($fe.parametersValues->at(1));
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('map',    [$f], javaStream(javaObject()))
        ->j_invoke('toList', [], javaList(javaObject()));
}

// `$lambda->eval(args...)` — invoke a Pure lambda. The lambda was translated
// via translateLambdaValue into a Java lambda expression; cast it to the
// arity-matched functional interface (Supplier/Function/BiFunction) and
// dispatch through `.get()`/`.apply(...)`. Arities > 2 are uncommon in PCT
// and fall through with a clear diagnostic — Java doesn't ship a built-in
// TriFunction so each would need its own ad-hoc interface.
function <<access.private>> meta::external::language::java::translation::evalCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'evalCoder expects at least 1 argument (the lambda)');
   let lambdaArg = $fe.parametersValues->at(0);
   let argVals   = $fe.parametersValues->slice(1, $fe.parametersValues->size());
   // β-reduction fast path. Pure compiles `someFn_Number_1__Float_1_->eval(x)`
   // by η-expanding the function reference into a lambda `(a -> someFn($a))`.
   // The default cast-to-Function path then emits
   // {@code ((Function<Object,Object>)(Number a) -> Math.someFn(a.doubleValue())).apply(x)}
   // which javac rejects because Function is invariant and `(Number a) -> ...`
   // doesn't satisfy `Function<Object, Object>`. By β-reducing — substituting
   // the eval args for the lambda's parameter references — we collapse to
   // {@code Math.someFn(((Number) x).doubleValue())} and let the inner
   // coder generate idiomatic Java. Works for any function with a coder
   // (cbrt, sqrt, sin, cos, log, ...) AND for UDF refs (helper-class call).
   let inlined = $conv->tryInlineLambdaAtomicValue($lambdaArg, $argVals);
   if ($inlined->isNotEmpty(),
      | $inlined->toOne(),
      | $conv->evalCoderFallback($lambdaArg, $argVals)
   );
}

// Original evalCoder path — cast the lambda to Supplier / Function /
// BiFunction by arity and invoke .get / .apply. Used when β-reduction
// can't apply (non-literal lambda, multi-statement body, arity mismatch).
function <<access.private>> meta::external::language::java::translation::evalCoderFallback(
   conv: Conventions[1],
   lambdaArg: ValueSpecification[1],
   argVals: ValueSpecification[*]
): Code[1]
{
   let lambdaCode = $conv->translateExpression($lambdaArg);
   let evalArgs   = $argVals->map(p | $conv->translateExpression($p));
   if ($evalArgs->isEmpty(),
       | $lambdaCode->j_cast(javaSupplier(javaObject()))->j_invoke('get', [], javaObject()),
       |if ($evalArgs->size() == 1,
            | $lambdaCode->j_cast(javaFunction(javaObject(), javaObject()))->j_invoke('apply', $evalArgs, javaObject()),
            |if ($evalArgs->size() == 2,
                 | $lambdaCode->j_cast(javaBiFunction(javaObject(), javaObject(), javaObject()))->j_invoke('apply', $evalArgs, javaObject()),
                 | fail('evalCoder: arities > 2 not yet supported, got ' + $evalArgs->size()->toString()); j_null();
             )
        )
   );
}

// β-reduction fast path. If `lambdaArg` is an {@link AtomicValue} wrapping a
// {@link LambdaFunction} with N parameters that match N eval args, substitute
// each {@code VariableExpression($paramName)} in the lambda body with the
// corresponding eval arg and translate the substituted body directly. Returns
// empty if the shape doesn't match.
function <<access.private>> meta::external::language::java::translation::tryInlineLambdaAtomicValue(
   conv: Conventions[1],
   lambdaArg: ValueSpecification[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if (!$lambdaArg->instanceOf(AtomicValue),
      | []->cast(@Code),
      | $conv->tryInlineLambdaFromAV($lambdaArg->cast(@AtomicValue), $evalArgs)
   );
}

function <<access.private>> meta::external::language::java::translation::tryInlineLambdaFromAV(
   conv: Conventions[1],
   av: AtomicValue[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if ($av.value->isEmpty(),
      | []->cast(@Code),
      | $conv->tryInlineFuncValue($av.value->toOne(), $evalArgs)
   );
}

// Dispatch on the AV's wrapped value: literal LambdaFunction → β-reduce
// via parameter substitution. {@link PackageableFunction} reference (e.g.
// {@code tan_Number_1__Float_1_}) → synthesise a {@link FunctionExpression}
// with the function's short name and route through the coder map. Other
// values: skip (evalCoder falls back to its Function-cast path).
function <<access.private>> meta::external::language::java::translation::tryInlineFuncValue(
   conv: Conventions[1],
   v: Any[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if ($v->instanceOf(LambdaFunction),
      | $conv->tryInlineLambda($v->cast(@LambdaFunction<Any>), $evalArgs),
      | if ($v->instanceOf(meta::pure::metamodel::function::PackageableFunction),
           | $conv->tryInlinePackageableFunction($v->cast(@meta::pure::metamodel::function::PackageableFunction<Any>), $evalArgs),
           | []->cast(@Code)
        )
   );
}

// Function reference: build a synthetic {@code FunctionExpression(functionName=...,
// parametersValues=[args])} and translate via the coder map. Mirrors what
// would have been emitted if the user had written `fn(args)` directly.
// Returns empty when no coder OR no UDF helper-class match — caller
// falls back to the typed-lambda cast path which usually fails javac.
function <<access.private>> meta::external::language::java::translation::tryInlinePackageableFunction(
   conv: Conventions[1],
   fn: meta::pure::metamodel::function::PackageableFunction<Any>[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let shortName = $fn.functionName->toOne();
   // Synthetic FE genericType is required but inconsequential for translation
   // (coders read it for type-aware emit but eval-routed natives don't need
   // it). Use an empty {@code CompilerNotSetGenericType} placeholder.
   let synthetic = ^meta::pure::metamodel::valuespecification::FunctionInvocation(
      functionName     = $shortName,
      parametersValues = $evalArgs,
      func             = $fn,
      multiplicity     = meta::pure::metamodel::multiplicity::PureOne,
      genericType      = ^meta::pure::metamodel::type::generics::CompilerNotSetGenericType()
   );
   // Route through the coder map when present; otherwise check UDF helper
   // class dispatch (translateUdfCall handles UserDefinedFunction targets).
   let coderOpt = $conv.functionCoders->get($shortName);
   if ($coderOpt->isNotEmpty(),
      | [$coderOpt->toOne()->eval($synthetic, $conv)],
      | if ($fn->instanceOf(meta::pure::metamodel::function::UserDefinedFunction),
           | [$conv->translateUdfCall($synthetic)],
           | []->cast(@Code)
        )
   );
}

function <<access.private>> meta::external::language::java::translation::tryInlineLambda(
   conv: Conventions[1],
   lambda: LambdaFunction<Any>[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let params = $lambda.parameters;
   let body   = $lambda.expressionSequence;
   // Match arity AND single-expression body — multi-statement bodies need
   // a Block wrapper which doesn't fit cleanly into expression position.
   if ($params->size() != $evalArgs->size() || $body->size() != 1,
      | []->cast(@Code),
      | $conv->inlineLambdaBody($params, $body->at(0), $evalArgs)
   );
}

function <<access.private>> meta::external::language::java::translation::inlineLambdaBody(
   conv: Conventions[1],
   params: meta::pure::metamodel::valuespecification::VariableExpression[*],
   body: ValueSpecification[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let subs = range(0, $params->size())->map(i |
      ^meta::pure::translation::shared::ParamSub(name = $params->at($i).name, value = $evalArgs->at($i))
   );
   let substituted = $body->meta::pure::translation::shared::substituteVariables($subs);
   [$conv->translateExpression($substituted)];
}

// `format(fmt, args)` -> `String.format(fmt, args.toArray())`. Pure's format
// strings (`%s`, `%d`, etc.) share syntax with java.util.Formatter, so we
// can pass the format string through unchanged. List.toArray() returns
// Object[] which satisfies String.format's varargs.
function <<access.private>> meta::external::language::java::translation::formatCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'formatCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let fmt  = $conv->translateExpression($fe.parametersValues->at(0));
   let args = $conv->translateExpression($fe.parametersValues->at(1));
   j_invoke(javaString(), 'format', [$fmt, $args->j_invoke('toArray', [], javaArray(javaObject()))], javaString());
}

// `print(x)` — Pure returns the formatted-string representation of x AND
// writes it to stdout. We emit only the return path (`String.valueOf(x)`)
// — the stdout side-effect is dropped because expression-position println
// would require wrapping in a Supplier closure. PCT assertions check the
// return value, not what reached stdout, so the round-trip still validates
// semantics for the cases we care about.
function <<access.private>> meta::external::language::java::translation::printCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n == 1 || $n == 2, | 'printCoder expects 1 or 2 arguments, got ' + $n->toString());
   // Pure: print(value) and print(value, maxChars). Both return a String.
   // We ignore the max-char truncation arg — the value's String.valueOf form
   // is sufficient for the PCT-level equality assertions; PCT tests don't
   // currently validate the truncation behaviour at the Java surface.
   j_invoke(javaString(), 'valueOf', [$conv->translateExpression($fe.parametersValues->at(0))], javaString());
}

// `coll->sort()` — natural-order sort. Stream.sorted() on natural order
// requires the elements implement Comparable; PCT tests typically sort
// Number/String collections so this is fine. The 2-arg form (custom
// comparator) is more involved and currently fails through to the
// arity assert.
function <<access.private>> meta::external::language::java::translation::sortCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n >= 1 && $n <= 3, | 'sortCoder expects 1, 2, or 3 arguments, got ' + $n->toString());
   let stream = $conv->translateExpression($fe.parametersValues->at(0))
                  ->j_invoke('stream', [], javaStream(javaObject()));
   let sorted = if ($n == 1,
      | $stream->j_invoke('sorted', [], javaStream(javaObject())),
      | $conv->sortStreamWithArgs($stream, $fe.parametersValues)
   );
   $sorted->j_invoke('toList', [], javaList(javaObject()));
}

// Apply the comparator/key-extractor args to a stream. 2-arg form: cast the
// 2nd arg to {@code Comparator} and hand to {@code Stream.sorted}. 3-arg
// form (key + comparator): compose via {@code Comparator.comparing(key, comp)}.
function <<access.private>> meta::external::language::java::translation::sortStreamWithArgs(conv: Conventions[1], stream: Code[1], args: ValueSpecification[*]): Code[1]
{
   let cmpClass = javaClass('java.util.Comparator');
   let fnClass  = javaClass('java.util.function.Function');
   // Raw casts for Function / Comparator targets — the factory's lambda-cast
   // path only whitelists Function/Supplier and trips its assert on
   // Comparator; for Function it inserts a body rewrite that's overly strict
   // for typed Pure lambdas like {@code {String s -> s}}.
   let cmp = if ($args->size() == 2,
      | $conv->translateExpression($args->at(1))->j_castWithoutChecks($cmpClass),
      | j_invoke($cmpClass, 'comparing',
           [$conv->translateExpression($args->at(1))->j_castWithoutChecks($fnClass),
            $conv->translateExpression($args->at(2))->j_castWithoutChecks($cmpClass)],
           $cmpClass)
   );
   $stream->j_invoke('sorted', [$cmp], javaStream(javaObject()));
}

// `if(cond, |thenLambda, |elseLambda)` — Pure's lazy conditional. Pure
// represents the branches as zero-arg thunks so only one is evaluated.
// We emit a Java ternary `cond ? thenBody : elseBody` and inline the
// lambda bodies when they're literal thunks (the common case) so the
// emitted Java stays compact. If a branch is a non-literal expression
// yielding a Function (rare), we fall back to `((Supplier) f).get()`.
function <<access.private>> meta::external::language::java::translation::ifCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'ifCoder expects exactly 3 arguments (cond, then-thunk, else-thunk), got ' + $fe.parametersValues->size()->toString());
   let cond = $conv->translateExpression($fe.parametersValues->at(0));
   let thenBody = $conv->thunkArgToBody($fe.parametersValues->at(1));
   let elseBody = $conv->thunkArgToBody($fe.parametersValues->at(2));
   j_conditional($cond, $thenBody, $elseBody);
}

function <<access.private>> meta::external::language::java::translation::thunkArgToBody(conv: Conventions[1], vs: ValueSpecification[1]): Code[1]
{
   if ($vs->instanceOf(AtomicValue),
      | let val = $vs->cast(@AtomicValue).value;
        if ($val->size() == 1 && $val->toOne()->instanceOf(LambdaFunction),
           | let lambda = $val->toOne()->cast(@LambdaFunction<Any>);
             let exprs = $lambda.expressionSequence;
             if ($exprs->size() == 1,
                | $conv->translateExpression($exprs->toOne()),
                | j_block($conv->buildJavaBody($exprs->toOneMany()))
             );,
           | // Non-lambda atomic value — translate and treat as Supplier.
             $conv->translateExpression($vs)->j_cast(javaSupplier(javaObject()))->j_invoke('get', [], javaObject())
        );,
      | $conv->translateExpression($vs)->j_cast(javaSupplier(javaObject()))->j_invoke('get', [], javaObject())
   );
}

// `isEmpty(x)` — Pure's `[0..1]` "is the value empty?" check. Multi-valued
// args route through Collection.isEmpty; scalar nullable args route through
// `x == null`. The dispatch uses the arg's compile-time multiplicity.
function <<access.private>> meta::external::language::java::translation::isEmptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'isEmptyCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let arg  = $fe.parametersValues->at(0);
   let code = $conv->translateExpression($arg);
   let mult = $arg.multiplicity->toOne();
   if ($mult->meta::pure::functions::meta::isToMany(),
      | $code->j_cast(javaCollection(javaObject()))->j_invoke('isEmpty', [], javaBoolean()),
      | j_eq($code, j_null())
   );
}

// `size(coll)` — Pure's size returns Integer (Java long); Collection.size
// returns int, so cast the result. Multi-valued only; scalar args have
// size = 1 conceptually but Pure rarely calls size on scalars.
function <<access.private>> meta::external::language::java::translation::sizeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'sizeCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateExpression($fe.parametersValues->at(0));
   j_cast($coll->j_cast(javaCollection(javaObject()))->j_invoke('size', [], javaInt()), javaLong());
}

// `length(str)` — String.length() returns int; Pure's length returns
// Integer (Java long), so cast.
function <<access.private>> meta::external::language::java::translation::lengthCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'lengthCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let s = $conv->translateExpression($fe.parametersValues->at(0));
   j_cast($s->j_cast(javaString())->j_invoke('length', [], javaInt()), javaLong());
}

// `isNotEmpty(x)` — inverse of {@link isEmptyCoder}. Multi-value -> Collection.isEmpty
// negated; scalar [0..1] -> non-null check. The two shapes don't collapse to
// `size > 0` because the scalar branch must avoid casting to Collection.
function <<access.private>> meta::external::language::java::translation::isNotEmptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'isNotEmptyCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let arg  = $fe.parametersValues->at(0);
   let code = $conv->translateExpression($arg);
   let mult = $arg.multiplicity->toOne();
   if ($mult->meta::pure::functions::meta::isToMany(),
      | j_not($code->j_cast(javaCollection(javaObject()))->j_invoke('isEmpty', [], javaBoolean())),
      | j_ne($code, j_null())
   );
}

// `empty()` (0-arg) — returns Pure's empty collection. Java equivalent is
// {@code java.util.Collections.emptyList()}.
function <<access.private>> meta::external::language::java::translation::emptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->isEmpty(), | 'emptyCoder expects 0 arguments, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaCollections(), 'emptyList', [], javaList(javaObject()));
}

// `head(coll)` — Pure: first element (or empty if list is empty). Java:
// {@code coll.isEmpty() ? null : coll.get(0)}. Cast through Collection→List
// so the index-based accessor is available; Pure callers receive {@code [0..1]}.
function <<access.private>> meta::external::language::java::translation::headCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'headCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let listCode = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaList(javaObject()));
   j_conditional(
      $listCode->j_invoke('isEmpty', [], javaBoolean()),
      j_null(),
      $listCode->j_invoke('get', [j_int(0)], javaObject())
   );
}

// `last(coll)` — mirror of {@link headCoder} from the other end. Empty list
// returns empty (null); otherwise {@code coll.get(coll.size() - 1)}.
function <<access.private>> meta::external::language::java::translation::lastCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'lastCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let listCode = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaList(javaObject()));
   j_conditional(
      $listCode->j_invoke('isEmpty', [], javaBoolean()),
      j_null(),
      $listCode->j_invoke('get', [j_minus($listCode->j_invoke('size', [], javaInt()), j_int(1))], javaObject())
   );
}

// `tail(coll)` — everything except the first element. Empty stays empty.
// Wraps the {@code subList} view in a fresh ArrayList because Pure-side
// equality unwraps standard collections but doesn't recognise AbstractList
// SubList views, so {@code assertEquals(expected, tail([a,b,c]))} would
// report a spurious mismatch on visually-identical lists. Uses RAW
// {@code ArrayList} (not {@code ArrayList<Object>}) so the conditional
// flows into a method whose inferred return type is e.g. {@code List<String>}
// without triggering Java's invariant-generics check.
function <<access.private>> meta::external::language::java::translation::tailCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'tailCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let listCode = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaList(javaObject()));
   j_conditional(
      $listCode->j_invoke('isEmpty', [], javaBoolean()),
      j_new(javaArrayList(), []),
      j_new(javaArrayList(),
         [$listCode->j_invoke('subList', [j_int(1), $listCode->j_invoke('size', [], javaInt())], javaList(javaObject()))])
   );
}

// `init(coll)` — everything except the last element. Same SubList→ArrayList
// wrap (and raw-type rationale) as {@link tailCoder}.
function <<access.private>> meta::external::language::java::translation::initCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'initCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let listCode = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaList(javaObject()));
   j_conditional(
      $listCode->j_invoke('isEmpty', [], javaBoolean()),
      j_new(javaArrayList(), []),
      j_new(javaArrayList(),
         [$listCode->j_invoke('subList', [j_int(0), j_minus($listCode->j_invoke('size', [], javaInt()), j_int(1))], javaList(javaObject()))])
   );
}

// `reverse(coll)` — Pure: returns a fresh reversed list. {@code Collections.reverse}
// mutates in place, so we wrap in a copy first via {@code new ArrayList<>(coll)}.
// Pass the raw listCode (no Collection cast) into the ArrayList ctor; Java's
// {@code <? extends T>} ArrayList(Collection) overload accepts any List
// directly. Casting to {@code Collection<Object>} would flip the variance
// rules and fail to compile.
function <<access.private>> meta::external::language::java::translation::reverseCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'reverseCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let listCode = $conv->translateExpression($fe.parametersValues->at(0));
   // Raw ArrayList / raw List throughout the Supplier IIFE — same rationale
   // as {@link tailCoder}'s raw-type choice: the result threads into method
   // signatures whose return type is e.g. {@code List<String>}, which raw
   // List flows into without an invariant-generics rejection.
   let rawList = javaList();
   let copy = j_new(javaArrayList(), [$listCode]);
   let reverseCall = j_invoke(javaCollections(), 'reverse', [j_variable($rawList, 'list')], javaVoid());
   let supplierBody = j_block([
      j_declare($rawList, 'list', $copy),
      j_expressionStatement($reverseCall),
      j_return(j_variable($rawList, 'list'))
   ]);
   j_lambda([], $supplierBody)
      ->j_cast(javaSupplier($rawList))
      ->j_invoke('get', [], $rawList);
}

// `parseFloat(str)` — Pure: returns Float. Java: {@code Double.parseDouble(s)}
// since Pure's Float maps to Java double (see pureTypeToJavaType).
function <<access.private>> meta::external::language::java::translation::parseFloatCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'parseFloatCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let s = $conv->translateExpression($fe.parametersValues->at(0));
   j_invoke(javaClass('java.lang.Double'), 'parseDouble', [$s->j_cast(javaString())], javaDouble());
}

// `parseInteger(str)` — Pure: returns Integer. Java: {@code Long.parseLong(s)}.
function <<access.private>> meta::external::language::java::translation::parseIntegerCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'parseIntegerCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let s = $conv->translateExpression($fe.parametersValues->at(0));
   j_invoke(javaClass('java.lang.Long'), 'parseLong', [$s->j_cast(javaString())], javaLong());
}

// `parseDate(str)` — heuristic mirroring the type mapping: try the broadest
// parser via {@link normalizePureDate} preprocessing on the Pure side.
// {@code LocalDateTime.parse(s)} handles the ISO offset-less form; for
// date-only strings javac falls through to LocalDate. Most PCT tests use
// the date-time form, so default to LocalDateTime — callers cast to a
// narrower temporal type as needed.
function <<access.private>> meta::external::language::java::translation::parseDateCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'parseDateCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let s = $conv->translateExpression($fe.parametersValues->at(0));
   j_invoke(javaClass('java.time.LocalDateTime'), 'parse', [$s->j_cast(javaString())], javaClass('java.time.temporal.Temporal'));
}

