// {@code s.split(...)} array in {@code Arrays.asList} so the result is a
// {@code List<String>} matching the [*] multiplicity. {@code String.split}
// uses regex; PCT tests' tokens are literal so the regex meta-char risk is
// limited, but a fully Pure-faithful version would call
// {@code Pattern.quote} first.
function <<access.private>> platform::extensions::language::java::translation::splitCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'splitCoder expects exactly 2 arguments');
   let s     = $conv->translateExpression($fe.parametersValues->at(0));
   let token = $conv->translateExpression($fe.parametersValues->at(1));
