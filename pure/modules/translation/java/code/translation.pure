   // the function's signature) has no Java operator: compare their values.
   // Java has no operator for two `Number`s (a function reference's parameters
   // are typed by its signature): compare or compute on their values.
   let compares  = ($resultTypeOpt->isNotEmpty() && $resultTypeOpt->toOne() == Boolean)
                   || ($left.type == javaNumber() && $right.type == javaNumber());
