// `empty()` (0-arg) — returns Pure's empty collection. Java equivalent is
// {@code java.util.Collections.emptyList()}.
function <<access.private>> meta::external::language::java::translation::emptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
