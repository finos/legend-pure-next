import meta::external::language::java::factory::*;
import meta::external::language::java::metamodel::*;
import meta::external::language::java::translation::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::valuespecification::*;

// Ultra-minimal Pure -> Java translator. Models legend-engine's strategy:
//   - `Conventions` carries config + per-Pure-function coders
//   - `translateFunction` produces a `FunctionSignature` (owning Java class + method)
//   - `translateExpression` walks a Pure ValueSpecification, dispatching FunctionExpression
//     calls through the conventions' coder map.
// Only enough surface to translate `add(a, b) { $a + $b }` end-to-end.

Class meta::external::language::java::translation::Conventions
{
   basePackageName : String[1];
   // Element literals (`NativeFunction`, `PureOne`) as the metamodel objects of
   // the Java platform's installed PDBs (Metadata.element), rather than their names.
   metadataElements : Boolean[1];
   // The function being translated, when its lambdas need an address into the
   // metadata (see lambdasInFunction).
   owner            : String[0..1];
   // The Pure variables bound at this point (parameters, enclosing lambdas'
   // parameters, lets already emitted): what a lambda here can capture.
   scope            : String[*];
   functionCoders  : Map<String, meta::pure::metamodel::function::Function<{FunctionExpression[1], Conventions[1] -> Code[1]}>>[1];
   // Which parameter of the function being translated witnesses each of its
   // type parameters: `castAsHint<T>(value:Any[1], hint:T[1])` casts to T, and
   // only the argument passed for `hint` says what T is. Read at the cast site.
   typeVarWitness  : Map<String, TypeVarWitness>[0..1];
}

// A function parameter that witnesses a type parameter, and the multiplicity
// parameter it binds at the same time (`witness:T[m]` binds both T and m).
Class meta::external::language::java::translation::TypeVarWitness
{
   parameter    : String[1];
   mulParameter : String[0..1];
}

Class meta::external::language::java::translation::FunctionSignature
{
   class       : meta::external::language::java::metamodel::Class[1];
   method      : meta::external::language::java::metamodel::Method[1];
   // Additional class definitions (as full Java source strings) to be
   // concatenated alongside the main class in the same compilation unit.
   // Populated by the `new` coder path: every Pure user-defined Class
   // referenced via `^X(props)` gets a generated nested-style Java class
   // with fluent `_propName(value)` setters and a `type()` accessor so
   // expressions like `^X(...).type()` reconstruct Pure's type-of behavior.
   extraClasses: meta::external::language::java::metamodel::Class[*];
   // Java platform types (interfaces, implementations, enums) of the Pure
   // classes and enumerations the program uses, each a `//// FILE <path>`
   // block: they are public types in their own packages, so separate units.
   files       : String[*];
}

// A body being built: the statements so far, and the conventions carrying the
// variables bound by them.
Class meta::external::language::java::translation::BodyScope
{
   conv  : meta::external::language::java::translation::Conventions[1];
   codes : meta::external::language::java::metamodel::Code[*];
}

// What a translated program needs besides its own class (see {@link supportClasses}).
Class meta::external::language::java::translation::SupportCode
{
   classes : meta::external::language::java::metamodel::Class[*];
   files   : String[*];
}

// ----------------------------------------------------------------------------
// Conventions construction — built-in arithmetic coders only for now.
// ----------------------------------------------------------------------------

// Sanitize a Pure identifier for use as a Java identifier. Pure allows names
// that are reserved keywords in Java (e.g. `default`, `class`, `int`, `for`)
// and tests like {@code orElse(value, default)} use them as parameter names.
// Suffix `_` so the emitted Java compiles; the user-facing name stays close
// enough to debug from.
function meta::external::language::java::translation::safeJavaName(name: String[1]): String[1]
{
   if (javaReservedWords()->contains($name), | $name + '_', | $name);
}

function <<access.private>> meta::external::language::java::translation::javaReservedWords(): String[*]
{
   ['abstract','assert','boolean','break','byte','case','catch','char','class','const',
    'continue','default','do','double','else','enum','extends','final','finally','float',
    'for','goto','if','implements','import','instanceof','int','interface','long','native',
    'new','package','private','protected','public','return','short','static','strictfp',
    'super','switch','synchronized','this','throw','throws','transient','try','void',
    'volatile','while']
}

// The Java package of the platform's generated runtime classes (PureMap,
// PureMatch, Variant, PureDate, PureFormat, PureBytes): JDK-only classes every
// translated program calls, generated once by {@link generateRuntimeClasses}.
function meta::external::language::java::translation::runtimePackage(): String[1]
{
   'org.finos.legend.pure.platform.java.runtime'
}

function meta::external::language::java::translation::runtimeClass(simpleName: String[1]): String[1]
{
   runtimePackage() + '.' + $simpleName
}

// Value normalisation as the Pure language sees values: `null` is `[]`, and a
// one-element list is its element. Inlined everywhere before, one class now.
function <<access.private>> meta::external::language::java::translation::pureValuesHelperClass(conv: Conventions[1]): meta::external::language::java::metamodel::Class[1]
{
   javaClass(['public'], meta::external::language::java::translation::runtimeClass('PureValues'))
      ->addMethod(javaMethod(['public', 'static'], javaObject(), 'norm', [j_parameter(javaObject(), 'v')],
           'if (v == null) { return java.util.Collections.emptyList(); }\n'
         + 'return v instanceof java.util.List && ((java.util.List<?>) v).size() == 1 ? ((java.util.List<?>) v).get(0) : v;'))
      ->addMethod(javaMethod(['public', 'static'], javaBoolean(), 'equal', [j_parameter(javaObject(), 'a'), j_parameter(javaObject(), 'b')],
           'Object x = norm(a), y = norm(b);\n'
         // Pure has one zero: Double.equals tells -0.0 from 0.0, and `%-000.000`
         // parses to a negative zero that must still equal the literal 0.0.
         + 'if (x instanceof Double && y instanceof Double && ((Double) x) == 0.0 && ((Double) y) == 0.0) { return true; }\n'
         // A function reference and the element it names are one Pure element.
         + 'if (same(x, y)) { return true; }\n'
         + 'return java.util.Objects.equals(x, y);'))
      ->addMethod(javaMethod(['public', 'static'], javaClass('java.util.Map'), 'captures', [j_parameter(javaList(), 'namesAndValues')],
           'java.util.LinkedHashMap<Object, Object> captures = new java.util.LinkedHashMap<>();\n'
         + 'for (int i = 0; i + 1 < namesAndValues.size(); i += 2) {\n'
         + '    captures.put(namesAndValues.get(i), new org.finos.legend.pure.m3.meta.pure.functions.collection.ListImpl()._values(list(namesAndValues.get(i + 1))));\n'
         + '}\n'
         + 'return captures;'))
      ->addMethod(javaMethod(['public', 'static'], javaList(), 'list', [j_parameter(javaObject(), 'v')],
           'if (v == null) { return java.util.Collections.emptyList(); }\n'
         + 'return v instanceof java.util.List ? (java.util.List) v : java.util.Collections.singletonList(v);'))
      ->addMethod(javaMethod(['public', 'static'], javaObject(), 'one', [j_parameter(javaObject(), 'v')],
           'if (!(v instanceof java.util.List)) { return v; }\n'
         + 'java.util.List<?> l = (java.util.List<?>) v;\n'
         + 'return l.isEmpty() ? null : l.get(0);'))
      ->addMethod(javaMethod(['public', 'static'], javaBoolean(), 'same', [j_parameter(javaObject(), 'a'), j_parameter(javaObject(), 'b')],
           'Object x = norm(a), y = norm(b);\n'
         // A function reference is the element it names.
         + 'Object ea = org.finos.legend.pure.platform.java.pdb.PureLambda.elementOf(x);\n'
         + 'Object eb = org.finos.legend.pure.platform.java.pdb.PureLambda.elementOf(y);\n'
         + 'return (ea == null ? x : ea) == (eb == null ? y : eb);'))
      // Java has no unary minus for Number: `-n` where n is a function
      // parameter typed Number (Pure's minus accepts any). Each kind keeps its
      // own, so negating an Integer is an Integer.
      ->addMethod(javaMethod(['public', 'static'], javaObject(), 'negate', [j_parameter(javaObject(), 'v')],
           'if (v instanceof Long) { return -((Long) v); }\n'
         + 'if (v instanceof Double) { return -((Double) v); }\n'
         + 'if (v instanceof java.math.BigDecimal) { return ((java.math.BigDecimal) v).negate(); }\n'
         + 'if (v instanceof Number) { return -((Number) v).doubleValue(); }\n'
         + 'throw new RuntimeException("Cannot negate " + (v == null ? "[]" : v.getClass().getName()));'));
}

// The runtime classes as `//// FILE <path>` blocks, for the Java platform to compile.
function <<test.TestDependency>> meta::external::language::java::translation::generateRuntimeClasses(): String[1]
{
   let conv = defaultConventions(runtimePackage());
   [
      pair('PureValues', $conv->pureValuesHelperClass()),
      pair('PureMap',    $conv->pureMapHelperClass()),
      pair('PureMatch',  $conv->pureMatchHelperClass()),
      pair('Variant',    $conv->pureVariantHelperClass()),
      pair('PureDate',   $conv->pureDateHelperClass()),
      pair('PureFormat', $conv->pureFormatHelperClass()),
      pair('PureBytes',  $conv->pureBytesHelperClass())
   ]->map(p | '//// FILE ' + runtimeClass($p.first)->replace('.', '/') + '.java\n' + $p.second->meta::external::language::java::serialization::classToString())
    ->joinStrings('\n');
}

