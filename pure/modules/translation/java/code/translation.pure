function <<access.private>> platform::extensions::language::java::translation::findAllTypesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($conv.metadataElements, | 'No coder for Pure function: findAllTypes');
   j_invoke(javaClass(compilationClass()), 'findAllTypes', [], javaList());
}

function <<access.private>> platform::extensions::language::java::translation::findFunctionsByNameAndArityCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'findFunctionsByNameAndArityCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: findFunctionsByNameAndArity');
   j_invoke(javaClass(compilationClass()), 'findFunctionsByNameAndArity',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode(),
             $conv->translateExpression($fe.parametersValues->at(1))->toObjectCode()], javaList());
}

// `unescapePureString(s)` — a native because a chained replace is not stable
// under self-hosting (the patterns distort themselves).
function <<access.private>> platform::extensions::language::java::translation::unescapePureStringCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'unescapePureStringCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaClass(compilationClass()), 'unescapePureString',
            [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString())], javaString());
}

// `normalizeDateString(s)` — a date literal as the metadata stores it.
function <<access.private>> platform::extensions::language::java::translation::normalizeDateStringCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'normalizeDateStringCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaClass(compilationClass()), 'normalizeDateString',
            [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString())], javaString());
}

function <<access.private>> platform::extensions::language::java::translation::compilationClass(): String[1]
{
   'org.finos.legend.pure.platform.java.compiler.Compilation'
}

// `parse(sourceId, content)` — Pure source to a PureFile, through the Top
// grammar and the translated section parsers (see the platform's PureParsing).
// `@X` / `@X|1` as a value: the platform's holder over the type it names.
// The type a holder's generic type names: its first type argument when the
// generic type is the holder class itself, else the raw type.
function <<access.private>> platform::extensions::language::java::translation::namedTypeOfHolder(g: platform::pure::metamodel::type::generics::GenericType[1]): platform::pure::metamodel::type::Type[*]
{
   let raw  = $g->rawType();
   let args = if ($g->instanceOf(platform::pure::metamodel::type::generics::UserDefinedGenericType),
                  | $g->cast(@platform::pure::metamodel::type::generics::UserDefinedGenericType).typeArguments->map(t | $t->rawType()),
                  | []->cast(@platform::pure::metamodel::type::Type));
   let isHolder = $raw->isNotEmpty()
                  && $raw->toOne()->instanceOf(platform::pure::metamodel::PackageableElement)
                  && $raw->toOne()->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()->endsWith('GenericTypeAndMultiplicityHolder');
   if ($isHolder && $args->isNotEmpty(), | $args->at(0), | $raw);
}

function <<access.private>> platform::extensions::language::java::translation::translateTypeHolder(conv: Conventions[1], holder: platform::pure::metamodel::valuespecification::GenericTypeAndMultiplicityHolder[1]): Code[1]
{
   // The VS's own type is the HOLDER (that is what `@X` evaluates to); the type
   // it names is that holder's type argument.
   let raw = $holder.genericType->map(g | $g->namedTypeOfHolder())
                ->filter(t | $t->instanceOf(platform::pure::metamodel::PackageableElement))
                ->cast(@platform::pure::metamodel::PackageableElement);
   assert($conv.metadataElements && $raw->isNotEmpty(), | 'No coder for Pure function: genericTypeHolder');
   j_invoke(javaClass($conv->pdbClass('Metadata')), 'genericTypeHolderOf',
            [j_string($raw->toOne()->elementToPath())], javaObject());
}

// `genericTypeHolder(value)` — the value's own type and multiplicity, as a value.
function <<access.private>> platform::extensions::language::java::translation::genericTypeHolderCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'genericTypeHolderCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: genericTypeHolder');
   j_invoke(javaClass($conv->pdbClass('Metadata')), 'genericTypeHolder',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaObject());
}

function <<access.private>> platform::extensions::language::java::translation::parseCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'parseCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: parse');
   $conv->parseCall($fe.parametersValues->at(0), $fe.parametersValues->at(1));
}

function <<access.private>> platform::extensions::language::java::translation::parseCall(conv: Conventions[1], sourceId: ValueSpecification[1], content: ValueSpecification[1]): Code[1]
{
   j_invoke(javaClass($conv->platformClass('grammar.PureParsing')), 'parse',
            [$conv->translateExpression($sourceId)->j_cast(javaString()),
             $conv->translateExpression($content)->j_cast(javaString())], javaObject());
}

// `resolveAndReturnGraph(elements)` — the compiler's pointer-resolution
// boundary: every TempCompilerPointer the passes wove into the graph is swapped
// for the live element it names, and each entry comes back deep-copied.
function <<access.private>> platform::extensions::language::java::translation::resolveAndReturnGraphCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'resolveAndReturnGraphCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: resolveAndReturnGraph');
   j_invoke(javaClass($conv->pdbClass('PointerGraph')), 'resolveAndReturnGraph',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaList());
}

// `writeFile(path, content)` — writes the file, parent directories included,
// and returns the path.
function <<access.private>> platform::extensions::language::java::translation::writeFileCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'writeFileCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   $conv->runtimeCall('PureFiles', 'writeFile', [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString()), $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaString())], javaString());
}

// `currentTimeMillis()` — milliseconds since the epoch.
function <<access.private>> platform::extensions::language::java::translation::currentTimeMillisCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->isEmpty(), | 'currentTimeMillisCoder expects no argument, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaClass('java.lang.System'), 'currentTimeMillis', [], javaLong());
}

// `withSilencedPrint(body)` — the body's value. Translated `print` formats a
// value and returns the text without writing it, so there is nothing to silence.
function <<access.private>> platform::extensions::language::java::translation::withSilencedPrintCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'withSilencedPrintCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   // Run the body with stdout muted: the test runner wraps every test body in
   // this so a test's own prints do not interleave with the progress display,
   // while the runner's own prints (tickProgress) stay visible.
   let body = $conv->thunkArgToBody($fe.parametersValues->at(0));
   j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureOut')), 'silenced',
            [j_lambda([], j_block([j_return($body->toObjectCode())]))->j_castWithoutChecks(javaSupplier(javaObject()))],
            javaObject())
      ->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed(), $conv);
}

// `directoryTree(path)` — every regular file under `path`, recursively, sorted.
// The corpus suites walk a fixture directory with it.
function <<access.private>> platform::extensions::language::java::translation::directoryTreeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'directoryTreeCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   $conv->runtimeCall('PureFiles', 'directoryTree', [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString())], javaList());
}

// `readFileBytes(path)` — the file's bytes as Pure Integers, through the
// platform's PureBytes list view (runtime library).
function <<access.private>> platform::extensions::language::java::translation::readFileBytesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'readFileBytesCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   // A Binary is the raw byte[]: no PureBytes view, no boxing.
   $conv->runtimeCall('PureFiles', 'readFileBytes', [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString())], javaArray(javaByte()));
}

// `reverseString(s)`
function <<access.private>> platform::extensions::language::java::translation::reverseStringCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'reverseStringCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_new(javaClass('java.lang.StringBuilder'), [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString())])
      ->j_invoke('reverse', [], javaClass('java.lang.StringBuilder'))->j_invoke('toString', [], javaString());
}

// `let x = v` used as an expression (the last one of a lambda body): its value.
function <<access.private>> platform::extensions::language::java::translation::letFunctionCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'letFunctionCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   $conv->translateExpression($fe.parametersValues->at(1));
}

// `substring` — two overloads: (s, start) and (s, start, end). Both indices
// are Pure Integer (Java long); narrow to int for String.substring.
function <<access.private>> platform::extensions::language::java::translation::substringCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let args = $fe.parametersValues;
   if ($args->size() == 2, | $conv->substring2($args),
   |if ($args->size() == 3, | $conv->substring3($args),
      | fail('substringCoder: expected 2 or 3 args, got ' + $args->size()->toString()); j_null();
   ));
}

function <<access.private>> platform::extensions::language::java::translation::substring2(conv: Conventions[1], args: ValueSpecification[*]): Code[1]
{
   let s     = $conv->translateExpression($args->at(0));
   let start = $conv->translateExpression($args->at(1));
   $s->j_invoke('substring', [j_cast($start, javaInt())], javaString());
}

function <<access.private>> platform::extensions::language::java::translation::substring3(conv: Conventions[1], args: ValueSpecification[*]): Code[1]
{
   let s     = $conv->translateExpression($args->at(0));
   let start = $conv->translateExpression($args->at(1));
   let end   = $conv->translateExpression($args->at(2));
   $s->j_invoke('substring', [j_cast($start, javaInt()), j_cast($end, javaInt())], javaString());
}

// `indexOf(s, val)` — String.indexOf or List.indexOf returns int → cast to
// long. Both Pure overloads (string-in-string and value-in-collection)
// share the Java method name.
function <<access.private>> platform::extensions::language::java::translation::indexOfCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2 || $fe.parametersValues->size() == 3, | 'indexOfCoder expects 2 or 3 arguments, got ' + $fe.parametersValues->size()->toString());
   let receiver = $conv->translateExpression($fe.parametersValues->at(0));
   let val      = $conv->translateExpression($fe.parametersValues->at(1));
   let from     = $fe.parametersValues->slice(2, 3)->map(v | $conv->translateExpression($v)->j_cast(javaLong())->j_cast(javaInt()));
   j_cast($receiver->j_invoke('indexOf', $val->concatenate($from), javaInt()), javaLong());
}

function <<access.private>> platform::extensions::language::java::translation::parseBooleanCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'parseBooleanCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaClass('java.lang.Boolean'), 'parseBoolean', [$conv->translateExpression($fe.parametersValues->at(0))], javaBoolean());
}

// `parseDecimal(s)` and `parseDecimal(s, precision, scale)` — a BigDecimal,
// the 3-argument form rounded HALF_UP to `scale` digits.
function <<access.private>> platform::extensions::language::java::translation::parseDecimalCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1 || $fe.parametersValues->size() == 3, | 'parseDecimalCoder expects 1 or 3 arguments, got ' + $fe.parametersValues->size()->toString());
   // A trailing d / D (Pure's Decimal literal suffix) is accepted.
   let text   = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString())->j_invoke('trim', [], javaString())
                   ->j_invoke('replaceFirst', [j_string('[dD]$'), j_string('')], javaString());
   let parsed = j_new(javaBigDecimal(), [$text]);
   if ($fe.parametersValues->size() == 1,
      | $parsed,
      | $parsed->j_invoke('setScale', [
           $conv->translateExpression($fe.parametersValues->at(2))->j_cast(javaLong())->j_cast(javaInt()),
           j_field(javaClass('java.math.RoundingMode'), 'HALF_UP', javaClass('java.math.RoundingMode'))], javaBigDecimal()));
}

// `regexpLike(s, pattern)` — partial match. Two overloads; the 3-arg form
// adds optional regex parameters (case-sensitivity, multi-line, ...) that
// we ignore for now and still compile with default flags. Tests sensitive
// to the parameters will diverge.
function <<access.private>> platform::extensions::language::java::translation::regexpLikeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 2, | 'regexpLikeCoder expects at least 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let s     = $conv->translateExpression($fe.parametersValues->at(0));
   let pat   = $conv->translateExpression($fe.parametersValues->at(1));
   let flags = if ($fe.parametersValues->size() > 2, | $fe.parametersValues->at(2)->enumLiteralNames()->javaRegexFlags(), | 0);
   j_invoke(javaClass('java.util.regex.Pattern'), 'compile', [$pat, j_int($flags)], javaClass('java.util.regex.Pattern'))
      ->j_invoke('matcher', [$s], javaClass('java.util.regex.Matcher'))
      ->j_invoke('find', [], javaBoolean());
}

// Names of the enum literals in `vs`, read statically, in the shapes
// {@link extractChronoUnitRef} handles: an AtomicValue holding Enums, the
// `Enumeration.VALUE` access expression, or a Collection of either.
function <<access.private>> platform::extensions::language::java::translation::enumLiteralNames(vs: ValueSpecification[1]): String[*]
{
   $vs->match([
      a: AtomicValue[1] | $a.value->filter(v | $v->instanceOf(platform::pure::metamodel::type::Enum))->cast(@platform::pure::metamodel::type::Enum)->map(e | $e.name->toOne()),
      c: Collection[1]  | $c.values->map(v | $v->enumLiteralNames()),
      fe: FunctionExpression[1] | $fe.functionName,
      other: ValueSpecification[1] | []->cast(@String)
   ]);
}

// Pure RegexpParameter names -> java.util.regex.Pattern flag bits, matching
// the JS runtime's i / m / s: CASE_INSENSITIVE, MULTILINE, and
// NON_NEWLINE_SENSITIVE (`.` also matches a line terminator, i.e. DOTALL).
function <<access.private>> platform::extensions::language::java::translation::javaRegexFlags(names: String[*]): Integer[1]
{
   $names->removeDuplicates()
      ->map(n | if ($n == 'CASE_INSENSITIVE',      | 2,
               |if ($n == 'MULTILINE',             | 8,
               |if ($n == 'NON_NEWLINE_SENSITIVE', | 32,
                                                   | 0))))
      ->fold({flag, acc | $acc + $flag}, 0);
}

// Assertion coders — Pure's assert* natives THROW on failure. For
// PCT-via-translator we don't need real throws: the inner `$f->eval(|...)`
// is wrapped by an outer `assert(...)` in every PCT test, so returning
// the Boolean result of the check propagates the right signal (true =
// passed, false = outer assert fails the test).
function <<access.private>> platform::extensions::language::java::translation::assertEqualsCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 2, | 'assertEqualsCoder expects at least 2 arguments, got ' + $fe.parametersValues->size()->toString());
   $conv->pureAssertion($fe, true);
}

// assertEquals / assertIs (expectEqual) and assertIsNot: compare the two values
// as Pure's equality does — an absent value (null) is [], a one-element list its
// element — and fail when the outcome isn't the expected one; true otherwise.
function <<access.private>> platform::extensions::language::java::translation::pureAssertion(conv: Conventions[1], fe: FunctionExpression[1], expectEqual: Boolean[1]): Code[1]
{
   $conv->runtimeCall('PureAsserts', if($expectEqual, | 'assertEqual', | 'assertNotEqual'), [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode(), $conv->translateExpression($fe.parametersValues->at(1))->toObjectCode()], javaBoolean());
}

function <<access.private>> platform::extensions::language::java::translation::assertFalseCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'assertFalseCoder expects at least 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_not($conv->translateExpression($fe.parametersValues->at(0))->asBooleanCode());
}

// `assertIsNot(a, b)` — Pure's negated identity check. Translate as
// `!Objects.equals(a, b)` since j_eq routes objects through Objects.equals.
function <<access.private>> platform::extensions::language::java::translation::assertIsNotCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 2, | 'assertIsNotCoder expects at least 2 arguments, got ' + $fe.parametersValues->size()->toString());
   $conv->pureAssertion($fe, false);
}

// Pure `assert(condition[, message])`: throws when the condition is false — a
// tryEval around it relies on that — and is true otherwise. The message may be
// a String or a `{-> String}` thunk (cast to Supplier: a bare lambda can't sit
// in List.of); a format string with arguments is reported unformatted.
function <<access.private>> platform::extensions::language::java::translation::assertCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n >= 1, | 'assertCoder expects at least 1 argument, got ' + $n->toString());
   let cond = $conv->translateExpression($fe.parametersValues->at(0));
   let msg  = if ($n == 1,                                         | j_string('Assert failed'),
              |if ($fe.parametersValues->at(1)->isLambdaLiteral(), | $conv->translateExpression($fe.parametersValues->at(1))->j_castWithoutChecks(javaClass('java.util.function.Supplier')),
                                                                   | $conv->translateExpression($fe.parametersValues->at(1))));
   $conv->runtimeCall('PureAsserts', 'assertTrue', [$cond->j_cast(javaBoolean()), $msg->toObjectCode()], javaBoolean());
}

// `exists(coll, predicate)` — Stream.anyMatch with the translated predicate.
function <<access.private>> platform::extensions::language::java::translation::existsCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'existsCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   let pred = $conv->translateExpression($fe.parametersValues->at(1));
   $coll->j_invoke('stream',    [], javaStream(javaObject()))
        ->j_invoke('anyMatch',  [$pred->asPredicate()], javaBoolean());
}

// `assertEqWithinTolerance(expected, actual, tolerance)` — numeric closeness.
// Emit `Math.abs((double)actual - (double)expected) <= (double)tolerance`.
function <<access.private>> platform::extensions::language::java::translation::assertEqWithinToleranceCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 3, | 'assertEqWithinToleranceCoder expects at least 3 arguments, got ' + $fe.parametersValues->size()->toString());
   let expected  = $conv->translateExpression($fe.parametersValues->at(0));
   let actual    = $conv->translateExpression($fe.parametersValues->at(1));
   let tolerance = $conv->translateExpression($fe.parametersValues->at(2));
   // Both sides are compared as doubles: either may be Object-typed (a called
   // function's result), which has no `-`.
   let diff      = ^platform::extensions::language::java::metamodel::InfixExpression(
                      left  = $actual->asDoubleCode(),
                      op    = '-',
                      right = $expected->asDoubleCode(),
                      type  = javaDouble());
   let absDiff   = j_invoke(javaMath(), 'abs', [$diff], javaDouble());
   // asDoubleCode on the tolerance too: a Number-typed one (this function's own
   // `delta` parameter, when the 3-arg overload is translated as a UDF class)
   // has no `<=` against a double.
   j_le($absDiff, $tolerance->asDoubleCode());
}

// `value->instanceOf(SomeType)` — Pure runtime type check. Two cases:
//   - User-defined Class: our runtime model is `Map` with a `__class__`
//     marker, so check `"Foo".equals(((Map)v).get("__class__"))`.
//   - Primitive (Integer/Number/Any/Date/etc.): box the value to Object
//     and use Java `instanceof BoxedType`. `Any` -> always-true since
//     anything in Pure is an Object in Java.
// The type arg must be a static literal type reference (the common case);
// dynamic type values aren't supported here.
function <<access.private>> platform::extensions::language::java::translation::instanceOfCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'instanceOfCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let value   = $conv->translateExpression($fe.parametersValues->at(0));
   let typeArg = $fe.parametersValues->at(1);
   // A type known only at run time (`$instance->instanceOf($type)`) is answered
   // from the metadata: the value's type, or one of its generalizations, is it.
   assert($typeArg->instanceOf(AtomicValue) || $conv.metadataElements, | 'instanceOfCoder: type arg must be a literal AtomicValue, got non-AtomicValue');
   if (!$typeArg->instanceOf(AtomicValue),
      | j_invoke(javaClass($conv->pdbClass('Metadata')), 'instanceOf',
                 [$value->toObjectCode(), $conv->translateExpression($typeArg)->toObjectCode()], javaBoolean()),
      | $conv->literalInstanceOf($value, $typeArg->cast(@AtomicValue).value->toOne()));
}

// Any enum value, whatever enumeration it belongs to: a generated platform enum
// is marked with PureEnumValue, and one read from a PDB is a metamodel Enum.
function <<access.private>> platform::extensions::language::java::translation::enumValueInstanceOf(conv: Conventions[1], value: Code[1]): Code[1]
{
   j_or(j_instanceof($value->j_cast(javaObject()), javaClass($conv->pdbClass('PureEnumValue'))),
        j_instanceof($value->j_cast(javaObject()), javaClass(platform::pure::metamodel::type::Enum->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot()))));
}

function <<access.private>> platform::extensions::language::java::translation::literalInstanceOf(conv: Conventions[1], value: Code[1], tval: Any[1]): Code[1]
{
   // An enumeration is the generated Java enum; Any is anything present (it is
   // a Pure Class, and would otherwise emit a non-existent `instanceof Any`).
   if ($tval->instanceOf(platform::pure::metamodel::type::Enumeration),
      | j_instanceof($value->j_cast(javaObject()), $conv->javaEnumType($tval->cast(@platform::pure::metamodel::type::Enumeration<Any>))),
   // `Enum` is ANY enum value, whatever enumeration it belongs to: on the
   // platform that is what PureEnumValue marks (a generated enum implements it;
   // a value read from a PDB is the metamodel Enum itself).
   |if ($tval == platform::pure::metamodel::type::Enum,
      | $conv->enumValueInstanceOf($value),
   |if ($tval == Any,
      | j_ne($value->j_cast(javaObject()), j_null()),
   |if ($tval->instanceOf(platform::pure::metamodel::type::Class),
      | $conv->classInstanceOf($value, $tval->cast(@platform::pure::metamodel::PackageableElement)),
      | $conv->primitiveInstanceOf($value, $tval->cast(@platform::pure::metamodel::type::Type))
   ))));
}

// User-defined class check — our generated helper Java classes share the
// Pure class's short name in the conventions package, so a plain Java
// `instanceof GeneratedClass` works directly.
function <<access.private>> platform::extensions::language::java::translation::classInstanceOf(conv: Conventions[1], value: Code[1], cls: platform::pure::metamodel::PackageableElement[1]): Code[1]
{
   j_instanceof($value->j_cast(javaObject()), javaClass($cls->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot())));
}

// Primitive-side instanceOf: box the value to Object then use Java
// `instanceof BoxedType`. Pure's `Any` maps to Object, which everything in
// Java is — `instanceof Object` is always true.
function <<access.private>> platform::extensions::language::java::translation::primitiveInstanceOf(conv: Conventions[1], value: Code[1], raw: platform::pure::metamodel::type::Type[1]): Code[1]
{
   if ($raw->isDateOrTimeType() && $raw != platform::pure::metamodel::type::primitives::StrictTime,
      | // A PureDate's kind tells StrictDate from DateTime; any PureDate is a Date.
        let kind = if ($raw == platform::pure::metamodel::type::primitives::StrictDate, | 'StrictDate', |if ($raw == platform::pure::metamodel::type::primitives::DateTime, | 'DateTime', | 'Date'));
        j_invoke($conv->javaPureDateType(), 'is', [$value->toObjectCode(), j_string($kind)], javaBoolean());,
      | $conv->primitiveClassInstanceOf($value, $raw));
}

function <<access.private>> platform::extensions::language::java::translation::primitiveClassInstanceOf(conv: Conventions[1], value: Code[1], raw: platform::pure::metamodel::type::Type[1]): Code[1]
{
   let boxed = if ($raw == Integer, | javaClass('java.lang.Long'),
               |if ($raw == Float,   | javaClass('java.lang.Double'),
               |if ($raw == Boolean, | javaClass('java.lang.Boolean'),
               |if ($raw == String,  | javaClass('java.lang.String'),
               |if ($raw == Number,  | javaClass('java.lang.Number'),
               |if ($raw == Any,     | javaObject(),
               |if ($raw == Nil,     | javaObject(),
               |if ($raw == platform::pure::metamodel::type::primitives::Decimal, | javaBigDecimal(),
               |if ($raw->isDateOrTimeType(), | javaClass('java.time.LocalTime'),
                  | javaObject()
               )))))))));
   j_instanceof($value->j_cast(javaObject()), $boxed);
}

// `dateDiff(d1, d2, unit)` and `adjust(date, n, unit)` — PureDate.dateDiff /
// PureDate.adjust, the unit passed by its Pure DurationUnit name.
function <<access.private>> platform::extensions::language::java::translation::dateDiffCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'dateDiffCoder expects exactly 3 arguments (d1, d2, unit), got ' + $fe.parametersValues->size()->toString());
   let d1   = $conv->translateExpression($fe.parametersValues->at(0))->j_castWithoutChecks($conv->javaPureDateType());
   let d2   = $conv->translateExpression($fe.parametersValues->at(1))->j_castWithoutChecks($conv->javaPureDateType());
   j_invoke($conv->javaPureDateType(), 'dateDiff', [$d1, $d2, $conv->durationUnitName($fe.parametersValues->at(2))], javaLong());
}

function <<access.private>> platform::extensions::language::java::translation::adjustCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'adjustCoder expects exactly 3 arguments (date, n, unit), got ' + $fe.parametersValues->size()->toString());
   let date = $conv->translateExpression($fe.parametersValues->at(0))->j_castWithoutChecks($conv->javaPureDateType());
   let n    = $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaLong());
   j_invoke($conv->javaPureDateType(), 'adjust', [$date, $n, $conv->durationUnitName($fe.parametersValues->at(2))], $conv->javaPureDateType());
}

// Date extractors — the matching PureDate method, returning long as Pure's Integer.
function <<access.private>> platform::extensions::language::java::translation::yearCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'year', 'yearCoder');
}

function <<access.private>> platform::extensions::language::java::translation::monthNumberCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'monthNumber', 'monthNumberCoder');
}

function <<access.private>> platform::extensions::language::java::translation::dayOfMonthCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'dayOfMonth', 'dayOfMonthCoder');
}

function <<access.private>> platform::extensions::language::java::translation::hourCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'hour', 'hourCoder');
}

function <<access.private>> platform::extensions::language::java::translation::minuteCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'minute', 'minuteCoder');
}

function <<access.private>> platform::extensions::language::java::translation::secondCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'second', 'secondCoder');
}

function <<access.private>> platform::extensions::language::java::translation::millisCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'millis', 'millisCoder');
}

function <<access.private>> platform::extensions::language::java::translation::dateExtractor(conv: Conventions[1], fe: FunctionExpression[1], javaMethod: String[1], label: String[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | $label + ' expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let date = $conv->translateExpression($fe.parametersValues->at(0))->j_castWithoutChecks($conv->javaPureDateType());
   $date->j_invoke($javaMethod, [], javaLong());
}

// A DurationUnit argument as its name (`"DAYS"`): a literal enum value, the
// `DurationUnit.DAYS` access form, or any enum-valued expression at run time.
function <<access.private>> platform::extensions::language::java::translation::durationUnitName(conv: Conventions[1], unitArg: ValueSpecification[1]): Code[1]
{
   let literal = if ($unitArg->instanceOf(AtomicValue), | $unitArg->cast(@AtomicValue).value->filter(v | $v->instanceOf(platform::pure::metamodel::type::Enum))->cast(@platform::pure::metamodel::type::Enum), | []->cast(@platform::pure::metamodel::type::Enum));
   let access  = $unitArg->instanceOf(FunctionExpression)
                 && $unitArg->cast(@FunctionExpression).parametersValues->size() == 1
                 && $unitArg->cast(@FunctionExpression).parametersValues->at(0)->enumerationLiteral()->isNotEmpty();
   if ($literal->size() == 1, | j_string($literal->toOne().name->toOne()),
   |if ($access,              | j_string($unitArg->cast(@FunctionExpression).functionName->toOne()),
                              | $conv->translateExpression($unitArg)->j_castWithoutChecks(javaClass('java.lang.Enum'))->j_invoke('name', [], javaString())));
}


// `pathToElement(path)` and `lenientPathToElement(path)` — Pure's runtime
// path resolver. The translator can't actually resolve elements at Java
// runtime (no metamodel registry available), so emit the path string
// itself. Downstream uses that compare against `elementToPath` or just
// stringify the result will work; uses that need a real PE will fail.
//
// On the Java platform (`metadataElements`) the element is resolved in the
// installed PDBs: Metadata.element / Metadata.lenientElement.
function <<access.private>> platform::extensions::language::java::translation::pathToElementCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'pathToElementCoder expects at least 1 argument, got ' + $fe.parametersValues->size()->toString());
   let path   = $conv->translateExpression($fe.parametersValues->at(0));
   let method = if ($fe->coderName() == 'lenientPathToElement', | 'lenientElement', | 'element');
   // The path may be written with another separator: `pathToElement('a.b', '.')`.
   let args   = $path->j_castWithoutChecks(javaString())
                   ->concatenate(if ($fe.parametersValues->size() == 2,
                                     | $conv->translateExpression($fe.parametersValues->at(1))->j_castWithoutChecks(javaString()),
                                     | []->cast(@Code)));
   if ($conv.metadataElements,
      | j_invoke(javaClass($conv->pdbClass('Metadata')), $method, $args, javaObject())
           ->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed()),
      | $path);
}

// `rem(a, b)` — Pure's modulo. Java `%` works for both long and double via
// j_remHelper (no j_mod factory exists in the metamodel). Result type
// follows Pure's `Number[1]` return — emit as double which Number-typed
// callers accept after auto-widening.
function <<access.private>> platform::extensions::language::java::translation::remCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'remCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   if ($fe.parametersValues->exists(p | $p->isDecimalTyped()),
      | $conv->asBigDecimal($fe.parametersValues->at(0))->j_invoke('remainder', [$conv->asBigDecimal($fe.parametersValues->at(1))], javaBigDecimal()),
      | $conv->primitiveRem($fe));
}

function <<access.private>> platform::extensions::language::java::translation::primitiveRem(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let a = $conv->translateExpression($fe.parametersValues->at(0));
   let b = $conv->translateExpression($fe.parametersValues->at(1));
   ^platform::extensions::language::java::metamodel::InfixExpression(left=$a, op='%', right=$b, type=javaDouble());
}

// `toRepresentation(x)` — same shape as toString for non-string types;
// strings round-trip with quotes in real Pure but tests that depend on the
// quoted form will diverge here. Good enough for non-string toRepresentation
// cases (Integer, Float, Boolean, Date, ...) and a clean step beyond
// silently failing.
function <<access.private>> platform::extensions::language::java::translation::toRepresentationCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'toRepresentationCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   let element = $fe.parametersValues->at(0)->match([
      a: AtomicValue[1]            | $a.value->filter(v | $v->instanceOf(platform::pure::metamodel::PackageableElement))->cast(@platform::pure::metamodel::PackageableElement),
      other: ValueSpecification[1] | []->cast(@platform::pure::metamodel::PackageableElement)
   ]);
   // A class or function literal is represented by its full path, known now.
   if ($element->size() == 1, | j_string($element->toOne()->elementToPath()), | $conv->valueRepresentation($fe));
}

function <<access.private>> platform::extensions::language::java::translation::valueRepresentation(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   $conv->runtimeCall('PureStrings', 'toRepresentation', [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaString());
}

// `cast(value, type)` — Pure's runtime type assertion. Java's type system
// already erases generics at runtime; we treat cast as identity at the
// translation level (the Pure type checker has already validated the static
// shape). Emit only the operand expression — the unused `type` arg is
// dropped.
// The parameters that witness type parameters, by the name of the parameter they
// witness. A parameter declared `T[m]` witnesses both T and m; the first such
// parameter wins, as the call site binds them all to the same thing.
function <<access.private>> platform::extensions::language::java::translation::witnessesOfTypeParameters(parameters: platform::pure::metamodel::valuespecification::VariableExpression[*]): Map<String, TypeVarWitness>[0..1]
{
   let witnesses = $parameters->map(p | $p->witnessOfParameter())->filter(w | $w->isNotEmpty());
   if ($witnesses->isEmpty(),
      | []->cast(@Map<String, TypeVarWitness>),
      | newMap($witnesses));
}

function <<access.private>> platform::extensions::language::java::translation::witnessOfParameter(parameter: platform::pure::metamodel::valuespecification::VariableExpression[1]): Pair<String, TypeVarWitness>[0..1]
{
   let raw = $parameter.genericType->rawType();
   if ($raw->isEmpty() || !$raw->toOne()->instanceOf(platform::pure::metamodel::type::generics::TypeParameter),
      | []->cast(@Pair<String, TypeVarWitness>),
      | let mul = $parameter.multiplicity;
        let mulName = if ($mul->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity),
                          | []->cast(@String),
                          | $mul->cast(@platform::pure::metamodel::multiplicity::MultiplicityParameter).name);
        pair($raw->toOne()->cast(@platform::pure::metamodel::type::generics::TypeParameter).name->toOne(),
             ^TypeVarWitness(parameter = $parameter.name->platform::extensions::language::java::translation::safeJavaName(),
                             mulParameter = $mulName));
   );
}

function <<access.private>> platform::extensions::language::java::translation::castCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'castCoder expects at least 1 argument, got ' + $fe.parametersValues->size()->toString());
   let value  = $conv->translateExpression($fe.parametersValues->at(0));
   let raw    = $fe.genericType->rawType();
   let target = if ($raw->isNotEmpty() && $raw->toOne()->isCheckedCastTarget(), | $raw->toOne(), | []->cast(@platform::pure::metamodel::type::Type));
   // Any other class (the metamodel's, a function type) is cast unchecked to
   // its Java type, so the value is typed as the Pure expression is.
   let typed  = $raw->isNotEmpty() && $raw->toOne()->instanceOf(platform::pure::metamodel::type::Class) && $raw->toOne() != Any;
   // `cast(@T)` — the type parameter is whatever the call site bound it to, so
   // the check reads it off the argument that witnesses it.
   let witnessed = if ($raw->isNotEmpty() && $raw->toOne()->instanceOf(platform::pure::metamodel::type::generics::TypeParameter),
                       | $conv->witnessFor($raw->toOne()->cast(@platform::pure::metamodel::type::generics::TypeParameter)),
                       | []->cast(@TypeVarWitness));
   if ($witnessed->isNotEmpty(), | $conv->witnessedCast($value, $witnessed->toOne(), $fe),
   |if ($target->isNotEmpty(), | $conv->withConstraints($conv->checkedCast($value, $target->toOne(), $fe), $target->toOne(), $fe),
   |if ($typed,               | $value->toObjectCode()->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe->resolvedMultiplicity())->toBoxed(), $conv),
                              | $value)));
}

// The witness recorded for `t`, if the function being translated has one.
function <<access.private>> platform::extensions::language::java::translation::witnessFor(conv: Conventions[1], t: platform::pure::metamodel::type::generics::TypeParameter[1]): TypeVarWitness[0..1]
{
   if ($conv.typeVarWitness->isEmpty() || $t.name->isEmpty(),
      | []->cast(@TypeVarWitness),
      | $conv.typeVarWitness->toOne()->get($t.name->toOne()));
}

// `Metadata.castTo(value, Metadata.witnessType(witness))`, and when the cast
// names the multiplicity parameter the same witness binds (`cast(@T|m)`), the
// check covers the count too.
function <<access.private>> platform::extensions::language::java::translation::witnessedCast(conv: Conventions[1], value: Code[1], witness: TypeVarWitness[1], fe: FunctionExpression[1]): Code[1]
{
   let metadata  = javaClass($conv->pdbClass('Metadata'));
   let witnessed = j_variable(javaObject(), $witness.parameter);
   let bindsMul  = $witness.mulParameter->isNotEmpty()
                   && !$fe.multiplicity->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity)
                   && $fe.multiplicity->cast(@platform::pure::metamodel::multiplicity::MultiplicityParameter).name == $witness.mulParameter;
   if ($bindsMul,
      | j_invoke($metadata, 'castToWitness', [$value->toObjectCode(), $witnessed], javaObject()),
      | j_invoke($metadata, 'castTo', [$value->toObjectCode(),
                 j_invoke($metadata, 'witnessType', [$witnessed], javaObject())], javaObject()));
}

// `cast(@P(8))` where P carries constraints: each is checked on the value, with
// `$this` bound to it and the type variables to the values the target names.
// Failing one throws as Pure does: "Constraint :[id] violated in the Class P".
function <<access.private>> platform::extensions::language::java::translation::withConstraints(conv: Conventions[1], code: Code[1], target: platform::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[1]
{
   let owner       = $target->filter(t | $t->instanceOf(platform::pure::metamodel::extension::ElementWithConstraints))
                        ->cast(@platform::pure::metamodel::extension::ElementWithConstraints);
   let constraints = $owner->map(o | $o.constraints);
   // Only when every type variable the constraints may mention is bound by the
   // cast (`@P(8)`): a check over an unbound one would not compile.
   let variables = $target->filter(t | $t->instanceOf(platform::pure::metamodel::type::PrimitiveType))
                      ->cast(@platform::pure::metamodel::type::PrimitiveType).typeVariables;
   let bound     = $conv->typeVariableBindings($target, $fe);
   if (!$conv.metadataElements,                                                   | $code,
   |if ($constraints->isNotEmpty() && $bound->size() == $variables->size(),        | $conv->constraintChecks($code, $constraints, $target, $fe),
   |if ($constraints->isEmpty(),                                                   | $conv->inheritedConstraintChecks($code, $target, $fe),
                                                                                   | $code)));
}

// A primitive may carry its constraints through its parent, binding the parent's
// type variables as it extends it (`OP8 extends OP(8)`): the check is the
// PARENT's, with the values written there, and it names the parent.
function <<access.private>> platform::extensions::language::java::translation::inheritedConstraintChecks(conv: Conventions[1], code: Code[1], target: platform::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[1]
{
   let parents = $target.generalizations->map(g | $g.general)
                    ->filter(g | $g->instanceOf(platform::pure::metamodel::type::generics::GenericTypeValue))
                    ->cast(@platform::pure::metamodel::type::generics::GenericTypeValue)
                    ->filter(g | $g->rawType()->constraintsOf()->isNotEmpty());
   if ($parents->isEmpty(), | $code, | $conv->boundParentConstraints($code, $parents->at(0), $fe));
}

function <<access.private>> platform::extensions::language::java::translation::boundParentConstraints(conv: Conventions[1], code: Code[1], parent: platform::pure::metamodel::type::generics::GenericTypeValue[1], fe: FunctionExpression[1]): Code[1]
{
   let owner     = $parent->rawType()->toOne();
   let variables = $owner->filter(t | $t->instanceOf(platform::pure::metamodel::type::PrimitiveType))
                      ->cast(@platform::pure::metamodel::type::PrimitiveType).typeVariables;
   let values    = $parent.typeVariableValues;
   let bindings  = range($variables->size())->filter(i | $i < $values->size())->map(i |
                      j_declare($conv->pureTypeToJavaType($variables->at($i).genericType, $variables->at($i).multiplicity),
                                $variables->at($i).name->platform::extensions::language::java::translation::safeJavaName(),
                                $conv->translateExpression($values->at($i))));
   if ($bindings->size() != $variables->size(),
      | $code,
      | $conv->constraintChecksBound($code, $owner->constraintsOf(), $owner, $fe, $bindings));
}

// The constraints an element carries, if it carries any.
function <<access.private>> platform::extensions::language::java::translation::constraintsOf(t: platform::pure::metamodel::type::Type[*]): platform::pure::metamodel::constraint::Constraint[*]
{
   $t->filter(x | $x->instanceOf(platform::pure::metamodel::extension::ElementWithConstraints))
      ->cast(@platform::pure::metamodel::extension::ElementWithConstraints).constraints;
}

// The value, checked against each constraint before it is returned.
function <<access.private>> platform::extensions::language::java::translation::constraintChecks(conv: Conventions[1], code: Code[1], constraints: platform::pure::metamodel::constraint::Constraint[*], target: platform::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[1]
{
   $conv->constraintChecksBound($code, $constraints, $target, $fe, $conv->typeVariableBindings($target, $fe));
}

function <<access.private>> platform::extensions::language::java::translation::constraintChecksBound(conv: Conventions[1], code: Code[1], constraints: platform::pure::metamodel::constraint::Constraint[*], target: platform::pure::metamodel::type::Type[1], fe: FunctionExpression[1], typeBindings: Code[*]): Code[1]
{
   // Its own parameter name: a constraint's message may itself be an IIFE over
   // `pureIifeIn`, which would clash.
   let valueType = $conv->pureTypeToJavaType($fe.genericType, PureOne)->toBoxed();
   let bindThis  = j_declare($valueType, 'this_', j_variable(javaObject(), 'pureConstrainedV')->j_castWithoutChecks($valueType));
   let bindings  = $typeBindings->concatenate($bindThis);
   let checks    = $constraints->map(c | $conv->constraintCheck($c, $target));
   let body      = $bindings->concatenate($checks)->concatenate(j_return(j_variable(javaObject(), 'pureConstrainedV')));
   let checked   = j_lambda([j_parameter(javaObject(), 'pureConstrainedV')], j_block($body))
                      ->j_cast(javaFunction(javaObject(), javaObject()))
                      ->j_invoke('apply', [$code->toObjectCode()], javaObject());
   $checked->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe->resolvedMultiplicity())->toBoxed());
}

// `<type> x = <value>;` for each type variable the cast target binds (`@P(8)`).
function <<access.private>> platform::extensions::language::java::translation::typeVariableBindings(conv: Conventions[1], target: platform::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[*]
{
   let variables = $target->filter(t | $t->instanceOf(platform::pure::metamodel::type::PrimitiveType))
                      ->cast(@platform::pure::metamodel::type::PrimitiveType).typeVariables;
   // `cast(@P(8))`: the target's generic type is the holder argument's type
   // argument, and it carries the values (see extractNameFromGenericTypeAndMultiplicityHolder).
   let fromHolder = $fe.parametersValues->slice(1, $fe.parametersValues->size())
                       ->filter(p | $p->instanceOf(platform::pure::metamodel::valuespecification::GenericTypeAndMultiplicityHolder))
                       ->cast(@platform::pure::metamodel::valuespecification::GenericTypeAndMultiplicityHolder)
                       ->map(h | $h.classifierGenericType.typeArguments);
   let values    = $fe.genericType->concatenate($fromHolder)
                      ->filter(g | $g->instanceOf(platform::pure::metamodel::type::generics::GenericTypeValue))
                      ->cast(@platform::pure::metamodel::type::generics::GenericTypeValue).typeVariableValues;
   range($variables->size())->filter(i | $i < $values->size())->map(i |
      j_declare($conv->pureTypeToJavaType($variables->at($i).genericType, $variables->at($i).multiplicity),
                $variables->at($i).name->platform::extensions::language::java::translation::safeJavaName(),
                $conv->translateExpression($values->at($i))));
}

// `if (!(<constraint>)) { throw ... }` for one constraint.
function <<access.private>> platform::extensions::language::java::translation::constraintCheck(conv: Conventions[1], constraint: platform::pure::metamodel::constraint::Constraint[1], target: platform::pure::metamodel::type::Type[1]): Code[1]
{
   let className = $target->cast(@platform::pure::metamodel::PackageableElement).name->toOne();
   let name      = if ($constraint.name->isEmpty(), | '0', | $constraint.name->toOne());
   let condition = $conv->translateExpression($constraint.functionDefinition.expressionSequence->toOne())->asBooleanCode();
   let prefix    = j_string('Constraint :[' + $name + '] violated in the Class ' + $className);
   let message   = $constraint.messageFunction->map(m |
                      j_string(', Message: ')->j_plus($conv->translateExpression($m.expressionSequence->toOne())->j_castWithoutChecks(javaString())));
   let text      = $message->fold({m, acc | $acc->j_plus($m)}, $prefix);
   j_if(j_not($condition), j_throw(j_new(javaClass('java.lang.RuntimeException'), [$text])));
}

// A cast target whose Java class can check a value: a primitive, a primitive
// extension, a user class or an enumeration. Not a type parameter (erased), a
// metamodel type or Any.
function <<access.private>> platform::extensions::language::java::translation::isCheckedCastTarget(t: platform::pure::metamodel::type::Type[1]): Boolean[1]
{
   ($t->instanceOf(platform::pure::metamodel::type::PrimitiveType) || $t->instanceOf(platform::pure::metamodel::type::Enumeration) || $t->isUserClassType())
      && $t != Any;
}

// `value->cast(@T)` checked at runtime: every value must be an instance of T's
// Java class, or it fails with Pure's message — `Cast exception: String cannot
// be cast to CR_Sub`, the value's type named as Pure names it.
function <<access.private>> platform::extensions::language::java::translation::checkedCast(conv: Conventions[1], value: Code[1], target: platform::pure::metamodel::type::Type[1], fe: FunctionExpression[1]): Code[1]
{
   let javaType = $conv->pureTypeToJavaType($target->typeGenericType(), PureOne)->toBoxed();
   let name     = $target->cast(@platform::pure::metamodel::PackageableElement).name->toOne();
   $conv->runtimeCall('PureValues', 'checkedCast', [$value->toObjectCode(), j_classField($javaType), j_string($name)], javaObject())
      ->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe->resolvedMultiplicity())->toBoxed(), $conv);
}

// A GenericType for `t`.
function <<access.private>> platform::extensions::language::java::translation::typeGenericType(t: platform::pure::metamodel::type::Type[1]): platform::pure::metamodel::type::generics::GenericType[1]
{
   ^platform::pure::metamodel::type::generics::UserDefinedGenericType(type = $t);
}

// True for a user primitive extending another primitive, e.g. `Primitive P8 extends Integer`.
function <<access.private>> platform::extensions::language::java::translation::isPrimitiveExtension(t: platform::pure::metamodel::type::Type[1]): Boolean[1]
{
   $t->instanceOf(platform::pure::metamodel::type::PrimitiveType)
      && !$t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()->startsWith('platform::pure::metamodel::type::primitives::')
      && !$t->extendedPrimitiveOpt()->isEmpty();
}

function <<access.private>> platform::extensions::language::java::translation::extendedPrimitiveOpt(t: platform::pure::metamodel::type::Type[1]): platform::pure::metamodel::type::Type[*]
{
   $t.generalizations->map(g | $g.general->rawType())->filter(s | $s->instanceOf(platform::pure::metamodel::type::PrimitiveType));
}

function <<access.private>> platform::extensions::language::java::translation::extendedPrimitive(t: platform::pure::metamodel::type::Type[1]): platform::pure::metamodel::type::Type[1]
{
   $t->extendedPrimitiveOpt()->at(0);
}

// `coll->fold({elt, acc | body}, init)` — left fold. Stream.reduce expects the
// accumulator as `(acc, elt) -> newAcc` (acc first) but Pure's fold lambda is
// `(elt, acc) -> newAcc` (elt first). Wrap the translated lambda in a flip
// lambda before passing to reduce. The combiner is required by reduce's
// signature for parallel streams; since `.stream()` is sequential, our
// combiner is never invoked — just return the first operand.
function <<access.private>> platform::extensions::language::java::translation::foldCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'foldCoder expects exactly 3 arguments (collection, lambda, init), got ' + $fe.parametersValues->size()->toString());
   let coll      = $conv->translateAsList($fe.parametersValues->at(0));
   let lambdaArg = $fe.parametersValues->at(1);
   // Cast init to Object so Stream.reduce's generic U infers consistently
   // — the reducer's lambda return type is Object (β-inlined body or
   // BiFunction<Object,Object,Object>), so init must agree or Java fails
   // type inference ("inference variable U has incompatible bounds").
   let init      = $conv->translateExpression($fe.parametersValues->at(2))->toObjectCode();
   // The reducer (Object, Object) → Object around the translated lambda.
   let reducer = $conv->buildFoldReducer($lambdaArg);
   // Prefixed names: a lambda parameter may not shadow one of the enclosing
   // method's, and a Pure function is free to call its own parameters a and b.
   let combiner = j_lambda(
      [j_parameter(javaObject(), 'pureFoldA'), j_parameter(javaObject(), 'pureFoldB')],
      j_variable(javaObject(), 'pureFoldA')
   );
   let reduceCall = $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('reduce', [$init, $reducer, $combiner], javaObject());
   // Cast the Object reduce result to the FE's expected type so the
   // surrounding context (return statement, assignment, arg position)
   // typechecks. For primitive targets, route through the boxed type
   // so {@code j_cast}'s primitive proxy handles auto-unboxing.
   let feRetType = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity);
   $reduceCall->j_castWithoutChecks($feRetType->toBoxed());
}

// The `(Object acc, Object elt) -> ...` reducer: the translated fold lambda
// cast to {@code BiFunction<Object,Object,Object>} and applied as
// {@code .apply(elt, acc)} (note the flip: Pure puts elt first, Stream.reduce
// passes the accumulator first). The lambda's `var` parameters are rebound to
// their Pure types (see {@link translateLambdaValue}), so its body reads
// properties and copies objects through the generated classes. An earlier
// version inlined the body with Object-typed `_acc`/`_elt`, which lost those
// types. The reducer's own parameters are prefixed so they can't collide with
// a local of the enclosing method, and suffixed with the Pure lambda's
// parameter names so a fold nested in the lambda doesn't redeclare them.
function <<access.private>> platform::extensions::language::java::translation::buildFoldReducer(conv: Conventions[1], lambdaArg: ValueSpecification[1]): Code[1]
{
   let f      = $conv->translateExpression($lambdaArg);
   let bif    = $f->j_castWithoutChecks(javaBiFunction(javaObject(), javaObject(), javaObject()));
   let names  = $lambdaArg->match([
                   av: AtomicValue[1] | $av.value->filter(v | $v->instanceOf(LambdaFunction))->map(l | $l->cast(@LambdaFunction<Any>).parameters->map(p | $p.name)),
                   other: ValueSpecification[1] | []->cast(@String)
                ]);
   let suffix = $names->map(n | '_' + $n)->joinStrings('');
   j_lambda(
      [j_parameter(javaObject(), 'pureFoldAcc' + $suffix), j_parameter(javaObject(), 'pureFoldElt' + $suffix)],
      $bif->j_invoke('apply', [j_variable(javaObject(), 'pureFoldElt' + $suffix), j_variable(javaObject(), 'pureFoldAcc' + $suffix)], javaObject())
   );
}

// `compare(a, b)` — Pure's 3-way compare, returns Integer (Java long).
// Java's `((Comparable) a).compareTo(b)` returns int; cast up to long.
function <<access.private>> platform::extensions::language::java::translation::compareCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'compareCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   if ($fe.parametersValues->exists(p | $p->isDecimalTyped()) || $fe.parametersValues->mixesNumberTypes(),
      | j_cast($conv->asBigDecimal($fe.parametersValues->at(0))->j_invoke('compareTo', [$conv->asBigDecimal($fe.parametersValues->at(1))], javaInt()), javaLong()),
      | let a = $conv->translateExpression($fe.parametersValues->at(0));
        let b = $conv->translateExpression($fe.parametersValues->at(1));
        if ($fe.parametersValues->at(0).genericType->rawType() != $fe.parametersValues->at(1).genericType->rawType(),
           | // Values of unrelated types order by their Java class name first, as
             // on the Truffle runtime; same-class values by their natural order.
             $conv->runtimeCall('PureCollections', 'compare', [$a->toObjectCode(), $b->toObjectCode()], javaLong()),
           | j_cast(j_invoke($a->j_cast(javaClass('java.lang.Comparable')), 'compareTo', [$b], javaInt()), javaLong())););
}

// `value->match([p1:T1[m1]|body1, p2:T2[m2]|body2, ...])` and the 3-argument
// `value->match(lambdas, extra)` — dispatch on type AND multiplicity: the first
// lambda whose parameter accepts the value (its size within the multiplicity's
// bounds, every element an instance of the type) runs. The dispatch lives in
// the platform's PureMatch class (runtime library); the call
// site only passes the value, the translated lambdas, each parameter's bounds
// and Java class. Doing it inline would need locals, and a match nested in an
// arm's body would redeclare them — javac rejects a lambda parameter or local
// that shadows an enclosing one.
function <<access.private>> platform::extensions::language::java::translation::matchCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2 || $fe.parametersValues->size() == 3, | 'matchCoder expects 2 or 3 arguments, got ' + $fe.parametersValues->size()->toString());
   let withExtra = $fe.parametersValues->size() == 3;
   if (!$fe.parametersValues->at(1)->hasLiteralMatchLambdas(),
      | $conv->dynamicMatch($fe, $withExtra),
      | $conv->literalMatch($fe, $withExtra));
}

// `$x->match($lambdas)` — the arms are a value, so each is asked for its own
// parameter type and bounds when the match runs.
function <<access.private>> platform::extensions::language::java::translation::dynamicMatch(conv: Conventions[1], fe: FunctionExpression[1], withExtra: Boolean[1]): Code[1]
{
   let arms  = $conv->translateAsList($fe.parametersValues->at(1));
   let extra = if ($withExtra, | $conv->translateExpression($fe.parametersValues->at(2))->toObjectCode(), | j_null());
   let many  = if ($fe.multiplicity->holdsManyValues(), | j_true(), | j_false());
   j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureMatch')), 'matchDynamic',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode(), $arms, $extra,
             if ($withExtra, | j_true(), | j_false()), $many], javaObject())
      ->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed(), $conv);
}

// True when the match arms are written out, so their types are known here.
function <<access.private>> platform::extensions::language::java::translation::hasLiteralMatchLambdas(vs: ValueSpecification[1]): Boolean[1]
{
   $vs->match([
      c: Collection[1]  | $c.values->forAll(v | $v->hasLiteralMatchLambdas()),
      a: AtomicValue[1] | $a.value->forAll(v | $v->instanceOf(LambdaFunction)),
      x: ValueSpecification[1] | false
   ]);
}

function <<access.private>> platform::extensions::language::java::translation::literalMatch(conv: Conventions[1], fe: FunctionExpression[1], withExtra: Boolean[1]): Code[1]
{
   let lambdas   = $fe.parametersValues->at(1)->matchLambdas();
   let fnType    = if ($withExtra, | javaClass('java.util.function.BiFunction'), | javaClass('java.util.function.Function'));
   let arms      = j_invoke(javaArrays(), 'asList', $lambdas->map(l | $conv->translateLambdaValue($l)->j_castWithoutChecks($fnType)), javaList());
   let params    = $lambdas->map(l | $l.parameters->at(0));
   let bounds    = j_invoke(javaArrays(), 'asList', $params->map(p | $p.multiplicity->matchBounds())->map(b | j_long($b)), javaList());
   let classes   = j_invoke(javaArrays(), 'asList', $params->map(p | $conv->matchClassLiteral($p)), javaList());
   let extra     = if ($withExtra, | $conv->translateExpression($fe.parametersValues->at(2))->toObjectCode(), | j_null());
   let many      = if ($fe.multiplicity->holdsManyValues(), | j_true(), | j_false());
   j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureMatch')), 'match',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode(), $arms, $bounds, $classes, $extra, if ($withExtra, | j_true(), | j_false()), $many],
            javaObject())
      ->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed());
}

// The lambdas of a match, written as a literal list or a single literal lambda.
function <<access.private>> platform::extensions::language::java::translation::matchLambdas(vs: ValueSpecification[1]): LambdaFunction<Any>[*]
{
   $vs->match([
      c: Collection[1]  | $c.values->map(v | $v->matchLambdas()),
      a: AtomicValue[1] | $a.value->map(v | $v->cast(@LambdaFunction<Any>)),
      x: ValueSpecification[1] | fail('matchCoder: the match lambdas must be written as literals, got ' + $x.classifierGenericType->toOne()->rawType()->toOne()->elementToPath()); []->cast(@LambdaFunction<Any>);
   ]);
}

// `lower, upper` of a match parameter's multiplicity; upper -1 is unbounded,
// and a multiplicity parameter accepts any size.
function <<access.private>> platform::extensions::language::java::translation::matchBounds(m: platform::pure::metamodel::multiplicity::Multiplicity[1]): Integer[*]
{
   if (!$m->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity),
      | [0, -1],
      | let c = $m->cast(@platform::pure::metamodel::multiplicity::ConcreteMultiplicity);
        [$c.lowerBound.value->toOne(), if ($c.upperBound->isEmpty(), | -1, | $c.upperBound->toOne().value->toOne())];
   );
}

// `T.class` for the Java type of one value of the parameter's Pure type.
function <<access.private>> platform::extensions::language::java::translation::matchClassLiteral(conv: Conventions[1], p: VariableExpression[1]): Code[1]
{
   // A class arm tests the platform interface: a function type would otherwise
   // test the Java functional interface it is called through (or Object), which
   // a metamodel LambdaFunction read from a PDB is not, and anything would match.
   let raw  = $p.genericType->rawType();
   let cls  = $raw->filter(t | $t->instanceOf(platform::pure::metamodel::type::Class) && !$t->instanceOf(platform::pure::metamodel::type::Enumeration) && $t != Any);
   let type = if ($cls->isEmpty(),
                 | $conv->pureTypeToJavaType($p.genericType, PureOne)->toBoxed(),
                 | $p.genericType->platform::extensions::language::java::translation::platform::platformValueType(PureOne, platform::extensions::language::java::translation::platform::platformRoot()));
   let literal = j_field($type, 'class', javaClass('java.lang.Class'));
   // A Pure function value is either a metamodel object (read from a PDB) or a
   // Java lambda (a closure): such an arm accepts any of those classes.
   let isFunction = $cls->exists(c | $c->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()->startsWith('platform::pure::metamodel::function::'));
   if (!$isFunction,
      | $literal,
      | j_invoke(javaList(), 'of', [$literal,
           j_field(javaClass('java.util.function.Function'), 'class', javaClass('java.lang.Class')),
           j_field(javaClass('java.util.function.BiFunction'), 'class', javaClass('java.lang.Class')),
           j_field(javaClass('java.util.function.Supplier'), 'class', javaClass('java.lang.Class'))], javaList()));
}

// True when `exprs` call a function with one of `names`, lambda bodies and
// functions passed by name (`format_String_1__Any_MANY__String_1_->eval(...)`) included.
function <<access.private>> platform::extensions::language::java::translation::callsFunctionNamed(exprs: ValueSpecification[*], names: String[*]): Boolean[1]
{
   $exprs->exists(e | $e->match([
      fe: FunctionExpression[1]    | $names->contains($fe.functionName->toOne()) || $fe.parametersValues->callsFunctionNamed($names),
      av: AtomicValue[1]           | $av.value->filter(v | $v->instanceOf(LambdaFunction))->cast(@LambdaFunction<Any>)->exists(l | $l.expressionSequence->callsFunctionNamed($names))
                                     || $av.value->filter(v | $v->instanceOf(platform::pure::metamodel::function::PackageableFunction))->cast(@platform::pure::metamodel::function::PackageableFunction<Any>)->exists(f | $names->contains($f.functionName->toOne())),
      col: Collection[1]           | $col.values->callsFunctionNamed($names),
      other: ValueSpecification[1] | false
   ]));
}

// ----------------------------------------------------------------------------
// Type mapping.
// ----------------------------------------------------------------------------

function platform::extensions::language::java::translation::pureTypeToJavaType(conv: Conventions[1], g: platform::pure::metamodel::type::generics::GenericType[1], mult: platform::pure::metamodel::multiplicity::Multiplicity[1]): platform::extensions::language::java::metamodel::Type[1]
{
   let rawOpt = $g->rawType();
   if ($rawOpt->isEmpty(),
      | // Unresolved GenericType — common after canonical-recompile loses
        // some inference (e.g. `let x = new(...)` where new's result type
        // can't be re-derived). Fall back to Object so translation
        // continues; the use site will work as long as it doesn't need
        // type-specific dispatch.
        javaObject(),
   // A type PARAMETER has no path — asking one for it casts it to a
   // PackageableElement, which it is not. It erases to Object anyway.
   |if ($rawOpt->toOne()->instanceOf(platform::pure::metamodel::type::generics::TypeParameter),
      | $conv->pureTypeToJavaTypeResolved($rawOpt->toOne(), $mult),
   |if ($rawOpt->toOne()->elementToPath()->startsWith('platform::pure::metamodel::function::') && !$mult->holdsManyValues(),
      | $g->javaFunctionalInterfaceFor(),
      | $conv->pureTypeToJavaTypeResolved($rawOpt->toOne(), $mult)
   )));
}

// A single function value (LambdaFunction, Function, ...) as the raw
// functional interface matching its arity — Supplier, Function, BiFunction —
// read from the FunctionType type argument. Checked here, before the
// resolved mapping, because LambdaFunction is a Pure Class and would
// otherwise be emitted as a non-existent `<basePackage>.LambdaFunction`
// ("cannot find symbol" for `LambdaFunction key = ...`); and a lambda can't be
// assigned to plain Object either. Unknown arity erases to Object.
function <<access.private>> platform::extensions::language::java::translation::javaFunctionalInterfaceFor(g: platform::pure::metamodel::type::generics::GenericType[1]): platform::extensions::language::java::metamodel::Type[1]
{
   // typeArguments is declared on UserDefinedGenericType, not on GenericType.
   let fnTypes = if ($g->instanceOf(platform::pure::metamodel::type::generics::UserDefinedGenericType),
      | $g->cast(@platform::pure::metamodel::type::generics::UserDefinedGenericType).typeArguments
           ->map(t: platform::pure::metamodel::type::generics::GenericType[1] | $t->rawType())
           ->filter(t: platform::pure::metamodel::type::Type[1] | $t->instanceOf(platform::pure::metamodel::type::FunctionType))
           ->cast(@platform::pure::metamodel::type::FunctionType),
      | []->cast(@platform::pure::metamodel::type::FunctionType)
   );
   if ($fnTypes->isEmpty(), | javaObject(), | $fnTypes->at(0).parameters->size()->javaFunctionalInterfaceForArity());
}

// Raw Supplier / Function / BiFunction for a function of 0 / 1 / 2 parameters;
// Object otherwise.
function <<access.private>> platform::extensions::language::java::translation::javaFunctionalInterfaceForArity(arity: Integer[1]): platform::extensions::language::java::metamodel::Type[1]
{
   if ($arity == 0, | javaClass('java.util.function.Supplier'),
   |if ($arity == 1, | javaClass('java.util.function.Function'),
   |if ($arity == 2, | javaClass('java.util.function.BiFunction'),
                     | javaObject())));
}

// Java type for a `let` binding of `valExpr`. A lambda value is typed by its
// own parameter count: the value expression's genericType doesn't reliably
// carry the FunctionType argument, and a lambda can't be assigned to Object
// ("Object is not a functional interface").
function <<access.private>> platform::extensions::language::java::translation::letVariableType(conv: Conventions[1], valExpr: ValueSpecification[1]): platform::extensions::language::java::metamodel::Type[1]
{
   let lambdas = $valExpr->match([
      a: AtomicValue[1]            | $a.value->filter(v | $v->instanceOf(LambdaFunction))->cast(@LambdaFunction<Any>),
      other: ValueSpecification[1] | []->cast(@LambdaFunction<Any>)
   ]);
   if ($lambdas->size() == 1,
      | $lambdas->toOne().parameters->size()->javaFunctionalInterfaceForArity(),
      | $conv->pureTypeToJavaType($valExpr.genericType, $valExpr->resolvedMultiplicity())
   );
}

// `vs`'s multiplicity, with a cast's taken from its source: `cast<T|m>` returns
// `T[m]` for a source of `[m]`. The compiler can infer otherwise — it types
// `[]->cast(@Integer)` [1] (InferredPackageableMultiplicity), which declared a
// `long` holding an empty list.
function <<access.private>> platform::extensions::language::java::translation::resolvedMultiplicity(vs: ValueSpecification[1]): platform::pure::metamodel::multiplicity::Multiplicity[1]
{
   if ($vs->instanceOf(FunctionExpression)
         && $vs->cast(@FunctionExpression).functionName == 'cast'
         && $vs->cast(@FunctionExpression).parametersValues->isNotEmpty(),
      | $vs->cast(@FunctionExpression).parametersValues->at(0)->resolvedMultiplicity(),
      | $vs.multiplicity);
}

function <<access.private>> platform::extensions::language::java::translation::isDateOrTimeType(t: platform::pure::metamodel::type::Type[1]): Boolean[1]
{
   $t == platform::pure::metamodel::type::primitives::Date
   || $t == platform::pure::metamodel::type::primitives::StrictDate
   || $t == platform::pure::metamodel::type::primitives::DateTime
   || $t == platform::pure::metamodel::type::primitives::LatestDate
   || $t == platform::pure::metamodel::type::primitives::StrictTime;
}

function <<access.private>> platform::extensions::language::java::translation::pureTypeToJavaTypeResolved(conv: Conventions[1], raw: platform::pure::metamodel::type::Type[1], mult: platform::pure::metamodel::multiplicity::Multiplicity[1]): platform::extensions::language::java::metamodel::Type[1]
{
   // Type parameters (`T`, `Z`, ...) erase to java.lang.Object — Java doesn't
   // have reified generics and the call site already knows the concrete shape
   // it expects via Pure's type checking.
   let scalar = if([
                pair(| $raw->instanceOf(platform::pure::metamodel::type::generics::TypeParameter), | javaObject()),
                pair(| $raw == Integer, | javaLong()),
                pair(| $raw == Boolean, | javaBoolean()),
                pair(| $raw == Float,   | javaDouble()),
                pair(| $raw == String,  | javaString()),
                pair(| $raw == Number,  | javaNumber()),
                pair(| $raw == Any,     | javaObject()),
                pair(| $raw == Nil,     | javaObject()),
                pair(| $raw == platform::pure::metamodel::type::primitives::Decimal, | javaBigDecimal()),
                // Date types map to java.time classes that match Pure's
                // normalized stored format. DateTime literals get normalized
                // to zone-less ISO strings (see compiler's normalizePureDate),
                // so LocalDateTime.parse handles them; ZonedDateTime would
                // require a zone marker we don't have. `Date` is the abstract
                // base — Temporal lets it accept any concrete subtype.
                pair(| $raw == platform::pure::metamodel::type::primitives::Date,        | $conv->javaPureDateType()),
                pair(| $raw == platform::pure::metamodel::type::primitives::DateTime,    | $conv->javaPureDateType()),
                pair(| $raw == platform::pure::metamodel::type::primitives::StrictDate,  | $conv->javaPureDateType()),
                pair(| $raw == platform::pure::metamodel::type::primitives::LatestDate,  | $conv->javaPureDateType()),
                // Binary is a host byte[] — bytes cross the native boundary as an
                // opaque handle, with no per-element boxing.
                pair(| $raw == platform::pure::metamodel::type::primitives::Binary,      | javaArray(javaByte())),
                pair(| $raw == platform::pure::metamodel::type::primitives::StrictTime,  | javaClass('java.time.LocalTime')),
                pair(| $raw == platform::pure::metamodel::PackageableElement,            | javaObject()),
                // A primitive extension (`Primitive P8 extends Integer`) is
                // represented as the primitive it extends.
                pair(| $raw->isPrimitiveExtension(), | $conv->pureTypeToJavaTypeResolved($raw->extendedPrimitive(), PureOne)),
                // A Variant is the generated Variant class.
                pair(| $raw->instanceOf(platform::pure::metamodel::PackageableElement) && $raw->cast(@platform::pure::metamodel::PackageableElement)->elementToPath() == variantTypePath(), | $conv->javaVariantType()),
                // An AntlrContext is a parse-tree node of the ANTLR extension, not
                // a value with a platform class: it is opaque to translated code.
                // The same predicate types a PROPERTY of this type (platformValueType), so the two
                // cannot drift — they did, and a typed getter then cast a real ANTLR context to the
                // generated interface it does not implement.
                pair(| $raw->platform::extensions::language::java::translation::platform::isOpaqueHostType(), | javaObject()),
                // A Pure Map is a java.util.Map, so this check must come before
                // the generic Class branch (a Pure Map would otherwise be its
                // platform interface, which PureMap's values are not).
                pair(| $raw == platform::pure::functions::collection::Map,           | javaClass('java.util.Map')),
                // The top type of a hierarchy is Object, whichever hierarchy:
                // the protocol grammar has an Any of its own, and an
                // AtomicValue's value — typed by it — is a literal at run time.
                pair(| $raw->platform::extensions::language::java::translation::platform::isTopType(), | javaObject()),
                // An enumeration is its generated Java enum; the abstract Enum
                // (any enum value) is java.lang.Enum.
                pair(| $raw->instanceOf(platform::pure::metamodel::type::Enumeration), | $conv->javaEnumType($raw->cast(@platform::pure::metamodel::type::Enumeration<Any>))),
                // An enum value is a Java enum constant, or — with metadata — the
                // metamodel object of an enumeration read from a PDB.
                pair(| $raw == platform::pure::metamodel::type::Enum,                | if ($conv.metadataElements, | javaObject(), | javaClass('java.lang.Enum'))),
                // User-defined Pure classes are emitted as plain Java
                // classes alongside GalleryRunner (see buildSignature's
                // `extraClasses` walk). Map a Pure Class reference to the
                // generated Java class in the same package.
                pair(| $raw->instanceOf(platform::pure::metamodel::type::Class),
                     | javaClass($raw->cast(@platform::pure::metamodel::PackageableElement)->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot()))),
                // Function-typed values (LambdaFunction / Function subclasses
                // captured as variables) erase to java.lang.Object — at the
                // use site, evalCoder casts to the right Supplier/Function/
                // BiFunction before dispatch.
                pair(| $raw->elementToPath()->startsWith('platform::pure::metamodel::function::'), | javaObject())],
                | fail('Unsupported Pure type: ' + $raw->elementToPath()); javaVoid(););
   // Any multiplicity that can hold more than one value wraps in
   // java.util.List<T> (javaList boxes primitive scalars automatically). An
   // optional single value ([0..1]) is boxed, because its absence is null and
   // a primitive can't hold null — `!(b == null) && !(Boolean) b` fails javac
   // for a primitive boolean. [1] keeps the bare, possibly primitive, form.
   if ($mult->holdsManyValues(), | javaList($scalar),
   |if ($mult->mayBeEmpty(),     | $scalar->toBoxed(),
                                 | $scalar));
}

// True for a concrete multiplicity whose upper bound is 1: the value is never a
// List. False for a multiplicity parameter, which may stand for a collection.
function <<access.private>> platform::extensions::language::java::translation::isSingleValued(m: platform::pure::metamodel::multiplicity::Multiplicity[1]): Boolean[1]
{
   $m->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity) && !$m->holdsManyValues();
}

// True for a concrete multiplicity with a lower bound of 0 — an optional
// single value once {@link holdsManyValues} has ruled out collections. A
// multiplicity parameter is not assumed optional.
function <<access.private>> platform::extensions::language::java::translation::mayBeEmpty(m: platform::pure::metamodel::multiplicity::Multiplicity[1]): Boolean[1]
{
   $m->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity)
      && $m->cast(@platform::pure::metamodel::multiplicity::ConcreteMultiplicity).lowerBound.value == 0;
}

// True when a value of multiplicity `m` is represented as a java.util.List:
// any concrete multiplicity whose upper bound isn't exactly 1 — unbounded
// ([*], [1..*]), above one ([2], [0..3]) or zero ([0], the type of `[]`).
// Not isToMany(), which is true only for an unbounded upper bound: a literal
// collection such as ['a', 'b'] is typed [2], so `let set = ['a', 'b']` came
// out as `String set = Arrays.asList(...)`, and `[]->isEmpty()` compiled to
// `[] == null`. A multiplicity parameter stays scalar, as before.
function <<access.private>> platform::extensions::language::java::translation::holdsManyValues(m: platform::pure::metamodel::multiplicity::Multiplicity[1]): Boolean[1]
{
   $m->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity)
      && ($m->cast(@platform::pure::metamodel::multiplicity::ConcreteMultiplicity).upperBound->isEmpty()
          || $m->cast(@platform::pure::metamodel::multiplicity::ConcreteMultiplicity).upperBound->toOne().value->toOne() != 1);
}

// ----------------------------------------------------------------------------
// Expression walker. Variables -> Java variable refs; function calls -> dispatch
// through the conventions' coder map.
// ----------------------------------------------------------------------------

function platform::extensions::language::java::translation::translateExpression(conv: Conventions[1], expr: ValueSpecification[1]): Code[1]
{
   $expr->match([
      v: VariableExpression[1]  | if ($v.name->startsWith('~'), | $conv->parentRefCode($v), | j_variable($conv->pureTypeToJavaType($v.genericType, $v.multiplicity), $conv->platform::extensions::language::java::translation::javaNameFor($v.name))),
      a: AtomicValue[1]         | $conv->translateAtomicValue($a),
      fe: FunctionExpression[1] | $conv->translateFunctionExpression($fe),
      // Compiled-form list literal (`[a, b, c]` / `[]`). Each element is
      // itself a VS, so recurse via translateExpression and concatenate into
      // a `List<Object>`. The Arrays.asList variant boxes primitives via the
      // standard auto-boxing path; Collections.emptyList handles `[]`.
      c: Collection[1]          | if ($c.values->isEmpty(),
                                      | j_invoke(javaCollections(), 'emptyList', [], javaList(javaObject())),
                                      | j_invoke(javaArrays(), 'asList', $c.values->map(v | $conv->translateExpression($v)), javaList(javaObject()))
                                  ),
      // `@CC_Person` — a type written as a value. With metadata it is the
      // holder the platform builds for that type.
      h: platform::pure::metamodel::valuespecification::GenericTypeAndMultiplicityHolder[1] | $conv->translateTypeHolder($h),
      // A language extension's value (an expression island compiled to its own class): it evaluates to the
      // instance itself, so it is emitted as the instance — what `^Class(...)` with its slots emits.
      x: ValueSpecification[1]  | if ($x->isUserClassInstance(),
                                      | $conv->translateExtensionValue($x),
                                      | fail('translateExpression: unsupported VS subtype ' + $x.classifierGenericType->toOne()->rawType()->toOne()->elementToPath()); j_null();)
   ]);
}

// An extension value as a constant: its slots as a `new XImpl()._p(v)...` chain (translateClassInstance),
// with the classifier `^X(...)` sets, so instanceOf and genericType see the same object either way.
// It is also a value SPECIFICATION, and its type and multiplicity are its own (a TDS's type is its relation
// type, TDS<(a:Integer[1], …)>): they are set too, as the metamodel values they are (translateMetamodelValue).
function <<access.private>> platform::extensions::language::java::translation::translateExtensionValue(conv: Conventions[1], v: ValueSpecification[1]): Code[1]
{
   let cls = $v->platform::pure::functions::meta::genericType()->rawType()->toOne()->cast(@platform::pure::metamodel::type::Class<Any>);
   let clsType = javaClass($cls->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot()) + 'Impl');
   let typed = $conv->translateClassInstance($v)
      ->j_invoke('_genericType', [$conv->translateMetamodelValue($v.genericType)], $clsType)
      ->j_invoke('_multiplicity', [$conv->translateMetamodelValue($v.multiplicity)], $clsType);
   $conv->withClassifier($typed, $clsType, $cls, [], []);
}

// A metamodel value as code: an element (a class, a primitive type, a canonical generic type, PureOne) as
// the platform's metadata element; a primitive as its literal; any other instance (a UserDefinedGenericType,
// a RelationType, a Column) as its generated class with every property it has set, each such a value too.
function <<access.private>> platform::extensions::language::java::translation::translateMetamodelValue(conv: Conventions[1], v: Any[1]): Code[1]
{
   let type = $v->platform::pure::functions::meta::genericType()->rawType()->toOne();
   if([pair(| $v->instanceOf(platform::pure::metamodel::PackageableElement),
            | j_invoke(javaClass($conv->pdbClass('Metadata')), 'element', [j_string($v->cast(@platform::pure::metamodel::PackageableElement)->elementToPath())], javaObject())),
       pair(| !$type->instanceOf(platform::pure::metamodel::type::Class),
            | $conv->translateScalarAtomicValue($v))],
      | $conv->translateMetamodelInstance($v, $type->cast(@platform::pure::metamodel::type::Class<Any>)));
}

function <<access.private>> platform::extensions::language::java::translation::translateMetamodelInstance(conv: Conventions[1], v: Any[1], cls: platform::pure::metamodel::type::Class<Any>[1]): Code[1]
{
   let clsType = javaClass($cls->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot()) + 'Impl');
   let built = $cls->platform::extensions::language::java::translation::allMetamodelProperties()->filter(p | $p.name != 'classifierGenericType')
      ->fold({p, acc | platform::extensions::language::java::translation::setMetamodelProperty($conv, $acc, $clsType, $p, $p->eval($v))}, j_new($clsType, []));
   $conv->withClassifier($built, $clsType, $cls, [], []);
}

function <<access.private>> platform::extensions::language::java::translation::setMetamodelProperty(conv: Conventions[1], acc: Code[1], clsType: platform::extensions::language::java::metamodel::Type[1], p: platform::pure::metamodel::function::property::Property<Any, Any>[1], values: Any[*]): Code[1]
{
   if([pair(| $values->isEmpty(), | $acc),
       pair(| $values->size() == 1, | $acc->j_invoke('_' + $p.name->toOne(), [$conv->translateMetamodelValue($values->toOne())], $clsType))],
      | $acc->j_invoke('_' + $p.name->toOne(), [j_invoke(javaArrays(), 'asList', $values->map(x | $conv->translateMetamodelValue($x)), javaList(javaObject()))], $clsType));
}

// Every property of `cls`, inherited ones included, metamodel ancestors and all (allUserProperties stops at them).
function <<access.private>> platform::extensions::language::java::translation::allMetamodelProperties(cls: platform::pure::metamodel::type::Class<Any>[1]): platform::pure::metamodel::function::property::Property<Any, Any>[*]
{
   let supers = $cls.generalizations->map(g | $g.general->rawType())
                    ->filter(t | $t->isNotEmpty() && $t->toOne()->instanceOf(platform::pure::metamodel::type::Class))
                    ->cast(@platform::pure::metamodel::type::Class<Any>);
   $cls.properties->concatenate($supers->map(s | $s->platform::extensions::language::java::translation::allMetamodelProperties()))->removeDuplicatesBy(p | $p.name->toOne());
}

// FunctionExpression dispatch with two fallbacks:
//   1. coder lookup by functionName — the primary path
//   2. property-access fallback — if `fe.func` is an AbstractProperty, emit
//      `((Map) receiver).get("propName")`. This makes `$x.firstName` work
//      for user-defined classes whose instances are HashMap-backed.
// The name coders are keyed by: the called function's short name, however the
// call was written (`platform::pure::functions::meta::genericType($x)` included).
function <<access.private>> platform::extensions::language::java::translation::coderName(fe: FunctionExpression[1]): String[1]
{
   let written = $fe.functionName->toOne('coderName: function expression without a name');
   let declared = $fe.func->filter(f | $f->instanceOf(platform::pure::metamodel::function::PackageableFunction))->map(f | $f->cast(@platform::pure::metamodel::function::PackageableFunction<Any>).functionName);
   if ($declared->isNotEmpty(),
      | $declared->at(0),
      | $written->split('::')->last()->toOne());
}

// The coder translating calls to `f` (named `name` at the call): coders
// implement the core library, natives and platform::pure::functions, so a user
// function elsewhere sharing a coder's short name
// (platform::pure::compiler::pdb::schema::enumValues) is called, not coded.
function <<access.private>> platform::extensions::language::java::translation::coderFor(conv: Conventions[1], f: Any[*], name: String[1]): platform::pure::metamodel::function::Function<{FunctionExpression[1], Conventions[1] -> Code[1]}>[0..1]
{
   let userFunction = $f->size() == 1
                      && $f->toOne()->instanceOf(platform::pure::metamodel::function::UserDefinedFunction)
                      && !$f->toOne()->cast(@platform::pure::metamodel::function::UserDefinedFunction<Any>)->elementToPath()->startsWith('platform::pure::functions::');
   if ($userFunction, | [], | $conv.functionCoders->get($name));
}

function <<access.private>> platform::extensions::language::java::translation::translateFunctionExpression(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let coderOpt = $conv->coderFor($fe.func, $fe->coderName());
   // A property read goes first: coders are keyed by short name, so `$out.tail`
   // would otherwise be translated as the tail() function.
   let isProperty = $fe.func->isNotEmpty() && $fe.func->toOne()->instanceOf(platform::pure::metamodel::function::property::Property);
   // A qualified property is called, not read: its arguments would be dropped by
   // the property-access fallback (`$p.fullName(true)` → `p.fullName()`).
   let isQualified = $fe.func->isNotEmpty() && $fe.func->toOne()->instanceOf(platform::pure::metamodel::function::property::QualifiedProperty);
   // Every Pure call passes through here, so this is the one place the call's
   // source position has to be recorded — see withPureSource.
   let code = if ($isProperty, | $conv->translatePropertyAccess($fe),
   |if ($isQualified, | $conv->translateQualifiedPropertyCall($fe),
   |if ($coderOpt->isNotEmpty(),
      | $coderOpt->toOne()->eval($fe, $conv),
      | // UDF dispatch must come BEFORE the property-access fallback —
        // {@link isPropertyAccessLike} returns true for any 1-arg FE that
        // misses the coder map, which would misclassify a 1-arg UDF call
        // (e.g. `myHelper($x)`) as `$x.myHelper`. buildSignature emits one
        // Java helper class per referenced UDF; the call here lines up with
        // that class's `public static execute(...)` method.
        if ($conv->isUserDefinedFunctionCall($fe),
            | $conv->translateUdfCall($fe),
            | if ($conv->isPropertyAccessLike($fe),
                  | $conv->translatePropertyAccess($fe),
                  | fail('No coder for Pure function: ' + $fe.functionName); j_null();
              )
        ))
   ));
   $code->platform::extensions::language::java::translation::withPureSource($fe.sourceInformation);
}

// Remember where a piece of generated code came from. Only call expressions
// carry this: a frame's position is the call it was executing, so that is all a
// stack trace ever needs, and tagging every Code node would bloat the metamodel
// for nothing.
function <<access.private>> platform::extensions::language::java::translation::withPureSource(code: platform::extensions::language::java::metamodel::Code[1], si: platform::pure::metamodel::SourceInformation[0..1]): platform::extensions::language::java::metamodel::Code[1]
{
   if ($si->isEmpty(), | $code, | ^$code(sourceInformation = $si));
}

function <<access.private>> platform::extensions::language::java::translation::isUserDefinedFunctionCall(conv: Conventions[1], fe: FunctionExpression[1]): Boolean[1]
{
   $fe.func->isNotEmpty()
   && $fe.func->toOne()->instanceOf(platform::pure::metamodel::function::UserDefinedFunction);
}

// Emit `HelperClass.execute(arg1, arg2, ...)` for a UDF call. HelperClass
// matches the Java class name {@link buildSignature} generates for the
// UDF — `udfClassName(udf)` is the single source of truth so caller +
// callee stay in lockstep.
function <<access.private>> platform::extensions::language::java::translation::translateUdfCall(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let udf       = $fe.func->toOne()->cast(@platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>);
   let cls       = javaClass($conv->udfClassName($udf));
   let params    = $udf.parameters;
   let argCodes  = range($fe.parametersValues->size())->map(i | $conv->udfArgument($fe, $params, $i));
   // Use the FE's genericType (the resolved type at this call site after
   // type-parameter substitution) rather than the UDF's declared return
   // type. For a generic UDF like {@code orElse<T>(value, default)} the
   // declaration returns Object (T erases to Object) but a call site like
   // {@code orElse(emptyInt, 99)} has FE.genericType = Integer. Without
   // routing the FE type to the invoke node, the outer return-position
   // sees Object where it expects long and javac rejects.
   let typedArgs = $argCodes->map(a | $a->typedFunctionValue());
   let feRetType = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity);
   // Cast the Object result to the FE's expected type so the surrounding
   // expression (return statement, assignment, arg position) typechecks.
   // For primitive targets, cast to the BOXED equivalent — `(long) someObject`
   // is rejected by javac, but `(Long) someObject` works and Java auto-unboxes
   // in primitive-typed contexts (return, assignment, arithmetic).
   let castTarget = $feRetType->toBoxed();
   j_invoke($cls, 'execute', $typedArgs, javaObject())->j_castWithoutChecks($castTarget);
}

// One argument of a call to a translated function, typed as that function
// DECLARES the parameter: a value read out of a collection arrives as Object,
// and a `String[0..1]` parameter will not take it. A parameter whose
// multiplicity is itself a PARAMETER (`T[m]`) is left alone — its Java type is
// Object, and fitting a list to it would take only the first value.
function <<access.private>> platform::extensions::language::java::translation::udfArgument(conv: Conventions[1], fe: FunctionExpression[1], params: platform::pure::metamodel::valuespecification::VariableExpression[*], i: Integer[1]): Code[1]
{
   let raw = $conv->udfArgumentRaw($fe, $params, $i);
   // A parameter typed by a TYPE parameter has no Java type of its own (it
   // erases to Object), and asking for one would ask a TypeParameter for its
   // path — it has none.
   let declared = if ($i >= $params->size(), | []->cast(@platform::pure::metamodel::valuespecification::VariableExpression), | $params->at($i));
   let concrete = $declared->filter(p | $p.multiplicity->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity)
                                        && !$p.genericType->rawType()->isEmpty()
                                        && !$p.genericType->rawType()->toOne()->instanceOf(platform::pure::metamodel::type::generics::TypeParameter));
   if ($concrete->isEmpty(),
      | $raw,
      | $raw->fitToType($conv->pureTypeToJavaType($concrete->toOne().genericType, $concrete->toOne().multiplicity)->toBoxed(), $conv));
}

// An argument as the call writes it, before it is fitted to the declaration.
function <<access.private>> platform::extensions::language::java::translation::udfArgumentRaw(conv: Conventions[1], fe: FunctionExpression[1], params: platform::pure::metamodel::valuespecification::VariableExpression[*], i: Integer[1]): Code[1]
{
   // An argument for a List-typed parameter goes through translateAsList: Pure
   // lifts a single value into a collection parameter (`println('hello')`
   // calls a helper whose `Any[*]` parameter is a List), which a plain
   // translation would pass as a bare String.
   if ($i < $params->size() && $params->at($i).multiplicity->holdsManyValues(), | $conv->translateAsList($fe.parametersValues->at($i)),
   // A multiplicity parameter (`ifNotEmpty<T|m>(collection: T[m])`) takes the
   // value as it is: collapsing it to one value loses every other.
   |if ($i < $params->size() && !$params->at($i).multiplicity->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity),
                                                                                 | $conv->translateExpression($fe.parametersValues->at($i)),
   // `[]` for a single-valued parameter is its absence: null, not an empty list.
   |if ($fe.parametersValues->at($i)->isEmptyCollectionLiteral(),                 | j_null(),
   // A List (e.g. `let empty = []->cast(@Integer)`) for a single-valued
   // parameter: its only value, or null.
   |if ($i < $params->size() && !$fe.parametersValues->at($i)->resolvedMultiplicity()->isSingleValued(), | $conv->translateAsOptional($fe.parametersValues->at($i)),
                                                                                  | $conv->translateExpression($fe.parametersValues->at($i))))));
}

// The Java class of a UDF: its Pure signature name (`sort_T_MANY__...`, unique
// across overloads) in the platform package mirroring its Pure package, the
// same scheme as the platform types. The call site and the definition both go
// through here, so they always agree.
function <<access.private>> platform::extensions::language::java::translation::udfClassName(conv: Conventions[1], udf: platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[1]): String[1]
{
   let root = platform::extensions::language::java::translation::platform::platformRoot();
   $udf->platform::extensions::language::java::translation::platform::platformPackage($root) + '.' + $udf.name->toOne('udfClassName: UDF missing name')->replace('~', '_');
}

// Property-access heuristic: an FE is property-like when its `func` slot
// resolves to an AbstractProperty (the cleanest signal — compile resolved
// the dot to a known Property), OR — fallback for canonical-recompiled
// bodies where `func` may be empty — when the FE has exactly one
// parameter and no coder is registered for its name. A resolved function
// without a coder is not a property: it fails as untranslatable.
// `$p.fullName(true)` — the platform generates a method per qualified property
// (see platformQualifiedPropertyMethod), so the call carries its arguments,
// each typed as that method declares it.
function <<access.private>> platform::extensions::language::java::translation::translateQualifiedPropertyCall(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'translateQualifiedPropertyCall: needs a receiver');
   let javaRoot   = platform::extensions::language::java::translation::platform::platformRoot();
   let qp         = $fe.func->toOne()->cast(@platform::pure::metamodel::function::property::QualifiedProperty<platform::pure::metamodel::type::Any>);
   let name       = $qp->platform::extensions::language::java::translation::platform::qualifiedPropertyName()->platform::extensions::language::java::translation::platform::getterName();
   let owner      = $qp.owner->filter(o | $o->instanceOf(platform::pure::metamodel::type::Class))->cast(@platform::pure::metamodel::type::Class<Any>)->head();
   let receiver   = $conv->qualifiedPropertyReceiver($fe.parametersValues->at(0), $owner, $javaRoot);
   // The arguments are the CALL's, not the declaration's: a qualified property
   // may be overloaded (`res()` and `res(z)`), and `fe.func` can name either.
   let actuals    = $fe.parametersValues->slice(1, $fe.parametersValues->size());
   let declared   = $qp.parameters->slice(1, $qp.parameters->size());
   let args       = range(0, $actuals->size())->map(i |
                       $conv->qualifiedPropertyArgument($actuals->at($i), $declared->slice($i, $i + 1), $javaRoot));
   let returnType = $qp.genericType->platform::extensions::language::java::translation::platform::platformValueType($qp.multiplicity, $javaRoot);
   $receiver->j_invoke($name, $args, $returnType)
      ->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed(), $conv);
}

// The receiver of a qualified-property call, read through the platform interface
// of the class that declares it (the expression is often typed Object).
// One argument of a qualified-property call, typed as the method declares it
// when the declaration is the one the call resolved to.
function <<access.private>> platform::extensions::language::java::translation::qualifiedPropertyArgument(conv: Conventions[1], actual: ValueSpecification[1], declared: platform::pure::metamodel::valuespecification::VariableExpression[*], javaRoot: String[1]): Code[1]
{
   let code = $conv->translateExpression($actual);
   // Its own Java type when the declaration does not line up (an overload the
   // call resolved elsewhere): `(Object) "z"` does not fit a String parameter.
   if ($declared->isEmpty(),
      | $code->typedFunctionValue(),
      | $code->fitToType($declared->toOne().genericType->platform::extensions::language::java::translation::platform::platformValueType($declared->toOne().multiplicity, $javaRoot), $conv));
}

function <<access.private>> platform::extensions::language::java::translation::qualifiedPropertyReceiver(conv: Conventions[1], receiverVS: ValueSpecification[1], owner: platform::pure::metamodel::type::Class<Any>[0..1], javaRoot: String[1]): Code[1]
{
   let translated = $conv->translateExpression($receiverVS);
   let viaType    = $owner->map(c | javaClass($c->platform::extensions::language::java::translation::platform::platformTypeName($javaRoot)));
   if ($viaType->isEmpty() || $translated.type == $viaType->toOne(),
      | $translated,
      | $translated->toObjectCode()->j_castWithoutChecks($viaType->toOne()));
}

function <<access.private>> platform::extensions::language::java::translation::isPropertyAccessLike(conv: Conventions[1], fe: FunctionExpression[1]): Boolean[1]
{
   ($fe.func->isNotEmpty() && $fe.func->toOne()->instanceOf(platform::pure::metamodel::function::property::AbstractProperty))
   || ($fe.func->isEmpty() && $fe.parametersValues->size() == 1);
}

// Property access — `$x.propName` compiles to a 1-arg FunctionExpression.
// Our generated helper class exposes BOTH a public field `propName` and a
// no-arg method that returns the Pure type (`type()`). For most property
// names we want the field; for the special-cased `type` we want the
// method. Use the method form `_propName()` for cleaner downstream
// compatibility — wait, no, the field is what the property name maps to.
// Field access wins because that's the actual data slot.
function <<access.private>> platform::extensions::language::java::translation::translatePropertyAccess(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'translatePropertyAccess: property FE needs a receiver, got ' + $fe.parametersValues->size()->toString() + ' args');
   if ($fe->parentRefDepth()->isNotEmpty(), | $conv->parentRefCode($fe), | $conv->translateNonParentPropertyAccess($fe));
}

function <<access.private>> platform::extensions::language::java::translation::translateNonParentPropertyAccess(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let enumeration = $fe.parametersValues->at(0)->enumerationLiteral();
   if ($enumeration->isNotEmpty(),
      | // `Enumeration.VALUE`: the constant of the generated Java enum, not a
        // field read on the enumeration's name (which emitted `"E".VALUE`).
        let enumType = $conv->javaEnumType($enumeration->toOne());
        j_field($enumType, $fe.functionName->toOne()->platform::extensions::language::java::translation::safeJavaName(), $enumType);,
      | $conv->translateInstancePropertyAccess($fe)
   );
}

// The Property an FE reads, resolved — every caller that needs a slot off it goes
// through here rather than reading `$fe.func` directly.
//
// Two shapes of `func` arrive. Normally it is already a Property. But when the property
// belongs to a class compiled in this session — `compileSource`, or a PureRuntime
// in-memory module — it is a PropertyPointer: the pointer-resolution boundary leaves one
// alone on purpose, because it names a property rather than a packageable element
// (PointerGraph and both other JVM hosts agree), and PropertyPointer extends Property, so
// it passes an `instanceOf(Property)` test. Reading any slot but the four pointer-native
// ones off it trips the unresolved-pointer guard — `owner` and `multiplicity` are both
// read below, which is why this resolves ONCE here instead of per slot.
//
// Only `path` is read off the pointer (whitelisted); the property's name comes from
// `$fe.functionName`, which the FE carries anyway. Same `instanceOf` / `pathToElement`
// idiom functionTestRunner.pure uses for Package.children.
//
// The JavaScript translator never hit this: it needs no owner or declared multiplicity
// for a plain property read. Only a typed host has to name the declaring class.
function <<access.private>> platform::extensions::language::java::translation::resolvedProperty(fe: FunctionExpression[1]): platform::pure::metamodel::function::property::Property<platform::pure::metamodel::type::Nil, Any|*>[0..1]
{
   let candidates = $fe.func->filter(f | $f->instanceOf(platform::pure::metamodel::function::property::Property));
   let live       = $candidates->filter(f | !$f->instanceOf(platform::pure::metamodel::pointer::TempCompilerPointer))
                       ->cast(@platform::pure::metamodel::function::property::Property<platform::pure::metamodel::type::Nil, Any|*>);
   let resolved   = $candidates->filter(f | $f->instanceOf(platform::pure::metamodel::pointer::TempCompilerPointer))
                       ->map(f | pathToElement($f->cast(@platform::pure::metamodel::pointer::TempCompilerPointer).path))
                       ->filter(o | $o->instanceOf(platform::pure::metamodel::type::Class))
                       ->cast(@platform::pure::metamodel::type::Class<Any>)
                       ->map(c | $c.properties->filter(p | $p.name == $fe.functionName))
                       ->cast(@platform::pure::metamodel::function::property::Property<platform::pure::metamodel::type::Nil, Any|*>);
   let all = $live->concatenate($resolved);
   if ($all->isEmpty(), | []->cast(@platform::pure::metamodel::function::property::Property<platform::pure::metamodel::type::Nil, Any|*>), | $all->at(0));
}

// The class declaring the property an FE reads, when it is one with a generated
// class (a user class, or the Pure List / Pair).
function <<access.private>> platform::extensions::language::java::translation::propertyOwnerClass(fe: FunctionExpression[1]): platform::pure::metamodel::type::Class<Any>[0..1]
{
   let owners = $fe->platform::extensions::language::java::translation::resolvedProperty().owner
                   ->filter(o | $o->instanceOf(platform::pure::metamodel::type::Class) && !$o->instanceOf(platform::pure::metamodel::type::Enumeration))
                   ->cast(@platform::pure::metamodel::type::Class<Any>);
   if ($owners->isEmpty(), | []->cast(@platform::pure::metamodel::type::Class<Any>), | $owners->at(0));
}

// `receiver.property` on an instance (see {@link translatePropertyAccess}).
function <<access.private>> platform::extensions::language::java::translation::translateInstancePropertyAccess(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let receiverVS = $fe.parametersValues->at(0);
   let raw      = $receiverVS.genericType->rawType();
   let isEnum   = $raw->isNotEmpty()
                  && ($raw->toOne()->instanceOf(platform::pure::metamodel::type::Enumeration) || $raw->toOne() == platform::pure::metamodel::type::Enum);
   // A single instance of a user class is read through its generated class: the
   // Java expression is often typed Object (a fold accumulator, a lambda
   // parameter from a raw functional interface), where the field isn't visible.
   let translated = $conv->translateExpression($receiverVS);
   // The class to read through: the class declaring the property, whose
   // platform interface has the getter (the receiver may be typed as a class
   // that only inherits it, or not at all: `$s->cast(@List<String>).values` where
   // the Java variable is still a String); else the receiver's own class
   // (association properties are owned by the association).
   let generated = $raw->filter(t | $t->isUserClassType() || $t == platform::pure::functions::collection::List || $t == platform::pure::functions::collection::Pair)
                       ->cast(@platform::pure::metamodel::type::Class<Any>);
   let owner    = $fe->propertyOwnerClass();
   let readVia  = if ($owner->isNotEmpty(), | $owner, | $generated);
   let viaType  = $readVia->map(c | javaClass($c->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot())));
   let receiver = if ($viaType->isEmpty() || $receiverVS.multiplicity->holdsManyValues() || $translated.type == $viaType->toOne(),
      | $translated,
      | $translated->toObjectCode()->j_castWithoutChecks($viaType->toOne()));
   // Special-case `.type()` which is a generated method, not a field. An enum
   // value's `name` is Enum.name() — the field is private to java.lang.Enum.
   let isProperty = $fe.func->isNotEmpty() && $fe.func->toOne()->instanceOf(platform::pure::metamodel::function::property::Property);
   if ($fe.functionName == 'type' && !$isProperty, | $receiver->j_invoke('type', [], javaString()),
   // An enum value is a Java enum constant, or — with metadata — the metamodel
   // object of an enumeration read from a PDB.
   |if ($isEnum && $fe.functionName == 'name' && $conv.metadataElements,
                                                  | j_invoke(javaClass($conv->pdbClass('Metadata')), 'enumName', [$translated->toObjectCode()], javaString()),
   |if ($isEnum && $fe.functionName == 'name',     | $receiver->j_cast(javaClass('java.lang.Enum'))->j_invoke('name', [], javaString()),
                                                   | $conv->typedFieldRead($fe, $receiver->j_invoke($fe.functionName->toOne()->platform::extensions::language::java::translation::platform::getterName(), [], javaObject()))
   )));
}

// A generated field is typed Object; a single-valued read is cast to the
// property's boxed Java type so `return person.lastName` fits a String result,
// a many-valued one to a raw List (setters store every many-valued property as
// a list, `^X(p='a')` included).
function <<access.private>> platform::extensions::language::java::translation::typedFieldRead(conv: Conventions[1], fe: FunctionExpression[1], read: Code[1]): Code[1]
{
   // A property whose multiplicity is a parameter (`TryResult.value` is `V[m]`)
   // is a List on the platform type, whatever this read's multiplicity is.
   let declared = $fe->platform::extensions::language::java::translation::resolvedProperty().multiplicity;
   let listed   = $declared->exists(m | !$m->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity));
   if ($fe.multiplicity->holdsManyValues(),
      | $read->j_castWithoutChecks(javaList()),
   |if ($listed,
      | $read->singleValueOfAny($conv)->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed()),
      | $read->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed())));
}

// `new(holder, [KeyExpression('k1', v1), KeyExpression('k2', v2), ...])`
// — Pure instance construction. We emit a HashMap-backed runtime model:
//   `java.util.Map.ofEntries(
//      java.util.Map.entry("__class__", "Foo"),
//      java.util.Map.entry("k1", v1Code),
//      java.util.Map.entry("k2", v2Code))`
// The `__class__` marker distinguishes instances of different Pure classes
// with the same property shape so PCT assertEquals still discriminates.
function <<access.private>> platform::extensions::language::java::translation::newCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'newCoder expects at least 1 argument (target type holder), got ' + $fe.parametersValues->size()->toString());
   let className = $conv->extractNewTargetName($fe.parametersValues->at(0));
   let keyExprs  = if ($fe.parametersValues->size() >= 2,
                        | $conv->collectKeyExpressions($fe.parametersValues->at(1)),
                        | []->cast(@FunctionExpression));
   // Emit `new ClassName()._k1(v1)._k2(v2)` — fluent setters chained on a
   // freshly-constructed helper class. buildSignature generates the helper
   // class definition alongside GalleryRunner so this compiles.
   let pureClass = $fe.genericType->rawType()->filter(t | $t->instanceOf(platform::pure::metamodel::type::Class))->cast(@platform::pure::metamodel::type::Class<Any>);
   let cls = if ($pureClass->isEmpty(), | javaClass($conv.basePackageName + '.' + $className), | javaClass($pureClass->toOne()->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot()) + 'Impl'));
   // A class known only at run time (`new(^GenericType(type = $t))`): the
   // instance and its keys go through the metadata.
   let dynamic = $conv.metadataElements && ($pureClass->isEmpty() || $pureClass->at(0) == Any);
   let fresh = if ($dynamic,
                  | j_invoke(javaClass($conv->pdbClass('Metadata')), 'newInstance',
                             [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaObject()),
                  | ^platform::extensions::language::java::metamodel::New(type = $cls, arguments = []));
   // With metadata, an instance carries its classifier, so `$x.classifierGenericType`
   // answers the class it was built from (`assertIs(LA_Person, ...)`).
   // `^X(10)(...)` writes the type-variable values on the TARGET it names —
   // inside its classifier's type argument, where the wrapped class lives too
   // (a holder's own `genericType` is the holder, see extractNameFrom...).
   let typeVarValues = $fe.genericType->concatenate($fe.parametersValues->at(0)->newTargetGenericTypes())
                          ->filter(g | $g->instanceOf(platform::pure::metamodel::type::generics::GenericTypeValue))
                          ->cast(@platform::pure::metamodel::type::generics::GenericTypeValue)
                          ->map(g | $g.typeVariableValues);
   let ctor = $conv->withClassifier($fresh, $cls, $pureClass, $fe.genericType, $typeVarValues);
   // `^X(p = v)` writes its keys as `keyExpression(...)` calls, which are read
   // here; a program can also BUILD KeyExpression values and hand them over, and
   // those are only known when `new` runs.
   let writtenKeys = $keyExprs->forAll(k | $k.functionName == 'keyExpression');
   let built = if (!$writtenKeys,
      | j_invoke(javaClass($conv->pdbClass('Metadata')), 'setKeysFrom',
                 [if ($dynamic, | $fresh, | $ctor), $conv->translateAsList($fe.parametersValues->at(1))], javaObject())
           ->j_castWithoutChecks($cls),
   |if ($dynamic,                                                    | $conv->setKeysDynamically($fresh, $keyExprs),
   |if ($conv->needsConstructionScope($pureClass, $keyExprs),        | $conv->scopedConstruction($ctor, $cls, $pureClass, $keyExprs),
                                                                    | $conv->setKeys($ctor, $cls, $keyExprs))));
   $conv->withClassConstraints($built, $pureClass, $fe, $typeVarValues);
}

// A class may constrain its instances (`[wx(~function:$this.text->size() < $x)]`):
// the checks run on what was just built, with `$this` bound to it and the
// class's type variables to the values it was built with.
function <<access.private>> platform::extensions::language::java::translation::withClassConstraints(conv: Conventions[1], built: Code[1], pureClass: platform::pure::metamodel::type::Class<Any>[*], fe: FunctionExpression[1], typeVariableValues: ValueSpecification[*]): Code[1]
{
   let constraints = $pureClass->cast(@platform::pure::metamodel::type::Type)->constraintsOf();
   let variables   = $pureClass->map(c | $c.typeVariables);
   let bindings    = range($variables->size())->filter(i | $i < $typeVariableValues->size())->map(i |
                        j_declare($conv->pureTypeToJavaType($variables->at($i).genericType, $variables->at($i).multiplicity)->toBoxed(),
                                  $variables->at($i).name->platform::extensions::language::java::translation::safeJavaName(),
                                  $conv->translateExpression($typeVariableValues->at($i))));
   if ($constraints->isEmpty() || !$conv.metadataElements || $bindings->size() != $variables->size(),
      | $built,
      | $conv->constraintChecksBound($built, $constraints, $pureClass->toOne(), $fe, $bindings));
}

// `new XImpl()._classifierGenericType(new GenericTypeValueImpl()._type(<the class>))`
// on the Java platform: the metamodel object is the one the metadata holds, so
// identity against the class element holds.
// The generic types a `new` target carries its arguments on: the holder may be
// the value specification itself, or the value inside one.
function <<access.private>> platform::extensions::language::java::translation::newTargetGenericTypes(target: ValueSpecification[1]): platform::pure::metamodel::type::generics::GenericType[*]
{
   let direct = $target->filter(t | $t->instanceOf(platform::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder))
                   ->cast(@platform::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder);
   let held   = $target->filter(t | $t->instanceOf(AtomicValue))->cast(@AtomicValue).value
                   ->filter(v | $v->instanceOf(platform::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder))
                   ->cast(@platform::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder);
   $direct->concatenate($held)->map(h | $h.classifierGenericType.typeArguments);
}

function <<access.private>> platform::extensions::language::java::translation::withClassifier(conv: Conventions[1], ctor: Code[1], cls: platform::extensions::language::java::metamodel::Type[1], pureClass: platform::pure::metamodel::type::Class<Any>[*], genericType: platform::pure::metamodel::type::generics::GenericType[*], typeVariableValues: ValueSpecification[*]): Code[1]
{
   if (!$conv.metadataElements || $pureClass->isEmpty(),
      | $ctor,
      | // `^X<A>(...)`: the type arguments travel with the classifier.
        let typeArgs = $genericType->filter(g | $g->instanceOf(platform::pure::metamodel::type::generics::GenericTypeValue))
                          ->cast(@platform::pure::metamodel::type::generics::GenericTypeValue)
                          ->map(g | $g.typeArguments)
                          ->map(ta | $ta->rawType())
                          ->filter(t | $t->instanceOf(platform::pure::metamodel::PackageableElement))
                          ->map(t | j_string($t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()));
        // `^X(8)(...)`: a class may declare type VARIABLES, and their values
        // belong to the classifier — that is where `$x` is read from.
        let typeVars = $typeVariableValues->map(v | $conv->translateExpression($v)->toObjectCode());
        let classifier = j_invoke(javaClass($conv->pdbClass('Metadata')), 'classifier',
                                  [j_string($pureClass->at(0)->elementToPath()),
                                   j_invoke(javaArrays(), 'asList', $typeArgs, javaList()),
                                   j_invoke(javaArrays(), 'asList', $typeVars, javaList())], javaObject());
        $ctor->j_invoke('_classifierGenericType', [$classifier], $cls););
}

// `Metadata.set(Metadata.set(instance, "k1", v1), "k2", v2)` — the setters of a
// class the generated code cannot name.
function <<access.private>> platform::extensions::language::java::translation::setKeysDynamically(conv: Conventions[1], target: Code[1], keyExprs: FunctionExpression[*]): Code[1]
{
   $keyExprs->fold({ke, acc |
      let propName = $conv->extractKeyExpressionPropName($ke);
      let valCode  = $conv->translateExpression($ke.parametersValues->at(1))->toObjectCode();
      j_invoke(javaClass($conv->pdbClass('Metadata')), 'set', [$acc, j_string($propName), $valCode], javaObject());
   }, $target);
}

// `target._k1(v1)._k2(v2)...` for the key expressions of a new / copy.
function <<access.private>> platform::extensions::language::java::translation::setKeys(conv: Conventions[1], target: Code[1], cls: platform::extensions::language::java::metamodel::Type[1], keyExprs: FunctionExpression[*]): Code[1]
{
   $keyExprs->fold({ke, acc |
      let propName = $conv->extractKeyExpressionPropName($ke);
      // A setter takes Object, and a bare Java lambda has no type there: a
      // function-valued property (a section parser) needs its interface named.
      let valCode  = $conv->translateExpression($ke.parametersValues->at(1))->typedFunctionValue();
      $acc->j_invoke($ke->keyExpressionSetter($propName), [$valCode], $cls);
   }, $target);
}

// A construction needs the PureNew scope when its class has association
// properties (their values must be fresh, and their reverse ends are linked)
// or when a key refers to the object being built through `~`.
function <<access.private>> platform::extensions::language::java::translation::needsConstructionScope(conv: Conventions[1], pureClass: platform::pure::metamodel::type::Class<Any>[*], keyExprs: FunctionExpression[*]): Boolean[1]
{
   $pureClass->exists(c | $c->hasAssociationProperties())
      || $keyExprs->exists(ke | $ke.parametersValues->slice(1, 2)->containsParentRef());
}

// `(X) PureNew.run(instance, () -> ((X) PureNew.self(0))._k1(v1)..._pureFinish())`:
// the keys run with `instance` on the construction stack and in a fresh scope
// (see {@link pureNewHelperClass}). The Supplier has no parameter, so nested
// constructions can't clash on a name.
function <<access.private>> platform::extensions::language::java::translation::scopedConstruction(conv: Conventions[1], instance: Code[1], cls: platform::extensions::language::java::metamodel::Type[1], pureClass: platform::pure::metamodel::type::Class<Any>[*], keyExprs: FunctionExpression[*]): Code[1]
{
   let newType = javaClass($conv->pdbClass('PureNew'));
   let self    = j_invoke($newType, 'self', [j_int(0)], javaObject())->j_castWithoutChecks($cls);
   let keyed   = $conv->setKeys($self, $cls, $keyExprs);
   let body    = if ($pureClass->exists(c | $c->hasAssociationProperties()), | $keyed->j_invoke('_pureFinish', [], $cls), | $keyed);
   j_invoke($newType, 'run', [$instance, j_lambda([], $body)], javaObject())->j_castWithoutChecks($cls);
}

// True when `cls` or a user superclass has properties from an association.
function <<access.private>> platform::extensions::language::java::translation::hasAssociationProperties(cls: platform::pure::metamodel::type::Class<Any>[1]): Boolean[1]
{
   $cls->concatenate($cls->userAncestors())->exists(c | $c.propertiesFromAssociations->isNotEmpty());
}

// `~` → 0, `~.~` → 1, ...: how many constructions up a parent reference reads;
// empty when `vs` isn't one. Same shape as the JavaScript translator's.
function <<access.private>> platform::extensions::language::java::translation::parentRefDepth(vs: ValueSpecification[1]): Integer[0..1]
{
   $vs->match([
      v: VariableExpression[1]     | if ($v.name->startsWith('~'), | 0, | []->cast(@Integer)),
      fe: FunctionExpression[1]    | if ($fe.functionName == '~' && $fe.parametersValues->size() == 1, | $fe.parametersValues->at(0)->parentRefDepth()->map(d | $d + 1), | []->cast(@Integer)),
      other: ValueSpecification[1] | []->cast(@Integer)
   ]);
}

// True when a parent reference (`~`) occurs anywhere in `exprs`, lambda bodies included.
function <<access.private>> platform::extensions::language::java::translation::containsParentRef(exprs: ValueSpecification[*]): Boolean[1]
{
   $exprs->exists(e | $e->match([
      v: VariableExpression[1]     | $v.name->startsWith('~'),
      fe: FunctionExpression[1]    | $fe.parametersValues->containsParentRef(),
      av: AtomicValue[1]           | $av.value->filter(x | $x->instanceOf(LambdaFunction))->cast(@LambdaFunction<Any>)->exists(l | $l.expressionSequence->containsParentRef()),
      col: Collection[1]           | $col.values->containsParentRef(),
      other: ValueSpecification[1] | false
   ]));
}

// A parent reference as the object on the construction stack, cast to its type.
function <<access.private>> platform::extensions::language::java::translation::parentRefCode(conv: Conventions[1], vs: ValueSpecification[1]): Code[1]
{
   j_invoke(javaClass($conv->pdbClass('PureNew')), 'self', [j_int($vs->parentRefDepth()->toOne())], javaObject())
      ->j_castWithoutChecks($conv->pureTypeToJavaType($vs.genericType, PureOne)->toBoxed());
}

function <<access.private>> platform::extensions::language::java::translation::mapEntryCode(key: Code[1], val: Code[1]): Code[1]
{
   let pairType = javaClass(platform::extensions::language::java::translation::platform::platformTypeName(platform::pure::functions::collection::Pair, platform::extensions::language::java::translation::platform::platformRoot()));
   // The setters take Object, so no cast: `(Object) -2L` would parse as a subtraction.
   j_new(javaClass($pairType->platform::extensions::language::java::serialization::typeToString() + 'Impl'), [])
      ->j_invoke('_first', [$key], $pairType)
      ->j_invoke('_second', [$val], $pairType);
}

// `copy(src, keyExprs)` — Pure: return a new instance of {@code src}'s type
// with the override fields applied. Emit
// {@code ((Foo)src)._copy()._k1(v1)._k2(v2)} — the {@code _copy()} method
// is generated alongside the helper class's fluent setters (see
// {@link generateHelperClass}). The cast threads through `extractClassRefFromCopy`
// so the surface type matches the helper class.
function <<access.private>> platform::extensions::language::java::translation::copyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'copyCoder expects at least 1 argument');
   let src      = $fe.parametersValues->at(0);
   let rawOpt   = $src.genericType->rawType();
   let srcCode  = $conv->translateExpression($src);
   let keyExprs = if ($fe.parametersValues->size() >= 2,
                       | $conv->collectKeyExpressions($fe.parametersValues->at(1)),
                       | []->cast(@FunctionExpression));
   // Resolve the class name from the source's genericType so the emitted
   // cast / setter chain matches the generated helper class. If the type
   // isn't a Pure Class (e.g. inferred to Any), skip the cast and fall
   // through to a raw _copy() call.
   let clsOpt = if ($rawOpt->isNotEmpty() && $rawOpt->toOne()->instanceOf(platform::pure::metamodel::type::Class),
      | [javaClass($rawOpt->toOne()->cast(@platform::pure::metamodel::PackageableElement)->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot()))],
      | []->cast(@platform::extensions::language::java::metamodel::Class)
   );
   let typedSrc = if ($clsOpt->isEmpty(), | $srcCode, | $srcCode->j_cast($clsOpt->toOne()));
   let copyType = if ($clsOpt->isEmpty(), | javaObject(), | $clsOpt->toOne()->cast(@platform::extensions::language::java::metamodel::Type));
   let copied = $typedSrc->j_invoke('_copy', [], $copyType);
   let pureClass = $rawOpt->filter(t | $t->instanceOf(platform::pure::metamodel::type::Class))->cast(@platform::pure::metamodel::type::Class<Any>);
   // A key-less copy (`^$x()`) only registers as fresh: like the other
   // platforms, it doesn't re-check or re-link the association values it copies.
   if ($conv->needsConstructionScope($pureClass, $keyExprs),
      | $conv->scopedConstruction($copied, $copyType, $pureClass->filter(c | $keyExprs->isNotEmpty()), $keyExprs),
      | $conv->setKeys($copied, $copyType, $keyExprs));
}

// ----------------------------------------------------------------------------
// Pure Map<U,V> — coders + per-compilation-unit PureMap helper class.
//
// Pure's collection::Map is immutable: every op returns a fresh map. We map
// each Pure call to a static method on a generated PureMap class so the
// callsite stays a one-liner and the immutability/copy semantics live in
// one place. `pair(a, b)` translates inline to `java.util.Map.entry(a, b)`
// so the helper's varargs of Map.Entry work uniformly whether the entries
// came from `pair(...)` or another source.
// ----------------------------------------------------------------------------

function <<access.private>> platform::extensions::language::java::translation::pairCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'pairCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   mapEntryCode(
      $conv->translateExpression($fe.parametersValues->at(0))->typedFunctionValue(),
      $conv->translateExpression($fe.parametersValues->at(1))->typedFunctionValue()
   );
}

// A Java lambda cast to the raw functional interface of its arity (Supplier,
// Function, BiFunction), the ones evaluate applies, so it can sit where Java
// infers nothing from the target (`Map.entry("plus", (a, b) -> ...)`); any
// other code as is.
// Pure lambdas of three parameters have no JDK functional interface; the
// platform carries one (the JDK stops at BiFunction).
function <<access.private>> platform::extensions::language::java::translation::pureFunction3Class(): String[1]
{
   'org.finos.legend.pure.platform.java.runtime.PureFunction3'
}

function <<access.private>> platform::extensions::language::java::translation::typedFunctionValue(code: Code[1]): Code[1]
{
   let arity = $code->match([l: platform::extensions::language::java::metamodel::Lambda[1] | $l.parameters->size(), other: Code[1] | -1]);
   if ($arity == 0, | $code->j_castWithoutChecks(javaSupplier(javaObject())),
   |if ($arity == 1, | $code->j_castWithoutChecks(javaFunction(javaObject(), javaObject())),
   |if ($arity == 2, | $code->j_castWithoutChecks(javaBiFunction(javaObject(), javaObject(), javaObject())),
   |if ($arity == 3, | $code->j_castWithoutChecks(javaClass(platform::extensions::language::java::translation::pureFunction3Class())),
                     | $code))));
}

// Build the static-method invocation `PureMap.<methodName>(args...)` against
// the generated helper class — single source of truth so coders + the helper
// class generator agree on the symbol.
function <<access.private>> platform::extensions::language::java::translation::pureMapCall(conv: Conventions[1], methodName: String[1], args: Code[*], retType: platform::extensions::language::java::metamodel::Type[1]): Code[1]
{
   j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureMap')), $methodName, $args, $retType);
}

function <<access.private>> platform::extensions::language::java::translation::newMapCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   // Single-arg form `newMap(pairs)` is the only one the translator handles —
   // the 2-arg form `newMap(pairs, prop)` adds a custom key extractor and
   // would require translating that property reference to a Java function,
   // which the PCT tests under `platform::pure::functions::collection` don't
   // exercise via this path.
   assert($fe.parametersValues->size() >= 1, | 'newMapCoder expects at least 1 argument');
   let entries = $conv->translateExpression($fe.parametersValues->at(0));
   $conv->pureMapCall('newMap', [$entries], javaMap(javaObject(), javaObject()));
}

function <<access.private>> platform::extensions::language::java::translation::getCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'getCoder expects exactly 2 arguments');
   if ($fe.parametersValues->at(0)->isVariantTyped(), | $conv->variantGet($fe), | $conv->mapGet($fe));
}

// `variant->get('key')` / `variant->get(index)`: an object's field or an array's element.
function <<access.private>> platform::extensions::language::java::translation::variantGet(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let byKey = $fe.parametersValues->at(1).genericType->rawType() == [String];
   let key   = $conv->translateExpression($fe.parametersValues->at(1));
   j_invoke($conv->javaVariantType(), if ($byKey, | 'get', | 'at'),
            [$conv->variantArgument($fe.parametersValues->at(0)), if ($byKey, | $key->j_cast(javaString()), | $key->j_cast(javaLong()))],
            $conv->javaVariantType());
}

// `map->get(key)`
function <<access.private>> platform::extensions::language::java::translation::mapGet(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let m   = $conv->translateExpression($fe.parametersValues->at(0));
   let key = $conv->translateExpression($fe.parametersValues->at(1));
   $conv->pureMapCall('get', [$m, $key], javaObject())->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed());
}

function <<access.private>> platform::extensions::language::java::translation::putCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'putCoder expects exactly 3 arguments');
   let m   = $conv->translateExpression($fe.parametersValues->at(0));
   let key = $conv->translateExpression($fe.parametersValues->at(1));
   let val = $conv->translateExpression($fe.parametersValues->at(2));
   $conv->pureMapCall('put', [$m, $key, $val], javaMap(javaObject(), javaObject()));
}

function <<access.private>> platform::extensions::language::java::translation::putAllCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   // Both Pure overloads — putAll(m, pairs) and putAll(m, otherMap) — land
   // here. PureMap.putAll detects List-vs-Map at runtime.
   assert($fe.parametersValues->size() == 2, | 'putAllCoder expects exactly 2 arguments');
   let m   = $conv->translateExpression($fe.parametersValues->at(0));
   let add = $conv->translateExpression($fe.parametersValues->at(1));
   $conv->pureMapCall('putAll', [$m, $add], javaMap(javaObject(), javaObject()));
}

function <<access.private>> platform::extensions::language::java::translation::removeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'removeCoder expects exactly 2 arguments');
   let m   = $conv->translateExpression($fe.parametersValues->at(0));
   let key = $conv->translateExpression($fe.parametersValues->at(1));
   $conv->pureMapCall('remove', [$m, $key], javaMap(javaObject(), javaObject()));
}

function <<access.private>> platform::extensions::language::java::translation::keysCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'keysCoder expects exactly 1 argument');
   $conv->pureMapCall('keys', [$conv->translateExpression($fe.parametersValues->at(0))], javaList(javaObject()));
}

// `map->values()`; on anything but a Map, `values` is a property — `$list.values`
// on a Pure List (coders are keyed by short name, so both arrive here).
function <<access.private>> platform::extensions::language::java::translation::valuesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'valuesCoder expects exactly 1 argument');
   if ($fe.parametersValues->at(0).genericType->rawType() == [platform::pure::functions::collection::Map],
      | $conv->pureMapCall('values', [$conv->translateExpression($fe.parametersValues->at(0))], javaList(javaObject())),
      | $conv->translatePropertyAccess($fe));
}

function <<access.private>> platform::extensions::language::java::translation::keyValuesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'keyValuesCoder expects exactly 1 argument');
   $conv->pureMapCall('keyValues', [$conv->translateExpression($fe.parametersValues->at(0))], javaList(javaObject()));
}

function <<access.private>> platform::extensions::language::java::translation::replaceAllCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'replaceAllCoder expects exactly 2 arguments');
   let m     = $conv->translateExpression($fe.parametersValues->at(0));
   let pairs = $conv->translateExpression($fe.parametersValues->at(1));
   $conv->pureMapCall('replaceAll', [$m, $pairs], javaMap(javaObject(), javaObject()));
}

function <<access.private>> platform::extensions::language::java::translation::getIfAbsentPutWithKeyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 3, | 'getIfAbsentPutWithKeyCoder expects exactly 3 arguments');
   let m   = $conv->translateExpression($fe.parametersValues->at(0));
   let key = $conv->translateExpression($fe.parametersValues->at(1));
   // The function arg may be a literal lambda or a stored Function value;
   // translateExpression handles both — closure literals land as Java
   // lambdas which auto-conform to java.util.function.Function.
   let fn  = $conv->translateExpression($fe.parametersValues->at(2));
   $conv->pureMapCall('getIfAbsentPutWithKey', [$m, $key, $fn], javaObject());
}

// Pull the target Class name from a `new`'s first arg. Common shapes:
//   - AtomicValue holding a Class (`^Foo(...)` -> ^Foo's class reference)
//   - UserDefinedGenericTypeAndMultiplicityHolder carrying a GenericType
//     whose rawType is the Class
//   - Other shapes fall back to a generic marker.
function <<access.private>> platform::extensions::language::java::translation::extractNewTargetName(conv: Conventions[1], holder: ValueSpecification[1]): String[1]
{
   $holder->match([
      gmh: platform::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder[1] |
         $conv->extractNameFromGenericTypeAndMultiplicityHolder($gmh);,
      av: AtomicValue[1] |
         let v = $av.value;
         if ($v->size() == 1,
            | $conv->extractNameFromHolderValue($v->toOne()),
            | 'PureInstance'
         );,
      other: ValueSpecification[1] | 'PureInstance'
   ]);
}

function <<access.private>> platform::extensions::language::java::translation::extractNameFromHolderValue(conv: Conventions[1], v: Any[1]): String[1]
{
   if ($v->instanceOf(platform::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder),
      | $conv->extractNameFromGenericTypeAndMultiplicityHolder($v->cast(@platform::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder)),
   | if ($v->instanceOf(platform::pure::metamodel::PackageableElement),
      | $v->cast(@platform::pure::metamodel::PackageableElement).name->toOneMany()->at(0),
      | 'PureInstance'
   ));
}

function <<access.private>> platform::extensions::language::java::translation::extractNameFromGenericTypeAndMultiplicityHolder(conv: Conventions[1], gmh: platform::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder[1]): String[1]
{
   // The wrapped class is the T parameter of GMH<T>; look it up via
   // classifierGenericType.typeArguments[0].rawType(). The instance's
   // own `.genericType` slot inherits from VS and points to GMH itself
   // (not the wrapped class), so we'd extract "...Holder" if we used it.
   let typeArgs = $gmh.classifierGenericType.typeArguments;
   if ($typeArgs->isNotEmpty(),
      | let raw = $typeArgs->at(0)->rawType();
        if ($raw->isNotEmpty() && $raw->toOne()->instanceOf(platform::pure::metamodel::PackageableElement),
           | $raw->toOne()->cast(@platform::pure::metamodel::PackageableElement).name->toOneMany()->at(0),
           | 'PureInstance'
        );,
      | 'PureInstance'
   );
}

// `new`'s key-expression list arg shows up as a Collection of inline-built
// KeyExpression values. Each KeyExpression is itself a FunctionExpression
// (functionName == 'keyExpression') whose two args are the name string +
// the value VS. Walk the Collection to extract them all.
function <<access.private>> platform::extensions::language::java::translation::collectKeyExpressions(conv: Conventions[1], arg: ValueSpecification[1]): FunctionExpression[*]
{
   if ($arg->instanceOf(Collection),
      | $arg->cast(@Collection).values->map(v | $conv->asKeyExpressionFE($v))->cast(@FunctionExpression),
      | $conv->asKeyExpressionFE($arg);
   );
}

function <<access.private>> platform::extensions::language::java::translation::asKeyExpressionFE(conv: Conventions[1], vs: ValueSpecification[1]): FunctionExpression[*]
{
   if ($vs->instanceOf(FunctionExpression),
      | $vs->cast(@FunctionExpression),
      | []->cast(@FunctionExpression)
   );
}

function <<access.private>> platform::extensions::language::java::translation::keyExpressionToEntry(conv: Conventions[1], ke: FunctionExpression[1]): Code[1]
{
   assert($ke.parametersValues->size() == 2, | 'keyExpressionToEntry expects 2-arg keyExpression, got ' + $ke.parametersValues->size()->toString());
   let nameArg = $ke.parametersValues->at(0);
   let propName = if ($nameArg->instanceOf(AtomicValue),
                       | $nameArg->cast(@AtomicValue).value->toOne()->cast(@String),
                       | 'unknownProp');
   let valCode = $conv->translateExpression($ke.parametersValues->at(1));
   mapEntryCode(j_string($propName), $valCode);
}

// Literals: dispatch on the Pure primitive type. Integer→j_long mirrors the
// translator's `Integer→long` type mapping in pureTypeToJavaType so the
// emitted Java compiles without explicit conversions. Multi-valued atomic
// values turn into `Arrays.asList(...)` (typed `List<Object>`); empty
// values become `Collections.emptyList()`.
function <<access.private>> platform::extensions::language::java::translation::translateAtomicValue(conv: Conventions[1], a: AtomicValue[1]): Code[1]
{
   let v = $a.value;
   if ($v->isEmpty(),
       | j_invoke(javaCollections(), 'emptyList', [], javaList(javaObject())),
       | if ($v->size() == 1,
             | $conv->translateScalarAtomicValueTyped($v->toOne(), $a),
             | j_invoke(javaArrays(), 'asList', $v->map(x | $conv->translateScalarAtomicValue($x)), javaList(javaObject()))
         )
   );
}

// Type-aware single-value translation. Pure stores date literals as Strings
// in AtomicValue.value with the date type carried on .genericType; we look
// at the genericType to emit `LocalDate.parse("...")` etc. instead of a
// bare String. Falls back to the type-unaware translateScalarAtomicValue
// for everything else.
function <<access.private>> platform::extensions::language::java::translation::translateScalarAtomicValueTyped(conv: Conventions[1], v: Any[1], a: AtomicValue[1]): Code[1]
{
   if ($v->instanceOf(String) && $a.genericType->isNotEmpty(),
      | let rawOpt = $a.genericType->toOne()->rawType();
        if([pair(| $rawOpt->isNotEmpty() && $conv->isDateTypeFor($rawOpt->toOne()),
                 | $conv->dateLiteralToJava($v->cast(@String), $rawOpt->toOne())),
            pair(| $rawOpt->isNotEmpty() && $rawOpt->toOne() == platform::pure::metamodel::type::primitives::Binary,
                 | binaryLiteralToJava($v->cast(@String)))],
           | $conv->translateScalarAtomicValue($v));,
      | $conv->translateScalarAtomicValue($v)
   );
}

// A binary literal carries its hex text on the AtomicValue; the Java value of
// a Binary is a byte[]. java.util.HexFormat keeps the emitted code JDK-only,
// and `0x` (no digits) parses to a zero-length array.
function <<access.private>> platform::extensions::language::java::translation::binaryLiteralToJava(hex: String[1]): Code[1]
{
   j_invoke(javaClass('java.util.HexFormat'), 'of', [], javaClass('java.util.HexFormat'))->j_invoke('parseHex', [j_string($hex)], javaArray(javaByte()));
}

function <<access.private>> platform::extensions::language::java::translation::isDateTypeFor(conv: Conventions[1], t: platform::pure::metamodel::type::Type[1]): Boolean[1]
{
   $t == platform::pure::metamodel::type::primitives::Date
   || $t == platform::pure::metamodel::type::primitives::DateTime
   || $t == platform::pure::metamodel::type::primitives::StrictDate
   || $t == platform::pure::metamodel::type::primitives::LatestDate
   || $t == platform::pure::metamodel::type::primitives::StrictTime;
}

// A date literal: PureDate.of("...") for the date types, LocalTime.parse for StrictTime.
function <<access.private>> platform::extensions::language::java::translation::dateLiteralToJava(conv: Conventions[1], s: String[1], dateType: platform::pure::metamodel::type::Type[1]): Code[1]
{
   if ($dateType == platform::pure::metamodel::type::primitives::StrictTime,
      | j_invoke(javaClass('java.time.LocalTime'), 'parse', [j_string($s)], javaClass('java.time.LocalTime')),
      | $conv->pureDateLiteral($s));
}

// Single-element atomic-value translation, factored out so multi-valued
// AtomicValues can map their elements without re-dispatching through
// translateAtomicValue. Also handles inline lambda literals (passed as
// `Function`-typed arguments to natives like `map`/`filter`/`fold`).
function <<access.private>> platform::extensions::language::java::translation::translateScalarAtomicValue(conv: Conventions[1], v: Any[1]): Code[1]
{
   $v->match([
      i: Integer[1]             | j_long($i),
      f: Float[1]               | j_double($f),
      b: Boolean[1]             | j_boolean($b),
      s: String[1]              | j_string($s),
      // Pure Decimal literals (`3.14d`) — java.math.BigDecimal from their text,
      // so no binary rounding creeps in (0.1d + 0.2d is 0.3).
      d: platform::pure::metamodel::type::primitives::Decimal[1] | j_new(javaBigDecimal(), [j_string($d->toString())]),
      // Pure Date / DateTime / StrictDate / LatestDate / StrictTime literals
      // (`%2014-02-27`, `%2014-02-27T10:01:35`). Their toString round-trips
      // through Pure's normalized form (zone-less ISO); pair with the
      // {@code java.time} class that {@link pureTypeToJavaTypeResolved} maps
      // the Pure type to. {@code LocalDate.parse} / {@code LocalDateTime.parse}
      // handle the date-only / date-time strings respectively.
      stm:    platform::pure::metamodel::type::primitives::StrictTime[1]  | dateLiteralCode($stm->toString(),    'java.time.LocalTime'),
      date:   platform::pure::metamodel::type::primitives::Date[1]        | $conv->pureDateLiteral($date->toString()),
      l: LambdaFunction<Any>[1] | $conv->translateLambdaValue($l),
      fn: platform::pure::metamodel::function::PackageableFunction<Any>[1] | $conv->translateFunctionReference($fn),
      // Class / Enumeration / Enum references captured as values
      // (e.g. `STR_Person->toString()`, `City.NY->toString()`) — constant-fold
      // to the element's short name, the same string Pure's `toString` would
      // produce. Deliberately NOT catching all PackageableElement: Function
      // refs also extend PE but need to flow through translateLambdaValue
      // (or be left for evalCoder's downstream cast) instead of degrading
      // to a String name.
      cls:  platform::pure::metamodel::type::Class<Any>[1]        | if ($conv.metadataElements, | $conv->metadataElement($cls), | j_string($cls.name->toOne())),
      en:   platform::pure::metamodel::type::Enumeration<Any>[1]  | if ($conv.metadataElements, | $conv->metadataElement($en), | j_string($en.name->toOne())),
      ev:   platform::pure::metamodel::type::Enum[1]              | $conv->enumConstantCode($ev),
      // {@code Pair<U,V>} runtime PDO — flows here when a captured
      // {@code pair(a, b)} is reached as a value (e.g. inside a multi-if's
      // pair-lambda, or zip's result list). Mirror the {@link pairCoder}
      // translation: emit {@code Map.entry(first, second)} so the runtime
      // shape matches the Pure Map-like layout.
      pr:   platform::pure::functions::collection::Pair<Any, Any>[1] |
         mapEntryCode($conv->translateScalarAtomicValue($pr.first->toOne()),
                      $conv->translateScalarAtomicValue($pr.second->toOne())),
      // {@code PrimitiveType} values (`String`, `Integer`, ...) come through
      // when a Pure expression captures the type itself, not an instance —
      // e.g. `String->toString()` or `someValue.genericType.type` reaching a
      // primitive. Same `name` extraction as classes/enums.
      pt:   platform::pure::metamodel::type::PrimitiveType[1]     | if ($conv.metadataElements, | $conv->metadataElement($pt), | j_string($pt.name->toOne())),
      // Multiplicity literals (`PureOne`, `ZeroOne`, ...) — captured when
      // Pure metamodel-walking code reads a `.multiplicity` slot. Emit a
      // {@code "<lower>..<upper>"} sentinel; PCT tests don't dispatch on
      // multiplicity values at the Java surface, just round-trip them.
      m:    platform::pure::metamodel::multiplicity::Multiplicity[1] | if ($conv.metadataElements && $m->instanceOf(platform::pure::metamodel::PackageableElement),
                                                                    | $conv->metadataElement($m->cast(@platform::pure::metamodel::PackageableElement)),
                                                                    | j_string(platform::pure::functions::printer::compiled::printMultiplicity($m))),
      // Any other element named in the source (a Profile, a Package, ...) is the
      // metamodel object the platform has.
      pe: platform::pure::metamodel::PackageableElement[1] | if ($conv.metadataElements,
                                     | $conv->metadataElement($pe),
                                     | fail('Unsupported atomic value type: ' + $pe->toString()); j_null();),
      // A captured user-class instance (`smith` in `[smith, doe]->find(...)`)
      // reached as a literal: rebuild it as the `new X()._p(v)...` chain
      // newCoder emits for `^X(...)`; collectNewClassRefs generates X.
      x: Any[1]                 | if ($x->isUserClassInstance(),
                                     | $conv->translateClassInstance($x),
                                     | fail('Unsupported atomic value type: ' + $x->toString()); j_null();
                                  )
   ]);
}

// Every lambda in a function's body, depth first, each before the lambdas
// inside it. The translator addresses a lambda by its index here, and the
// platform resolves that index through this same walk — so they agree.
function platform::extensions::language::java::translation::lambdasInFunction(functionPath: String[1]): LambdaFunction<platform::pure::metamodel::type::Any>[*]
{
   let fn = $functionPath->pathToElement()->cast(@platform::pure::metamodel::function::FunctionDefinition<platform::pure::metamodel::type::Any>);
   $fn.expressionSequence->map(e | $e->lambdasInValueSpecification());
}

function platform::extensions::language::java::translation::lambdasInValueSpecification(vs: ValueSpecification[1]): LambdaFunction<platform::pure::metamodel::type::Any>[*]
{
   $vs->match([
      fe:  FunctionExpression[1] | $fe.parametersValues->map(p | $p->lambdasInValueSpecification()),
      av:  AtomicValue[1]        | $av.value->filter(v | $v->instanceOf(LambdaFunction))
                                      ->cast(@LambdaFunction<platform::pure::metamodel::type::Any>)
                                      ->map(l | $l->concatenate($l.expressionSequence->map(e | $e->lambdasInValueSpecification()))),
      col: Collection[1]         | $col.values->map(v | $v->lambdasInValueSpecification()),
      other: ValueSpecification[1] | []->cast(@LambdaFunction<platform::pure::metamodel::type::Any>)
   ]);
}

// Two functions written at the same place in the same source.
function platform::extensions::language::java::translation::atSamePosition(a: platform::pure::metamodel::function::FunctionDefinition<platform::pure::metamodel::type::Any>[1], b: platform::pure::metamodel::function::FunctionDefinition<platform::pure::metamodel::type::Any>[1]): Boolean[1]
{
   let one = $a.sourceInformation;
   let two = $b.sourceInformation;
   $one->isNotEmpty()
      && $two->isNotEmpty()
      && $one.startLine == $two.startLine
      && $one.startColumn == $two.startColumn
      && $one.endLine == $two.endLine
      && $one.endColumn == $two.endColumn;
}

// The variable a `let` statement binds, or nothing for any other statement.
function <<access.private>> platform::extensions::language::java::translation::letBoundName(vs: ValueSpecification[1]): String[0..1]
{
   $vs->match([
      fe: FunctionExpression[1] | if ($fe.functionName == 'letFunction' && $fe.parametersValues->size() == 2,
                                      | $fe.parametersValues->at(0)->cast(@AtomicValue).value->cast(@String),
                                      | []->cast(@String)),
      other: ValueSpecification[1] | []->cast(@String)
   ]);
}

// `conv` with the variable a `let` statement binds added to the scope.
function <<access.private>> platform::extensions::language::java::translation::withBinding(conv: Conventions[1], vs: ValueSpecification[1]): Conventions[1]
{
   let name = $vs->platform::extensions::language::java::translation::letBoundName();
   if ($name->isEmpty(), | $conv, | ^$conv(scope = $conv.scope->concatenate($name)));
}

// `conv` with the Java local a `let` declares, recorded BEFORE its initializer is
// translated: a lambda in that initializer may not redeclare it (see
// translateLambdaValue), even though Pure does not consider it bound yet.
function <<access.private>> platform::extensions::language::java::translation::withJavaLocal(conv: Conventions[1], vs: ValueSpecification[1]): Conventions[1]
{
   let name = $vs->platform::extensions::language::java::translation::letBoundName();
   if ($name->isEmpty(), | $conv, | ^$conv(javaLocals = $conv.javaLocals->concatenate($name)));
}

// A Pure qualified property is a method on the platform type: a body over
// `$this` (`inParameters() { $this.scope == Scope.IN_PARAMETERS }`), declared on
// the interface and implemented on the implementation. A body that doesn't
// translate throws, like a function that doesn't (see udfFileOrStub).
function platform::extensions::language::java::translation::platformQualifiedPropertyMethods(
   conv: Conventions[1],
   cls: platform::pure::metamodel::type::Class<platform::pure::metamodel::type::Any>[1],
   javaRoot: String[1],
   withBody: Boolean[1]
): platform::extensions::language::java::metamodel::Method[*]
{
   $cls->platform::extensions::language::java::translation::platform::allPlatformQualifiedProperties()
      ->map(qp | $conv->platformQualifiedPropertyMethod($qp, $cls, $javaRoot, $withBody));
}

function <<access.private>> platform::extensions::language::java::translation::platformQualifiedPropertyMethod(
   conv: Conventions[1],
   qp: platform::pure::metamodel::function::property::QualifiedProperty<platform::pure::metamodel::type::Any>[1],
   cls: platform::pure::metamodel::type::Class<platform::pure::metamodel::type::Any>[1],
   javaRoot: String[1],
   withBody: Boolean[1]
): platform::extensions::language::java::metamodel::Method[1]
{
   let name       = $qp->platform::extensions::language::java::translation::platform::qualifiedPropertyName()->platform::extensions::language::java::translation::platform::getterName();
   let returnType = $qp.genericType->platform::extensions::language::java::translation::platform::platformValueType($qp.multiplicity, $javaRoot);
   // The first parameter is `$this`, the receiver.
   let params     = $qp.parameters->slice(1, $qp.parameters->size())
                       ->map(p | j_parameter($p.genericType->platform::extensions::language::java::translation::platform::platformValueType($p.multiplicity, $javaRoot), $p.name->safeJavaName()));
   let modifiers  = if ($withBody, | ['public'], | []->cast(@String));
   if (!$withBody,
      | javaMethod($modifiers, $returnType, $name, $params),
      | javaMethod($modifiers, $returnType, $name, $params, $conv->qualifiedPropertyBody($qp, $cls, $javaRoot, $returnType)));
}

function <<access.private>> platform::extensions::language::java::translation::qualifiedPropertyBody(
   conv: Conventions[1],
   qp: platform::pure::metamodel::function::property::QualifiedProperty<platform::pure::metamodel::type::Any>[1],
   cls: platform::pure::metamodel::type::Class<platform::pure::metamodel::type::Any>[1],
   javaRoot: String[1],
   returnType: platform::extensions::language::java::metamodel::Type[1]
): platform::extensions::language::java::metamodel::Code[*]
{
   // `$this` translates to the variable `this_` (`this` is a Java keyword), bound here.
   // Bodies are emitted on the implementation only, so `this` is the Impl, held as the class's interface.
   let selfType = javaClass($cls->platform::extensions::language::java::translation::platform::platformTypeName($javaRoot));
   let receiver = j_declare($selfType, 'this_', j_this(javaClass($cls->platform::extensions::language::java::translation::platform::platformTypeName($javaRoot) + 'Impl')));
   // `Class X(x:Integer[1])` — its qualified properties read `$x`, which the
   // instance carries on its classifier.
   let typeVars = $cls.typeVariables->map(v |
      j_declare($conv->pureTypeToJavaType($v.genericType, $v.multiplicity)->toBoxed(),
                $v.name->platform::extensions::language::java::translation::safeJavaName(),
                j_invoke(javaClass($conv->pdbClass('Metadata')), 'typeVariable',
                         [j_variable(javaObject(), 'this'), j_string($v.name->toOne())], javaObject())
                   ->j_castWithoutChecks($conv->pureTypeToJavaType($v.genericType, $v.multiplicity)->toBoxed())));
   let attempt  = tryEval(| let raw = $conv->buildJavaBodyReturning($qp.expressionSequence->toOneMany(), $qp.multiplicity->holdsManyValues());
                            if ($qp.multiplicity->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity),
                               | $raw->returningType($returnType, $conv),
                               | $raw->returningNormalized($conv)););
   if ($attempt.failure->isEmpty(),
      | $receiver->concatenate($typeVars)->concatenate($attempt.value->toOne()->cast(@platform::extensions::language::java::metamodel::Code)),
      | j_throw(j_new(javaClass('java.lang.UnsupportedOperationException'), [j_string('not translated: ' + $cls->elementToPath() + '.' + $qp->platform::extensions::language::java::translation::platform::qualifiedPropertyName() + ': ' + $attempt.failure->toOne().message->split('\n')->at(0))])));
}

// A packageable element as its metamodel object on the Java platform:
// `(Class) Metadata.element("platform::...::NativeFunction")`, typed as its classifier.
function <<access.private>> platform::extensions::language::java::translation::metadataElement(conv: Conventions[1], element: platform::pure::metamodel::PackageableElement[1]): Code[1]
{
   let classifier = $conv->pureTypeToJavaType($element->platform::pure::functions::meta::genericType(), PureOne)->toBoxed();
   j_invoke(javaClass($conv->pdbClass('Metadata')), 'element', [j_string($element->elementToPath())], javaObject())
      ->j_castWithoutChecks($classifier);
}

// The Java enum generated for a Pure Enumeration (see {@link enumHelperClass}).
function <<access.private>> platform::extensions::language::java::translation::javaEnumType(conv: Conventions[1], e: platform::pure::metamodel::type::Enumeration<Any>[1]): platform::extensions::language::java::metamodel::Type[1]
{
   javaClass($e->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot()));
}

// A Pure enum value as the constant of its generated Java enum.
function <<access.private>> platform::extensions::language::java::translation::enumConstantCode(conv: Conventions[1], ev: platform::pure::metamodel::type::Enum[1]): Code[1]
{
   let enumType = $conv->javaEnumType($ev->enumerationOf());
   j_field($enumType, $ev.name->toOne()->platform::extensions::language::java::translation::safeJavaName(), $enumType);
}

// The Enumeration a Pure enum value belongs to.
function <<access.private>> platform::extensions::language::java::translation::enumerationOf(ev: platform::pure::metamodel::type::Enum[1]): platform::pure::metamodel::type::Enumeration<Any>[1]
{
   $ev->platform::pure::functions::meta::genericType()->rawType()->toOne()->cast(@platform::pure::metamodel::type::Enumeration<Any>);
}

// `vs` when it is an Enumeration literal (the receiver of `Enumeration.VALUE`,
// or the argument of enumValues / instanceOf), otherwise empty.
function <<access.private>> platform::extensions::language::java::translation::enumerationLiteral(vs: ValueSpecification[1]): platform::pure::metamodel::type::Enumeration<Any>[0..1]
{
   let found = if ($vs->instanceOf(AtomicValue),
      | $vs->cast(@AtomicValue).value->filter(v | $v->instanceOf(platform::pure::metamodel::type::Enumeration))->cast(@platform::pure::metamodel::type::Enumeration<Any>),
      | []->cast(@platform::pure::metamodel::type::Enumeration<Any>)
   );
   if ($found->size() == 1, | $found->toOne(), | []->cast(@platform::pure::metamodel::type::Enumeration<Any>));
}

// True for an instance of a user-defined Pure class — not a metamodel element
// (those are PackageableElements), and not Pair / List / Map, which have their
// own translations. Test models live under platform::pure::functions::...::tests,
// so a blanket platform::pure:: exclusion would be wrong.
function <<access.private>> platform::extensions::language::java::translation::isUserClassInstance(v: Any[1]): Boolean[1]
{
   let raw  = $v->platform::pure::functions::meta::genericType()->rawType();
   let path = if ($raw->isEmpty(), | '', | $raw->toOne()->cast(@platform::pure::metamodel::PackageableElement)->elementToPath());
   !$v->instanceOf(platform::pure::metamodel::PackageableElement)
      && $raw->isNotEmpty()
      && $raw->toOne()->instanceOf(platform::pure::metamodel::type::Class)
      && !$path->startsWith('platform::pure::metamodel::')
      && !['platform::pure::functions::collection::Pair', 'platform::pure::functions::collection::List', 'platform::pure::functions::collection::Map']->contains($path);
}

// A user-class instance as `new X()._p1(v1)._p2(v2)...` over its non-empty
// properties, inherited ones included. Each setter is typed as X so the chain
// resolves (on Object the next `._p` wouldn't).
function <<access.private>> platform::extensions::language::java::translation::translateClassInstance(conv: Conventions[1], v: Any[1]): Code[1]
{
   let cls     = $v->platform::pure::functions::meta::genericType()->rawType()->toOne()->cast(@platform::pure::metamodel::type::Class<Any>);
   let clsType = javaClass($cls->platform::extensions::language::java::translation::platform::platformTypeName(platform::extensions::language::java::translation::platform::platformRoot()) + 'Impl');
   $cls->allUserProperties()->fold({p, acc |
      let values = $p->eval($v);
      if ($values->isEmpty(),
         | $acc,
         | $acc->j_invoke('_' + $p.name->toOne(), [$conv->translateAtomicValues($values)], $clsType));
   }, j_new($clsType, []));
}

// A property's values: one value as itself, several as a List.
function <<access.private>> platform::extensions::language::java::translation::translateAtomicValues(conv: Conventions[1], values: Any[*]): Code[1]
{
   if ($values->size() == 1,
      | $conv->translateScalarAtomicValue($values->toOne()),
      | j_invoke(javaArrays(), 'asList', $values->map(x | $conv->translateScalarAtomicValue($x)), javaList(javaObject())));
}

// `cls`'s properties including those inherited from user superclasses, stopping
// at metamodel ancestors. Same walk as the JS translator's allUserProperties.
function <<access.private>> platform::extensions::language::java::translation::allUserProperties(cls: platform::pure::metamodel::type::Class<Any>[1]): platform::pure::metamodel::function::property::Property<Any, Any>[*]
{
   let supers = $cls.generalizations
                    ->map(g | $g.general->rawType())
                    ->filter(t | $t->isNotEmpty()
                                 && $t->toOne()->instanceOf(platform::pure::metamodel::type::Class)
                                 && !$t->toOne()->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()->startsWith('platform::pure::metamodel::'))
                    ->cast(@platform::pure::metamodel::type::Class<Any>);
   let inherited = $supers->map(s | $s->allUserProperties());
   $cls.properties->concatenate($inherited)->removeDuplicatesBy(p | $p.name->toOne());
}

// Helper classes needed to rebuild a user-class instance literal (see
// {@link translateClassInstance}) — its own class with the properties it sets,
// plus those of any instance nested in its property values.
function <<access.private>> platform::extensions::language::java::translation::classRefsFromValue(v: Any[1]): platform::extensions::language::java::translation::ClassRef[*]
{
   if (!$v->isUserClassInstance(),
      | []->cast(@platform::extensions::language::java::translation::ClassRef),
      | let cls    = $v->platform::pure::functions::meta::genericType()->rawType()->toOne()->cast(@platform::pure::metamodel::type::Class<Any>);
        let props  = $cls->allUserProperties()->filter(p | $p->eval($v)->isNotEmpty());
        let self   = ^platform::extensions::language::java::translation::ClassRef(className = $cls.name->toOne(), propertyNames = $props->map(p | $p.name->toOne()), purePath = $cls->elementToPath());
        let nested = $props->map(p | $p->eval($v))->map(pv | $pv->classRefsFromValue());
        $self->concatenate($nested);
   );
}

// Emit {@code <Class>.parse("<stringForm>")}. Pure normalises date literals
// to a zone-less ISO form (see {@code normalizePureDate} on the runtime
// side), so {@code toString} on a Pure Date yields a string accepted by
// the corresponding {@code java.time} parser. The leading `%` from Pure's
// grammar is dropped via substring(1) when present.
// A Pure date literal as `PureDate.of("...")`, without Pure's leading `%`.
function <<access.private>> platform::extensions::language::java::translation::pureDateLiteral(conv: Conventions[1], s: String[1]): Code[1]
{
   let stripped = if ($s->startsWith('%'), | $s->substring(1, $s->length()), | $s);
   j_invoke($conv->javaPureDateType(), 'of', [j_string($stripped)], $conv->javaPureDateType());
}

// The platform's PureDate class (runtime library) as a Java type.
function <<access.private>> platform::extensions::language::java::translation::javaPureDateType(conv: Conventions[1]): platform::extensions::language::java::metamodel::Class[1]
{
   javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureDate'));
}

function <<access.private>> platform::extensions::language::java::translation::dateLiteralCode(s: String[1], javaClassName: String[1]): Code[1]
{
   let stripped = if ($s->startsWith('%'), | $s->substring(1, $s->length()), | $s);
   j_invoke(javaClass($javaClassName), 'parse', [j_string($stripped)], javaClass($javaClassName));
}

// Translate a Pure LambdaFunction value (as it appears when used as an
// argument to higher-order natives) into a Java lambda expression. Single-
// expression bodies emit the expression-bodied form `(a) -> expr`; multi-
// expression bodies fall back to a Java block lambda `(a) -> { ...; return
// last; }` via buildJavaBody so let-bindings and intermediate statements
// translate cleanly (otherwise tests like `|let a = 5; $a + 1` bail out
// during translation).
function <<access.private>> platform::extensions::language::java::translation::translateLambdaValue(conv: Conventions[1], lambda: LambdaFunction<Any>[1]): Code[1]
{
   // Parameters are declared `var` (implicitly typed) and re-bound to a typed
   // local at the top of the body. The lambda is either cast to a raw
   // functional interface — `(Predicate) lambda`, whose parameter is Object —
   // or passed to a typed stream, `Stream<Long>.map(lambda)`. An explicit
   // parameter type has to match the target exactly, so it can only ever suit
   // one of the two; `var` adapts to both, and the cast to the boxed Pure type
   // is valid either way. (Boxed: a functional interface can't take a
   // primitive, and arithmetic in the body still auto-unboxes.)
   let params  = $lambda.parameters;
   // The Java locals the enclosing method already binds. A parameter whose name
   // collides is renamed: Java rejects a lambda body that redeclares one.
   // Innermost renames come first so `javaNameFor` picks them over outer ones.
   let taken   = $conv.scope->concatenate($conv.javaLocals)->map(n | $conv->platform::extensions::language::java::translation::javaNameFor($n));
   let inner   = ^$conv(scope   = $conv.scope->concatenate($params->map(p | $p.name)),
                        renames = $params->map(p | $p->platform::extensions::language::java::translation::renameIfShadowing($taken))
                                          ->concatenate($conv.renames));
   let jParams = $params->map(p | j_parameter(javaTypeVar('var'), $inner->platform::extensions::language::java::translation::javaNameFor($p.name) + '_pureArg'));
   let rebinds = $params->map(p | $inner->rebindLambdaParameter($p));
   let exprs   = $lambda.expressionSequence;
   let stmts   = if ($exprs->size() == 1,
      | [j_return($inner->translateExpression($exprs->toOne()))],
      | $inner->buildJavaBody($exprs->toOneMany())
   );
   let code    = j_lambda($jParams, j_block($rebinds->concatenate($stmts)));
   $conv->withLambdaMetadata($code, $lambda);
}

// A lambda value on the Java platform is callable AND its own metadata: the
// adapter that translates it (and every reflective read of its parameters or
// body) needs the AST, which a bare Java lambda has none of. It is addressed by
// the function being translated and its index in {@link lambdasInFunction}.
function <<access.private>> platform::extensions::language::java::translation::withLambdaMetadata(conv: Conventions[1], code: Code[1], lambda: LambdaFunction<platform::pure::metamodel::type::Any>[1]): Code[1]
{
   let all   = $conv.owner->map(o | platform::extensions::language::java::translation::lambdasInFunction($o));
   // Addressed by where it is written: both sides compare the same numbers,
   // and a lambda without a source position is left unwrapped.
   let index = range($all->size())->filter(i | $all->at($i)->atSamePosition($lambda));
   // The wrapper keeps the lambda's Java type, so it still fits where a
   // functional interface is expected (`.map(f)`); arities the platform cannot
   // call (four parameters and more) are left as plain lambdas.
   let arity = $lambda.parameters->size();
   // Raw interfaces: a cast between two parameterizations of Function is illegal,
   // and the call site casts the value to the shape it expects. Three parameters
   // is the platform's PureFunction3 (an island handler's compile), which
   // PureLambda proxies like the JDK's two.
   let type  = if ($arity == 0, | [javaClass('java.util.function.Supplier')],
               |if ($arity == 1, | [javaClass('java.util.function.Function')],
               |if ($arity == 2, | [javaClass('java.util.function.BiFunction')],
               |if ($arity == 3, | [javaClass(platform::extensions::language::java::translation::pureFunction3Class())],
                                 | []->cast(@platform::extensions::language::java::metamodel::Type)))));
   if ($index->isEmpty() || $type->isEmpty(),
      | $code,
      | j_invoke(javaClass($conv->pdbClass('PureLambda')), 'of',
                 [$code->j_castWithoutChecks($type->toOne()), j_string($conv.owner->toOne()), j_long($index->at(0)), $lambda->capturesCode($conv.scope, $conv)], javaObject())
           ->j_castWithoutChecks($type->toOne()));
}

// The values a lambda captures, by name: a Java closure cannot be asked what it
// captured, so the names the metadata lists are read here, where they are in
// scope, and travel with the value (`openVariableValues`).
function <<access.private>> platform::extensions::language::java::translation::capturesCode(lambda: LambdaFunction<platform::pure::metamodel::type::Any>[1], scope: String[*], conv: Conventions[1]): Code[1]
{
   let names = $lambda.openVariables->map(v | $v.name)->removeDuplicates()
                  ->filter(n | !$n->startsWith('~') && $scope->contains($n));
   let pairs = $names->map(n | [j_string($n), j_variable(javaObject(), $n->platform::extensions::language::java::translation::safeJavaName())]);
   j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureValues')), 'captures',
            [j_invoke(javaArrays(), 'asList', $pairs, javaList())], javaClass('java.util.Map'));
}

// A Java name not already bound in `taken`, reached by appending `_` until free.
function <<access.private>> platform::extensions::language::java::translation::freshJavaName(base: String[1], taken: String[*]): String[1]
{
   if (!$taken->contains($base),
      | $base,
      | platform::extensions::language::java::translation::freshJavaName($base + '_', $taken));
}

// The rename a lambda parameter needs when its Java name is already bound by the
// enclosing method, or nothing when it is free.
function <<access.private>> platform::extensions::language::java::translation::renameIfShadowing(p: VariableExpression[1], taken: String[*]): Pair<String, String>[0..1]
{
   let base = $p.name->platform::extensions::language::java::translation::safeJavaName();
   let jn   = platform::extensions::language::java::translation::freshJavaName($base, $taken);
   if ($jn == $base, | [], | pair($p.name, $jn));
}

// The Java local name for a Pure variable: its safe name unless it was renamed.
function <<access.private>> platform::extensions::language::java::translation::javaNameFor(conv: Conventions[1], pureName: String[1]): String[1]
{
   let hit = $conv.renames->filter(r | $r.first == $pureName);
   if ($hit->isEmpty(),
      | $pureName->platform::extensions::language::java::translation::safeJavaName(),
      | $hit->at(0).second);
}

// `<BoxedType> name = (<BoxedType>) name_pureArg;` for one lambda parameter —
// see {@link translateLambdaValue}.
function <<access.private>> platform::extensions::language::java::translation::rebindLambdaParameter(conv: Conventions[1], p: VariableExpression[1]): Code[1]
{
   // A single-valued primitive is declared primitive (`long x = (Long) x_pureArg`),
   // as the translator types `$x`: declared boxed, `$x == $y` would become a
   // reference comparison of two Longs.
   let declared = $conv->pureTypeToJavaType($p.genericType, $p.multiplicity);
   let type = $declared->toBoxed();
   let name = $conv->platform::extensions::language::java::translation::javaNameFor($p.name);
   let arg  = j_variable(javaObject(), $name + '_pureArg');
   // A many-valued parameter may be handed a single value or null (a function
   // reference such as equal_Any_MANY__Any_MANY_ called with two elements).
   let value = if ($p.multiplicity->holdsManyValues(),
      | j_conditional(j_instanceof($arg, javaList()), $arg,
           j_conditional(j_eq($arg, j_null()), j_invoke(javaCollections(), 'emptyList', [], javaList()),
              j_invoke(javaCollections(), 'singletonList', [$arg], javaList()), javaObject()), javaObject()),
      | $arg);
   j_declare(if ($declared->platform::extensions::language::java::metamodel::isJavaPrimitive(), | $declared, | $type), $name, $value->j_castWithoutChecks($type));
}

// ----------------------------------------------------------------------------
// Top-level entry point: translate a Pure function definition into a Java class
// holding a single static method that mirrors the function body.
// ----------------------------------------------------------------------------

function platform::extensions::language::java::translation::translateFunction(conv: Conventions[1], f: platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[1]): FunctionSignature[1]
{
   let funcName = $f.functionName->toOne('translateFunction: function is missing a name');
   let className = $funcName->substring(0, 1)->toUpper() + $funcName->substring(1);
   let returnType = $conv->pureTypeToJavaType($f.returnGenericType, $f.returnMultiplicity);
   $conv->buildSignature($f, $className, $returnType);
}

// Translate an anonymous lambda. The lambda's `parameters` and
// `expressionSequence` come straight from FunctionDefinition; the return
// type lives on the lambda's classifier (LambdaFunction<{params -> ret}>)
// rather than on dedicated slots (lambdas aren't PackageableFunctions).
function platform::extensions::language::java::translation::translateLambda(conv: Conventions[1], f: platform::pure::metamodel::function::LambdaFunction<platform::pure::metamodel::type::Any>[1], className: String[1]): FunctionSignature[1]
{
   let funcType   = $f.classifierGenericType.typeArguments->at(0)->rawType()->toOne('translateLambda: lambda missing classifier function type')->cast(@platform::pure::metamodel::type::FunctionType);
   let returnType = $conv->pureTypeToJavaType($funcType.returnType, $funcType.returnMultiplicity);
   $conv->buildSignature($f, $className, $returnType);
}

// Unified entry — dispatches on the runtime kind of the FunctionDefinition so
// the adapter can hand off whatever shape `makeCanonical` produced (a
// UserDefinedFunction for capturing-lambda inputs, passthrough LambdaFunction
// for non-capturing inputs). The caller picks the Java className; the function
// name on the emitted method is always `execute` (see buildSignature).
// A lambda's Java return type. Normally its declared function type, carried as
// the type argument of its classifier (`{->String[0..1]}`).
//
// A lambda assembled at RUN TIME has none: `^LambdaFunction<{->String[0..1]}>(...)`
// loses the argument, because a structural FunctionType has no element path and
// `withClassifier` can only pass named types to `Metadata.classifier` (which
// resolves each one with `installed.element((String) typeArgument)`). Fall back
// to the type of the body's last expression, which is what the lambda returns.
function <<access.private>> platform::extensions::language::java::translation::lambdaReturnType(conv: Conventions[1], lf: LambdaFunction<platform::pure::metamodel::type::Any>[1]): platform::extensions::language::java::metamodel::Type[1]
{
   let declared = $lf.classifierGenericType.typeArguments
                     ->map(ta | $ta->rawType())
                     ->filter(t | $t->instanceOf(platform::pure::metamodel::type::FunctionType))
                     ->cast(@platform::pure::metamodel::type::FunctionType);
   if ($declared->isNotEmpty(),
      | $conv->pureTypeToJavaType($declared->at(0).returnType, $declared->at(0).returnMultiplicity),
      | let exprs = $lf.expressionSequence;
        assert($exprs->size() > 0, | 'lambdaReturnType: lambda has no expressionSequence and no declared function type');
        let last = $exprs->at($exprs->size() - 1);
        $conv->pureTypeToJavaType($last.genericType, $last.multiplicity););
}

function platform::extensions::language::java::translation::translateFunctionDef(
   conv: Conventions[1],
   f: platform::pure::metamodel::function::FunctionDefinition<platform::pure::metamodel::type::Any>[1],
   className: String[1]
): FunctionSignature[1]
{
   let returnType = $f->match([
      lf: LambdaFunction<Any>[1]       | $conv->platform::extensions::language::java::translation::lambdaReturnType($lf),
      udf: UserDefinedFunction<Any>[1] | $conv->pureTypeToJavaType($udf.returnGenericType, $udf.returnMultiplicity)
   ]);
   $conv->buildSignature($f, $className, $returnType);
}

// Shared back-end for both translateFunction and translateLambda: turn a
// FunctionDefinition + a Java return type into a Java class wrapping the
// translated body as a single `public static execute(...)` method.
function <<access.private>> platform::extensions::language::java::translation::buildSignature(conv: Conventions[1], f: platform::pure::metamodel::function::FunctionDefinition<platform::pure::metamodel::type::Any>[1], className: String[1], returnType: platform::extensions::language::java::metamodel::Type[1]): FunctionSignature[1]
{
   let jParams = $f.parameters->map(p |
      j_parameter($conv->pureTypeToJavaType($p.genericType, $p.multiplicity), $p.name->platform::extensions::language::java::translation::safeJavaName())
   );

   assert($f.expressionSequence->size() >= 1, | 'buildSignature: empty expressionSequence');
   let bodyStatements = $conv->buildJavaBody($f.expressionSequence->toOneMany());

   let javaCls = javaClass(['public'], $conv.basePackageName + '.' + $className);
   let javaMtd = javaMethod(['public', 'static'], $returnType, 'execute', $jParams, $bodyStatements);

   // Walk the body collecting every UserDefinedFunction transitively
   // referenced via `fe.func`. Each becomes a top-level Java helper class
   // with one `public static execute(...)` method, so call sites translated
   // via {@link translateUdfCall} can invoke `HelperClass.execute(args)`.
   // Mirrors the JavaScript translator's collectReferencedUdfs/translateUdf
   // pattern; tests like {@code testLetAsLastStatement} that delegate to a
   // sibling UDF would otherwise fail with "No coder for Pure function".
   let udfs = $conv->collectReferencedUdfs(
      $f.expressionSequence,
      []->cast(@platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>));

   let support = $conv->supportClasses($f.expressionSequence, $f.parameters->map(p | $p.genericType), $udfs, []);
   ^FunctionSignature(
      class = $javaCls->addMethod($javaMtd),
      method = $javaMtd,
      extraClasses = $support.classes,
      files = $support.files
   );
}

// The classes a translated program needs besides its own: one per referenced
// UDF (its `execute`) and one per user class and enumeration the Java can
// name. The runtime classes the code calls (PureMap, PureMatch, Variant,
// PureDate, PureFormat, PureBytes) are the platform's, see
// the runtime library in the platform's sources. `bodies` and `signatureTypes`
// are the program's own; `udfs` are translated and scanned too; `extraTypes`
// are classes/enumerations to generate even when nothing references them.
function <<access.private>> platform::extensions::language::java::translation::supportClasses(
   conv: Conventions[1],
   ownBodies: ValueSpecification[*],
   signatureTypes: platform::pure::metamodel::type::generics::GenericType[*],
   udfs: platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[*],
   extraTypes: platform::pure::metamodel::type::Type[*]
): platform::extensions::language::java::translation::SupportCode[1]
{
   // Every user class and enumeration the Java can name — through a type in a
   // signature, a value specification's type, a type literal or a captured
   // value — gets a generated Java type in the same compilation unit: a class
   // per Pure class (superclasses included, see {@link withSuperclasses}), whose
   // fluent setters `new X()._k(v)` typecheck, and an enum per enumeration.
   let bodies      = $ownBodies->concatenate($udfs->map(u | $u.expressionSequence));
   let signatures  = $signatureTypes
                        ->concatenate($udfs->map(u | $u.parameters->map(p | $p.genericType)))
                        ->concatenate($udfs->map(u | $u.returnGenericType));
   let referenced  = $bodies->map(e | $e->typesInValueSpecification())
                        ->concatenate($signatures->map(g | $g->typesInGenericType()))
                        ->concatenate($extraTypes);
   let usesVariant = $referenced->exists(t | $t->instanceOf(platform::pure::metamodel::PackageableElement) && $t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath() == variantTypePath());
   // The Variant class builds and reads Pure Lists, so the List class comes with it.
   let usesList    = $referenced->exists(t | $t == platform::pure::functions::collection::List) || $bodies->callsFunctionNamed('groupBy');
   let variantRefs = if ($usesVariant || $usesList,
      | [^platform::extensions::language::java::translation::ClassRef(className = 'List', propertyNames = ['values'], purePath = 'platform::pure::functions::collection::List')],
      | []->cast(@platform::extensions::language::java::translation::ClassRef));
   let classRefs   = $conv->collectNewClassRefs($bodies)
                        ->concatenate($variantRefs)
                        ->concatenate($referenced->filter(t | $t->isUserClassType())->map(t | $t->cast(@platform::pure::metamodel::type::Class<Any>)->classRefFor()))
                        ->mergeClassRefs()
                        ->withSuperclasses();
   // Platform types for every Pure class the program uses (with its
   // generalizations) and every enumeration, except those the platform prebuilds.
   let pureClasses = $classRefs->map(cr | $cr.purePath->map(p | $p->lenientPathToElement()))
                        ->filter(e | $e->instanceOf(platform::pure::metamodel::type::Class))
                        ->cast(@platform::pure::metamodel::type::Type)
                        ->concatenate($referenced->filter(t | $t->instanceOf(platform::pure::metamodel::type::Enumeration)))
                        ->platform::extensions::language::java::translation::platform::withReferencedTypes(true)
                        ->filter(t | !$t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()->platform::extensions::language::java::translation::platform::isPrebuiltType());
   let enumerations = $pureClasses->filter(t | $t->instanceOf(platform::pure::metamodel::type::Enumeration))->cast(@platform::pure::metamodel::type::Enumeration<Any>);
   let classes      = $pureClasses->filter(t | !$t->instanceOf(platform::pure::metamodel::type::Enumeration))->cast(@platform::pure::metamodel::type::Class<Any>);
   let root  = platform::extensions::language::java::translation::platform::platformRoot();
   let files = $classes->map(c | [
                  $c->platform::extensions::language::java::translation::platform::platformFile($root, $conv->platform::extensions::language::java::translation::platform::platformInterface($c, $root)),
                  '//// FILE ' + ($c->platform::extensions::language::java::translation::platform::platformTypeName($root) + 'Impl')->replace('.', '/') + '.java\n' + $conv->platform::extensions::language::java::translation::platform::platformImplementation($c, $root)->platform::extensions::language::java::serialization::classToStringWithPositions()])
               ->concatenate($enumerations->map(e | $e->platform::extensions::language::java::translation::platform::platformFile($root, $e->platform::extensions::language::java::translation::platform::platformEnum($root, $conv))));
   let udfFiles = $udfs->map(u | '//// FILE ' + $conv->udfClassName($u)->replace('.', '/') + '.java\n' + $conv->translateUdf($u)->platform::extensions::language::java::serialization::classToString());
   ^platform::extensions::language::java::translation::SupportCode(classes = [], files = $udfFiles->concatenate($files));
}

// Walk a value-spec tree collecting every UserDefinedFunction reached via
// {@link FunctionExpression.func} for which there is NO registered coder.
// Coder-backed UDFs (e.g. assertEquals, contains, range) are handled by
// {@link translateFunctionExpression} dispatching to the coder — emitting
// their bodies as helper classes would needlessly drag in the entire core
// runtime and break tests on the first non-translatable construct deep in
// the call graph. Recurses into each collected UDF's body so callees-of-
// callees show up too. `seen` carries the transitive closure to break
// cycles (recursive UDF would otherwise loop).
function <<access.private>> platform::extensions::language::java::translation::collectReferencedUdfs(
   conv: Conventions[1],
   exprs: ValueSpecification[*],
   seen: platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[*]
): platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[*]
{
   $exprs->fold({e, acc | $conv->collectReferencedUdfsOne($e, $acc)}, $seen);
}

function <<access.private>> platform::extensions::language::java::translation::collectReferencedUdfsOne(
   conv: Conventions[1],
   vs: ValueSpecification[1],
   seen: platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[*]
): platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[*]
{
   $vs->match([
      {fe: FunctionExpression[1] |
         let acc1 = $conv->collectReferencedUdfs($fe.parametersValues, $seen);
         if ($fe.func->isNotEmpty()
              && $fe.func->toOne()->instanceOf(platform::pure::metamodel::function::UserDefinedFunction)
              && $conv->coderFor($fe.func, $fe->coderName())->isEmpty(),
             | let udf = $fe.func->toOne()->cast(@platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>);
               if ($acc1->contains($udf),
                   | $acc1,
                   | $conv->collectReferencedUdfs($udf.expressionSequence, $acc1->concatenate($udf)));,
             | $acc1
         );
      },
      {av: AtomicValue[1] |
         // AtomicValue may wrap a LambdaFunction (multi-if conds, match arms,
         // pair branches) whose body holds further FEs to walk, or a UDF
         // passed by name, which needs its helper class like a call does.
         if ($av.value->size() == 1
             && $av.value->toOne()->instanceOf(platform::pure::metamodel::function::UserDefinedFunction)
             && $conv->coderFor($av.value, $av.value->toOne()->cast(@platform::pure::metamodel::function::UserDefinedFunction<Any>).functionName->toOne())->isEmpty(),
             | let udf = $av.value->toOne()->cast(@platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>);
               if ($seen->contains($udf), | $seen, | $conv->collectReferencedUdfs($udf.expressionSequence, $seen->concatenate($udf)));,
         |if ($av.value->isNotEmpty()
             && $av.value->toOne()->instanceOf(platform::pure::metamodel::function::LambdaFunction),
             | $conv->collectReferencedUdfs(
                 $av.value->toOne()
                    ->cast(@platform::pure::metamodel::function::LambdaFunction<platform::pure::metamodel::type::Any>)
                    .expressionSequence,
                 $seen),
             | $seen
         ));
      },
      {col: Collection[1] | $conv->collectReferencedUdfs($col.values, $seen)},
      other: ValueSpecification[1] | $seen
   ]);
}

// Translate one UDF to a Java class holding a single `public static
// execute(...)` method that mirrors the UDF body. Class name comes from
// {@link udfClassName} so call sites translated via {@link translateUdfCall}
// resolve to the same symbol.
function <<access.private>> platform::extensions::language::java::translation::translateUdf(
   convIn: Conventions[1],
   udf: platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[1]
): platform::extensions::language::java::metamodel::Class[1]
{
   let conv        = ^$convIn(owner = if ($convIn.metadataElements, | $udf->elementToPath(), | []),
                              scope = $udf.parameters->map(p | $p.name),
                              typeVarWitness = $udf.parameters->witnessesOfTypeParameters());
   let className   = $conv->udfClassName($udf);
   let returnType  = $conv->pureTypeToJavaType($udf.returnGenericType, $udf.returnMultiplicity);
   let jParams     = $udf.parameters->map(p |
      j_parameter($conv->pureTypeToJavaType($p.genericType, $p.multiplicity), $p.name->platform::extensions::language::java::translation::safeJavaName())
   );
   assert($udf.expressionSequence->size() >= 1, | 'translateUdf: empty expressionSequence for ' + $udf.functionName->toOne());
   // A return multiplicity that is a PARAMETER (`T[m]`) is neither one value nor
   // many until the call site says so: what the body produced passes through,
   // where fitting it would take the first value of a list.
   let raw         = $conv->buildJavaBodyReturning($udf.expressionSequence->toOneMany(), $udf.returnMultiplicity->holdsManyValues());
   let body        = if ($udf.returnMultiplicity->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity),
                        | $raw->returningType($returnType, $conv),
                        | $raw->returningNormalized($conv));
   let javaCls     = javaClass(['public'], $className);
   let javaMtd     = javaMethod(['public', 'static'], $returnType, 'execute', $jParams, $body);
   $javaCls->addMethod($javaMtd);
}

// Holds the Pure-Class identity + the property names seen during AST walk.
// Properties are inferred from the actual `^X(prop1=v, prop2=v)` shapes,
// not from the class's declared metamodel, since we only emit setters for
// what the translated body actually needs.
Class platform::extensions::language::java::translation::ClassRef
{
   className   : String[1];
   propertyNames : String[*];
   // Full Pure class path, when known — emitted as the helper's _purePath() so
   // a returned instance can be turned back into a Pure object.
   purePath    : String[0..1];
}

// Walk the body collecting Pure Class references in `^X(...)` form. Each
// emerges as a FunctionExpression named `new` whose first arg's AtomicValue
// holds the target Class. Recurses through every FE so nested `^Inner(...)`
// inside a `^Outer(...)` is collected too. Deduplicates by class name,
// merging property lists.
function <<access.private>> platform::extensions::language::java::translation::collectNewClassRefs(conv: Conventions[1], exprs: ValueSpecification[*]): platform::extensions::language::java::translation::ClassRef[*]
{
   $exprs->map(e | $conv->collectNewClassRefsOne($e))->mergeClassRefs();
}

// Dedupe by className, merging property lists across each occurrence.
function <<access.private>> platform::extensions::language::java::translation::mergeClassRefs(refs: platform::extensions::language::java::translation::ClassRef[*]): platform::extensions::language::java::translation::ClassRef[*]
{
   // By Pure path: simple names collide (platform::extensions::language::java::metamodel::Class).
   let byKey = $refs->groupBy(cr | if ($cr.purePath->isEmpty(), | $cr.className, | $cr.purePath->toOne()));
   $byKey->keys()->map(k |
      let group = $byKey->get($k)->toOne().values;
      let allProps = $group->map(cr | $cr.propertyNames)->removeDuplicates();
      let paths = $group->map(cr | $cr.purePath);
      ^platform::extensions::language::java::translation::ClassRef(className = $group->at(0).className, propertyNames = $allProps, purePath = if ($paths->isEmpty(), | []->cast(@String), | $paths->at(0)));
   );
}

// A ClassRef for a Pure class known only as a type: its properties come from
// the metadata in {@link generateHelperClass}.
function <<access.private>> platform::extensions::language::java::translation::classRefFor(cls: platform::pure::metamodel::type::Class<Any>[1]): platform::extensions::language::java::translation::ClassRef[1]
{
   ^platform::extensions::language::java::translation::ClassRef(className = $cls.name->toOne(), propertyNames = [], purePath = $cls->elementToPath());
}

// `refs` plus a ClassRef for every user superclass of theirs, so a generated
// class's `extends` names a class that exists.
function <<access.private>> platform::extensions::language::java::translation::withSuperclasses(refs: platform::extensions::language::java::translation::ClassRef[*]): platform::extensions::language::java::translation::ClassRef[*]
{
   let ancestors = $refs->map(cr | $cr->pureClassOf())->map(c | $c->userAncestors())->map(a | $a->classRefFor());
   $refs->concatenate($ancestors)->mergeClassRefs();
}

// The Pure class a ClassRef stands for, when its path resolves to one.
function <<access.private>> platform::extensions::language::java::translation::pureClassOf(cr: platform::extensions::language::java::translation::ClassRef[1]): platform::pure::metamodel::type::Class<Any>[0..1]
{
   let found = $cr.purePath->map(p | $p->lenientPathToElement())->filter(e | $e->isUserClassType())->cast(@platform::pure::metamodel::type::Class<Any>);
   if ($found->isEmpty(), | []->cast(@platform::pure::metamodel::type::Class<Any>), | $found->at(0));
}

// The direct user superclasses of `cls`, in declaration order.
function <<access.private>> platform::extensions::language::java::translation::userSuperclasses(cls: platform::pure::metamodel::type::Class<Any>[1]): platform::pure::metamodel::type::Class<Any>[*]
{
   $cls.generalizations->map(g | $g.general->rawType())->filter(t | $t->isUserClassType())->cast(@platform::pure::metamodel::type::Class<Any>);
}

function <<access.private>> platform::extensions::language::java::translation::userAncestors(cls: platform::pure::metamodel::type::Class<Any>[1]): platform::pure::metamodel::type::Class<Any>[*]
{
   $cls->userSuperclasses()->map(s | $s->concatenate($s->userAncestors()));
}

// True for a user-defined Pure class — one that gets a generated Java class.
// Metamodel classes, enumerations and the classes with a translation of their
// own (Pair, List, Map) don't. Same exclusions as {@link isUserClassInstance}.
function <<access.private>> platform::extensions::language::java::translation::isUserClassType(t: Any[1]): Boolean[1]
{
   let path = if ($t->instanceOf(platform::pure::metamodel::PackageableElement), | $t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath(), | '');
   $t->instanceOf(platform::pure::metamodel::type::Class)
      && !$t->instanceOf(platform::pure::metamodel::type::Enumeration)
      && !$path->startsWith('platform::pure::metamodel::')
      && !['platform::pure::functions::collection::Pair', 'platform::pure::functions::collection::List', 'platform::pure::functions::collection::Map']->contains($path);
}

// Every type a translated body can name in Java: the raw types (and type
// arguments) of each value specification's type, and the types reached
// through literal values — type literals, enum values, lambda parameters and
// bodies, captured class instances.
function <<access.private>> platform::extensions::language::java::translation::typesInValueSpecification(vs: ValueSpecification[1]): platform::pure::metamodel::type::Type[*]
{
   let nested = $vs->match([
      fe: FunctionExpression[1]    | $fe.parametersValues->map(p | $p->typesInValueSpecification()),
      c: Collection[1]             | $c.values->map(v | $v->typesInValueSpecification()),
      a: AtomicValue[1]            | $a.value->map(v | $v->typesInValue()),
      // A language extension's value: the types its slots hold, as for a value an AtomicValue holds.
      other: ValueSpecification[1] | if ($other->isUserClassInstance(), | $other->typesInValue(), | []->cast(@platform::pure::metamodel::type::Type))
   ]);
   $vs.genericType->map(g | $g->typesInGenericType())->concatenate($nested);
}

function <<access.private>> platform::extensions::language::java::translation::typesInGenericType(g: platform::pure::metamodel::type::generics::GenericType[1]): platform::pure::metamodel::type::Type[*]
{
   let arguments = if ($g->instanceOf(platform::pure::metamodel::type::generics::UserDefinedGenericType),
      | $g->cast(@platform::pure::metamodel::type::generics::UserDefinedGenericType).typeArguments,
      | []->cast(@platform::pure::metamodel::type::generics::GenericType)
   );
   $g->rawType()->concatenate($arguments->map(a | $a->typesInGenericType()));
}

function <<access.private>> platform::extensions::language::java::translation::typesInValue(v: Any[1]): platform::pure::metamodel::type::Type[*]
{
   $v->match([
      l: LambdaFunction<Any>[1]                   | $l.parameters->map(p | $p.genericType->typesInGenericType())
                                                       ->concatenate($l.expressionSequence->map(e | $e->typesInValueSpecification())),
      t: platform::pure::metamodel::type::Type[1]     | $t,
      ev: platform::pure::metamodel::type::Enum[1]    | $ev->enumerationOf(),
      d: Date[1]                                  | platform::pure::metamodel::type::primitives::Date,
      x: Any[1]                                   | if ($x->isUserClassInstance(), | $x->typesInInstance(), | []->cast(@platform::pure::metamodel::type::Type))
   ]);
}

function <<access.private>> platform::extensions::language::java::translation::typesInInstance(x: Any[1]): platform::pure::metamodel::type::Type[*]
{
   let cls = $x->platform::pure::functions::meta::genericType()->rawType()->toOne()->cast(@platform::pure::metamodel::type::Class<Any>);
   $cls->concatenate($cls->allUserProperties()->map(p | $p->eval($x))->map(pv | $pv->typesInValue()));
}

function <<access.private>> platform::extensions::language::java::translation::collectNewClassRefsOne(conv: Conventions[1], vs: ValueSpecification[1]): platform::extensions::language::java::translation::ClassRef[*]
{
   $vs->match([
      fe: FunctionExpression[1] |
         let self = if ($fe.functionName == 'new' && $fe.parametersValues->size() >= 1,  | $conv->extractClassRefFromNew($fe),
                    |if ($fe.functionName == 'copy' && $fe.parametersValues->size() >= 1, | $conv->extractClassRefFromCopy($fe),
                    |if ($fe.functionName == 'tryEval',                                   | tryEvalClassRefs(),
                                                                                          | []->cast(@platform::extensions::language::java::translation::ClassRef))));
         let recursed = $fe.parametersValues->map(p | $conv->collectNewClassRefsOne($p));
         concatenate($self, $recursed);,
      c: Collection[1] | $c.values->map(v | $conv->collectNewClassRefsOne($v)),
      a: AtomicValue[1] | $a.value->map(v | if ($v->instanceOf(LambdaFunction),
                                               | $conv->collectNewClassRefs($v->cast(@LambdaFunction<Any>).expressionSequence),
                                               | $v->classRefsFromValue())),
      // A language extension's value is a class instance emitted as a constant (translateExtensionValue).
      other: ValueSpecification[1] | if ($other->isUserClassInstance(), | $other->classRefsFromValue(), | []->cast(@platform::extensions::language::java::translation::ClassRef))
   ]);
}

// `copy(object, keyExpressions)` — the source's class comes from the source
// expression's genericType; the property set comes from the keyExpressions.
// {@link collectNewClassRefs} dedup-merges with any {@code ^X(...)}
// occurrences of the same class so generateHelperClass emits one Java
// class holding all observed properties.
function <<access.private>> platform::extensions::language::java::translation::extractClassRefFromCopy(conv: Conventions[1], fe: FunctionExpression[1]): platform::extensions::language::java::translation::ClassRef[*]
{
   let src      = $fe.parametersValues->at(0);
   let rawOpt   = $src.genericType->rawType();
   if ($rawOpt->isEmpty(),
      | []->cast(@platform::extensions::language::java::translation::ClassRef),
      | let raw = $rawOpt->toOne();
        if (!$raw->instanceOf(platform::pure::metamodel::type::Class),
           | []->cast(@platform::extensions::language::java::translation::ClassRef),
           | let className = $raw->cast(@platform::pure::metamodel::PackageableElement).name->toOne();
             let keyExprs  = if ($fe.parametersValues->size() >= 2,
                                  | $conv->collectKeyExpressions($fe.parametersValues->at(1)),
                                  | []->cast(@FunctionExpression));
             let propNames = $keyExprs->map(ke | $conv->extractKeyExpressionPropName($ke));
             ^platform::extensions::language::java::translation::ClassRef(
           className     = $className,
           propertyNames = $propNames,
           purePath      = $fe.genericType->rawType()->map(t | $t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()));
        );
   );
}

function <<access.private>> platform::extensions::language::java::translation::extractClassRefFromNew(conv: Conventions[1], fe: FunctionExpression[1]): platform::extensions::language::java::translation::ClassRef[*]
{
   let className = $conv->extractNewTargetName($fe.parametersValues->at(0));
   if ($className == 'PureInstance',
      | []->cast(@platform::extensions::language::java::translation::ClassRef),
      | let keyExprs = if ($fe.parametersValues->size() >= 2,
                            | $conv->collectKeyExpressions($fe.parametersValues->at(1)),
                            | []->cast(@FunctionExpression));
        let propNames = $keyExprs->map(ke | $conv->extractKeyExpressionPropName($ke));
        ^platform::extensions::language::java::translation::ClassRef(
           className     = $className,
           propertyNames = $propNames,
           purePath      = $fe.genericType->rawType()->map(t | $t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()));
   );
}

// The generated method a key expression calls: `_p` sets the property, `_p_add`
// appends to it — `^X(p += v)` compiles to the 3-argument
// keyExpression('p', v, true).
function <<access.private>> platform::extensions::language::java::translation::keyExpressionSetter(ke: FunctionExpression[1], propName: String[1]): String[1]
{
   let add = $ke.parametersValues->size() >= 3
             && $ke.parametersValues->at(2)->instanceOf(AtomicValue)
             && $ke.parametersValues->at(2)->cast(@AtomicValue).value == [true];
   if ($add, | '_' + $propName + '_add', | '_' + $propName);
}

function <<access.private>> platform::extensions::language::java::translation::extractKeyExpressionPropName(conv: Conventions[1], ke: FunctionExpression[1]): String[1]
{
   let nameArg = $ke.parametersValues->at(0);
   if ($nameArg->instanceOf(AtomicValue),
      | $nameArg->cast(@AtomicValue).value->toOne()->cast(@String),
      | 'unknownProp'
   );
}

// Render a Pure expressionSequence as a list of Java statements. All but the
// last are emitted as Java statements (letFunction -> local var decl,
// everything else -> expression statement, preserving side-effect order).
// The last expression is wrapped in `return`. Mirrors Pure's "value of the
// body = value of the last expression" semantics — same shape as TS's
// buildTsFunctionBody.
// {@link buildJavaBody} for a function whose result holds many values: a
// single-valued last expression (`let a = $val` in a `[*]` function) is
// returned as a list.
// `body` with its final `return` cast to `returnType` when the returned code is
// typed otherwise: an expression's Pure type can be less specific than the
// function's declared one (`if(c, | [], | $coders->get($n))` is typed by `get`).
// The body of a function whose return multiplicity is a PARAMETER (`T[m]`):
// what it produced is returned as Pure holds it — one value when there is one,
// the collection otherwise. Fitting it to a type would decide that statically,
// and `m` is only known at the call site.
function <<access.private>> platform::extensions::language::java::translation::returningNormalized(body: Code[*], conv: Conventions[1]): Code[*]
{
   let last     = $body->last();
   let returned = $last->filter(c | $c->instanceOf(platform::extensions::language::java::metamodel::Return))->map(r | $r->cast(@platform::extensions::language::java::metamodel::Return).expression);
   if ($returned->isEmpty(),
      | $body,
      | $body->slice(0, $body->size() - 1)->concatenate(j_return(
           j_invoke(javaClass($conv->platform::extensions::language::java::translation::runtimeClass('PureValues')), 'norm',
                    [$returned->toOne()->toObjectCode()], javaObject()))));
}

function <<access.private>> platform::extensions::language::java::translation::returningType(body: Code[*], returnType: platform::extensions::language::java::metamodel::Type[1], conv: Conventions[1]): Code[*]
{
   let last     = $body->last();
   let returned = $last->filter(c | $c->instanceOf(platform::extensions::language::java::metamodel::Return))->map(r | $r->cast(@platform::extensions::language::java::metamodel::Return).expression);
   if ($returned->isEmpty() || $returned->toOne().type == $returnType || $returnType == javaVoid(),
      | $body,
      | $body->slice(0, $body->size() - 1)->concatenate(j_return($returned->toOne()->fitToType($returnType->toBoxed(), $conv))));
}

function <<access.private>> platform::extensions::language::java::translation::buildJavaBodyReturning(
   conv: Conventions[1],
   exprs: ValueSpecification[1..*],
   returnsMany: Boolean[1]
): Code[*]
{
   let body = $conv->buildJavaBody($exprs);
   let last = $exprs->at($exprs->size() - 1);
   let lastValue = if ($last->instanceOf(FunctionExpression) && $last->cast(@FunctionExpression).functionName == 'letFunction',
      | $last->cast(@FunctionExpression).parametersValues->at(1),
      | $last);
   if (!$returnsMany || !$lastValue->resolvedMultiplicity()->isSingleValued(),
      | $body,
      | $body->slice(0, $body->size() - 1)->concatenate(j_return(
           // Already a list (a `[1]` literal is typed [1] but translated as a List): as is.
           $conv->runtimeCall('PureValues', 'list', [$body->at($body->size() - 1)->cast(@platform::extensions::language::java::metamodel::Return).expression->toOne()->toObjectCode()], javaList()))));
}

function <<access.private>> platform::extensions::language::java::translation::buildJavaBody(
   conv: Conventions[1],
   exprs: ValueSpecification[1..*]
): Code[*]
{
   let lastIdx = $exprs->size() - 1;
   // Each statement is translated with the variables bound before it, so a
   // lambda knows what it can capture (see capturesCode).
   let built   = range(0, $lastIdx)->fold({i, acc |
                    let e = $exprs->at($i);
                    let c = $acc.conv->platform::extensions::language::java::translation::withJavaLocal($e);
                    ^$acc(codes = $acc.codes->concatenate($c->translateStatement($e)),
                          conv  = $c->withBinding($e));
                 }, ^platform::extensions::language::java::translation::BodyScope(conv = $conv, codes = []));
   let stmts   = $built.codes;
   let tailConv = $built.conv;
   let last    = $exprs->at($lastIdx);
   // Let-as-last-statement: Pure's `let x = v` returns v. {@link translateExpression}
   // has no `letFunction` coder (it's a statement-level form handled by
   // {@link translateStatement}), so a UDF like `function f(): T { let x = v; }`
   // would otherwise hit "No coder for Pure function: letFunction". Emit
   // `<T> x = v; return x;` instead. Mirrors the TS translator's
   // buildTsFunctionBody.
   let isLetLast = $last->instanceOf(FunctionExpression)
      && $last->cast(@FunctionExpression).functionName == 'letFunction'
      && $last->cast(@FunctionExpression).parametersValues->size() == 2;
   let tail = if ($isLetLast,
      | let fe       = $last->cast(@FunctionExpression);
        let varName  = $fe.parametersValues->at(0)->cast(@AtomicValue).value->toOne()->cast(@String)->platform::extensions::language::java::translation::safeJavaName();
        let valExpr  = $fe.parametersValues->at(1);
        let varType  = $tailConv->letVariableType($valExpr);
        [j_declare($varType, $varName, $tailConv->translateExpression($valExpr)),
         j_return(j_variable($varType, $varName))];,
      | [j_return($tailConv->translateExpression($last))]
   );
   $stmts->concatenate($tail);
}

// Translate a non-final expression-sequence element to a Java statement.
// `letFunction(name, value)` -> `<JavaType> name = value;` (type derived from
// the value expression's genericType/multiplicity).
// Anything else -> an ExpressionStatement wrapping translateExpression so
// side-effecting calls land in source order.
function <<access.private>> platform::extensions::language::java::translation::translateStatement(
   conv: Conventions[1],
   vs: ValueSpecification[1]
): Code[1]
{
   $vs->match([
      {fe: FunctionExpression[1] |
         if ($fe.functionName == 'letFunction' && $fe.parametersValues->size() == 2,
             | let varName  = $fe.parametersValues->at(0)->cast(@AtomicValue).value->cast(@String)->platform::extensions::language::java::translation::safeJavaName();
               let valExpr  = $fe.parametersValues->at(1);
               let varType  = $conv->letVariableType($valExpr);
               j_declare($varType, $varName, $conv->translateExpression($valExpr)->fitToType($varType, $conv));,
             | $conv->translateExpression($vs)->asJavaStatement()
         );
      },
      other: ValueSpecification[1] | $conv->translateExpression($other)->asJavaStatement()
   ]);
}

// Wrap an expression as a Java statement. {@link j_expressionStatement} only
// accepts MethodCall / StaticMethodCall / New / pre+postfix / assignment —
// anything else (a ternary `cond ? a : b`, a cast, a variable access, a
// literal) trips its assertion. Wrap such expressions in a no-op static
// {@code java.util.Objects.toString(expr, null)} call to make them valid
// statement syntax while preserving their evaluation side effects.
function <<access.private>> platform::extensions::language::java::translation::asJavaStatement(expr: Code[1]): Code[1]
{
   if ($expr->platform::extensions::language::java::metamodel::isValidExpressionAsStatement(),
      | j_expressionStatement($expr),
