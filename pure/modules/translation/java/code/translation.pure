      | $conv->decimalArithmetic($fe),
      | $conv->primitiveInfix($fe, $factory));
}

// Pure arithmetic on a Decimal is exact: both operands become BigDecimal and
// the BigDecimal method named for the function runs — Truffle's rule too.
function <<access.private>> platform::extensions::language::java::translation::decimalArithmetic(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
