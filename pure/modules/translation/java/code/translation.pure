   assert($conv.metadataElements, | 'No coder for Pure function: elementPath');
   j_invoke(javaClass($conv->pdbClass('Metadata')), 'elementPath',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaList(javaObject()));
