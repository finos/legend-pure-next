{
   let byType = $rawType->filter(t | [platform::pure::metamodel::type::primitives::Integer, platform::pure::metamodel::type::primitives::Float,
                                      platform::pure::metamodel::type::primitives::Number, platform::pure::metamodel::type::primitives::Decimal,
                                      platform::pure::metamodel::type::primitives::String, platform::pure::metamodel::type::primitives::Boolean]->contains($t));
   if ($byType->isNotEmpty(), | $expr->binaryOperandCast($byType->toOne()),
   |if ($peer == javaDouble() || $peer == javaClass('java.lang.Double'), | $expr->j_castWithoutChecks(javaClass('java.lang.Double'))->j_cast(javaDouble()),
   |if ($peer == javaLong()   || $peer == javaClass('java.lang.Long'),   | $expr->j_castWithoutChecks(javaClass('java.lang.Long'))->j_cast(javaLong()),
   |if ($peer == javaString(),                                           | $expr->j_castWithoutChecks(javaString()),
   |if ($peer == javaBigDecimal(),                                       | $expr->j_castWithoutChecks(javaBigDecimal()),
                                                                         | $expr)))));
