      | $expr->j_castWithoutChecks(javaClass('java.lang.Long'))->j_cast(javaLong()),
   |if ($rawType == platform::pure::metamodel::type::primitives::Decimal,
      | $expr->j_castWithoutChecks(javaBigDecimal()),
   |if ($rawType == platform::pure::metamodel::type::primitives::Float
      || $rawType == platform::pure::metamodel::type::primitives::Number,
      | $expr->j_castWithoutChecks(javaClass('java.lang.Double'))->j_cast(javaDouble()),
   |if ($rawType == platform::pure::metamodel::type::primitives::String,
      | $expr->j_castWithoutChecks(javaString()),
   |if ($rawType == platform::pure::metamodel::type::primitives::Boolean,
      | $expr->j_castWithoutChecks(javaClass('java.lang.Boolean'))->j_cast(javaBoolean()),
      | $expr
