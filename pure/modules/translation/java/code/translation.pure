           + 'java.util.function.BiFunction pureRdEq = (java.util.function.BiFunction) pureIifeIn.get(2); '
           + 'java.util.List<Object> pureRdOut = new java.util.ArrayList<>(); java.util.List<Object> pureRdKeys = new java.util.ArrayList<>(); '
           + 'for (Object pureRdV : (java.util.List<?>) pureIifeIn.get(0)) { '
           + 'Object pureRdK = pureRdKey == null ? pureRdV : pureRdKey.apply(pureRdV); boolean pureRdDup = false; '
           + 'for (Object pureRdSeen : pureRdKeys) { if (pureRdEq == null ? java.util.Objects.equals(pureRdSeen, pureRdK) : (Boolean) pureRdEq.apply(pureRdSeen, pureRdK)) { pureRdDup = true; break; } } '
           + 'if (!pureRdDup) { pureRdOut.add(pureRdV); pureRdKeys.add(pureRdK); } } '
           + 'return pureRdOut;', javaVoid())
