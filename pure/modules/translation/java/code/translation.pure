   // An offset outside the collection fails with Pure's message; the element (Object) is cast back to its
   // boxed type.
   $conv->runtimeCall('PureCollections', 'at', [$conv->translateAsList($fe.parametersValues->at(0)), $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaLong())], javaObject())
      ->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed());
}

// `readFile(path)` — the file's text, UTF-8.
// `compileAndExecute(source, className, methodName, args)` — the Java platform
// compiles the source in memory and calls the method (JavaSource), so translated
// code can compile and run further translated code.
function <<access.private>> platform::extensions::language::java::translation::compileAndExecuteCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 4, | 'compileAndExecuteCoder expects exactly 4 arguments, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: compileAndExecute');
   j_invoke(javaClass($conv->platformClass('execution.JavaSource')), 'compileAndExecute',
            [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString()),
             $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaString()),
             $conv->translateExpression($fe.parametersValues->at(2))->j_cast(javaString()),
             $conv->translateAsList($fe.parametersValues->at(3))], javaObject());
   // No cast: the value is whatever the compiled method returned — the native's
   // `Any[*]` doesn't make a single value a list.
}

// The `platform::pure::functions::meta::antlr` natives: parsing and walking a parse
// tree, which the platform's ANTLR extension provides (see the Antlr facade).
function <<access.private>> platform::extensions::language::java::translation::antlrCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($conv.metadataElements, | 'No coder for Pure function: ' + $fe->coderName());
   let args = $fe.parametersValues->map(p | $conv->antlrArgument($p));
   j_invoke(javaClass($conv->platformClass('grammar.Antlr')), $fe->coderName(), $args, javaObject())
      ->fitToType($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed(), $conv);
}

// One argument of an ANTLR native, typed as the facade declares it: a parse-tree
// context is opaque (Object), the rest are the primitives Pure names.
function <<access.private>> platform::extensions::language::java::translation::antlrArgument(conv: Conventions[1], vs: ValueSpecification[1]): Code[1]
{
   let raw  = $vs.genericType->rawType();
   let code = $conv->translateExpression($vs);
   if ($raw == [String],   | $code->j_cast(javaString()),
   |if ($raw == [Integer],  | $code->j_castWithoutChecks(javaClass('java.lang.Long'))->j_cast(javaLong()),
   |if ($raw == [Boolean],  | $code->j_castWithoutChecks(javaBooleanBoxed())->j_cast(javaBoolean()),
                            | $code->toObjectCode())));
}

// `openVariableValues(lambda)` — what the lambda captured, carried by the value
// itself (see capturesCode).
function <<access.private>> platform::extensions::language::java::translation::openVariableValuesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'openVariableValuesCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: openVariableValues');
   j_invoke(javaClass($conv->pdbClass('Metadata')), 'openVariables',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaClass('java.util.Map'));
}

// `compileSource(file, dependencies)` — compile Pure at run time. The compiler
// is Pure too, so this only hands it the parsed file (see the platform's
// Compilation); nothing it compiles is added to the running program's graph.
function <<access.private>> platform::extensions::language::java::translation::compileSourceCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2 || $fe.parametersValues->size() == 3,
          | 'compileSourceCoder expects (file, dependencies) or (sourceId, content, dependencies), got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: compileSource');
   // The three-argument form is the same call over source text: it parses first.
   let file = if ($fe.parametersValues->size() == 2,
                  | $conv->translateExpression($fe.parametersValues->at(0))->toObjectCode(),
                  | $conv->parseCall($fe.parametersValues->at(0), $fe.parametersValues->at(1)));
   let dependencies = $conv->translateExpression($fe.parametersValues->last()->toOne())->toObjectCode();
   j_invoke(javaClass(compilationClass()), 'compileSource', [$file, $dependencies], javaObject());
}

// `findAllTypes()` / `findFunctionsByNameAndArity(name, arity)` — what the
