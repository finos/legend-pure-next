// ----------------------------------------------------------------------------

function <<access.private>> meta::external::language::java::translation::startsWithCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'startsWithCoder expects exactly 2 arguments');
