function <<access.private>> platform::extensions::language::java::translation::asinCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->mathDoubleCoder($fe, 'asin') }
function <<access.private>> platform::extensions::language::java::translation::acosCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->mathDoubleCoder($fe, 'acos') }
function <<access.private>> platform::extensions::language::java::translation::atanCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->mathDoubleCoder($fe, 'atan') }
function <<access.private>> platform::extensions::language::java::translation::cotCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   // Java's Math has no cot; emit {@code 1.0 / Math.tan(x)}.
   assert($fe.parametersValues->size() == 1, | 'cotCoder expects exactly 1 argument');
   let n = $conv->translateExpression($fe.parametersValues->at(0));
   let tan = j_invoke(javaClass('java.lang.Math'), 'tan', [$n->j_cast(javaDouble())], javaDouble());
   j_divide(j_double(1.0), $tan);
}

// `abs(n)` — Math.abs is overloaded for long/double; the Pure→Java type
// mapping uses long for Integer, double for Float/Number. We branch on the
// rawType so an Integer arg stays a long round-trip (matches Pure's
// {@code abs(Integer)->Integer}).
function <<access.private>> platform::extensions::language::java::translation::absCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'absCoder expects exactly 1 argument');
   let arg = $fe.parametersValues->at(0);
   let n   = $conv->translateExpression($arg);
   let rawOpt = $arg.genericType->rawType();
   let isInt  = $rawOpt->isNotEmpty() && $rawOpt->toOne() == platform::pure::metamodel::type::primitives::Integer;
   if ($arg->isDecimalTyped(), | $n->j_castWithoutChecks(javaBigDecimal())->j_invoke('abs', [], javaBigDecimal()),
   |if ($isInt,
      | j_invoke(javaClass('java.lang.Math'), 'abs', [$n->j_cast(javaLong())], javaLong()),
      | j_invoke(javaClass('java.lang.Math'), 'abs', [$n->j_cast(javaDouble())], javaDouble())
   ));
}

// `sign(n)` — Pure: returns Integer (-1/0/+1). Java: {@code Math.signum} returns
// a double matching the input sign — cast to long since Pure's return is Integer.
function <<access.private>> platform::extensions::language::java::translation::signCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'signCoder expects exactly 1 argument');
   let n = $conv->translateExpression($fe.parametersValues->at(0));
   j_cast(
      j_invoke(javaClass('java.lang.Math'), 'signum', [$n->j_cast(javaDouble())], javaDouble()),
      javaLong()
   );
}

// String case / trim intrinsics — direct String methods. Note: Pure's trim
// strips ASCII whitespace; Java's String.strip() strips Unicode whitespace
// (close enough for PCT tests). {@code stripLeading} / {@code stripTrailing}
// give the one-side variants.
function <<access.private>> platform::extensions::language::java::translation::stringUnaryCoder(conv: Conventions[1], fe: FunctionExpression[1], methodName: String[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | $methodName + 'Coder expects exactly 1 argument');
   let s = $conv->translateExpression($fe.parametersValues->at(0));
   $s->j_cast(javaString())->j_invoke($methodName, [], javaString());
}

function <<access.private>> platform::extensions::language::java::translation::toLowerCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1] { $conv->stringUnaryCoder($fe, 'toLowerCase') }
function <<access.private>> platform::extensions::language::java::translation::toUpperCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1] { $conv->stringUnaryCoder($fe, 'toUpperCase') }
function <<access.private>> platform::extensions::language::java::translation::trimCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]    { $conv->stringUnaryCoder($fe, 'strip') }
function <<access.private>> platform::extensions::language::java::translation::ltrimCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]   { $conv->stringUnaryCoder($fe, 'stripLeading') }
function <<access.private>> platform::extensions::language::java::translation::rtrimCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]  { $conv->stringUnaryCoder($fe, 'stripTrailing') }

// Numeric conversions — Pure's `toFloat` accepts {@code Number|String}, returns
// Float. Same shape as `toDecimal`. Emit a {@code Double.parseDouble(s)} for
// String inputs, else cast to double. Detect String at translate-time via the
// arg's rawType; fall back to runtime cast otherwise.
function <<access.private>> platform::extensions::language::java::translation::toFloatCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'toFloatCoder expects exactly 1 argument');
   let arg = $fe.parametersValues->at(0);
   let n   = $conv->translateExpression($arg);
   let raw = $arg.genericType->rawType();
   let isStr = $raw->isNotEmpty() && $raw->toOne() == platform::pure::metamodel::type::primitives::String;
   if ($isStr,
      | j_invoke(javaClass('java.lang.Double'), 'parseDouble', [$n->j_cast(javaString())], javaDouble()),
      | $n->j_cast(javaDouble())
   );
}

// `toDecimal(n)` — the number as a BigDecimal.
function <<access.private>> platform::extensions::language::java::translation::toDecimalCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'toDecimalCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   $conv->asBigDecimal($fe.parametersValues->at(0));
}

// `assertEmpty(coll)` — equivalent to {@code assert(coll.isEmpty())}. The
// existing assertCoder pattern returns the boolean expression directly;
// callers (test bodies) treat a false return as a test failure. Match that
// shape so assertEmpty plugs into the same surrounding assertion harness.
function <<access.private>> platform::extensions::language::java::translation::assertEmptyCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'assertEmptyCoder expects at least 1 argument');
   // translateAsList covers every representation: a List, a null standing for
   // an empty collection, and a lone value (never empty).
   $conv->translateAsList($fe.parametersValues->at(0))->j_invoke('isEmpty', [], javaBoolean());
}

// `in(value, coll)` — collection contains. Pure's `in` is identity-ish; we
// route through {@code Collection.contains} which uses {@code .equals}.
function <<access.private>> platform::extensions::language::java::translation::inCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'inCoder expects exactly 2 arguments');
   let v    = $conv->translateExpression($fe.parametersValues->at(0));
   let coll = $conv->translateExpression($fe.parametersValues->at(1));
   $coll->j_cast(javaClass('java.util.Collection'))->j_invoke('contains', [$v->j_box()], javaBoolean());
}

// `elementToPath(el)` — Pure returns the canonical `::`-joined path of a
// PackageableElement. Our translator currently emits PE values as their
// short-name String literal — so the runtime "path" is just that String,
// without the leading namespace. Best-effort: passthrough the string when
// arg is already a String, else fall back to {@code String.valueOf}.
// `genericType(value)` — the value's classifier, which only the Java platform
// can answer: the metamodel object the value carries (or one over its type).
function <<access.private>> platform::extensions::language::java::translation::genericTypeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'genericTypeCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'No coder for Pure function: genericType');
   j_invoke(javaClass($conv->pdbClass('Metadata')), 'genericType',
            [$conv->translateExpression($fe.parametersValues->at(0))->toObjectCode()], javaObject())
      ->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed());
}

// `elementPath(el)` — the packages from the outermost down to `el`, as Pure's
// native returns them. Only the platform can answer it: it walks the metadata
// graph, so it needs the real elements (see Metadata.elementPath).
// `entryNames(archive)` / `entryBytes(archive, name)` — reading the zip a .pdb
// is, through the host's own zip reader rather than a DEFLATE written in Pure.
// See archiveRead.pure and PdbArchives.
function <<access.private>> platform::extensions::language::java::translation::entryNamesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'entryNamesCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaClass($conv->pdbClass('PdbArchives')), 'entryNames',
            [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaArray(javaByte()))], javaList(javaObject()));
}

function <<access.private>> platform::extensions::language::java::translation::entryBytesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'entryBytesCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   j_invoke(javaClass($conv->pdbClass('PdbArchives')), 'entryBytes',
            [$conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaArray(javaByte())),
