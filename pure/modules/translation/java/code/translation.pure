}

// `parseInteger(str)` — Pure: returns Integer. Java: {@code Long.parseLong(s)}.
function <<access.private>> platform::extensions::language::java::translation::parseIntegerCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
