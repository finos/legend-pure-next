// `inferType(cells)` — the type a CSV column's cells have: the host's handwritten execution.InferType applies
// the rules (see inferType.pure) and the type is the metadata element at that path. A type is metadata, so
// this is a metadata-mode function only.
function <<access.private>> platform::extensions::language::java::translation::inferTypeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1, | 'inferTypeCoder expects exactly 1 argument, got ' + $fe.parametersValues->size()->toString());
   assert($conv.metadataElements, | 'inferType needs the platform metadata: it returns a Type element');
   let path = j_invoke(javaClass($conv->platformClass('execution.InferType')), 'path',
                       [$conv->translateAsList($fe.parametersValues->at(0))->toObjectCode()], javaString());
   j_invoke(javaClass($conv->pdbClass('Metadata')), 'element', [$path], javaObject());
