   if ($fe.parametersValues->at(0)->isDecimalTyped(), | $conv->decimalToInteger($fe.parametersValues->at(0), 'CEILING'), |
   j_cast(j_invoke(javaMath(), 'ceil', [$conv->translateExpression($fe.parametersValues->at(0))], javaDouble()), javaLong()));
}

// toOne(x) — Pure's multiplicity narrower. For scalar values it's a pure
// passthrough at the value level (Java doesn't carry Pure's multiplicity at
// runtime); the type erasure already matches what the caller expects.
function <<access.private>> meta::external::language::java::translation::toOneCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 1 || $fe.parametersValues->size() == 2, | 'toOneCoder expects 1 or 2 arguments, got ' + $fe.parametersValues->size()->toString());
   if ($fe.parametersValues->size() == 2, | $conv->toOneWithMessage($fe), | $conv->toOneValue($fe));
}

// `toOne(values, message)`: the only value, or an error with `message`,
// evaluated only then.
function <<access.private>> meta::external::language::java::translation::toOneWithMessage(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let values  = $conv->translateAsList($fe.parametersValues->at(0));
   let message = $conv->translateExpression($fe.parametersValues->at(1));
   valueIife($values->toObjectCode(), javaObject(), javaObject(), [
      j_code('java.util.List<?> pureOneL = (java.util.List<?>) pureIifeIn;', javaVoid()),
      j_if(j_code('pureOneL.size() != 1', javaBoolean()), j_throw(j_new(javaClass('java.lang.RuntimeException'), [j_invoke(javaString(), 'valueOf', [$message->toObjectCode()], javaString())]))),
      j_code('return pureOneL.get(0);', javaVoid())
   ])->j_castWithoutChecks($conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed());
}

function <<access.private>> meta::external::language::java::translation::toOneValue(conv: Conventions[1], fe: FunctionExpression[1]): Code[1]
{
   let arg  = $fe.parametersValues->at(0);
   let code = $conv->translateExpression($arg);
   // When the source is multi-valued, extract the first element via
   // {@code .get(0)} so the result type matches Pure's `[1]` shape. Pure
   // scalars (`[1]` or `[0..1]`) pass through unchanged — the runtime
   // value is already the single element. Cast the result to the FE's
   // expected type (boxed when primitive — Java auto-unboxes in context).
   // A multiplicity parameter (`TryResult.value` is `V[m]`) is neither single
   // nor many statically: unwrap a list at run time, pass anything else through.
   let extracted = if ($arg.multiplicity->toOne()->holdsManyValues(),
      | $conv->translateAsList($arg)->j_invoke('get', [j_int(0)], javaObject()),
   |if (!$arg.multiplicity->toOne()->instanceOf(meta::pure::metamodel::multiplicity::ConcreteMultiplicity),
      | $code->singleValueOfAny(),
      | $code
   ));
   let feRetType = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity);
   // fitToType, not a cast: a scalar Pure multiplicity can still arrive as a
   // Java List (an automapped property read builds one), and `(Long) aList`
   // is not a cast Java accepts.
   $extracted->fitToType($feRetType->toBoxed());
}

// Collection slice + transform — Pure's `take`/`drop`/`map` over `[*]` map
// onto Java `Stream` ops with `.toList()` (Java 16+ shortcut for
// `.collect(Collectors.toList())`). The 4-arg j_invoke variant carries an
// explicit return type since these stream methods aren't in apiKnowledge.
function <<access.private>> meta::external::language::java::translation::takeCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'takeCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   // A negative count takes nothing; Stream.limit would throw on it.
   let n    = j_invoke(javaMath(), 'max', [j_long(0), $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaLong())], javaLong());
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('limit',  [$n], javaStream(javaObject()))
        ->j_invoke('toList', [], javaList(javaObject()));
}

function <<access.private>> meta::external::language::java::translation::dropCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'dropCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   // A negative count drops nothing; Stream.skip would throw on it.
   let n    = j_invoke(javaMath(), 'max', [j_long(0), $conv->translateExpression($fe.parametersValues->at(1))->j_cast(javaLong())], javaLong());
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('skip',   [$n], javaStream(javaObject()))
        ->j_invoke('toList', [], javaList(javaObject()));
}

// map's second arg is an AtomicValue holding a LambdaFunction; the scalar
// dispatch in translateScalarAtomicValue lifts it into a Java lambda via
// translateLambdaValue, which becomes the Function passed to Stream.map.
function <<access.private>> meta::external::language::java::translation::mapCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'mapCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   let coll = $conv->translateAsList($fe.parametersValues->at(0));
   let f    = $conv->translateExpression($fe.parametersValues->at(1));
   // Pure's map concatenates the results: a to-many result is flattened and an
   // empty one (null) dropped.
   $coll->j_invoke('stream', [], javaStream(javaObject()))
        ->j_invoke('map',    [$f], javaStream(javaObject()))
        ->j_invoke('flatMap', [j_code('pureFlatV -> pureFlatV instanceof java.util.List ? ((java.util.List<?>) pureFlatV).stream() : java.util.stream.Stream.ofNullable(pureFlatV)', javaObject())], javaStream(javaObject()))
        ->j_invoke('toList', [], javaList(javaObject()))
        // Raw: the typed lambda makes it a List<String>, not a List<Object>.
        ->j_castWithoutChecks(javaList());
}

// `$lambda->eval(args...)` — invoke a Pure lambda. The lambda was translated
// via translateLambdaValue into a Java lambda expression; cast it to the
// arity-matched functional interface (Supplier/Function/BiFunction) and
// dispatch through `.get()`/`.apply(...)`. Arities > 2 are uncommon in PCT
// and fall through with a clear diagnostic — Java doesn't ship a built-in
// TriFunction so each would need its own ad-hoc interface.
function <<access.private>> meta::external::language::java::translation::evalCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() >= 1, | 'evalCoder expects at least 1 argument (the lambda)');
   let lambdaArg = $fe.parametersValues->at(0);
   let argVals   = $fe.parametersValues->slice(1, $fe.parametersValues->size());
   // β-reduction fast path. Pure compiles `someFn_Number_1__Float_1_->eval(x)`
   // by η-expanding the function reference into a lambda `(a -> someFn($a))`.
   // The default cast-to-Function path then emits
   // {@code ((Function<Object,Object>)(Number a) -> Math.someFn(a.doubleValue())).apply(x)}
   // which javac rejects because Function is invariant and `(Number a) -> ...`
   // doesn't satisfy `Function<Object, Object>`. By β-reducing — substituting
   // the eval args for the lambda's parameter references — we collapse to
   // {@code Math.someFn(((Number) x).doubleValue())} and let the inner
   // coder generate idiomatic Java. Works for any function with a coder
   // (cbrt, sqrt, sin, cos, log, ...) AND for UDF refs (helper-class call).
   // `evaluate` wraps each argument in a Pure List, so its arguments cannot be
   // substituted into the callee: only `eval` gets the inlining fast path.
   let inlined = if ($fe->coderName() == 'evaluate', | []->cast(@Code), | $conv->tryInlineLambdaAtomicValue($lambdaArg, $argVals));
   // fitToType, not a cast: what a called function returns is a single value or
   // a list at run time, whatever the call's multiplicity says.
   let type = $conv->pureTypeToJavaType($fe.genericType, $fe.multiplicity)->toBoxed();
   // The call is built inside the arms: `let` is eager, and the fallback
   // refuses arities the inlining fast path handles happily.
   if ($inlined->isNotEmpty(),
      | $inlined->toOne()->fitToType($type),
   |if ($fe->coderName() == 'evaluate' && $conv.metadataElements,
      | $conv->evaluateCoder($lambdaArg, $argVals)->fitToType($type),
      | $conv->evalCoderFallback($lambdaArg, $argVals)->fitToType($type)
   ));
}

// `evaluate(f, [^List(values=a), ^List(values=b)])` — the arity is the size of
// that ONE collection, not the number of arguments the expression has, so the
// platform is handed the collection and unwraps it (a no-argument call is an
// empty collection, which `eval`'s by-argument path would read as one argument).
function <<access.private>> meta::external::language::java::translation::evaluateCoder(
   conv: Conventions[1],
   lambdaArg: ValueSpecification[1],
   argVals: ValueSpecification[*]
): Code[1]
{
   let lambdaCode = $conv->translateExpression($lambdaArg)->typedFunctionValue();
   let argsCode   = if ($argVals->isEmpty(),
                       | j_null(),
                       | $conv->translateExpression($argVals->toOne())->toObjectCode());
   j_invoke(javaClass('org.finos.legend.pure.platform.java.pdb.Metadata'), 'evaluate',
            [$lambdaCode, $argsCode], javaObject());
}

// Original evalCoder path — cast the lambda to Supplier / Function /
// BiFunction by arity and invoke .get / .apply. Used when β-reduction
// can't apply (non-literal lambda, multi-statement body, arity mismatch).
function <<access.private>> meta::external::language::java::translation::evalCoderFallback(
   conv: Conventions[1],
   lambdaArg: ValueSpecification[1],
   argVals: ValueSpecification[*]
): Code[1]
{
   let lambdaCode = $conv->translateExpression($lambdaArg);
   let evalArgs   = $argVals->map(p | $conv->translateExpression($p));
   // On the platform the callee may be a function of the metadata (a test the
   // runner discovered), which is called through its translated class.
   if ($conv.metadataElements,
      | j_invoke(javaClass('org.finos.legend.pure.platform.java.pdb.Metadata'), 'invoke',
                 [$lambdaCode->typedFunctionValue(),
                  j_invoke(javaArrays(), 'asList', $evalArgs->map(a | $a->typedFunctionValue()), javaList())], javaObject()),
   |if ($evalArgs->isEmpty(),
       | $lambdaCode->j_cast(javaSupplier(javaObject()))->j_invoke('get', [], javaObject()),
       |if ($evalArgs->size() == 1,
            | $lambdaCode->j_cast(javaFunction(javaObject(), javaObject()))->j_invoke('apply', $evalArgs, javaObject()),
            |if ($evalArgs->size() == 2,
                 | $lambdaCode->j_cast(javaBiFunction(javaObject(), javaObject(), javaObject()))->j_invoke('apply', $evalArgs, javaObject()),
            |if ($evalArgs->size() == 3,
                 | $lambdaCode->j_cast(javaClass(meta::external::language::java::translation::pureFunction3Class()))->j_invoke('apply', $evalArgs, javaObject()),
                 | fail('evalCoder: arities > 3 not yet supported, got ' + $evalArgs->size()->toString()); j_null();
             ))
        )
   ));
}

// β-reduction fast path. If `lambdaArg` is an {@link AtomicValue} wrapping a
// {@link LambdaFunction} with N parameters that match N eval args, substitute
// each {@code VariableExpression($paramName)} in the lambda body with the
// corresponding eval arg and translate the substituted body directly. Returns
// empty if the shape doesn't match.
function <<access.private>> meta::external::language::java::translation::tryInlineLambdaAtomicValue(
   conv: Conventions[1],
   lambdaArg: ValueSpecification[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if (!$lambdaArg->instanceOf(AtomicValue),
      | []->cast(@Code),
      | $conv->tryInlineLambdaFromAV($lambdaArg->cast(@AtomicValue), $evalArgs)
   );
}

function <<access.private>> meta::external::language::java::translation::tryInlineLambdaFromAV(
   conv: Conventions[1],
   av: AtomicValue[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if ($av.value->isEmpty(),
      | []->cast(@Code),
      | $conv->tryInlineFuncValue($av.value->toOne(), $evalArgs)
   );
}

// Dispatch on the AV's wrapped value: literal LambdaFunction → β-reduce
// via parameter substitution. {@link PackageableFunction} reference (e.g.
// {@code tan_Number_1__Float_1_}) → synthesise a {@link FunctionExpression}
// with the function's short name and route through the coder map. Other
// values: skip (evalCoder falls back to its Function-cast path).
function <<access.private>> meta::external::language::java::translation::tryInlineFuncValue(
   conv: Conventions[1],
   v: Any[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   if ($v->instanceOf(LambdaFunction),
      | $conv->tryInlineLambda($v->cast(@LambdaFunction<Any>), $evalArgs),
      | if ($v->instanceOf(meta::pure::metamodel::function::PackageableFunction),
           | $conv->tryInlinePackageableFunction($v->cast(@meta::pure::metamodel::function::PackageableFunction<Any>), $evalArgs),
           | []->cast(@Code)
        )
   );
}

// A function passed by name (`contains($x, myComparator_A_1__A_1__Boolean_1_)`)
// as a Java lambda that calls it: `(var a0_pureArg, ...) -> { A a0 = (A) a0_pureArg;
// ...; return fn(a0, ...); }`, the call translated like one written in the body.
function <<access.private>> meta::external::language::java::translation::translateFunctionReference(conv: Conventions[1], fn: meta::pure::metamodel::function::PackageableFunction<Any>[1]): Code[1]
{
   let fnType = $fn.classifierGenericType.typeArguments->at(0)->rawType()->toOne()->cast(@meta::pure::metamodel::type::FunctionType);
   let vars   = range($fnType.parameters->size())->map(i |
      ^meta::pure::metamodel::valuespecification::VariableExpression(
         name = 'pureFnA' + $i->toString(),
         genericType = $fnType.parameters->at($i).genericType,
         multiplicity = $fnType.parameters->at($i).multiplicity));
   let call   = $conv->tryInlinePackageableFunction($fn, $vars);
   assert($call->isNotEmpty(), | 'translateFunctionReference: no coder or helper for ' + $fn.functionName->toOne());
   let lambda = j_lambda($vars->map(v | j_parameter(javaTypeVar('var'), $v.name + '_pureArg')),
                         j_block($vars->map(v | $conv->rebindLambdaParameter($v))->concatenate(j_return($call->toOne()))));
   $conv->withElementIdentity($lambda, $fn, $vars->size());
}

// A function reference IS the element it names, as well as something to call:
// `assertIs(toString_Any_1__String_1_, pathToElement('...'))` compares the two.
// The wrapper keeps the lambda's Java type, so it still fits where a functional
// interface is expected; an arity the platform cannot call stays a plain lambda.
function <<access.private>> meta::external::language::java::translation::withElementIdentity(conv: Conventions[1], code: Code[1], fn: meta::pure::metamodel::function::PackageableFunction<Any>[1], arity: Integer[1]): Code[1]
{
   let type = if ($arity == 0, | [javaClass('java.util.function.Supplier')],
              |if ($arity == 1, | [javaClass('java.util.function.Function')],
              |if ($arity == 2, | [javaClass('java.util.function.BiFunction')],
                                | []->cast(@meta::external::language::java::metamodel::Type))));
   if (!$conv.metadataElements || $type->isEmpty(),
      | $code,
      | j_invoke(javaClass('org.finos.legend.pure.platform.java.pdb.PureLambda'), 'ofElement',
                 [$code->j_castWithoutChecks($type->toOne()), j_string($fn->elementToPath())], javaObject())
           ->j_castWithoutChecks($type->toOne()));
}

// Function reference: build a synthetic {@code FunctionExpression(functionName=...,
// parametersValues=[args])} and translate via the coder map. Mirrors what
// would have been emitted if the user had written `fn(args)` directly.
// Returns empty when no coder OR no UDF helper-class match — caller
// falls back to the typed-lambda cast path which usually fails javac.
function <<access.private>> meta::external::language::java::translation::tryInlinePackageableFunction(
   conv: Conventions[1],
   fn: meta::pure::metamodel::function::PackageableFunction<Any>[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let shortName = $fn.functionName->toOne();
   // Synthetic FE genericType is required but inconsequential for translation
   // (coders read it for type-aware emit but eval-routed natives don't need
   // it). Use an empty {@code CompilerNotSetGenericType} placeholder.
   let synthetic = ^meta::pure::metamodel::valuespecification::FunctionInvocation(
      functionName     = $shortName,
      parametersValues = $evalArgs,
      func             = $fn,
      multiplicity     = meta::pure::metamodel::multiplicity::PureOne,
      genericType      = ^meta::pure::metamodel::type::generics::CompilerNotSetGenericType()
   );
   // Route through the coder map when present; otherwise check UDF helper
   // class dispatch (translateUdfCall handles UserDefinedFunction targets).
   let coderOpt = $conv->coderFor($fn, $shortName);
   if ($coderOpt->isNotEmpty(),
      | [$coderOpt->toOne()->eval($synthetic, $conv)],
      | if ($fn->instanceOf(meta::pure::metamodel::function::UserDefinedFunction),
           | [$conv->translateUdfCall($synthetic)],
           | []->cast(@Code)
        )
   );
}

function <<access.private>> meta::external::language::java::translation::tryInlineLambda(
   conv: Conventions[1],
   lambda: LambdaFunction<Any>[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let params = $lambda.parameters;
   let body   = $lambda.expressionSequence;
   // Match arity AND single-expression body — multi-statement bodies need
   // a Block wrapper which doesn't fit cleanly into expression position.
   if ($params->size() != $evalArgs->size() || $body->size() != 1,
      | []->cast(@Code),
      | $conv->inlineLambdaBody($params, $body->at(0), $evalArgs)
   );
}

function <<access.private>> meta::external::language::java::translation::inlineLambdaBody(
   conv: Conventions[1],
   params: meta::pure::metamodel::valuespecification::VariableExpression[*],
   body: ValueSpecification[1],
   evalArgs: ValueSpecification[*]
): Code[0..1]
{
   let subs = range(0, $params->size())->map(i |
      ^meta::pure::translation::shared::ParamSub(name = $params->at($i).name, value = $evalArgs->at($i))
   );
   let substituted = $body->meta::pure::translation::shared::substituteVariables($subs);
   [$conv->translateExpression($substituted)];
}

// `format(fmt, args)` -> `String.format(fmt, args.toArray())`. Pure's format
// strings (`%s`, `%d`, etc.) share syntax with java.util.Formatter, so we
// can pass the format string through unchanged. List.toArray() returns
// Object[] which satisfies String.format's varargs.
function <<access.private>> meta::external::language::java::translation::formatCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'formatCoder expects exactly 2 arguments, got ' + $fe.parametersValues->size()->toString());
   // Pure's printf dialect isn't Java's (%r, %t{pattern}, Pure toString of each
   // value), so it runs in the generated PureFormat class.
   let fmt  = $conv->translateExpression($fe.parametersValues->at(0))->j_cast(javaString());
   let args = $conv->translateExpression($fe.parametersValues->at(1))->toObjectCode();
   j_invoke(javaClass(meta::external::language::java::translation::runtimeClass('PureFormat')), 'format', [$fmt, $args], javaString());
}

// `print(x)` — Pure returns the formatted-string representation of x AND
// writes it to stdout. We emit only the return path (`String.valueOf(x)`)
// — the stdout side-effect is dropped because expression-position println
// would require wrapping in a Supplier closure. PCT assertions check the
// return value, not what reached stdout, so the round-trip still validates
// semantics for the cases we care about.
function <<access.private>> meta::external::language::java::translation::printCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n == 1 || $n == 2, | 'printCoder expects 1 or 2 arguments, got ' + $n->toString());
   // Pure: print(value) and print(value, maxChars). Both return a String; the
   // max-chars argument is ignored. The format follows the JS runtime's
   // __pureFormat: a collection prints one element per line (empty prints
   // nothing), a String prints bare at the top level and quoted when nested, a
   // Float as {@link pureFloatStringJava}, and an instance of a generated
   // helper class as its class name followed by one indented
   // `property: value` line per non-empty property. The recursive formatter is
   // a local class inside the IIFE, so no helper class has to be emitted.
   valueIife(
      $conv->translateExpression($fe.parametersValues->at(0)),
      javaObject(),
      javaString(),
      [j_code('class PureFmt { static String f(Object v, int d) { '
         + 'if (v == null) { return ""; } '
         + 'if (v instanceof java.util.List) { java.util.List<String> parts = new java.util.ArrayList<>(); '
         + 'for (Object e : (java.util.List) v) { parts.add(f(e, d)); } '
         + 'return String.join(String.valueOf((char) 10), parts); } '
         + 'if (v instanceof String) { return d == 0 ? (String) v : String.valueOf((char) 39) + v + String.valueOf((char) 39); } '
         + pureFloatStringJava('v')
         + 'if (v instanceof Enum) { return ((Enum<?>) v).name(); } '
         + 'if (v instanceof org.finos.legend.pure.platform.java.pdb.LazyObject) { org.finos.legend.pure.platform.java.pdb.LazyObject lo = (org.finos.legend.pure.platform.java.pdb.LazyObject) v; '
         + 'String path = lo._purePath(); StringBuilder sb = new StringBuilder(path.substring(path.lastIndexOf(58) + 1)); '
         + 'for (String pn : lo._propertyNames()) { '
         + 'if (pn.equals("classifierGenericType") || pn.equals("elementOverride")) { continue; } '
         + 'java.util.List<Object> fvs = lo.__values(pn); if (fvs.isEmpty()) { continue; } '
         + 'Object fv = fvs.size() == 1 ? fvs.get(0) : fvs; '
         + 'sb.append((char) 10).append("  ".repeat(d + 1)).append(pn).append(": ").append(f(fv, d + 1)); } '
         + 'return sb.toString(); } '
         + 'return String.valueOf(v); } } '
         + 'return PureFmt.f(pureIifeIn, 0);', javaVoid())]);
}

// `coll->sort()` — natural-order sort. Stream.sorted() on natural order
// requires the elements implement Comparable; PCT tests typically sort
// Number/String collections so this is fine. The 2-arg form (custom
// comparator) is more involved and currently fails through to the
// arity assert.
function <<access.private>> meta::external::language::java::translation::sortCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   let n = $fe.parametersValues->size();
   assert($n >= 1 && $n <= 3, | 'sortCoder expects 1, 2, or 3 arguments, got ' + $n->toString());
   // Raw list, so the raw toList() fits whatever list type the caller declares
   // (a mixed literal infers List<Number & Comparable<...>>, not List<Number>).
   let stream = $conv->translateAsList($fe.parametersValues->at(0))
                  ->j_invoke('stream', [], javaStream(javaObject()));
   // Natural order compares mixed numbers by value: Pure sorts [342, 5.0, -2.0]
   // numerically, where Long.compareTo(Double) would throw ClassCastException.
   // Other values of different classes order by class name first, as on the
   // Truffle runtime (['aaa', 2] sorts without failing).
   let naturalOrder = j_code('(java.util.Comparator) (var pureCmpA, var pureCmpB) -> '
      + '(pureCmpA instanceof Number && pureCmpB instanceof Number && !(pureCmpA instanceof Long && pureCmpB instanceof Long)) '
      + '? Double.compare(((Number) pureCmpA).doubleValue(), ((Number) pureCmpB).doubleValue()) '
      + ': pureCmpA.getClass() != pureCmpB.getClass() && !(pureCmpA instanceof Number && pureCmpB instanceof Number) '
      + '? pureCmpA.getClass().getName().compareTo(pureCmpB.getClass().getName()) '
      + ': ((Comparable) pureCmpA).compareTo(pureCmpB)', javaClass('java.util.Comparator'));
   let sorted = if ($n == 1,
      | $stream->j_invoke('sorted', [$naturalOrder], javaStream(javaObject())),
      | $conv->sortStreamWithArgs($stream, $fe.parametersValues)
   );
   $sorted->j_invoke('toList', [], javaList(javaObject()));
}

// Apply the comparator/key-extractor args to a stream. 2-arg form: cast the
// 2nd arg to {@code Comparator} and hand to {@code Stream.sorted}. 3-arg
// form (key + comparator): compose via {@code Comparator.comparing(key, comp)}.
function <<access.private>> meta::external::language::java::translation::sortStreamWithArgs(conv: Conventions[1], stream: Code[1], args: ValueSpecification[*]): Code[1]
{
   let cmpClass = javaClass('java.util.Comparator');
   let fnClass  = javaClass('java.util.function.Function');
   // Raw casts for Function / Comparator targets — the factory's lambda-cast
   // path only whitelists Function/Supplier and trips its assert on
   // Comparator; for Function it inserts a body rewrite that's overly strict
   // for typed Pure lambdas like {@code {String s -> s}}.
   let cmp = if ($args->size() == 2,
      | $conv->pureComparator($args->at(1)),
      | j_invoke($cmpClass, 'comparing',
           [$conv->translateExpression($args->at(1))->j_castWithoutChecks($fnClass),
            $conv->pureComparator($args->at(2))],
           $cmpClass)
   );
   $stream->j_invoke('sorted', [$cmp], javaStream(javaObject()));
}

// A Pure predicate value as a java.util.function.Predicate. Casting works for a
// lambda literal, but a lambda already created as a Function — a let-bound
// `func` — throws ClassCastException when cast to Predicate at runtime, so
// adapt through Function.apply in both cases.
function <<access.private>> meta::external::language::java::translation::asPredicate(fn: Code[1]): Code[1]
{
