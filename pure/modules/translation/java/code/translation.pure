   let p = $conv->translateExpression($fe.parametersValues->at(1));
   $s->j_cast(javaString())->j_invoke('startsWith', [$p->j_cast(javaString())], javaBoolean());
}

function <<access.private>> meta::external::language::java::translation::endsWithCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'endsWithCoder expects exactly 2 arguments');
