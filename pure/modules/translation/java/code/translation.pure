function <<access.private>> platform::extensions::language::java::translation::matchesCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   assert($fe.parametersValues->size() == 2, | 'matchesCoder expects exactly 2 arguments');
   let s = $conv->translateExpression($fe.parametersValues->at(0));
