function <<access.private>> meta::external::language::java::translation::dayOfMonthCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'dayOfMonth', 'dayOfMonthCoder');
}

function <<access.private>> meta::external::language::java::translation::hourCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'hour', 'hourCoder');
}

function <<access.private>> meta::external::language::java::translation::minuteCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'minute', 'minuteCoder');
}

function <<access.private>> meta::external::language::java::translation::secondCoder(fe: FunctionExpression[1], conv: Conventions[1]): Code[1]
{
   $conv->dateExtractor($fe, 'second', 'secondCoder');
