   $conv->asBigDecimal($fe.parametersValues->at(0))->j_invoke($method, [$conv->asBigDecimal($fe.parametersValues->at(1))], javaBigDecimal());
}

// A number as a BigDecimal, through its decimal text (exact for Long, Double's
// shortest repr, and BigDecimal itself).
function <<access.private>> platform::extensions::language::java::translation::asBigDecimal(conv: Conventions[1], vs: ValueSpecification[1]): Code[1]
{
