function <<access.private>> platform::extensions::language::java::translation::primitiveInfix(
   conv: Conventions[1],
   fe: FunctionExpression[1],
   factory: Function<{Code[1], Code[1] -> Code[1]}>[1]
): Code[1]
{
   let left  = $conv->translateExpression($fe.parametersValues->at(0));
   let right = $conv->translateExpression($fe.parametersValues->at(1));
   // When an operand is Object-typed (came through fold's β-substituted
   // reducer or similar), cast to the FE's expected result type so the
   // infix factory doesn't emit {@code Object + Object}. Typed operands
   // (the common case) pass through unchanged.
   let resultTypeOpt = $fe.genericType->rawType();
