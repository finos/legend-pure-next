      $conv->translateAsList($fe.parametersValues->at(0)),
      javaList(),
      javaList(),
      [j_return(j_code('pureIifeIn.isEmpty() ? new java.util.ArrayList() : new java.util.ArrayList(pureIifeIn.subList(1, pureIifeIn.size()))', javaList()))]);
