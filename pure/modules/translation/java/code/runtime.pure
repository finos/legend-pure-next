import meta::external::language::java::*;
import meta::external::language::java::serialization::*;
import meta::external::language::java::translation::*;

// JVM-runtime bridge for the Pure->Java translator: `translation.pure`
// produces a Java metamodel Class; this file serialises that to source,
// hands it to `compileAndExecute` (the in-process javac + reflective-invoke
// native declared in language/java/code/native.pure), and surfaces the
// result so round-trip / PCT tests can assert that the translated Java
// *computes* the same answer as the source Pure, not merely that it
// serialises to a particular string.

// Translate a Pure function, then compile+execute the resulting Java with
// the supplied arguments.
function meta::external::language::java::translation::runViaTranslation(
   conv: Conventions[1],
   f: meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>[1],
   args: Any[*]
): Any[*]
{
   let sig       = $conv->translateFunction($f);
   let source    = $sig.class->classToString();
   let className = $sig.class->qualifiedClassName();
   compileAndExecute($source, $className, $sig.method.name, $args);
}

// PCT adapter — pluggable into any `<<PCT.test>>`. Takes the test's
// no-arg lambda, translates it to a Java class, compiles + executes it,
// and returns the result for the test's `assertEquals(..., $f->eval(|expr))`.
function meta::external::language::java::translation::testAdapterForTranslatedJava<X|o>(
   f: meta::pure::metamodel::function::Function<{->X[o]}>[1]
): X[o]
{
   let conv      = defaultConventions('org.finos.test');
   let lambda    = $f->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>);
   let sig       = $conv->translateLambda($lambda, 'PCTRunner');
   let source    = $sig.class->classToString();
   let className = $sig.class->qualifiedClassName();
   compileAndExecute($source, $className, $sig.method.name, []);
}

// Convenience: run every `<<PCT.test>>` under `rootPackagePath` through the
// translator adapter — each PCT lambda gets compiled to Java, javac'd
// in-process, reflectively invoked, and the result fed back to the PCT
// test's assertion. Delegates to the core `runPCTTests(pkg, adapter)`
// overload with our adapter baked in. Marked `<<test.TestDependency>>`
// because the core runner has that stereotype (PCT runners go in -tests.pdb).
function <<test.TestDependency>>
   meta::external::language::java::translation::runPCTTestsViaTranslator(rootPackagePath:String[1]):String[1]
{
   meta::pure::test::runPCTTests(
      $rootPackagePath,
      testAdapterForTranslatedJava_Function_1__X_o_
   );
}
