import platform::extensions::language::java::factory::*;
import platform::extensions::language::java::serialization::*;
import platform::extensions::language::java::translation::*;
import platform::extensions::language::java::translation::platform::*;
import platform::pure::metamodel::function::property::*;
import platform::pure::metamodel::type::*;

// ============================================================================
// Java platform: the Java types for Pure classes and enumerations.
//
// Pure has multiple inheritance (Class alone generalizes Testable,
// TypeAndMultiplicityParametersOwner, NamedType, PropertyOwner and
// ElementWithConstraints), so every Pure class becomes a Java INTERFACE that
// extends the interfaces of its generalizations and declares one getter per
// property; the implementations (PDB-backed, lazy) are generated separately.
// Enumerations become Java enums. Java packages mirror Pure packages under
// `javaRoot`, with Java keywords mangled (`function` → `function_`).
//
// `generatePlatformTypes` returns every file's source, each preceded by a
// `//// FILE <path relative to the source root>` line, which the platform's
// build splits into a source tree.
// ============================================================================

function <<test.TestDependency>> platform::extensions::language::java::translation::platform::generatePlatformTypes(rootPackagePaths: String[1], javaRoot: String[1]): String[1]
{
   platform::extensions::language::java::translation::platform::generatePlatformTypesFor($rootPackagePaths, $javaRoot,
      platform::extensions::language::java::translation::defaultPlatformPackage());
}

// The platform TYPES the test wrappers need.
//
// The ordinary walk skips `tests`, and `withReferencedTypes` only chases what
// the NON-test generated code names — so a type named solely by a test
// signature (FuncColSpec, AggColSpec: declared in
// platform::pure::metamodel::relation but stored with the functions, which is why
// the package walk misses them) never gets emitted. Feed the same generator the
// tests-including walk and it finds them.
function <<test.TestDependency>> platform::extensions::language::java::translation::platform::generatePlatformTypesWithTests(rootPackagePaths: String[1], javaRoot: String[1]): String[1]
{
   let elements = $rootPackagePaths->split(',')->map(p | $p->pathToElement()->cast(@platform::pure::metamodel::Package)
                     ->platform::extensions::language::java::translation::translatableElementsWithTests());
   let conv     = ^(platform::extensions::language::java::translation::conventionsFor($javaRoot, platform::extensions::language::java::translation::defaultPlatformPackage()))(metadataElements = true);
   // Also the types the FUNCTION SIGNATURES name. AggColSpec / FuncColSpec are
   // declared in platform::pure::metamodel::relation but stored with the functions,
   // so no package walk reaches them and nothing else names them — only
   // `aggColSpec(...): AggColSpec[1]` does.
   let udfs     = $elements->filter(e | $e->instanceOf(UserDefinedFunction))->cast(@UserDefinedFunction<Any>);
   let sigTypes = $udfs->map(u | $u.parameters->map(p | $p.genericType)->concatenate($u.returnGenericType))
                       ->map(gt | $gt->rawType())
                       ->filter(t | $t->instanceOf(Type))->cast(@Type);
   let types    = $elements->filter(e | $e->instanceOf(Type))->cast(@Type)->concatenate($sigTypes)->withReferencedTypes();
   let classes  = $types->filter(e | $e->instanceOf(Class) && !$e->instanceOf(Enumeration))->cast(@Class<Any>);
   let enums    = $types->filter(e | $e->instanceOf(Enumeration))->cast(@Enumeration<Any>);
   $classes->map(c | $c->platformFile($javaRoot, $conv->platformInterface($c, $javaRoot)))
      ->concatenate($classes->map(c | '//// FILE ' + ($c->platformTypeName($javaRoot) + 'Impl')->replace('.', '/') + '.java\n' + $conv->platformImplementation($c, $javaRoot)->platform::extensions::language::java::serialization::classToStringWithPositions()))
      ->concatenate($enums->map(e | $e->platformFile($javaRoot, $e->platformEnum($javaRoot, $conv))))
      ->joinStrings('\n')
      ->platform::extensions::language::java::translation::withPositionTable();
}

// The same generation, emitted for a NAMED host — see translatePackagesToJavaFor.
function <<test.TestDependency>> platform::extensions::language::java::translation::platform::generatePlatformTypesFor(rootPackagePaths: String[1], javaRoot: String[1], platformPackage: String[1]): String[1]
{
   platform::extensions::language::java::translation::platform::generatePlatformTypesForHost($rootPackagePaths, $javaRoot, $platformPackage, platform::extensions::language::java::translation::defaultPdbPackage($platformPackage), platform::extensions::language::java::translation::defaultRuntimePackage($platformPackage));
}

// The same, for a host that keeps its support classes in ONE package: `hooksPackage` is
// where the generated types look for both the metadata hooks and the runtime helpers.
function <<test.TestDependency>> platform::extensions::language::java::translation::platform::generatePlatformTypesFor(rootPackagePaths: String[1], javaRoot: String[1], platformPackage: String[1], hooksPackage: String[1]): String[1]
{
   platform::extensions::language::java::translation::platform::generatePlatformTypesForHost($rootPackagePaths, $javaRoot, $platformPackage, $hooksPackage, $hooksPackage);
}

// A language extension's table -> implementation factory, over the classes of its metamodel package
// — the tables its generated PDB schema fragment declares (pdb/fbsgen). The runtime asks it after
// PdbTypes for a table m3 does not have, so a PDB holding ###Diagram elements decodes to DiagramImpl
// & co. rather than UntypedObject. Only the metamodel package: the protocol package has classes with
// the same simple names (`Diagram`), and a PDB names its tables by simple name.
function <<test.TestDependency>> platform::extensions::language::java::translation::platform::generateExtensionTypeFactory(packagePath: String[1], javaRoot: String[1], factoryName: String[1]): String[1]
{
   let pkg     = platform::extensions::language::java::translation::defaultPlatformPackage();
   let conv    = ^(platform::extensions::language::java::translation::conventionsFor($javaRoot, $pkg))(metadataElements = true,
                    pdbPackage = platform::extensions::language::java::translation::defaultPdbPackage($pkg),
                    runtimePkg = platform::extensions::language::java::translation::defaultRuntimePackage($pkg));
   let classes = $packagePath->pathToElement()->cast(@platform::pure::metamodel::Package)->translatableElements()
      ->filter(e | $e->instanceOf(Class) && !$e->instanceOf(Enumeration))->cast(@Class<Any>);
   '//// FILE ' + $factoryName->replace('.', '/') + '.java\n'
      + $classes->platform::extensions::language::java::translation::platform::platformTypeFactory($javaRoot, $conv, $factoryName)
           ->platform::extensions::language::java::serialization::classToStringWithPositions();
}

// The two support packages, separately — see translatePackagesToJavaForHost.
function <<test.TestDependency>> platform::extensions::language::java::translation::platform::generatePlatformTypesForHost(rootPackagePaths: String[1], javaRoot: String[1], platformPackage: String[1], hooksPackage: String[1], runtimePackage: String[1]): String[1]
{
   let elements = $rootPackagePaths->split(',')->map(p | $p->pathToElement()->cast(@platform::pure::metamodel::Package)->translatableElements());
   // A package walk misses types stored in another archive than their package
   // (platform::pure::metamodel::relation::ColSpec is defined with the functions),
   // so generate what the generated types name, too.
   let conv     = ^(platform::extensions::language::java::translation::conventionsFor($javaRoot, $platformPackage))(metadataElements = true, pdbPackage = $hooksPackage, runtimePkg = $runtimePackage);
   let types    = $elements->filter(e | $e->instanceOf(Type))->cast(@Type)->withReferencedTypes();
   let classes  = $types->filter(e | $e->instanceOf(Class) && !$e->instanceOf(Enumeration))->cast(@Class<Any>);
   let enums    = $types->filter(e | $e->instanceOf(Enumeration))->cast(@Enumeration<Any>);
   let factory  = javaClass(['public', 'final'], $javaRoot + '.PdbTypes');
   $classes->map(c | $c->platformFile($javaRoot, $conv->platformInterface($c, $javaRoot)))
      ->concatenate($classes->map(c | '//// FILE ' + ($c->platformTypeName($javaRoot) + 'Impl')->replace('.', '/') + '.java\n' + $conv->platformImplementation($c, $javaRoot)->platform::extensions::language::java::serialization::classToStringWithPositions()))
      ->concatenate($enums->map(e | $e->platformFile($javaRoot, $e->platformEnum($javaRoot, $conv))))
      ->concatenate('//// FILE ' + ($javaRoot + '.PdbTypes')->replace('.', '/') + '.java\n' + $classes->platform::extensions::language::java::translation::platform::platformTypeFactory($javaRoot, $conv)->platform::extensions::language::java::serialization::classToStringWithPositions())
      ->joinStrings('\n')
      ->platform::extensions::language::java::translation::withPositionTable();
}

// A generated type's source, preceded by its `//// FILE <path>` line.
function platform::extensions::language::java::translation::platform::platformFile(element: platform::pure::metamodel::PackageableElement[1], javaRoot: String[1], type: platform::extensions::language::java::metamodel::Class[1]): String[1]
{
   '//// FILE ' + $element->platformTypeName($javaRoot)->replace('.', '/') + '.java\n' + $type->platform::extensions::language::java::serialization::classToStringWithPositions();
}

// The Java package root of the platform's types.
function platform::extensions::language::java::translation::platform::platformRoot(): String[1]
{
   'org.finos.legend.pure.m3'
}

// True for the types the platform prebuilds (`just java::generate-types`): the
// metamodel's and the core library's, test models excepted.
function platform::extensions::language::java::translation::platform::isPrebuiltType(path: String[1]): Boolean[1]
{
   $path->startsWith('platform::pure::metamodel::') || ($path->startsWith('platform::pure::functions::') && !$path->contains('::tests::'));
}

// The Java package of a Pure element: `javaRoot` + its Pure package, keywords mangled.
function platform::extensions::language::java::translation::platform::platformPackage(element: platform::pure::metamodel::PackageableElement[1], javaRoot: String[1]): String[1]
{
   let segments = $element->elementToPath()->split('::');
   $javaRoot->concatenate($segments->slice(0, $segments->size() - 1)->map(s | $s->safeJavaName()))->joinStrings('.');
}

function platform::extensions::language::java::translation::platform::platformTypeName(element: platform::pure::metamodel::PackageableElement[1], javaRoot: String[1]): String[1]
{
   $element->platformPackage($javaRoot) + '.' + $element.name->toOne();
}

// The Java type of a property value: a boxed primitive, the platform interface
// or enum of a class or enumeration (every one has one: a translation generates
// the types its types name, see {@link withReferencedTypes}), Object for anything
// else (type parameters included); a List of it when many-valued.
function platform::extensions::language::java::translation::platform::platformValueType(g: platform::pure::metamodel::type::generics::GenericType[1], m: platform::pure::metamodel::multiplicity::Multiplicity[1], javaRoot: String[1]): platform::extensions::language::java::metamodel::Type[1]
{
   let raw   = $g->rawType();
   let path  = $raw->filter(t | $t->instanceOf(platform::pure::metamodel::PackageableElement))->map(t | $t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath());
   // The classes with a Java representation of their own, as pureTypeToJavaType
   // maps them: a Pure Map is a java.util.Map, a Pair a Map.Entry (PairImpl is
   // one too), so a property typed by them fits the values translated code builds.
   let one   = if ($raw == [platform::pure::functions::collection::Map],  | javaClass('java.util.Map'),
               |if ($raw == [platform::pure::functions::collection::Pair], | javaClass('java.util.Map.Entry'),
               |if ($raw == [String],  | javaString(),
               |if ($raw == [Integer], | javaClass('java.lang.Long'),
               |if ($raw == [Float],   | javaClass('java.lang.Double'),
               |if ($raw == [Boolean], | javaClass('java.lang.Boolean'),
               |if ($raw == [platform::pure::metamodel::type::primitives::Decimal], | javaClass('java.math.BigDecimal'),
               |if ($raw == [Number],  | javaClass('java.lang.Number'),
               // Only classes and enumerations have platform types; Any, an opaque host type and the
               // other primitives (the dates, ...) are Object.
               |if ($path->isNotEmpty() && !$raw->isTopType() && !$raw->isOpaqueHostType()
                   && ($raw->toOne()->instanceOf(Class) || $raw->toOne()->instanceOf(Enumeration)), | javaClass($raw->toOne()->cast(@platform::pure::metamodel::PackageableElement)->platformTypeName($javaRoot)),
                                       | javaObject())))))))));
   if ($m->holdsManyValues() || !$m->instanceOf(platform::pure::metamodel::multiplicity::ConcreteMultiplicity),
      | javaParameterizedType(javaClass('java.util.List'), [$one]),
      | $one);
}

// A Pure class whose instances are HOST objects rather than translated values. An AntlrContext is a
// parse-tree node of whichever parser the platform generated, so it has no platform interface: it must
// be read as Object, for the same reason a top type must.
//
// SHARED WITH pureTypeToJavaTypeResolved, which maps the same type to Object, because the two
// disagreeing is the bug this exists to prevent. A parameter typed AntlrContext was already Object,
// while a PROPERTY typed AntlrContext got a typed getter — so the diagram extension's
// `value : AntlrContext[1]` generated `(AntlrContext) one("value")` and failed with a
// ClassCastException on a real ANTLR context, on the only host where a property holds one.
function platform::extensions::language::java::translation::platform::isOpaqueHostType(raw: platform::pure::metamodel::type::Type[*]): Boolean[1]
{
   $raw == [platform::pure::functions::meta::antlr::AntlrContext];
}

// The top type of a hierarchy — the metamodel's Any, and the protocol grammar's
// own Any, which every protocol class extends. A property typed by one holds
// ANY value, a literal included (an AtomicValue's `value` is a Long or a
// String), so it is read as Object: a typed getter would cast and fail.
function platform::extensions::language::java::translation::platform::isTopType(raw: platform::pure::metamodel::type::Type[*]): Boolean[1]
{
   $raw == [Any]
      || ($raw->size() == 1
          && $raw->toOne()->instanceOf(platform::pure::metamodel::PackageableElement)
          && $raw->toOne()->cast(@platform::pure::metamodel::PackageableElement).name == ['Any']);
}

// A getter name for a property: the property name, `_`-suffixed when it is a
// Java keyword or the name of a java.lang.Object method.
function platform::extensions::language::java::translation::platform::getterName(propertyName: String[1]): String[1]
{
   if (['getClass', 'hashCode', 'equals', 'toString', 'notify', 'notifyAll', 'wait', 'clone', 'finalize']->contains($propertyName),
      | $propertyName + '_',
      | $propertyName->safeJavaName());
}

function platform::extensions::language::java::translation::platform::platformInterface(conv: platform::extensions::language::java::translation::Conventions[1], cls: Class<Any>[1], javaRoot: String[1]): platform::extensions::language::java::metamodel::Class[1]
{
   let supers  = $cls.generalizations->map(g | $g.general->rawType())
                    ->filter(t | $t->instanceOf(Class) && $t->instanceOf(platform::pure::metamodel::PackageableElement))
                    ->cast(@platform::pure::metamodel::PackageableElement);
   let base    = javaClass(['public', 'interface'], $cls->platformTypeName($javaRoot))
                    ->javaDoc('Pure class ' + $cls->elementToPath() + '. Generated.');
   let withSup = $supers->fold({s, i | $i->jextends(javaClass($s->platformTypeName($javaRoot)))}, $base);
   // Every Pure value can name its class: declared on Any, which all interfaces extend.
   let withPath = if ($cls == Any, | $withSup->addMethod(javaMethod([], javaString(), '_purePath', [])), | $withSup);
   let self     = javaClass($cls->platformTypeName($javaRoot));
   let getters  = $cls.properties->concatenate($cls.propertiesFromAssociations)->fold({p, i |
      $i->addMethod(javaMethod([], $p.genericType->platformValueType($p.multiplicity, $javaRoot), $p.name->toOne()->getterName(), []))
   }, $withPath);
   // Setters and _copy() for every property of the class, inherited ones
   // included, returning this interface: `copy`/`new` chains then type on any
   // subtype, and each implementation overrides them covariantly.
   let withQps = $conv->platform::extensions::language::java::translation::platformQualifiedPropertyMethods($cls, $javaRoot, false)->fold({m, i | $i->addMethod($m)}, $getters);
   $cls->allPlatformProperties()->fold({p, i |
      $i->addMethod(javaMethod([], $self, '_' + $p.name->toOne(), [j_parameter(javaObject(), 'value')]))
        ->addMethod(javaMethod([], $self, '_' + $p.name->toOne() + '_add', [j_parameter(javaObject(), 'value')]))
   }, $withQps->addMethod(javaMethod([], $self, '_copy', []))
              ->withFinishDeclaration($cls, $self));
}

// `_pureFinish()` declared on the interface of a class with association
// properties, so a copy chain typed by the interface can call it.
function platform::extensions::language::java::translation::platform::withFinishDeclaration(i: platform::extensions::language::java::metamodel::Class[1], cls: Class<Any>[1], self: platform::extensions::language::java::metamodel::Type[1]): platform::extensions::language::java::metamodel::Class[1]
{
   if ($cls->generalizationClosure()->exists(c | $c.propertiesFromAssociations->isNotEmpty()),
      | $i->addMethod(javaMethod([], $self, '_pureFinish', [])),
      | $i);
}

// Map.Entry over `first`/`second`, on the implementation of Pure's Pair.
function platform::extensions::language::java::translation::platform::withMapEntry(impl: platform::extensions::language::java::metamodel::Class[1], cls: Class<Any>[1]): platform::extensions::language::java::metamodel::Class[1]
{
   if ($cls != platform::pure::functions::collection::Pair,
      | $impl,
      | $impl->addMethod(javaMethod(['public'], javaObject(), 'getKey', [], j_return(j_this($impl)->j_invoke('first', [], javaObject()))))
             ->addMethod(javaMethod(['public'], javaObject(), 'getValue', [], j_return(j_this($impl)->j_invoke('second', [], javaObject()))))
             ->addMethod(javaMethod(['public'], javaObject(), 'setValue', [j_parameter(javaObject(), 'value')],
                  j_throw(j_new(javaClass('java.lang.UnsupportedOperationException'), [j_string('A Pure Pair is immutable')])))));
}

// Every qualified property of `cls` and of its generalizations, each name once.
function platform::extensions::language::java::translation::platform::allPlatformQualifiedProperties(cls: Class<Any>[1]): platform::pure::metamodel::function::property::QualifiedProperty<Any>[*]
{
   $cls->generalizationClosure()->map(c | $c.qualifiedProperties->concatenate($c.qualifiedPropertiesFromAssociations))
      ->removeDuplicatesBy(qp | $qp->qualifiedPropertyName() + '/' + $qp.parameters->size()->toString());
}

// The method name of a qualified property: its name without the signature
// (`inParameters()` is stored with its parentheses).
function platform::extensions::language::java::translation::platform::qualifiedPropertyName(qp: platform::pure::metamodel::function::property::QualifiedProperty<Any>[1]): String[1]
{
   $qp.name->toOne('qualifiedPropertyName: qualified property without a name')->split('(')->at(0);
}

// Every property of `cls` and of all its generalizations (transitively), the
// class's own first, each name once — what an implementation must provide.
function platform::extensions::language::java::translation::platform::allPlatformProperties(cls: Class<Any>[1]): AbstractProperty<Any>[*]
{
   $cls->generalizationClosure()->map(c | $c.properties->concatenate($c.propertiesFromAssociations))->removeDuplicatesBy(p | $p.name->toOne());
}

// `types` and every class or enumeration their Java types name (generalizations
// and property types), transitively.
function platform::extensions::language::java::translation::platform::withReferencedTypes(types: Type[*]): Type[*]
{
   $types->withReferencedTypes(false);
}

// The same, not looking into the types the platform prebuilds when
// `stopAtPrebuilt` (what they name is prebuilt too).
function platform::extensions::language::java::translation::platform::withReferencedTypes(types: Type[*], stopAtPrebuilt: Boolean[1]): Type[*]
{
   // Only a packageable type has a path and a platform type: a TypeParameter
   // reaches here through a property's generic type and belongs to no package.
   let named    = $types->filter(t | $t->instanceOf(platform::pure::metamodel::PackageableElement));
   let distinct = $named->removeDuplicatesBy(t | $t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath());
   let expanded = $distinct->filter(t | $t->instanceOf(Class) && !($stopAtPrebuilt && $t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath()->isPrebuiltType()));
   let next = $distinct
      ->concatenate($expanded->cast(@Class<Any>)->map(c | $c->directlyReferencedTypes()))
      ->filter(t | $t->instanceOf(platform::pure::metamodel::PackageableElement))
      ->removeDuplicatesBy(t | $t->cast(@platform::pure::metamodel::PackageableElement)->elementToPath());
   if ($next->size() == $distinct->size(), | $distinct, | $next->withReferencedTypes($stopAtPrebuilt));
}

function platform::extensions::language::java::translation::platform::directlyReferencedTypes(cls: Class<Any>[1]): Type[*]
{
   $cls.generalizations->map(g | $g.general->rawType())
      ->concatenate($cls.properties->concatenate($cls.propertiesFromAssociations)->map(p | $p.genericType->rawType()))
      ->filter(t | ($t->instanceOf(Class) || $t->instanceOf(Enumeration)) && $t->instanceOf(platform::pure::metamodel::PackageableElement));
}

// `cls` followed by its generalizations, breadth first, each once.
function platform::extensions::language::java::translation::platform::generalizationClosure(cls: Class<Any>[1]): Class<Any>[*]
{
   let direct = $cls.generalizations->map(g | $g.general->rawType())->filter(t | $t->instanceOf(Class))->cast(@Class<Any>);
   $cls->concatenate($direct->map(d | $d->generalizationClosure()))->removeDuplicatesBy(c | $c->elementToPath());
}

// The implementation of a class's interface, for PDB-read and run-time-built
// instances alike (see the platform runtime's LazyObject). Each getter returns
// the property's values — decoded lazily from the element's FlatBuffer, or as
// set: a single value cast, an enumeration value mapped by name, a many-valued
// property as a List. `_p(v)` sets a property and `_p_add(v)` appends to it,
// both returning the object for chaining (`new XImpl()._a(1)._b(2)`), and
// `_copy()` makes a shallow copy that keeps a PDB backing.
function platform::extensions::language::java::translation::platform::platformImplementation(conv: platform::extensions::language::java::translation::Conventions[1], cls: Class<Any>[1], javaRoot: String[1]): platform::extensions::language::java::metamodel::Class[1]
{
   // A Pure Pair is a Map.Entry in translated code (pairCoder): ^Pair(...) builds
   // a PairImpl, which is one too, so both fit a Pair-typed property.
   let entry = if ($cls == platform::pure::functions::collection::Pair, | [javaClass('java.util.Map.Entry')], | []->cast(@platform::extensions::language::java::metamodel::Type));
   let base = $entry->fold({e, c | $c->implements($e)},
                 javaClass(['public', 'final'], $cls->platformTypeName($javaRoot) + 'Impl')
                 ->jextends(javaClass($conv->platform::extensions::language::java::translation::pdbClass('LazyObject')))
                 ->implements(javaClass($cls->platformTypeName($javaRoot))))
                 ->javaDoc('PDB-backed implementation of Pure class ' + $cls->elementToPath() + '. Generated.')
                 ->addMethod(javaMethod(['public'], javaString(), '_purePath', [], j_return(j_string($cls->elementToPath()))))
                 ->withMapEntry($cls);
   $cls->allPlatformProperties()->fold({p, c |
      let type = $p.genericType->platformValueType($p.multiplicity, $javaRoot);
      let raw  = $p.genericType->rawType();
      let name = $p.name->toOne();
      let implType = javaClass($cls->platformTypeName($javaRoot) + 'Impl');
      let self = j_this($implType);
      let value = j_variable(javaObject(), 'v');
      let body = if ($type->typeToString()->startsWith('java.util.List'), | j_return($self->j_invoke('many', [j_string($name)], $type)),
                 |if ($raw->isNotEmpty() && $raw->toOne()->instanceOf(Enumeration) && $type != javaObject(),
                    // Read from a PDB an enum value is its name; set at run time, the constant.
                    | [j_declare(javaObject(), 'v', $self->j_invoke('one', [j_string($name)], javaObject())),
                       j_return(j_conditional(j_or(j_eq($value, j_null()), j_instanceof($value, $type)),
                                              $value->j_castWithoutChecks($type),
                                              j_invoke($type, 'valueOf', [$value->j_castWithoutChecks(javaString())], $type)))],
                    | j_return($self->j_invoke('one', [j_string($name)], javaObject())->j_castWithoutChecks($type))));
      // A pointer stands in for an element it has not been resolved to, so a
      // read of a slot it only inherits is a caller that skipped resolution:
      // guard it here, in the 28 pointer impls, rather than in LazyObject's
      // one()/many() where all ~4000 classes would pay for it. LazyObject holds
      // the list of slots a pointer does answer for itself.
      let guarded = if ($cls->elementToPath()->startsWith('platform::pure::metamodel::pointer::'),
                       | j_expressionStatement($self->j_invoke('checkPointerAccess', [j_string($name)], javaVoid()))->concatenate($body),
                       | $body);
      $c->addMethod(javaMethod(['public'], $type, $name->getterName(), [], $guarded))
        ->addMethod(javaMethod(['public'], $implType, '_' + $name, [j_parameter(javaObject(), 'value')],
             [j_expressionStatement($self->j_invoke('set', [j_string($name), j_variable(javaObject(), 'value')], javaVoid())), j_return($self)]))
        ->addMethod(javaMethod(['public'], $implType, '_' + $name + '_add', [j_parameter(javaObject(), 'value')],
             [j_expressionStatement($self->j_invoke('add', [j_string($name), j_variable(javaObject(), 'value')], javaVoid())), j_return($self)]));
   }, $conv->platform::extensions::language::java::translation::platformQualifiedPropertyMethods($cls, $javaRoot, true)->fold({m, c | $c->addMethod($m)},
         $base->addMethod(javaMethod(['public'], javaClass($cls->platformTypeName($javaRoot) + 'Impl'), '_copy', [],
            j_return(j_this(javaClass($cls->platformTypeName($javaRoot) + 'Impl'))->j_invoke('copyInto', [j_new(javaClass($cls->platformTypeName($javaRoot) + 'Impl'), [])], javaClass($cls->platformTypeName($javaRoot) + 'Impl')))))))
      ->withAssociationFinish($cls, $javaRoot, $conv)
      ->platform::extensions::language::java::translation::platform::withKeyEquality($cls, $conv)
      ->withPureToString($cls);
}

// `_pureFinish()` on a class with association properties (its own or inherited):
// every association value must have been instantiated within the enclosing
// new/copy expression, then each value's reverse end is set to this object
// (see the platform runtime's PureNew). Classes without associations get none.
function platform::extensions::language::java::translation::platform::withAssociationFinish(impl: platform::extensions::language::java::metamodel::Class[1], cls: Class<Any>[1], javaRoot: String[1], conv: platform::extensions::language::java::translation::Conventions[1]): platform::extensions::language::java::metamodel::Class[1]
{
   let props = $cls->generalizationClosure()->map(c | $c.propertiesFromAssociations)->removeDuplicatesBy(p | $p.name->toOne());
   if ($props->isEmpty(),
      | $impl,
      | let newType = $conv->platform::extensions::language::java::translation::pdbClass('PureNew');
        let self    = j_this(javaClass($cls->platformTypeName($javaRoot) + 'Impl'));
        let valuesOf = {name: String[1] | $self->j_invoke('__values', [j_string($name)], javaList())};
        let checks  = $props->map(p | j_expressionStatement(j_invoke(javaClass($newType), 'checkFresh', [$valuesOf->eval($p.name->toOne()), j_string($p.name->toOne()), j_string($cls->elementToPath())], javaVoid())));
        let links   = $props->map(p |
           $p.owner->cast(@platform::pure::metamodel::relationship::Association).properties->filter(q | $q.name != $p.name)
              ->map(r | j_expressionStatement(j_invoke(javaClass($newType), 'link', [$valuesOf->eval($p.name->toOne()), j_string($r.name->toOne()), if ($r.multiplicity->holdsManyValues(), | j_true(), | j_false()), $self], javaVoid()))));
        $impl->addMethod(javaMethod(['public'], javaClass($cls->platformTypeName($javaRoot) + 'Impl'), '_pureFinish', [],
           $checks->concatenate($links)->concatenate(j_return($self))));
   );
}

// equals/hashCode over the `<<equality.Key>>` properties (inherited ones
// included): instances of the same class with equal keys are equal, as `==`
// and contains() see them in Pure. Identity otherwise.
function platform::extensions::language::java::translation::platform::withKeyEquality(impl: platform::extensions::language::java::metamodel::Class[1], cls: Class<Any>[1], conv: platform::extensions::language::java::translation::Conventions[1]): platform::extensions::language::java::metamodel::Class[1]
{
   let keys = $cls->allPlatformProperties()
       ->filter(p | $p.stereotypes->exists(s |
              $s.profile->isNotEmpty()
              && $s.profile->toOne()->cast(@platform::pure::metamodel::PackageableElement)->elementToPath() == 'platform::pure::profiles::equality'
              && $s.value == ['Key']))
       ->map(p | $p.name->toOne());
   if ($keys->isEmpty(),
      | $impl,
      | let lazy   = javaClass($conv->platform::extensions::language::java::translation::pdbClass('LazyObject'));
        let self   = j_this($impl);
        let o      = j_variable(javaObject(), 'o');
        let other  = j_variable($lazy, 'other');
        let objects = javaClass('java.util.Objects');
        let keyEqs = $keys->map(k | j_invoke($objects, 'equals', [$self->j_invoke('__values', [j_string($k)], javaList()), $other->j_invoke('__values', [j_string($k)], javaList())], javaBoolean()));
        $impl->addMethod(javaMethod(['public'], javaBoolean(), 'equals', [j_parameter(javaObject(), 'o')],
           [j_if(j_eq($self, $o), j_return(j_true())),
            j_if(j_or(j_eq($o, j_null()), j_ne($o->j_invoke('getClass', [], javaClass('java.lang.Class')), $self->j_invoke('getClass', [], javaClass('java.lang.Class')))), j_return(j_false())),
            j_declare($lazy, 'other', $o->j_castWithoutChecks($lazy)),
            j_return($keyEqs->tail()->fold({e, a | j_and($a, $e)}, $keyEqs->at(0)))]))
             ->addMethod(javaMethod(['public'], javaInt(), 'hashCode', [],
           j_return(j_invoke($objects, 'hash', $keys->map(k | $self->j_invoke('__values', [j_string($k)], javaList())), javaInt()))));
   );
}

// Pure's toString for the collection classes: a List prints its values as
// `[a, b]`, a Pair as `<a, b>`.
function platform::extensions::language::java::translation::platform::withPureToString(impl: platform::extensions::language::java::metamodel::Class[1], cls: Class<Any>[1]): platform::extensions::language::java::metamodel::Class[1]
{
   let path = $cls->elementToPath();
   if ($path == 'platform::pure::functions::collection::List',
      | let builder = javaClass('java.lang.StringBuilder');
        let sb = j_variable($builder, 'sb');
        let vs = j_variable(javaList(javaObject()), 'vs');
        let i  = j_variable(javaInt(), 'i');
        $impl->addMethod(javaMethod(['public'], javaString(), 'toString', [],
           [j_declare($builder, 'sb', j_new($builder, [j_string('[')])),
            j_declare(javaList(javaObject()), 'vs', j_this($impl)->j_invoke('__values', [j_string('values')], javaList(javaObject()))),
            j_for($i->j_declare(j_int(0)), $i->j_lt($vs->j_invoke('size', [], javaInt())), $i->j_inc(),
                  [j_if(j_gt($i, j_int(0)), j_expressionStatement($sb->j_invoke('append', [j_string(', ')], $builder))),
                   j_expressionStatement($sb->j_invoke('append', [$vs->j_invoke('get', [$i], javaObject())], $builder))]),
            j_return($sb->j_invoke('append', [j_string(']')], $builder)->j_invoke('toString', [], javaString()))]));,
   |if ($path == 'platform::pure::functions::collection::Pair',
      | $impl->addMethod(javaMethod(['public'], javaString(), 'toString', [],
           j_return(j_string('<')->j_plus(j_this($impl)->j_invoke('one', [j_string('first')], javaObject()))->j_plus(j_string(', '))
                       ->j_plus(j_this($impl)->j_invoke('one', [j_string('second')], javaObject()))->j_plus(j_string('>'))))),
      | $impl));
}

// PdbTypes.create(table): a new implementation for a FlatBuffer table name
// (`<PureClassName>Def`), null for tables without one.
function platform::extensions::language::java::translation::platform::platformTypeFactory(classes: Class<Any>[*], javaRoot: String[1], conv: platform::extensions::language::java::translation::Conventions[1]): platform::extensions::language::java::metamodel::Class[1]
{
   // This maps a PDB TABLE to the implementation to build while decoding, so it
   // holds the types a PDB can store — the metamodel and the core library.
   // Everything else (the protocol grammar, a test's own classes) is built by
   // running code, never decoded, and a PDB names its tables by the class's
   // SIMPLE name: including those would collide `Any` with `Any` and
   // `PackageableElement` with `PackageableElement`.
   let storable = $classes->filter(c | $c->elementToPath()->isPrebuiltType());
   platform::extensions::language::java::translation::platform::platformTypeFactory($storable, $javaRoot, $conv, $javaRoot + '.PdbTypes');
}

// A table -> implementation factory named `factoryName` over exactly `storable`: m3's PdbTypes,
// or a language extension's (see generateExtensionTypeFactory).
function platform::extensions::language::java::translation::platform::platformTypeFactory(storable: Class<Any>[*], javaRoot: String[1], conv: platform::extensions::language::java::translation::Conventions[1], factoryName: String[1]): platform::extensions::language::java::metamodel::Class[1]
{
   let cases = $storable->map(c | pair(j_string($c.name->toOne() + 'Def'), j_return(j_new(javaClass($c->platformTypeName($javaRoot) + 'Impl'), []))));
   javaClass(['public', 'final'], $factoryName)
      ->javaDoc('FlatBuffer table name to generated implementation. Generated.')
      ->addMethod(javaMethod(['public', 'static'], javaClass($conv->platform::extensions::language::java::translation::pdbClass('LazyObject')), 'create', [j_parameter(javaString(), 'table')],
           j_switch(j_variable(javaString(), 'table'), $cases, j_return(j_null()))));
}

function platform::extensions::language::java::translation::platform::platformEnum(e: Enumeration<Any>[1], javaRoot: String[1], conv: platform::extensions::language::java::translation::Conventions[1]): platform::extensions::language::java::metamodel::Class[1]
{
   // PureEnumConstant: the constant IS a metamodel Enum (so a NamedElement, an AddressableElement, an
   // AnnotatedElement), answering its metamodel properties through the platform's metadata — its
   // enumeration is its classifier, and the PDB holds its annotations.
   javaEnum(['public'], $e->platformTypeName($javaRoot))
      ->addEntries($e->platform::pure::functions::meta::enumValues()->map(v | javaEnumEntry($v.name->toOne()->safeJavaName())))
      ->implements(javaClass($conv->platform::extensions::language::java::translation::pdbClass('PureEnumConstant')))
      ->addMethod(javaMethod(['public'], javaString(), '_purePath', [], j_return(j_string($e->elementToPath()))));
}
