import meta::external::language::java::serialization::*;
import meta::external::language::java::translation::*;
import meta::external::language::java::translation::tests::*;

// ----------------------------------------------------------------------------
// Pure functions under test. Each compiles to a UserDefinedFunction whose
// expressionSequence is the operator's FunctionExpression — that's what the
// translator must consume.
// ----------------------------------------------------------------------------

function meta::external::language::java::translation::tests::add(a: Integer[1], b: Integer[1]): Integer[1]
{
   $a + $b
}

function meta::external::language::java::translation::tests::sub(a: Integer[1], b: Integer[1]): Integer[1]
{
   $a - $b
}

function meta::external::language::java::translation::tests::mul(a: Integer[1], b: Integer[1]): Integer[1]
{
   $a * $b
}

function meta::external::language::java::translation::tests::div(a: Float[1], b: Float[1]): Float[1]
{
   $a / $b
}

function meta::external::language::java::translation::tests::neg(a: Integer[1]): Integer[1]
{
   -$a
}

// ----------------------------------------------------------------------------
// Translator tests: assert exact Java output for each arithmetic operator.
// ----------------------------------------------------------------------------

function <<access.private>> meta::external::language::java::translation::tests::translateAndStringify(f: meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>[1]): String[1]
{
   defaultConventions('org.finos.test')->translateFunction($f).class->classToString();
}

function <<test.Test>> meta::external::language::java::translation::tests::testTranslateAdd(): Boolean[1]
{
   let expected = '''
                  package org.finos.test;

                  public class Add
                  {
                      public static long execute(long a, long b)
                      {
                          return a + b;
                      }
                  }''';
   assertEquals($expected, translateAndStringify(add_Integer_1__Integer_1__Integer_1_));
}

function <<test.Test>> meta::external::language::java::translation::tests::testTranslateSub(): Boolean[1]
{
   let expected = '''
                  package org.finos.test;

                  public class Sub
                  {
                      public static long execute(long a, long b)
                      {
                          return a - b;
                      }
                  }''';
   assertEquals($expected, translateAndStringify(sub_Integer_1__Integer_1__Integer_1_));
}

function <<test.Test>> meta::external::language::java::translation::tests::testTranslateMul(): Boolean[1]
{
   let expected = '''
                  package org.finos.test;

                  public class Mul
                  {
                      public static long execute(long a, long b)
                      {
                          return a * b;
                      }
                  }''';
   assertEquals($expected, translateAndStringify(mul_Integer_1__Integer_1__Integer_1_));
}

function <<test.Test>> meta::external::language::java::translation::tests::testTranslateDiv(): Boolean[1]
{
   let expected = '''
                  package org.finos.test;

                  public class Div
                  {
                      public static double execute(double a, double b)
                      {
                          return a / b;
                      }
                  }''';
   assertEquals($expected, translateAndStringify(div_Float_1__Float_1__Float_1_));
}

function <<test.Test>> meta::external::language::java::translation::tests::testTranslateNeg(): Boolean[1]
{
   let expected = '''
                  package org.finos.test;

                  public class Neg
                  {
                      public static long execute(long a)
                      {
                          return -a;
                      }
                  }''';
   assertEquals($expected, translateAndStringify(neg_Integer_1__Integer_1_));
}
