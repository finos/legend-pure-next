import platform::extensions::language::java::serialization::*;
import platform::extensions::language::java::translation::*;
import platform::extensions::language::java::translation::tests::*;

// ----------------------------------------------------------------------------
// Pure functions under test. Each compiles to a UserDefinedFunction whose
// expressionSequence is the operator's FunctionExpression — that's what the
// translator must consume.
// ----------------------------------------------------------------------------

function platform::extensions::language::java::translation::tests::add(a: Integer[1], b: Integer[1]): Integer[1]
{
   $a + $b
}

function platform::extensions::language::java::translation::tests::sub(a: Integer[1], b: Integer[1]): Integer[1]
{
   $a - $b
}

function platform::extensions::language::java::translation::tests::mul(a: Integer[1], b: Integer[1]): Integer[1]
{
   $a * $b
}

function platform::extensions::language::java::translation::tests::div(a: Float[1], b: Float[1]): Float[1]
{
   $a / $b
}

function platform::extensions::language::java::translation::tests::neg(a: Integer[1]): Integer[1]
{
   -$a
}

// ----------------------------------------------------------------------------
// Translator tests: assert exact Java output for each arithmetic operator.
// ----------------------------------------------------------------------------

function <<access.private>> platform::extensions::language::java::translation::tests::translateAndStringify(f: platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[1]): String[1]
{
   defaultConventions('org.finos.test')->translateFunction($f).class->classToString();
}

// The function's class and every class and file it needs (one per user function it calls), as one string.
function <<access.private>> platform::extensions::language::java::translation::tests::translateAllAndStringify(f: platform::pure::metamodel::function::UserDefinedFunction<platform::pure::metamodel::type::Any>[1]): String[1]
{
   let signature = defaultConventions('org.finos.test')->translateFunction($f);
   $signature.class->concatenate($signature.extraClasses)->map(c | $c->classToString())->concatenate($signature.files)->joinStrings('\n');
}

function <<test.Test>> platform::extensions::language::java::translation::tests::testTranslateAdd(): Boolean[1]
{
   let expected = '''
                  package org.finos.test;

                  public class Add
                  {
                      public static long execute(long a, long b)
                      {
                          return a + b;
                      }
                  }''';
   assertEquals($expected, translateAndStringify(add_Integer_1__Integer_1__Integer_1_));
}

function <<test.Test>> platform::extensions::language::java::translation::tests::testTranslateSub(): Boolean[1]
{
   let expected = '''
                  package org.finos.test;

                  public class Sub
                  {
                      public static long execute(long a, long b)
                      {
                          return a - b;
                      }
                  }''';
   assertEquals($expected, translateAndStringify(sub_Integer_1__Integer_1__Integer_1_));
}

