import meta::external::language::java::translation::*;

// PCT tests for the Pure->Java translator. Each `<<test.Test>>` here just
// invokes an upstream `<<PCT.test>>` from the math/operation specs, passing
// our `testAdapterForTranslatedJava` adapter. That adapter translates the
// PCT lambda to Java, compiles it in-process, executes it via reflection,
// and returns the result. If the answer matches the PCT test's expected
// constant, the translator + emitted Java + the platform's plus/minus/etc.
// all agree with Pure semantics.

function <<test.Test>> meta::external::language::java::translation::tests::pct::testSimplePlus(): Boolean[1]
{
   meta::pure::functions::math::tests::plus::testSimplePlus(testAdapterForTranslatedJava_Function_1__X_o_);
}

function <<test.Test>> meta::external::language::java::translation::tests::pct::testComplexPlus(): Boolean[1]
{
   meta::pure::functions::math::tests::plus::testComplexPlus(testAdapterForTranslatedJava_Function_1__X_o_);
}

function <<test.Test>> meta::external::language::java::translation::tests::pct::testNegativePlus(): Boolean[1]
{
   meta::pure::functions::math::tests::plus::testNegativePlus(testAdapterForTranslatedJava_Function_1__X_o_);
}

function <<test.Test>> meta::external::language::java::translation::tests::pct::testPlusMany(): Boolean[1]
{
   meta::pure::functions::math::tests::plus::testPlusMany(testAdapterForTranslatedJava_Function_1__X_o_);
}
