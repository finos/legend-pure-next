# pure/modules/translation/java/Justfile — builds the Pure-to-Java translator
# into a single PDB.
#
# Direct invocation: just <recipe>     (from pure/modules/translation/java/)
#
# Inputs:  shared/core.pdb, pure/modules/language/java/build/java.pdb.
# Output:  build/java-translation.pdb
#
# The translator consumes the language/java metamodel + factories + serializer
# (pure/modules/language/java/build/java.pdb) and the Pure metamodel (shared/core.pdb), and emits Code
# AST nodes that the serializer turns back into Java source.

set quiet := true
set shell := ["bash", "-c"]

# Sibling modules consumed by `build-all` (relative paths from this Justfile).
# `build` itself only checks for the produced PDBs and fails loudly — these
# mods are used solely to make `build-all` self-sufficient.
mod _mod_language_java      "../../language/java/Justfile"
mod _mod_translation_shared "../shared/Justfile"

trn_root       := source_directory()
repo_root      := trn_root / ".." / ".." / ".." / ".."
shared_out     := repo_root / "shared"
# Module build outputs: each module writes its own pdbs (and gallery) into its build/.
language_java_out          := repo_root / "pure" / "modules" / "language" / "java" / "build"
translation_shared_out     := repo_root / "pure" / "modules" / "translation" / "shared" / "build"
translation_java_out       := repo_root / "pure" / "modules" / "translation" / "java" / "build"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"
test_results   := repo_root / "test-results"

verbose := ""
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

header := "h(){ s=\"[java-translation::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build java-translation.pdb.
default: build

# Requires shared/core.pdb and pure/modules/language/java/build/java.pdb.

# Compile pure/modules/translation/java -> build/java-translation.pdb.
build:
    @{{header}} 'build'
    @{{substep}} 'compile pure/modules/translation/java -> build/java-translation.pdb'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_java_out}}/java.pdb               || (echo "ERROR: missing {{language_java_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    mkdir -p {{translation_java_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_java_out}}/java.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{trn_root}} \
        --output-dir {{translation_java_out}} {{err_filter}}

# Still needs bootstrap PDBs (core.pdb / core-tests.pdb) — `build` checks for those and fails loudly.

# Build sibling-module deps (language_java, translation_shared) first, then this module.
build-all: _mod_language_java::build _mod_translation_shared::build build

# Compile via the Pure compiler running on Truffle.
build-truffle:
    @{{header}} 'build-truffle'
    @{{substep}} 'compile pure/modules/translation/java -> build/java-translation.pdb (Truffle)'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_java_out}}/java.pdb               || (echo "ERROR: missing {{language_java_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    test -f {{shared_out}}/compiler.pdb           || (echo "ERROR: missing {{shared_out}}/compiler.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    test -x {{pure_truffle}} || (echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" && exit 1)
    mkdir -p {{translation_java_out}}
    {{pure_truffle}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_java_out}}/java.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{trn_root}} \
        --output-dir {{translation_java_out}} {{err_filter}}

# Compile with tests split into build/java-translation-tests.pdb.
build-tests:
    @{{header}} 'build-tests'
    @{{substep}} 'compile pure/modules/translation/java -> build/java-translation.pdb + java-translation-tests.pdb'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_java_out}}/java.pdb               || (echo "ERROR: missing {{language_java_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    mkdir -p {{translation_java_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_java_out}}/java.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{trn_root}} \
        --output-dir {{translation_java_out}} \
        --tests split {{err_filter}}

# The translator's own <<test.Test>> suite and the PCT corpus BOTH run on the
# Java platform now (`just java::test-translation`, `just java::pct`) — this
# module no longer runs anything through Truffle, so nothing here reaches into
# platforms/java/build/classes via PURE_JAVA_PLATFORM_CLASSES.
#
# Default umbrella: delegate to the platform that owns these suites. Same
# cross-tree call the `gallery` recipe below makes.
test-all: build-tests
    @{{header}} 'test-all'
    @{{substep}} 'run the translator suites on the Java platform'
    cd {{repo_root}} && just java::test-translation

# Each `sample_*` UDF in code/gallery.pure is rendered as a side-by-side card
# (literal Pure snippet on the left, translateFunction + classToString Java
# on the right). Rendered by, and written into, platforms/java/build.
#
# pure-truffle prints the returned String to stdout verbatim (no `'...'`
# quoting wrapper, no `\n` escaping), so a plain redirect is enough.

# Build the Pure -> Java translation gallery as a self-contained HTML page.
# Rendered BY THE JAVA PLATFORM (platforms/java): the gallery shows the Java this
# platform generates, compiles and runs, and has no Truffle dependency.
gallery: build-tests
    @{{header}} 'gallery'
    @{{substep}} 'render Pure -> Java gallery on the Java platform'
    # No OUT override: the gallery is a report about the Java host, so it lands in that platform's
    # build/ with the other two.
    cd {{repo_root}} && just java::gallery "meta::pure::functions"

clean:
    @{{header}} 'clean'
    @{{substep}} 'remove build/java-translation.pdb + java-translation-tests.pdb'
    rm -f {{translation_java_out}}/java-translation.pdb {{translation_java_out}}/java-translation-tests.pdb
    # The gallery too: it is this module's output, and nothing else removes it —
    # which is how a gallery built against an older test corpus survived weeks of
    # rebuilds and kept showing stale counts on the dashboard.
    rm -f {{translation_java_out}}/java-translation-gallery.html   # legacy location, before the gallery moved to platforms/java
