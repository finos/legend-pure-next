# pure/modules/translation/java/Justfile — builds the Pure-to-Java translator
# into a single PDB.
#
# Direct invocation: just <recipe>     (from pure/modules/translation/java/)
#
# Inputs:  shared/core.pdb, shared/java.pdb.
# Output:  shared/java-translation.pdb
#
# The translator consumes the language/java metamodel + factories + serializer
# (shared/java.pdb) and the Pure metamodel (shared/core.pdb), and emits Code
# AST nodes that the serializer turns back into Java source.

set quiet := true
set shell := ["bash", "-c"]

trn_root       := source_directory()
repo_root      := trn_root / ".." / ".." / ".." / ".."
shared_out     := repo_root / "shared"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"

verbose := ""
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

banner := "printf '\\n══════════════════════════════════════════════════════════════════════════════════\\n  %-13s %s\\n══════════════════════════════════════════════════════════════════════════════════\\n'"

# Default: build java-translation.pdb.
default: build

# Compile pure/modules/translation/java -> shared/java-translation.pdb.
# Requires shared/core.pdb and shared/java.pdb.
build:
    @{{banner}} '[java-translation]' 'compile pure/modules/translation/java -> shared/java-translation.pdb'
    test -f {{shared_out}}/core.pdb || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/java.pdb || (echo "ERROR: missing {{shared_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/java.pdb \
        --source {{trn_root}} \
        --output-dir {{shared_out}} {{err_filter}}

# Compile via the Pure compiler running on Truffle.
build-truffle:
    @{{banner}} '[java-translation]' 'compile pure/modules/translation/java -> shared/java-translation.pdb (Truffle)'
    test -f {{shared_out}}/core.pdb || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/java.pdb || (echo "ERROR: missing {{shared_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    test -f {{shared_out}}/compiler.pdb || (echo "ERROR: missing {{shared_out}}/compiler.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -x {{pure_truffle}} || (echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" && exit 1)
    {{pure_truffle}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/java.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --source {{trn_root}} \
        --output-dir {{shared_out}} {{err_filter}}

# Compile with tests split into shared/java-translation-tests.pdb.
build-tests:
    @{{banner}} '[java-translation]' 'compile pure/modules/translation/java -> shared/java-translation.pdb + java-translation-tests.pdb'
    test -f {{shared_out}}/core.pdb || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/java.pdb || (echo "ERROR: missing {{shared_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/java.pdb \
        --source {{trn_root}} \
        --output-dir {{shared_out}} \
        --tests split {{err_filter}}

# Default umbrella: translator's own <<test.Test>> suite (the 14 cases under
# meta::external::language::java::translation::tests) plus the standard runtime
# suites over meta::pure::functions exercised through Truffle with the
# java-translation extension loaded.
test-all: test-translation test-pure-runtime

# Run the translator's own <<test.Test>> suite. Each case exercises some
# combination of translator AST shape, generated Java assertions, in-process
# javac round-trips, and per-PCT-test wrappers (code/tests/*).
test-translation: build-tests _check-runtime-pdbs
    @{{banner}} '[java-translation]' 'runTests meta::external::language::java::translation (Truffle)'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/java.pdb \
        --pdb {{shared_out}}/java-translation.pdb \
        --pdb {{shared_out}}/java-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1_" \
        --args "meta::external::language::java::translation" {{err_filter}}

# Run the standard Pure runtime test suites (runTests + PCT) over
# meta::pure::functions (which lives in core-tests) via Truffle. Mirrors the
# truffle Justfile recipe — same args, same backend — verifies that loading
# the translator extension doesn't break Truffle's interpretation of any
# stdlib spec test.
test-pure-runtime: test-pure-runtime-testFunctions test-pure-runtime-PCTs

test-pure-runtime-testFunctions: build-tests _check-runtime-pdbs
    @{{banner}} '[java-translation]' 'runTests meta::pure::functions (Truffle, extension loaded)'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/java.pdb \
        --pdb {{shared_out}}/java-translation.pdb \
        --pdb {{shared_out}}/java-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1_" \
        --args "meta::pure::functions" {{err_filter}}

test-pure-runtime-PCTs: build-tests _check-runtime-pdbs
    @{{banner}} '[java-translation]' 'runPCTTests meta::pure::functions (Truffle, translator adapter)'
    # Uses runPCTTestsViaTranslator (in code/runtime.pure) which delegates to
    # the core 2-arg `runPCTTests(pkg, adapter)` with our translator adapter
    # baked in. Each PCT lambda gets translated to Java, compiled via the
    # in-process javac (CompileAndExecuteNode), invoked reflectively, and
    # the result fed back to the PCT test's assertion. Tests that exercise
    # natives we don't yet have coders for fail loudly — that's the desired
    # signal of "what's left to translate."
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/java.pdb \
        --pdb {{shared_out}}/java-translation.pdb \
        --pdb {{shared_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::runPCTTestsViaTranslator_String_1__String_1_" \
        --args "meta::pure::functions" {{err_filter}}

# Internal: fail loudly if the PDBs the runtime recipes need aren't staged.
_check-runtime-pdbs:
    #!/usr/bin/env bash
    if [[ ! -f "{{shared_out}}/core-tests.pdb" ]]; then
        echo "ERROR: missing {{shared_out}}/core-tests.pdb (run \`just bootstrap::build\` first)" >&2
        exit 1
    fi
    if [[ ! -x "{{pure_truffle}}" ]]; then
        echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" >&2
        exit 1
    fi

# Remove shared/java-translation.pdb (and the tests PDB).
clean:
    @{{banner}} '[java-translation clean]' 'remove shared/java-translation.pdb + java-translation-tests.pdb'
    rm -f {{shared_out}}/java-translation.pdb {{shared_out}}/java-translation-tests.pdb
