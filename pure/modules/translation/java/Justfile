# pure/modules/translation/java/Justfile — builds the Pure-to-Java translator
# into a single PDB.
#
# Direct invocation: just <recipe>     (from pure/modules/translation/java/)
#
# Inputs:  shared/core.pdb, pure/modules/language/java/build/java.pdb.
# Output:  build/java-translation.pdb
#
# The translator consumes the language/java metamodel + factories + serializer
# (pure/modules/language/java/build/java.pdb) and the Pure metamodel (shared/core.pdb), and emits Code
# AST nodes that the serializer turns back into Java source.

set quiet := true
set shell := ["bash", "-c"]

# Sibling modules consumed by `build-all` (relative paths from this Justfile).
# `build` itself only checks for the produced PDBs and fails loudly — these
# mods are used solely to make `build-all` self-sufficient.
mod _mod_language_java      "../../language/java/Justfile"
mod _mod_translation_shared "../shared/Justfile"

trn_root       := source_directory()
repo_root      := trn_root / ".." / ".." / ".." / ".."
shared_out     := repo_root / "shared"
# Module build outputs: each module writes its own pdbs (and gallery) into its build/.
language_java_out          := repo_root / "pure" / "modules" / "language" / "java" / "build"
translation_shared_out     := repo_root / "pure" / "modules" / "translation" / "shared" / "build"
translation_java_out       := repo_root / "pure" / "modules" / "translation" / "java" / "build"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"
test_results   := repo_root / "test-results"

verbose := ""
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

header := "h(){ s=\"[java-translation::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build java-translation.pdb.
default: build

# Requires shared/core.pdb and pure/modules/language/java/build/java.pdb.

# Compile pure/modules/translation/java -> build/java-translation.pdb.
build:
    @{{header}} 'build'
    @{{substep}} 'compile pure/modules/translation/java -> build/java-translation.pdb'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_java_out}}/java.pdb               || (echo "ERROR: missing {{language_java_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    mkdir -p {{translation_java_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_java_out}}/java.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{trn_root}} \
        --output-dir {{translation_java_out}} {{err_filter}}

# Still needs bootstrap PDBs (core.pdb / core-tests.pdb) — `build` checks for those and fails loudly.

# Build sibling-module deps (language_java, translation_shared) first, then this module.
build-all: _mod_language_java::build _mod_translation_shared::build build

# Compile via the Pure compiler running on Truffle.
build-truffle:
    @{{header}} 'build-truffle'
    @{{substep}} 'compile pure/modules/translation/java -> build/java-translation.pdb (Truffle)'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_java_out}}/java.pdb               || (echo "ERROR: missing {{language_java_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    test -f {{shared_out}}/compiler.pdb           || (echo "ERROR: missing {{shared_out}}/compiler.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    test -x {{pure_truffle}} || (echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" && exit 1)
    mkdir -p {{translation_java_out}}
    {{pure_truffle}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_java_out}}/java.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{trn_root}} \
        --output-dir {{translation_java_out}} {{err_filter}}

# Compile with tests split into build/java-translation-tests.pdb.
build-tests:
    @{{header}} 'build-tests'
    @{{substep}} 'compile pure/modules/translation/java -> build/java-translation.pdb + java-translation-tests.pdb'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_java_out}}/java.pdb               || (echo "ERROR: missing {{language_java_out}}/java.pdb (run \`just language::java::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    mkdir -p {{translation_java_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_java_out}}/java.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{trn_root}} \
        --output-dir {{translation_java_out}} \
        --tests split {{err_filter}}

# Runs the translator's own <<test.Test>> suite (the 14 cases under
# meta::external::language::java::translation::tests) plus the standard runtime
# suites over meta::pure::functions exercised through Truffle with the
# java-translation extension loaded.

# Default umbrella: translator test suite + runtime suites (Truffle, extension loaded).
test-all: test-translation test-pure-runtime

# Each case exercises some combination of translator AST shape, generated Java
# assertions, in-process javac round-trips, and per-PCT-test wrappers (code/tests/*).

# Run the translator's own <<test.Test>> suite (meta::external::language::java::translation).
test-translation: build-tests _depCheck_runtime-pdbs
    @{{header}} 'test-translation'
    @{{substep}} 'runTests meta::external::language::java::translation (Truffle)'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::external::language::java::translation" "{{test_results}}/pure/translation-java/pure@cli-truffle.json" {{err_filter}}

# Mirrors the truffle Justfile recipe — same args, same backend — verifying
# that loading the translator extension doesn't break Truffle's interpretation
# of any stdlib spec test. meta::pure::functions lives in core-tests.

# Run the standard Pure runtime suites over meta::pure::functions via Truffle, plus the PCT
# tests through the translator adapter (their failures are reported without failing the build).
test-pure-runtime: test-pure-runtime-testFunctions test-pure-runtime-PCTs

# Run runTests over meta::pure::functions via Truffle, with the java-translation extension loaded.
test-pure-runtime-testFunctions: build-tests _depCheck_runtime-pdbs
    @{{header}} 'test-pure-runtime-testFunctions'
    @{{substep}} 'runTests meta::pure::functions (Truffle, extension loaded)'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/pure/translation-java-functions/pure@cli-truffle.json" {{err_filter}}

# Run PCT tests over meta::pure::functions via the translator adapter (lambdas -> Java -> javac -> invoke).
test-pure-runtime-PCTs: build-tests _depCheck_runtime-pdbs
    @{{header}} 'test-pure-runtime-PCTs'
    @{{substep}} 'runPCTTests meta::pure::functions (Truffle, translator adapter)'
    # Uses runPCTTestsViaTranslator (in code/runtime.pure) which delegates to
    # the core 2-arg `runPCTTests(pkg, adapter)` with our translator adapter
    # baked in. Each PCT lambda gets translated to Java, compiled via the
    # in-process javac (CompileAndExecuteNode), invoked reflectively, and
    # the result fed back to the PCT test's assertion. Tests that exercise
    # natives we don't yet have coders for fail loudly — that's the desired
    # signal of "what's left to translate."
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::runPCTTestsViaTranslator_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/spec/pct/java-translation@cli-truffle.json" {{err_filter}} || echo "  PCT failures do not fail the build: they are in the report and on the dashboard"

# Each `sample_*` UDF in code/gallery.pure is rendered as a side-by-side card
# (literal Pure snippet on the left, translateFunction + classToString Java
# on the right). Writes build/java-translation-gallery.html.
#
# pure-truffle prints the returned String to stdout verbatim (no `'...'`
# quoting wrapper, no `\n` escaping), so a plain redirect is enough.

# Build the Pure -> Java translation gallery as a self-contained HTML page.
gallery: build-tests _depCheck_runtime-pdbs
    @{{header}} 'gallery'
    @{{substep}} 'render Pure -> Java gallery -> build/java-translation-gallery.html'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::gallery::renderGallery_String_1__String_1_" \
        --args "meta::pure::functions" \
        2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2) \
        | grep -v '^\[graal-tripwire\]' \
        > {{translation_java_out}}/java-translation-gallery.html
    @echo "wrote {{translation_java_out}}/java-translation-gallery.html ($(wc -c < {{translation_java_out}}/java-translation-gallery.html) bytes)"

# Internal: fail loudly if the PDBs the runtime recipes need aren't staged.
_depCheck_runtime-pdbs:
    #!/usr/bin/env bash
    if [[ ! -f "{{shared_out}}/core-tests.pdb" ]]; then
        echo "ERROR: missing {{shared_out}}/core-tests.pdb (run \`just bootstrap::build\` first)" >&2
        exit 1
    fi
    if [[ ! -x "{{pure_truffle}}" ]]; then
        echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" >&2
        exit 1
    fi

# Remove build/java-translation.pdb (and the tests PDB).
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove build/java-translation.pdb + java-translation-tests.pdb'
    rm -f {{translation_java_out}}/java-translation.pdb {{translation_java_out}}/java-translation-tests.pdb
