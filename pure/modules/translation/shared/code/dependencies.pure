import meta::pure::metamodel::function::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::translation::shared::*;

// ============================================================================
// collectDependencies — given a FunctionDefinition (UserDefinedFunction or
// LambdaFunction), walk its body and return the transitive set of
// PackageableElements it references: other UserDefinedFunctions called, Class
// types used in instantiations or property access, Enumerations referenced,
// etc. The result is what a target-language translator must emit alongside
// the entry function for the produced source to be self-contained.
//
// NOTE — future optimization: the bootstrap compiler already computes a
// function-call dependency graph (see
//   pure/specification/compiler/compiler-pure/compiler/functionRefExtractor.pure
// — the `referencedBy` map on CompilerContext). That graph could be serialized
// into the .pdb alongside the elements, and exposed at runtime through a new
// protocol entry point so translators can look up dependencies in O(1) per
// edge instead of re-walking the AST. Doing that requires:
//   - serializing the reverseIndex into the pdb (writer change)
//   - reading + indexing it on pdb load (reader change)
//   - exposing a Pure-callable native or per-PackageableElement slot
// Until that lands, this module walks the AST at runtime. The walk is fine
// for the small surfaces translators see today; revisit when the graphs grow
// past the level where re-walking is cheap.
// ============================================================================

function meta::pure::translation::shared::collectDependencies(f: FunctionDefinition<Any>[1]): PackageableElement[*]
{
   collectDependenciesTransitive([$f], []->cast(@PackageableElement));
}

// Worklist-based transitive walk. `pending` is what we still need to scan;
// `seen` is the accumulated dependency set (used as both the visited filter
// AND the return value). On each iteration we pop one definition, gather its
// immediate deps, add the unseen ones to both `seen` and `pending`, and loop.
function meta::pure::translation::shared::collectDependenciesTransitive(
   pending: FunctionDefinition<Any>[*],
   seen: PackageableElement[*]
): PackageableElement[*]
{
   if ($pending->isEmpty(),
      | $seen,
      | let head    = $pending->head()->toOne();
        let rest    = $pending->tail();
        let direct  = $head->collectDirectDependencies();
        // Unseen elements: those not already in `seen`. Identity comparison
        // is fine — PackageableElements are canonical instances per registry.
        let fresh   = $direct->filter(e | !$seen->contains($e));
        // Functions among the fresh deps become new work; classes/enums are
        // leaves for this scan (their own dependencies — supertypes,
        // property types — fall out of subsequent class translation, not
        // here).
        let freshFns = $fresh->filter(e | $e->instanceOf(FunctionDefinition))
                              ->cast(@FunctionDefinition<Any>);
        collectDependenciesTransitive(
           $rest->concatenate($freshFns),
           $seen->concatenate($fresh)
        );
   );
}

// Direct (one-hop) dependencies of a single FunctionDefinition: walk its
// expressionSequence and pull out every function/class referenced.
function meta::pure::translation::shared::collectDirectDependencies(f: FunctionDefinition<Any>[1]): PackageableElement[*]
{
   $f.expressionSequence->map(e | $e->depsFromExpression())->removeDuplicates();
}

// Recursive walker over ValueSpecification. Each shape contributes whatever
// PackageableElement it directly references, and recurses into its children.
//
// Constructor literals `^Class(...)` and class references arrive here as
// FunctionExpressions whose `func` slot points at a synthesized factory
// (`new_Class_*` or similar) — they don't need a special arm. The Class
// itself ends up as a dep once that factory's surface lands here too, but
// for now we follow it through the same FunctionExpression branch.
function meta::pure::translation::shared::depsFromExpression(e: ValueSpecification[1]): PackageableElement[*]
{
   $e->match([
      {fe: FunctionExpression[1] |
         // The function being called is in `fe.func` (set during pass-2
         // resolution). Skip if absent (unresolved / lambda-position call).
         let calleeDeps = if ($fe.func->isEmpty(),
                              | []->cast(@PackageableElement),
                              | [$fe.func->toOne()]->cast(@PackageableElement));
         let argDeps = $fe.parametersValues->map(p | $p->depsFromExpression());
         $calleeDeps->concatenate($argDeps);
      },
      {lam: LambdaFunction<Any>[1] |
         // Inline lambdas: walk their own body. Don't add the lambda itself
         // to the deps — it's anonymous, lives inline in the emitted source.
         $lam.expressionSequence->map(x | $x->depsFromExpression());
      },
      // Catch-all for AtomicValue, VariableExpression, etc. — they don't
      // introduce element deps directly.
      other: ValueSpecification[1] | []->cast(@PackageableElement)
   ]);
}

