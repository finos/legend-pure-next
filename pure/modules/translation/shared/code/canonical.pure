import meta::pure::compiler::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::translation::shared::*;

// ============================================================================
// makeCanonical — Pure-AST -> Pure-AST simplification pipeline. The pipeline
// is composed of independent, idempotent PASSES; callers pick which passes
// to apply via the {@link CanonicalMode} enum. Each pass takes a
// FunctionDefinition[1] and returns a FunctionDefinition[1]. Applying the
// same pass twice gives the same result as once (fixpoint guarantee).
//
// Modes are a SET — the input list is deduped and the caller's ordering is
// IGNORED. Passes are always applied in the strict order defined by
// {@link canonicalPassOrder}, which encodes the dependency relationships
// between passes (Inline → PartialEval → IfBranchPruning → FilterFusion →
// DeadLetElim). This means {@code makeCanonical(f, [A, B])} and
// {@code makeCanonical(f, [B, A])} are equivalent — the canonicalization
// itself is canonical. Passing the empty list is a no-op.
//
// Pass catalogue:
//
//   InlineOpenVariables — substitute every captured VariableExpression in
//     the body with the protocol expression representing the captured
//     value. Implementation strategy: decompile the compiled
//     FunctionDefinition to its protocol form (substituting captures along
//     the way), wrap in a PureFile, and feed through the standard
//     {@code meta::pure::compiler::compile} pipeline with the live runtime
//     registry seeded into the CompilerContext via
//     {@code buildLiveCompilerContext}. After this pass the canonical
//     FunctionDefinition has openVariables = [] and every VariableExpression
//     refers to a local parameter or a let-binding inside the body.
//
//   LocalizeOpenVariables — like InlineOpenVariables, but instead of
//     substituting each captured VariableExpression with its value inline,
//     KEEP the `$name` references and prepend a `let name = <value>;`
//     binding for each capture as the first expressions of the body. Same
//     decompile -> recompile strategy, but decompile runs with an EMPTY
//     substitution map (so `$name` survives) and the captured values are
//     emitted as synthesised `letFunction` statements (lowered the same way
//     InlineOpenVariables lowers them, via captureToProtocol). After this
//     pass openVariables = [] and every former capture is a local
//     let-binding — useful when a downstream consumer wants the captured
//     values named once at the top rather than duplicated at every use site.
//
//   SingleUseLetInline — for each top-level {@code let x = RHS;} binding
//     in a function/lambda body, if {@code $x} is referenced exactly once
//     by a subsequent expression and {@code RHS} is side-effect-free,
//     substitute the use with {@code RHS} and drop the let. Recursive
//     across nested scopes (lambda bodies inside the function get the same
//     treatment at their own expressionSequence boundary). Iterates to a
//     fixpoint per-scope so a chain {@code let a = ...; let b = $a + 1; $b}
//     collapses fully in one pass.
//
//     Safety: side-effect detection uses the same
//     {@code functionType.SideEffectFunction}-stereotype check as
//     {@link PartialEvaluation}, plus a conservative "unresolved function
//     reference = treat as side-effecting" rule. Unmoved evaluation order:
//     when an intervening expression between the let and its use carries
//     observable side effects, the inlining would re-order them — we side-
//     step this by inlining only when uses count is 1 and the RHS itself
//     is pure (the use's evaluation point is preserved; the let itself is
//     deleted with no semantic effect because no other expression
//     observed the binding).
//
//   PartialEvaluation — fold every FunctionExpression whose params are
//     ALL literal AtomicValues by invoking the function via
//     {@code evaluate(func, argLists)} and replacing the FE with its
//     result. Bottom-up walk so inner sub-expressions fold first and outer
//     ones see literal args ({@code (1 + 2) + 3 -> 3 + 3 -> 6} in one
//     pass). Recurses into compiled lambda values too, so conds inside
//     pair-lambdas of a multi-if get the same treatment — making them
//     visible to {@link IfBranchPruning}.
//
//     Functions whose stereotypes include
//     {@code functionType.SideEffectFunction} are skipped (no fold), so
//     the pass never executes IO ({@code print}), nondeterministic ops
//     ({@code random}, {@code currentTimeMillis}), or code-eval
//     ({@code eval}/{@code evaluate}/{@code tryEval}) at translation
//     time. Throws bubble up — the pass assumes inputs are well-typed
//     non-side-effecting, and if a fold throws (e.g. divide-by-zero with
//     literal args) the user's code would have thrown at runtime anyway.
//
//   NestedIfToMultiIf — collapse cascades of arity-3 `if(c, |t, |e)` where
//     each else-branch is itself an arity-3 `if` into the multi-if form
//     {@code if([pair(|c1,|t1), pair(|c2,|t2), …], |default)}. Downstream
//     targets (Truffle MultiIfNode, JS `__multiIf`) prefer the flat shape
//     because it avoids per-clause closure dispatch and per-arm Pair
//     allocation. Implemented via a protocol-level round-trip: decompile
//     the UDF, walk the protocol AST and emit `pair(|c, |t)` invocations
//     plus a default lambda, recompile so the new {@code pair}/{@code if}
//     references resolve. Pre-checks for any peelable chain to skip the
//     recompile cost on functions that don't contain one.
//
//   FilterFusion — collapse adjacent {@code xs->filter(c1)->filter(c2)}
//     chains into a single {@code xs->filter(c | c1 && c2)} so the
//     downstream backend only iterates the source once. Recursive
//     bottom-up: a chain of N filters reduces to one with N-1 {@code &&}s.
//     Fusion only fires when both lambdas have a single parameter and a
//     single body expression (Pure grammar rejects multi-expression
//     sequences inside parens, so multi-expr bodies can't be combined as
//     {@code &&} operands), and when the outer body doesn't reference the
//     inner parameter name as a free variable (would cause capture under
//     the param rename). Adjacent fusable pairs in a longer chain still
//     fuse around any non-fusable pair. Same protocol-rewrite +
//     recompile pattern as NestedIfToMultiIf — the new {@code and}
//     references resolve at recompile against the live registry.
//
//   IfBranchPruning — replace `if(literal_bool, |a, |b)` with the body of
//     the taken branch when the condition is an AtomicValue holding a
//     {@link Boolean} literal. Walks the multi-if form too: drops pairs
//     whose cond-lambda body folds to literal-false, and short-circuits at
//     the first literal-true to that pair's value-lambda body. Pairs with
//     a non-literal cond stop the walk (we can only prune past clauses
//     that are definitively decidable). Direct AST walk — no recompile.
//     Most useful immediately after {@link PartialEvaluation}, which is
//     what turns `1 == 1` into a literal {@code true}.
//
//   DeadLetElim — drop top-level {@code let x = expr;} bindings whose
//     variable isn't referenced by any subsequent expression in the same
//     body. The RHS expr is discarded along with the let. Pairs naturally
//     with {@link PartialEvaluation}: a fold can collapse a let's RHS to
//     a literal that wasn't even used elsewhere, then this pass removes
//     the binding. Walks the body end-to-start so a chain of dead lets
//     cascades in one application. NOTE: doesn't follow into nested
//     lambdas or branch arms — those scopes have their own let-sequences
//     and would need their own pass (lifting / inlining first).
// ============================================================================

Enum meta::pure::translation::shared::CanonicalMode
{
   InlineOpenVariables,
   LocalizeOpenVariables,
   SingleUseLetInline,
   PartialEvaluation,
   NestedIfToMultiIf,
   IfBranchPruning,
   FilterFusion,
   DeadLetElim
}

// Back-compat default — current callers pass no modes. Apply only
// InlineOpenVariables to preserve the pre-mode-API behaviour. Callers that
// want partial evaluation should opt in via the explicit overload.
function meta::pure::translation::shared::makeCanonical(f: FunctionDefinition<Any>[1]): FunctionDefinition<Any>[1]
{
   makeCanonical($f, [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables]);
}

// Apply the named passes. The input list is treated as a SET — duplicates
// collapse (each pass is a fixpoint, so applying twice equals once) and the
// order in the list is IGNORED. The actual order of application is the
// strict canonical order defined by {@link canonicalPassOrder}, regardless
// of how the caller arranged the list. Concretely: even if a caller passes
// {@code [FilterFusion, InlineOpenVariables]}, InlineOpenVariables runs
// first because filter fusion can only see capture-free filter bodies after
// the open-variable substitution has happened (a filter lambda that still
// references {@code $cap} would fail to recompile during fusion).
//
// Rationale for a fixed order: pass dependencies are real (Inline before
// PartialEval before IfBranchPruning before DeadLetElim, etc.); letting
// callers pick an order led to silent miscompiles when the chosen order
// hid a capture or a literal from a downstream pass. The set semantics
// make {@code makeCanonical(f, [A, B])} and {@code makeCanonical(f, [B, A])}
// equivalent — the canonicalization itself is canonical.
function meta::pure::translation::shared::makeCanonical(
   f: FunctionDefinition<Any>[1],
   modes: meta::pure::translation::shared::CanonicalMode[*]
): FunctionDefinition<Any>[1]
{
   canonicalPassOrder()
      ->filter(p | $modes->contains($p))
      ->fold({mode, acc | $acc->applyCanonicalPass($mode)}, $f);
}

// The strict canonical ordering of passes. New passes must be inserted at
// the position that respects their dependencies on prior passes. Order
// chosen so each pass sees the most-reduced input from upstream passes:
//
//   1. InlineOpenVariables  — resolve captures so downstream passes see
//                              complete literal bodies, not VariableExpressions.
//   2. LocalizeOpenVariables — alternative to Inline (rare in combination —
//                              after Inline, openVariables is empty so this
//                              is a no-op; listed for completeness).
//   3. SingleUseLetInline   — inline a top-level let-bound variable into its
//                              single use site, dropping the let, when the
//                              RHS is side-effect-free. Runs before
//                              PartialEvaluation so the inlined RHS gets
//                              folded together with the surrounding expr,
//                              and before FilterFusion so a filter lambda
//                              of the shape {@code (x | let y = ...; bool)}
//                              collapses to single-expression form and
//                              becomes fusable.
//   4. PartialEvaluation    — fold literal-only sub-expressions; depends on
//                              Inline having lowered captures to literals.
//   5. NestedIfToMultiIf    — collapse if-cascades into multi-if form; safe
//                              after PartialEvaluation has folded their
//                              conditions.
//   6. IfBranchPruning      — drop pairs with literal-false conds and
//                              short-circuit at literal-true; depends on
//                              PartialEvaluation surfacing those literals
//                              and NestedIfToMultiIf placing them in the
//                              multi-if shape we walk.
//   7. FilterFusion         — collapse {@code xs->filter(c1)->filter(c2)}
//                              into a single filter with {@code &&}; safe
//                              after Inline (filter bodies are capture-free),
//                              after SingleUseLetInline (multi-expr filter
//                              lambdas of the form {@code (x | let y = ...; bool)}
//                              collapse to fusable single-expression form),
//                              and after IfBranchPruning (a conditional
//                              filter clause may have collapsed to a single
//                              expression).
//   8. DeadLetElim          — drop unreferenced lets last, since earlier
//                              passes can render previously-live bindings
//                              dead (e.g. a let used only by a pruned
//                              if-branch).
function meta::pure::translation::shared::canonicalPassOrder(): meta::pure::translation::shared::CanonicalMode[*]
{
   [
      meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
      meta::pure::translation::shared::CanonicalMode.LocalizeOpenVariables,
      meta::pure::translation::shared::CanonicalMode.SingleUseLetInline,
      meta::pure::translation::shared::CanonicalMode.PartialEvaluation,
      meta::pure::translation::shared::CanonicalMode.NestedIfToMultiIf,
      meta::pure::translation::shared::CanonicalMode.IfBranchPruning,
      meta::pure::translation::shared::CanonicalMode.FilterFusion,
      meta::pure::translation::shared::CanonicalMode.DeadLetElim
   ];
}

function meta::pure::translation::shared::applyCanonicalPass(
   f: FunctionDefinition<Any>[1],
   mode: meta::pure::translation::shared::CanonicalMode[1]
): FunctionDefinition<Any>[1]
{
   if ([
      pair(| $mode == meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
           | $f->match([
                lf: LambdaFunction<Any>[1] | $lf->inlineOpenVariables(),
                // UserDefinedFunctions have no captures by construction — passthrough.
                other: FunctionDefinition<Any>[1] | $other
             ])),
      pair(| $mode == meta::pure::translation::shared::CanonicalMode.LocalizeOpenVariables,
           | $f->match([
                lf: LambdaFunction<Any>[1] | $lf->localizeOpenVariables(),
                // UserDefinedFunctions have no captures by construction — passthrough.
                other: FunctionDefinition<Any>[1] | $other
             ])),
      pair(| $mode == meta::pure::translation::shared::CanonicalMode.SingleUseLetInline,
           | $f->singleUseLetInline()),
      pair(| $mode == meta::pure::translation::shared::CanonicalMode.PartialEvaluation,
           | $f->partialEvaluate()),
      pair(| $mode == meta::pure::translation::shared::CanonicalMode.NestedIfToMultiIf,
           | $f->nestedIfToMultiIf()),
      pair(| $mode == meta::pure::translation::shared::CanonicalMode.IfBranchPruning,
           | $f->ifBranchPrune()),
      pair(| $mode == meta::pure::translation::shared::CanonicalMode.FilterFusion,
           | $f->filterFusion()),
      pair(| $mode == meta::pure::translation::shared::CanonicalMode.DeadLetElim,
           | $f->deadLetElim())
   ],
   | $f
   );
}

// ----------------------------------------------------------------------------
// Pass — inlineOpenVariables.
//
// Strategy:
//   1. Fast path: lambdas with no open variables are already canonical
//      (no substitution needed). Return as-is.
//   2. Decompile the compiled body into protocol form, substituting every
//      VariableExpression whose name is in openVariableValues(lambda) with
//      the protocol expression representing the captured value (see
//      decompile.pure).
//   3. Wrap the decompiled body in a synthetic UserDefinedFunction —
//      grammar's equivalent of `function canonical::__canonical__(params): ?
//      { body }` — and feed through `meta::pure::compiler::compile`.
//   4. Pull the compiled UserDefinedFunction out of the result by name.
//      The result has openVariables = [] by construction (every captured
//      ref was replaced with an inline literal before recompile).
//
// Note: the canonical form is a UserDefinedFunction (not a LambdaFunction).
// Downstream translators consume FunctionDefinition (the common super of
// both), so this is structurally compatible.
// ----------------------------------------------------------------------------

function meta::pure::translation::shared::inlineOpenVariables(lambda: LambdaFunction<Any>[1]): FunctionDefinition<Any>[1]
{
   if ($lambda.openVariables->isEmpty(),
      | $lambda,
      | $lambda->inlineOpenVariablesViaRecompile()
   );
}

function meta::pure::translation::shared::inlineOpenVariablesViaRecompile(lambda: LambdaFunction<Any>[1]): FunctionDefinition<Any>[1]
{
   // openVariableValues() returns ALL referenced names — including those
   // bound by a `let` inside the body (the Truffle backend tags every
   // VariableExpression node it walks). Strip those out so they don't
   // get substituted with empty Collections during decompile (which would
   // silently replace `$letVar` with `[]`).
   let allCaptures = $lambda->meta::pure::functions::meta::openVariableValues();
   let letBoundNames = $lambda.expressionSequence
                          ->filter(vs | $vs->instanceOf(meta::pure::metamodel::valuespecification::FunctionExpression))
                          ->cast(@meta::pure::metamodel::valuespecification::FunctionExpression)
                          ->filter(fe | $fe.functionName == 'letFunction'
                                     && $fe.parametersValues->size() == 2
                                     && $fe.parametersValues->at(0)->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue))
                          ->map(fe | $fe.parametersValues->at(0)
                                       ->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value
                                       ->cast(@String));
   let captures = $allCaptures->keys()
                     ->filter(k | !$letBoundNames->contains($k))
                     ->fold({k, acc | $acc->put($k, $allCaptures->get($k)->toOne())},
                            newMap([]->cast(@Pair<String, List<Any>>)));
   let canonicalPkg  = '__canonical__';
   let canonicalName = '__canonical__';
   // Lambda's return type lives on its classifier (LambdaFunction<{params -> ret}>),
   // not on a dedicated slot — extract from typeArguments[0]->rawType()->cast(@FunctionType).
   let funcType = $lambda.classifierGenericType.typeArguments
                     ->at(0)
                     ->rawType()
                     ->toOne('inlineOpenVariablesViaRecompile: lambda missing classifier function type')
                     ->cast(@meta::pure::metamodel::type::FunctionType);
   let protoUDF = toProtocolUserDefinedFunction(
      $lambda.expressionSequence,
      $lambda.parameters,
      $funcType.returnType,
      $funcType.returnMultiplicity,
      $captures,
      $canonicalPkg,
      $canonicalName
   );
   let pf = ^meta::pure::protocol::PureFile(
      sourceId = '__canonical__.pure',
      sections = [^meta::pure::protocol::Section(
         parserName = 'Pure',
         imports    = [],
         elements   = [$protoUDF]
      )]
   );
   let result = meta::pure::compiler::compile(
      [$pf],
      meta::pure::compiler::newCompilerContext(false),
      false,
      true
   );
   // Pull the canonicalized function out of the result by functionName.
   // compile() now invokes resolveAndReturnGraph internally before returning,
   // so the elementMap values are already pointer-free — no per-FD walker
   // needed here.
   $result.context->toOne().elementMap->values()
      ->filter(e | $e->instanceOf(UserDefinedFunction))
      ->cast(@UserDefinedFunction<Any>)
      ->filter(udf | $udf.functionName == $canonicalName)
      ->toOne('inlineOpenVariables: canonicalized function not found after recompile; errors=' + $result.errors->joinStrings(' | '));
}

// ----------------------------------------------------------------------------
// Pass — localizeOpenVariables.
//
// Same decompile -> recompile machinery as inlineOpenVariables, but the
// captures are NOT substituted into the body. Instead:
//   1. Fast path: no open variables -> already canonical, return as-is.
//   2. Decompile the body with an EMPTY captureMap, so every captured
//      VariableExpression survives as `$name` (rather than being replaced
//      by its value's protocol form).
//   3. Synthesise a `let name = <capturedValue>;` for each capture and
//      prepend them to the body's expressionSequence. The captured value
//      is lowered via the SAME captureToProtocol path InlineOpenVariables
//      uses, so scalars become literals, class instances become PDO-bearing
//      AtomicValues, multi-values become Collections.
//   4. Recompile, extract by name, resolve pointers — identical to inline.
//
// Result: a UserDefinedFunction with openVariables = [], where every former
// capture is a top-of-body let-binding and all original `$name` references
// resolve to those bindings.
// ----------------------------------------------------------------------------

function meta::pure::translation::shared::localizeOpenVariables(lambda: LambdaFunction<Any>[1]): FunctionDefinition<Any>[1]
{
   if ($lambda.openVariables->isEmpty(),
      | $lambda,
      | $lambda->localizeOpenVariablesViaRecompile()
   );
}

// True outer-scope captures of `lambda` — its open-variable values with the
// let-bound locals stripped out (those are not captures, just body bindings).
function meta::pure::translation::shared::realOpenVariableCaptures(lambda: LambdaFunction<Any>[1]): Map<String, List<Any>>[1]
{
   let allCaptures = $lambda->meta::pure::functions::meta::openVariableValues();
   let letBoundNames = $lambda.expressionSequence
                          ->filter(vs | $vs->instanceOf(meta::pure::metamodel::valuespecification::FunctionExpression))
                          ->cast(@meta::pure::metamodel::valuespecification::FunctionExpression)
                          ->filter(fe | $fe.functionName == 'letFunction'
                                     && $fe.parametersValues->size() == 2
                                     && $fe.parametersValues->at(0)->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue))
                          ->map(fe | $fe.parametersValues->at(0)
                                       ->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value
                                       ->cast(@String));
   // `~` (and `~.~`, ...) are construction parent-references, not outer-scope
   // captures: openVariableValues reports `~` with an empty value list. Binding
   // it as `let ~ = []` turns the parent-reference into a bogus empty local, so
   // `^~.foo(...)` deep-copies misresolve and the key-expression cycle detector
   // false-positives ('firm' -> 'firm'). Leave `~` for the recompile to resolve
   // against the enclosing construction.
   $allCaptures->keys()
      ->filter(k | !$letBoundNames->contains($k)
                && !$k->startsWith('~'))
      ->fold({k, acc | $acc->put($k, $allCaptures->get($k)->toOne())},
             newMap([]->cast(@Pair<String, List<Any>>)));
}

// The packages of every function called in `exprs` — used to populate the
// canonical-recompile PureFile's `imports` so short function names (e.g. a
// `<<test.TestDependency>>` helper like `castViaSeq`) resolve. Without this the
// recompile fails with "function ... not in scope" and leaves a broken func ref.
function meta::pure::translation::shared::referencedFnPackages(exprs: meta::pure::metamodel::valuespecification::ValueSpecification[*]): String[*]
{
   $exprs->map(e | $e->referencedFnPackagesOne())->removeDuplicates()->filter(p | $p != '');
}
function meta::pure::translation::shared::referencedFnPackagesOne(vs: meta::pure::metamodel::valuespecification::ValueSpecification[1]): String[*]
{
   $vs->match([
      fe:  meta::pure::metamodel::valuespecification::FunctionExpression[1] | $fe->feFnPackage()->concatenate($fe.parametersValues->map(p | $p->referencedFnPackagesOne())),
      av:  meta::pure::metamodel::valuespecification::AtomicValue[1]        | $av->avFnPackages(),
      lf:  meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[1] | $lf.expressionSequence->map(e | $e->referencedFnPackagesOne()),
      col: meta::pure::metamodel::valuespecification::Collection[1]         | $col.values->map(e | $e->referencedFnPackagesOne()),
      o:   meta::pure::metamodel::valuespecification::ValueSpecification[1] | []->cast(@String)
   ]);
}
function meta::pure::translation::shared::avFnPackages(av: meta::pure::metamodel::valuespecification::AtomicValue[1]): String[*]
{
   if ($av.value->isNotEmpty() && $av.value->toOne()->instanceOf(meta::pure::metamodel::function::LambdaFunction),
      | $av.value->toOne()->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>).expressionSequence->map(e | $e->referencedFnPackagesOne()),
      | []->cast(@String));
}
function meta::pure::translation::shared::feFnPackage(fe: meta::pure::metamodel::valuespecification::FunctionExpression[1]): String[*]
{
   if ($fe.func->isEmpty() || !$fe.func->toOne()->instanceOf(meta::pure::metamodel::PackageableElement),
      | []->cast(@String),
      | $fe.func->toOne()->cast(@meta::pure::metamodel::PackageableElement)->elementToPath()->packageOfPath());
}
function meta::pure::translation::shared::packageOfPath(path: String[1]): String[1]
{
   let segs = $path->split('::');
   $segs->take($segs->size() - 1)->joinStrings('::');
}


function meta::pure::translation::shared::localizeOpenVariablesViaRecompile(lambda: LambdaFunction<Any>[1]): FunctionDefinition<Any>[1]
{
   // True outer-scope captures (let-bound locals stripped) — each becomes a
   // top-of-body `let name = value` binding so its `$name` references survive.
   let captures = $lambda->realOpenVariableCaptures();
   let canonicalPkg  = '__canonical__';
   let canonicalName = '__canonical__';
   let funcType = $lambda.classifierGenericType.typeArguments
                     ->at(0)
                     ->rawType()
                     ->toOne('localizeOpenVariablesViaRecompile: lambda missing classifier function type')
                     ->cast(@meta::pure::metamodel::type::FunctionType);
   // Decompile WITHOUT substitution (empty capture map) so captured
   // `$name` references survive in the body. The return type/mult passed here
   // are overridden to Any[*] on $withLets below — the lambda's classifier
   // return is frequently the enclosing test's type/mult PARAMETERS (e.g.
   // `eval`'s `{->Z[y]}`), which are unbound in the canonical UDF and resolve
   // to [1], spuriously clashing with the body's concrete inferred return.
   let protoUDF = toProtocolUserDefinedFunction(
      $lambda.expressionSequence,
      $lambda.parameters,
      $funcType.returnType,
      $funcType.returnMultiplicity,
      newMap([]->cast(@Pair<String, List<Any>>)),
      $canonicalPkg,
      $canonicalName
   );
   // One `let <name> = <capturedValue>;` per capture, prepended to the body
   // so each surviving `$name` resolves to the local binding at recompile.
   let letStmts = $captures->keys()->map(k | buildProtocolLet($k, $captures->get($k)->toOne()));
   // The canonical body is a recompiled copy of a (possibly test) lambda, so it
   // may legitimately reference test-only helpers (e.g. a `<<test.TestDependency>>`
   // cast helper). Mark it `<<test.TestDependency>>` so the lean-references
   // validator doesn't flag it as a non-test element referencing test-only code.
   let withLets = ^$protoUDF(
      expressionSequence = $letStmts->concatenate($protoUDF.expressionSequence),
      stereotypes        = [^meta::pure::protocol::grammar::extension::Stereotype_Pointer(
                              value              = 'meta::pure::profiles::test',
                              extraPointerValues = [^meta::pure::protocol::grammar::PointerValue(value = 'TestDependency')]
                           )],
      // Permissive declared return: Any[*] is compatible with whatever the body
      // infers, so the recompile never raises a spurious "Return type/multiplicity
      // error". The accurate return type/mult is read back from the recompiled
      // body's last expression (post-compile, reliable) and restamped below.
      returnGenericType  = ^meta::pure::protocol::grammar::type::generics::UserDefinedGenericType(
                              type = ^meta::pure::protocol::grammar::type::Type_Pointer(value = 'meta::pure::metamodel::type::Any'),
                              typeArguments = [], multiplicityArguments = [], typeVariableValues = []
                           ),
      // [*] must be encoded as a ConcreteMultiplicity (lowerBound 0, unbounded
      // upper) — compileMultiplicity has no arm for Multiplicity_Pointer and
      // would silently default a pointer to [1].
      returnMultiplicity = ^meta::pure::protocol::grammar::multiplicity::UserDefinedAdHocMultiplicity(
                              lowerBound = ^meta::pure::protocol::grammar::multiplicity::MultiplicityValue(value = 0),
                              upperBound = []
                           )
   );
   let pf = ^meta::pure::protocol::PureFile(
      sourceId = '__canonical__.pure',
      sections = [^meta::pure::protocol::Section(
         parserName = 'Pure',
         imports    = $lambda.expressionSequence->referencedFnPackages(),
         elements   = [$withLets]
      )]
   );
   let result = meta::pure::compiler::compile(
      [$pf],
      meta::pure::compiler::newCompilerContext(false),
      false,
      true
   );
   // Fail hard on a broken canonical recompile — otherwise unresolved refs
   // (e.g. an unresolved function pointer for a called UDF) leak silently into
   // translation as a malformed func slot.
   assert($result.errors->isEmpty(), | 'localizeOpenVariables: canonical recompile errors: ' + $result.errors->joinStrings(' | '));
   // compile() resolves pointers internally; canonical is already pointer-free.
   let canonical = $result.context->toOne().elementMap->values()
      ->filter(e | $e->instanceOf(UserDefinedFunction))
      ->cast(@UserDefinedFunction<Any>)
      ->filter(udf | $udf.functionName == $canonicalName)
      ->toOne('localizeOpenVariables: canonicalized function not found after recompile; errors=' + $result.errors->joinStrings(' | '));
   // Restamp the return type/mult from the recompiled body's last expression.
   // We declared Any[*] before compiling (so the recompile couldn't fail on a
   // return mismatch); now that the body is a freshly-compiled metamodel element
   // its last expression carries the accurate inferred genericType/multiplicity,
   // which is the canonical function's real return contract.
   $canonical->restampReturnFromBody();
}

// Replace a recompiled UDF's declared Any[*] return with its body's last
// expression's inferred genericType/multiplicity. Restamps both the
// PackageableFunction return slots and the classifier's inner FunctionType
// (which the translator adapter reads as the real return contract). Leaves the
// function unchanged when the body is empty or its last expression lacks
// inferred type/mult.
function meta::pure::translation::shared::restampReturnFromBody(udf: UserDefinedFunction<Any>[1]): UserDefinedFunction<Any>[1]
{
   let last = $udf.expressionSequence->last();
   if ($last->isEmpty()
          || $last->toOne().genericType->isEmpty()
          || $last->toOne().multiplicity->isEmpty(),
      | $udf,
      | let bodyGT  = $last->toOne().genericType->toOne();
        let bodyMul = $last->toOne().multiplicity->toOne();
        let cgt     = $udf.classifierGenericType;
        let ftGT    = $cgt.typeArguments->at(0)->cast(@meta::pure::metamodel::type::generics::GenericTypeValue);
        let ft      = $ftGT.type->cast(@meta::pure::metamodel::type::FunctionType);
        let newFt   = ^$ft(returnType = $bodyGT, returnMultiplicity = $bodyMul);
        ^$udf(
           returnGenericType     = $bodyGT,
           returnMultiplicity    = $bodyMul,
           classifierGenericType = ^$cgt(typeArguments = [^$ftGT(type = $newFt)])
        );
   );
}

// Build a protocol `letFunction('name', <value>)` invocation — the parser's
// canonical form for `let name = value`. The name is emitted as a String
// AtomicValue (compileExpressionSequence reads it via
// `parametersValues->at(0)->cast(@AtomicValue<String>).value`); the value
// reuses InlineOpenVariables' capture lowering so the binding RHS matches
// exactly what inlining would have substituted at each use site.
function meta::pure::translation::shared::buildProtocolLet(
   name: String[1],
   value: List<Any>[1]
): meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1]
{
   ^meta::pure::protocol::grammar::valuespecification::FunctionInvocation(
      functionName     = 'letFunction',
      parametersValues = [
         $name->singleValueToProtocol(),
         $value->captureToProtocol()
      ]
   );
}

// ----------------------------------------------------------------------------
// Pass — partialEvaluate.
//
// Walks the function body and reduces every FunctionExpression whose
// parameters are all literal AtomicValues into a single AtomicValue
// holding the precomputed result. Conservative: unknown function names
// and any sub-expression that isn't fully literal are left untouched, so
// the pass never changes semantics — it can only shrink the AST.
//
// Today handles `plus(Integer, Integer)`, `plus(String, String)`,
// `minus(Integer, Integer)`, and `length(String)`. Extend by adding new
// arms to {@link tryFoldFunctionExpression}.
//
// Recursive: nested folds resolve in one pass — `(1 + 2) + 3` walks
// inside-out and collapses to `6` because the outer `plus` sees two
// AtomicValue children after the inner fold.
// ----------------------------------------------------------------------------

function meta::pure::translation::shared::partialEvaluate(f: FunctionDefinition<Any>[1]): FunctionDefinition<Any>[1]
{
   $f->match([
      udf: UserDefinedFunction<Any>[1] | $udf->partialEvaluateUDF(),
      // Lambdas pass through unchanged. The Truffle runtime backs lambdas
      // with `RawClosure` instances whose body slots aren't directly
      // readable through the metamodel's typed accessors (slot access
      // throws ClassCastException on a RawClosure). Callers that want
      // partial evaluation of a captured lambda's body should run
      // {@link CanonicalMode.InlineOpenVariables} first — that pass wraps
      // the lambda as a real UserDefinedFunction via recompile, after
      // which partial eval can fold normally.
      other: FunctionDefinition<Any>[1] | $other
   ]);
}

function meta::pure::translation::shared::partialEvaluateUDF(udf: UserDefinedFunction<Any>[1]): UserDefinedFunction<Any>[1]
{
   ^$udf(expressionSequence = $udf.expressionSequence->map(vs | $vs->foldConstants()));
}

function meta::pure::translation::shared::foldConstants(vs: ValueSpecification[1]): ValueSpecification[1]
{
   $vs->match([
      fe: FunctionExpression[1] |
         let reducedParams = $fe.parametersValues->map(p | $p->foldConstants());
         tryFoldFunctionExpression($fe, $reducedParams);,
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         ^$coll(values = $coll.values->map(v | $v->foldConstants())),
      // Recurse into compiled lambdas — pair-lambdas inside a multi-if hold
      // their conds in a 0-arg LambdaFunction wrapped in an AtomicValue, and
      // we want PartialEvaluation to fold those too so IfBranchPruning can
      // see literal-true/false on the cond.
      av: AtomicValue[1] |
         if ($av.value->instanceOf(LambdaFunction),
            | let inner = $av.value->cast(@LambdaFunction<Any>);
              let foldedBody = $inner.expressionSequence->map(e | $e->foldConstants());
              ^$av(value = ^$inner(expressionSequence = $foldedBody));,
            | $av
         ),
      other: ValueSpecification[1] | $other
   ]);
}

// Try to fold a FunctionExpression to a literal by EVALUATING it. Skip
// the fold when ANY of these is true:
//   - Some reduced parameter isn't a constant subtree
//     ({@link isConstantValueSpec}: AtomicValue with a non-empty value,
//     or Collection whose every element is recursively the same).
//     VariableExpressions, holders, and FunctionExpressions that the
//     bottom-up walk couldn't fold all fail the check.
//   - The FE has no resolved {@code func} slot (only happens for
//     unresolved-reference paths that wouldn't run at runtime either).
//   - The resolved function carries the
//     {@code functionType.SideEffectFunction} stereotype — IO, non-
//     deterministic clocks, code-eval, throw, registry lookup.
//
// On a clean fold we call {@code evaluate(func, argLists)} directly. Any
// runtime throw from the callee (divide-by-zero, etc.) propagates — the
// user's code would have thrown the same way at runtime, so failing the
// translation surfaces a real bug rather than masking it.
function meta::pure::translation::shared::tryFoldFunctionExpression(
   fe: FunctionExpression[1],
   reducedParams: ValueSpecification[*]
): ValueSpecification[1]
{
   // `if` is owned by {@link IfBranchPruning} — that pass collapses
   // {@code if(literal_bool, ...)} via direct AST walk, no runtime invoke.
   // Folding here via {@code evaluate(if, [bool, lambda, lambda])} works
   // for the simple case but trips a Truffle lambda-dispatch null when
   // the AST is synthesised (lambda call-target not wired through the
   // recompile path). Same outcome either way, so just defer to Prune.
   let allConstant = $reducedParams->forAll(p | $p->isConstantValueSpec());
   if (!$allConstant || $fe.functionName == 'if',
      | ^$fe(parametersValues = $reducedParams),
      | evalFoldedFE($fe, $reducedParams)
   );
}

// Invoke `fe.func` via the runtime {@code evaluate(func, argLists)} entry
// point and wrap the returned value back into a compiled AtomicValue (or
// Collection for multi-value results). Carries the FE's genericType +
// multiplicity onto the result so the rest of the AST stays well-typed.
function meta::pure::translation::shared::evalFoldedFE(
   fe: FunctionExpression[1],
   reducedParams: ValueSpecification[*]
): ValueSpecification[1]
{
   let foldedFE = ^$fe(parametersValues = $reducedParams);
   if ($fe.func->isEmpty(),
      | $foldedFE,
      | let realFunc = $fe.func->toOne()->cast(@Function<Any>);
        if ($realFunc->hasSideEffect() || foldWouldTriggerEvalSideEffect($realFunc, $reducedParams),
           | $foldedFE,
           | // `evaluate(func, params)` takes a Function plus per-arg
             // `List<Any>` wrappers and dispatches to the implementation.
             // {@link extractRuntimeValues} pulls the raw value(s) out of
             // the constant subtree (scalar AtomicValue → one value,
             // Collection of literals → the element values).
             let argLists = $reducedParams->map(p |
                               ^List<Any>(values = $p->extractRuntimeValues()));
             foldedResultToValueSpec(
                meta::pure::functions::lang::evaluate($realFunc, $argLists),
                $fe
             );
        );
   );
}

// Does the function carry the {@code functionType.SideEffectFunction}
// stereotype? Used to keep PartialEvaluation away from IO ({@code print}),
// nondeterministic ops ({@code random}, {@code currentTimeMillis}), throwing
// ops ({@code assert}, {@code assertError}).
function meta::pure::translation::shared::hasSideEffect(func: Function<Any>[1]): Boolean[1]
{
   $func->cast(@meta::pure::metamodel::PackageableElement).stereotypes
      ->exists(s | $s.value == 'SideEffectFunction' && $s.profile.name == 'functionType');
}

// Transitive side-effect check for the eval family. `eval`/`evaluate`/
// `tryEval` are themselves pure dispatchers, but folding {@code eval(printFn)}
// would execute the print at translation time even though `print` is the
// thing carrying the stereotype. Peek at the first arg's underlying Function
// value — if THAT is tagged, skip the fold.
function meta::pure::translation::shared::foldWouldTriggerEvalSideEffect(
   func: Function<Any>[1],
   params: ValueSpecification[*]
): Boolean[1]
{
   if (!$func->isEvalFamily() || $params->isEmpty(),
      | false,
      | $params->at(0)->extractFunctionValue()->exists(fn | $fn->hasSideEffect())
   );
}

// Is `func` one of {@code meta::pure::functions::lang::eval} (all 8 arity
// overloads), {@code evaluate}, or {@code tryEval}? Identified via the
// unmangled {@code .functionName} slot so it works across all arities.
function meta::pure::translation::shared::isEvalFamily(func: Function<Any>[1]): Boolean[1]
{
   let pe = $func->cast(@meta::pure::metamodel::PackageableElement);
   if ($pe.package->isEmpty(),
      | false,
      | let pkgPath = $pe.package->toOne()->elementToPath();
        if ($pkgPath != 'meta::pure::functions::lang',
           | false,
           | let name = $func->cast(@meta::pure::metamodel::function::PackageableFunction<Any>)
                          .functionName->toOne();
             $name == 'eval' || $name == 'evaluate' || $name == 'tryEval';
        );
   );
}

// If `vs` is an AtomicValue whose `.value` is a Function, return it. Used by
// {@link foldWouldTriggerEvalSideEffect} to peek through eval's first arg.
// compile() resolves every PackageableFunctionPointer at its boundary so the
// value is a live Function (UDF or LambdaFunction) by the time it gets here.
function meta::pure::translation::shared::extractFunctionValue(vs: ValueSpecification[1]): Function<Any>[0..1]
{
   if (!$vs->instanceOf(AtomicValue),
      | []->cast(@Function<Any>),
      | let av = $vs->cast(@AtomicValue);
        if ($av.value->isEmpty(),
           | []->cast(@Function<Any>),
           | let v = $av.value->toOne();
             if ($v->instanceOf(meta::pure::metamodel::function::Function),
                | $v->cast(@Function<Any>),
                | []->cast(@Function<Any>)
             );
        );
   );
}

// Convert the runtime result of a fold-eval back into a compiled
// ValueSpecification node. Empty → empty Collection; single → AtomicValue;
// multi → Collection of per-element AtomicValues. The outer node's
// genericType + multiplicity match the original FE's so the AST stays
// well-typed.
function meta::pure::translation::shared::foldedResultToValueSpec(
   values: Any[*],
   fe: FunctionExpression[1]
): ValueSpecification[1]
{
   if ($values->size() == 1,
      | ^AtomicValue(
           value        = $values->toOne(),
           genericType  = $fe.genericType,
           multiplicity = $fe.multiplicity
        ),
      | // 0 or 2+ values — emit a Collection. Element AtomicValues use the
        // outer genericType too (the printer reads element types from the
        // Collection's genericType anyway).
        ^meta::pure::metamodel::valuespecification::Collection(
           values       = $values->map(v |
                            ^AtomicValue(
                               value        = $v,
                               genericType  = $fe.genericType,
                               multiplicity = meta::pure::metamodel::multiplicity::PureOne
                            )),
           genericType  = $fe.genericType,
           multiplicity = $fe.multiplicity
        )
   );
}

// Is `vs` a constant subtree — every leaf is a value the runtime
// evaluator can pass directly? AtomicValue with non-empty `.value`
// counts (primitive, class-instance PDO, runtime LambdaFunction without
// captures, etc. — `evaluate` doesn't care about the leaf's class).
// Collection of all-constant children counts (Pure auto-spreads the
// values into List<Any>). VariableExpressions and FunctionExpressions
// that the bottom-up walk couldn't fold to a literal fail the check.
function meta::pure::translation::shared::isConstantValueSpec(vs: ValueSpecification[1]): Boolean[1]
{
   $vs->match([
      av: AtomicValue[1] | $av.value->isNotEmpty(),
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         $coll.values->forAll(v | $v->isConstantValueSpec()),
      other: ValueSpecification[1] | false
   ]);
}

// Pull the raw runtime value(s) out of a constant ValueSpec — used to
// build the `List<Any>` arg wrappers that {@code evaluate} expects. The
// scalar shape is `[value]`; a Collection becomes the flat list of its
// element values (matching how Pure passes a multi-valued arg).
function meta::pure::translation::shared::extractRuntimeValues(vs: ValueSpecification[1]): Any[*]
{
   $vs->match([
      av: AtomicValue[1] | $av.value->toOne(),
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         $coll.values->map(v | $v->extractRuntimeValues()),
      other: ValueSpecification[1] |
         fail('extractRuntimeValues: non-constant subtree leaked through; class='
                 + $other->genericType().type->toOne()->elementToPath());
        []->cast(@Any);
   ]);
}

// ----------------------------------------------------------------------------
// Pass — nestedIfToMultiIf.
//
// Walks the function body and collapses
//
//   if(c1, |t1, |if(c2, |t2, |if(c3, |t3, |default)))
//
// into the multi-if shape
//
//   if([pair(|c1,|t1), pair(|c2,|t2), pair(|c3,|t3)], |default).
//
// Peeling requires each else-lambda to be a SINGLE arity-3 `if` call (no
// surrounding let-bindings or sequenced expressions, which would be lost
// in the flat form). Chains shorter than two nested ifs are left alone.
//
// Strategy: pre-walk the compiled AST to skip work on functions with no
// peelable chain (cheap walk, common case in user code). When a chain is
// found, decompile the whole UDF to its protocol form, walk the protocol
// AST and rewrite each peelable `if` at the protocol level (where new
// {@code pair} invocations + 0-arg cond lambdas can be expressed without
// chasing compiled-side `func` / GenericType bookkeeping), then recompile
// — the compile pipeline resolves the freshly-emitted references against
// the live registry.
// ----------------------------------------------------------------------------

function meta::pure::translation::shared::nestedIfToMultiIf(f: FunctionDefinition<Any>[1]): FunctionDefinition<Any>[1]
{
   $f->match([
      udf: UserDefinedFunction<Any>[1] |
         if ($udf->hasPeelableNestedIf(),
            | $udf->nestedIfToMultiIfViaRecompile(),
            | $udf
         );,
      // Lambdas pass through (same RawClosure limitation as partialEvaluate).
      other: FunctionDefinition<Any>[1] | $other
   ]);
}

function meta::pure::translation::shared::hasPeelableNestedIf(udf: UserDefinedFunction<Any>[1]): Boolean[1]
{
   $udf.expressionSequence->exists(vs | $vs->hasPeelableNestedIfInVS());
}

function meta::pure::translation::shared::hasPeelableNestedIfInVS(vs: ValueSpecification[1]): Boolean[1]
{
   $vs->match([
      fe: FunctionExpression[1] |
         $fe->isPeelableIf3() || $fe.parametersValues->exists(p | $p->hasPeelableNestedIfInVS()),
      av: AtomicValue[1] |
         if ($av.value->instanceOf(LambdaFunction),
            | $av.value->cast(@LambdaFunction<Any>).expressionSequence->exists(e | $e->hasPeelableNestedIfInVS()),
            | false
         ),
      col: meta::pure::metamodel::valuespecification::Collection[1] |
         $col.values->exists(v | $v->hasPeelableNestedIfInVS()),
      other: ValueSpecification[1] | false
   ]);
}

// Compiled-side check: an arity-3 `if` whose else-branch is itself an
// arity-3 `if` wrapped in a single-expression 0-arg lambda. This is the
// shape we know how to flatten without losing surrounding bindings.
function meta::pure::translation::shared::isPeelableIf3(fe: FunctionExpression[1]): Boolean[1]
{
   if (!($fe.functionName == 'if' && $fe.parametersValues->size() == 3),
      | false,
      | let elseParam = $fe.parametersValues->at(2);
        if (!$elseParam->instanceOf(AtomicValue),
           | false,
           | let elseAV = $elseParam->cast(@AtomicValue);
             if (!$elseAV.value->instanceOf(LambdaFunction),
                | false,
                | let elseLam = $elseAV.value->cast(@LambdaFunction<Any>);
                  if (!($elseLam.parameters->isEmpty() && $elseLam.expressionSequence->size() == 1),
                     | false,
                     | let body0 = $elseLam.expressionSequence->at(0);
                       $body0->instanceOf(FunctionExpression)
                          && $body0->cast(@FunctionExpression).functionName == 'if'
                          && $body0->cast(@FunctionExpression).parametersValues->size() == 3;
                  );
             );
        );
   );
}

function meta::pure::translation::shared::nestedIfToMultiIfViaRecompile(udf: UserDefinedFunction<Any>[1]): UserDefinedFunction<Any>[1]
{
   let funcType = $udf.classifierGenericType.typeArguments
                     ->at(0)
                     ->rawType()
                     ->toOne('nestedIfToMultiIf: UDF missing classifier function type')
                     ->cast(@meta::pure::metamodel::type::FunctionType);
   let canonicalPkg  = '__canonical__';
   let canonicalName = '__canonical__';
   let protoUDF = toProtocolUserDefinedFunction(
      $udf.expressionSequence,
      $udf.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression),
      $funcType.returnType,
      $funcType.returnMultiplicity,
      newMap([]->cast(@Pair<String, List<Any>>)),
      $canonicalPkg,
      $canonicalName
   );
   let rewritten = ^$protoUDF(
      expressionSequence = $protoUDF.expressionSequence->map(e | $e->rewriteIfsToMultiIfProtocol())
   );
   let pf = ^meta::pure::protocol::PureFile(
      sourceId = '__canonical_nested_if__.pure',
      sections = [^meta::pure::protocol::Section(
         parserName = 'Pure',
         imports    = [],
         elements   = [$rewritten]
      )]
   );
   let result = meta::pure::compiler::compile(
      [$pf],
      meta::pure::compiler::newCompilerContext(false),
      false,
      true
   );
   // compile() resolves pointers internally; canonical is already pointer-free.
   $result.context->toOne().elementMap->values()
      ->filter(e | $e->instanceOf(UserDefinedFunction))
      ->cast(@UserDefinedFunction<Any>)
      ->filter(u | $u.functionName == $canonicalName)
      ->toOne('nestedIfToMultiIf: function not found after recompile; errors=' + $result.errors->joinStrings(' | '));
}

// Protocol-AST walk — recurse first, then attempt to flatten this node.
// The recursion ensures inner if-chains are already flattened before we
// look at the outer one, so the "else is a single arity-3 if" check sees
// post-recursion shape.
//
// Note: protocol AST wraps lambdas in `AtomicValue(value=LambdaFunction)`
// rather than placing them bare in `parametersValues` (which is typed
// `ValueSpecification[*]`, and LambdaFunction is NOT a ValueSpecification
// in the protocol metamodel). So when we walk into a lambda body, we
// return a new AtomicValue wrapping a freshly-built protocol lambda.
function meta::pure::translation::shared::rewriteIfsToMultiIfProtocol(
   vs: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   $vs->match([
      fi: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
         let recursed = $fi.parametersValues->map(p | $p->rewriteIfsToMultiIfProtocol());
         tryFlattenIfChainProtocol($fi, $recursed);,
      da: meta::pure::protocol::grammar::valuespecification::DotApplication[1] |
         ^$da(parametersValues = $da.parametersValues->map(p | $p->rewriteIfsToMultiIfProtocol())),
      col: meta::pure::protocol::grammar::valuespecification::Collection[1] |
         ^$col(values = $col.values->map(v | $v->rewriteIfsToMultiIfProtocol())),
      av: meta::pure::protocol::grammar::valuespecification::AtomicValue[1] |
         // Decompiled then/else lambdas land here: AtomicValue.value is a
         // compiled LambdaFunction PDO (decompile passes them through).
         // Walk INTO that compiled lambda's body, decompile each expression
         // and recurse — then rebuild AtomicValue(value=newProtoLambda).
         if ($av.value->instanceOf(meta::pure::metamodel::function::LambdaFunction),
            | let innerCompiled = $av.value->cast(@meta::pure::metamodel::function::LambdaFunction<Any>);
              let innerProto = $innerCompiled.expressionSequence
                                 ->map(e | $e->toProtocolValueSpec(newMap([]->cast(@Pair<String, List<Any>>))))
                                 ->map(e | $e->rewriteIfsToMultiIfProtocol());
              let newLam = ^meta::pure::protocol::grammar::function::LambdaFunction(
                 parameters         = $innerCompiled.parameters
                                         ->map(p | $p->toProtocolParameter()),
                 expressionSequence = $innerProto
              );
              ^$av(value = $newLam);,
            | $av
         ),
      other: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1] | $other
   ]);
}

// If `fi` is an arity-3 `if` whose else-branch (now post-recursion) is a
// 0-arg lambda containing another `if` — either a 3-arg if OR an already-
// flattened multi-if — splice the outer cond/then on as the first pair of
// a new multi-if. Recursion in {@link rewriteIfsToMultiIfProtocol} has
// already processed the inner if, so it's already in its most-flat form
// when we look at it here: peel-one-level + merge handles unbounded depth.
//
// Protocol shape: the else-branch is `AtomicValue(value=LambdaFunction)`
// (either the decompile's pass-through of a compiled lambda, or our own
// re-wrap from recursing into one). Peek through both layers.
function meta::pure::translation::shared::tryFlattenIfChainProtocol(
   fi: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1],
   recursed: meta::pure::protocol::grammar::valuespecification::ValueSpecification[*]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   if (!($fi.functionName == 'if' && $recursed->size() == 3),
      | ^$fi(parametersValues = $recursed),
      | let elseInnerIf = $recursed->at(2)->protocolLambdaIfBody();
        if ($elseInnerIf->isEmpty(),
           | ^$fi(parametersValues = $recursed),
           | mergeOuterIntoInnerIf($recursed->at(0), $recursed->at(1), $elseInnerIf->toOne(), $fi, $recursed)
        );
   );
}

// If `vs` is `AtomicValue(value=LambdaFunction)` wrapping a 0-arg lambda
// whose single body expression is an `if` FunctionInvocation, return that
// inner if. Otherwise empty. Handles both shapes the value may take: a
// compiled LambdaFunction PDO (decompile pass-through) or a protocol
// LambdaFunction (after recursion through this pass).
function meta::pure::translation::shared::protocolLambdaIfBody(
   vs: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
): meta::pure::protocol::grammar::valuespecification::FunctionInvocation[0..1]
{
   if (!$vs->instanceOf(meta::pure::protocol::grammar::valuespecification::AtomicValue),
      | []->cast(@meta::pure::protocol::grammar::valuespecification::FunctionInvocation),
      | let av = $vs->cast(@meta::pure::protocol::grammar::valuespecification::AtomicValue);
        let body = $av.value->protocolLambdaBody();
        if ($body->isEmpty()
            || !$body->toOne()->instanceOf(meta::pure::protocol::grammar::valuespecification::FunctionInvocation),
           | []->cast(@meta::pure::protocol::grammar::valuespecification::FunctionInvocation),
           | $body->toOne()->cast(@meta::pure::protocol::grammar::valuespecification::FunctionInvocation)
        );
   );
}

// Pull the single-expression body out of a 0-arg lambda value. The lambda
// may be a compiled `meta::pure::metamodel::function::LambdaFunction` (PDO,
// decompile pass-through) or a protocol
// `meta::pure::protocol::grammar::function::LambdaFunction` (rebuilt by
// this pass). Returns empty if shape doesn't match.
function meta::pure::translation::shared::protocolLambdaBody(
   v: Any[1]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[0..1]
{
   if ($v->instanceOf(meta::pure::metamodel::function::LambdaFunction),
      | let cl = $v->cast(@meta::pure::metamodel::function::LambdaFunction<Any>);
        if (!($cl.parameters->isEmpty() && $cl.expressionSequence->size() == 1),
           | []->cast(@meta::pure::protocol::grammar::valuespecification::ValueSpecification),
           | $cl.expressionSequence->at(0)
                  ->toProtocolValueSpec(newMap([]->cast(@Pair<String, List<Any>>)))
        );,
      | if ($v->instanceOf(meta::pure::protocol::grammar::function::LambdaFunction),
           | let pl = $v->cast(@meta::pure::protocol::grammar::function::LambdaFunction);
             if (!($pl.parameters->isEmpty() && $pl.expressionSequence->size() == 1),
                | []->cast(@meta::pure::protocol::grammar::valuespecification::ValueSpecification),
                | $pl.expressionSequence->at(0)
             );,
           | []->cast(@meta::pure::protocol::grammar::valuespecification::ValueSpecification)
        )
   );
}

// Splice (outerCond, outerThen) onto the front of innerIf's clauses to
// produce a single multi-if. innerIf is either a 3-arg if (becomes two
// pairs + innerElse-as-default) or an already-flattened 2-arg multi-if
// (we prepend outer's pair to the existing collection). Falls back to
// returning the unchanged outer FE if innerIf's shape is something else.
function meta::pure::translation::shared::mergeOuterIntoInnerIf(
   outerCond: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1],
   outerThen: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1],
   innerIf: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1],
   outerFE: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1],
   outerRecursed: meta::pure::protocol::grammar::valuespecification::ValueSpecification[*]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   let outerPair = makeProtocolPair($outerCond, $outerThen);
   let innerArity = $innerIf.parametersValues->size();
   if ($innerArity == 3,
      | let innerPair = makeProtocolPair($innerIf.parametersValues->at(0), $innerIf.parametersValues->at(1));
        buildMultiIfProtocol([$outerPair, $innerPair], $innerIf.parametersValues->at(2));,
      | if ($innerArity == 2
            && $innerIf.parametersValues->at(0)->instanceOf(meta::pure::protocol::grammar::valuespecification::Collection),
           | let existingPairs = $innerIf.parametersValues->at(0)
                                    ->cast(@meta::pure::protocol::grammar::valuespecification::Collection).values;
             buildMultiIfProtocol($outerPair->concatenate($existingPairs), $innerIf.parametersValues->at(1));,
           | ^$outerFE(parametersValues = $outerRecursed)
        )
   );
}

// Build a 2-arg multi-if FunctionInvocation: `if([pair, pair, ...], |default)`.
function meta::pure::translation::shared::buildMultiIfProtocol(
   pairs: meta::pure::protocol::grammar::valuespecification::ValueSpecification[*],
   defaultLambda: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
): meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1]
{
   ^meta::pure::protocol::grammar::valuespecification::FunctionInvocation(
      functionName     = 'if',
      parametersValues = [
         ^meta::pure::protocol::grammar::valuespecification::Collection(
            values       = $pairs,
            genericType  = ^meta::pure::protocol::grammar::type::generics::CompilerNotSetGenericType(),
            multiplicity = ^meta::pure::protocol::grammar::multiplicity::CompilerNotSetMultiplicity()
         ),
         $defaultLambda
      ]
   );
}

// Build a protocol `pair(|cond, |thenLambdaBody)` invocation. `cond` is a
// bare expression (the original 3-arg if's first arg), so wrap in a 0-arg
// lambda — and then in an AtomicValue, because protocol parametersValues
// is `ValueSpecification[*]` and LambdaFunction is not a ValueSpec. The
// `thenLambda` parameter is already `AtomicValue(value=LambdaFunction)`
// from the original if — pass through unchanged.
function meta::pure::translation::shared::makeProtocolPair(
   cond: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1],
   thenLambda: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
): meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1]
{
   let condLambda = ^meta::pure::protocol::grammar::function::LambdaFunction(
      parameters         = [],
      expressionSequence = [$cond]
   );
   let condAV = ^meta::pure::protocol::grammar::valuespecification::AtomicValue(
      value        = $condLambda,
      genericType  = ^meta::pure::protocol::grammar::type::generics::CompilerNotSetGenericType(),
      multiplicity = ^meta::pure::protocol::grammar::multiplicity::CompilerNotSetMultiplicity()
   );
   ^meta::pure::protocol::grammar::valuespecification::FunctionInvocation(
      functionName     = 'pair',
      parametersValues = [$condAV, $thenLambda]
   );
}

// ----------------------------------------------------------------------------
// Pass — ifBranchPrune.
//
// Replace `if(literal_bool, |a, |b)` with the body of the taken branch.
// Walks both the 3-arg and the multi-if forms recursively. Operates on the
// compiled AST directly — no recompile needed because pruning never
// introduces new function references, only deletes/inlines existing ones.
//
// Multi-if pruning rule: walk pairs left-to-right. Drop pairs whose cond
// folds to literal false. On the first pair with literal-true cond, take
// its value-lambda body as the result (later pairs and the default become
// unreachable). On a non-literal cond, stop pruning — we can't prove the
// remaining pairs unreachable, so we keep the multi-if with the surviving
// suffix. If every pair is literal-false (or no pairs survive), the result
// is the default-lambda body.
//
// Pruning only fires when the taken branch's lambda has a SINGLE body
// expression (the common case). Multi-statement bodies are left intact —
// inlining would lose the surrounding let-bindings.
// ----------------------------------------------------------------------------

function meta::pure::translation::shared::ifBranchPrune(f: FunctionDefinition<Any>[1]): FunctionDefinition<Any>[1]
{
   $f->match([
      udf: UserDefinedFunction<Any>[1] |
         ^$udf(expressionSequence = $udf.expressionSequence->map(vs | $vs->pruneIfBranches())),
      // Lambdas: same RawClosure limitation as the other passes.
      other: FunctionDefinition<Any>[1] | $other
   ]);
}

function meta::pure::translation::shared::pruneIfBranches(vs: ValueSpecification[1]): ValueSpecification[1]
{
   $vs->match([
      fe: FunctionExpression[1] |
         let recursed = $fe.parametersValues->map(p | $p->pruneIfBranches());
         tryPruneIf($fe, $recursed);,
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         ^$coll(values = $coll.values->map(v | $v->pruneIfBranches())),
      av: AtomicValue[1] |
         if ($av.value->instanceOf(LambdaFunction),
            | let inner = $av.value->cast(@LambdaFunction<Any>);
              let prunedBody = $inner.expressionSequence->map(e | $e->pruneIfBranches());
              ^$av(value = ^$inner(expressionSequence = $prunedBody));,
            | $av
         ),
      other: ValueSpecification[1] | $other
   ]);
}

function meta::pure::translation::shared::tryPruneIf(
   fe: FunctionExpression[1],
   recursed: ValueSpecification[*]
): ValueSpecification[1]
{
   if (!($fe.functionName == 'if'),
      | ^$fe(parametersValues = $recursed),
      | if ($recursed->size() == 3,
           | tryPruneIf3($fe, $recursed),
           | if ($recursed->size() == 2,
                | tryPruneMultiIf($fe, $recursed),
                | ^$fe(parametersValues = $recursed)
             )
        )
   );
}

function meta::pure::translation::shared::tryPruneIf3(
   fe: FunctionExpression[1],
   recursed: ValueSpecification[*]
): ValueSpecification[1]
{
   let cond = $recursed->at(0);
   let literalBool = $cond->literalBooleanValue();
   if ($literalBool->isEmpty(),
      | ^$fe(parametersValues = $recursed),
      | let taken = if ($literalBool->toOne(),
                        | $recursed->at(1),
                        | $recursed->at(2)
                    );
        $taken->extractSingleLambdaBody()->extractedOrUnchanged($fe, $recursed);
   );
}

function meta::pure::translation::shared::tryPruneMultiIf(
   fe: FunctionExpression[1],
   recursed: ValueSpecification[*]
): ValueSpecification[1]
{
   let collParam = $recursed->at(0);
   let defaultLambda = $recursed->at(1);
   if (!$collParam->instanceOf(meta::pure::metamodel::valuespecification::Collection),
      | ^$fe(parametersValues = $recursed),
      | let pairs = $collParam->cast(@meta::pure::metamodel::valuespecification::Collection).values;
        let walked = walkMultiIfPairs($pairs);
        // walked.first  = surviving-pairs sequence (or [valueLambda] singleton if hitTrue)
        // walked.second = true iff a literal-true cond was hit (survivors is [valueLambda])
        let survivors = $walked.first.values;
        let hitTrue   = $walked.second;
        if ($hitTrue,
           | $survivors->at(0)->extractSingleLambdaBody()->extractedOrUnchanged($fe, $recursed),
           | if ($survivors->isEmpty(),
                | $defaultLambda->extractSingleLambdaBody()->extractedOrUnchanged($fe, $recursed),
                | let collCast = $collParam->cast(@meta::pure::metamodel::valuespecification::Collection);
                  let newColl = ^$collCast(values = $survivors);
                  ^$fe(parametersValues = [$newColl, $defaultLambda]);
             )
        );
   );
}

// Iterate left-to-right over multi-if pairs.
//   - Drop pairs whose cond folds to literal-false.
//   - Stop at the first literal-true cond and return its value-lambda as
//     the singleton survivor (hitTrue=true).
//   - Stop at a non-literal cond and keep this pair + remaining tail
//     (we can't prove later pairs unreachable). hitTrue=false.
//   - Reach the end with no survivors → empty, hitTrue=false.
function meta::pure::translation::shared::walkMultiIfPairs(
   remaining: ValueSpecification[*]
): Pair<List<ValueSpecification>, Boolean>[1]
{
   if ($remaining->isEmpty(),
      | pair(^List<ValueSpecification>(values = []->cast(@ValueSpecification)), false),
      | let head = $remaining->at(0);
        let tail = $remaining->tail();
        let headIsPair = $head->instanceOf(FunctionExpression)
           && $head->cast(@FunctionExpression).functionName == 'pair'
           && $head->cast(@FunctionExpression).parametersValues->size() == 2;
        if (!$headIsPair,
           // unknown shape — keep this and rest unchanged.
           | pair(^List<ValueSpecification>(values = $remaining), false),
           | let pairFE = $head->cast(@FunctionExpression);
             let condLambda = $pairFE.parametersValues->at(0);
             let valueLambda = $pairFE.parametersValues->at(1);
             let condBool = $condLambda->lambdaBodyLiteralBoolean();
             if ($condBool->isEmpty(),
                // non-literal cond — keep this pair AND all remaining, stop pruning.
                | pair(^List<ValueSpecification>(values = $remaining), false),
                | if ($condBool->toOne(),
                     // literal-true — take the value lambda as the singleton survivor.
                     | pair(^List<ValueSpecification>(values = [$valueLambda]), true),
                     // literal-false — drop this pair, recurse on tail.
                     | walkMultiIfPairs($tail)
                  )
             );
        );
   );
}

// If `vs` is an AtomicValue holding a literal Boolean, return [bool].
// Otherwise empty. The conds in 3-arg `if(...)` land here directly.
function meta::pure::translation::shared::literalBooleanValue(vs: ValueSpecification[1]): Boolean[0..1]
{
   if (!$vs->instanceOf(AtomicValue),
      | []->cast(@Boolean),
      | let av = $vs->cast(@AtomicValue);
        if ($av.value->isEmpty() || !$av.value->toOne()->instanceOf(Boolean),
           | []->cast(@Boolean),
           | $av.value->toOne()->cast(@Boolean)
        );
   );
}

// Multi-if conds are wrapped in 0-arg lambdas. Peek through the lambda to
// the body and check for a literal Boolean there.
function meta::pure::translation::shared::lambdaBodyLiteralBoolean(vs: ValueSpecification[1]): Boolean[0..1]
{
   if (!$vs->instanceOf(AtomicValue),
      | []->cast(@Boolean),
      | let av = $vs->cast(@AtomicValue);
        if (!$av.value->instanceOf(LambdaFunction),
           | []->cast(@Boolean),
           | let lam = $av.value->cast(@LambdaFunction<Any>);
             if (!($lam.parameters->isEmpty() && $lam.expressionSequence->size() == 1),
                | []->cast(@Boolean),
                | $lam.expressionSequence->at(0)->literalBooleanValue()
             );
        );
   );
}

// Pull the single body expression out of an AtomicValue-wrapped 0-arg
// LambdaFunction. Returns empty if the shape doesn't match (multi-statement
// body, non-empty parameters, or the value isn't a lambda) so the caller
// can fall back to leaving the if intact.
function meta::pure::translation::shared::extractSingleLambdaBody(vs: ValueSpecification[1]): ValueSpecification[0..1]
{
   if (!$vs->instanceOf(AtomicValue),
      | []->cast(@ValueSpecification),
      | let av = $vs->cast(@AtomicValue);
        if (!$av.value->instanceOf(LambdaFunction),
           | []->cast(@ValueSpecification),
           | let lam = $av.value->cast(@LambdaFunction<Any>);
             if (!($lam.parameters->isEmpty() && $lam.expressionSequence->size() == 1),
                | []->cast(@ValueSpecification),
                | $lam.expressionSequence->at(0)
             );
        );
   );
}

// Helper: if `extracted` is non-empty, use it; otherwise fall back to the
// unchanged FunctionExpression. Lets the prune sites express
// "extract-lambda-body, else keep original" in one chain.
function meta::pure::translation::shared::extractedOrUnchanged(
   extracted: ValueSpecification[0..1],
   fe: FunctionExpression[1],
   recursed: ValueSpecification[*]
): ValueSpecification[1]
{
   if ($extracted->isEmpty(),
      | ^$fe(parametersValues = $recursed),
      | $extracted->toOne()
   );
}

// ----------------------------------------------------------------------------
// Pass — deadLetElim.
//
// Drop {@code let x = expr;} bindings from the top-level expressionSequence
// when `x` isn't referenced by any subsequent expression. Walks end-to-start
// so a chain of dead lets collapses in one application:
//
//   let a = 5;       -- a referenced only by b's RHS → drops after b drops
//   let b = $a + 1;  -- b unreferenced (below) → drops first (end-to-start)
//   doSomething()
//
// Reference detection recurses into nested FE/Collection/AtomicValue-with-
// lambda subtrees. The RHS expr of a dropped let is discarded — fine for
// pure exprs, but if the RHS has observable side effects they're lost.
// Combine with the SideEffectFunction stereotype-aware passes upstream
// (PartialEvaluation already won't fold side-effecting calls into literals)
// to keep this safe in practice.
// ----------------------------------------------------------------------------

function meta::pure::translation::shared::deadLetElim(f: FunctionDefinition<Any>[1]): FunctionDefinition<Any>[1]
{
   $f->match([
      udf: UserDefinedFunction<Any>[1] |
         ^$udf(expressionSequence = $udf.expressionSequence->dropUnreferencedLets()),
      other: FunctionDefinition<Any>[1] | $other
   ]);
}

// Iterate the expression sequence end-to-start, building the kept tail.
// For each let, check the already-built tail for any reference to its
// variable; drop if 0 references. Cascades a chain of dead lets in one pass.
function meta::pure::translation::shared::dropUnreferencedLets(exprs: ValueSpecification[*]): ValueSpecification[*]
{
   let n = $exprs->size();
   range(0, $n)
      ->map(i | $n - 1 - $i)
      ->fold({i, kept |
         let curr = $exprs->at($i);
         let varName = $curr->letBoundVarName();
         let isDead = $varName->isNotEmpty()
                      && !$kept->exists(e | $e->referencesVariable($varName->toOne()));
         if ($isDead, | $kept, | [$curr]->concatenate($kept));
      }, []->cast(@ValueSpecification));
}

// Returns the variable name iff `vs` is a top-level `letFunction('name', value)`
// invocation in standard shape: an arity-2 FE whose first arg is an
// AtomicValue holding a String. Otherwise empty (not a let, or weird shape).
function meta::pure::translation::shared::letBoundVarName(vs: ValueSpecification[1]): String[0..1]
{
   if (!$vs->instanceOf(FunctionExpression),
      | []->cast(@String),
      | let fe = $vs->cast(@FunctionExpression);
        if (!($fe.functionName == 'letFunction' && $fe.parametersValues->size() == 2),
           | []->cast(@String),
           | let nameParam = $fe.parametersValues->at(0);
             if (!$nameParam->instanceOf(AtomicValue),
                | []->cast(@String),
                | let av = $nameParam->cast(@AtomicValue);
                  if ($av.value->isEmpty() || !$av.value->toOne()->instanceOf(String),
                     | []->cast(@String),
                     | $av.value->toOne()->cast(@String)
                  );
             );
        );
   );
}

// Recursive walker — does `vs` reference a VariableExpression named `name`
// anywhere in its subtree? Recurses into FunctionExpression.parametersValues,
// Collection.values, and AtomicValue-wrapped LambdaFunction bodies. Does NOT
// follow into nested LambdaFunctions whose `parameters` include `name`
// (proper lexical shadowing).
function meta::pure::translation::shared::referencesVariable(vs: ValueSpecification[1], name: String[1]): Boolean[1]
{
   $vs->match([
      ve: meta::pure::metamodel::valuespecification::VariableExpression[1] |
         $ve.name == $name,
      fe: FunctionExpression[1] |
         $fe.parametersValues->exists(p | $p->referencesVariable($name)),
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         $coll.values->exists(v | $v->referencesVariable($name)),
      av: AtomicValue[1] |
         if (!$av.value->instanceOf(LambdaFunction),
            | false,
            | let lam = $av.value->cast(@LambdaFunction<Any>);
              if ($lam.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression)
                     ->exists(p | $p.name == $name),
                 // shadowed by an inner lambda parameter — inner uses don't count
                 | false,
                 | $lam.expressionSequence->exists(e | $e->referencesVariable($name))
              );
         ),
      other: ValueSpecification[1] | false
   ]);
}

// ----------------------------------------------------------------------------
// Pass — singleUseLetInline.
//
// Inline every top-level {@code let x = RHS;} binding into its single use
// when {@code $x} is referenced exactly once by a subsequent expression and
// {@code RHS} is side-effect-free. The let is then dropped (no other
// expression observed the binding, so the deletion is invisible).
//
// Applies independently at every expressionSequence boundary in the AST —
// function/UDF body, lambda bodies inside the function, lambda bodies
// inside lambda bodies, ... — so a multi-expression filter lambda of the
// shape {@code (x | let y = $x + 1; $y > 0)} collapses to single-
// expression form {@code (x | $x + 1 > 0)} and unblocks downstream
// FilterFusion.
//
// Iterates per-scope until fixpoint, so chains collapse fully:
// {@code let a = 1; let b = $a + 1; $b * 2} -> {@code (1 + 1) * 2} in
// one pass (then PartialEvaluation folds to {@code 4} if enabled).
//
// Safety:
//   - RHS purity: walked recursively, conservatively rejects any
//     FunctionExpression whose resolved {@code .func} carries the
//     {@code functionType.SideEffectFunction} stereotype (IO, random,
//     time, throw-on-error, eval-family with side-effecting target).
//     Unresolved {@code .func} (empty slot) is also conservatively
//     rejected — we can't prove it's pure.
//   - Single-use: counted respecting lexical shadowing — a nested
//     lambda re-binding {@code x} does NOT count its inner uses as
//     references to the outer let.
//   - Evaluation order: when RHS is pure, moving its evaluation point
//     from after the let to wherever {@code $x} appears is invisible
//     (no side effect is reordered). Intervening side-effecting
//     expressions are unaffected — they sit where they were and run
//     in the same relative order; only the (pure) RHS hops over them.
// ----------------------------------------------------------------------------

function meta::pure::translation::shared::singleUseLetInline(f: FunctionDefinition<Any>[1]): FunctionDefinition<Any>[1]
{
   $f->match([
      udf: UserDefinedFunction<Any>[1] |
         ^$udf(expressionSequence = $udf.expressionSequence->inlineSingleUseLetsInSequence());,
      // Lambdas pass through unchanged — same RawClosure limitation as
      // partialEvaluate / deadLetElim: a bare LambdaFunction's body slots
      // aren't directly readable through the metamodel accessors. Callers
      // that want this pass on a lambda should compose with
      // InlineOpenVariables (or LocalizeOpenVariables) — those passes
      // recompile the lambda into a UserDefinedFunction first, and the
      // strict canonical ordering guarantees they run before this one.
      other: FunctionDefinition<Any>[1] | $other
   ]);
}

// Apply single-use let inlining to one expressionSequence (a function/lambda
// body). First recurse into every expression so nested scopes (lambda bodies)
// are processed at their own boundary, then run the single-scope inliner
// over the sequence at this scope.
function meta::pure::translation::shared::inlineSingleUseLetsInSequence(exprs: ValueSpecification[*]): ValueSpecification[*]
{
   $exprs->map(e | $e->inlineSingleUseLetsRecurseIntoScopes())
         ->inlineSingleUseLetsAtThisScope();
}

// Walk the VS recursively, recursing into nested expressionSequences
// (AtomicValue-wrapped LambdaFunctions) and applying the same pass at each
// boundary. Non-scope-creating nodes (FunctionExpression, Collection) just
// propagate the walk to their children. NB: this DOES NOT inline at the
// current node — that's done by `inlineSingleUseLetsAtThisScope` after the
// parent sequence-walk returns.
function meta::pure::translation::shared::inlineSingleUseLetsRecurseIntoScopes(vs: ValueSpecification[1]): ValueSpecification[1]
{
   $vs->match([
      fe: FunctionExpression[1] |
         ^$fe(parametersValues = $fe.parametersValues->map(p | $p->inlineSingleUseLetsRecurseIntoScopes())),
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         ^$coll(values = $coll.values->map(v | $v->inlineSingleUseLetsRecurseIntoScopes())),
      av: AtomicValue[1] |
         if (!$av.value->instanceOf(LambdaFunction),
            | $av,
            | let inner = $av.value->cast(@LambdaFunction<Any>);
              let inlinedBody = $inner.expressionSequence->inlineSingleUseLetsInSequence();
              ^$av(value = ^$inner(expressionSequence = $inlinedBody));
         ),
      other: ValueSpecification[1] | $other
   ]);
}

// Process one expressionSequence: for the FIRST let-binding whose variable
// is referenced exactly once in the tail AND whose RHS is side-effect-free,
// substitute the use and drop the let; then recurse on the modified
// sequence to catch chained inlinings. If no such let exists, leave the
// sequence intact.
function meta::pure::translation::shared::inlineSingleUseLetsAtThisScope(exprs: ValueSpecification[*]): ValueSpecification[*]
{
   if ($exprs->isEmpty(),
      | [],
      | let head = $exprs->at(0);
        let tail = $exprs->drop(1);
        let varName = $head->letBoundVarName();
        if ($varName->isEmpty(),
           | [$head]->concatenate($tail->inlineSingleUseLetsAtThisScope()),
           | let name = $varName->toOne();
             let rhs = $head->cast(@FunctionExpression).parametersValues->at(1);
             let tailUses = $tail->map(e | $e->countVariableReferences($name))->fold({n, acc | $acc + $n}, 0);
             if ($tailUses == 1 && $rhs->isSideEffectFreeForInlining(),
                | let sub = ^meta::pure::translation::shared::ParamSub(name = $name, value = $rhs);
                  let inlinedTail = $tail->map(e | $e->substituteVariables([$sub]));
                  // Drop the let, restart from the modified tail (the
                  // substitution may have exposed further single-use
                  // patterns in the tail's lets).
                  $inlinedTail->inlineSingleUseLetsAtThisScope();,
                | [$head]->concatenate($tail->inlineSingleUseLetsAtThisScope())
             );
        );
   );
}

// Count VariableExpression references to `name` in a value-spec tree,
// respecting lexical shadowing in nested lambdas. Mirror of
// `referencesVariable`'s recursion but accumulating an integer count.
function meta::pure::translation::shared::countVariableReferences(vs: ValueSpecification[1], name: String[1]): Integer[1]
{
   $vs->match([
      ve: meta::pure::metamodel::valuespecification::VariableExpression[1] |
         if ($ve.name == $name, | 1, | 0);,
      fe: FunctionExpression[1] |
         $fe.parametersValues->map(p | $p->countVariableReferences($name))->fold({n, acc | $acc + $n}, 0);,
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         $coll.values->map(v | $v->countVariableReferences($name))->fold({n, acc | $acc + $n}, 0);,
      av: AtomicValue[1] |
         if (!$av.value->instanceOf(LambdaFunction),
            | 0,
            | let lam = $av.value->cast(@LambdaFunction<Any>);
              if ($lam.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression)
                     ->exists(p | $p.name == $name),
                 | 0,
                 | $lam.expressionSequence->map(e | $e->countVariableReferences($name))->fold({n, acc | $acc + $n}, 0)
              );
         ),
      other: ValueSpecification[1] | 0
   ]);
}

// Conservative "is this RHS safe to inline" walker. Recurses through
// FunctionExpression / Collection / AtomicValue-with-Lambda. A
// FunctionExpression is rejected if its `.func` is empty (unresolved, can't
// prove pure) OR if the resolved func carries the SideEffectFunction
// stereotype OR if it's an eval-family call with a side-effecting target.
// Lambda VALUES (literal closures) are inherently pure to embed — the
// lambda's body only runs when the closure is invoked, not at the position
// the RHS is moved to.
function meta::pure::translation::shared::isSideEffectFreeForInlining(vs: ValueSpecification[1]): Boolean[1]
{
   $vs->match([
      ve: meta::pure::metamodel::valuespecification::VariableExpression[1] | true,
      fe: FunctionExpression[1] |
         if ($fe.func->isEmpty(),
            | false,
            | let f = $fe.func->toOne();
              if ($f->hasSideEffect() || foldWouldTriggerEvalSideEffect($f, $fe.parametersValues),
                 | false,
                 | $fe.parametersValues->forAll(p | $p->isSideEffectFreeForInlining())
              );
         ),
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         $coll.values->forAll(v | $v->isSideEffectFreeForInlining()),
      av: AtomicValue[1] | true,
      other: ValueSpecification[1] | true
   ]);
}

// ----------------------------------------------------------------------------
// Pass — filterFusion.
//
// Collapse adjacent {@code xs->filter(p1 | c1)->filter(p2 | c2)} chains
// into a single {@code xs->filter(p | c1 && c2-with-p2-renamed-to-p)}.
// Recursion is bottom-up so 3+ filters in a chain reduce to one. {@code &&}
// is short-circuit, so the semantics match — c2 only sees elements that
// passed c1, the same as the pipelined original.
//
// Fusion only fires when both lambdas have a single parameter and a single
// body expression. Multi-expression bodies (e.g. lambdas containing
// {@code let} bindings) leave the chain alone: Pure grammar accepts only a
// single {@code combinedExpression} inside parens, so we can't form
// {@code (let x = ...; bool) && otherBool} as a valid expression. Adjacent
// single-expression pairs in a longer chain still fuse around such a pair.
//
// Variable-capture safety: if the outer lambda's body references a free
// variable named the same as the inner lambda's parameter, renaming would
// capture that reference. Such pairs are left un-fused. (Filter lambdas
// with disjoint identifier sets — the overwhelmingly common case — fuse.)
//
// Recompile-based pattern (same shape as NestedIfToMultiIf): detect at the
// compiled level, rewrite the protocol form, and feed back through
// {@code compile} so the freshly-emitted {@code and} reference resolves.
// ----------------------------------------------------------------------------

function meta::pure::translation::shared::filterFusion(f: FunctionDefinition<Any>[1]): FunctionDefinition<Any>[1]
{
   $f->match([
      udf: UserDefinedFunction<Any>[1] |
         if ($udf.expressionSequence->exists(vs | $vs->hasFusableFilterChainInVS()),
            | $udf->filterFusionViaRecompileUDF(),
            | $udf
         );,
      // Lambdas with a fusable chain are wrapped in a synthetic UDF for
      // the recompile (same pattern as inlineOpenVariablesViaRecompile)
      // and emerge as a UDF. Lambdas with no fusable chain pass through.
      lf: LambdaFunction<Any>[1] |
         if ($lf.expressionSequence->exists(vs | $vs->hasFusableFilterChainInVS()),
            | $lf->filterFusionViaRecompileLambda(),
            | $lf
         );,
      other: FunctionDefinition<Any>[1] | $other
   ]);
}

function meta::pure::translation::shared::hasFusableFilterChainInVS(vs: ValueSpecification[1]): Boolean[1]
{
   $vs->match([
      fe: FunctionExpression[1] |
         $fe->isFusableFilterPair() || $fe.parametersValues->exists(p | $p->hasFusableFilterChainInVS()),
      av: AtomicValue[1] |
         if ($av.value->instanceOf(LambdaFunction),
            | $av.value->cast(@LambdaFunction<Any>).expressionSequence->exists(e | $e->hasFusableFilterChainInVS()),
            | false
         ),
      col: meta::pure::metamodel::valuespecification::Collection[1] |
         $col.values->exists(v | $v->hasFusableFilterChainInVS()),
      other: ValueSpecification[1] | false
   ]);
}

// Compiled-side check: arity-2 `filter` whose first param is itself an
// arity-2 `filter`. Both lambdas must be single-param, single-body-
// expression and pass the capture-safety check.
function meta::pure::translation::shared::isFusableFilterPair(fe: FunctionExpression[1]): Boolean[1]
{
   if (!($fe.functionName == 'filter' && $fe.parametersValues->size() == 2),
      | false,
      | let outerLam = $fe.parametersValues->at(1)->extractFilterLambda();
        if ($outerLam->isEmpty(),
           | false,
           | let recv = $fe.parametersValues->at(0);
             if (!$recv->instanceOf(FunctionExpression),
                | false,
                | let inner = $recv->cast(@FunctionExpression);
                  if (!($inner.functionName == 'filter' && $inner.parametersValues->size() == 2),
                     | false,
                     | let innerLam = $inner.parametersValues->at(1)->extractFilterLambda();
                       if ($innerLam->isEmpty(),
                          | false,
                          | filterLambdasFuseSafely($innerLam->toOne(), $outerLam->toOne())
                       );
                  );
             );
        );
   );
}

// Returns the compiled LambdaFunction iff `vs` is an AtomicValue wrapping a
// LambdaFunction with exactly one parameter and one body expression.
function meta::pure::translation::shared::extractFilterLambda(vs: ValueSpecification[1]): LambdaFunction<Any>[0..1]
{
   if (!$vs->instanceOf(AtomicValue),
      | []->cast(@LambdaFunction<Any>),
      | let av = $vs->cast(@AtomicValue);
        if (!$av.value->instanceOf(LambdaFunction),
           | []->cast(@LambdaFunction<Any>),
           | let lam = $av.value->cast(@LambdaFunction<Any>);
             if (!($lam.parameters->size() == 1 && $lam.expressionSequence->size() == 1),
                | []->cast(@LambdaFunction<Any>),
                | $lam
             );
        );
   );
}

// Capture-safety: when outer's param name differs from inner's, the outer
// body will be rewritten to use inner's name. Refuse if the outer body
// references the inner name as a free variable (would be captured by the
// rename). When names match no rename is needed and any pair fuses.
function meta::pure::translation::shared::filterLambdasFuseSafely(
   innerLam: LambdaFunction<Any>[1],
   outerLam: LambdaFunction<Any>[1]
): Boolean[1]
{
   let innerName = $innerLam.parameters->at(0)->cast(@meta::pure::metamodel::valuespecification::VariableExpression).name->toOne();
   let outerName = $outerLam.parameters->at(0)->cast(@meta::pure::metamodel::valuespecification::VariableExpression).name->toOne();
   if ($innerName == $outerName,
      | true,
      | !$outerLam.expressionSequence->at(0)->referencesVariable($innerName)
   );
}

function meta::pure::translation::shared::filterFusionViaRecompileUDF(udf: UserDefinedFunction<Any>[1]): UserDefinedFunction<Any>[1]
{
   let funcType = $udf.classifierGenericType.typeArguments
                     ->at(0)
                     ->rawType()
                     ->toOne('filterFusion: UDF missing classifier function type')
                     ->cast(@meta::pure::metamodel::type::FunctionType);
   filterFusionRecompileFromParts(
      $udf.expressionSequence,
      $udf.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression),
      $funcType.returnType,
      $funcType.returnMultiplicity
   );
}

function meta::pure::translation::shared::filterFusionViaRecompileLambda(lambda: LambdaFunction<Any>[1]): UserDefinedFunction<Any>[1]
{
   let funcType = $lambda.classifierGenericType.typeArguments
                     ->at(0)
                     ->rawType()
                     ->toOne('filterFusion: lambda missing classifier function type')
                     ->cast(@meta::pure::metamodel::type::FunctionType);
   filterFusionRecompileFromParts(
      $lambda.expressionSequence,
      $lambda.parameters,
      $funcType.returnType,
      $funcType.returnMultiplicity
   );
}

function meta::pure::translation::shared::filterFusionRecompileFromParts(
   expressionSequence: ValueSpecification[*],
   parameters: meta::pure::metamodel::valuespecification::VariableExpression[*],
   returnType: GenericType[1],
   returnMultiplicity: meta::pure::metamodel::multiplicity::Multiplicity[1]
): UserDefinedFunction<Any>[1]
{
   let canonicalPkg  = '__canonical__';
   let canonicalName = '__canonical__';
   let protoUDF = toProtocolUserDefinedFunction(
      $expressionSequence,
      $parameters,
      $returnType,
      $returnMultiplicity,
      newMap([]->cast(@Pair<String, List<Any>>)),
      $canonicalPkg,
      $canonicalName
   );
   let rewritten = ^$protoUDF(
      expressionSequence = $protoUDF.expressionSequence->map(e | $e->fuseFiltersProtocol())
   );
   let pf = ^meta::pure::protocol::PureFile(
      sourceId = '__canonical_filter_fusion__.pure',
      sections = [^meta::pure::protocol::Section(
         parserName = 'Pure',
         imports    = [],
         elements   = [$rewritten]
      )]
   );
   let result = meta::pure::compiler::compile(
      [$pf],
      meta::pure::compiler::newCompilerContext(false),
      false,
      true
   );
   $result.context->toOne().elementMap->values()
      ->filter(e | $e->instanceOf(UserDefinedFunction))
      ->cast(@UserDefinedFunction<Any>)
      ->filter(u | $u.functionName == $canonicalName)
      ->toOne('filterFusion: function not found after recompile; errors=' + $result.errors->joinStrings(' | '));
}

// Protocol-AST walk — recurse first so inner filter chains are fused before
// we look at the outer one. Mirrors rewriteIfsToMultiIfProtocol. Both
// FunctionInvocation (prefix call `filter(xs, lam)`) and ArrowInvocation
// (`xs->filter(lam)`) participate: decompile emits the FunctionInvocation
// shape, but the fusion output is ArrowInvocation, so the outer pass over
// a chain that already fused once-inside sees ArrowInvocation as its inner
// receiver.
function meta::pure::translation::shared::fuseFiltersProtocol(
   vs: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   $vs->match([
      fi: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
         let recursed = $fi.parametersValues->map(p | $p->fuseFiltersProtocol());
         tryFuseFilterPairProtocol($fi.functionName, $recursed, $fi);,
      ai: meta::pure::protocol::grammar::valuespecification::ArrowInvocation[1] |
         let recursed = $ai.parametersValues->map(p | $p->fuseFiltersProtocol());
         tryFuseFilterPairProtocol($ai.functionName, $recursed, $ai);,
      da: meta::pure::protocol::grammar::valuespecification::DotApplication[1] |
         ^$da(parametersValues = $da.parametersValues->map(p | $p->fuseFiltersProtocol())),
      col: meta::pure::protocol::grammar::valuespecification::Collection[1] |
         ^$col(values = $col.values->map(v | $v->fuseFiltersProtocol())),
      av: meta::pure::protocol::grammar::valuespecification::AtomicValue[1] |
         // Lambdas land here via either decompile pass-through (compiled
         // LambdaFunction PDO) or after a prior recursion (protocol
         // LambdaFunction). Walk into the body and rebuild the AV cleanly
         // (matching the grammar — see `mapping_value_spec.pure`: the parser
         // emits the AV with `value` only and leaves
         // `genericType`/`multiplicity` empty so the compiler infers them at
         // resolution). Reusing the upstream AV via `^$av(value = ...)`
         // would carry forward the decompiler's `CompilerNotSetMultiplicity`
         // sentinel, which then survives compile and trips
         // `printMultiplicity`.
         if ($av.value->instanceOf(meta::pure::metamodel::function::LambdaFunction),
            | let innerCompiled = $av.value->cast(@meta::pure::metamodel::function::LambdaFunction<Any>);
              let innerProto = $innerCompiled.expressionSequence
                                 ->map(e | $e->toProtocolValueSpec(newMap([]->cast(@Pair<String, List<Any>>))))
                                 ->map(e | $e->fuseFiltersProtocol());
              let newLam = ^meta::pure::protocol::grammar::function::LambdaFunction(
                 parameters         = $innerCompiled.parameters
                                         ->map(p | $p->toProtocolParameter()),
                 expressionSequence = $innerProto
              );
              ^meta::pure::protocol::grammar::valuespecification::AtomicValue(value = $newLam);,
            | if ($av.value->instanceOf(meta::pure::protocol::grammar::function::LambdaFunction),
                 | let pl = $av.value->cast(@meta::pure::protocol::grammar::function::LambdaFunction);
                   ^meta::pure::protocol::grammar::valuespecification::AtomicValue(
                      value = ^$pl(expressionSequence = $pl.expressionSequence->map(e | $e->fuseFiltersProtocol()))
                   );,
                 | $av
              )
         ),
      other: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1] | $other
   ]);
}

// If `(name, recursed)` is an arity-2 `filter` call whose receiver (post-
// recursion) is also an arity-2 `filter` call, and both lambdas are
// fuse-shaped + capture-safe, build the combined `filter(innerReceiver,
// fusedLambda)` as a fresh ArrowInvocation. Otherwise return the original
// node (`originalFE`) with the recursed parametersValues spliced back in,
// preserving its concrete subtype (FunctionInvocation / ArrowInvocation).
function meta::pure::translation::shared::tryFuseFilterPairProtocol(
   name: String[1],
   recursed: meta::pure::protocol::grammar::valuespecification::ValueSpecification[*],
   originalFE: meta::pure::protocol::grammar::valuespecification::FunctionExpression[1]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   if (!($name == 'filter' && $recursed->size() == 2),
      | rebuildFEWithParams($originalFE, $recursed),
      | let outerLam = $recursed->at(1)->extractFilterLambdaProtocol();
        if ($outerLam->isEmpty(),
           | rebuildFEWithParams($originalFE, $recursed),
           | let recv = $recursed->at(0);
             let innerCall = protocolFilterCall($recv);
             if ($innerCall->isEmpty(),
                | rebuildFEWithParams($originalFE, $recursed),
                | let innerParams = $innerCall->toOne().parametersValues;
                  let innerLam = $innerParams->at(1)->extractFilterLambdaProtocol();
                  if ($innerLam->isEmpty() || !filterLambdasFuseSafelyProtocol($innerLam->toOne(), $outerLam->toOne()),
                     | rebuildFEWithParams($originalFE, $recursed),
                     | buildFusedFilterProtocol($innerParams->at(0), $innerLam->toOne(), $outerLam->toOne())
                  );
             );
        );
   );
}

// Returns the FunctionExpression iff `vs` is an arity-2 `filter` call (in
// either FunctionInvocation or ArrowInvocation form). Both subtypes share
// parametersValues + functionName via FunctionExpression.
function meta::pure::translation::shared::protocolFilterCall(
   vs: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
): meta::pure::protocol::grammar::valuespecification::FunctionExpression[0..1]
{
   $vs->match([
      fi: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
         if ($fi.functionName == 'filter' && $fi.parametersValues->size() == 2, | $fi, | []->cast(@meta::pure::protocol::grammar::valuespecification::FunctionExpression));,
      ai: meta::pure::protocol::grammar::valuespecification::ArrowInvocation[1] |
         if ($ai.functionName == 'filter' && $ai.parametersValues->size() == 2, | $ai, | []->cast(@meta::pure::protocol::grammar::valuespecification::FunctionExpression));,
      other: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1] |
         []->cast(@meta::pure::protocol::grammar::valuespecification::FunctionExpression)
   ]);
}

// Rebuild the FE with a fresh parametersValues, preserving its concrete
// subtype (FunctionInvocation / ArrowInvocation / DotApplication). The
// protocol's FunctionExpression doesn't have a uniform copy constructor,
// so dispatch on the concrete subtype.
function meta::pure::translation::shared::rebuildFEWithParams(
   fe: meta::pure::protocol::grammar::valuespecification::FunctionExpression[1],
   params: meta::pure::protocol::grammar::valuespecification::ValueSpecification[*]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   $fe->match([
      fi: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] | ^$fi(parametersValues = $params),
      ai: meta::pure::protocol::grammar::valuespecification::ArrowInvocation[1] | ^$ai(parametersValues = $params),
      da: meta::pure::protocol::grammar::valuespecification::DotApplication[1] | ^$da(parametersValues = $params),
      other: meta::pure::protocol::grammar::valuespecification::FunctionExpression[1] | $other
   ]);
}

// Protocol-side mirror of extractFilterLambda. Returns the LambdaFunction
// iff `vs` is `AtomicValue(value=LambdaFunction)` with exactly one parameter
// and one body expression.
function meta::pure::translation::shared::extractFilterLambdaProtocol(
   vs: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
): meta::pure::protocol::grammar::function::LambdaFunction[0..1]
{
   if (!$vs->instanceOf(meta::pure::protocol::grammar::valuespecification::AtomicValue),
      | []->cast(@meta::pure::protocol::grammar::function::LambdaFunction),
      | let av = $vs->cast(@meta::pure::protocol::grammar::valuespecification::AtomicValue);
        if (!$av.value->instanceOf(meta::pure::protocol::grammar::function::LambdaFunction),
           | []->cast(@meta::pure::protocol::grammar::function::LambdaFunction),
           | let lam = $av.value->cast(@meta::pure::protocol::grammar::function::LambdaFunction);
             if (!($lam.parameters->size() == 1 && $lam.expressionSequence->size() == 1),
                | []->cast(@meta::pure::protocol::grammar::function::LambdaFunction),
                | $lam
             );
        );
   );
}

// Protocol-side capture-safety check — same logic as the compiled-side
// variant but walking protocol VS shapes.
function meta::pure::translation::shared::filterLambdasFuseSafelyProtocol(
   innerLam: meta::pure::protocol::grammar::function::LambdaFunction[1],
   outerLam: meta::pure::protocol::grammar::function::LambdaFunction[1]
): Boolean[1]
{
   let innerName = $innerLam.parameters->at(0).name;
   let outerName = $outerLam.parameters->at(0).name;
   if ($innerName == $outerName,
      | true,
      | !$outerLam.expressionSequence->at(0)->protocolReferencesVariable($innerName)
   );
}

// Build the fused filter call: `innerReceiver->filter(p | innerBody && outerBody-renamed)`.
// The combined lambda reuses the inner lambda's parameter (preserving any
// type annotation), and the outer body's references to its own parameter
// are renamed to the inner name so the combined body type-checks.
function meta::pure::translation::shared::buildFusedFilterProtocol(
   receiver: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1],
   innerLam: meta::pure::protocol::grammar::function::LambdaFunction[1],
   outerLam: meta::pure::protocol::grammar::function::LambdaFunction[1]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   let innerParam = $innerLam.parameters->at(0);
   let innerBody = $innerLam.expressionSequence->at(0);
   let outerBody0 = $outerLam.expressionSequence->at(0);
   let outerBody = if ($innerParam.name == $outerLam.parameters->at(0).name,
                       | $outerBody0,
                       | $outerBody0->renameProtocolVariable($outerLam.parameters->at(0).name, $innerParam.name)
                      );
   let andCall = ^meta::pure::protocol::grammar::valuespecification::FunctionInvocation(
      functionName     = 'and',
      parametersValues = [$innerBody, $outerBody]
   );
   let fusedLam = ^meta::pure::protocol::grammar::function::LambdaFunction(
      parameters         = [$innerParam],
      expressionSequence = [$andCall]
   );
   // Match the grammar shape for an AtomicValue wrapping a lambda — see
   // `mapping_value_spec.pure :: buildLambdaFunction` and its call sites:
   // the parser emits the AV with `value` set and leaves
   // `genericType`/`multiplicity` empty so the compiler infers them at
   // resolution. Emitting `CompilerNotSetGenericType`/`CompilerNotSetMultiplicity`
   // sentinels here would survive into the compiled output (latent bug in
   // setMissingLambdaParameterInformation when the lambda body has a
   // multi-expression sequence) and trip `printMultiplicity` on a value
   // it doesn't have an arm for.
   let fusedAV = ^meta::pure::protocol::grammar::valuespecification::AtomicValue(
      value = $fusedLam
   );
   // Emit ArrowInvocation so the recompiled form prints as `xs->filter(...)`
   // rather than the prefix `filter(xs, ...)`. The original source-side
   // shape is overwhelmingly arrow form for chained filters; matching it
   // preserves readability of the canonical output.
   ^meta::pure::protocol::grammar::valuespecification::ArrowInvocation(
      functionName     = 'filter',
      parametersValues = [$receiver, $fusedAV]
   );
}

// Protocol-AST variable rename. Walks down the tree replacing every
// VariableExpression(name=from) with VariableExpression(name=to). Respects
// lexical shadowing — does not descend into a lambda that re-binds `from`.
function meta::pure::translation::shared::renameProtocolVariable(
   vs: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1],
   from: String[1],
   to: String[1]
): meta::pure::protocol::grammar::valuespecification::ValueSpecification[1]
{
   $vs->match([
      ve: meta::pure::protocol::grammar::valuespecification::VariableExpression[1] |
         if ($ve.name == $from, | ^$ve(name = $to), | $ve);,
      fi: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
         ^$fi(parametersValues = $fi.parametersValues->map(p | $p->renameProtocolVariable($from, $to))),
      da: meta::pure::protocol::grammar::valuespecification::DotApplication[1] |
         ^$da(parametersValues = $da.parametersValues->map(p | $p->renameProtocolVariable($from, $to))),
      col: meta::pure::protocol::grammar::valuespecification::Collection[1] |
         ^$col(values = $col.values->map(v | $v->renameProtocolVariable($from, $to))),
      av: meta::pure::protocol::grammar::valuespecification::AtomicValue[1] |
         if (!$av.value->instanceOf(meta::pure::protocol::grammar::function::LambdaFunction),
            | $av,
            | let lam = $av.value->cast(@meta::pure::protocol::grammar::function::LambdaFunction);
              if ($lam.parameters->exists(p | $p.name == $from),
                 // shadowed by an inner lambda parameter — don't descend
                 | $av,
                 | ^$av(value = ^$lam(
                      expressionSequence = $lam.expressionSequence->map(e | $e->renameProtocolVariable($from, $to))
                   ))
              );
         ),
      other: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1] | $other
   ]);
}

// Protocol-side mirror of `referencesVariable`. Does `vs` reference a
// VariableExpression named `name` anywhere in its subtree, respecting
// lexical shadowing in nested lambdas.
function meta::pure::translation::shared::protocolReferencesVariable(
   vs: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1],
   name: String[1]
): Boolean[1]
{
   $vs->match([
      ve: meta::pure::protocol::grammar::valuespecification::VariableExpression[1] |
         $ve.name == $name,
      fi: meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
         $fi.parametersValues->exists(p | $p->protocolReferencesVariable($name)),
      da: meta::pure::protocol::grammar::valuespecification::DotApplication[1] |
         $da.parametersValues->exists(p | $p->protocolReferencesVariable($name)),
      col: meta::pure::protocol::grammar::valuespecification::Collection[1] |
         $col.values->exists(v | $v->protocolReferencesVariable($name)),
      av: meta::pure::protocol::grammar::valuespecification::AtomicValue[1] |
         if (!$av.value->instanceOf(meta::pure::protocol::grammar::function::LambdaFunction),
            | false,
            | let lam = $av.value->cast(@meta::pure::protocol::grammar::function::LambdaFunction);
              if ($lam.parameters->exists(p | $p.name == $name),
                 | false,
                 | $lam.expressionSequence->exists(e | $e->protocolReferencesVariable($name))
              );
         ),
      other: meta::pure::protocol::grammar::valuespecification::ValueSpecification[1] | false
   ]);
}

// ============================================================================
// Compile bridge — recompiling a protocol fragment resolves references to
// the currently-loaded universe via the compile pipeline's existing
// live-registry fallbacks:
//   - `findFunctionsByNameAndArity` native unions the local function index
//     with the live PDB function index (see
//     findAllFunctionsByNameAndArityUnfiltered in compilerContext.pure).
//   - `pathToElementInContext` falls through to `lenientPathToElement` (the
//     live element resolver) when a path isn't in elementMap.
//   - `findAllTypes` provides the universe-side of buildLinearizationCache.
//
// Net effect: we can call `meta::pure::compiler::compile([pf], newCompilerContext(false), ...)`
// and references to already-loaded elements (plus, filter, CO_Person, ...)
// resolve without manually seeding elementMap. The seeding only matters
// when running in a context where the live registry isn't reachable (e.g.
// detached compile in CI tooling), which isn't our case.
// ============================================================================

// ============================================================================
// β-reduction support — substitute VariableExpression references in a
// ValueSpecification tree with replacement expressions. Used by the Java
// translator's evalCoder to inline `funcRef->eval(args)` patterns: Pure
// η-expands function references into wrapping lambdas, and the cast-to-
// Function path emits typed Java lambdas that don't satisfy Java's
// invariant generics. Inlining the lambda body with eval args substituted
// for the parameters collapses to a direct call that the per-function
// coder can handle as if it were written {@code fn(arg)} directly.
// ============================================================================

Class meta::pure::translation::shared::ParamSub
{
   name  : String[1];
   value : ValueSpecification[1];
}

function meta::pure::translation::shared::substituteVariables(
   vs: ValueSpecification[1],
   subs: meta::pure::translation::shared::ParamSub[*]
): ValueSpecification[1]
{
   $vs->match([
      ve: meta::pure::metamodel::valuespecification::VariableExpression[1] |
         substituteVariableLookup($ve, $subs),
      fe: FunctionExpression[1] |
         ^$fe(parametersValues = $fe.parametersValues->map(p | $p->substituteVariables($subs))),
      coll: meta::pure::metamodel::valuespecification::Collection[1] |
         ^$coll(values = $coll.values->map(v | $v->substituteVariables($subs))),
      av: AtomicValue[1] |
         substituteVariablesInAtomicValue($av, $subs),
      other: ValueSpecification[1] | $other
   ]);
}

// Single-VariableExpression lookup. Match-arm bodies in Pure can't hold a
// {@code let} followed by a non-trailing expression, so we extract this
// to its own function rather than inline-letting in the match arm.
function meta::pure::translation::shared::substituteVariableLookup(
   ve: meta::pure::metamodel::valuespecification::VariableExpression[1],
   subs: meta::pure::translation::shared::ParamSub[*]
): ValueSpecification[1]
{
   let hit = $subs->filter(s | $s.name == $ve.name);
   if ($hit->isEmpty(), | $ve, | $hit->at(0).value);
}

// AtomicValue may wrap a LambdaFunction; recurse with proper lexical
// scoping (drop subs that the inner lambda re-binds).
function meta::pure::translation::shared::substituteVariablesInAtomicValue(
   av: AtomicValue[1],
   subs: meta::pure::translation::shared::ParamSub[*]
): ValueSpecification[1]
{
   if ($av.value->isNotEmpty() && $av.value->toOne()->instanceOf(LambdaFunction),
      | let inner   = $av.value->toOne()->cast(@LambdaFunction<Any>);
        let shadow  = $inner.parameters->map(p | $p.name);
        let inner2  = $subs->filter(s | !$shadow->contains($s.name));
        let body2   = $inner.expressionSequence->map(e | $e->substituteVariables($inner2));
        ^$av(value = ^$inner(expressionSequence = $body2));,
      | $av
   );
}
