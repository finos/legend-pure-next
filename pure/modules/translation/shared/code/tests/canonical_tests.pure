import meta::pure::functions::asserts::*;
import meta::pure::functions::printer::compiled::*;
import meta::pure::functions::printer::protocol::*;
import meta::pure::metamodel::function::*;
import meta::pure::translation::shared::*;
import meta::pure::translation::shared::tests::*;
import meta::pure::translation::shared::tests::model::*;

// ============================================================================
// Canonical / decompile round-trip tests.
//
// Each <<test.Test>> below picks a fixture lambda, runs it through:
//
//   1. `decompileAndPrint` — invoke the decompile pipeline on the lambda's
//      compiled body, produce a protocol UserDefinedFunction with captures
//      substituted, render via the protocol printer. Assert the resulting
//      Pure source verbatim.
//
//   2. `canonicalAndPrint` — invoke `makeCanonical` (full pipeline: decompile
//      + recompile + dead-code-elim), render the compiled result via the
//      compiled printer. Assert the resulting Pure source verbatim.
//
// Tests rely on the Truffle compile pipeline being available at runtime
// (parse + compile natives + live-registry fallbacks). Bootstrap registers
// a different natives surface, so they're effectively Truffle-only.
//
// Notes on the rendered shape:
//
//   - Decompile uses the synthetic wrapping name `canonicalTest::fixture`
//     (passed into `toProtocolUserDefinedFunction`) and renders types via
//     full FQN paths because the protocol metamodel stores them that way.
//
//   - Canonical comes back via `inlineOpenVariablesViaRecompile`, which
//     wraps under `__canonical__::__canonical__` and goes through the
//     full compile path. The compiled printer uses short names for types
//     (the standard `Integer[1]` form) but emits FQN for non-built-in
//     function calls (e.g. `meta::pure::functions::string::length`).
// ============================================================================

Class <<test.TestDependency>> meta::pure::translation::shared::tests::model::TS_Person
{
   firstName : String[1];
   lastName  : String[1];
}

// ----------------------------------------------------------------------------
// Helpers
// ----------------------------------------------------------------------------

// Decompile a lambda into its protocol UserDefinedFunction form (with all
// open-variable captures substituted by their values' protocol form), then
// render via the protocol printer. The wrapping function is synthesised
// under `canonicalTest::fixture` so the printed source has a stable name.
function <<test.TestDependency>> meta::pure::translation::shared::tests::decompileAndPrint(lambda: LambdaFunction<Any>[1]): String[1]
{
   // Mirror `inlineOpenVariablesViaRecompile`: strip let-bound names from
   // the capture set so we don't substitute `$letVar` references with the
   // empty-Collection sentinel returned by openVariableValues for them.
   let allCaptures = $lambda->meta::pure::functions::meta::openVariableValues();
   let letBoundNames = $lambda.expressionSequence
                          ->filter(vs | $vs->instanceOf(meta::pure::metamodel::valuespecification::FunctionExpression))
                          ->cast(@meta::pure::metamodel::valuespecification::FunctionExpression)
                          ->filter(fe | $fe.functionName == 'letFunction'
                                     && $fe.parametersValues->size() == 2
                                     && $fe.parametersValues->at(0)->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue))
                          ->map(fe | $fe.parametersValues->at(0)
                                       ->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value
                                       ->cast(@String));
   let captures = $allCaptures->keys()
                     ->filter(k | !$letBoundNames->contains($k))
                     ->fold({k, acc | $acc->put($k, $allCaptures->get($k)->toOne())},
                            newMap([]->cast(@Pair<String, List<Any>>)));
   // The lambda's return type lives on its classifier
   // (`LambdaFunction<{params -> ret}>`), not on a dedicated slot.
   let funcType = $lambda.classifierGenericType.typeArguments
                     ->at(0)
                     ->rawType()
                     ->toOne('decompileAndPrint: lambda missing classifier function type')
                     ->cast(@meta::pure::metamodel::type::FunctionType);
   let proto = toProtocolUserDefinedFunction(
      $lambda.expressionSequence,
      $lambda.parameters,
      $funcType.returnType,
      $funcType.returnMultiplicity,
      $captures,
      'canonicalTest',
      'fixture'
   );
   // Base printer keeps FQN intact (corpus tests rely on byte-roundtrip).
   // Post-process to drop auto-imported package prefixes so test assertions
   // can stay in the short, human-readable form.
   meta::pure::functions::printer::protocol::shortenAutoImportedTypesInString(
      printProtocolUserDefinedFunction($proto)
   );
}

// Run `makeCanonical` (full pipeline with default modes — back-compat) and
// render the compiled result. UDF outputs go through the compiled element
// printer; lambdas that pass through unchanged are rendered via the
// compiled-lambda printer (`|<body>`).
function <<test.TestDependency>> meta::pure::translation::shared::tests::canonicalAndPrint(lambda: LambdaFunction<Any>[1]): String[1]
{
   printCanonical($lambda, $lambda->meta::pure::translation::shared::makeCanonical());
}

// Run `makeCanonical` with an explicit mode list and render. Same
// dispatch as `canonicalAndPrint`.
function <<test.TestDependency>> meta::pure::translation::shared::tests::canonicalAndPrintWithModes(
   lambda: LambdaFunction<Any>[1],
   modes: meta::pure::translation::shared::CanonicalMode[*]
): String[1]
{
   printCanonical($lambda, $lambda->meta::pure::translation::shared::makeCanonical($modes));
}

function <<test.TestDependency>> meta::pure::translation::shared::tests::printCanonical(
   original: LambdaFunction<Any>[1],
   canonical: FunctionDefinition<Any>[1]
): String[1]
{
   $canonical->match([
      udf: UserDefinedFunction<Any>[1] |
         printCompiledElements(
            [$udf->cast(@meta::pure::metamodel::PackageableElement)],
            meta::pure::functions::printer::compiled::PrintMode.ManageImports
         ),
      lf: LambdaFunction<Any>[1] |
         // Lambda kept its shape (PartialEvaluation alone, or InlineOpen on
         // a no-capture lambda). Render the lambda body so a fold inside is
         // visible.
         printCanonicalLambda($lf)
   ]);
}

function <<test.TestDependency>> meta::pure::translation::shared::tests::printCanonicalLambda(lf: LambdaFunction<Any>[1]): String[1]
{
   let ctx = meta::pure::functions::printer::compiled::buildPrintContext(
      []->cast(@meta::pure::metamodel::PackageableElement),
      meta::pure::functions::printer::compiled::PrintMode.ManageImports
   );
   meta::pure::functions::printer::compiled::printCompiledLambdaFunction($lf, $ctx);
}

// ----------------------------------------------------------------------------
// Fixtures + assertions
// ----------------------------------------------------------------------------

// Scalar Integer capture: a single Integer captured by the lambda.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_scalarIntegerCapture(): Boolean[1]
{
   let x = 5;
   let lambda = {| $x + 1};

   assertEquals(
      '''
      function canonicalTest::fixture(): Integer[1]
      {
        5 + 1
      }
      ''',
      decompileAndPrint($lambda)
   );

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        5 + 1
      }
      ''',
      canonicalAndPrint($lambda)
   );
}

// String capture: a captured String literal.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_stringCapture(): Boolean[1]
{
   let s = 'hello';
   let lambda = {| $s->length()};

   // Decompile prints the arrow call in prefix form (`length('hello')`) —
   // the protocol printer doesn't recover the arrow-receiver shape from
   // the lifted FunctionInvocation.
   assertEquals(
      '''
      function canonicalTest::fixture(): Integer[1]
      {
        length('hello')
      }
      ''',
      decompileAndPrint($lambda)
   );

   // Canonical uses `ManageImports` print mode, so `length` (in
   // `meta::pure::functions::string`, a default-imported package) appears
   // as its short name.
   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        length('hello')
      }
      ''',
      canonicalAndPrint($lambda)
   );
}

// Multiple captures: two captured Integers, both substituted independently.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_multipleCaptures(): Boolean[1]
{
   let a = 1;
   let b = 2;
   let lambda = {| $a + $b};

   assertEquals(
      '''
      function canonicalTest::fixture(): Integer[1]
      {
        1 + 2
      }
      ''',
      decompileAndPrint($lambda)
   );

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        1 + 2
      }
      ''',
      canonicalAndPrint($lambda)
   );
}

// No captures: decompile still produces a wrapped UDF (the wrapping is
// unconditional); canonical short-circuits and returns the LambdaFunction
// unchanged — the compiled-lambda printer renders it as `|1 + 2`.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_noCaptures(): Boolean[1]
{
   let lambda = {| 1 + 2};

   assertEquals(
      '''
      function canonicalTest::fixture(): Integer[1]
      {
        1 + 2
      }
      ''',
      decompileAndPrint($lambda)
   );

   assertEquals(
      '|1 + 2',
      canonicalAndPrint($lambda)
   );
}

// ----------------------------------------------------------------------------
// Mode-additivity tests — show that each pass can run independently and
// that combining them in either order yields the additively-reduced AST.
// ----------------------------------------------------------------------------

// InlineOpenVariables ALONE — captures inlined but the resulting literal
// arithmetic is left in place (`5 + 1`, not `6`). Same shape as the
// default `makeCanonical(f)`.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_inlineOnly_keepsLiteralArithmetic(): Boolean[1]
{
   let x = 5;
   let lambda = {| $x + 1};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        5 + 1
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables]
      )
   );
}

// Inline + PartialEval applied together — captures inlined, then
// arithmetic folded. Demonstrates additivity: `[Inline, Partial]` produces
// a strictly smaller AST than `[Inline]` alone.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_inlineThenPartial_reducesToLiteral(): Boolean[1]
{
   let x = 5;
   let lambda = {| $x + 1};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        6
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.PartialEvaluation]
      )
   );
}

// PartialEvaluation ALONE on a captured lambda — captures remain (no
// inlining), so the literal-only fold rule can't fire on `$x + 1` (one
// operand is a VariableExpression). Lambda passes through unchanged.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_partialOnly_cantFoldAcrossCaptures(): Boolean[1]
{
   let x = 5;
   let lambda = {| $x + 1};

   assertEquals(
      '|$x + 1',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.PartialEvaluation]
      )
   );
}

// Empty mode list — explicit no-op. Lambda passes through unchanged.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_emptyModes_isNoOp(): Boolean[1]
{
   let lambda = {| 1 + 2};

   assertEquals(
      '|1 + 2',
      canonicalAndPrintWithModes($lambda, [])
   );
}

// ----------------------------------------------------------------------------
// LocalizeOpenVariables — keep captured `$name` references and bind each one
// with a `let name = <value>;` at the top of the body, rather than inlining
// the value at every use site (the InlineOpenVariables behaviour).
// ----------------------------------------------------------------------------

// Scalar Integer capture: instead of `5 + 1` (inline), the capture stays a
// variable and a leading `let x = 5;` binds it. Contrast with
// testCanonical_scalarIntegerCapture / testCanonical_inlineOnly_*.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_localize_scalarCapture(): Boolean[1]
{
   let x = 5;
   let lambda = {| $x + 1};

   assertEquals(
      '''
      ###Pure
      function <<test.TestDependency>> __canonical__::__canonical__(): Integer[1]
      {
        let x = 5;
        $x + 1;
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.LocalizeOpenVariables]
      )
   );
}

// String capture: the binding RHS is lowered the same way inline lowers it
// (`'hi'`), but `$s` survives in the body as a let-bound reference.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_localize_stringCapture(): Boolean[1]
{
   let s = 'hi';
   let lambda = {| $s->length()};

   assertEquals(
      '''
      ###Pure
      function <<test.TestDependency>> __canonical__::__canonical__(): Integer[1]
      {
        let s = 'hi';
        length($s);
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.LocalizeOpenVariables]
      )
   );
}

// ----------------------------------------------------------------------------
// PartialEvaluation — eval-based generalization
//
// The fold isn't hard-coded per-native; ANY all-literal FunctionExpression
// gets wrapped in `tryEval(| evaluate(func, argLists))` and replaced with
// its result. These tests pin the coverage that buys us — comparisons,
// boolean ops, string predicates — none of which had per-native arms in
// the previous implementation.
// ----------------------------------------------------------------------------

// Comparison: `5 < 10` folds to `true` via the eval path.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_partial_evalsComparison(): Boolean[1]
{
   let x = 5;
   let lambda = {| $x < 10};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Boolean[1]
      {
        true
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.PartialEvaluation]
      )
   );
}

// String predicate: `'hello'->startsWith('he')` folds to `true`.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_partial_evalsStringPredicate(): Boolean[1]
{
   let s = 'hello';
   let lambda = {| $s->startsWith('he')};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Boolean[1]
      {
        true
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.PartialEvaluation]
      )
   );
}

// Bottom-up walk — inner sub-expressions fold first so the outer one sees
// literal args. `(2 + 3) * 4` folds inside-out to `5 * 4` → `20`.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_partial_foldsNestedArithmetic(): Boolean[1]
{
   let x = 2;
   let lambda = {| ($x + 3) * 4};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        20
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.PartialEvaluation]
      )
   );
}

// Composed: PartialEvaluation folds a comparison cond, then IfBranchPruning
// collapses the if to the taken branch. This is the chain reaction the
// generalization unlocks — the old per-native code never folded `<`, so
// pruning couldn't fire.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_partialThenPrune_collapsesIfWithComparedCond(): Boolean[1]
{
   let x = 5;
   let lambda = {| if($x < 10, |'small', |'big')};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): String[1]
      {
        'small'
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.PartialEvaluation,
          meta::pure::translation::shared::CanonicalMode.IfBranchPruning]
      )
   );
}

// Collection arg — generic fold reaches into a Collection of literal
// AtomicValues, hands it off to evaluate() as a single List<Any>, and the
// runtime computes the result. Demonstrates that the predicate is "constant
// subtree" not "primitive scalar". The bottom-up walk then folds `0 + 3`
// to `3` as well, so the entire body collapses to a single literal.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_partial_evalsOnCollectionArg(): Boolean[1]
{
   let marker = 0;
   let lambda = {| $marker + [10, 20, 30]->size()};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        3
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.PartialEvaluation]
      )
   );
}

// Side-effect skip: `print` is tagged `<<functionType.SideEffectFunction>>`
// (see `runtime/functions/io/print.pure`). Even with all-literal args,
// PartialEvaluation must leave the call alone — folding would execute the
// print at translation time, losing the runtime side effect.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_partial_skipsSideEffectFunction(): Boolean[1]
{
   let prefix = 'msg=';
   let lambda = {| $prefix + meta::pure::functions::io::print('hi')};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): String[1]
      {
        'msg=' + print('hi')
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.PartialEvaluation]
      )
   );
}

// ----------------------------------------------------------------------------
// NestedIfToMultiIf / IfBranchPruning
//
// Fixture design notes:
//   - These passes only run on UserDefinedFunctions; lambdas pass through
//     unchanged. To force UDF promotion via `InlineOpenVariables` we need
//     at least one capture, but `inlineOpenVariablesViaRecompile` only
//     substitutes captures at the OUTER lambda body level — references
//     inside nested lambdas (branch-arms, pair-conds) stay as `$name`.
//
//   - So fixtures put captures either (a) in the outer-most `if`'s cond
//     (one level up from any branch lambda), or (b) prefixed onto the
//     if-chain via `$cap + (if(...))` so the capture is a top-level body
//     reference, not nested in a branch.
//
//   - The compiled printer (driven via `ManageImports` mode) auto-shortens
//     references to `meta::pure::functions::lang::*`,
//     `meta::pure::functions::collection::*` etc. because those packages
//     are in the parser's default-imports list — so `if` and `pair` appear
//     bare in the expected output.
// ----------------------------------------------------------------------------

// 2-level chain — outer cond captures `$n`, inner cond + branches are
// literals. After Inline the outer cond becomes `0 == 1`; after
// NestedIfToMultiIf the structure flattens into a multi-if with two pairs
// plus the deepest else as the default.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_nestedIf_twoLevels_flattensToMultiIf(): Boolean[1]
{
   let n = 0;
   let lambda = {| if($n == 1, |'one', |if(true, |'two', |'other'))};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): String[1]
      {
        if([pair(|0 == 1, |'one'), pair(|true, |'two')], |'other')
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.NestedIfToMultiIf]
      )
   );
}

// 3-level chain peels cascades into a 3-pair multi-if + default.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_nestedIf_threeLevels_flattensFully(): Boolean[1]
{
   let n = 0;
   let lambda = {|
      if($n == 1, |'one',
         |if(true, |'two',
            |if(false, |'three', |'other')))
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): String[1]
      {
        if([pair(|0 == 1, |'one'), pair(|true, |'two'), pair(|false, |'three')], |'other')
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.NestedIfToMultiIf]
      )
   );
}

// ----------------------------------------------------------------------------
// IfBranchPruning
// ----------------------------------------------------------------------------

// Literal-true cond in 3-arg if → result is the then-lambda's body.
// Capture moves the `true` into the outer cond (which Inline does
// substitute), so the if sees a literal and prunes.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_ifPrune_literalTrue_takesThen(): Boolean[1]
{
   let n = true;
   let lambda = {| if($n, |1, |2)};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        1
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.IfBranchPruning]
      )
   );
}

// Literal-false cond → result is the else-lambda's body.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_ifPrune_literalFalse_takesElse(): Boolean[1]
{
   let n = false;
   let lambda = {| if($n, |1, |2)};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        2
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.IfBranchPruning]
      )
   );
}

// Multi-if with literal-true FIRST cond. Capture is a top-level prefix
// (`$dummy +`) so Inline reaches it without poking into pair-cond
// lambdas. After Inline: `0 + if([pair(|true,|10), pair(|false,|20)], |30)`;
// after IfBranchPruning the multi-if collapses to `10`.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_ifPrune_multiIf_firstTrue_wins(): Boolean[1]
{
   let dummy = 0;
   let lambda = {| $dummy + (if([pair(|true, |10), pair(|false, |20)], |30))};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        0 + 10
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.IfBranchPruning]
      )
   );
}

// Multi-if with all-literal-false conds → falls through to default.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_ifPrune_multiIf_allFalse_takesDefault(): Boolean[1]
{
   let dummy = 0;
   let lambda = {| $dummy + (if([pair(|false, |1), pair(|false, |2)], |30))};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        0 + 30
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.IfBranchPruning]
      )
   );
}

// ----------------------------------------------------------------------------
// Composition: NestedIfToMultiIf + IfBranchPruning.
//
// Captured outer cond is `true`; after Inline the chain is
// `if(true, |10, |if(false, |20, |30))`. NestedIfToMultiIf flattens to
// `if([pair(|true, |10), pair(|false, |20)], |30)`. IfBranchPruning sees
// the first literal-true and collapses to `10`.
// ----------------------------------------------------------------------------
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_nestedThenPrune_literalTrue_collapses(): Boolean[1]
{
   let n = true;
   let lambda = {| if($n, |10, |if(false, |20, |30))};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        10
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.NestedIfToMultiIf,
          meta::pure::translation::shared::CanonicalMode.IfBranchPruning]
      )
   );
}

// ----------------------------------------------------------------------------
// DeadLetElim
//
// Drop top-level `let x = expr;` bindings whose `x` isn't referenced by any
// subsequent expression. Walks end-to-start so a chain of dead lets collapses
// in one pass.
// ----------------------------------------------------------------------------

// Single dead let preceding a literal — drops the let, leaves the literal.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_deadLet_singleDead(): Boolean[1]
{
   let cap = 7;
   let lambda = {| let unused = $cap; 42;};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        42
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.DeadLetElim]
      )
   );
}

// Chain of dead lets — `a` only referenced by `b`'s RHS; once `b` drops,
// `a` becomes dead too and drops in the same pass (end-to-start walk).
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_deadLet_cascade(): Boolean[1]
{
   let cap = 7;
   let lambda = {|
      let a = $cap;
      let b = $a + 1;
      'done';
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): String[1]
      {
        'done'
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.DeadLetElim]
      )
   );
}

// Referenced let is preserved. `$used` is read by the final expression so
// the binding stays.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_deadLet_keepsReferenced(): Boolean[1]
{
   let cap = 7;
   let lambda = {|
      let used = $cap;
      $used + 1;
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        let used = 7;
        $used + 1;
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.DeadLetElim]
      )
   );
}

// TODO: Class-instance capture is broken under Truffle. `^TS_Person(...)`
// is a PureDynamicObject and `classInstanceToProtocol` (or one of the
// dispatch helpers in decompile.pure) doesn't recognise it as a class
// instance — the printer falls through to `Any -> toString()`, producing
// `org.finos.legend.pure.truffle.runtime.dynobj.PureDynamicObject@<hash>`
// instead of `^TS_Person(firstName='Fabrice', lastName='Smith')`. The hash
// is also non-deterministic so we can't even pin the broken form.
//
// Re-enable once decompile.pure's class-instance detection handles PDOs.
//
// function <<test.Test>> testCanonical_classInstanceCapture(): Boolean[1]
// {
//    let smith = ^TS_Person(firstName='Fabrice', lastName='Smith');
//    let lambda = {| $smith.firstName};
//    ...
// }

// ----------------------------------------------------------------------------
// SingleUseLetInline — inline {@code let x = RHS;} into its single use site
// when RHS is side-effect-free, then drop the let.
// ----------------------------------------------------------------------------

// Basic case: single let, single use, pure RHS — inlines and drops the let.
// Compose with InlineOpenVariables (no-op for the capture-free body but its
// presence promotes the lambda to a UDF, which is what SingleUseLetInline
// operates on — bare lambdas pass through, see the pass's lambda-arm note).
// The capture provides Inline with something to do so the UDF wrap fires.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_singleUseLetInline_basic(): Boolean[1]
{
   let cap = 99;
   let lambda = {|
      let a = 5;
      $a + 1 + $cap;
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        5 + 1 + 99
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.SingleUseLetInline]
      )
   );
}

// Chained lets: each is single-use into the next; iterating to fixpoint
// collapses the whole chain in one pass.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_singleUseLetInline_chain(): Boolean[1]
{
   let cap = 99;
   let lambda = {|
      let a = 5;
      let b = $a + 1;
      $b * 2 + $cap;
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        (5 + 1) * 2 + 99
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.SingleUseLetInline]
      )
   );
}

// Multi-use let is NOT inlined — would duplicate the RHS, change cost,
// and (if RHS had side effects) change semantics. Rule is strict on
// use-count regardless.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_singleUseLetInline_multiUse_keeps(): Boolean[1]
{
   let cap = 99;
   let lambda = {|
      let a = 5;
      $a + $a + $cap;
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        let a = 5;
        $a + $a + 99;
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.SingleUseLetInline]
      )
   );
}

// Composing with PartialEvaluation — once SingleUseLetInline exposes the
// literals, PartialEvaluation folds. The strict ordering puts
// SingleUseLetInline before PartialEvaluation so this happens whichever
// order the caller passes them.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_singleUseLetInline_thenPartialFolds(): Boolean[1]
{
   let cap = 100;
   let lambda = {|
      let a = 5;
      let b = $a + 1;
      $b * 2 + $cap;
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[1]
      {
        112
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.SingleUseLetInline,
          meta::pure::translation::shared::CanonicalMode.PartialEvaluation]
      )
   );
}

// Filter chain + `let` expression at outer-lambda scope, referenced inside
// one of the filter lambdas, with BOTH new options enabled
// (SingleUseLetInline + FilterFusion) plus InlineOpenVariables to promote
// the bare lambda into a UDF the let-inline pass can operate on.
//
// SingleUseLetInline counts cross-scope references (respecting lexical
// shadowing), substitutes the let RHS into the inner reference, and drops
// the outer let. FilterFusion then collapses the now-single-expression-
// bodied chain into a single `filter(x | a && b)`.
//
// NOTE: a sibling shape — putting the `let` INSIDE the filter lambda
// body — would also collapse via SingleUseLetInline and become a fusable
// single-expression body, BUT trips a pre-existing compile-bug-then-print-
// crash in InlineOpenVariables's recompile (the multi-expression filter
// lambda emerges with a `CompilerNotSetMultiplicity` sentinel on its
// parameter that survives compile and trips `printMultiplicity`). The
// shape below side-steps that by keeping the filter lambdas single-
// expression from the start.
//
// Avoids the pre-existing printer bug that surfaces when a let lives
// INSIDE a filter lambda body and goes through the canonical recompile
// (see {@link letBody_filterFusionOnly_skips} for that case).
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_singleUseLetInline_unblocksFilterFusion(): Boolean[1]
{
   let cap = 0;
   let lambda = {|
      let threshold = 10;
      [1, 2, 3, 4, 5]->filter(x | $x > $cap)->filter(x | $x < $threshold);
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[*]
      {
        [1, 2, 3, 4, 5]->filter(x|$x > 0 && $x < 10)
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.SingleUseLetInline,
          meta::pure::translation::shared::CanonicalMode.FilterFusion]
      )
   );
}

// ----------------------------------------------------------------------------
// FilterFusion — collapse {@code xs->filter(c1)->filter(c2)} chains into a
// single filter with the two conditions {@code &&}-joined.
// ----------------------------------------------------------------------------

// Basic pair: two adjacent filters fuse to one with `&&`-joined conditions.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_filterFusion_pair(): Boolean[1]
{
   let lambda = {| [1, 2, 3, 4, 5]->filter(x | $x > 0)->filter(x | $x < 10)};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[*]
      {
        [1, 2, 3, 4, 5]->filter(x|$x > 0 && $x < 10)
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion]
      )
   );
}

// Three-filter chain reduces to a single filter with two `&&`s — the
// recursion is bottom-up so the inner pair fuses first, then the outer
// pair fuses around the (now-fused) inner.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_filterFusion_chain3(): Boolean[1]
{
   let lambda = {| [1, 2, 3, 4, 5]->filter(x | $x > 0)->filter(x | $x < 10)->filter(x | $x == 3)};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[*]
      {
        [1, 2, 3, 4, 5]->filter(x|$x > 0 && $x < 10 && $x == 3)
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion]
      )
   );
}

// Differently-named params: outer's param is rewritten to the inner's name
// in the combined body. Use disjoint identifier sets so no capture conflict.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_filterFusion_renamesOuterParam(): Boolean[1]
{
   let lambda = {| [1, 2, 3, 4, 5]->filter(a | $a > 0)->filter(b | $b < 10)};

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[*]
      {
        [1, 2, 3, 4, 5]->filter(a|$a > 0 && $a < 10)
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion]
      )
   );
}

// Single filter — no chain to collapse, leaves the AST alone (the
// pre-check rejects the function as having a fusable chain, so the lambda
// is returned unchanged — no synthetic-UDF wrap).
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_filterFusion_singleFilter_noChange(): Boolean[1]
{
   let lambda = {| [1, 2, 3, 4, 5]->filter(x | $x > 0)};

   assertEquals(
      '|[1, 2, 3, 4, 5]->meta::pure::functions::collection::filter(x|$x > 0)',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion]
      )
   );
}

// ----------------------------------------------------------------------------
// Strict canonical ordering — the modes list is a SET; passes always run in
// the order defined by {@link canonicalPassOrder} regardless of how the
// caller arranged the list. This is load-bearing for FilterFusion in
// particular: a filter lambda that still references a captured variable
// would fail to recompile, so Inline must run first.
// ----------------------------------------------------------------------------

// Caller passes the modes in the "wrong" order (FilterFusion before
// InlineOpenVariables). Strict ordering reorders to Inline → FilterFusion,
// so the captured `$cap` is substituted before fusion sees the filter body.
// Without strict ordering this would explode at recompile because the
// fused lambda's `&&` operand would still be `$cap`-relative.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_strictOrder_inlineRunsBeforeFusion(): Boolean[1]
{
   let cap = 10;
   let lambda = {| [1, 2, 3, 4, 5]->filter(x | $x > 0)->filter(x | $x < $cap)};

   let expected = '''
      ###Pure
      function __canonical__::__canonical__(): Integer[*]
      {
        [1, 2, 3, 4, 5]->filter(x|$x > 0 && $x < 10)
      }
      ''';

   assertEquals(
      $expected,
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion,
          meta::pure::translation::shared::CanonicalMode.InlineOpenVariables]
      )
   );

   // Caller-order invariance: same modes in the natural order produce the
   // same canonical output.
   assertEquals(
      $expected,
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables,
          meta::pure::translation::shared::CanonicalMode.FilterFusion]
      )
   );
}

// Multi-expression filter body (a `let` inside the lambda) blocks fusion of
// both adjacent pairs. With no captures and only FilterFusion enabled, the
// pre-check returns false (no fusable chain) and the lambda is returned
// unchanged — no synthetic-UDF wrap, no recompile.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_filterFusion_letBody_filterFusionOnly_skips(): Boolean[1]
{
   let lambda = {|
      [1, 2, 3, 4, 5]->filter(x | $x > 0)
                    ->filter(x | let threshold = 10; $x < $threshold;)
                    ->filter(x | $x == 3)
   };

   assertEquals(
      '|[1, 2, 3, 4, 5]->meta::pure::functions::collection::filter(x|$x > 0)->meta::pure::functions::collection::filter(x|let threshold = 10; $x < $threshold)->meta::pure::functions::collection::filter(x|$x == 3)',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion]
      )
   );
}

// `let` at outer-lambda scope (not inside a filter body), with a CAPTURED
// variable on the let RHS, plus a fusable two-filter chain. Caller asks for
// [FilterFusion, InlineOpenVariables] — strict ordering routes Inline first
// so `$cap` is substituted into the let RHS, then FilterFusion collapses
// the two filters and preserves the surrounding `let threshold = ...;`.
// The let-bound `$threshold` survives in the fused predicate.
//
// NOTE: a sibling test with the `let` INSIDE a filter body alongside Inline
// would surface a pre-existing printer bug (`printMultiplicity` chokes on
// a multiplicity PDO that the canonical recompile leaves on the inner
// lambda param). That bug is independent of FilterFusion — Inline alone on
// the same fixture trips it. See {@link letBody_filterFusionOnly_skips}
// for the in-filter let case under FilterFusion alone.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_filterFusion_letAtOuter_withInline_fuses(): Boolean[1]
{
   let cap = 10;
   let lambda = {|
      let threshold = $cap;
      [1, 2, 3, 4, 5]->filter(x | $x > 0)->filter(x | $x < $threshold);
   };

   assertEquals(
      '''
      ###Pure
      function __canonical__::__canonical__(): Integer[*]
      {
        let threshold = 10;
        [1, 2, 3, 4, 5]->filter(x|$x > 0 && $x < $threshold);
      }
      ''',
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion,
          meta::pure::translation::shared::CanonicalMode.InlineOpenVariables]
      )
   );
}

// ----------------------------------------------------------------------------
// Regression: the canonical decompile→recompile path leaves a
// `CompilerNotSetMultiplicity` sentinel on a filter lambda parameter when
// the lambda body is multi-expression (e.g. {@code (x | let t = ...; bool)}),
// while parse→compile of the equivalent source infers it correctly to
// {@code PureOne}. This isolates the bug to the canonical pipeline, NOT
// the compiler/printer.
//
// The test asserts the divergence directly: same logical UDF, two
// construction paths, two different parameter-multiplicity slot
// contents. When the underlying bug is fixed, the second assertion will
// flip — `CompilerNotSetMultiplicity` will become a real
// `ConcreteMultiplicity` — and this test will fail, signalling the fix
// can land and the canonical-side workarounds (the
// {@code _noRoundtrip} marker, the documented test limitations) can
// be removed.
// ----------------------------------------------------------------------------

// Helper — drill into a UDF whose body is exactly one `filter(coll, lam)`
// FunctionExpression and return the filter lambda's first parameter's
// multiplicity slot value. Both paths in the regression test produce this
// same shape; the slot contents differ.
function <<test.TestDependency>> meta::pure::translation::shared::tests::firstFilterLambdaParamMul(udf: UserDefinedFunction<Any>[1]): meta::pure::metamodel::multiplicity::Multiplicity[1]
{
   let filterFE = $udf.expressionSequence->at(0)->cast(@meta::pure::metamodel::valuespecification::FunctionExpression);
   let av       = $filterFE.parametersValues->at(1)->cast(@meta::pure::metamodel::valuespecification::AtomicValue);
   let lam      = $av.value->toOne()->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>);
   $lam.parameters->at(0)->cast(@meta::pure::metamodel::valuespecification::VariableExpression).multiplicity->toOne();
}

function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_letInFilterBody_compilerInfersMul_canonicalLeavesSentinel(): Boolean[1]
{
   // -- Path A: parse + compile the source directly. The standard 3-arg
   // compile (which delegates to the same 4-arg form canonical uses) should
   // infer the filter lambda's parameter multiplicity to a real concrete
   // multiplicity via setMissingLambdaParameterInformation.
   let source = '###Pure\n'
              + 'function test::f(): Integer[*]\n'
              + '{\n'
              + '  [1, 2, 3, 4, 5]->filter(x|let threshold = 10; $x < $threshold;)\n'
              + '}\n';
   let parsedFile = meta::pure::functions::meta::parse('regression.pure', $source);
   let parsedResult = meta::pure::compiler::compile([$parsedFile], false, true);
   assert($parsedResult.errors->isEmpty(), | 'parse-compile failed: ' + $parsedResult.errors->joinStrings('; '));
   let parsedUDF = $parsedResult.context->toOne().elementMap->values()
                       ->filter(e | $e->instanceOf(UserDefinedFunction))
                       ->cast(@UserDefinedFunction<meta::pure::metamodel::type::Any>)
                       ->filter(u | $u.functionName == 'f')
                       ->toOne();
   let parsedMul = $parsedUDF->firstFilterLambdaParamMul();
   assert(!$parsedMul->instanceOf(meta::pure::metamodel::multiplicity::CompilerNotSetMultiplicity),
      | 'Path A: parse+compile left CompilerNotSetMultiplicity on the filter lambda param — expected a concrete multiplicity. Type was: ' + $parsedMul->type()->toOne()->elementToPath()
   );

   // -- Path B: same logical UDF, built via the canonical pipeline. A
   // capture is needed so InlineOpenVariables actually runs its decompile
   // → recompile (no-capture lambdas pass through unchanged). The capture
   // is wired into the filter lambda's let RHS so the multi-expression
   // body shape is preserved through the recompile.
   let cap = 10;
   let lambda = {|
      [1, 2, 3, 4, 5]->filter(x | let threshold = $cap; $x < $threshold;)
   };
   let canonical = $lambda->meta::pure::translation::shared::makeCanonical(
      [meta::pure::translation::shared::CanonicalMode.InlineOpenVariables]
   );
   let canonicalUDF = $canonical->cast(@UserDefinedFunction<meta::pure::metamodel::type::Any>);
   let canonicalMul = $canonicalUDF->firstFilterLambdaParamMul();
   // BUG MARKER — when this assertion fires (i.e. the canonical pipeline
   // is fixed to infer the multiplicity correctly), flip to `assert(!...)`
   // and remove the surrounding workarounds tracked in
   // canonical_tests.pure and filterWithLetInLambdaBody_noRoundtrip.pure.
   assert($canonicalMul->instanceOf(meta::pure::metamodel::multiplicity::CompilerNotSetMultiplicity),
      | 'Path B regression: canonical recompile USED to leave CompilerNotSetMultiplicity on the filter lambda param. If this is firing the bug is fixed — flip the assertion and clean up workarounds. Type was: ' + $canonicalMul->type()->toOne()->elementToPath()
   );
   true;
}

// Mode-list dedup: passing the same mode twice gives the same result as
// passing it once. Each pass is a fixpoint, so this is structurally true,
// but the strict-ordering layer also dedups by virtue of filtering the
// canonical-order list against the user's set.
function <<test.Test>> meta::pure::translation::shared::tests::testCanonical_strictOrder_dedupesModes(): Boolean[1]
{
   let lambda = {| [1, 2, 3]->filter(x | $x > 0)->filter(x | $x < 10)};

   assertEquals(
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion]
      ),
      canonicalAndPrintWithModes(
         $lambda,
         [meta::pure::translation::shared::CanonicalMode.FilterFusion,
          meta::pure::translation::shared::CanonicalMode.FilterFusion]
      )
   );
}
