# pure/modules/translation/shared/Justfile — Pure-AST -> Pure-AST transformations
# shared across target-language translators.
#
# Direct invocation: just <recipe>   (from pure/modules/translation/shared/)
#
# Inputs:  shared/core.pdb
# Output:  build/translation-shared.pdb
#
# Target-language-agnostic. Provides:
#   - makeCanonical: a Pure-AST simplification pipeline (open-variable inlining,
#     constant folding, ...) shared by Java + JavaScript translators.
#   - collectDependencies: AST-walk that returns the transitive PackageableElement
#     callees of a function. Today walks the AST at runtime; future optimization
#     is to read the compiler's reverseIndex out of the PDB — needs a
#     post-archive protocol the bootstrap doesn't expose yet.

set quiet := true
set shell := ["bash", "-c"]

shared_root    := source_directory()
repo_root      := shared_root / ".." / ".." / ".." / ".."
shared_out     := repo_root / "shared"
test_results   := repo_root / "test-results"
# Module build outputs: each module writes its own pdbs (and gallery) into its build/.
translation_shared_out     := repo_root / "pure" / "modules" / "translation" / "shared" / "build"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"

verbose := ""
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

header := "h(){ s=\"[translation-shared::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build translation-shared.pdb.
default: build

# Compile pure/modules/translation/shared -> build/translation-shared.pdb.
build:
    @{{header}} 'build'
    @{{substep}} 'compile pure/modules/translation/shared -> build/translation-shared.pdb'
    test -f {{shared_out}}/core.pdb     || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/compiler.pdb || (echo "ERROR: missing {{shared_out}}/compiler.pdb (run \`just bootstrap::build\` first)" && exit 1)
    mkdir -p {{translation_shared_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --source {{shared_root}} \
        --output-dir {{translation_shared_out}} {{err_filter}}

# No sibling-module deps (only bootstrap PDBs, file-checked above) — alias of `build` for symmetry.
build-all: build

# Compile with tests split into build/translation-shared-tests.pdb (needed by `test-all`).
build-tests:
    @{{header}} 'build-tests'
    @{{substep}} 'compile pure/modules/translation/shared -> translation-shared.pdb + translation-shared-tests.pdb'
    test -f {{shared_out}}/core.pdb       || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/core-tests.pdb || (echo "ERROR: missing {{shared_out}}/core-tests.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/compiler.pdb   || (echo "ERROR: missing {{shared_out}}/compiler.pdb (run \`just bootstrap::build\` first)" && exit 1)
    mkdir -p {{translation_shared_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --source {{shared_root}} \
        --output-dir {{translation_shared_out}} \
        --tests split {{err_filter}}

# These tests exercise the decompile + makeCanonical pipeline; bootstrap
# doesn't register the same natives surface so they're effectively
# Truffle-only (see comment at top of canonical_tests.pure).

# Run the canonical_tests.pure suite via Truffle (platform::extensions::pure::translation::canonical::tests).
# Named `test-all` for symmetry with translation/{java,javascript}/Justfile, even
# though there's only one suite here today.
test-all: build-tests
    @{{header}} 'test-all'
    @{{substep}} 'runTests platform::extensions::pure::translation::canonical::tests (Truffle)'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_shared_out}}/translation-shared-tests.pdb \
        --function "platform::pure::test::runTests_String_1__String_1__String_1_" \
        --args "platform::extensions::pure::translation::canonical::tests" "{{test_results}}/pure/translation-shared/pure@cli-truffle.json" {{err_filter}}

# Remove build/ — the PDBs and anything else this module writes there.
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove build/'
    rm -rf {{translation_shared_out}}
