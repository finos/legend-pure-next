# pure/modules/translation/javascript/Justfile — builds the Pure-to-JavaScript translator
# into a single PDB.
#
# Direct invocation: just <recipe>     (from pure/modules/translation/javascript/)
#
# Inputs:  shared/core.pdb, pure/modules/language/javascript/build/javascript.pdb, pure/modules/translation/shared/build/translation-shared.pdb.
# Output:  build/javascript-translation.pdb
#
# The translator consumes the language/javascript metamodel + factories + serializer
# (pure/modules/language/javascript/build/javascript.pdb) and the Pure metamodel (shared/core.pdb), and emits a
# JavaScript AST that serializes back to source.

set quiet := true
set shell := ["bash", "-c"]

# Sibling modules consumed by `build-all` (relative paths from this Justfile).
# `build` itself only checks for the produced PDBs and fails loudly — these
# mods are used solely to make `build-all` self-sufficient.
mod _mod_language_javascript "../../language/javascript/Justfile"
mod _mod_translation_shared  "../shared/Justfile"

trn_root       := source_directory()
repo_root      := trn_root / ".." / ".." / ".." / ".."
shared_out     := repo_root / "shared"
# Module build outputs: each module writes its own pdbs (and gallery) into its build/.
language_javascript_out    := repo_root / "pure" / "modules" / "language" / "javascript" / "build"
translation_shared_out     := repo_root / "pure" / "modules" / "translation" / "shared" / "build"
translation_javascript_out := repo_root / "pure" / "modules" / "translation" / "javascript" / "build"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"
pure_js        := repo_root / "platforms" / "javascript" / "bin" / "pure-js"
test_results   := repo_root / "test-results"

# Which Pure runtime runs the TRANSLATOR for the emit recipes. Bootstrap is the
# default so this module needs nothing from platforms/truffle — the standalone
# JS platform consumes parser-mappings-bundle.js and must not drag a GraalVM
# build in behind it. Output is byte-identical either way; truffle is faster:
#     just pure_rt=truffle parser-mappings-bundle   (overrides precede the recipe)
pure_rt := "bootstrap"
emit_rt := if pure_rt == "truffle" { pure_truffle } else { pure_bootstrap }
grammar_dir    := repo_root / "pure" / "specification" / "grammar" / "antlr"

# `--source` sees only `code/` (not the module root, as other modules pass):
# the compiler walks every file under it, and `js/` holds npm tooling.
code_dir       := trn_root / "code"
js_dir         := trn_root / "js"
gen_dir        := js_dir / "generated"
bundle_out     := js_dir / "build" / "antlr-bundle.js"
mappings_bundle_out := js_dir / "build" / "parser-mappings-bundle.js"

verbose := ""
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

header := "h(){ s=\"[javascript-translation::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build javascript-translation.pdb.
default: build

# Compile pure/ -> build/javascript-translation.pdb.
build:
    @{{header}} 'build'
    @{{substep}} 'compile pure/modules/translation/javascript -> build/javascript-translation.pdb'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_javascript_out}}/javascript.pdb         || (echo "ERROR: missing {{language_javascript_out}}/javascript.pdb (run \`just language::javascript::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    mkdir -p {{translation_javascript_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_javascript_out}}/javascript.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{code_dir}} \
        --output-dir {{translation_javascript_out}} {{err_filter}}

# Build sibling-module deps (language_javascript, translation_shared) first, then this module.
build-all: _mod_language_javascript::build _mod_translation_shared::build build

# Compile via the Pure compiler running on Truffle.
build-truffle:
    @{{header}} 'build-truffle'
    @{{substep}} 'compile pure/modules/translation/javascript -> build/javascript-translation.pdb (Truffle)'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_javascript_out}}/javascript.pdb         || (echo "ERROR: missing {{language_javascript_out}}/javascript.pdb (run \`just language::javascript::build\` first)" && exit 1)
    test -f {{shared_out}}/compiler.pdb           || (echo "ERROR: missing {{shared_out}}/compiler.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    test -x {{pure_truffle}} || (echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" && exit 1)
    mkdir -p {{translation_javascript_out}}
    {{pure_truffle}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_javascript_out}}/javascript.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{code_dir}} \
        --output-dir {{translation_javascript_out}} {{err_filter}}

# Compile with `--tests split` -> javascript-translation-tests.pdb.
build-tests:
    @{{header}} 'build-tests'
    @{{substep}} 'compile pure/modules/translation/javascript -> build/javascript-translation.pdb + javascript-translation-tests.pdb'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{language_javascript_out}}/javascript.pdb         || (echo "ERROR: missing {{language_javascript_out}}/javascript.pdb (run \`just language::javascript::build\` first)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    mkdir -p {{translation_javascript_out}}
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{language_javascript_out}}/javascript.pdb \
        --base-pdb {{translation_shared_out}}/translation-shared.pdb \
        --source {{code_dir}} \
        --output-dir {{translation_javascript_out}} \
        --tests split {{err_filter}}

# Default umbrella: translator test suite + runtime suites — the same recipes as
# translation/java, run on the JavaScript host (bin/pure-js) where Java's run on
# Truffle (bin/pure-truffle). The `compileModule` / `execute` natives these tests
# reach exist only on that host.
test-all: test-translation test-pure-runtime

# Run the translator's own <<test.Test>> suite (meta::external::language::javascript::translation).
test-translation: build-tests _host-generate _depCheck_runtime-pdbs
    @{{header}} 'test-translation'
    @{{substep}} 'runTests meta::external::language::javascript::translation (JavaScript host)'
    {{pure_js}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::external::language::javascript::translation" "{{test_results}}/pure/translation-javascript/pure@cli-javascript.json"

# Run the standard Pure runtime suites over meta::pure::functions on the JavaScript host, plus the
# PCT tests through the translator adapter (their failures are reported without failing the build).
test-pure-runtime: test-pure-runtime-testFunctions test-pure-runtime-PCTs

# Run runTests over meta::pure::functions on the JavaScript host.
test-pure-runtime-testFunctions: build-tests _host-generate _depCheck_runtime-pdbs
    @{{header}} 'test-pure-runtime-testFunctions'
    @{{substep}} 'runTests meta::pure::functions (JavaScript host)'
    {{pure_js}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/spec/functions/pure@cli-javascript.json"

# Run PCT tests over meta::pure::functions via the translator adapter (lambdas -> JavaScript -> compileModule -> execute).
test-pure-runtime-PCTs: build-tests _host-generate _depCheck_runtime-pdbs
    @{{header}} 'test-pure-runtime-PCTs'
    @{{substep}} 'runPCTTests meta::pure::functions (JavaScript host, translator adapter)'
    {{pure_js}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::external::language::javascript::translation::runPCTTestsViaTranslator_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/spec/pct/javascript-translation@cli-javascript.json" || echo "  PCT failures do not fail the build: they are in the report and on the dashboard"

# Build the Pure -> JavaScript translation gallery as a self-contained HTML page.
# pure-js prints the returned String to stdout, so a plain redirect is enough.
gallery: build-tests _host-generate _depCheck_runtime-pdbs
    @{{header}} 'gallery'
    @{{substep}} 'render Pure -> JavaScript gallery -> build/javascript-translation-gallery.html'
    {{pure_js}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::external::language::javascript::translation::gallery::renderGallery_String_1__String_1_" \
        --args "meta::pure::functions" \
        > {{translation_javascript_out}}/javascript-translation-gallery.html
    @echo "wrote {{translation_javascript_out}}/javascript-translation-gallery.html ($(wc -c < {{translation_javascript_out}}/javascript-translation-gallery.html) bytes)"

# Internal: the one step translation/java has no counterpart for. Truffle
# interprets PDBs directly; the JavaScript host runs code TRANSLATED from them,
# so regenerate it from the pdbs build-tests just wrote or the suites run stale code.
_host-generate:
    just --justfile {{repo_root}}/platforms/javascript/Justfile generate-all

# Internal: fail loudly if the PDBs the runtime recipes need aren't staged.
_depCheck_runtime-pdbs:
    #!/usr/bin/env bash
    if [[ ! -f "{{shared_out}}/core-tests.pdb" ]]; then
        echo "ERROR: missing {{shared_out}}/core-tests.pdb (run \`just bootstrap::build\` first)" >&2
        exit 1
    fi
    if [[ ! -x "{{pure_js}}" ]]; then
        echo "ERROR: missing {{pure_js}}" >&2
        exit 1
    fi

_npm-install:
    #!/usr/bin/env bash
    set -e
    if [[ ! -d "{{js_dir}}/node_modules" ]]; then
        echo "  ↳ pnpm install (antlr4 + antlr4ng-cli + esbuild)"
        cd "{{js_dir}}" && pnpm install
    fi

# Generate TS lexer/parser from grammar/antlr/*.g4 -> js/generated/.
# ANTLR's JavaScript target via the complete jar bundled with antlr4ng-cli
# (its `antlr4ng` wrapper only emits TypeScript). Each grammar is generated
# from its own directory so output lands flat in gen_dir and `-lib gen_dir`
# lets the parser grammars find the lexer-generated `.tokens`.
antlr-generate-parsers: _npm-install
    @{{header}} 'antlr-generate-parsers'
    @{{substep}} 'antlr4 -Dlanguage=JavaScript on Top/M3 grammars'
    rm -f "{{gen_dir}}"/*.ts "{{gen_dir}}"/*.js "{{gen_dir}}"/*.interp "{{gen_dir}}"/*.tokens
    mkdir -p "{{gen_dir}}"
    jar="$(ls {{js_dir}}/node_modules/antlr4ng-cli/antlr4-*-complete.jar | head -1)"; \
    cd "{{grammar_dir}}" && java -jar "$jar" -Dlanguage=JavaScript -no-listener -no-visitor -o "{{gen_dir}}" -lib "{{gen_dir}}" TopLexer.g4 TopParser.g4 && \
    cd "{{grammar_dir}}/m3" && java -jar "$jar" -Dlanguage=JavaScript -no-listener -no-visitor -o "{{gen_dir}}" -lib "{{gen_dir}}" M3Lexer.g4 M3Parser.g4
    @echo "  generated $(ls {{gen_dir}}/*.js | wc -l | tr -d ' ') JS files"

# Translate parser-mappings.pdb -> js/build/parser-mappings.js (re-exported by antlr bundle).
antlr-generate-ts-parserMapping: build-tests _depCheck_emit-pdbs
    @{{header}} 'antlr-generate-ts-parserMapping'
    @{{substep}} 'translate meta::pure::parser::mappings -> js/build/parser-mappings.js'
    mkdir -p "$(dirname "{{bundle_out}}")"
    {{emit_rt}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::external::language::javascript::translation::pdb::translatePackageToJs_String_1__String_1_" \
        --args "meta::pure::parser::mappings" \
        2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2) \
        | grep -v '^\[graal-tripwire\]' \
        > "{{js_dir}}/build/parser-mappings.js"
    @echo "  wrote {{js_dir}}/build/parser-mappings.js ($(wc -c < {{js_dir}}/build/parser-mappings.js | tr -d ' ') bytes)"

# Bundle antlr4 + generated parsers + native impls -> js/build/antlr-bundle.js (no-imports IIFE exposing `PureAntlr`).
# `--conditions=browser` selects antlr4's browser build (no node `fs`/`path`),
# which is what the browser (and any non-Node host) needs.
#
# PARSER HALF. Depends only on antlr-generate-parsers, so it needs nothing from
# Pure: no pure-truffle, no PDBs. That is deliberate — the JS platform's parser
# bakes this in at process-resources, and CI packages that jar in truffle-self-host,
# which runs UPSTREAM of the jobs producing javascript.pdb. Keep it PDB-free or
# that ordering breaks again.
antlr-bundle: antlr-generate-parsers
    @{{header}} 'antlr-bundle'
    @{{substep}} 'esbuild --bundle js/antlr-entry.js -> js/build/antlr-bundle.js'
    mkdir -p "$(dirname "{{bundle_out}}")"
    cd "{{js_dir}}" && pnpm exec esbuild antlr-entry.js \
        --bundle --format=iife --global-name=PureAntlr --platform=neutral --conditions=browser --target=es2020 \
        --outfile="{{bundle_out}}" \
        --log-level=warning
    @echo "  wrote {{bundle_out}} ($(wc -c < {{bundle_out}} | tr -d ' ') bytes)"

# Bundle the translated parser-mappings interpreter + __pureParseTop ->
# js/build/parser-mappings-bundle.js (no-imports IIFE).
#
# MAPPINGS HALF. Needs pure-truffle and the javascript/translation PDBs (via
# antlr-generate-ts-parserMapping), so it can only run after those exist. The
# extension loads it when present and installs a throwing stub for
# `__pureParseTop` when it is not — only Pure's `parse` needs it.
parser-mappings-bundle: antlr-generate-ts-parserMapping
    @{{header}} 'parser-mappings-bundle'
    @{{substep}} 'esbuild --bundle js/parser-mappings-entry.js -> js/build/parser-mappings-bundle.js'
    mkdir -p "$(dirname "{{mappings_bundle_out}}")"
    cd "{{js_dir}}" && pnpm exec esbuild parser-mappings-entry.js \
        --bundle --format=iife --platform=neutral --conditions=browser --target=es2020 \
        --outfile="{{mappings_bundle_out}}" \
        --log-level=warning
    @echo "  wrote {{mappings_bundle_out}} ($(wc -c < {{mappings_bundle_out}} | tr -d ' ') bytes)"

# Both halves — the full local setup (browser demo + Pure `parse` support).
antlr-all: antlr-bundle parser-mappings-bundle

# Internal: fail loudly if the emit recipes' deps aren't staged — the base
# pdbs plus whichever Pure runtime `pure_rt` selected (bootstrap by default,
# so no GraalVM build is required).
_depCheck_emit-pdbs:
    #!/usr/bin/env bash
    if [[ ! -f "{{shared_out}}/core-tests.pdb" ]]; then
        echo "ERROR: missing {{shared_out}}/core-tests.pdb (run \`just bootstrap::build\` first)" >&2
        exit 1
    fi
    if [[ ! -x "{{emit_rt}}" ]]; then
        echo "ERROR: missing {{emit_rt}} (run \`just bootstrap::build\`, or \`just truffle::build\` when pure_rt=truffle)" >&2
        exit 1
    fi

# Remove build/javascript-translation.pdb (and the tests PDB).
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove build/javascript-translation.pdb + javascript-translation-tests.pdb'
    rm -f {{translation_javascript_out}}/javascript-translation.pdb {{translation_javascript_out}}/javascript-translation-tests.pdb
