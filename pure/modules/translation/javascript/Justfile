# pure/modules/translation/javascript/Justfile — builds the Pure-to-JavaScript translator
# into a single PDB.
#
# Direct invocation: just <recipe>     (from pure/modules/translation/javascript/)
#
# Inputs:  shared/core.pdb, shared/javascript.pdb, shared/translation-shared.pdb.
# Output:  shared/javascript-translation.pdb
#
# The translator consumes the language/javascript metamodel + factories + serializer
# (shared/javascript.pdb) and the Pure metamodel (shared/core.pdb), and emits a
# JavaScript AST that serializes back to source.

set quiet := true
set shell := ["bash", "-c"]

# Sibling modules consumed by `build-all` (relative paths from this Justfile).
# `build` itself only checks for the produced PDBs and fails loudly — these
# mods are used solely to make `build-all` self-sufficient.
mod _mod_language_javascript "../../language/javascript/Justfile"
mod _mod_translation_shared  "../shared/Justfile"

trn_root       := source_directory()
repo_root      := trn_root / ".." / ".." / ".." / ".."
shared_out     := repo_root / "shared"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"
grammar_dir    := repo_root / "pure" / "specification" / "grammar" / "antlr"

# `--source` sees only `pure/`; npm tooling runs out of `js/`.
pure_dir       := trn_root / "pure"
js_dir         := trn_root / "js"
gen_dir        := js_dir / "generated"
bundle_out     := js_dir / "build" / "antlr-bundle.js"
mappings_bundle_out := js_dir / "build" / "parser-mappings-bundle.js"

verbose := ""
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

header := "h(){ s=\"[javascript-translation::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build javascript-translation.pdb.
default: build

# Compile pure/ -> shared/javascript-translation.pdb.
build:
    @{{header}} 'build'
    @{{substep}} 'compile pure/modules/translation/javascript -> shared/javascript-translation.pdb'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/javascript.pdb         || (echo "ERROR: missing {{shared_out}}/javascript.pdb (run \`just language::javascript::build\` first)" && exit 1)
    test -f {{shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/javascript.pdb \
        --base-pdb {{shared_out}}/translation-shared.pdb \
        --source {{pure_dir}} \
        --output-dir {{shared_out}} {{err_filter}}

# Build sibling-module deps (language_javascript, translation_shared) first, then this module.
build-all: _mod_language_javascript::build _mod_translation_shared::build build

# Compile via the Pure compiler running on Truffle.
build-truffle:
    @{{header}} 'build-truffle'
    @{{substep}} 'compile pure/modules/translation/javascript -> shared/javascript-translation.pdb (Truffle)'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/javascript.pdb         || (echo "ERROR: missing {{shared_out}}/javascript.pdb (run \`just language::javascript::build\` first)" && exit 1)
    test -f {{shared_out}}/compiler.pdb           || (echo "ERROR: missing {{shared_out}}/compiler.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    test -x {{pure_truffle}} || (echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" && exit 1)
    {{pure_truffle}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/javascript.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --base-pdb {{shared_out}}/translation-shared.pdb \
        --source {{pure_dir}} \
        --output-dir {{shared_out}} {{err_filter}}

# Compile with `--tests split` -> javascript-translation-tests.pdb.
build-tests:
    @{{header}} 'build-tests'
    @{{substep}} 'compile pure/modules/translation/javascript -> shared/javascript-translation.pdb + javascript-translation-tests.pdb'
    test -f {{shared_out}}/core.pdb               || (echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared_out}}/javascript.pdb         || (echo "ERROR: missing {{shared_out}}/javascript.pdb (run \`just language::javascript::build\` first)" && exit 1)
    test -f {{shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{shared_out}}/translation-shared.pdb (run \`just translation::shared::build\` first)" && exit 1)
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/javascript.pdb \
        --base-pdb {{shared_out}}/translation-shared.pdb \
        --source {{pure_dir}} \
        --output-dir {{shared_out}} \
        --tests split {{err_filter}}

# Default umbrella: translator's <<test.Test>> suite. PCTs are stabilising — invoke test-pure-runtime-PCTs directly.
test-all: test-pure-runtime-translation

# Run translator's <<test.Test>> suite (Truffle — needs compileAndExecute native).
test-pure-runtime-translation: build-tests _depCheck_runtime-pdbs
    @{{header}} 'test-pure-runtime-translation'
    @{{substep}} 'runTests meta::external::language::javascript::translation (Truffle)'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/javascript.pdb \
        --pdb {{shared_out}}/translation-shared.pdb \
        --pdb {{shared_out}}/javascript-translation.pdb \
        --pdb {{shared_out}}/javascript-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1_" \
        --args "meta::external::language::javascript::translation" {{err_filter}}

# Run PCT tests over meta::pure::functions via the translator adapter (lambdas -> TS -> GraalJS -> invoke).
test-pure-runtime-PCTs: build-tests _depCheck_runtime-pdbs
    @{{header}} 'test-pure-runtime-PCTs'
    @{{substep}} 'runPCTTests meta::pure::functions (Truffle, translator adapter)'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/javascript.pdb \
        --pdb {{shared_out}}/translation-shared.pdb \
        --pdb {{shared_out}}/javascript-translation.pdb \
        --pdb {{shared_out}}/javascript-translation-tests.pdb \
        --function "meta::external::language::javascript::translation::runPCTTestsViaTranslator_String_1__String_1_" \
        --args "meta::pure::functions" {{err_filter}}

# Render Pure -> JavaScript translation gallery as a self-contained HTML page.
gallery: build-tests _depCheck_runtime-pdbs
    @{{header}} 'gallery'
    @{{substep}} 'render Pure -> JavaScript gallery -> shared/javascript-translation-gallery.html'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/javascript.pdb \
        --pdb {{shared_out}}/translation-shared.pdb \
        --pdb {{shared_out}}/javascript-translation.pdb \
        --pdb {{shared_out}}/javascript-translation-tests.pdb \
        --function "meta::external::language::javascript::translation::gallery::renderGallery_String_1__String_1_" \
        --args "meta::pure::functions" \
        2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2) \
        | grep -v '^\[graal-tripwire\]' \
        | awk '/<!DOCTYPE/{p=1} p' \
        > {{shared_out}}/javascript-translation-gallery.html
    @echo "wrote {{shared_out}}/javascript-translation-gallery.html ($(wc -c < {{shared_out}}/javascript-translation-gallery.html) bytes)"

_npm-install:
    #!/usr/bin/env bash
    set -e
    if [[ ! -d "{{js_dir}}/node_modules" ]]; then
        echo "  ↳ pnpm install (antlr4 + antlr4ng-cli + esbuild)"
        cd "{{js_dir}}" && pnpm install
    fi

# Generate TS lexer/parser from grammar/antlr/*.g4 -> js/generated/.
# ANTLR's JavaScript target via the complete jar bundled with antlr4ng-cli
# (its `antlr4ng` wrapper only emits TypeScript). Each grammar is generated
# from its own directory so output lands flat in gen_dir and `-lib gen_dir`
# lets the parser grammars find the lexer-generated `.tokens`.
antlr-generate-parsers: _npm-install
    @{{header}} 'antlr-generate-parsers'
    @{{substep}} 'antlr4 -Dlanguage=JavaScript on Top/M3 grammars'
    rm -f "{{gen_dir}}"/*.ts "{{gen_dir}}"/*.js "{{gen_dir}}"/*.interp "{{gen_dir}}"/*.tokens
    mkdir -p "{{gen_dir}}"
    jar="$(ls {{js_dir}}/node_modules/antlr4ng-cli/antlr4-*-complete.jar | head -1)"; \
    cd "{{grammar_dir}}" && java -jar "$jar" -Dlanguage=JavaScript -no-listener -no-visitor -o "{{gen_dir}}" -lib "{{gen_dir}}" TopLexer.g4 TopParser.g4 && \
    cd "{{grammar_dir}}/m3" && java -jar "$jar" -Dlanguage=JavaScript -no-listener -no-visitor -o "{{gen_dir}}" -lib "{{gen_dir}}" M3Lexer.g4 M3Parser.g4
    @echo "  generated $(ls {{gen_dir}}/*.js | wc -l | tr -d ' ') JS files"

# Translate parser-mappings.pdb -> js/build/parser-mappings.js (re-exported by antlr bundle).
antlr-generate-ts-parserMapping: build-tests _depCheck_runtime-pdbs
    @{{header}} 'antlr-generate-ts-parserMapping'
    @{{substep}} 'translate meta::pure::parser::mappings -> js/build/parser-mappings.js'
    mkdir -p "$(dirname "{{bundle_out}}")"
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/javascript.pdb \
        --pdb {{shared_out}}/translation-shared.pdb \
        --pdb {{shared_out}}/javascript-translation.pdb \
        --pdb {{shared_out}}/javascript-translation-tests.pdb \
        --function "meta::external::language::javascript::translation::pdb::translatePackageToJs_String_1__String_1_" \
        --args "meta::pure::parser::mappings" \
        2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2) \
        | grep -v '^\[graal-tripwire\]' \
        > "{{js_dir}}/build/parser-mappings.js"
    @echo "  wrote {{js_dir}}/build/parser-mappings.js ($(wc -c < {{js_dir}}/build/parser-mappings.js | tr -d ' ') bytes)"

# Bundle antlr4 + generated parsers + native impls -> js/build/antlr-bundle.js (no-imports IIFE).
# `--conditions=browser` selects antlr4's browser build (no node `fs`/`path`),
# which is what the GraalJS host (and the browser) needs.
#
# PARSER HALF. Depends only on antlr-generate-parsers, so it needs nothing from
# Pure: no pure-truffle, no PDBs. That is deliberate — the truffle extension jar
# bakes this in at process-resources, and CI packages that jar in truffle-self-host,
# which runs UPSTREAM of the jobs producing javascript.pdb. Keep it PDB-free or
# that ordering breaks again.
antlr-bundle: antlr-generate-parsers
    @{{header}} 'antlr-bundle'
    @{{substep}} 'esbuild --bundle js/antlr-entry.js -> js/build/antlr-bundle.js'
    mkdir -p "$(dirname "{{bundle_out}}")"
    cd "{{js_dir}}" && pnpm exec esbuild antlr-entry.js \
        --bundle --format=iife --platform=neutral --conditions=browser --target=es2020 \
        --outfile="{{bundle_out}}" \
        --log-level=warning
    @echo "  wrote {{bundle_out}} ($(wc -c < {{bundle_out}} | tr -d ' ') bytes)"

# Bundle the translated parser-mappings interpreter + __pureParseTop ->
# js/build/parser-mappings-bundle.js (no-imports IIFE).
#
# MAPPINGS HALF. Needs pure-truffle and the javascript/translation PDBs (via
# antlr-generate-ts-parserMapping), so it can only run after those exist. The
# extension loads it when present and installs a throwing stub for
# `__pureParseTop` when it is not — only Pure's `parse` needs it.
parser-mappings-bundle: antlr-generate-ts-parserMapping
    @{{header}} 'parser-mappings-bundle'
    @{{substep}} 'esbuild --bundle js/parser-mappings-entry.js -> js/build/parser-mappings-bundle.js'
    mkdir -p "$(dirname "{{mappings_bundle_out}}")"
    cd "{{js_dir}}" && pnpm exec esbuild parser-mappings-entry.js \
        --bundle --format=iife --platform=neutral --conditions=browser --target=es2020 \
        --outfile="{{mappings_bundle_out}}" \
        --log-level=warning
    @echo "  wrote {{mappings_bundle_out}} ($(wc -c < {{mappings_bundle_out}} | tr -d ' ') bytes)"

# Both halves — the full local setup (browser demo + Pure `parse` support).
antlr-all: antlr-bundle parser-mappings-bundle

# Internal: fail loudly if the PDBs the runtime recipes need aren't staged.
_depCheck_runtime-pdbs:
    #!/usr/bin/env bash
    if [[ ! -f "{{shared_out}}/core-tests.pdb" ]]; then
        echo "ERROR: missing {{shared_out}}/core-tests.pdb (run \`just bootstrap::build\` first)" >&2
        exit 1
    fi
    if [[ ! -x "{{pure_truffle}}" ]]; then
        echo "ERROR: missing {{pure_truffle}} (run \`just truffle::build\` from repo root first)" >&2
        exit 1
    fi

# Remove shared/javascript-translation.pdb (and the tests PDB).
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove shared/javascript-translation.pdb + javascript-translation-tests.pdb'
    rm -f {{shared_out}}/javascript-translation.pdb {{shared_out}}/javascript-translation-tests.pdb
