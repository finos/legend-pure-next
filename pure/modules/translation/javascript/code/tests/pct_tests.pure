import meta::external::language::javascript::*;
import meta::external::language::javascript::translation::*;
import meta::external::language::javascript::serialization::*;
import meta::pure::translation::shared::*;

// PCT tests for the Pure->JavaScript translator. Each `<<test.Test>>` here
// invokes an upstream `<<PCT.test>>` from the math/operation specs, passing
// our `testAdapterForTranslatedJavaScript`. The adapter translates the PCT
// lambda to TS, transpiles + evaluates it through the host's `compileModule` +
// `execute` natives, and returns the result. If the answer matches
// the PCT's expected constant, the translator + emitted TS + the JS engine's
// arithmetic all agree with Pure semantics.

function <<test.Test>> meta::external::language::javascript::translation::tests::pct::testSimplePlus(): Boolean[1]
{
   meta::pure::functions::math::tests::plus::testSimplePlus(testAdapterForTranslatedJavaScript_Function_1__X_o_);
}

function <<test.Test>> meta::external::language::javascript::translation::tests::pct::testFilterInstance(): Boolean[1]
{
   meta::pure::functions::collection::tests::filter::testFilterInstance(testAdapterForTranslatedJavaScript_Function_1__X_o_);
}

// Meta PCT — exercises metamodel reflection through the translator:
//   instance.genericType() → class metadata → .properties /
//   .propertiesFromAssociations / .generalizations.general traversal.
// First test to actually hit the address-walker + __metadataRead path
// end-to-end with real metamodel reads.
function <<test.Test>> meta::external::language::javascript::translation::tests::pct::testMetaProperties(): Boolean[1]
{
   meta::pure::functions::meta::tests::properties::testProperties(testAdapterForTranslatedJavaScript_Function_1__X_o_);
}
