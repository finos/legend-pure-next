import meta::external::language::javascript::*;
import meta::external::language::javascript::translation::*;
import meta::external::language::javascript::serialization::*;
import meta::pure::translation::shared::*;

// Runtime tests for the Pure->JavaScript translator: translate a function or
// lambda, run it through the host's `compileModule` + `execute` natives, and
// check the computed result (translation/java keeps the same split).

// Phase-2 orientation: a tiny lambda example. Pair it with `renderTinyLambdaTs`
// to inspect what the current translator emits for a typical lambda-bound
// expression. See the matching commentary in `runtime.pure` for the target
// __pureResolve / __pdo / __lambda emit shape we're moving to.
function meta::external::language::javascript::translation::tests::tinyLambdaExample(): Boolean[1]
{
   let inc = {x:Integer[1] | $x + 1};
   assertEquals(2, $inc->eval(1));
   // Reflection on the lambda — triggers metadata machinery
   assert($inc->genericType().type->toOne()->instanceOf(meta::pure::metamodel::function::LambdaFunction));
}

// Run the tiny example through the PCT adapter end-to-end (translate +
// execute on the host). Lets us catch regressions in the new metadata
// strategy (compile/execute split, __pureResolve / __pdo / __lambda) on
// a single small function before running the full PCT suite.
function <<test.Test>> meta::external::language::javascript::translation::tests::runTinyLambdaViaTranslator(): Boolean[1]
{
   testAdapterForTranslatedJavaScript(| {x:Integer[1] | $x + 1}->eval(1) == 2);
}

// Diagnostic: verify the round-tripped PDO has the right field values, even
// if the assertEquals comparator rejects them. Pin firstName / lastName /
// classifierGenericType type-path on the actual result.
function <<test.Test>> meta::external::language::javascript::translation::tests::debugFilterInstanceRoundTripFields(): Boolean[1]
{
   let smith   = ^meta::pure::functions::collection::tests::model::CO_Person(firstName='Fabrice', lastName='Smith');
   let doe     = ^meta::pure::functions::collection::tests::model::CO_Person(firstName='Pierre', lastName='Doe');
   let branche = ^meta::pure::functions::collection::tests::model::CO_Person(firstName='Justin', lastName='Branche');
   let result  = testAdapterForTranslatedJavaScript(
      | [$smith, $branche, $doe]->filter(p | !$p.lastName->isEmpty() && ($p.lastName->toOne()->length() < 6))
   )->cast(@meta::pure::functions::collection::tests::model::CO_Person);
   assertEquals(2, $result->size());
   assertEquals('Fabrice', $result->at(0).firstName);
   assertEquals('Smith',   $result->at(0).lastName);
   assertEquals('Pierre',  $result->at(1).firstName);
   assertEquals('Doe',     $result->at(1).lastName);
}
