import platform::extensions::language::javascript::*;
import platform::extensions::language::javascript::translation::*;
import platform::extensions::language::javascript::serialization::*;

// Translation helpers for the Pure->JavaScript translator: render a function or
// lambda to JavaScript source without executing it (translation/java keeps the
// same split).

// Helper: translate `tinyLambdaExample` to JavaScript source and return the
// serialized string. Invoke via:
//   pure-js execute --pdb …  --function platform::extensions::language::javascript::translation::tests::renderTinyLambdaTs_String_1_  --args ''
function <<test.TestDependency>>
platform::extensions::language::javascript::translation::tests::renderTinyLambdaTs(): String[1]
{
   let f  = platform::extensions::language::javascript::translation::tests::tinyLambdaExample__Boolean_1_;
   // Use conventionForRoot (same as the PCT adapter) so the lambdaIndex
   // is seeded and wrapLambdaWithAst actually emits __lambdaPtr wrappers.
   let sf = $f->translateFunctionDef(conventionForRoot($f));
   $sf->serialize();
}

function <<test.TestDependency>>
platform::extensions::language::javascript::translation::tests::renderFilterTestTs(): String[1]
{
   let lambda = {| [^platform::pure::functions::collection::tests::model::CO_Person(firstName='Fabrice', lastName='Smith')]
                  ->filter(p | !$p.lastName->isEmpty() && ($p.lastName->toOne()->length() < 6))};
   let canonical = $lambda->platform::extensions::pure::translation::canonical::makeCanonical(
                       [platform::extensions::pure::translation::canonical::CanonicalMode.InlineOpenVariables]);
   let sf = $canonical->translateFunctionDef(conventionForRoot($canonical));
   $sf->serialize();
}

function <<test.TestDependency>>
platform::extensions::language::javascript::translation::tests::renderMetaPropertiesTs(): String[1]
{
   let lambda = {| ^platform::pure::functions::meta::tests::model::CC_Address(name='Hoboken',
                       type=platform::pure::functions::meta::tests::model::CC_GeographicEntityType.CITY)
                     ->genericType()->platform::pure::functions::meta::properties()};
   let canonical = $lambda->platform::extensions::pure::translation::canonical::makeCanonical(
                       [platform::extensions::pure::translation::canonical::CanonicalMode.InlineOpenVariables]);
   let sf = $canonical->translateFunctionDef(conventionForRoot($canonical));
   $sf->serialize();
}

// The coder table is this platform's native registry, keyed by full id: every native the loaded modules declare
// has a coder (or is listed as not on this platform), and every coder is for a native — a function written in Pure
// is always translated from its body, never replaced.
function <<test.Test>> platform::extensions::language::javascript::translation::tests::testTheCodersAreTheNativesOfTheLoadedModules(): Boolean[1]
{
   let coders = platform::extensions::language::javascript::translation::defaultConvention().functionCoders->keys();
   let notHere = platform::extensions::language::javascript::translation::notOnThisPlatform().first;
   let natives = platform::pure::test::nativeFunctionsUnder(pathToElement('platform')->cast(@Package))->map(n | $n->elementToPath())->removeDuplicates();
   assertEquals([], $natives->filter(n | !$coders->contains($n) && !$notHere->contains($n))->sort());
   assertEquals([], $coders->filter(c | $notHere->contains($c))->sort());
   assertEquals([], $coders->filter(c | platform::pure::functions::meta::lenientPathToElement($c)
                                           ->filter(e | !$e->instanceOf(platform::pure::metamodel::function::NativeFunction))->isNotEmpty())->sort());
}

// -- updatability (pure/specification/IN_PLACE_UPDATE_ANALYSIS.md) ---------------------------------------------------------
// A use the compiler marked updatable in place calls the in-place helper; a fold whose step adds to its accumulator is told its
// updatability; a call passes the mask of its updatable in place arguments, and the callee decodes the bits its body reads.

function platform::extensions::language::javascript::translation::tests::grow(): Integer[*]
{
   let xs = [1, 2]->map(x|$x);
   $xs->add(3);
}

function platform::extensions::language::javascript::translation::tests::collect(values: Integer[*]): Integer[*]
{
   $values->fold({e, acc|if($e > 1, |$acc->add($e), |$acc)}, [])
}

function platform::extensions::language::javascript::translation::tests::append(values: Integer[*], value: Integer[1]): Integer[*]
{
   $values->add($value)
}

function platform::extensions::language::javascript::translation::tests::appendTwice(values: Integer[*]): Integer[*]
{
   platform::extensions::language::javascript::translation::tests::append(platform::extensions::language::javascript::translation::tests::append($values, 3), 4)
}

function platform::extensions::language::javascript::translation::tests::callsAppend(): Integer[*]
{
   let xs = [1, 2]->map(x|$x);
   platform::extensions::language::javascript::translation::tests::appendTwice($xs);
}

function <<test.TestDependency>> platform::extensions::language::javascript::translation::tests::compactTs(f: platform::pure::metamodel::function::FunctionDefinition<Any>[1]): String[1]
{
   $f->translateFunctionDef(conventionForRoot($f))->serialize()->replace('\n', '')->replace(' ', '');
}

function <<test.Test>> platform::extensions::language::javascript::translation::tests::testUpdatableInPlaceAddIsInPlace(): Boolean[1]
{
   let js = platform::extensions::language::javascript::translation::tests::grow__Integer_MANY_->platform::extensions::language::javascript::translation::tests::compactTs();
   assert($js->contains('__addInPlace('), | 'expected an in-place add in:\n' + $js);
}

function <<test.Test>> platform::extensions::language::javascript::translation::tests::testFoldStepIsToldItsUpdatability(): Boolean[1]
{
   let js = platform::extensions::language::javascript::translation::tests::collect_Integer_MANY__Integer_MANY_->platform::extensions::language::javascript::translation::tests::compactTs();
   assert($js->contains('__foldUpdatingInPlace(') && $js->contains('__addIfUpdatableInPlace('), | 'expected an updatableInPlace fold whose add is told its updatability in:\n' + $js);
}

function <<test.Test>> platform::extensions::language::javascript::translation::tests::testUpdatabilityPassesThroughCalls(): Boolean[1]
{
   let js = platform::extensions::language::javascript::translation::tests::callsAppend__Integer_MANY_->platform::extensions::language::javascript::translation::tests::compactTs();
   assert($js->contains('__updatableInPlaceBit(pureUpdatableInPlace,1)'), | 'expected the callee to decode bit 0 in:\n' + $js);
   assert($js->contains('values_pureUpdatableInPlace?1:0'), | 'expected appendTwice to pass its own flag on in:\n' + $js);
   assert($js->contains('__addIfUpdatableInPlace('), | 'expected append to add told its updatability in:\n' + $js);
}

// A qualified property with a list parameter it concatenates to takes the mask (defaulted, so __qp still matches it by
// arity); a call passing a list it never reads again goes through __qpUpdatingInPlace with that list's bit.
Class platform::extensions::language::javascript::translation::tests::Collector
{
   base: Integer[*];
   withAll(extra: Integer[*]) {$extra->concatenate($this.base)}: Integer[*];
}

function platform::extensions::language::javascript::translation::tests::collectInto(): Integer[*]
{
   let xs = [1, 2]->map(x|$x);
   ^platform::extensions::language::javascript::translation::tests::Collector(base = [3, 4]).withAll($xs);
}

function <<test.Test>> platform::extensions::language::javascript::translation::tests::testUpdatabilityPassesIntoAQualifiedProperty(): Boolean[1]
{
   let js = platform::extensions::language::javascript::translation::tests::collectInto__Integer_MANY_->platform::extensions::language::javascript::translation::tests::compactTs();
   assert($js->contains('\'withAll\',2,'), | 'expected the call to pass bit 1 (2) through __qpUpdatingInPlace in:\n' + $js);
   assert($js->contains('pureUpdatableInPlace=0') && $js->contains('__updatableInPlaceBit(pureUpdatableInPlace,2)'), | 'expected the qualified property to take a defaulted mask and decode bit 1 in:\n' + $js);
}

// A fold step growing a field of its accumulator: the read takes the object's own array (__updatableInPlaceRead) when the
// accumulator was passed updatable in place, and the grown array is stored as the object's own (__updatableInPlace).
function platform::extensions::language::javascript::translation::tests::growAField(): Integer[*]
{
   [1, 2, 3]->fold({e, acc|^$acc(base = $acc.base->add($e))}, ^platform::extensions::language::javascript::translation::tests::Collector(base = [])).base;
}

function <<test.Test>> platform::extensions::language::javascript::translation::tests::testAFieldGivenAwayIsGrownInPlace(): Boolean[1]
{
   let js = platform::extensions::language::javascript::translation::tests::growAField__Integer_MANY_->platform::extensions::language::javascript::translation::tests::compactTs();
   assert($js->contains('__updatableInPlaceRead('), | 'expected the field read to take the object\'s own array in:\n' + $js);
   assert($js->contains('__updatableInPlace('), | 'expected the grown array stored as the object\'s own in:\n' + $js);
}
