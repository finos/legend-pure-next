import meta::pure::metamodel::function::*;

// Lowers a Pure lambda to a Truffle RootNode (via the same path the runtime
// uses on first invocation — PureContext.callTargetForLambda) and returns
// the tree-form dump from Truffle's NodeUtil.printTreeToString. Powers the
// Pure -> Truffle AST gallery.
//
// Implementation lives in the Truffle runtime
// (org.finos.legend.pure.truffle.ast.natives.meta.TruffleAstForNode) and is
// registered on the default NativeNodeRegistry — no extension jar required.
// Bootstrap (java-direct) has no implementation; calling this from anywhere
// other than `--backend truffle` will fall through to the bridged-native
// path and throw "no implementation".
native function meta::external::language::truffle::truffleAstFor(
    lambda: LambdaFunction<meta::pure::metamodel::type::Any>[1]
): String[1];
