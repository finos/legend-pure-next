// matches(s, pat) -> whole-string match (`^pat$`).
function meta::external::language::typescript::translation::matchesCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__matches'), $args->map(a | $a->translateExpression($conv)));
}

// replace(s, from, to) -> s.replaceAll(from, to).
function meta::external::language::typescript::translation::replaceCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
