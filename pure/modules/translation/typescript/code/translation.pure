// Convention seeded with the canonical UDF's lambdas, in traversal order.
// Used by `testAdapterForTranslatedTypeScript` so emitted `__lambdaPtr(arrow,
// idx)` references match the host's `lambdaProp(idx, ...)` walk. The host
// walker is `PureReflectHost.collectLambdas` (Java); the Pure-side mirror is
// `collectLambdasInOrder` below — keep them aligned.
function meta::external::language::typescript::translation::conventionForRoot(
   root: meta::pure::metamodel::function::FunctionDefinition<meta::pure::metamodel::type::Any>[1]
): Convention[1]
{
   let base = defaultConvention();
   // For PE-backed roots use their resolver path; for in-memory canonicals
   // (no PE backing — typical of test adapter flows) fall back to the
   // sentinel address the Java side routes to the injected graph.
   let path = $root->match([
      pe: meta::pure::metamodel::PackageableElement[1] | $pe->elementToPath(),
      x:  meta::pure::metamodel::type::Any[1]          | '__local::root'
   ]);
   ^$base(
      lambdaIndex = $root.expressionSequence->collectLambdasInOrder(),
      rootPath    = $path
   );
}

// Walk a value-specification tree collecting LambdaFunctions in the same
// order PureReflectHost.collectLambdas walks. Order of recursion below MUST
// match the Java side — descend into LambdaFunction.expressionSequence,
// FunctionExpression.parametersValues, Collection.values, AtomicValue.value,
// emitting each LambdaFunction at first visit.
function meta::external::language::typescript::translation::collectLambdasInOrder(
   vs: ValueSpecification[*]
): meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[*]
{
   $vs->map(v | $v->collectLambdasInOrderOne());
}

function meta::external::language::typescript::translation::collectLambdasInOrderOne(
   vs: ValueSpecification[1]
): meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[*]
{
   $vs->match([
      lf: meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[1] |
         concatenate($lf, $lf.expressionSequence->collectLambdasInOrder()),
      fe: meta::pure::metamodel::valuespecification::FunctionExpression[1] |
         $fe.parametersValues->collectLambdasInOrder(),
      col: meta::pure::metamodel::valuespecification::Collection[1] |
         $col.values->collectLambdasInOrder(),
      av: meta::pure::metamodel::valuespecification::AtomicValue[1] |
         $av->collectLambdasInAtomicValue(),
      other: ValueSpecification[1] | []->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>)
   ]);
}

function meta::external::language::typescript::translation::collectLambdasInAtomicValue(
   av: meta::pure::metamodel::valuespecification::AtomicValue[1]
): meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[*]
{
   let isLambdaValued = $av.value->isNotEmpty()
       && $av.value->toOne()->instanceOf(meta::pure::metamodel::function::LambdaFunction);
   let inner = if ($isLambdaValued,
                   | [$av.value->toOne()->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>)],
                   | []->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>));
   $inner->concatenate($inner->map(l | $l.expressionSequence->collectLambdasInOrder()));
}

// ----------------------------------------------------------------------------
// Type mapping. TS has one numeric type, so Integer and Float collapse.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::pureTypeToTypeScriptType(
   g: meta::pure::metamodel::type::generics::GenericType[1],
   mult: meta::pure::metamodel::multiplicity::Multiplicity[1]
): TypeNode[1]
{
   let raw = $g->rawType()->toOne('pureTypeToTypeScriptType: unresolved rawType on GenericType');
   let base = if ($raw == Integer, | tsNumber(),
              |if ($raw == Float,   | tsNumber(),
              |if ($raw == Boolean, | tsBoolean(),
              |if ($raw == String,  | tsString(),
              | // User-defined Class types map to a TypeReferenceNode by short
              // name (last segment of the canonical path). The translator
              // emits the class itself elsewhere (or assumes a runtime where
              // the name is in scope); the type ref here is just the annotation.
              tsRef($raw->cast(@meta::pure::metamodel::PackageableElement)->elementToPath()->split('::')->last()->toOne())
              ))));
   // Multiplicity wrapping: `[*]` / `[1..*]` → `T[]`; scalar `[1]` stays bare.
   // `[0..1]` is unhandled today (would map to `T | undefined`); fall through
   // to bare T — refine as PCTs surface the need.
   $base;
}

// ----------------------------------------------------------------------------
// Expression walker. Variables -> TS identifiers; atomic values -> TS literals;
// function calls -> Convention's coder dispatch.
// ----------------------------------------------------------------------------

// JS reserved words that would collide with Pure identifiers. Map each to a
// mangled equivalent so the emitted TS parses. The mangling is a fixed `__`
// prefix; reverse-mangling on outputs isn't needed since we never read these
// names back from JS land.
function meta::external::language::typescript::translation::safeJsName(name: String[1]): String[1]
{
   let reserved = ['var', 'let', 'const', 'function', 'class', 'return', 'if',
                   'else', 'for', 'while', 'do', 'break', 'continue', 'throw',
                   'try', 'catch', 'finally', 'switch', 'case', 'default',
                   'new', 'delete', 'typeof', 'instanceof', 'in', 'of', 'void',
                   'this', 'super', 'null', 'true', 'false', 'undefined',
                   'NaN', 'Infinity', 'yield', 'async', 'await', 'export',
                   'import', 'debugger', 'with', 'enum', 'package', 'public',
                   'private', 'protected', 'interface', 'implements', 'static',
                   'arguments', 'eval'];
   if ($reserved->contains($name), | '__' + $name, | $name);
}

// Emit a JS-side pointer (`__pureResolve('path')`) for a top-level
// PackageableElement. The pointer is a Proxy whose property access routes
// back through the Java-side resolver — so reads like
// `Boolean.generalizations` lazily hit PDB rather than instantiating the
// metamodel graph in JS. `.path` is preserved for identity assertions.
// Returns `undefined` for anonymous values (no path).
function meta::external::language::typescript::translation::encodePeRef(v: Any[1]): Expression[1]
{
   let isPe = $v->instanceOf(meta::pure::metamodel::PackageableElement);
   let pe   = $v->cast(@meta::pure::metamodel::PackageableElement);
   // Use `elementToPath` rather than reading `.package` directly — the
   // former routes through the resolver so cross-module ClassPointers (which
   // have an unresolved `.package` slot) still produce their canonical path.
   let path = if ($isPe, | $pe->elementToPath(), | '');
   if (!$isPe || $path == '',
       | tsId('undefined'),
       | tsCall(tsId('__pureResolve'), [tsStrLit($path)]));
}

// Wrap a translated lambda arrow as `__lambda(arrow, '<rootPath>$lambda/<idx>')`
// — the second arg is the lambda's address (synthetic path) relative to the
// containing PE. The Java walker resolves the address to the LambdaFunction
// PDO so reflection reads (`__pdo(arrow).classifierGenericType`, etc.) reach
// the live metamodel rather than inlined JS data.
//
// `<rootPath>` comes from `conv.rootPath`, and `<idx>` from
// `conv.lambdaIndex->indexOf($lam)`. When either is missing (sub-translation
// without a root, gallery, etc.), fall back to a bare arrow — non-adapter
// callers rarely introspect lambdas, and silent fallback keeps them working.
function meta::external::language::typescript::translation::wrapLambdaWithAst(
   arrow: Expression[1],
   lam: meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[1],
   conv: Convention[1]
): Expression[1]
{
   let idx = if ($conv.lambdaIndex->isEmpty(),
                 | -1,
                 | $conv.lambdaIndex->indexOf($lam));
   if ($idx < 0 || $conv.rootPath->isEmpty(),
       | $arrow,
       | tsCall(tsId('__lambda'),
                [$arrow, tsStrLit($conv.rootPath->toOne() + '$lambda/' + $idx->toString())]));
}

function meta::external::language::typescript::translation::translateExpression(expr: ValueSpecification[1], conv: Convention[1]): Expression[1]
{
   $expr->match([
      {v: VariableExpression[1] |
         // `~` and chained forms (`~.~`, `~.foo`) are Pure's parent-reference
         // syntax for the surrounding `^Class(...)` construction. The runtime
         // bookkeeping that resolves these isn't available in plain JS, so we
         // emit `undefined` as a placeholder — tests that rely on the loop
         // semantics will fail equality, but the generated source still parses.
         if ($v.name->startsWith('~'),
             | tsId('undefined'),
             | tsId(safeJsName($v.name)));
      },
      a:  AtomicValue[1]        | $a->translateAtomicValue($conv),
      // A bare LambdaFunction in expression position → emit a TS arrow
      // wrapped with reflective AST metadata via Object.assign. The wrapped
      // value is still callable (so `$f(args)` and `arr.filter(arrow)` work
      // identically), but `.expressionSequence` / `.parameters` are now
      // introspectable — Pure tests like
      //   `{|toOne('a')}.expressionSequence->at(0).multiplicity`
      // can walk the AST at runtime, mirroring Java's reflective semantics.
      {lam: LambdaFunction<Any>[1] |
         let params = $lam.parameters->map(p | tsParamNoType(safeJsName($p.name)));
         let arrow = if ($lam.expressionSequence->size() == 1,
                         | tsArrowExpr($params, translateExpression($lam.expressionSequence->toOne(), $conv)),
                         | tsArrowBlock($params, $lam.expressionSequence->buildTsFunctionBody($conv)));
         wrapLambdaWithAst($arrow, $lam, $conv);
      },
      // Compiled Collection literal -> TS array literal.
      col: meta::pure::metamodel::valuespecification::Collection[1] | tsArrayLit($col.values->map(v | $v->translateExpression($conv))),
      {fe: FunctionExpression[1] |
         // Property access (`$p.lastName`) shows up either as a
         // DotApplication (the runtime classifier subtype) or as a generic
         // FunctionExpression with `func` set to an AbstractProperty. Both
         // shapes emit `obj.propName`; without this dispatch, every property
         // name would need its own coder entry.
         let isProperty = $fe->instanceOf(meta::pure::metamodel::valuespecification::DotApplication)
                          || ($fe.func->isNotEmpty() && $fe.func->toOne()->instanceOf(AbstractProperty));
         if ($isProperty,
             // Wrap the receiver with __pdo so a tagged-lambda receiver
             // (or any value carrying __purePath) gets resolved to its
             // Pure PDO proxy before property access. __pdo is a
             // pass-through on non-tagged values, so this is safe to apply
             // unconditionally — non-Pure receivers (already-proxied PE
             // refs, plain values) flow through unchanged.
             | tsAccess(tsCall(tsId('__pdo'), [translateExpression($fe.parametersValues->at(0), $conv)]), $fe.functionName),
             | // Coder dispatch tolerates fully-qualified function names by
             //   falling back to the last `::`-separated segment. The canonical
             //   recompile occasionally produces FQNs (`meta::pure::functions::
             //   lang::new` instead of `new`).
             let directHit = $conv.functionCoders->get($fe.functionName);
             let shortHit = if ($directHit->isNotEmpty(),
                                | $directHit,
                                | $conv.functionCoders->get($fe.functionName->split('::')->last()->toOne()));
             if ($shortHit->isNotEmpty(),
                 | $shortHit->toOne()->eval($fe.parametersValues, $conv),
                 | // Last-resort: if no coder matches, check whether `func`
                 //   resolves to a UserDefinedFunction; if so, emit a call to
                 //   the UDF by its short name. The UDF's body is collected
                 //   in `buildSourceFile` and emitted as a top-level
                 //   declaration alongside `execute`.
                 if ($fe.func->isNotEmpty() && $fe.func->toOne()->instanceOf(meta::pure::metamodel::function::UserDefinedFunction),
                     | let udfName = safeJsName($fe.functionName->split('::')->last()->toOne());
                       tsCall(tsId($udfName),
                              $fe.parametersValues->map(p | $p->translateExpression($conv)));,
                     | fail('No translator branch for Pure function: ' + $fe.functionName);
                       tsId('undefined');
                 )
             );
         );
      }
   ]);
}

function meta::external::language::typescript::translation::plusCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '+', $conv);
}

// minus is overloaded: binary `a - b` and unary `-a`. Dispatch on arity.
function meta::external::language::typescript::translation::minusCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   if ($args->size() == 1,
      | tsNeg(translateExpression($args->at(0), $conv)),
      | binaryInfix($args, '-', $conv));
}

function meta::external::language::typescript::translation::timesCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '*', $conv);
}

function meta::external::language::typescript::translation::divideCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // 2-arg: `a / b`. 3-arg `divide(Decimal, Decimal, scale)` ignores `scale`
   // because JS Number has no precision-scale concept.
   let left  = translateExpression($args->at(0), $conv);
   let right = translateExpression($args->at(1), $conv);
   tsBinary($left, '/', $right);
}

function meta::external::language::typescript::translation::remCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '%', $conv);
}

function meta::external::language::typescript::translation::equalCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // Pure `==` is structural for collections / no-Key class instances. JS `===`
   // is reference-only; delegate to the runtime `__eq` helper.
   assert($args->size() == 2, | 'equalCoder expects 2 args');
   tsCall(tsId('__eq'), [translateExpression($args->at(0), $conv), translateExpression($args->at(1), $conv)]);
}

function meta::external::language::typescript::translation::greaterThanCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '>', $conv);
}

function meta::external::language::typescript::translation::andCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '&&', $conv);
}

function meta::external::language::typescript::translation::orCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '||', $conv);
}

function meta::external::language::typescript::translation::lessThanCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '<', $conv);
}

function meta::external::language::typescript::translation::notCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'notCoder expects exactly 1 argument');
   tsNot(translateExpression($args->at(0), $conv));
}

// filter(collection, predicateLambda) -> `collection.filter(predicate)`.
function meta::external::language::typescript::translation::filterCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'filterCoder expects exactly 2 arguments');
   tsCall(tsAccess(translateExpression($args->at(0), $conv), 'filter'),
          [translateExpression($args->at(1), $conv)]);
}

// isEmpty(x) -> `x === undefined || (Array.isArray(x) && x.length === 0)`.
// Works for both `T[0..1]` (scalar may be undefined) and `T[*]` (empty array).
function meta::external::language::typescript::translation::isEmptyCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'isEmptyCoder expects exactly 1 argument');
   let x = translateExpression($args->at(0), $conv);
   tsBinary(
      tsBinary($x, '===', tsId('undefined')),
      '||',
      tsBinary(
         tsCall(tsAccess(tsId('Array'), 'isArray'), [$x]),
         '&&',
         tsBinary(tsAccess($x, 'length'), '===', tsNumLit('0'))
      )
   );
}

// toOne(x) -> identity in JS (the value already IS the underlying scalar at
// runtime; the [0..1] vs [1] distinction is a type-level concept that
// disappears at runtime).
function meta::external::language::typescript::translation::toOneCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'toOneCoder expects exactly 1 argument');
   translateExpression($args->at(0), $conv);
}

function meta::external::language::typescript::translation::lengthCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'lengthCoder expects exactly 1 argument');
   tsAccess(translateExpression($args->at(0), $conv), 'length');
}

// map(collection, fn) -> `collection.map(fn)`.
function meta::external::language::typescript::translation::mapCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'mapCoder expects exactly 2 arguments');
   tsCall(tsAccess(translateExpression($args->at(0), $conv), 'map'),
          [translateExpression($args->at(1), $conv)]);
}

// fold(collection, fn, seed) — Pure fold passes (item, acc); JS reduce passes
// (acc, item). Delegate to a runtime helper that tolerates scalar inputs
// (`fold(1, fn, seed)` is a single-value fold, not a fold over an array).
// Inline `collection.reduce(...)` would also break syntactically on numeric
// literals (`1.reduce(...)` is parsed as `1.r educe(...)`).
function meta::external::language::typescript::translation::foldCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 3, | 'foldCoder expects exactly 3 arguments');
   tsCall(tsId('__fold'), $args->map(a | $a->translateExpression($conv)));
}

// take(collection, n) -> `collection.slice(0, n)`.
function meta::external::language::typescript::translation::takeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'takeCoder expects exactly 2 arguments');
   tsCall(tsAccess(translateExpression($args->at(0), $conv), 'slice'),
          [tsNumLit('0'), translateExpression($args->at(1), $conv)]);
}

// drop(collection, n) -> `collection.slice(n)`.
function meta::external::language::typescript::translation::dropCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'dropCoder expects exactly 2 arguments');
   tsCall(tsAccess(translateExpression($args->at(0), $conv), 'slice'),
          [translateExpression($args->at(1), $conv)]);
}

// toString(x) — delegate to runtime helper that recognizes Pair (`<a, b>`),
// List (`[a, b, c]`), arrays, primitives, and falls back to JSON.stringify
// for the remaining cases.
function meta::external::language::typescript::translation::toStringCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'toStringCoder expects exactly 1 argument');
   tsCall(tsId('__toString'), [translateExpression($args->at(0), $conv)]);
}

// eval(fn, args...) -> `fn(args...)`. Pure's eval invokes a function value
// with positional args; in JS that's plain call syntax.
function meta::external::language::typescript::translation::evalCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 1, | 'evalCoder expects at least 1 argument (the callee)');
   let callee   = translateExpression($args->at(0), $conv);
   let restArgs = $args->slice(1, $args->size())->map(a | $a->translateExpression($conv));
   tsCall($callee, $restArgs);
}

// ^Class(k=v, ...) compiles to new(holder, [keyExpression('k', v), ...]).
// args[0] = the GenericTypeAndMultiplicityHolder. We extract the holder's
// rawType class so the emitted instance can carry a `_type` classifier
// chain (the class + its `superTypes` chain up to Any). `instanceOf`
// then walks the chain at runtime.
// args[1] = a Collection of either:
//   (a) `keyExpression('k', v)` FunctionExpressions, or
//   (b) explicit `^KeyExpression(name='k', expression=v)` literals, which the
//       compiler desugars to nested `new(@KeyExpression|1, [keyExpression(...)])`
//       calls — we unwrap them recursively.
function meta::external::language::typescript::translation::newCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 1, | 'newCoder expects at least 1 argument (the type holder)');
   let keyExprs = if ($args->size() >= 2,
      | $args->at(1)->cast(@meta::pure::metamodel::valuespecification::Collection).values,
      | []->cast(@ValueSpecification));
   let entries = $keyExprs->map(ke | $ke->extractKeyEntry($conv));
   // `classifierGenericType` is the canonical self-describing tag — the Java
   // lift uses it to pick the right class, and JS-side `__instanceOf` walks
   // the classifier chain via `__pureHost.instanceOf`. The older `_type`
   // chain is redundant (and walking `cls.generalizations` here would choke
   // on cross-module ClassPointers).
   let cgtEntry   = $args->at(0)->classifierGenericTypeEntry();
   tsObject($entries->concatenate($cgtEntry));
}

// Emit `classifierGenericType: { rawType: __ptr('classPath') }` for the class
// being instantiated. Self-describing tag the Java-side toPureValue reads to
// decide which Pure class to lift the JS object into — without relying on the
// caller threading a `returnClass`. Same shape Pure's metamodel uses (every
// instance has a classifierGenericType slot), so Pure code reading
// `$obj.classifierGenericType.rawType` finds the canonical class via the
// `__ptr` resolver.
function meta::external::language::typescript::translation::classifierGenericTypeEntry(holder: ValueSpecification[1]): meta::external::language::typescript::metamodel::PropertyAssignment[*]
{
   let rawType = $holder->holderTargetType();
   if ($rawType->isEmpty() || !$rawType->toOne()->instanceOf(meta::pure::metamodel::PackageableElement),
      | []->cast(@meta::external::language::typescript::metamodel::PropertyAssignment),
      | let pe = $rawType->toOne()->cast(@meta::pure::metamodel::PackageableElement);
        [tsEntry('classifierGenericType',
                 tsObject([tsEntry('rawType', encodePeRef($pe))]))];
   );
}

// Build the `_type: [path, super1, super2, ..., Any]` entry from the holder.
// Walk the class's `generalizations` chain to capture the full supertype
// list. Translator-internal `_`-prefixed key is skipped by `__eq` and by
// the Java-side `liftToPdo` so it doesn't pollute structural compare or
// Pure-side PDO writes.
function meta::external::language::typescript::translation::instanceTypeEntry(holder: ValueSpecification[1]): meta::external::language::typescript::metamodel::PropertyAssignment[*]
{
   let rawType = $holder->holderTargetType();
   if ($rawType->isEmpty() || !$rawType->toOne()->instanceOf(meta::pure::metamodel::type::Class),
      | []->cast(@meta::external::language::typescript::metamodel::PropertyAssignment),
      | let cls = $rawType->toOne()->cast(@Class<Any>);
        let chain = $cls->classChain();
        let chainArr = tsArrayLit($chain->map(p | tsStrLit($p)));
        [tsEntry('_type', $chainArr)];
   );
}

// Extract the user-facing target class from a holder VS. The holder's
// `.genericType` slot describes the holder's OWN classifier shape
// (e.g. `UserDefinedGenericTypeAndMultiplicityHolder<LA_Person>`), so
// `holder.genericType.rawType` returns the holder class itself, not
// the user class. The user class is one level deeper — at
// `holder.genericType.typeArguments[0].rawType` — same path compiler-pure
// uses (see functionExpressionResolver.pure).
function meta::external::language::typescript::translation::holderTargetType(holder: ValueSpecification[1]): meta::pure::metamodel::type::Type[0..1]
{
   let isUdgmh = $holder->instanceOf(meta::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder);
   let cast = $holder->cast(@meta::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder);
   let gt = if ($isUdgmh && $cast.genericType->isNotEmpty(),
                | $cast.genericType->toOne(),
                | []->cast(@meta::pure::metamodel::type::generics::GenericType));
   // Inline `genericTypeTypeArguments` — that helper lives in compiler-pure
   // which the translator module doesn't depend on. Same match logic: only
   // GenericTypeValue carries `.typeArguments`; other GenericType shapes
   // (InferredGenericType, TypeParameter binding) have no type args.
   let typeArgs = $gt->match([
      gtv: meta::pure::metamodel::type::generics::GenericTypeValue[1] | $gtv.typeArguments,
      e:  meta::pure::metamodel::type::generics::GenericType[*]        | []->cast(@meta::pure::metamodel::type::generics::GenericType)
   ]);
   if ($typeArgs->isEmpty(),
       | []->cast(@meta::pure::metamodel::type::Type),
       | $typeArgs->at(0)->rawType());
}

// Walk a Class's generalization chain, collecting paths from the class
// itself up to (and including) `meta::pure::metamodel::type::Any`.
// Idempotent at every node (dedup via Pure set semantics on the result).
function meta::external::language::typescript::translation::classChain(cls: meta::pure::metamodel::type::Class<meta::pure::metamodel::type::Any>[1]): String[*]
{
   let self = $cls->cast(@meta::pure::metamodel::PackageableElement)->elementToPath();
   let supers = $cls.generalizations
                    ->map(g | $g.general->rawType())
                    ->filter(t | $t->isNotEmpty() && $t->toOne()->instanceOf(meta::pure::metamodel::type::Class))
                    ->cast(@meta::pure::metamodel::type::Class<meta::pure::metamodel::type::Any>);
   let superChains = $supers->map(s | $s->classChain());
   concatenate([$self], $superChains);
}

function meta::external::language::typescript::translation::extractKeyEntry(ke: ValueSpecification[1], conv: Convention[1]): meta::external::language::typescript::metamodel::PropertyAssignment[1]
{
   let kfe = $ke->cast(@FunctionExpression);
   if ($kfe.functionName == 'keyExpression',
      | let name  = $kfe.parametersValues->at(0)->cast(@AtomicValue).value->cast(@String);
        let value = translateExpression($kfe.parametersValues->at(1), $conv);
        tsEntry($name, $value);,
      | // `new(@KeyExpression|1, [keyExpression('name', n), keyExpression('expression', v)])`.
        // Recurse into the inner keyExpression Collection and pluck the `name`
        // and `expression` entries.
        assert($kfe.functionName == 'new',
           | 'extractKeyEntry: expected keyExpression or new(@KeyExpression), got ' + $kfe.functionName);
        let inner = $kfe.parametersValues->at(1)
                       ->cast(@meta::pure::metamodel::valuespecification::Collection).values;
        let nameFE = $inner->filter(i | $i->cast(@FunctionExpression).parametersValues->at(0)
                                            ->cast(@AtomicValue).value->cast(@String) == 'name')->toOne();
        let valueFE = $inner->filter(i | $i->cast(@FunctionExpression).parametersValues->at(0)
                                             ->cast(@AtomicValue).value->cast(@String) == 'expression')->toOne();
        let name  = $nameFE->cast(@FunctionExpression).parametersValues->at(1)
                       ->cast(@AtomicValue).value->cast(@String);
        let value = translateExpression($valueFE->cast(@FunctionExpression).parametersValues->at(1), $conv);
        tsEntry($name, $value);
   );
}

function meta::external::language::typescript::translation::binaryInfix(args: ValueSpecification[*], op: String[1], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'binaryInfix expects exactly 2 arguments, got ' + $args->size()->toString());
   tsBinary(translateExpression($args->at(0), $conv), $op, translateExpression($args->at(1), $conv));
}

// Helper: emit `receiver.method(...args[1..])`.
function meta::external::language::typescript::translation::methodCall(
   args: ValueSpecification[*], method: String[1], conv: Convention[1]
): Expression[1]
{
   assert($args->size() >= 1, | 'methodCall (' + $method + '): need a receiver arg');
   let recv = translateExpression($args->at(0), $conv);
   let rest = $args->slice(1, $args->size())->map(a | $a->translateExpression($conv));
   tsCall(tsAccess($recv, $method), $rest);
}

// Helper: emit `Math.method(...args)`.
function meta::external::language::typescript::translation::mathCall(
   args: ValueSpecification[*], method: String[1], conv: Convention[1]
): Expression[1]
{
   let tsArgs = $args->map(a | $a->translateExpression($conv));
   tsCall(tsAccess(tsId('Math'), $method), $tsArgs);
}

// ----------------------------------------------------------------------------
// Collection coders.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::atCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'atCoder expects exactly 2 arguments');
   // Pure `at(coll, i)` throws on out-of-range; JS `Array.at(i)` returns
   // undefined. Delegate to a runtime helper so the throwing semantics
   // line up — required by `testSimpleAssertError` and other tests that
   // pin the error message.
   tsCall(tsId('__at'), $args->map(a | $a->translateExpression($conv)));
}

function meta::external::language::typescript::translation::sizeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'sizeCoder expects exactly 1 argument');
   tsAccess(translateExpression($args->at(0), $conv), 'length');
}

function meta::external::language::typescript::translation::headCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'headCoder expects exactly 1 argument');
   tsCall(tsAccess(translateExpression($args->at(0), $conv), 'at'), [tsNumLit('0')]);
}

function meta::external::language::typescript::translation::firstCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   $args->headCoder($conv);
}

function meta::external::language::typescript::translation::lastCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'lastCoder expects exactly 1 argument');
   tsCall(tsAccess(translateExpression($args->at(0), $conv), 'at'), [tsNumLit('-1')]);
}

function meta::external::language::typescript::translation::tailCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'tailCoder expects exactly 1 argument');
   tsCall(tsAccess(translateExpression($args->at(0), $conv), 'slice'), [tsNumLit('1')]);
}

function meta::external::language::typescript::translation::initCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'initCoder expects exactly 1 argument');
   tsCall(tsAccess(translateExpression($args->at(0), $conv), 'slice'), [tsNumLit('0'), tsNumLit('-1')]);
}

function meta::external::language::typescript::translation::reverseCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'reverseCoder expects exactly 1 argument');
   tsCall(tsAccess(tsCall(tsAccess(translateExpression($args->at(0), $conv), 'slice'), []), 'reverse'), []);
}

function meta::external::language::typescript::translation::isNotEmptyCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 1, | 'isNotEmptyCoder expects exactly 1 argument');
   // Pure semantics: a value is non-empty if it's not undefined AND, when an array, length > 0.
   // For arrays in JS, `arr.length > 0` is correct; for [1] scalar slot, the value is a non-array.
   // Conservative: `x !== undefined && (Array.isArray(x) ? x.length > 0 : true)`.
   let x = translateExpression($args->at(0), $conv);
   tsBinary(
      tsBinary($x, '!==', tsId('undefined')),
      '&&',
      tsTernary(
         tsCall(tsAccess(tsId('Array'), 'isArray'), [$x]),
         tsBinary(tsAccess($x, 'length'), '>', tsNumLit('0')),
         tsBoolLit(true)
      )
   );
}

function meta::external::language::typescript::translation::containsCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // 2-arg: structural-equality contains via runtime helper. JS
   // `coll.includes(obj)` is reference-only; Pure uses structural equality
   // for non-primitive class instances (and identity-equality fallback).
   // 3-arg form passes an explicit equality function.
   if ($args->size() == 2,
      | tsCall(tsId('__contains'), $args->map(a | $a->translateExpression($conv))),
      | tsCall(tsId('__containsBy'), $args->map(a | $a->translateExpression($conv)))
   );
}

function meta::external::language::typescript::translation::concatenateCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'concatenateCoder expects exactly 2 arguments');
   methodCall($args, 'concat', $conv);
}

function meta::external::language::typescript::translation::addCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 2, | 'addCoder expects at least 2 arguments');
   // add(coll, x) → [...coll, x]; add(coll, idx, x) → [...coll.slice(0,idx), x, ...coll.slice(idx)]
   if ($args->size() == 2,
      | let coll = translateExpression($args->at(0), $conv);
        let elt  = translateExpression($args->at(1), $conv);
        tsArrayLit([tsSpread($coll), $elt]);,
      | let coll = translateExpression($args->at(0), $conv);
        let idx  = translateExpression($args->at(1), $conv);
        let elt  = translateExpression($args->at(2), $conv);
        tsArrayLit([
           tsSpread(tsCall(tsAccess($coll, 'slice'), [tsNumLit('0'), $idx])),
           $elt,
           tsSpread(tsCall(tsAccess($coll, 'slice'), [$idx]))
        ]);
   );
}

function meta::external::language::typescript::translation::sliceCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 2, | 'sliceCoder expects at least 2 arguments');
   methodCall($args, 'slice', $conv);
}

function meta::external::language::typescript::translation::sortCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // sort(coll) -> [...coll].sort(); sort(coll, cmpFn) -> [...coll].sort(cmpFn).
   let coll = translateExpression($args->at(0), $conv);
   let copy = tsArrayLit([tsSpread($coll)]);
   let rest = $args->slice(1, $args->size())->map(a | $a->translateExpression($conv));
   tsCall(tsAccess($copy, 'sort'), $rest);
}

function meta::external::language::typescript::translation::removeDuplicatesCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // 1-arg form: `[...new Set(coll)]` (referential dedup).
   // 2-arg form: removeDuplicates(coll, eqFn) — runtime helper that uses the
   //   supplied predicate to compare pairs.
   if ($args->size() == 1,
      | tsArrayLit([tsSpread(tsNew(tsId('Set'), [translateExpression($args->at(0), $conv)]))]),
      | tsCall(tsId('__removeDuplicatesBy'), $args->map(a | $a->translateExpression($conv)))
   );
}

function meta::external::language::typescript::translation::indexOfCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // String.indexOf / Array.indexOf both accept (search) or (search, fromIdx) —
   // forward all args via methodCall.
   methodCall($args, 'indexOf', $conv);
}

function meta::external::language::typescript::translation::lastIndexOfCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'lastIndexOfCoder expects exactly 2 arguments');
   methodCall($args, 'lastIndexOf', $conv);
}

function meta::external::language::typescript::translation::findCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'findCoder expects exactly 2 arguments');
   methodCall($args, 'find', $conv);
}

function meta::external::language::typescript::translation::forAllCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'forAllCoder expects exactly 2 arguments');
   methodCall($args, 'every', $conv);
}

function meta::external::language::typescript::translation::existsCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'existsCoder expects exactly 2 arguments');
   methodCall($args, 'some', $conv);
}

// firstNonEmpty(thunks) — Pure's signature is `firstNonEmpty(Function<{->T[*]}>[*]):T[*]`.
// Walk the thunk list in order, invoke each, return the first non-empty
// result; short-circuits so a later thunk that would throw is never run.
function meta::external::language::typescript::translation::firstNonEmptyCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__firstNonEmpty'), [translateExpression($args->at(0), $conv)]);
}

// ----------------------------------------------------------------------------
// String coders.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::joinStringsCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // Always route through the `__joinStrings` runtime helper so the four
   // Pure overloads (1, 2, 3, 4 arg) share a single semantics defined in
   // runtime-lib.ts. Inlining `prefix + coll.join(sep) + suffix` worked for
   // arrays of strings but mis-handled the scalar-tolerance / non-string
   // element cases Pure's `joinStrings` supports.
   tsCall(tsId('__joinStrings'), $args->map(a | $a->translateExpression($conv)));
}

function meta::external::language::typescript::translation::substringCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'substring', $conv);
}

function meta::external::language::typescript::translation::startsWithCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'startsWith', $conv);
}

function meta::external::language::typescript::translation::endsWithCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'endsWith', $conv);
}

function meta::external::language::typescript::translation::splitCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'split', $conv);
}

function meta::external::language::typescript::translation::trimCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'trim', $conv);
}

function meta::external::language::typescript::translation::toUpperCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'toUpperCase', $conv);
}

function meta::external::language::typescript::translation::toLowerCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'toLowerCase', $conv);
}

function meta::external::language::typescript::translation::parseIntegerCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('parseInt'), [translateExpression($args->at(0), $conv), tsNumLit('10')]);
}

function meta::external::language::typescript::translation::parseFloatCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('parseFloat'), [translateExpression($args->at(0), $conv)]);
}

function meta::external::language::typescript::translation::parseDecimalCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('parseFloat'), [translateExpression($args->at(0), $conv)]);
}

// ----------------------------------------------------------------------------
// Math coders.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::absCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   mathCall($args, 'abs', $conv);
}

function meta::external::language::typescript::translation::floorCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   mathCall($args, 'floor', $conv);
}

function meta::external::language::typescript::translation::ceilingCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   mathCall($args, 'ceil', $conv);
}

function meta::external::language::typescript::translation::roundCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   mathCall($args, 'round', $conv);
}

function meta::external::language::typescript::translation::powCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   mathCall($args, 'pow', $conv);
}

function meta::external::language::typescript::translation::sqrtCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   mathCall($args, 'sqrt', $conv);
}

function meta::external::language::typescript::translation::minNativeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // min over a collection: Math.min(...coll)
   if ($args->size() == 1,
      | tsCall(tsAccess(tsId('Math'), 'min'), [tsSpread(translateExpression($args->at(0), $conv))]),
      | mathCall($args, 'min', $conv));
}

function meta::external::language::typescript::translation::maxNativeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   if ($args->size() == 1,
      | tsCall(tsAccess(tsId('Math'), 'max'), [tsSpread(translateExpression($args->at(0), $conv))]),
      | mathCall($args, 'max', $conv));
}

function meta::external::language::typescript::translation::modCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '%', $conv);
}

function meta::external::language::typescript::translation::sumCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // sum(coll) -> coll.reduce((a,b) => a+b, 0)
   let coll = translateExpression($args->at(0), $conv);
   let fn = tsArrowExpr(
      [tsParamNoType('__a'), tsParamNoType('__b')],
      tsBinary(tsId('__a'), '+', tsId('__b'))
   );
   tsCall(tsAccess($coll, 'reduce'), [$fn, tsNumLit('0')]);
}

function meta::external::language::typescript::translation::averageCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // average(coll) -> coll.reduce((a,b)=>a+b, 0) / coll.length
   let coll = translateExpression($args->at(0), $conv);
   let fn = tsArrowExpr(
      [tsParamNoType('__a'), tsParamNoType('__b')],
      tsBinary(tsId('__a'), '+', tsId('__b'))
   );
   tsBinary(
      tsCall(tsAccess($coll, 'reduce'), [$fn, tsNumLit('0')]),
      '/',
      tsAccess($coll, 'length')
   );
}

// ----------------------------------------------------------------------------
// Comparison + identity coders.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::greaterThanEqualCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '>=', $conv);
}

function meta::external::language::typescript::translation::lessThanEqualCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '<=', $conv);
}

function meta::external::language::typescript::translation::isTrueCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsBinary(translateExpression($args->at(0), $conv), '===', tsBoolLit(true));
}

function meta::external::language::typescript::translation::isFalseCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsBinary(translateExpression($args->at(0), $conv), '===', tsBoolLit(false));
}

// is(a, b) -> reference equality. JS === is fine for primitives, and for objects
// it's reference identity, matching Pure semantics.
function meta::external::language::typescript::translation::isCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   binaryInfix($args, '===', $conv);
}

// ----------------------------------------------------------------------------
// Control flow.
// ----------------------------------------------------------------------------

// Pure's `if` is overloaded:
//   - if(test:Boolean[1], valid:Function, invalid:Function) -> ternary
//   - if(condList:Pair<Function, Function>[*], default:Function) -> multi-if
// Both forms emit a runtime dispatch via __if so we don't have to walk the
// pair-collection at translation time.
function meta::external::language::typescript::translation::ifCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   if ($args->size() == 3,
      | let cond = translateExpression($args->at(0), $conv);
        let thn  = translateExpression($args->at(1), $conv);
        let els  = translateExpression($args->at(2), $conv);
        tsTernary($cond, tsCall($thn, []), tsCall($els, []));,
      | tsCall(tsId('__multiIf'), $args->map(a | $a->translateExpression($conv)))
   );
}

// ----------------------------------------------------------------------------
// Assertion coders. All emit an IIFE that throws on failure and returns `true`
// on success. Pure's assert* return Boolean[1]; throwing on failure matches the
// "test crashes" semantics for the PCT runner.
// ----------------------------------------------------------------------------

// Helper: invoke the runtime `__assert(cond, msg)` helper which throws on
// failure. The preamble in runtime.pure prepends a TS declaration for
// `__assert` so it's in scope wherever assertion coders emit calls to it.
function meta::external::language::typescript::translation::assertHelper(cond: Expression[1], msg: Expression[1]): Expression[1]
{
   tsCall(tsId('__assert'), [$cond, $msg]);
}

function meta::external::language::typescript::translation::assertCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // assert(cond) / assert(cond, msg). Msg may be a lambda or a string.
   let cond = translateExpression($args->at(0), $conv);
   let msg  = if ($args->size() >= 2,
                  | translateExpression($args->at(1), $conv),
                  | tsStrLit('assertion failed'));
   assertHelper($cond, $msg);
}

function meta::external::language::typescript::translation::assertEqualsCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // Delegate to the runtime structural-equality helper (`__eq`).
   assert($args->size() >= 2, | 'assertEqualsCoder needs at least 2 args');
   let expected = translateExpression($args->at(0), $conv);
   let actual   = translateExpression($args->at(1), $conv);
   let msg = tsBinary(
      tsBinary(tsStrLit('expected '), '+', tsCall(tsAccess(tsId('JSON'), 'stringify'), [$expected])),
      '+',
      tsBinary(tsStrLit(', got '), '+', tsCall(tsAccess(tsId('JSON'), 'stringify'), [$actual]))
   );
   assertHelper(tsCall(tsId('__eq'), [$expected, $actual]), $msg);
}

function meta::external::language::typescript::translation::assertNotEqualsCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let expected = translateExpression($args->at(0), $conv);
   let actual   = translateExpression($args->at(1), $conv);
   assertHelper(tsNot(tsCall(tsId('__eq'), [$expected, $actual])), tsStrLit('assertNotEquals failed'));
}

function meta::external::language::typescript::translation::assertEmptyCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let x = translateExpression($args->at(0), $conv);
   // Empty = undefined OR (Array.isArray && length === 0)
   let cond = tsBinary(
      tsBinary($x, '===', tsId('undefined')),
      '||',
      tsBinary(
         tsCall(tsAccess(tsId('Array'), 'isArray'), [$x]),
         '&&',
         tsBinary(tsAccess($x, 'length'), '===', tsNumLit('0'))
      )
   );
   assertHelper($cond, tsStrLit('assertEmpty failed'));
}

function meta::external::language::typescript::translation::assertIsCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // assertIs is identity in Pure. JS `===` matches for primitives.
   let expected = translateExpression($args->at(0), $conv);
   let actual   = translateExpression($args->at(1), $conv);
   let cond = tsBinary($expected, '===', $actual);
   assertHelper($cond, tsStrLit('assertIs failed'));
}

function meta::external::language::typescript::translation::assertIsNotCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let expected = translateExpression($args->at(0), $conv);
   let actual   = translateExpression($args->at(1), $conv);
   assertHelper(tsBinary($expected, '!==', $actual), tsStrLit('assertIsNot failed'));
}

function meta::external::language::typescript::translation::assertFalseCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let x = translateExpression($args->at(0), $conv);
   assertHelper(tsBinary($x, '===', tsBoolLit(false)), tsStrLit('assertFalse failed'));
}

// ----------------------------------------------------------------------------
// Type-info coders. Pure has rich runtime type introspection; JS objects
// don't carry the same classifier metadata, so these are best-effort.
// ----------------------------------------------------------------------------

// cast(x, type) -> identity in JS (no runtime type check). Pure's cast either
// succeeds or throws; we lose the throw-on-mismatch behavior but most PCTs
// pass a correctly-typed value.
function meta::external::language::typescript::translation::castCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

// instanceOf(v, type) -> runtime helper that walks the metamodel
// classifier hierarchy embedded in the runtime preamble. Knows about
// JS primitives (typeof checks) and Pure class-refs / instances tagged
// with `_kind` / `_type`.
function meta::external::language::typescript::translation::instanceOfCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'instanceOfCoder expects 2 args');
   tsCall(tsId('__instanceOf'), [translateExpression($args->at(0), $conv),
                                  translateExpression($args->at(1), $conv)]);
}

// type(x) / genericType(x) -> identity. Pure tests downstream may extract
// `.type` or `.classifierGenericType`; without classifier metadata in JS
// those property reads return undefined. Returning $x lets the access
// chain at least not crash for primitive-style introspection.
function meta::external::language::typescript::translation::typeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

function meta::external::language::typescript::translation::genericTypeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

function meta::external::language::typescript::translation::compareCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // compare(a, b) -> a < b ? -1 : a > b ? 1 : 0
   assert($args->size() == 2, | 'compareCoder expects exactly 2 arguments');
   let a = translateExpression($args->at(0), $conv);
   let b = translateExpression($args->at(1), $conv);
   tsTernary(
      tsBinary($a, '<', $b),
      tsNumLit('-1'),
      tsTernary(tsBinary($a, '>', $b), tsNumLit('1'), tsNumLit('0'))
   );
}

// ----------------------------------------------------------------------------
// Display + serialization coders.
// ----------------------------------------------------------------------------

// print(x) -> console.log(x), return x (Pure's print returns its input).
// Use a block-body arrow so the `console.log(x); return x;` sequence is
// unambiguous (an expression-body arrow with a comma operator is parsed as
// `(arrow), rest` at the comma-expression's call site).
function meta::external::language::typescript::translation::printCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let x = translateExpression($args->at(0), $conv);
   tsCall(
      tsArrowBlock(
         [tsParamNoType('__p')],
         tsBlock([
            tsExprStmt(tsCall(tsAccess(tsId('console'), 'log'), [tsId('__p')])),
            tsReturn(tsId('__p'))
         ])
      ),
      [$x]
   );
}

function meta::external::language::typescript::translation::printlnCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   $args->printCoder($conv);
}

// format(tpl, args) — Pure's signature is `format(String[1], Any[*]):String[1]`.
// The `args:Any[*]` slot arrives as a single Collection value (not splatted),
// so we pass `$args->at(1)` straight through to the runtime helper.
function meta::external::language::typescript::translation::formatCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let tpl = translateExpression($args->at(0), $conv);
   let rest = if ($args->size() >= 2,
      | translateExpression($args->at(1), $conv),
      | tsArrayLit([]));
   tsCall(tsId('__format'), [$tpl, $rest]);
}

// toRepresentation(x) -> JSON.stringify or a primitive's literal form.
function meta::external::language::typescript::translation::toRepresentationCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__toRepresentation'), [translateExpression($args->at(0), $conv)]);
}

// copy(obj, kvList) -> { ...obj, k1: v1, ... }. The spread must come FIRST so
// later entries override the base — emitting `{ k1: v1, ...obj }` would let
// the base values shadow the new ones.
function meta::external::language::typescript::translation::copyCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 1, | 'copyCoder expects at least 1 argument');
   let base = translateExpression($args->at(0), $conv);
   let keyExprs = if ($args->size() >= 2,
      | $args->at(1)->cast(@meta::pure::metamodel::valuespecification::Collection).values,
      | []->cast(@ValueSpecification));
   let entries = $keyExprs->map(ke |
      let kfe = $ke->cast(@FunctionExpression);
      let name  = $kfe.parametersValues->at(0)->cast(@AtomicValue).value->cast(@String);
      let value = translateExpression($kfe.parametersValues->at(1), $conv);
      tsEntry($name, $value);
   );
   tsObject([tsSpreadEntry($base)]->concatenate($entries));
}

function meta::external::language::typescript::translation::regexpLikeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // 2-arg form regexpLike(str, pattern); 3-arg form adds RegexpParameter flags
   // (CASE_INSENSITIVE / CASE_SENSITIVE / MULTILINE / NON_NEWLINE_SENSITIVE).
   // Delegate to a runtime helper that maps flags → JS regex flags.
   assert($args->size() >= 2, | 'regexpLikeCoder expects at least 2 args');
   if ($args->size() == 2,
      | tsCall(tsAccess(tsNew(tsId('RegExp'), [translateExpression($args->at(1), $conv)]), 'test'),
               [translateExpression($args->at(0), $conv)]),
      | tsCall(tsId('__regexpLike'), $args->map(a | $a->translateExpression($conv)))
   );
}

function meta::external::language::typescript::translation::tsNew(callee: Expression[1], args: Expression[*]): Expression[1]
{
   ^meta::external::language::typescript::metamodel::NewExpression(
      expression = $callee,
      arguments  = $args,
      typeArguments = []
   );
}

// ----------------------------------------------------------------------------
// More coders (later additions).
// ----------------------------------------------------------------------------

// assertError(thunk, expectedMessage) — invokes the lambda, expects it to
// throw, and verifies the thrown message contains/matches the expected. Emit:
//   ((thunk, m) => { try { thunk(); return __assert(false, 'expected error') }
//                    catch(e) { return __assert(String(e.message).includes(m), m); } })(t, m)
function meta::external::language::typescript::translation::assertErrorCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 2, | 'assertErrorCoder expects 2+ args');
   let thunk = translateExpression($args->at(0), $conv);
   let msg   = translateExpression($args->at(1), $conv);
   // Inline an IIFE that wraps the call in try/catch.
   let arrow = tsArrowBlock(
      [tsParamNoType('__t'), tsParamNoType('__m')],
      tsBlock([
         tsExprStmt(tsCall(tsId('__assertError'), [tsId('__t'), tsId('__m')])),
         tsReturn(tsBoolLit(true))
      ])
   );
   tsCall($arrow, [$thunk, $msg]);
}

// assertSize(coll, n[, msg]) -> assertEquals on coll.length === n.
function meta::external::language::typescript::translation::assertSizeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 2, | 'assertSizeCoder expects at least 2 args');
   let coll = translateExpression($args->at(0), $conv);
   let n    = translateExpression($args->at(1), $conv);
   assertHelper(
      tsBinary(
         tsTernary(
            tsCall(tsAccess(tsId('Array'), 'isArray'), [$coll]),
            tsAccess($coll, 'length'),
            tsNumLit('1')
         ),
         '===',
         $n
      ),
      tsStrLit('assertSize failed')
   );
}

function meta::external::language::typescript::translation::assertNotEmptyCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let x = translateExpression($args->at(0), $conv);
   let cond = tsBinary(
      tsBinary($x, '!==', tsId('undefined')),
      '&&',
      tsTernary(
         tsCall(tsAccess(tsId('Array'), 'isArray'), [$x]),
         tsBinary(tsAccess($x, 'length'), '>', tsNumLit('0')),
         tsBoolLit(true)
      )
   );
   assertHelper($cond, tsStrLit('assertNotEmpty failed'));
}

// assertInstanceOf(value, type) — without runtime classifier metadata we can't
// fully verify, so we conservatively pass (matches our instanceOfCoder).
function meta::external::language::typescript::translation::assertInstanceOfCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assertHelper(tsBoolLit(true), tsStrLit('assertInstanceOf passed (best-effort)'));
}

// chunk(coll, n) -> [coll.slice(0,n), coll.slice(n,2n), ...]. Use runtime helper.
function meta::external::language::typescript::translation::chunkCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__chunk'), $args->map(a | $a->translateExpression($conv)));
}

// orElse(scalar, default) -> scalar ?? default
function meta::external::language::typescript::translation::orElseCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'orElseCoder expects 2 args');
   tsNullishCoalesce(translateExpression($args->at(0), $conv), translateExpression($args->at(1), $conv));
}

// zip(a, b) -> a.map((x,i) => [x, b[i]]).slice(0, Math.min(a.length, b.length))
function meta::external::language::typescript::translation::zipCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'zipCoder expects 2 args');
   tsCall(tsId('__zip'), $args->map(a | $a->translateExpression($conv)));
}

// tryEval(thunk) — Pure native returns `TryResult<V|m>` with `value` and
// `failure: Error[0..1]` slots. Wrap the runtime helper which builds the
// shape so the adapter's liftToPdo can rebuild a TryResult PDO.
function meta::external::language::typescript::translation::tryEvalCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 1, | 'tryEvalCoder expects 1+ args');
   tsCall(tsId('__tryEval'), [translateExpression($args->at(0), $conv)]);
}

// match(value, [arm1, arm2, ...], with?) — each arm is a typed-param lambda
// (single param for the 2-arg form; (value, with) for the 3-arg form). We
// inspect each arm's first parameter at translation time to extract the
// type name + multiplicity bounds, and emit a runtime-dispatched table:
//   __match(value, [{ check: (v) => __matchType(v, "String", 1, 1), run: arm1 }, ...], withOrUndefined)
function meta::external::language::typescript::translation::matchCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 2, | 'matchCoder expects at least 2 args (value, arms)');
   let value = translateExpression($args->at(0), $conv);
   let armsValue = $args->at(1);
   // Arms can come as a Collection literal or a single arm (the lambdas
   // collection might be a VariableExpression bound to a list).
   let armSpecs = if ($armsValue->instanceOf(meta::pure::metamodel::valuespecification::Collection),
      | $armsValue->cast(@meta::pure::metamodel::valuespecification::Collection).values,
      | [$armsValue]);
   let armObjs = $armSpecs->map(arm | $arm->matchArmEntry($conv));
   let withArg = if ($args->size() >= 3,
      | translateExpression($args->at(2), $conv),
      | tsId('undefined'));
   tsCall(tsId('__match'), [$value, tsArrayLit($armObjs), $withArg]);
}

// Build the { check, run } object for one match arm. Arms typically appear
// wrapped as `AtomicValue{value: LambdaFunction}`; bare LambdaFunctions can
// also appear in expression position so we tolerate both.
//
// Arms can have either 1 param (the matched value) or 2 params (the matched
// value + a `with` arg, for `match(var, fns, with)`). The first param's type
// always drives dispatch; the rest are forwarded by the runtime.
function meta::external::language::typescript::translation::matchArmEntry(arm: ValueSpecification[1], conv: Convention[1]): Expression[1]
{
   let lam = $arm->extractMatchArmLambda();
   assert($lam.parameters->size() >= 1, | 'match arm needs at least one parameter');
   let param = $lam.parameters->at(0);
   let paramType = $param.genericType->rawType();
   // Emit the FULL classifier path (not just the last segment). `__matchType`
   // switches on the trailing segment for primitives and delegates to
   // `__pureHost.instanceOf` for user classes — the host needs the full
   // path to look up the class, so we pass both pieces in one string.
   let typePath = if ($paramType->isEmpty(),
                       | 'meta::pure::metamodel::type::Any',
                       | $paramType->toOne()->cast(@meta::pure::metamodel::PackageableElement)->elementToPath());
   let mult = $param.multiplicity;
   // Multiplicity bounds live on ConcreteMultiplicity (a subtype of
   // Multiplicity). PackageableMultiplicities (PureOne, ZeroMany, …) also
   // extend ConcreteMultiplicity, so the cast holds for every multiplicity
   // we expect to see in a typed lambda parameter.
   let concMult = $mult->cast(@meta::pure::metamodel::multiplicity::ConcreteMultiplicity);
   let lower = $concMult.lowerBound.value->toOne()->toString();
   let upperExpr = if ($concMult.upperBound->isEmpty(),
                       | tsId('undefined'),
                       | tsNumLit($concMult.upperBound->toOne().value->toOne()->toString()));
   let armArrow = $arm->translateExpression($conv);
   let check = tsArrowExpr(
      [tsParamNoType('__v')],
      tsCall(tsId('__matchType'),
             [tsId('__v'), tsStrLit($typePath), tsNumLit($lower), $upperExpr])
   );
   tsObject([tsEntry('check', $check), tsEntry('run', $armArrow)]);
}

// pathToElement(p:String[1][, sep:String[1]]) -> the resolved element.
// Emit a class-ref shape `{name, path}`; the toPureValue resolver detects
// this shape (any JS object with a `.path` string that resolves via
// `getElement(path)`) and returns the canonical Pure-side element. That
// makes `assertIs(Boolean, pathToElement('...::Boolean'))` identity-stable.
// The 2-arg form passes a separator that's not `::` — `__pathToElement`
// normalizes by re-joining on `::` so the resolver lookup succeeds.
function meta::external::language::typescript::translation::pathToElementCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let argExprs = $args->map(a | $a->translateExpression($conv));
   tsCall(tsId('__pathToElement'), $argExprs);
}

// elementToPath(e:PackageableElement[1]) -> the element's path. Without
// metadata, we treat the input as the path (works for class-name AtomicValues
// emitted by genericType()/type() chains).
function meta::external::language::typescript::translation::elementToPathCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

// value4Tag(taggedValueElement, tagName) -> empty string. Tag introspection
// isn't translated; return '' so consumers don't crash on `.value`.
function meta::external::language::typescript::translation::value4TagCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsStrLit('');
}

// list(values...) -> `{ values: [...args] }` matches Pure's List wrapper. Some
// tests build a List from a sequence and access `.values` afterward, so
// emitting a JS object with a `values` array keeps that read working.
function meta::external::language::typescript::translation::listCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let elems = $args->map(a | $a->translateExpression($conv));
   tsObject([tsEntry('values', tsArrayLit($elems))]);
}

// Map ops: model Pure's Map<K, V> as a JS object whose keys are stringified.
// newMap accepts either a single Pair, a sequence of Pairs, or empty —
// delegate to the runtime helper so all three shapes work without
// translator-side guesswork.
function meta::external::language::typescript::translation::newMapCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__newMap'), $args->map(a | $a->translateExpression($conv)));
}

// put(map, key, value) -> { ...map, [key]: value }
function meta::external::language::typescript::translation::putCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__mapPut'), $args->map(a | $a->translateExpression($conv)));
}

function meta::external::language::typescript::translation::putAllCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__mapPutAll'), $args->map(a | $a->translateExpression($conv)));
}

function meta::external::language::typescript::translation::removeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__mapRemove'), $args->map(a | $a->translateExpression($conv)));
}

function meta::external::language::typescript::translation::keysCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsAccess(tsId('Object'), 'keys'), [translateExpression($args->at(0), $conv)]);
}

function meta::external::language::typescript::translation::valuesCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsAccess(tsId('Object'), 'values'), [translateExpression($args->at(0), $conv)]);
}

function meta::external::language::typescript::translation::getCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // get(map, key) -> map[key]; emit as element access via __mapGet helper to
   // return [] for missing keys (matches Pure's [0..1] semantics).
   tsCall(tsId('__mapGet'), $args->map(a | $a->translateExpression($conv)));
}

// groupBy(coll, keyFn) -> Pure-side groupBy returns Map<K, List<V>>. Emit a
// runtime helper that builds the JS map.
function meta::external::language::typescript::translation::groupByCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__groupBy'), $args->map(a | $a->translateExpression($conv)));
}

// parseDate(s) -> Date.parse(s) returning the ISO string. JS Date parsing
// approximates Pure's grammar for the simple cases the PCT tests use.
function meta::external::language::typescript::translation::parseDateCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__parseDate'), [translateExpression($args->at(0), $conv)]);
}

// newClass — reflective class creation. Stubbed pass-through since JS has no
// equivalent of a Pure Class object; tests that depend on this will still
// fail downstream when they try to instantiate, but at least the call resolves.
function meta::external::language::typescript::translation::newClassCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsObject([tsEntry('name', translateExpression($args->at(0), $conv))]);
}

// pair(first, second) -> `{ first, second }` matches Pure's Pair shape. Used
// inside multi-if's [pair(|cond, |val), ...] form and elsewhere.
function meta::external::language::typescript::translation::pairCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'pairCoder expects exactly 2 args');
   tsObject([
      tsEntry('first',  translateExpression($args->at(0), $conv)),
      tsEntry('second', translateExpression($args->at(1), $conv))
   ]);
}

// Date arithmetic — delegate to runtime helpers. The translator can't
// reproduce Pure's date semantics exactly but most PCT tests use simple
// add-days/diff-days shapes.
function meta::external::language::typescript::translation::adjustCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__adjust'), $args->map(a | $a->translateExpression($conv)));
}

function meta::external::language::typescript::translation::dateDiffCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__dateDiff'), $args->map(a | $a->translateExpression($conv)));
}

function meta::external::language::typescript::translation::datePartCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__datePart'), $args->map(a | $a->translateExpression($conv)));
}

// evaluate(lambda, params:List<Any>[*]) — invoke the lambda with the params'
// `.values` (each param is a List wrapper). Runtime helper does the unwrap.
function meta::external::language::typescript::translation::evaluateCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'evaluateCoder expects 2 args (lambda, paramsList)');
   tsCall(tsId('__evaluate'), $args->map(a | $a->translateExpression($conv)));
}

// Trig + math coders — Math.X wrappers.
function meta::external::language::typescript::translation::sinCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'sin', $conv); }
function meta::external::language::typescript::translation::cosCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'cos', $conv); }
function meta::external::language::typescript::translation::tanCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'tan', $conv); }
function meta::external::language::typescript::translation::asinCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'asin', $conv); }
function meta::external::language::typescript::translation::acosCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'acos', $conv); }
function meta::external::language::typescript::translation::atanCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'atan', $conv); }
function meta::external::language::typescript::translation::atan2Coder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'atan2', $conv); }
function meta::external::language::typescript::translation::sinhCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'sinh', $conv); }
function meta::external::language::typescript::translation::coshCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'cosh', $conv); }
function meta::external::language::typescript::translation::tanhCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'tanh', $conv); }
function meta::external::language::typescript::translation::expCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'exp', $conv); }
function meta::external::language::typescript::translation::logCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'log', $conv); }
function meta::external::language::typescript::translation::log10Coder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'log10', $conv); }
function meta::external::language::typescript::translation::cbrtCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { mathCall($args, 'cbrt', $conv); }

// cot = 1 / tan.
function meta::external::language::typescript::translation::cotCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsBinary(tsNumLit('1'), '/', mathCall($args, 'tan', $conv));
}

// Numeric conversions — JS conflates Integer/Float, so toFloat/toDecimal/
// toInteger are mostly identity (toInteger truncates).
function meta::external::language::typescript::translation::toFloatCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('Number'), [translateExpression($args->at(0), $conv)]);
}
function meta::external::language::typescript::translation::toDecimalCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('Number'), [translateExpression($args->at(0), $conv)]);
}
function meta::external::language::typescript::translation::toIntegerCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsAccess(tsId('Math'), 'trunc'), [translateExpression($args->at(0), $conv)]);
}

// ----------------------------------------------------------------------------
// Date getters — strip the `%` tag and read the corresponding JS Date field.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::dateGetterCall(args: ValueSpecification[*], helper: String[1], conv: Convention[1]): Expression[1]
{
   tsCall(tsId($helper), [translateExpression($args->at(0), $conv)]);
}

function meta::external::language::typescript::translation::yearCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]        { dateGetterCall($args, '__year', $conv); }
function meta::external::language::typescript::translation::monthNumberCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { dateGetterCall($args, '__monthNumber', $conv); }
function meta::external::language::typescript::translation::dayOfMonthCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]  { dateGetterCall($args, '__dayOfMonth', $conv); }
function meta::external::language::typescript::translation::hourCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]        { dateGetterCall($args, '__hour', $conv); }
function meta::external::language::typescript::translation::minuteCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]      { dateGetterCall($args, '__minute', $conv); }
function meta::external::language::typescript::translation::secondCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]      { dateGetterCall($args, '__second', $conv); }
function meta::external::language::typescript::translation::millisCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]      { dateGetterCall($args, '__millis', $conv); }

