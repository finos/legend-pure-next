// ----------------------------------------------------------------------------
// String trim + reverse coders.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::ltrimCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'trimStart', $conv);
}

function meta::external::language::typescript::translation::rtrimCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   methodCall($args, 'trimEnd', $conv);
}

// reverseString(s) -> Array.from(s).reverse().join('') — handles multi-byte
// characters more reliably than `s.split('').reverse().join('')`.
function meta::external::language::typescript::translation::reverseStringCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__reverseString'), [translateExpression($args->at(0), $conv)]);
}

// ----------------------------------------------------------------------------
// Misc easy coders.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::signCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   mathCall($args, 'sign', $conv);
}

// parseBoolean(s) -> JSON-style truthy parse.
function meta::external::language::typescript::translation::parseBooleanCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__parseBoolean'), [translateExpression($args->at(0), $conv)]);
}

// removeDuplicatesBy(coll, eqOrKey) — same runtime helper as removeDuplicates
// with a function arg.
function meta::external::language::typescript::translation::removeDuplicatesByCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__removeDuplicatesBy'), $args->map(a | $a->translateExpression($conv)));
}

// fail(msg) — throws. Emit a runtime helper so we can express the throw
// statement (the TS metamodel has no ThrowStatement primitive).
function meta::external::language::typescript::translation::failCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let msg = if ($args->size() >= 1,
      | translateExpression($args->at(0), $conv),
      | tsStrLit('fail() called'));
   tsCall(tsId('__fail'), [$msg]);
}

// assertEqWithinTolerance(expected, actual, tol[, msg[, formatArgs]]) —
// |expected - actual| <= tol. Pure has 3/4/5-arg overloads; we accept any
// shape with arg[3] (msg) and arg[4] (formatArgs) optional.
function meta::external::language::typescript::translation::assertEqWithinToleranceCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() >= 3, | 'assertEqWithinToleranceCoder expects at least 3 args');
   let expected = translateExpression($args->at(0), $conv);
   let actual   = translateExpression($args->at(1), $conv);
   let tol      = translateExpression($args->at(2), $conv);
   let cond = tsBinary(
      tsCall(tsAccess(tsId('Math'), 'abs'), [tsBinary($expected, '-', $actual)]),
      '<=',
      $tol
   );
   assertHelper($cond, tsStrLit('assertEqWithinTolerance failed'));
}

// toOneMany(coll) -> identity in JS (Pure asserts the coll has >= 1 element).
function meta::external::language::typescript::translation::toOneManyCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

// castAsTM(x, multHolder) / castViaSeq(x) -> identity (cast is a no-op in JS).
function meta::external::language::typescript::translation::castAsTMCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

function meta::external::language::typescript::translation::castViaSeqCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

// letFunction(name, value) in *expression* position — when a let appears
// inside a thunk body (e.g. `if(true, |let b = 'true', |'false')`) it's
// translated via translateExpression rather than translateStatement.
// Emit an IIFE that binds the name and returns the value so downstream
// code sees the same result Pure would (let-as-last-statement returns
// its bound value).
function meta::external::language::typescript::translation::letFunctionCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   assert($args->size() == 2, | 'letFunctionCoder expects 2 args (name, value)');
   let name = safeJsName($args->at(0)->cast(@AtomicValue).value->cast(@String));
   let value = translateExpression($args->at(1), $conv);
   // ((__v) => __v)(value) — preserves evaluation order and returns the value.
   tsCall(tsArrowExpr([tsParamNoType($name)], tsId($name)), [$value]);
}

// isToOne(x) — Pure invariant assertion that x is single-valued; stub `true`.
function meta::external::language::typescript::translation::isToOneCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsBoolLit(true);
}

// enumValues(enumeration) — runtime reflection that JS can't reproduce
// without a registry; return [] as a safe stub.
function meta::external::language::typescript::translation::enumValuesCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsArrayLit([]);
}

// properties(class) — same as enumValues; return [].
function meta::external::language::typescript::translation::propertiesStubCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsArrayLit([]);
}

