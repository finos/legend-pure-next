{
   tsCall(tsAccess(tsId('Date'), 'now'), []);
}

// random() -> Math.random()
function meta::external::language::typescript::translation::randomCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsAccess(tsId('Math'), 'random'), []);
}

// replaceAll(s, from, to) -> s.replaceAll(from, to). Pure's `replace` already
// has "replace-all" semantics; `replaceAll` is the same.
function meta::external::language::typescript::translation::replaceAllCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__replace'), $args->map(a | $a->translateExpression($conv)));
}

// removeAll(map, keys) -> { ...map } minus listed keys.
function meta::external::language::typescript::translation::removeAllCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__mapRemoveAll'), $args->map(a | $a->translateExpression($conv)));
}

// keyValues(map) -> Pair entries [{first: k, second: v}, ...]
function meta::external::language::typescript::translation::keyValuesCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__mapKeyValues'), [translateExpression($args->at(0), $conv)]);
}

// getIfAbsentPutWithKey(map, key, keyFn) — Pure semantics: if key absent in
// map, insert keyFn(key); return value at key.
function meta::external::language::typescript::translation::getIfAbsentPutWithKeyCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsCall(tsId('__mapGetIfAbsentPut'), $args->map(a | $a->translateExpression($conv)));
}

// getMapStats(map) -> stats object stub.
function meta::external::language::typescript::translation::getMapStatsCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsObject([
      tsEntry('size', tsAccess(tsCall(tsAccess(tsId('Object'), 'keys'),
                                       [translateExpression($args->at(0), $conv)]), 'length'))
   ]);
}

// keyExpression(name, value, optional add) -> {name, expression: value, add?}.
// Most usages are inside `new`/`copy` calls where my newCoder/copyCoder
// already unwrap; this coder is the fallback for any standalone usage.
function meta::external::language::typescript::translation::keyExpressionCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let nameExpr  = translateExpression($args->at(0), $conv);
   let valueExpr = translateExpression($args->at(1), $conv);
   tsObject([tsEntry('name', $nameExpr), tsEntry('expression', $valueExpr)]);
}

// genericTypeHolder(x) — Pure reflection stub: returns the value itself so
// downstream `new($holder, [])` paths can use the source value as their
// type anchor.
function meta::external::language::typescript::translation::genericTypeHolderCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

// parse(src) — runtime reflection over Pure source; emit a stub object.
function meta::external::language::typescript::translation::parseCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsObject([]);
}

// readFile(path) -> '' (no FS access in JS sandbox).
function meta::external::language::typescript::translation::readFileCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsStrLit('');
}

// directoryTree(path) -> [] (no FS access in JS sandbox).
function meta::external::language::typescript::translation::directoryTreeCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsArrayLit([]);
}

// newEnumeration(name, values) — runtime reflection stub; emit an object with
// the name + values so downstream `.values` reads return something sensible.
function meta::external::language::typescript::translation::newEnumerationCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   let nameExpr = if ($args->size() >= 1,
      | translateExpression($args->at(0), $conv),
      | tsStrLit(''));
   let valuesExpr = if ($args->size() >= 2,
      | translateExpression($args->at(1), $conv),
      | tsArrayLit([]));
   tsObject([tsEntry('name', $nameExpr), tsEntry('values', $valuesExpr)]);
}

// identityCoder — generic pass-through for metadata helpers
// (useNodeAsScalar, useAsScalar, tagAs, castAsHint) where the JS runtime
// has no semantic counterpart.
function meta::external::language::typescript::translation::identityCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   translateExpression($args->at(0), $conv);
}

// openVariableValues(lambda) — returns an empty Map placeholder. JS arrow
// functions don't carry the captured-variable metadata that Pure relies on,
// so the introspection result is necessarily approximate; we emit `{}` so
// downstream `.keys()`/`.get()` calls don't crash.
function meta::external::language::typescript::translation::openVariableValuesCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   tsObject([]);
}

function meta::external::language::typescript::translation::extractMatchArmLambda(
   arm: ValueSpecification[1]
): meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[1]
{
   $arm->match([
      lf: meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[1] | $lf,
      {av: AtomicValue[1] |
         $av.value->toOne()
            ->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>);
      },
      other: ValueSpecification[1] | fail('extractMatchArmLambda: unsupported arm shape'); $other->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>);
   ]);
}

function meta::external::language::typescript::translation::assertSameElementsCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]
{
   // assertSameElements(expected, actual) — order-insensitive equality on the
   // serialized sorted contents. Approximation: JSON.stringify on sorted copies.
   let expected = translateExpression($args->at(0), $conv);
   let actual   = translateExpression($args->at(1), $conv);
   let cond = tsBinary(
      tsCall(tsAccess(tsId('JSON'), 'stringify'),
             [tsCall(tsAccess(tsArrayLit([tsSpread($expected)]), 'sort'), [])]),
      '===',
      tsCall(tsAccess(tsId('JSON'), 'stringify'),
             [tsCall(tsAccess(tsArrayLit([tsSpread($actual)]), 'sort'), [])])
   );
   assertHelper($cond, tsStrLit('assertSameElements failed'));
}

function meta::external::language::typescript::translation::translateAtomicValue(a: AtomicValue[1], conv: Convention[1]): Expression[1]
{
   // Date-typed AtomicValues hold a normalized ISO string. Emit `new Date(iso)`
   // so the runtime gets a real Date object (instanceof Date works,
   // .getFullYear() etc. resolve naturally). Strip any leading `%`
   // (Pure-internal source tag) before handing to the JS Date constructor.
   let rawType = $a.genericType->rawType();
   let path = if ($rawType->isEmpty(), | '', | $rawType->toOne()->elementToPath());
   let isDate = $path == 'meta::pure::metamodel::type::primitives::Date'
                || $path == 'meta::pure::metamodel::type::primitives::StrictDate'
                || $path == 'meta::pure::metamodel::type::primitives::DateTime'
                || $path == 'meta::pure::metamodel::type::primitives::StrictTime';
   if ($isDate && $a.value->toOne()->instanceOf(String),
      | let raw = $a.value->toOne()->cast(@String);
        let iso = if ($raw->startsWith('%'), | $raw->substring(1), | $raw);
        ^meta::external::language::typescript::metamodel::NewExpression(
            expression    = tsId('Date'),
            arguments     = tsStrLit($iso),
            typeArguments = []->cast(@meta::external::language::typescript::metamodel::TypeNode)
        );,
      | $a.value->translatePureValueToTs($conv)
   );
}

// Translate a runtime Pure value into a TS Expression. Scalars become literals
// (tsNumLit/tsBoolLit/tsStrLit); a LambdaFunction PDO (or RawClosure with
// LambdaFunction classifierGenericType, as Truffle produces) becomes a TS
// arrow; other PDOs become object literals built reflectively.
function meta::external::language::typescript::translation::translatePureValueToTs(v: Any[1], conv: Convention[1]): Expression[1]
{
   // Dispatch lambdas via classifier rather than runtime instanceOf — the
   // Truffle backend represents capturing closures as `RawClosure`, which
   // isn't a subtype of LambdaFunction, so a `lam:LambdaFunction` match arm
   // would silently fall through to the object-literal arm and emit `{}`.
   let cls = $v->genericType().type;
   let isLambda = $cls->isNotEmpty() && $cls->toOne() == meta::pure::metamodel::function::LambdaFunction;
   // Function reference (`rem_Number_1__Number_1__Number_1_`) — the value
   // is a Pure native or user function, not a lambda. Wrap it in an arrow
   // that delegates to our coder for the short name so `funcRef->eval(...)`
   // works. Without this, classInstanceToObjectLiteral would emit `{}` and
   // `(funcRef)(...args)` would crash with "{} is not a function".
   //
   // Detect via runtime instanceOf — `$v->instanceOf(Function)` is true for
   // any subtype (PackageableFunction → NativeFunction / ConcreteFunctionDefinition).
   let isFunctionRef = !$isLambda
                       && $v->instanceOf(meta::pure::metamodel::function::Function);
   if ($isLambda,
      | let lam = $v->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>);
        let lamParams = $lam.parameters->map(p | tsParamNoType(safeJsName($p.name)));
        let arrow = if ($lam.expressionSequence->size() == 1,
                        | tsArrowExpr($lamParams, translateExpression($lam.expressionSequence->toOne(), $conv)),
                        | tsArrowBlock($lamParams, $lam.expressionSequence->buildTsFunctionBody($conv)));
        wrapLambdaWithAst($arrow, $lam, $conv);,
   |if ($isFunctionRef,
      | $v->cast(@meta::pure::metamodel::function::Function<Any>)->functionRefToArrow($conv);,
      | $v->match([
           // Pure distinguishes Integer / Float / Decimal — keep the arms
           // separate so each can grow its own handling. All three emit as
           // a TS numeric literal (JS has a single Number type). Decimals
           // beyond Number.MAX_SAFE_INTEGER lose precision (known JS
           // limitation) but representing them as a number is what lets JS
           // arithmetic operate on the value.
           i:   Integer[1] | tsNumLit($i->toString()),
           f:   Float[1]   | tsNumLit($f->toString()),
           d:   Decimal[1] | tsNumLit($d->toString()),
           b:   Boolean[1] | tsBoolLit($b),
           s:   String[1]  | tsStrLit($s),
           // Class-instance PDO -> TS object literal. Walk the class's direct
           // `properties` slot (not the recursive `properties()` native, which
           // would walk up to Any.properties and recurse into metamodel slots).
           x:   Any[1]     | $x->classInstanceToObjectLiteral()
        ])
   ));
}

// Build an arrow expression wrapping a Pure native/user function reference.
// Extracts the function's name (e.g. `rem_Number_1__Number_1__Number_1_`),
// strips the type-signature suffix to get the short name (`rem`), looks up
// the coder for that short name, and emits:
//   (a0, a1) => <coder body using __a0, __a1 as fake VariableExpressions>
// If we don't have a coder for the function, fall back to a stub arrow.
function meta::external::language::typescript::translation::functionRefToArrow(
   f: meta::pure::metamodel::function::Function<meta::pure::metamodel::type::Any>[1],
   conv: Convention[1]
): Expression[1]
{
   // Some Function subtypes (Property<T,V>, etc.) carry a non-FunctionType
   // typeArguments[0] — guard the cast so we degrade to a stub arrow
   // rather than crash translation.
   let rawTypeArg = $f.classifierGenericType.typeArguments
                       ->at(0)->rawType();
   if ($rawTypeArg->isEmpty() || !$rawTypeArg->toOne()->instanceOf(meta::pure::metamodel::type::FunctionType),
       | // Unknown function shape — emit a no-arg arrow returning undefined.
         tsArrowExpr([], tsId('undefined')),
       | $f->functionRefToArrowFromFT($rawTypeArg->toOne()->cast(@meta::pure::metamodel::type::FunctionType), $conv)
   );
}

function meta::external::language::typescript::translation::functionRefToArrowFromFT(
   f: meta::pure::metamodel::function::Function<meta::pure::metamodel::type::Any>[1],
   funcType: meta::pure::metamodel::type::FunctionType[1],
   conv: Convention[1]
): Expression[1]
{
   let arity = $funcType.parameters->size();
   let argNames = range(0, $arity)->map(i | '__a' + $i->toString());
   // Build synthetic VariableExpressions for the coder to consume.
   let fakeArgs = $argNames->map(n |
      ^meta::pure::metamodel::valuespecification::VariableExpression(
         name = $n,
         genericType = ^meta::pure::metamodel::type::generics::CompilerNotSetGenericType(),
         multiplicity = meta::pure::metamodel::multiplicity::PureOne
      )
   );
   // Resolve coder by short name (strip `_TypeSig` suffix).
   let funcName = if ($f->instanceOf(meta::pure::metamodel::PackageableElement),
      | $f->cast(@meta::pure::metamodel::PackageableElement)->elementToPath()->split('::')->last()->toOne(),
      | 'unknown');
   let shortName = $funcName->split('_')->at(0);
   let coder = $conv.functionCoders->get($shortName);
   let body = if ($coder->isEmpty(),
                  | tsId('undefined'),
                  | $coder->toOne()->eval($fakeArgs->cast(@ValueSpecification), $conv));
   tsArrowExpr($argNames->map(n | tsParamNoType($n)), $body);
}

function meta::external::language::typescript::translation::classInstanceToObjectLiteral(v: Any[1]): Expression[1]
{
   // Direct `Class.properties` slot, NOT the recursive `properties()` native:
   // the latter walks up to Any.properties which includes metamodel slots
   // (classifierGenericType, ...) whose values are themselves PDOs and
   // recurse into this function -> stack overflow. Direct slot = only the
   // user-declared fields, which is what we need for an object literal.
   //
   // Three classifier shapes get bespoke handling:
   //   - Class<Any>: walk `$cls.properties` and emit one entry per property.
   //   - Enumeration: an enum VALUE — emit `{ name: <enum-value-name> }`
   //     so downstream code can dispatch on the name (e.g. regex flag mapping).
   //   - PrimitiveType: best-effort String() coercion (Date, Decimal, …).
   let rawType = $v->genericType().type->toOne();
   // Case 1: `v` IS an Enumeration class itself (e.g. `LA_GeographicEntityType`).
   // Emit as a `__ptr` like any other PE — `EnumPath.VALUE` access in JS
   // routes through the proxy's `get` trap → `__pureHost.get(path, name)`
   // → host enum-value lookup → canonical Enum PDO. Avoids inlining the
   // entire enum values-map in the source on every reference.
   if ($v->instanceOf(meta::pure::metamodel::type::Enumeration),
      | encodePeRef($v),
   // Case 2: `v` is an enum VALUE (e.g. `LA_GeographicEntityType.CITY`).
   // Resolve to `__ptr(enumPath).valueName` so the runtime fetches the
   // canonical enum value via the resolver — same identity as if the value
   // had been accessed directly in source. Two references to the same enum
   // value end up `=== ` because the host hands back the canonical PDO.
   |if ($rawType->instanceOf(meta::pure::metamodel::type::Enumeration),
      | let enumValue = $v->cast(@meta::pure::metamodel::type::Enum);
        let enumPath = $rawType->cast(@meta::pure::metamodel::PackageableElement)->elementToPath();
        tsAccess(tsCall(tsId('__pureResolve'), [tsStrLit($enumPath)]),
                 $enumValue.name->toOne());,
   // Case 3: `v` is a regular Class object itself (e.g. `LA_Person` or
   // metamodel class like `PrimitiveType`). Emit as a `__ptr` so property
   // reads like `LA_Person.properties` lazily dereference via the resolver
   // rather than instantiating the whole class in JS.
   |if ($v->instanceOf(meta::pure::metamodel::type::Class),
      | encodePeRef($v),
   // Case 4: `v` is a PrimitiveType class (e.g. `Boolean`, `Date`, `String`).
   // PrimitiveType is itself a Class metamodel element but its instances
   // (Boolean, Integer, ...) are NOT instanceOf Class — they're instanceOf
   // PrimitiveType. Same pointer treatment as Case 3.
   |if ($v->instanceOf(meta::pure::metamodel::type::PrimitiveType),
      | encodePeRef($v),
   // Case 5: `v` is a primitive VALUE (not a Class). Date/StrictDate/etc.
   // become `new Date(iso)` so the runtime sees real JS Date instances.
   |if (!$rawType->instanceOf(meta::pure::metamodel::type::Class),
      | let path = $rawType->cast(@meta::pure::metamodel::PackageableElement)->elementToPath();
        let isDate = $path == 'meta::pure::metamodel::type::primitives::Date'
                     || $path == 'meta::pure::metamodel::type::primitives::StrictDate'
                     || $path == 'meta::pure::metamodel::type::primitives::DateTime'
                     || $path == 'meta::pure::metamodel::type::primitives::StrictTime';
        let s = $v->toString();
        if ($isDate,
           | let iso = if ($s->startsWith('%'), | $s->substring(1), | $s);
             ^meta::external::language::typescript::metamodel::NewExpression(
                 expression    = tsId('Date'),
                 arguments     = tsStrLit($iso),
                 typeArguments = []->cast(@meta::external::language::typescript::metamodel::TypeNode)
             );,
           | tsStrLit($s));,
   // Case 6: `v` is a named PackageableElement (Multiplicity, GenericType
   // anchor, ...) with a non-empty package. Emit a class-ref shape `{name,
   // path}` so the Java-side toPureValue resolver maps it to the canonical
   // Pure PE. Makes `assertIs(InferredPureOne,
   // $lam.expressionSequence->at(0).multiplicity)` pass — both sides
   // reference the same canonical PDO.
   |if ($v->instanceOf(meta::pure::metamodel::PackageableElement)
        && $v->cast(@meta::pure::metamodel::PackageableElement).package->isNotEmpty(),
      | encodePeRef($v),
   // Case 7 (default): user-class instance — walk the class's properties.
      | let cls = $rawType->cast(@Class<Any>);
        let conv = defaultConvention();
        let entries = $cls.properties->map(p |
           let propName  = $p.name->toOne();
           let propValue = $p->eval($v);
           tsEntry($propName, $propValue->translatePureValuesToTs($conv));
        );
        tsObject($entries);
   ))))));
}

// Multi-valued sibling of translatePureValueToTs: handles property values
// that may be `[*]`, `[0..1]`, or `[1]`. Empty becomes `undefined`; single
// values unwrap to the scalar TS expression; sequences become an array
// literal of element translations.
function meta::external::language::typescript::translation::translatePureValuesToTs(vs: Any[*], conv: Convention[1]): Expression[1]
{
   if ($vs->isEmpty(),
      | tsId('undefined'),
      | if ($vs->size() == 1,
            | $vs->toOne()->translatePureValueToTs($conv),
            | tsArrayLit($vs->map(v | $v->translatePureValueToTs($conv)))));
}

// ----------------------------------------------------------------------------
// Top-level entry: translate a Pure function or lambda into a TS SourceFile
// containing a single exported `execute(...)` function. The runtime adapter
// hands the serialized source to `compileAndExecute` and asks for `execute`.
// ----------------------------------------------------------------------------

function meta::external::language::typescript::translation::translateFunction(
   f: meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>[1],
   conv: Convention[1]
): SourceFile[1]
{
   let returnType = pureTypeToTypeScriptType($f.returnGenericType, $f.returnMultiplicity);
   buildSourceFile($f, $returnType, $conv);
}

// Unified entry — dispatches on the runtime kind of the FunctionDefinition
// so the adapter can hand off whatever shape makeCanonical produced (the
// canonical form is a UserDefinedFunction for capturing-lambda inputs and
// a passthrough LambdaFunction for non-capturing inputs).
function meta::external::language::typescript::translation::translateFunctionDef(
   f: meta::pure::metamodel::function::FunctionDefinition<meta::pure::metamodel::type::Any>[1],
   conv: Convention[1]
): SourceFile[1]
{
   $f->match([
      lf:  LambdaFunction<Any>[1]      | $lf->translateLambda($conv),
      udf: UserDefinedFunction<Any>[1] | $udf->translateFunction($conv)
   ]);
}

// Lambda's return type lives on the classifier (LambdaFunction<{params -> ret}>)
// rather than on dedicated slots — extract it from typeArguments[0].
function meta::external::language::typescript::translation::translateLambda(
   f: meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[1],
   conv: Convention[1]
): SourceFile[1]
{
   let funcType   = $f.classifierGenericType.typeArguments->at(0)->rawType()->toOne('translateLambda: lambda missing classifier function type')->cast(@meta::pure::metamodel::type::FunctionType);
   let returnType = pureTypeToTypeScriptType($funcType.returnType, $funcType.returnMultiplicity);
   buildSourceFile($f, $returnType, $conv);
}

// Shared back-end: take a FunctionDefinition + a TS return type, emit a
// SourceFile holding a single `export function execute(...)` plus a top-
// level `function` declaration for every UserDefinedFunction the body
// transitively calls. UDFs let PCT tests delegate to helpers defined in
// the same Pure file (`letAsLastStatement`, `singletonSeq`, ...); without
// emitting those, the runtime call would crash with `undefined is not a
// function`.
function meta::external::language::typescript::translation::buildSourceFile(
   f: meta::pure::metamodel::function::FunctionDefinition<meta::pure::metamodel::type::Any>[1],
   returnType: TypeNode[1],
   conv: Convention[1]
): SourceFile[1]
{
   let tsParams = $f.parameters->map(p |
      tsParam(safeJsName($p.name), pureTypeToTypeScriptType($p.genericType, $p.multiplicity))
   );

   let body = $f.expressionSequence->buildTsFunctionBody($conv);

   let fn = ^FunctionDeclaration(
      name           = 'execute',
      modifiers      = [ModifierFlag.Export],
      typeParameters = [],
      parameters     = $tsParams,
      returnType     = $returnType,
      body           = $body
   );

   // Collect every UserDefinedFunction transitively referenced from the
   // body, translate each to a top-level TS function declaration, and
   // prepend them so the `execute` function can call them by name.
   let udfs = $f.expressionSequence->collectReferencedUdfs(
      []->cast(@meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>));
   let udfDecls = $udfs->map(u | $u->translateUdf($conv));

   tsSourceFile('translated.ts', $udfDecls->concatenate($fn));
}

// Walk an expression tree collecting every UserDefinedFunction reached via
// FunctionExpression.func, recursing into each UDF's body. `seen` carries
// the transitive closure to break cycles (a recursive UDF would otherwise
// loop forever).
function meta::external::language::typescript::translation::collectReferencedUdfs(
   exprs: ValueSpecification[*],
   seen: meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>[*]
): meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>[*]
{
   $exprs->fold({e, acc | $e->collectReferencedUdfsOne($acc)}, $seen);
}

function meta::external::language::typescript::translation::collectReferencedUdfsOne(
   vs: ValueSpecification[1],
   seen: meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>[*]
): meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>[*]
{
   $vs->match([
      {fe: FunctionExpression[1] |
         // Recurse into the args first, then check if this FE calls a UDF.
         let acc1 = $fe.parametersValues->collectReferencedUdfs($seen);
         if ($fe.func->isNotEmpty()
              && $fe.func->toOne()->instanceOf(meta::pure::metamodel::function::UserDefinedFunction),
             | let udf = $fe.func->toOne()->cast(@meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>);
               if ($acc1->contains($udf),
                   | $acc1,
                   | $udf.expressionSequence->collectReferencedUdfs($acc1->concatenate($udf)));,
             | $acc1
         );
      },
      {av: AtomicValue[1] |
         // AtomicValues sometimes wrap LambdaFunctions whose body we need to
         // walk (e.g. match arms). Other values have no UDF refs of interest.
         if ($av.value->isNotEmpty()
             && $av.value->toOne()->instanceOf(meta::pure::metamodel::function::LambdaFunction),
             | $av.value->toOne()
                ->cast(@meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>)
                .expressionSequence
                ->collectReferencedUdfs($seen),
             | $seen
         );
      },
      {lf: meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[1] |
         $lf.expressionSequence->collectReferencedUdfs($seen);
      },
      {col: meta::pure::metamodel::valuespecification::Collection[1] |
         $col.values->collectReferencedUdfs($seen);
      },
      other: ValueSpecification[1] | $seen
   ]);
}

// Translate one UDF to a top-level `function name(...): T { ... }` TS decl.
// The function is not exported — it lives alongside `execute` and is called
// internally.
function meta::external::language::typescript::translation::translateUdf(
   udf: meta::pure::metamodel::function::UserDefinedFunction<meta::pure::metamodel::type::Any>[1],
   conv: Convention[1]
): FunctionDeclaration[1]
{
   let shortName = safeJsName($udf.functionName->toOne()->split('::')->last()->toOne());
   let tsParams = $udf.parameters->map(p |
      tsParam(safeJsName($p.name), pureTypeToTypeScriptType($p.genericType, $p.multiplicity))
   );
   let returnType = pureTypeToTypeScriptType($udf.returnGenericType, $udf.returnMultiplicity);
   let body = $udf.expressionSequence->buildTsFunctionBody($conv);
   ^FunctionDeclaration(
      name           = $shortName,
      modifiers      = [],
      typeParameters = [],
      parameters     = $tsParams,
      returnType     = $returnType,
      body           = $body
   );
}

// Render a Pure expressionSequence as a TS Block. All but the last statement
// is emitted as a statement (a `letFunction(name, value)` becomes
// `const name = value;`; anything else becomes an `ExpressionStatement`).
// The last statement is wrapped in `return`. Mirrors Pure's "last expression
// is the value" semantics.
function meta::external::language::typescript::translation::buildTsFunctionBody(
   exprs: ValueSpecification[*],
   conv: Convention[1]
): Block[1]
{
   assert($exprs->size() >= 1, | 'buildTsFunctionBody: empty expressionSequence');
   let lastIdx = $exprs->size() - 1;
   let last    = $exprs->at($lastIdx);
   let stmts = range(0, $lastIdx)->map(i | $exprs->at($i)->translateStatement($conv));
   // If the last expression is `letFunction(name, value)`, Pure's "let-as-last"
   // semantics is that the let's value becomes the function's return. Emit
   // `const name = value; return name;`. Match-dispatch via if to keep the
   // sequence-of-statements return shape straightforward.
   let isLetLast = $last->instanceOf(FunctionExpression)
                     && $last->cast(@FunctionExpression).functionName == 'letFunction'
                     && $last->cast(@FunctionExpression).parametersValues->size() == 2;
   let tail = if ($isLetLast,
      | let fe   = $last->cast(@FunctionExpression);
        let name = safeJsName($fe.parametersValues->at(0)->cast(@AtomicValue).value->cast(@String));
        let cst  = tsConst($name, [], translateExpression($fe.parametersValues->at(1), $conv));
        [$cst->cast(@Statement), tsReturn(tsId($name))->cast(@Statement)];,
      | [tsReturn(translateExpression($last, $conv))->cast(@Statement)]
   );
   tsBlock($stmts->concatenate($tail));
}

// Translate a non-last expression-sequence element to a TS Statement.
// `letFunction(name, value)` -> `const name = value;`.
// Everything else -> an ExpressionStatement (preserves side-effecting calls
// in source order).
function meta::external::language::typescript::translation::translateStatement(
   vs: ValueSpecification[1],
   conv: Convention[1]
): Statement[1]
{
   $vs->match([
      {fe: FunctionExpression[1] |
         // `letFunction(name, value)` -> `const name = value;`. The variable
         // name is an AtomicValue holding the String — pull it inline.
         if ($fe.functionName == 'letFunction' && $fe.parametersValues->size() == 2,
             | tsConst(
                  safeJsName($fe.parametersValues->at(0)->cast(@AtomicValue).value->cast(@String)),
                  [],
                  translateExpression($fe.parametersValues->at(1), $conv)
               ),
             | tsExprStmt(translateExpression($vs, $conv))
         );
      },
      other: ValueSpecification[1] | tsExprStmt(translateExpression($other, $conv))
   ]);
}
