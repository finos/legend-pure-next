import meta::external::language::typescript::factories::*;
import meta::external::language::typescript::metamodel::*;
import meta::external::language::typescript::translation::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::valuespecification::*;

// Minimal Pure -> TypeScript translator. Function-call dispatch goes through
// a Convention's `functionCoders` map. Adding a new Pure native to the
// surface is a one-line entry in `defaultConvention()` plus a small coder.
// Callers that want different behavior pass their own Convention to the
// public entry points (translateFunction / translateLambda).

// ----------------------------------------------------------------------------
// Convention — single-slot config holding the coder dispatch table. The
// coder signature carries `Convention[1]` so coders can recurse via
// translateExpression with the SAME convention.
// ----------------------------------------------------------------------------

Class meta::external::language::typescript::translation::Convention
{
   functionCoders : Map<String, meta::pure::metamodel::function::Function<{ValueSpecification[*], Convention[1] -> Expression[1]}>>[1];
   // Lambdas in traversal order. Translator pre-walks the canonical FD to
   // build this list; each lambda's index in the list IS the `idx`
   // appended to the synthetic address emitted in
   // `__lambda(arrow, '<rootPath>$lambda/<idx>')`. Java-side walker mirrors
   // the same traversal to resolve `lambda/<idx>` back to a LambdaFunction
   // PDO. Default-empty so call sites that don't need it (gallery
   // sub-translations, etc.) keep working — the emitter just skips wrapping
   // if the list is empty.
   lambdaIndex : meta::pure::metamodel::function::LambdaFunction<meta::pure::metamodel::type::Any>[*];
   // Canonical path of the containing PE — used as the prefix for inline
   // lambda addresses. Empty when no root is set (sub-translations,
   // gallery, etc.); wrapLambdaWithAst falls back to a bare arrow then.
   rootPath : String[0..1];
}

function meta::external::language::typescript::translation::defaultConvention(): Convention[1]
{
   ^Convention(
      functionCoders = newMap([
         // arithmetic
         pair('plus',        plusCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('minus',       minusCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('times',       timesCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('divide',      divideCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('rem',         remCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         // comparison
         pair('equal',       equalCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('lessThan',    lessThanCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('greaterThan', greaterThanCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         // boolean
         pair('and',         andCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('or',          orCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('not',         notCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         // collection — iteration + slicing
         pair('filter',      filterCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('map',         mapCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('fold',        foldCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('take',        takeCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('drop',        dropCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         // collection — predicates
         pair('isEmpty',     isEmptyCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('toOne',       toOneCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         // string / length
         pair('length',      lengthCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('toString',    toStringCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         // lambda invocation
         pair('eval',        evalCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         // construction
         pair('new',         newCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         // collection — indexing + accessors
         pair('at',                atCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('size',              sizeCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
         pair('head',              headCoder_ValueSpecification_MANY__Convention_1__Expression_1_),
