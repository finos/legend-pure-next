function meta::external::language::typescript::translation::dateGetterCall(args: ValueSpecification[*], helper: String[1], conv: Convention[1]): Expression[1]
{
   tsCall(tsId($helper), [translateExpression($args->at(0), $conv)]);
}

function meta::external::language::typescript::translation::yearCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]        { dateGetterCall($args, '__year', $conv); }
function meta::external::language::typescript::translation::monthNumberCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1] { dateGetterCall($args, '__monthNumber', $conv); }
function meta::external::language::typescript::translation::dayOfMonthCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]  { dateGetterCall($args, '__dayOfMonth', $conv); }
function meta::external::language::typescript::translation::hourCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]        { dateGetterCall($args, '__hour', $conv); }
function meta::external::language::typescript::translation::minuteCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]      { dateGetterCall($args, '__minute', $conv); }
function meta::external::language::typescript::translation::secondCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]      { dateGetterCall($args, '__second', $conv); }
function meta::external::language::typescript::translation::millisCoder(args: ValueSpecification[*], conv: Convention[1]): Expression[1]      { dateGetterCall($args, '__millis', $conv); }

