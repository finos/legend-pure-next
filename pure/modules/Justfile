# pure/modules/Justfile — orchestrates the Pure module Justfiles
# (language/{java,javascript}, translation/{shared,java,javascript,truffle}).
#
# Direct invocation:    just <recipe>            (from pure/modules/)
# Via the root Justfile: just modules::<recipe>  (from repo root)
#
# Per-submodule recipes are addressable as `just <submodule>::<recipe>` from
# here, e.g. `just translation_java::gallery`. Use `just --list <submodule>`
# to see what each submodule offers.
#
# Build order honours the PDB-producer dependency chain:
#   language/{java,javascript} + translation/shared  →  translation/{java,javascript,truffle}

set quiet := true
set shell := ["bash", "-c"]

mod language_java          "language/java/Justfile"
mod language_javascript    "language/javascript/Justfile"
mod translation_shared     "translation/shared/Justfile"
mod translation_java       "translation/java/Justfile"
mod translation_javascript "translation/javascript/Justfile"
mod translation_truffle    "translation/truffle/Justfile"

header := "h(){ s=\"[modules::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"

# Layer 0 — language metamodels + shared translation utilities. Depend only on
# bootstrap PDBs (core.pdb / compiler.pdb), so they can build in any order
# among themselves.
#
# Layer 1 — translator modules. Each consumes Layer 0 outputs:
#   translation_java       needs language_java::java.pdb + translation_shared::translation-shared.pdb
#   translation_javascript needs language_javascript::javascript.pdb + translation_shared::translation-shared.pdb
#   translation_truffle    needs translation_shared::translation-shared.pdb
#
# Order is enforced by listing Layer 0 recipes first; `just` runs prereqs
# sequentially in declaration order.

# Default: build all module PDBs.
default: build

# Build Layer 0 PDBs (language metamodels + translation_shared).
# language_javascript and translation_shared build WITH --tests split: the
# javascript platform's _emit loads their pdbs, and a lean pdb produced by a
# split build carries refs into its -tests companion — loading one without
# the other yields [PTR-FAIL] pointer resolutions. Splitting here keeps
# shared/ consistent regardless of whether `build` or `test-all` ran last.
build-layer0: language_java::build language_javascript::build-tests translation_shared::build-tests

# Build every module PDB (Layer 0 → Layer 1).
# translation_javascript builds WITH --tests split: the javascript platform's
# generate recipes run translatePackageToJs, which is <<test.TestDependency>>
# and therefore lives in javascript-translation-TESTS.pdb.
build: build-layer0 translation_java::build translation_javascript::build-tests translation_truffle::build

# Orchestrator's `build` already covers all sub-module deps — alias of `build` for symmetry with sub-Justfiles' `build-all`.
build-all: build

# Run Layer 0 `test-all` suites. translation_shared::test-all produces translation-shared.pdb (via build-tests), which Layer 1 test-alls then consume.
test-all-layer0: language_java::test-all language_javascript::test-all translation_shared::test-all

# Run every module's `test-all` (Layer 0 → Layer 1). NB: translation/truffle has no `test-all` — its surface is `gallery`.
test-all: test-all-layer0 translation_java::test-all translation_javascript::test-all

# Render every translator gallery (java + javascript + truffle). Assumes Layer 0 PDBs are built (gallery recipes call their own `build-tests`).
gallery: translation_java::gallery translation_javascript::gallery translation_truffle::gallery

# Remove every module's PDB outputs.
clean: language_java::clean language_javascript::clean translation_shared::clean translation_java::clean translation_javascript::clean translation_truffle::clean
