// ----------------------------------------------------------------------------
// Function stubs — legend-pure platform helpers not present in legend-pure-next.
//
// Implementations are deliberately minimal: enough to typecheck the
// java-generation source, with semantics that match the original where they
// can be expressed in terms of legend-pure-next primitives. Native-only
// behaviours (evaluateAndDeactivate, generateJava) are stubbed pass-through.
//
// When the corresponding functions land in legend-pure-next's standard
// library (or are inlined into call sites), delete this file.
// ----------------------------------------------------------------------------

import meta::pure::functions::asserts::*;
import meta::pure::functions::collection::*;
import meta::pure::functions::lang::*;
import meta::pure::functions::string::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::valuespecification::*;

Profile meta::pure::profiles::access
{
   stereotypes: [public, protected, private, externalizable];
}

// fail — legend-pure had this as an always-throw assert.
function meta::pure::functions::lang::fail(message:String[1]): Boolean[1]
{
    assert(false, $message);
}

function meta::pure::functions::lang::fail(): Boolean[1]
{
    fail('fail');
}

// `in` — element-of-collection membership.
function meta::pure::functions::collection::in<T>(value:T[1], collection:T[*]): Boolean[1]
{
    !$collection->filter(v | $v == $value)->isEmpty();
}

// isFalse / isTrue on Boolean[0..1]. Both mean "definitely X" — empty/unset
// returns false on BOTH (the value is neither definitely true nor definitely
// false). The previous isFalse impl returned true for empty, which made
// `nullResultPossible->isFalse()` in stream codegen treat "unknown nullness"
// as "definitely not null" and skip the null-filter step.
function meta::pure::functions::boolean::isFalse(b:Boolean[0..1]): Boolean[1]
{
    !$b->isEmpty() && !$b->toOne();
}

function meta::pure::functions::boolean::isTrue(b:Boolean[0..1]): Boolean[1]
{
    !$b->isEmpty() && $b->toOne();
}

// orElse — default value if empty for [0..1] collections.
function meta::pure::functions::collection::orElse<T>(value:T[0..1], default:T[1]): T[1]
{
    if($value->isEmpty(), | $default, | $value->toOne());
}

// sortBy — sort by a String key (only String keys are needed by the
// java-generation source).
function meta::pure::functions::collection::sortBy<T>(collection:T[*], key:Function<{T[1]->String[1]}>[1]): T[*]
{
    $collection->fold(
        {item:T[1], acc:T[*] |
            let itemKey = $key->eval($item);
            let lt      = $acc->filter(a | $key->eval($a) <= $itemKey);
            let ge      = $acc->filter(a | $key->eval($a) > $itemKey);
            $lt->concatenate($item)->concatenate($ge);
        },
        []->cast(@T)
    );
}

// sum — Integer sum.
function meta::pure::functions::math::sum(values:Integer[*]): Integer[1]
{
    $values->fold({v:Integer[1], acc:Integer[1] | $acc + $v}, 0);
}

// joinStrings/1 — single-arg form.
function meta::pure::functions::string::joinStrings(strings:String[*]): String[1]
{
    $strings->joinStrings('');
}

// String helpers.
function meta::pure::functions::string::lastIndexOf(s:String[1], sub:String[1]): Integer[1]
{
    let parts = $s->split($sub);
    if($parts->size() <= 1,
        | -1,
        | $s->length() - $parts->at($parts->size() - 1)->length() - $sub->length()
    );
}

function meta::pure::functions::string::toUpperFirstCharacter(s:String[1]): String[0..1]
{
    if($s == '',
        | $s,
        | $s->substring(0, 1)->toUpper() + $s->substring(1)
    );
}

// id — best-effort identifier for an arbitrary value. The java-generation
// source uses this for dispatch keys, so a stable string per element suffices.
// Handles two common cases:
//   - PackageableElement (Class, Function, Enumeration, ...) → its `name`
//   - Enum value (Modifier.Public, ...) → its `name`
// Returns '' for anything else.
function meta::pure::functions::lang::id(a:Any[1]): String[1]
{
    if($a->instanceOf(meta::pure::metamodel::PackageableElement),
        | $a->cast(@meta::pure::metamodel::PackageableElement).name->orElse(''),
        | if($a->instanceOf(meta::pure::metamodel::type::Enum),
              | $a->cast(@meta::pure::metamodel::type::Enum).name,
              | ''
          )
    );
}

// Multiplicity bounds — only ConcreteMultiplicity carries an upper bound.
function meta::pure::functions::multiplicity::hasUpperBound(m:Multiplicity[1]): Boolean[1]
{
    $m->match([
        cm : ConcreteMultiplicity[1] | $cm.upperBound.value->isNotEmpty(),
        a  : Any[1]                  | false
    ]);
}

function meta::pure::functions::multiplicity::getUpperBound(m:Multiplicity[1]): Integer[1]
{
    $m->match([
        cm : ConcreteMultiplicity[1] | $cm.upperBound.value->orElse(-1),
        a  : Any[1]                  | -1
    ]);
}

// evaluateAndDeactivate — legend-pure native that snapshotted a collection of
// values held inside a value-specification. In legend-pure-next there is no
// deactivation step; pass-through is correct here (the inputs are already
// concrete values plucked from `parametersValues`).
function meta::pure::functions::meta::evaluateAndDeactivate<T|m>(values:T[m]): T[m]
{
    $values;
}

// enumValues — return the values of an enumeration as Enum instances.
//
// legend-pure-next stores enum values on `Enumeration.properties[*]` as
// Property objects (one per value); each Property's `defaultValue` is a
// LambdaFunction whose first expression is an AtomicValue holding the actual
// Enum instance. This mirrors the bootstrap newEnumeration native (see
// MetaNatives.java line 820+): the registry only holds the Enumeration; the
// Enum values live inside its properties' default-value lambdas.
//
// Callers commonly want either `.name` filtering or `cast(@<EnumType>)` to a
// concrete enum literal — both work on the Enum instances returned here.
function meta::pure::functions::meta::enumValues<E>(enumeration:Enumeration<E>[1]): meta::pure::metamodel::type::Enum[*]
{
    $enumeration.properties->map(p |
        $p.defaultValue->toOne().expressionSequence->at(0)->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->toOne()->cast(@meta::pure::metamodel::type::Enum)
    );
}

// ----------------------------------------------------------------------------
// Property-access shims for old-metamodel patterns.
//
// Legend-pure exposed `genericType.rawType` (Type[0..1]) directly. Legend-
// pure-next only puts `type` on GenericTypeValue. Use ->genericTypeRawType()
// at call sites instead of `.rawType`.
// ----------------------------------------------------------------------------

function meta::pure::metamodel::type::generics::genericTypeRawType(gt:GenericType[1]): Type[0..1]
{
    $gt->match([
        gtv : GenericTypeValue[1] | $gtv.type,
        a   : Any[1]              | []
    ]);
}

// ----------------------------------------------------------------------------
// Additional missing collection / string helpers used by metamodel_factories.pure
// and metamodel_serialization.pure.
// ----------------------------------------------------------------------------

// chunk — split a String into pieces of <= chunkSize characters each.
function meta::pure::functions::string::chunk(s:String[1], chunkSize:Integer[1]): String[*]
{
    chunkRec($s, $chunkSize, []);
}

function <<access.private>> meta::pure::functions::string::chunkRec(s:String[1], chunkSize:Integer[1], acc:String[*]): String[*]
{
    if($s->length() <= $chunkSize,
        | $acc->concatenate($s),
        | chunkRec($s->substring($chunkSize), $chunkSize, $acc->concatenate($s->substring(0, $chunkSize)))
    );
}

// makeString — collection->string with a separator (legend-pure idiom).
function meta::pure::functions::string::makeString(strings:String[*], separator:String[1]): String[1]
{
    $strings->joinStrings($separator);
}

// makeString/4 — with prefix/separator/suffix.
function meta::pure::functions::string::makeString(strings:String[*], prefix:String[1], separator:String[1], suffix:String[1]): String[1]
{
    $strings->joinStrings($prefix, $separator, $suffix);
}

// min — pairwise integer minimum.
function meta::pure::functions::math::min(a:Integer[1], b:Integer[1]): Integer[1]
{
    if($a < $b, | $a, | $b);
}

// intersection — set intersection. Used to detect duplicate-name collisions.
function meta::pure::functions::collection::intersection<T>(a:T[*], b:T[*]): T[*]
{
    $a->filter(x | $x->in($b));
}

// plus on String[*] — legend-pure's variadic concat. Equivalent to joinStrings('').
function meta::pure::functions::string::plus(strings:String[*]): String[1]
{
    $strings->joinStrings('');
}

// value4Tag — fetch the value of a TaggedValue by tag name on a PackageableElement.
// Argument order matches legend-pure: element (receiver), tag-name, profile.
function meta::pure::functions::meta::value4Tag(element:meta::pure::metamodel::extension::AnnotatedElement[1], tag:String[1], profile:meta::pure::metamodel::extension::Profile[1]): meta::pure::metamodel::extension::TaggedValue[0..1]
{
    $element.taggedValues->filter(tv | $tv.tag.profile == $profile && $tv.tag.value == $tag)->head();
}
