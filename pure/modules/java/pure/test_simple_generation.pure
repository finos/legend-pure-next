// ----------------------------------------------------------------------------
// Simple end-to-end smoke test for the Java metamodel + factories +
// serialization pipeline. Builds a Java class by hand from a Pure class
// definition and asserts on the rendered Java source.
//
// Goal: prove that the legend-pure-next/pure/language/java module produces
// usable Java text for a basic class shape, without depending on the full
// transform/conventions layer (which is currently quarantined).
// ----------------------------------------------------------------------------

import meta::external::language::java::factory::*;
import meta::external::language::java::metamodel::*;
import meta::external::language::java::serialization::*;
import meta::external::language::java::test::*;

// ----------------------------------------------------------------------------
// Sample Pure class — the input.
// ----------------------------------------------------------------------------

Class meta::external::language::java::test::TestPerson
{
   firstName : String[1];
   lastName  : String[1];
   age       : Integer[1];
}

// ----------------------------------------------------------------------------
// Hand-rolled Pure-class -> Java-class transformer. Maps:
//   - class name      -> Java simpleName (in the configured package)
//   - String[1] field -> private String fieldName;
//   - Integer[1] field -> private long fieldName;
//
// This is intentionally tiny: it doesn't honour multiplicities, qualified
// properties, generics, or any conventions library — just enough to exercise
// the metamodel/factories/serialization round-trip end to end.
// ----------------------------------------------------------------------------

function meta::external::language::java::test::pureClassToJava(
    pureClass:meta::pure::metamodel::type::Class<meta::pure::metamodel::type::Any>[1],
    javaPkg:String[1]
): meta::external::language::java::metamodel::Class[1]
{
   let javaFields = $pureClass.properties
      ->map(p:meta::pure::metamodel::function::property::Property<meta::pure::metamodel::type::Nil, meta::pure::metamodel::type::Any|*>[1] |
         pureFieldToJava($p)
      );

   let javaCls = javaClass(['public'], $javaPkg + '.' + $pureClass.name->toOne());
   $javaFields->fold({f, c | $c->addField($f)}, $javaCls);
}

function meta::external::language::java::test::pureFieldToJava(
    property:meta::pure::metamodel::function::property::Property<meta::pure::metamodel::type::Nil, meta::pure::metamodel::type::Any|*>[1]
): meta::external::language::java::metamodel::Field[1]
{
   let propName  = $property.name->toOne();
   let rawType   = $property.genericType->genericTypeRawType()->toOne();
   let javaType  = pureRawTypeToJavaType($rawType);
   javaField(['private'], $javaType, $propName);
}

function meta::external::language::java::test::pureRawTypeToJavaType(
    type:meta::pure::metamodel::type::Type[1]
): meta::external::language::java::metamodel::Type[1]
{
   if($type == String,    | javaString(),
   | if($type == Integer,   | javaLong(),
   | if($type == Boolean,   | javaBoolean(),
   | if($type == Float,     | javaDouble(),
                            | javaObject()
   ))));
}

// ----------------------------------------------------------------------------
// Test entry points.
// ----------------------------------------------------------------------------

function <<test.Test>> meta::external::language::java::test::testTransformAndSerialize():Boolean[1]
{
   let pureCls = meta::external::language::java::test::TestPerson;
   let javaCls = pureClassToJava($pureCls, 'com.example.generated');

   assertEquals('TestPerson',           $javaCls.simpleName);
   assertEquals('com.example.generated', $javaCls.package->packageToString());
   assertEquals(3, $javaCls.fields->size());
   assertEquals(['firstName', 'lastName', 'age'], $javaCls.fields.name);

   let rendered = $javaCls->classToString();
   println($rendered);

   assert($rendered->contains('public class TestPerson'),  | 'rendered should declare public class TestPerson, got:\n' + $rendered);
   assert($rendered->contains('private String firstName'), | 'rendered should declare firstName field, got:\n' + $rendered);
   assert($rendered->contains('private String lastName'),  | 'rendered should declare lastName field, got:\n' + $rendered);
   assert($rendered->contains('private long age'),         | 'rendered should declare age field as long, got:\n' + $rendered);

   true;
}
