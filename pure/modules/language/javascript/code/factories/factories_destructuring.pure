// Destructuring factories.
//
//   const { a, b } = obj;
//   const { source: alias } = obj;
//   const { x = 0 } = obj;
//   const { head, ...rest } = obj;
//   const [a, b] = arr;
//   const [head, ...tail] = arr;
//   const { user: { name } } = obj;        // nested
//   function f({ a, b }: T) { ... }
//
// The element factories (jsBindName / jsBindRename / jsBindDefault /
// jsBindRest / jsBindNested) build one BindingElement at a time. Compose
// them inside jsObjectBinding(...) or jsArrayBinding(...) and pass the
// pattern to jsLet / jsConst / jsParam (BindingName-typed overloads).

import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;

// =============================================================================
// Binding elements — one position inside a pattern.
// =============================================================================

// `{ a }` or `[a]` — leaf binding to an identifier name.
function meta::external::language::javascript::factories::jsBindName(name: String[1]): BindingElement[1]
{
   ^BindingElement(name=jsId($name));
}

// `{ source: alias }` — destructure `source` from the object, bind to `alias`.
function meta::external::language::javascript::factories::jsBindRename(propertyName: String[1], localName: String[1]): BindingElement[1]
{
   ^BindingElement(propertyName=$propertyName, name=jsId($localName));
}

// `{ x = default }` — bind `x` with a fallback value when undefined.
function meta::external::language::javascript::factories::jsBindDefault(name: String[1], default: Expression[1]): BindingElement[1]
{
   ^BindingElement(name=jsId($name), initializer=$default);
}

// `{ ...rest }` or `[...tail]` — rest binding (must be last in pattern).
function meta::external::language::javascript::factories::jsBindRest(name: String[1]): BindingElement[1]
{
   ^BindingElement(name=jsId($name), isRest=true);
}

// `{ user: { name } }` — nest a pattern inside another. `propertyName` is the
// source-side property (here 'user'); `pattern` is the nested BindingPattern.
function meta::external::language::javascript::factories::jsBindNested(propertyName: String[1], pattern: BindingName[1]): BindingElement[1]
{
   ^BindingElement(propertyName=$propertyName, name=$pattern);
}

// =============================================================================
// Binding patterns.
// =============================================================================

function meta::external::language::javascript::factories::jsObjectBinding(elements: BindingElement[*]): ObjectBindingPattern[1]
{
   ^ObjectBindingPattern(elements=$elements);
}

function meta::external::language::javascript::factories::jsArrayBinding(elements: BindingElement[*]): ArrayBindingPattern[1]
{
   ^ArrayBindingPattern(elements=$elements);
}

// =============================================================================
// Overloads of jsLet / jsConst / jsParam that take a BindingName directly.
//
// The existing String-name forms remain (they wrap with jsId internally).
// These overloads are what destructuring callers reach for.
// =============================================================================

function meta::external::language::javascript::factories::jsLet(name: BindingName[1], init: Expression[0..1]): VariableStatement[1]
{
   ^VariableStatement(
      modifiers=[],
      declarationKind=VariableDeclarationKind.Let,
      declarations=[^VariableDeclaration(name=$name, initializer=$init)]
   );
}

function meta::external::language::javascript::factories::jsConst(name: BindingName[1], init: Expression[0..1]): VariableStatement[1]
{
   ^VariableStatement(
      modifiers=[],
      declarationKind=VariableDeclarationKind.Const,
      declarations=[^VariableDeclaration(name=$name, initializer=$init)]
   );
}

function meta::external::language::javascript::factories::jsParam(name: BindingName[1]): ParameterDeclaration[1]
{
   ^ParameterDeclaration(name=$name);
}
