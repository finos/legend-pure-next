// Factories for control flow: ternary, if-statement, let/const declarations,
// and the small unary operators that commonly compose with them.

import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;

// =============================================================================
// Ternary expression.
//   jsTernary(cond, t, e)  ->  cond ? t : e
// =============================================================================

function meta::external::language::javascript::factories::jsTernary(condition: Expression[1], whenTrue: Expression[1], whenFalse: Expression[1]): ConditionalExpression[1]
{
   ^ConditionalExpression(condition=$condition, whenTrue=$whenTrue, whenFalse=$whenFalse);
}

// =============================================================================
// If statement.
//
// Pass `[]` as elseStmt for the single-branch form.
// `thenStmt` / `elseStmt` are arbitrary Statements: typically a Block, but for
// else-if chains pass another IfStatement as elseStmt.
// =============================================================================

function meta::external::language::javascript::factories::jsIfStmt(condition: Expression[1], thenStmt: Statement[1], elseStmt: Statement[0..1]): IfStatement[1]
{
   ^IfStatement(expression=$condition, thenStatement=$thenStmt, elseStatement=$elseStmt);
}

// =============================================================================
// Variable declarations at statement position.
//   jsLet('x', jsStrLit('hi'))   ->  let x = 'hi';
//   jsConst('n', jsNumLit('42')) ->  const n = 42;
//
// Pass `[]` for `init` to omit the initializer (rarely used with const, but
// legal for let).
// =============================================================================

function meta::external::language::javascript::factories::jsLet(name: String[1], init: Expression[0..1]): VariableStatement[1]
{
   ^VariableStatement(
      modifiers=[],
      declarationKind=VariableDeclarationKind.Let,
      declarations=[^VariableDeclaration(name=jsId($name), initializer=$init)]
   );
}

function meta::external::language::javascript::factories::jsConst(name: String[1], init: Expression[0..1]): VariableStatement[1]
{
   ^VariableStatement(
      modifiers=[],
      declarationKind=VariableDeclarationKind.Const,
      declarations=[^VariableDeclaration(name=jsId($name), initializer=$init)]
   );
}

// =============================================================================
// Unary operators commonly used with conditionals.
// =============================================================================

function meta::external::language::javascript::factories::jsNot(operand: Expression[1]): PrefixUnaryExpression[1]
{
   ^PrefixUnaryExpression(operator='!', operand=$operand);
}

function meta::external::language::javascript::factories::jsNeg(operand: Expression[1]): PrefixUnaryExpression[1]
{
   ^PrefixUnaryExpression(operator='-', operand=$operand);
}

function meta::external::language::javascript::factories::jsTypeof(operand: Expression[1]): PrefixUnaryExpression[1]
{
   ^PrefixUnaryExpression(operator='typeof ', operand=$operand);
}
