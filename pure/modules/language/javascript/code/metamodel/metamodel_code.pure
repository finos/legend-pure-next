// Statements (non-declarations) and Expressions. See metamodel_type.pure for the strategy.

import meta::external::language::javascript::metamodel::*;

// =============================================================================
// Statements (other than Declaration; declarations live in metamodel_structure.pure).
// =============================================================================

Class meta::external::language::javascript::metamodel::Block extends Statement
{
   statements : Statement[*];
}

Class meta::external::language::javascript::metamodel::ReturnStatement extends Statement
{
   expression : Expression[0..1];
}

Class meta::external::language::javascript::metamodel::IfStatement extends Statement
{
   <<equality.Key>> expression : Expression[1];
   thenStatement : Statement[1];
   elseStatement : Statement[0..1];                  // may itself be an IfStatement (else-if chain)
}

Enum meta::external::language::javascript::metamodel::VariableDeclarationKind
{
   Var,
   Let,
   Const
}

// VariableStatement wraps a `let`/`const`/`var` declaration list at the
// statement level. Mirrors ts.VariableStatement which holds a
// VariableDeclarationList.
Class meta::external::language::javascript::metamodel::VariableStatement extends Statement
{
   modifiers       : ModifierFlag[*];                // `export const x = ...`
   declarationKind : VariableDeclarationKind[1];
   declarations    : VariableDeclaration[1..*];
}

// `name` is a BindingName so destructuring is first-class on the LHS:
//   - Identifier:               `let x = …`
//   - ObjectBindingPattern:     `let { a, b } = …`
//   - ArrayBindingPattern:      `let [a, b] = …`
Class meta::external::language::javascript::metamodel::VariableDeclaration extends Node
{
   <<equality.Key>> name : BindingName[1];
   initializer : Expression[0..1];
}

Class meta::external::language::javascript::metamodel::ExpressionStatement extends Statement
{
   <<equality.Key>> expression : Expression[1];
}

// =============================================================================
// Expressions.
// =============================================================================

Class meta::external::language::javascript::metamodel::Expression extends Node
{
}

// Identifier is a node, not a bare string. The TS compiler treats it the same
// way — leaves room for attaching position / inferred type later.
//
// Identifier multi-inherits from Expression AND BindingName, matching the TS
// compiler where `ts.Identifier` plays both roles (used as an expression
// reference, but also as the leaf form of a BindingName in declarations).
//
// `source` (optional) lets a generator mark an identifier as coming from
// another file. Used by resolveImports() to auto-add import declarations for
// expression-position references (function names, constructor refs, etc.).
// Local bindings (variables, parameters) leave it empty.
Class meta::external::language::javascript::metamodel::Identifier extends Expression, BindingName
{
   <<equality.Key>> text : String[1];
   source : meta::external::language::javascript::metamodel::ImportSource[0..1];
   // EXPORTED name from `source` when it differs from `text` (alias case).
   originalName : String[0..1];
}

Class meta::external::language::javascript::metamodel::ThisExpression extends Expression
{
}

Class meta::external::language::javascript::metamodel::SuperExpression extends Expression
{
}

// PropertyAccessExpression — `expression.name` (or `expression?.name`
// when `isOptional` is true).
Class meta::external::language::javascript::metamodel::PropertyAccessExpression extends Expression
{
   <<equality.Key>> expression : Expression[1];
   <<equality.Key>> name       : String[1];
   isOptional : Boolean[0..1];
}

// CallExpression — `expression(args)` (or `expression?.(args)` when
// `isOptional` is true).
Class meta::external::language::javascript::metamodel::CallExpression extends Expression
{
   <<equality.Key>> expression    : Expression[1];   // callee
   arguments     : Expression[*];
   isOptional : Boolean[0..1];
}

Class meta::external::language::javascript::metamodel::NewExpression extends Expression
{
   <<equality.Key>> expression    : Expression[1];   // constructor reference
   arguments     : Expression[*];
}

// BinaryExpression — covers arithmetic, comparison, logical, assignment, and
// nullish-coalescing operators. `operatorToken` carries the operator text as
// it appears in source (e.g. '+', '===', '&&', '??', '=', '+='). This
// matches the TS compiler's design of using SyntaxKind rather than a typed
// enum at the metamodel level.
Class meta::external::language::javascript::metamodel::BinaryExpression extends Expression
{
   <<equality.Key>> left          : Expression[1];
   <<equality.Key>> operatorToken : String[1];
   <<equality.Key>> right         : Expression[1];
}

// ConditionalExpression — TS ternary: `cond ? whenTrue : whenFalse`.
// Mirrors ts.ConditionalExpression { condition, whenTrue, whenFalse }.
Class meta::external::language::javascript::metamodel::ConditionalExpression extends Expression
{
   <<equality.Key>> condition : Expression[1];
   <<equality.Key>> whenTrue  : Expression[1];
   <<equality.Key>> whenFalse : Expression[1];
}

Class meta::external::language::javascript::metamodel::PrefixUnaryExpression extends Expression
{
   <<equality.Key>> operator : String[1];            // '!', '-', '+', '~', '++', '--', 'typeof', 'void', 'delete'
   <<equality.Key>> operand  : Expression[1];
}

Class meta::external::language::javascript::metamodel::PostfixUnaryExpression extends Expression
{
   <<equality.Key>> operand  : Expression[1];
   <<equality.Key>> operator : String[1];            // '++', '--'
}

// ArrowFunction
//   (p: T) => Expr
//   (p: T): R => { body; }
//
// TS distinguishes concise-body (Expression) from block-body (Block). We
// keep them on separate slots so the serializer can emit the correct form
// without inspecting body shape. Exactly one must be set.
Class meta::external::language::javascript::metamodel::ArrowFunction extends Expression
[
   ($this.body->isEmpty() && $this.expressionBody->isNotEmpty()) ||
   ($this.body->isNotEmpty() && $this.expressionBody->isEmpty())
]
{
   parameters     : ParameterDeclaration[*];
   body           : Block[0..1];
   expressionBody : Expression[0..1];
   isAsync        : Boolean[0..1];
}

// ObjectLiteralExpression — `{ a: 1, b: 2, ...rest }`.
// `properties` holds ObjectLiteralElements (PropertyAssignment or
// SpreadAssignment). MethodDeclaration / getters / setters in object
// literals remain deferred.
Class meta::external::language::javascript::metamodel::ObjectLiteralExpression extends Expression
{
   properties : ObjectLiteralElement[*];
}

Class meta::external::language::javascript::metamodel::ObjectLiteralElement extends Node
{
}

Class meta::external::language::javascript::metamodel::PropertyAssignment extends ObjectLiteralElement
{
   <<equality.Key>> name : String[1];                // raw key text; quoted by serializer when needed
   computed : Boolean[0..1];                         // `[expr]: ...` keys deferred to v2
   <<equality.Key>> initializer : Expression[1];
}

// SpreadAssignment — `{ ...source }` inside an object literal.
Class meta::external::language::javascript::metamodel::SpreadAssignment extends ObjectLiteralElement
{
   <<equality.Key>> expression : Expression[1];
}

// ShorthandPropertyAssignment — `{ x }` shorthand for `{ x: x }`. The
// `name` slot is both the property key AND the local identifier in scope.
Class meta::external::language::javascript::metamodel::ShorthandPropertyAssignment extends ObjectLiteralElement
{
   <<equality.Key>> name : String[1];
}

Class meta::external::language::javascript::metamodel::ArrayLiteralExpression extends Expression
{
   elements : Expression[*];
}

// SpreadElement — `...expr` in an array literal or call argument list.
// In TS, SpreadElement extends Expression, allowing it in any
// argument-list position without a special wrapper.
Class meta::external::language::javascript::metamodel::SpreadElement extends Expression
{
   <<equality.Key>> expression : Expression[1];
}

// =============================================================================
// Literals.
// =============================================================================

// `text` stores the literal as it appears in source so the serializer can
// emit it byte-for-byte. Mirrors ts.StringLiteral.text + ts.StringLiteral.rawText.
Class meta::external::language::javascript::metamodel::StringLiteral extends Expression
{
   <<equality.Key>> text : String[1];
}

// `text` because TS allows `1_000_000`, `0x1F`, `0b10`, `1n`, `1.5e3`, etc.
// A typed Number would lose those forms.
Class meta::external::language::javascript::metamodel::NumericLiteral extends Expression
{
   <<equality.Key>> text : String[1];
}

Class meta::external::language::javascript::metamodel::BooleanLiteral extends Expression
{
   <<equality.Key>> value : Boolean[1];
}

Class meta::external::language::javascript::metamodel::NullLiteral extends Expression
{
}

// AwaitExpression — `await expr`. Valid only inside async functions; TS
// enforces this — the metamodel does not.
Class meta::external::language::javascript::metamodel::AwaitExpression extends Expression
{
   <<equality.Key>> expression : Expression[1];
}

// =============================================================================
// Template literals.
//
//   NoSubstitutionTemplateLiteral:  `plain text`
//   TemplateExpression:             `Hello, ${name}!`
//                                    └─head─┘└span┘
//
// TemplateExpression decomposes into a head string + one TemplateSpan per
// `${…}…` slot. Each span carries the substituted expression and the
// literal text that follows it. Mirrors ts.TemplateExpression / ts.TemplateSpan.
// =============================================================================

Class meta::external::language::javascript::metamodel::TemplateLiteral extends Expression
{
}

Class meta::external::language::javascript::metamodel::NoSubstitutionTemplateLiteral extends TemplateLiteral
{
   <<equality.Key>> text : String[1];
}

Class meta::external::language::javascript::metamodel::TemplateExpression extends TemplateLiteral
{
   <<equality.Key>> head  : String[1];
   <<equality.Key>> spans : TemplateSpan[1..*];
}

Class meta::external::language::javascript::metamodel::TemplateSpan extends Node
{
   <<equality.Key>> expression : Expression[1];
   <<equality.Key>> literal    : String[1];
}
