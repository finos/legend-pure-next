// Smoke demo: build a tiny JS source file with a class containing one method,
// serialize it, return the rendered text. Useful for manual round-tripping
// through `node`.

import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;
import meta::external::language::javascript::serialization::*;

function meta::external::language::javascript::demo::greeterSource(): String[1]
{
   let method = jsMethod(
      'greet',
      [jsParam('name')],
      jsBlock([
         jsReturn(jsBinary(jsStrLit('Hello, '), '+', jsId('name')))
      ])
   );
   let cls = jsExportedClass('Greeter', [$method]);
   let sf  = jsSourceFile('greeter.js', [$cls]);
   $sf->serialize();
}
