import meta::external::language::javascript::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::multiplicity::*;

// ----------------------------------------------------------------------------
// JavaScript execution natives, implemented by the HOST. The standalone JS
// platform provides them in platforms/javascript/src/execution/js-natives.js
// (eval pipe + function lookup + a drain buffer); runtime-lib routes there via
// __jsCompile / __jsExecute / __jsDrainCompiledSources. There is no JVM-side
// implementation: the GraalJS Truffle extension that used to back these was
// removed once Node covered the same ground. Three natives, split by phase:
//
//   compile(source)                                           → ctx
//   execute(ctx, fnName, args, pureReturnType, pureMultiplicity) → Any[*]
//
// `compile` evaluates the (plain JavaScript) source as a CommonJS module in a
// long-lived host JS context — the translator emits type-free JS, so there is
// no transpile step. The returned `ctx` is opaque — a JVM-side handle wrapping
// the evaluated module's `exports`. Pass it from `compile` straight into
// `execute` without inspecting.
//
// `execute` looks up `fnName` on the captured module's exports and invokes
// it with `args` (passed positionally). Scalars map across the JS↔Pure
// boundary directly (Long, Double, Boolean, String); null/undefined becomes
// the empty Pure sequence. The return is `Any[*]` so callers in generic
// contexts (e.g. PCT adapters typed `<X|o>(...):X[o]`) can return this
// value directly — Pure widens `Any[*]` to the caller's `X[o]` at the call
// site.
//
// `pureReturnType` / `pureMultiplicity` (both optional) tell the native how
// to map the JS return value back into Pure shape: a Class-typed return
// gets its JS objects lifted into PDOs of that class; multiplicity guides
// the empty/single/many sequence wrapping. Omit both for hand-written JS
// where the JS already returns scalars (no Pure-shape coercion needed).
//
// Metadata access (lambda PDOs, type lookups, etc.) is embedded in the
// emitted JavaScript by the translator — calls to a globally-scoped
// `__pureResolve(path)` helper the host sets up once on its JS
// context. The translator owns the strategy; the native is just an
// eval pipe — the host installs `__pureResolve` separately.
// ----------------------------------------------------------------------------

// Named `compileModule` rather than `compile`: the JavaScript translator's
// coder table dispatches on the LAST ::-segment, so a native called `compile`
// would also capture meta::pure::compiler::compile — and compiler.js is itself
// produced by translating meta::pure::compiler, so every internal call would be
// rewritten into the JS eval pipe.
native function meta::external::language::javascript::compileModule(
   source: String[1]
): Any[1];

// Drains (and clears) the buffer of JS module sources that `compile` has been
// handed since the last drain. The translation gallery calls this right after
// running a test through the PCT adapter, so the displayed JavaScript is the
// EXACT source that was compiled + executed — keeping the gallery 100% in sync
// with the PCT run rather than re-deriving source through a separate path.
native function meta::external::language::javascript::drainCompiledSources(): String[*];

native function meta::external::language::javascript::execute(
   ctx: Any[1],
   fnName: String[1],
   args: Any[*],
   pureReturnType: GenericType[0..1],
   pureMultiplicity: Multiplicity[0..1],
   // Optional in-memory graph injected for reflection lookups during this
   // execute call. The translator generates uniform `__pureResolve(address)`
   // calls; for addresses targeting nodes that don't live in any loaded
   // PDB (e.g., a canonical lambda built in memory by a test adapter),
   // those reads route to this graph instead. Cleaned up after execute
   // returns — same lifetime as the call.
   graph: meta::pure::metamodel::type::Any[0..1]
): Any[*];

// ----------------------------------------------------------------------------
// No tests here. These natives were previously pinned by nine hand-written-JS
// tests (testCompileAndExecute*, testLambdaPdoFilter, testSelfDescribing*),
// which only ran on the GraalJS Truffle extension. That extension is gone, and
// the natives are now exercised far more broadly by the standalone JS platform:
// the PCT adapter (testAdapterForTranslatedJavaScript) drives compileModule +
// execute once per PCT test, and the translation gallery does the same per card
// — 804 of each, covering Integer/Float/String/Boolean returns, lambdas, PDOs
// and collection lifting. Run them with `just javascript::test-execution`.
// ----------------------------------------------------------------------------
