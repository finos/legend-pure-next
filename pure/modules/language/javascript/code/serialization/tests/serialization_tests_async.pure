import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::imports::*;
import meta::external::language::javascript::metamodel::*;
import meta::external::language::javascript::serialization::*;
import meta::external::language::javascript::serialization::tests::*;

// =============================================================================
// await expression
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::awaitSimple(): Boolean[1]
{
   testExpr('await fetch()', jsAwait(jsCall(jsId('fetch'), [])));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::awaitMemberAccess(): Boolean[1]
{
   testExpr('await user.save()',
            jsAwait(jsCall(jsAccess(jsId('user'), 'save'), [])));
}

// =============================================================================
// async function / method / arrow
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::asyncFunctionDeclaration(): Boolean[1]
{
   testStmt('''
            async function load() {
              return await fetchUser();
            }''',
            jsAsyncFunction('load', [],
               jsBlock([jsReturn(jsAwait(jsCall(jsId('fetchUser'), [])))])));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::asyncMethod(): Boolean[1]
{
   testStmt('''
            class Repo {
              async findOne(id) {
                return await this.db.get(id);
              }
            }''',
            jsClass('Repo', [
               jsAsyncMethod('findOne',
                  [jsParam('id')],
                  jsBlock([
                     jsReturn(jsAwait(jsCall(jsAccess(jsAccess(jsThis(), 'db'), 'get'), [jsId('id')])))
                  ]))
            ]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::asyncArrowExpression(): Boolean[1]
{
   testExpr('async (id) => await fetchUser(id)',
            jsAsyncArrowExpr(
               [jsParam('id')],
               jsAwait(jsCall(jsId('fetchUser'), [jsId('id')]))));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::asyncArrowBlock(): Boolean[1]
{
   testExpr('''
            async (id) => {
              return await fetchUser(id);
            }''',
            jsAsyncArrowBlock(
               [jsParam('id')],
               jsBlock([jsReturn(jsAwait(jsCall(jsId('fetchUser'), [jsId('id')])))])));
}

// =============================================================================
// Walker descends through await — imports inside `await ...` get picked up
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::awaitInsideResolvesImports(): Boolean[1]
{
   let apiFile = jsSourceFile('src/api.ts', []);
   let appFile = jsSourceFile('src/app.ts', [
      jsAsyncFunction('main', [],
         jsBlock([
            jsExprStmt(jsAwait(jsCall(jsIdFrom('fetchAll', jsLocalSource($apiFile)), [])))
         ]))
   ]);
   testFile('''
            import { fetchAll } from './api.js';

            async function main() {
              await fetchAll();
            }
            ''',
            $appFile->resolveImports());
}
