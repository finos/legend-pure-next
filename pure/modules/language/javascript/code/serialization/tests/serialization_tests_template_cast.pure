import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;
import meta::external::language::javascript::serialization::*;
import meta::external::language::javascript::serialization::tests::*;

// =============================================================================
// Template literals — no substitution
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::templatePlain(): Boolean[1]
{
   testExpr('`hello`', jsTemplate('hello'));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::templateEmpty(): Boolean[1]
{
   testExpr('``', jsTemplate(''));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::templateMultiline(): Boolean[1]
{
   // Note: real newlines in source preserved verbatim.
   testExpr('`line1\nline2`', jsTemplate('line1\nline2'));
}

// =============================================================================
// Template literals — interpolated
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::templateOneSpan(): Boolean[1]
{
   testExpr('`Hello, ${name}!`',
            jsTemplateExpr('Hello, ', [jsTemplateSpan(jsId('name'), '!')]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::templateMultipleSpans(): Boolean[1]
{
   testExpr('`${greeting}, ${name}! You are ${age}.`',
            jsTemplateExpr('',
               [
                  jsTemplateSpan(jsId('greeting'), ', '),
                  jsTemplateSpan(jsId('name'), '! You are '),
                  jsTemplateSpan(jsId('age'), '.')
               ]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::templateWithExpression(): Boolean[1]
{
   testExpr('`Total: ${price * qty}`',
            jsTemplateExpr('Total: ',
               [jsTemplateSpan(jsBinary(jsId('price'), '*', jsId('qty')), '')]));
}
