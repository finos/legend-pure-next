import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;
import meta::external::language::javascript::serialization::*;
import meta::external::language::javascript::serialization::tests::*;

// =============================================================================
// Optional property access  expr?.name
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::optionalAccessSimple(): Boolean[1]
{
   testExpr('user?.name', jsOptAccess(jsId('user'), 'name'));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::optionalAccessChained(): Boolean[1]
{
   // Mix optional + non-optional in a chain: user?.profile.name
   // First step optional, rest plain — TS short-circuits on the first ?.
   testExpr('user?.profile.name',
            jsAccess(jsOptAccess(jsId('user'), 'profile'), 'name'));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::optionalAccessTwice(): Boolean[1]
{
   // user?.profile?.name
   testExpr('user?.profile?.name',
            jsOptAccess(jsOptAccess(jsId('user'), 'profile'), 'name'));
}

// =============================================================================
// Optional call  fn?.()
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::optionalCallNoArgs(): Boolean[1]
{
   testExpr('callback?.()', jsOptCall(jsId('callback'), []));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::optionalCallWithArgs(): Boolean[1]
{
   testExpr('callback?.(1, 2)',
            jsOptCall(jsId('callback'), [jsNumLit('1'), jsNumLit('2')]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::optionalMethodCall(): Boolean[1]
{
   // user.save?.()  — optional invocation of a property
   testExpr('user.save?.()',
            jsOptCall(jsAccess(jsId('user'), 'save'), []));
}

// =============================================================================
// Nullish coalescing  a ?? b
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::nullishCoalesceSimple(): Boolean[1]
{
   testExpr('x ?? 0', jsNullishCoalesce(jsId('x'), jsNumLit('0')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::nullishCoalesceWithAccess(): Boolean[1]
{
   // user?.name ?? 'anonymous'
   testExpr('user?.name ?? \'anonymous\'',
            jsNullishCoalesce(
               jsOptAccess(jsId('user'), 'name'),
               jsStrLit('anonymous')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::nullishCoalesceInConst(): Boolean[1]
{
   testStmt('const name = user?.name ?? \'anonymous\';',
            jsConst('name',
               jsNullishCoalesce(
                  jsOptAccess(jsId('user'), 'name'),
                  jsStrLit('anonymous'))));
}
