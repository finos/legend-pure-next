import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;
import meta::external::language::javascript::serialization::*;
import meta::external::language::javascript::serialization::tests::*;

function <<test.Test>> meta::external::language::javascript::serialization::tests::emptyObject(): Boolean[1]
{
   testExpr('{}', jsEmptyObject());
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::objectOneEntry(): Boolean[1]
{
   testExpr('{ name: \'Ada\' }', jsObject([jsEntry('name', jsStrLit('Ada'))]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::objectMultipleEntries(): Boolean[1]
{
   testExpr(
      '{ name: \'Ada\', age: 36, active: true }',
      jsObject([
         jsEntry('name', jsStrLit('Ada')),
         jsEntry('age', jsNumLit('36')),
         jsEntry('active', jsBoolLit(true))
      ]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::objectShorthand(): Boolean[1]
{
   testExpr('{ x, y }', jsObject([jsEntryShorthand('x'), jsEntryShorthand('y')]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::nestedObject(): Boolean[1]
{
   testExpr(
      '{ user: { name: \'Ada\' }, role: \'admin\' }',
      jsObject([
         jsEntry('user', jsObject([jsEntry('name', jsStrLit('Ada'))])),
         jsEntry('role', jsStrLit('admin'))
      ]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::objectInsideArrayLit(): Boolean[1]
{
   testExpr(
      '[{ id: 1 }, { id: 2 }]',
      jsArrayLit([
         jsObject([jsEntry('id', jsNumLit('1'))]),
         jsObject([jsEntry('id', jsNumLit('2'))])
      ]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::objectInConstDeclaration(): Boolean[1]
{
   testStmt(
      'const user = { name: \'Ada\', age: 36 };',
      jsConst('user',
         jsObject([
            jsEntry('name', jsStrLit('Ada')),
            jsEntry('age', jsNumLit('36'))
         ])));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::objectAsCallArg(): Boolean[1]
{
   testExpr(
      'configure({ verbose: true, retries: 3 })',
      jsCall(jsId('configure'),
         [jsObject([
            jsEntry('verbose', jsBoolLit(true)),
            jsEntry('retries', jsNumLit('3'))
         ])]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::objectFromMapPipeline(): Boolean[1]
{
   // Object literals in arrow concise body MUST be parenthesized — pinning
   // that the serializer emits `({...})`, not `{...}` (which TS would parse
   // as a block body and reject).
   testExpr(
      'users.map((u) => ({ name: u.name, id: u.id }))',
      jsMap(jsId('users'), 'u',
         jsObject([
            jsEntry('name', jsAccess(jsId('u'), 'name')),
            jsEntry('id', jsAccess(jsId('u'), 'id'))
         ])));
}
