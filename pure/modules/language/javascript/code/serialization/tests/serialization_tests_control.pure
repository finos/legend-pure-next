import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;
import meta::external::language::javascript::serialization::*;
import meta::external::language::javascript::serialization::tests::*;

// =============================================================================
// Ternary
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::ternarySimple(): Boolean[1]
{
   testExpr('x > 0 ? \'pos\' : \'neg\'',
            jsTernary(
               jsBinary(jsId('x'), '>', jsNumLit('0')),
               jsStrLit('pos'),
               jsStrLit('neg')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::ternaryNested(): Boolean[1]
{
   testExpr('x > 0 ? \'pos\' : x < 0 ? \'neg\' : \'zero\'',
            jsTernary(
               jsBinary(jsId('x'), '>', jsNumLit('0')),
               jsStrLit('pos'),
               jsTernary(
                  jsBinary(jsId('x'), '<', jsNumLit('0')),
                  jsStrLit('neg'),
                  jsStrLit('zero'))));
}

// =============================================================================
// If statement
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::ifStmtSingleBranch(): Boolean[1]
{
   testStmt('''
            if (ready) {
              return 1;
            }''',
            jsIfStmt(
               jsId('ready'),
               jsBlock([jsReturn(jsNumLit('1'))]),
               []));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::ifStmtWithElse(): Boolean[1]
{
   testStmt('''
            if (ready) {
              return 1;
            } else {
              return 0;
            }''',
            jsIfStmt(
               jsId('ready'),
               jsBlock([jsReturn(jsNumLit('1'))]),
               jsBlock([jsReturn(jsNumLit('0'))])));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::ifElseIfChain(): Boolean[1]
{
   testStmt('''
            if (a) {
              return 1;
            } else if (b) {
              return 2;
            } else {
              return 3;
            }''',
            jsIfStmt(
               jsId('a'),
               jsBlock([jsReturn(jsNumLit('1'))]),
               jsIfStmt(
                  jsId('b'),
                  jsBlock([jsReturn(jsNumLit('2'))]),
                  jsBlock([jsReturn(jsNumLit('3'))]))));
}

// =============================================================================
// let / const
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::letWithInit(): Boolean[1]
{
   testStmt('let count = 0;', jsLet('count', jsNumLit('0')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::letStringInit(): Boolean[1]
{
   testStmt('let name = \'world\';', jsLet('name', jsStrLit('world')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::letNoInit(): Boolean[1]
{
   testStmt('let value;', jsLet('value', []));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::constWithInit(): Boolean[1]
{
   testStmt('const PI = 3.14;', jsConst('PI', jsNumLit('3.14')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::constInferred(): Boolean[1]
{
   testStmt('const greeting = \'hi\';', jsConst('greeting', jsStrLit('hi')));
}

// =============================================================================
// Unary operators in conditional position
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::notExpr(): Boolean[1]
{
   testExpr('!ready', jsNot(jsId('ready')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::negExpr(): Boolean[1]
{
   testExpr('-x', jsNeg(jsId('x')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::typeofExpr(): Boolean[1]
{
   testExpr('typeof x', jsTypeof(jsId('x')));
}

// =============================================================================
// Combined: guard-clause pattern
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::guardClause(): Boolean[1]
{
   testStmt('''
            if (!items.length) {
              return [];
            }''',
            jsIfStmt(
               jsNot(jsLength(jsId('items'))),
               jsBlock([jsReturn(jsArrayLit([]))]),
               []));
}
