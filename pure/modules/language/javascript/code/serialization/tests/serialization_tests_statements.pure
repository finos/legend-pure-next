import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;
import meta::external::language::javascript::serialization::*;
import meta::external::language::javascript::serialization::tests::*;

function <<test.Test>> meta::external::language::javascript::serialization::tests::returnVoidStmt(): Boolean[1]
{
   testStmt('return;', jsReturn([]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::returnWithValue(): Boolean[1]
{
   testStmt('return 42;', jsReturn(jsNumLit('42')));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::expressionStmt(): Boolean[1]
{
   testStmt('foo();', jsExprStmt(jsCall(jsId('foo'), [])));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::emptyBlock(): Boolean[1]
{
   testStmt('{}', jsBlock([]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::blockWithReturn(): Boolean[1]
{
   testStmt('''
            {
              return 42;
            }''',
            jsBlock([jsReturn(jsNumLit('42'))]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::blockTwoStatements(): Boolean[1]
{
   testStmt('''
            {
              foo();
              return 42;
            }''',
            jsBlock([
               jsExprStmt(jsCall(jsId('foo'), [])),
               jsReturn(jsNumLit('42'))
            ]));
}
