import meta::external::language::javascript::factories::*;
import meta::external::language::javascript::metamodel::*;
import meta::external::language::javascript::serialization::*;
import meta::external::language::javascript::serialization::tests::*;

// =============================================================================
// Get / Set accessors
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::classWithGetter(): Boolean[1]
{
   testStmt('''
            class Box {
              get value() {
                return 1;
              }
            }''',
            jsClass('Box', [
               jsGetter('value', jsBlock([jsReturn(jsNumLit('1'))]))
            ]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::classWithSetter(): Boolean[1]
{
   testStmt('''
            class Box {
              set value(v) {
                return;
              }
            }''',
            jsClass('Box', [
               jsSetter('value', jsParam('v'), jsBlock([jsReturn([])]))
            ]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::classWithGetterAndSetter(): Boolean[1]
{
   testStmt('''
            class Box {
              get value() {
                return this.v;
              }

              set value(v) {
                return;
              }
            }''',
            jsClass('Box', [
               jsGetter('value', jsBlock([jsReturn(jsAccess(jsThis(), 'v'))])),
               jsSetter('value', jsParam('v'), jsBlock([jsReturn([])]))
            ]));
}

// =============================================================================
// Shorthand property assignment — emits `{ x }`, not `{ x: x }`.
// =============================================================================

function <<test.Test>> meta::external::language::javascript::serialization::tests::shorthandSingle(): Boolean[1]
{
   testExpr('{ x }', jsObject([jsEntryShorthand('x')]));
}

function <<test.Test>> meta::external::language::javascript::serialization::tests::shorthandMixed(): Boolean[1]
{
   // Shorthand and long-form sit side by side in the same literal.
   testExpr('{ x, name: \'Ada\', y }',
            jsObject([
               jsEntryShorthand('x'),
               jsEntry('name', jsStrLit('Ada')),
               jsEntryShorthand('y')
            ]));
}
