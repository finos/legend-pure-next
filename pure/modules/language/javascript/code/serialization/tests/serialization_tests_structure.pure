import platform::external::language::javascript::factories::*;
import platform::external::language::javascript::metamodel::*;
import platform::external::language::javascript::serialization::*;
import platform::external::language::javascript::serialization::tests::*;

function <<test.Test>> platform::external::language::javascript::serialization::tests::emptyClass(): Boolean[1]
{
   testStmt('class Empty {}', jsClass('Empty', []));
}

function <<test.Test>> platform::external::language::javascript::serialization::tests::exportedEmptyClass(): Boolean[1]
{
   testStmt('export class Empty {}', jsExportedClass('Empty', []));
}

function <<test.Test>> platform::external::language::javascript::serialization::tests::classWithOneProperty(): Boolean[1]
{
   testStmt('''
            class Person {
              name;
            }''',
            jsClass('Person', [jsProperty('name')]));
}

function <<test.Test>> platform::external::language::javascript::serialization::tests::classWithOneMethod(): Boolean[1]
{
   testStmt('''
            class Greeter {
              greet(name) {
                return name;
              }
            }''',
            jsClass('Greeter', [
               jsMethod('greet',
                  [jsParam('name')],
                  jsBlock([jsReturn(jsId('name'))]))
            ]));
}

function <<test.Test>> platform::external::language::javascript::serialization::tests::simpleImport(): Boolean[1]
{
   testStmt(
      'import { Foo } from \'./bar.js\';',
      jsImport('./bar.js', [jsNamedImport('Foo')]));
}

function <<test.Test>> platform::external::language::javascript::serialization::tests::multipleNamedImports(): Boolean[1]
{
   testStmt(
      'import { Foo, Bar, Baz } from \'./things.js\';',
      jsImport('./things.js', [jsNamedImport('Foo'), jsNamedImport('Bar'), jsNamedImport('Baz')]));
}

function <<test.Test>> platform::external::language::javascript::serialization::tests::greeterEndToEnd(): Boolean[1]
{
   let method = jsMethod(
      'greet',
      [jsParam('name')],
      jsBlock([
         jsReturn(jsBinary(jsStrLit('Hello, '), '+', jsId('name')))
      ])
   );
   let cls = jsExportedClass('Greeter', [$method]);
   let sf  = jsSourceFile('greeter.ts', [$cls]);
   testFile('''
            export class Greeter {
              greet(name) {
                return 'Hello, ' + name;
              }
            }
            ''',
            $sf);
}
