import platform::extensions::language::java::metamodel::*;
import platform::extensions::language::java::metamodel::project::*;

Class platform::extensions::language::java::metamodel::Code
{
   <<equality.Key>> type : platform::extensions::language::java::metamodel::Type[1];
   requires              : CodeDependency[*];
   // The Pure source position this code was translated from, when known. The
   // serializer turns it into a position marker the class renderer collects into
   // a generated-line to Pure-position table, from which PureStack renders
   // positioned stack frames. NOT an equality key: two pieces of code that
   // differ only in where they came from are still the same code, and Code
   // equality is relied on elsewhere.
   sourceInformation     : platform::pure::metamodel::SourceInformation[0..1];
}

