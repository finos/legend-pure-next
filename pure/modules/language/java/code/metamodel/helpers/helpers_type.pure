function platform::extensions::language::java::metamodel::elementTypeOfJavaStream(type: platform::extensions::language::java::metamodel::Type[1]):platform::extensions::language::java::metamodel::Type[1]
{
   assert($type->isJavaStream(), |'Cannot obtain element type as not a Stream');
