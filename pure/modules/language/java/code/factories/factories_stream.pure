function meta::external::language::java::factory::js_reduce(stream:Code[1], identity:Code[1], func:Code[1]):Code[1]
{
   $stream->prepareStreamForCallWithLambda($func)->j_invoke('reduce', [$identity, $func], $identity.type->toBoxed());
}

