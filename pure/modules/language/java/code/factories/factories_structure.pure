function platform::extensions::language::java::factory::javaClass(typeParams:platform::extensions::language::java::metamodel::TypeVariable[*], proto:platform::extensions::language::java::metamodel::Class[1], fields:platform::extensions::language::java::metamodel::Field[*], constructors:Pair<platform::extensions::language::java::metamodel::Constructor,Code>[*], methods:Pair<platform::extensions::language::java::metamodel::Method,Code>[*]):platform::extensions::language::java::metamodel::Class[1]
{
