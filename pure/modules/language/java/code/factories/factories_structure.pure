{ // TODO: this can be skipped or simplified in fast mode
   let knownPackages = if($class->instanceOf(platform::extensions::language::java::factory::FactoryClass),
                          | $class->cast(@platform::extensions::language::java::factory::FactoryClass).knownPackages,
                          | platform::extensions::language::java::factory::knownPackage_Package_1__KnownPackage_1_
                       );

   let packages = $imports->filter(imp| $imp->instanceOf(platform::extensions::language::java::metamodel::Package))->cast(@platform::extensions::language::java::metamodel::Package)->filter(p| !$p->isJavaLang());
   let classes  = $imports->filter(imp| $imp->instanceOf(platform::extensions::language::java::metamodel::Class))->cast(@platform::extensions::language::java::metamodel::Class)->filter(c| !$c.package->isJavaLang());

   let existingImports = $class.additionalImports->map(imp| if($imp->endsWith('.*'),
                                                               |javaPackage($imp->substring(0, $imp->length()-2)),
                                                               |javaClass($imp)
                                                            )
                                                      );
   let withNewPackages = $existingImports->concatenate($packages)->removeDuplicates();
   let withoutSubsumed = $withNewPackages->filter(imp| $imp->match([
      pkg: platform::extensions::language::java::metamodel::Package[1] | true,
      cls: platform::extensions::language::java::metamodel::Class[1]   | !$withNewPackages->contains($cls.package)
   ]));

   let importedNames = $class.simpleName
      ->concatenate($withoutSubsumed->map(imp| $imp->match([
           pkg: platform::extensions::language::java::metamodel::Package[1] | $knownPackages->eval($pkg).classNames,
           cls: platform::extensions::language::java::metamodel::Class[1]   | $cls.simpleName
        ])));

   let importableClasses = $classes->removeDuplicatesBy(c | $c.simpleName)->filter(cls| !$withoutSubsumed->contains($cls.package) && !$importedNames->contains($cls.simpleName));
   let newImports        = $withoutSubsumed->concatenate($importableClasses)->removeDuplicates();

   ^$class(
      additionalImports=$newImports
         ->map(imp| $imp->match([
             pkg: platform::extensions::language::java::metamodel::Package[1] | $pkg->packageToString()+'.*',
             cls: platform::extensions::language::java::metamodel::Class[1]   | $cls->typeToString()
           ]))
         ->sort()
   );
