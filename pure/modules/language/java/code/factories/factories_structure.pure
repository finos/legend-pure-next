      {c, cl |
         let constuctor = $c.first;
         let bodyCode   = $c.second;
         $cl->addConstructor(^$constuctor(bodyCode=$bodyCode));
      },
      $withFields
   );

   $methods->fold(
      {m, cl |
         let method   = $m.first;
         let bodyCode = $m.second;
         $cl->addMethod(^$method(bodyCode=$bodyCode));
      },
      $withConstructors
   );
