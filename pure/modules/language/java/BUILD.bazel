# The Java language model.

load("//tools/bazel:pure.bzl", "pure_bootstrap_compile")

pure_bootstrap_compile(
    name = "compile",
    srcs = glob(["**/*.pure", "module.json"]),
    base_pdbs = ["//pure/specification:core.pdb"],
    outs = ["build/java.pdb", "build/java-tests.pdb"],
    source_dir = package_name(),
    split_tests = True,
    visibility = ["//visibility:public"],
)
