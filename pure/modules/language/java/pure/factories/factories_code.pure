      {fromP:meta::external::language::java::metamodel::PrimitiveType[1] |
         $to->match([
            {toP:meta::external::language::java::metamodel::PrimitiveType[1] |
               if($fromP.simpleName == $toP.simpleName,
                  | CastCompatibility.Identity,
                  |
               if($fromP.simpleName == 'byte' && $toP.simpleName == 'char',
                  | CastCompatibility.WideningAndNarrowing,
                  |
               if($fromP.simpleName == 'byte' && ['short', 'int', 'long', 'float', 'double']->contains($toP.simpleName),
                  | CastCompatibility.Widening,
                  |
               if($fromP.simpleName == 'short' && ['byte', 'char']->contains($toP.simpleName),
                  | CastCompatibility.Narrowing,
                  |
               if($fromP.simpleName == 'short' && ['int', 'long', 'float', 'double']->contains($toP.simpleName),
                  | CastCompatibility.Widening,
                  |
               if($fromP.simpleName == 'char' && ['byte', 'short']->contains($toP.simpleName),
                  | CastCompatibility.Narrowing,
                  |
               if($fromP.simpleName == 'char' && ['int', 'long', 'float', 'double']->contains($toP.simpleName),
                  | CastCompatibility.Widening,
                  |
               if($fromP.simpleName == 'int' && ['byte', 'short', 'char']->contains($toP.simpleName),
                  | CastCompatibility.Narrowing,
                  |
               if($fromP.simpleName == 'int' && ['long', 'float', 'double']->contains($toP.simpleName),
                  | CastCompatibility.Widening,
                  |
               if($fromP.simpleName == 'long' && ['byte', 'short', 'char', 'int']->contains($toP.simpleName),
                  | CastCompatibility.Narrowing,
                  |
               if($fromP.simpleName == 'long' && ['float', 'double']->contains($toP.simpleName),
                  | CastCompatibility.Widening,
                  |
               if($fromP.simpleName == 'float' && ['byte', 'short', 'char', 'int', 'long']->contains($toP.simpleName),
                  | CastCompatibility.Narrowing,
                  |
               if($fromP.simpleName == 'float' && $toP.simpleName == 'double',
                  | CastCompatibility.Widening,
                  |
               if($fromP.simpleName == 'double' && ['byte', 'short', 'char', 'int', 'long', 'float']->contains($toP.simpleName),
                  | CastCompatibility.Narrowing,
                  | CastCompatibility.Disallowed
               ))))))))))))));
            },
            {toC:meta::external::language::java::metamodel::Class[1] |
               if($fromP.simpleName == 'byte' && $toC->isClass('java.lang', 'Byte'),
