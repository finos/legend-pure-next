   | $then,
   |
   if($expr.left->instanceOf(Null) && $expr.right->instanceOf(Null) && $expr.op == '!=',
   | $else,
   |
   if($expr.left->isSameLiteral($expr.right) && $expr.op == '==',
   | $then,
   |
   if($expr.left->isSameLiteral($expr.right) && $expr.op == '!=',
   | $else,
   | ^Conditional(test=$expr, then=$then, else=$else, type=$type)
   ))))
}

