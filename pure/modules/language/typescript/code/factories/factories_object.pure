// Factories for object literals.
//
//   tsObject([
//     tsEntry('name', tsStrLit('Ada')),
//     tsEntry('age',  tsNumLit('36'))
//   ])
//
//   ->  { name: 'Ada', age: 36 }
//
// v1 emits long-form key:value pairs only. Shorthand `{ x }` is rendered
// as `{ x: x }` (semantically identical, accepted by tsc). True shorthand
// requires a new ShorthandPropertyAssignment node, which can land when a
// real generator needs the byte-level difference. Same story for spreads.

import meta::external::language::typescript::factories::*;
import meta::external::language::typescript::metamodel::*;

// =============================================================================
// Property assignments.
// =============================================================================

function meta::external::language::typescript::factories::tsEntry(key: String[1], value: Expression[1]): PropertyAssignment[1]
{
   ^PropertyAssignment(name=$key, initializer=$value);
}

// Renders as `{ x }` shorthand for `{ x: x }`. v2 (this round) uses the
// proper ShorthandPropertyAssignment node; v1 emitted the long form.
function meta::external::language::typescript::factories::tsEntryShorthand(name: String[1]): ShorthandPropertyAssignment[1]
{
   ^ShorthandPropertyAssignment(name=$name);
}

// =============================================================================
// Object literal.
// =============================================================================

function meta::external::language::typescript::factories::tsObject(entries: ObjectLiteralElement[*]): ObjectLiteralExpression[1]
{
   ^ObjectLiteralExpression(properties=$entries);
}

function meta::external::language::typescript::factories::tsEmptyObject(): ObjectLiteralExpression[1]
{
   ^ObjectLiteralExpression(properties=[]);
}
