import meta::external::language::typescript::factories::*;
import meta::external::language::typescript::metamodel::*;
import meta::external::language::typescript::serialization::*;
import meta::external::language::typescript::serialization::tests::*;

function <<test.Test>> meta::external::language::typescript::serialization::tests::emptyClass(): Boolean[1]
{
   testStmt('class Empty {}', tsClass('Empty', []));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::exportedEmptyClass(): Boolean[1]
{
   testStmt('export class Empty {}', tsExportedClass('Empty', []));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::classWithOneProperty(): Boolean[1]
{
   testStmt('''
            class Person {
              name: string;
            }''',
            tsClass('Person', [tsProperty('name', tsString())]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::classWithOneMethod(): Boolean[1]
{
   testStmt('''
            class Greeter {
              greet(name: string): string {
                return name;
              }
            }''',
            tsClass('Greeter', [
               tsMethod('greet',
                  [tsParam('name', tsString())],
                  tsString(),
                  tsBlock([tsReturn(tsId('name'))]))
            ]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::simpleImport(): Boolean[1]
{
   testStmt(
      'import { Foo } from \'./bar.js\';',
      tsImport('./bar.js', [tsNamedImport('Foo')]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::multipleNamedImports(): Boolean[1]
{
   testStmt(
      'import { Foo, Bar, Baz } from \'./things.js\';',
      tsImport('./things.js', [tsNamedImport('Foo'), tsNamedImport('Bar'), tsNamedImport('Baz')]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::greeterEndToEnd(): Boolean[1]
{
   let method = tsMethod(
      'greet',
      [tsParam('name', tsString())],
      tsString(),
      tsBlock([
         tsReturn(tsBinary(tsStrLit('Hello, '), '+', tsId('name')))
      ])
   );
   let cls = tsExportedClass('Greeter', [$method]);
   let sf  = tsSourceFile('greeter.ts', [$cls]);
   testFile('''
            export class Greeter {
              greet(name: string): string {
                return 'Hello, ' + name;
              }
            }
            ''',
            $sf);
}
