import meta::external::language::typescript::factories::*;
import meta::external::language::typescript::metamodel::*;
import meta::external::language::typescript::serialization::*;
import meta::external::language::typescript::serialization::tests::*;

// =============================================================================
// Optional property access  expr?.name
// =============================================================================

function <<test.Test>> meta::external::language::typescript::serialization::tests::optionalAccessSimple(): Boolean[1]
{
   testExpr('user?.name', tsOptAccess(tsId('user'), 'name'));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::optionalAccessChained(): Boolean[1]
{
   // Mix optional + non-optional in a chain: user?.profile.name
   // First step optional, rest plain — TS short-circuits on the first ?.
   testExpr('user?.profile.name',
            tsAccess(tsOptAccess(tsId('user'), 'profile'), 'name'));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::optionalAccessTwice(): Boolean[1]
{
   // user?.profile?.name
   testExpr('user?.profile?.name',
            tsOptAccess(tsOptAccess(tsId('user'), 'profile'), 'name'));
}

// =============================================================================
// Optional call  fn?.()
// =============================================================================

function <<test.Test>> meta::external::language::typescript::serialization::tests::optionalCallNoArgs(): Boolean[1]
{
   testExpr('callback?.()', tsOptCall(tsId('callback'), []));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::optionalCallWithArgs(): Boolean[1]
{
   testExpr('callback?.(1, 2)',
            tsOptCall(tsId('callback'), [tsNumLit('1'), tsNumLit('2')]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::optionalMethodCall(): Boolean[1]
{
   // user.save?.()  — optional invocation of a property
   testExpr('user.save?.()',
            tsOptCall(tsAccess(tsId('user'), 'save'), []));
}

// =============================================================================
// Nullish coalescing  a ?? b
// =============================================================================

function <<test.Test>> meta::external::language::typescript::serialization::tests::nullishCoalesceSimple(): Boolean[1]
{
   testExpr('x ?? 0', tsNullishCoalesce(tsId('x'), tsNumLit('0')));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::nullishCoalesceWithAccess(): Boolean[1]
{
   // user?.name ?? 'anonymous'
   testExpr('user?.name ?? \'anonymous\'',
            tsNullishCoalesce(
               tsOptAccess(tsId('user'), 'name'),
               tsStrLit('anonymous')));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::nullishCoalesceInConst(): Boolean[1]
{
   testStmt('const name = user?.name ?? \'anonymous\';',
            tsConst('name', [],
               tsNullishCoalesce(
                  tsOptAccess(tsId('user'), 'name'),
                  tsStrLit('anonymous'))));
}
