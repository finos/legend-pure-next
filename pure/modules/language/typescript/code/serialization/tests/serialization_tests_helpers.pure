import meta::external::language::typescript::metamodel::*;
import meta::external::language::typescript::serialization::*;
import meta::external::language::typescript::serialization::tests::*;

// Golden-text helpers. Each compares the rendered text against an expected
// String for one node category. We deliberately do NOT normalize whitespace —
// the serializer's exact byte output is what `tsc` will see, so that is what
// the tests pin down.

function meta::external::language::typescript::serialization::tests::testType(expected: String[1], t: TypeNode[1]): Boolean[1]
{
   assertEquals($expected, $t->serializeType());
}

function meta::external::language::typescript::serialization::tests::testExpr(expected: String[1], e: Expression[1]): Boolean[1]
{
   assertEquals($expected, $e->serializeExpression());
}

function meta::external::language::typescript::serialization::tests::testStmt(expected: String[1], s: Statement[1]): Boolean[1]
{
   assertEquals($expected, $s->serializeStatement(''));
}

function meta::external::language::typescript::serialization::tests::testFile(expected: String[1], sf: SourceFile[1]): Boolean[1]
{
   assertEquals($expected, $sf->serialize());
}
