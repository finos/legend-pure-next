import meta::external::language::typescript::factories::*;
import meta::external::language::typescript::metamodel::*;
import meta::external::language::typescript::serialization::*;
import meta::external::language::typescript::serialization::tests::*;

function <<test.Test>> meta::external::language::typescript::serialization::tests::keywordString(): Boolean[1]
{
   testType('string', tsString());
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::keywordNumber(): Boolean[1]
{
   testType('number', tsNumber());
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::keywordBoolean(): Boolean[1]
{
   testType('boolean', tsBoolean());
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::keywordVoid(): Boolean[1]
{
   testType('void', tsVoid());
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::arrayOfString(): Boolean[1]
{
   testType('string[]', tsArrayOf(tsString()));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::arrayOfArrayOfNumber(): Boolean[1]
{
   testType('number[][]', tsArrayOf(tsArrayOf(tsNumber())));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::typeRefSimple(): Boolean[1]
{
   testType('Foo', tsRef('Foo'));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::typeRefGeneric(): Boolean[1]
{
   testType('Map<string, number>', tsRefGeneric('Map', [tsString(), tsNumber()]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::typeRefNested(): Boolean[1]
{
   testType('Promise<Array<string>>', tsRefGeneric('Promise', [tsRefGeneric('Array', [tsString()])]));
}
