import meta::external::language::typescript::factories::*;
import meta::external::language::typescript::metamodel::*;
import meta::external::language::typescript::serialization::*;
import meta::external::language::typescript::serialization::tests::*;

function <<test.Test>> meta::external::language::typescript::serialization::tests::returnVoidStmt(): Boolean[1]
{
   testStmt('return;', tsReturn([]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::returnWithValue(): Boolean[1]
{
   testStmt('return 42;', tsReturn(tsNumLit('42')));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::expressionStmt(): Boolean[1]
{
   testStmt('foo();', tsExprStmt(tsCall(tsId('foo'), [])));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::emptyBlock(): Boolean[1]
{
   testStmt('{}', tsBlock([]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::blockWithReturn(): Boolean[1]
{
   testStmt('''
            {
              return 42;
            }''',
            tsBlock([tsReturn(tsNumLit('42'))]));
}

function <<test.Test>> meta::external::language::typescript::serialization::tests::blockTwoStatements(): Boolean[1]
{
   testStmt('''
            {
              foo();
              return 42;
            }''',
            tsBlock([
               tsExprStmt(tsCall(tsId('foo'), [])),
               tsReturn(tsNumLit('42'))
            ]));
}
