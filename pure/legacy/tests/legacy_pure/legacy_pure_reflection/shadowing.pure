// A package declaring classes named after primitives, imported (as the relational store's datatype package
// is): a primitive's simple name still means the primitive.
import usecases::reflection::datatype::*;

Class usecases::reflection::datatype::Integer
{
  size: String[1];
}

Class usecases::reflection::datatype::Column
{
  name: String[1];
  type: usecases::reflection::datatype::Integer[1];
}

function usecases::reflection::twice(i: Integer[1]): Integer[1]
{
  $i * 2
}

function <<test.Test>> usecases::reflection::testAPrimitiveNameIsThePrimitive(): Boolean[1]
{
  assertEquals(4, usecases::reflection::twice(2));
  assertEquals('Integer', usecases::reflection::twice(2)->type()->toString());
  assertEquals('8', ^Column(name = 'c', type = ^usecases::reflection::datatype::Integer(size = '8')).type.size);
}
