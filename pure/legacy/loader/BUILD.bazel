# The loader of legacy sources: legacy_loader.pdb and its tests.

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools/bazel:pure.bzl", "pure_module")

pure_module(
    name = "legacy_loader",
    base_pdbs = ["//pure/specification:core-tests.pdb"],
)

_M3_PROTOCOL = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-generators:m3_protocol_pure"

# Writes code/rewrite.pure back to the source tree, so it is run, not built.
sh_binary(
    name = "rewrite_generate",
    srcs = ["tools/rewrite-generate.sh"],
    args = ["$(rootpath %s)" % _M3_PROTOCOL],
    data = [_M3_PROTOCOL],
    tags = ["manual"],
)
