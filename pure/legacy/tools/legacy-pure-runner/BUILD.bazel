# legend-pure itself, pinned (@legend_pure_runner in MODULE.bazel), to run legacy Pure and read its real answers:
# bazel run //pure/legacy:test_legacy_pure_on_legend_pure.

load("@rules_java//java:defs.bzl", "java_binary")

java_binary(
    name = "legacy-pure-runner",
    srcs = ["src/RunLegacy.java"],
    main_class = "RunLegacy",
    tags = ["manual"],
    visibility = ["//pure/legacy:__pkg__"],
    deps = [
        "@legend_pure_runner//:org_eclipse_collections_eclipse_collections",
        "@legend_pure_runner//:org_eclipse_collections_eclipse_collections_api",
        "@legend_pure_runner//:org_finos_legend_pure_legend_pure_m3_core",
        "@legend_pure_runner//:org_finos_legend_pure_legend_pure_m4",
        "@legend_pure_runner//:org_finos_legend_pure_legend_pure_runtime_java_engine_interpreted",
    ],
)
