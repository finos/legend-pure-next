# The legend-pure compatibility layer: legacy.pdb and legacy-tests.pdb, and the tests of its tools. Its loader is a
# module of its own (loader/). What needs the pinned legend-pure and legend-engine sources is run from here too, by
# tools/legacy.sh, and is no part of a build or of //...: bazel run //pure/legacy:<command>.

load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools/bazel:pure.bzl", "pure_module")

pure_module(
    name = "legacy",
    srcs = glob(["code/**/*.pure", "module.json"]),
    base_pdbs = ["//pure/specification:core-tests.pdb"],
    sources = ["code"],
)

# The tests of its tools: the grammar preprocessor.
js_test(
    name = "test_tools",
    data = ["tools/preprocess.mjs"],
    entry_point = "tools/preprocess.test.mjs",
    tags = ["job:bootstrap"],
)

_CLI_BOOTSTRAP = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli:pure-bootstrap"
_CLI_TRUFFLE = "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-interfaces/legend-pure-next-platform-truffle-cli:pure-truffle"
_TDS_PDB = "//pure/extensions/pure/tds:build/tds.pdb"
_LEGACY_PDB = ":build/legacy.pdb"
_LOADER_PDB = "//pure/legacy/loader:build/legacy_loader.pdb"
_RUNNER = "//pure/legacy/tools/legacy-pure-runner"

# What the commands of tools/legacy.sh read, as tool names: the PDBs of 'shared', which they find beside core.pdb.
_SHARED_PDBS = ["//:shared/%s.pdb" % name for name in ["core", "core-tests", "parser-mappings", "pdb", "pdb_writer", "compiler"]]
_TOOLS = {
    "bootstrap": _CLI_BOOTSTRAP,
    "truffle": _CLI_TRUFFLE,
    "tds_pdb": _TDS_PDB,
    "legacy_pdb": _LEGACY_PDB,
    "loader_pdb": _LOADER_PDB,
    "runner": _RUNNER,
}

# {command: the tools it runs or reads, and whether it reads 'shared'}.
_COMMANDS = {
    "legend_sources_fetch": ([], False),
    "bridge_generate": (["bootstrap", "loader_pdb"], True),
    "legend_modules_load": (["bootstrap", "truffle", "tds_pdb", "legacy_pdb", "loader_pdb"], True),
    "test_legend_modules": (["truffle", "tds_pdb", "legacy_pdb"], True),
    "legacy_pure_expected_update": (["bootstrap", "loader_pdb"], True),
    "test_legacy_pure_on_next": (["bootstrap", "tds_pdb", "legacy_pdb", "loader_pdb"], True),
    "test_legacy_pure_on_legend_pure": (["runner"], False),
}

[sh_binary(
    name = command,
    srcs = ["tools/legacy.sh"],
    args = [command] + ["%s=$(rootpath %s)" % (tool, _TOOLS[tool]) for tool in tools] + (["shared_core=$(rootpath //:shared/core.pdb)"] if shared else []),
    data = [_TOOLS[tool] for tool in tools] + (_SHARED_PDBS if shared else []),
    tags = ["manual"],
) for command, (tools, shared) in _COMMANDS.items()]
