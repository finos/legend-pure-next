import meta::pure::functions::io::*;
import meta::pure::functions::math::*;
import meta::pure::functions::string::*;

// ---------------------------------------------------------------------------
// Two-line ANSI progress display: a bar that overwrites itself in place plus
// a status line directly below it showing the item currently being processed.
// Used by the test runners and the directory compiler. All terminal writes
// assume the terminal honors VT100 escape sequences (carriage return, cursor
// up/down, erase-in-line). No fallback for non-TTY output — same assumption
// the rest of the CLI makes.
//
// Invariant maintained across calls:
//   After startProgress and after every tickProgress, the cursor sits at
//   column 0 of the bar line (the line containing the bar). finishProgress
//   leaves the cursor on a fresh line below the cleared display area.
//
// Usage:
//   startProgress('Running 247 tests from spec/...');
//   range(0, $total)->map(i | tickProgress($i + 1, $total, $name); doWork($i););
//   finishProgress();
//   println('OK: 247 / 247 passed in 1234 ms');
// ---------------------------------------------------------------------------

// Render a 30-char progress bar plus percentage and counter. Pure function;
// kept public so callers that want the bar text without the cursor dance
// (logging, custom redraw) can reuse it.
function meta::pure::ui::progress::renderBar(done:Integer[1], total:Integer[1]):String[1]
{
    let fullBar = '\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588';
    let emptyBar = '\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591';
    let width = 30;
    // `/` returns Float in Pure — convert back to Integer via floor.
    let filled = if($total == 0, |0, |floor($done * $width / $total));
    let pct = if($total == 0, |100, |floor($done * 100 / $total));
    // Each block char is 3 bytes in UTF-8 — substring operates on Java char indices,
    // so taking first `filled` characters of the full/empty templates gives the right slice.
    '[' + substring($fullBar, 0, $filled)
        + substring($emptyBar, 0, $width - $filled)
        + '] ' + $pct->toString() + '%  ('
        + $done->toString() + '/' + $total->toString() + ')';
}

// Print the header, reserve two lines for the bar + status display, then park
// the cursor on the bar line. Caller should print no other output between
// startProgress and the matching finishProgress, or the bar will scroll off.
function meta::pure::ui::progress::startProgress(label:String[1]):Boolean[1]
{
    println($label);
    println('');
    println('');
    print('\u001B[2A');
    true;
}

// Redraw the bar with `done`/`total` and update the status line below it
// with `current`. Restores the bar-line cursor invariant on exit.
//   \r\u001B[K<bar>     — column 0, clear to EOL, write bar
//   \u001B[B\r\u001B[K  — cursor down (no scroll) to status line, col 0, clear
//   '  ' + $current     — write current item
//   \u001B[K            — clear tail (in case previous item name was longer)
//   \u001B[A\r          — cursor up back to bar line, col 0
function meta::pure::ui::progress::tickProgress(done:Integer[1], total:Integer[1], current:String[1]):Boolean[1]
{
    print('\r\u001B[K' + meta::pure::ui::progress::renderBar($done, $total)
          + '\u001B[B\r\u001B[K  ' + $current + '\u001B[K\u001B[A\r');
    true;
}

// Clear the bar + status lines and drop the cursor onto a fresh line below.
// After this call the caller can println a summary normally.
function meta::pure::ui::progress::finishProgress():Boolean[1]
{
    print('\r\u001B[K\u001B[B\r\u001B[K\u001B[B\r');
    true;
}

// ---------------------------------------------------------------------------
// Three-line ANSI progress display: phase header / bar / current item.
// Mirrors the Java native compiler's live status view (CompilerBinaryBuilder)
// so the user sees the same UX whether they run `pure-bootstrap compile` or
// `pure-bootstrap compile-via-pure` / `pure-truffle compile`.
//
// Invariant: after startProgress3 and after every tickProgress3, the cursor
// sits at column 0 of the header line (line 1). finishProgress3 leaves the
// cursor on a fresh line below the cleared 3-line area.
//
// Usage:
//   startProgress3();
//   range(0, $total)->map(i |
//     tickProgress3('Pass 3/3', $i + 1, $total, $elementName); doWork($i);
//   );
//   finishProgress3();
// ---------------------------------------------------------------------------

// Reserve 3 lines and park cursor on line 1. Unlike startProgress, no header
// is printed — the header is rendered live by tickProgress3 so it can change.
function meta::pure::ui::progress::startProgress3():Boolean[1]
{
    println('');
    println('');
    println('');
    print('\u001B[3A');
    true;
}

// Redraw all 3 lines: header / bar / current item. Writes content first then
// clears tail (\u001B[K) on each line - minimises flicker when content shrinks.
function meta::pure::ui::progress::tickProgress3(header:String[1], done:Integer[1], total:Integer[1], current:String[1]):Boolean[1]
{
    print('\r' + $header + '\u001B[K\u001B[B\r  '
          + meta::pure::ui::progress::renderBar($done, $total) + '\u001B[K\u001B[B\r  '
          + $current + '\u001B[K\u001B[A\u001B[A\r');
    true;
}

// Leave the 3 reserved lines in place (header / bar / current item visible
// to the user as a record of the final state), and drop the cursor onto
// a fresh line below them so subsequent output appears underneath.
//   \u001B[3B  cursor down 3 lines (no scroll, no overwrite)
//   \r         column 0
//   \n         newline so subsequent output starts below a blank gap
function meta::pure::ui::progress::finishProgress3():Boolean[1]
{
    print('\u001B[3B\r\n');
    true;
}
