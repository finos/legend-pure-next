import meta::pure::metamodel::type::generics::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::lambda::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::functionType::*;

// Lambda helpers

function meta::pure::compiler::helper::lambda::buildFunctionType(lambda:LambdaFunction<Any>[1]):FunctionType[1]
{
    let ft = newFunctionType();
    let ftWithParams = if($lambda.parameters->isNotEmpty(),
                          | ^$ft(parameters=$lambda.parameters),
                          | $ft
                       );
    if($lambda.expressionSequence->isNotEmpty(),
       | let lastExpr = $lambda.expressionSequence->last()->toOne();
         ^$ftWithParams(
            returnType = $lastExpr.genericType,
            returnMultiplicity = $lastExpr.multiplicity
         );,
       | $ftWithParams
    );
}

function meta::pure::compiler::helper::lambda::getLambdaClassifierGenericType(lambda:LambdaFunction<Any>[1]):GenericType[1]
{
    let base = buildInferredGenericType(LambdaFunction);
    ^$base(typeArguments = [buildInferredGenericType($lambda->buildFunctionType())]);
}

// Tests

function <<test.Test>> meta::pure::compiler::helper::lambda::tests::testBuildFunctionType():Boolean[1]
{
    let lambda = {a:String[1]| $a + 'ok'};
    let ft = $lambda->buildFunctionType();
    
    assert($ft.parameters->isNotEmpty());
    assertEquals('a', $ft.parameters->at(0).name);
    assertEquals(String, $ft.parameters->at(0).genericType->toOne()->genericTypeRawType()->toOne());
    assertEquals($lambda.expressionSequence->last()->toOne().genericType, $ft.returnType);
    assertEquals(1, $ft.returnMultiplicity->toOne()->multiplicityLowerBound());
    assertEquals(1, $ft.returnMultiplicity->toOne()->multiplicityUpperBound());
}

function <<test.Test>> meta::pure::compiler::helper::lambda::tests::testGetLambdaClassifierGenericType():Boolean[1]
{
    let lambda = {a:String[1]| $a + 'ok'};
    let gto = $lambda->getLambdaClassifierGenericType();
    
    assertEquals(LambdaFunction, $gto->genericTypeRawType()->toOne());
    let ta = $gto->genericTypeTypeArguments();
    assertEquals(1, $ta->size());
    assert($ta->at(0)->genericTypeRawType()->toOne()->instanceOf(FunctionType));
}
