import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::compiler::resolution::functionDefinitionResolver::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::resolveAtomicValue(av:AtomicValue[1], scope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    $av.value->match(
        [
            lambda : LambdaFunction<Any>[1] |
                let lambdaParams = $lambda.parameters->cast(@VariableExpression);
                let lambdaParamNames = $lambdaParams->map(p | $p.name->toOne());

                // Compute open variables structurally from the (unresolved) body. Names are
                // stable per source position (AST is immutable); we look up each name in the
                // current scope at cache-check time to capture the body's external dependencies.
                let unresolvedOpenVars = meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($lambda.expressionSequence, $lambdaParamNames);

                // Cache key shape: sourceInfo || param shapes || open-var name=current-scope-type pairs.
                let cacheKey = meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::buildLambdaCacheKey($av, $lambdaParams, $unresolvedOpenVars, $scope);

                // (1) Failure cache: previously determined this exact key can't resolve.
                let failureHit = if($cacheKey->isEmpty(), | false, | $context.lambdaFailureCache->get($cacheKey->toOne())->isNotEmpty());
                if($failureHit,
                    | debug($context, | 'resolveAtomicValue: LAMBDA failure cache hit');
                      let siCtx = formatMetamodelSourceInfo($av.sourceInformation, $context);
                      ^CompilerResult<ValueSpecification>(
                          value = ^$av(genericType = ^CompilerNotSetGenericType()),
                          context = ^$context(errors += 'Can\'t resolve lambda parameter types' + $siCtx)
                      );,
                    | // Skip body resolution if lambda params don't have concrete types.
                      let paramsAreConcrete = $lambdaParams->forAll(p |
                          $p.genericType->toOne()->isConcreteGenericType()
                          && $p.multiplicity->toOne()->isConcreteMultiplicity()
                      );
                      if(!$paramsAreConcrete,
                          | debug($context, | 'resolveAtomicValue: LAMBDA params not concrete in context, deferring');
                            let siCtx = formatMetamodelSourceInfo($av.sourceInformation, $context);
                            let updatedFailureCache = if($cacheKey->isEmpty(),
                                | $context.lambdaFailureCache,
                                | $context.lambdaFailureCache->put($cacheKey->toOne(), true)
                            );
                            let ctxWithError = ^$context(errors += 'Can\'t resolve lambda parameter types' + $siCtx);
                            let ctxWithFailure = ^$ctxWithError(lambdaFailureCache = $updatedFailureCache);
                            ^CompilerResult<ValueSpecification>(
                                value = ^$av(genericType = ^CompilerNotSetGenericType()),
                                context = $ctxWithFailure
                            );,
                          | // (2) Body cache: memoized body resolution outcomes.
                            let cachedOutcome = if($cacheKey->isEmpty(), | []->cast(@CachedLambdaOutcome), | $context.lambdaResolutionCache->get($cacheKey->toOne()));
                            if($cachedOutcome->isNotEmpty(),
                                | debug($context, | 'resolveAtomicValue: LAMBDA cache hit ' + $cacheKey->toOne());
                                  let cached = $cachedOutcome->toOne();
                                  let ctxWithReplay = ^$context(errors = $context.errors->concatenate($cached.errorsFired));
                                  ^CompilerResult<ValueSpecification>(
                                      value = $cached.av,
                                      context = $ctxWithReplay
                                  );,
                                | // Body resolution path
                                  let preBodyErrorCount = $context.errors->size();
                                  let siCtx = formatMetamodelSourceInfo($av.sourceInformation, $context);
                                  let conflictCtx = $lambdaParams->fold({p, c |
                                      let conflict = $scope->filter(s | $s.name == $p.name);
                                      if($conflict->isNotEmpty(),
                                          | ^$c(errors += 'Variable \'' + $p.name + '\' is already defined' + $siCtx),
                                          | $c
                                      );
                                  }, $context);
                                  debug($conflictCtx, | 'resolveAtomicValue: LAMBDA resolving body');
                                  let innerScope = $scope->concatenate($lambdaParams);
                                  let resolveResult = resolveExpressionSequence($lambda.expressionSequence, $innerScope, $conflictCtx);
                                  let ctx1 = $resolveResult.context;
                                  let bodyReturnGT = if($resolveResult.resolvedSpecs->isEmpty(),
                                      | ^CompilerNotSetGenericType(),
                                      | let lastExpr = $resolveResult.resolvedSpecs->at($resolveResult.resolvedSpecs->size() - 1);
                                        if($lastExpr.genericType->isEmpty() || $lastExpr.genericType->toOne()->instanceOf(CompilerNotSetGenericType),
                                            | ^CompilerNotSetGenericType(),
                                            | $lastExpr.genericType->toOne()
                                        );
                                  );
                                  let bodyReturnMul = if($resolveResult.resolvedSpecs->isEmpty(),
                                      | PureOne,
                                      | let lastExpr = $resolveResult.resolvedSpecs->at($resolveResult.resolvedSpecs->size() - 1);
                                        if($lastExpr.multiplicity->isEmpty(), | PureOne, | $lastExpr.multiplicity->toOne());
                                  );
                                  let lambdaFT = meta::pure::functions::lang::new(
                                      buildUserDefinedGenericType(FunctionType)
                                  )->cast(@FunctionType);
                                  let ft = ^$lambdaFT(parameters = $lambdaParams, returnType = $bodyReturnGT, returnMultiplicity = $bodyReturnMul);
                                  let lambdaInnerGT = buildInferredGenericType($ft);
                                  let lambdaBaseGT = buildInferredGenericType(LambdaFunction);
                                  let lambdaGT = ^$lambdaBaseGT(typeArguments = [$lambdaInnerGT]);
                                  let resolvedOpenVars = meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($resolveResult.resolvedSpecs->cast(@ValueSpecification), $lambdaParamNames);
                                  let resolvedLambda = ^$lambda(
                                      expressionSequence = $resolveResult.resolvedSpecs->cast(@ValueSpecification),
                                      classifierGenericType = $lambdaGT,
                                      openVariables = $resolvedOpenVars
                                  );
                                  let resolvedAv = ^$av(value = $resolvedLambda, genericType = $lambdaGT);
                                  // Cache the body outcome including any errors that fired.
                                  let errorsFired = $ctx1.errors->drop($preBodyErrorCount);
                                  let outcome = ^CachedLambdaOutcome(av = $resolvedAv, errorsFired = $errorsFired);
                                  let ctxOut = if($cacheKey->isEmpty(),
                                      | $ctx1,
                                      | ^$ctx1(lambdaResolutionCache = $ctx1.lambdaResolutionCache->put($cacheKey->toOne(), $outcome))
                                  );
                                  debug($context, | 'resolveAtomicValue: LAMBDA gt=' + printGenericType($lambdaGT));
                                  ^CompilerResult<ValueSpecification>(
                                      value = $resolvedAv,
                                      context = $ctxOut
                                  );
                            );
                      );
                );,
            a : Any[1] |
                // For element references, refresh from the map to get up-to-date classifierGenericType.
                // Mirrors Java AtomicValueResolver.processPackagePointer: the resolved element's CGT
                // is run through withUndefinedTypeParams so intrinsic type parameters of the element
                // (e.g. T in `Class<List<T>>` when referencing List as a value) are wildcarded —
                // otherwise an outer call's binder sees that T as a free TypeParameter, NO_MATCH's
                // the arg, and finalises with its own type parameter unbound (see reproducer at
                // specification/compiler/valueSpecification/atomicValue/element/classWithTypeParameter.pure).
                if($a->instanceOf(PackageableElement),
                    | let path = $a->cast(@PackageableElement)->elementToPath();
                      let fromMap = $context->resolveElement($path);
                      if($fromMap->isNotEmpty(),
                          | let resolved = $fromMap->toOne()->cast(@PackageableElement);
                            let resolvedCGT = $resolved->cast(@Any).classifierGenericType;
                            let updatedGT = if($resolvedCGT->isEmpty(),
                                | $av.genericType,
                                | asInferredGenericType(withUndefinedTypeParams($resolvedCGT->toOne()))
                            );
                            ^CompilerResult<ValueSpecification>(value = ^$av(value = $resolved, genericType = $updatedGT->toOne()), context = $context);,
                          | ^CompilerResult<ValueSpecification>(value = $av, context = $context)
                      );,
                    | ^CompilerResult<ValueSpecification>(value = $av, context = $context)
                )
        ]
    );
}

// Returns a stable cache key for a lambda AtomicValue keyed by
// (sourceInfo, paramShape, openVar-name=current-scope-type pairs), or [] when no source info.
function meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::buildLambdaCacheKey(av:AtomicValue[1], lambdaParams:VariableExpression[*], unresolvedOpenVars:VariableExpression[*], scope:VariableExpression[*]):String[0..1]
{
    if($av.sourceInformation->isEmpty(),
        | [],
        | let si = $av.sourceInformation->toOne();
          let sid = if($si.sourceId->isEmpty(), | '?', | $si.sourceId->toOne());
          let sl = $si.startLine->toOne()->toString();
          let sc = $si.startColumn->toOne()->toString();
          let el = $si.endLine->toOne()->toString();
          let ec = $si.endColumn->toOne()->toString();
          let paramsKey = $lambdaParams->map(p |
              let gt = $p.genericType->toOne()->printGenericType();
              let mul = $p.multiplicity->toOne()->printMultiplicity();
              $gt + ':' + $mul;
          )->joinStrings('|');
          let sortedNames = $unresolvedOpenVars->map(v | $v.name->toOne())->sort();
          let openVarPairs = $sortedNames->map(name |
              let resolved = $scope->filter(s | $s.name == $name);
              let typePart = if($resolved->isEmpty(),
                  | '?',
                  | $resolved->at(0).genericType->toOne()->printGenericType() + ':' + $resolved->at(0).multiplicity->toOne()->printMultiplicity()
              );
              $name + '=' + $typePart;
          );
          let openVarsKey = if($openVarPairs->isEmpty(), | '', | '||' + $openVarPairs->joinStrings('|'));
          $sid + ':' + $sl + ':' + $sc + '-' + $el + ':' + $ec + '||' + $paramsKey + $openVarsKey;
    );
}

function meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables(specs:ValueSpecification[*], paramNames:String[*]):VariableExpression[*]
{
    let result = $specs->fold({vs, acc |
        $vs->match([
            ve:VariableExpression[1] |
                if($paramNames->contains($ve.name->toOne()) || $acc->exists(a | $a.name == $ve.name),
                    | $acc,
                    | $acc->concatenate($ve)
                ),
            fe:FunctionExpression[1] |
                $acc->concatenate(meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($fe.parametersValues->cast(@ValueSpecification), $paramNames)),
            av:AtomicValue[1] |
                if($av.value->toOne()->instanceOf(LambdaFunction),
                    | let innerLambda = $av.value->toOne()->cast(@LambdaFunction<Any>);
                      let innerParamNames = $paramNames->concatenate($innerLambda.parameters->cast(@VariableExpression)->map(p | $p.name->toOne()));
                      $acc->concatenate(meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($innerLambda.expressionSequence->cast(@ValueSpecification), $innerParamNames));,
                    | $acc
                ),
            col:Collection[1] |
                $acc->concatenate(meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($col.values->cast(@ValueSpecification), $paramNames)),
            a:Any[1] | $acc
        ]);
    }, []->cast(@VariableExpression));
    $result->removeDuplicatesBy(v | $v.name->toOne());
}
