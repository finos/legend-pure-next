import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::*;

// Mirrors Java VariableExpressionResolver.resolveVariableExpression (lines 14-31)
function meta::pure::compiler::resolution::valueSpecification::variableExpressionResolver::resolveVariableExpression(ve:VariableExpression[1], scope:VariableExpression[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<ValueSpecification>[1]
{
    // If genericType is CompilerNotSetGenericType (= Java null / not set), look up in scope (like Java line 16-23)
    if($ve.genericType->toOne()->instanceOf(CompilerNotSetGenericType),
        | let inScope = $scope->filter(s | $s.name == $ve.name);
          if($inScope->isNotEmpty(),
              | // Found in scope — update genericType and multiplicity from the scope match
                let match = $inScope->at($inScope->size() - 1);
                let updatedVE = ^$ve(
                    genericType = asInferredGenericType($match.genericType->toOne()),
                    multiplicity = asInferredMultiplicity($match.multiplicity->toOne())
                );
                ^meta::pure::compiler::CompilerResult<ValueSpecification>(value = $updatedVE, context = $context);,
              | // Not found — error
                let siCtx = formatMetamodelSourceInfo($ve.sourceInformation, $context);
                ^meta::pure::compiler::CompilerResult<ValueSpecification>(
                    value = $ve,
                    context = ^$context(errors += 'The variable \'' + $ve.name + '\' is unknown!' + $siCtx)
                );
          );,
        | // Already has a concrete type — return as-is
          ^meta::pure::compiler::CompilerResult<ValueSpecification>(value = $ve, context = $context)
    );
}
