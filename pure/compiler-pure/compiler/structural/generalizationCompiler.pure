import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::relationship::*;
import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::*;

function meta::pure::compiler::structural::generalizationCompiler::compileGeneralizations(protocolGeneralizations:meta::pure::protocol::grammar::relationship::Generalization[*], skeleton:Type[1], context:CompilerContext[1], packagePath:String[1], ownerContext:String[1]):CompilerListResult<Generalization>[1]
{
    let typeParams = $skeleton->match(
        [
            c : Class<Any>[1] | $c.typeParameters->cast(@TypeParameter),
            a : Any[1]        | []->cast(@TypeParameter)
        ]
    );
    // Route Generalization construction through new(canonical UDPGT) so the
    // instance's _classifierGenericType resolves to the packageable canonical
    // (mirrors Java GeneralizationImpl(model) constructor which auto-sets
    // _classifierGenericType = optimization::GenericType_Generalization).
    let emptyGen = new(meta::pure::metamodel::type::generics::optimization::GenericType_Generalization)->cast(@Generalization);
    if($protocolGeneralizations->isEmpty(),
        | ^CompilerListResult<Generalization>(
              values = [^$emptyGen(
                  general = buildUserDefinedGenericType(Any),
                  specific = $skeleton
              )],
              context = $context
          ),
        | $protocolGeneralizations->fold({g, acc |
              let gtResult = $g.general->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($acc.context, $packagePath, $typeParams, 'super type', $ownerContext);
              ^$acc(
                  values += ^$emptyGen(
                      general = $gtResult.value->toOne(),
                      specific = $skeleton
                  ),
                  context = $gtResult.context
              );
          }, ^CompilerListResult<Generalization>(context = $context))
    );
}
