import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::structural::multiplicityCompiler::*;
import meta::pure::compiler::*;
import meta::pure::compiler::elements::*;

function meta::pure::compiler::compile(file:meta::pure::protocol::PureFile[1]):meta::pure::compiler::CompilationResult[1]
{
    let debug = ^meta::pure::compiler::DebugState(debug = true, space = '');

    let allElements = $file.sections.elements;
    let defaultImports = [
        'meta::pure::metamodel::type::primitives',
        'meta::pure::metamodel',
        'meta::pure::metamodel::function::property',
        'meta::pure::metamodel::type',
        'meta::pure::metamodel::type::generics',
        'meta::pure::metamodel::function',
        'meta::pure::metamodel::multiplicity',
        'meta::pure::metamodel::relation',
        'meta::pure::metamodel::valuespecification',
        'meta::pure::functions::math',
        'meta::pure::functions::lang',
        'meta::pure::functions::string',
        'meta::pure::functions::collection',
        'meta::pure::functions::boolean',
        'meta::pure::functions::relation',
        'meta::pure::functions::multiplicity',
        'meta::pure::functions::asserts',
        'meta::pure::functions::meta',
        'meta::pure::functions::io',
        'meta::pure::profiles'
    ];
    let fileImports = $file.sections.imports->map(i | if($i->endsWith('::*'), | $i->substring(0, $i->length() - 3), | $i));
    let allImports = $defaultImports->concatenate($fileImports)->removeDuplicates();

    // Pass 1: Build structural scaffolding
    let pass1Context = $allElements->fold({e, ctx |
        $e->match([
            c:meta::pure::protocol::grammar::type::Class[1] |
                let packagePath = if($c.package->isEmpty(), | '', | $c.package->toOne().pointerValue);
                let className = if($packagePath == '', | $c.name, | $packagePath + '::' + $c.name);
                let rootPkg = ^meta::pure::metamodel::Package(name = 'Root');
                let typeParams = $c.typeParameters->map(tp | ^meta::pure::metamodel::type::generics::TypeParameter(name = $tp.name, contravariant = false)->cast(@meta::pure::metamodel::type::generics::TypeParameter));
                let mulParams = $c.multiplicityParameters->map(mp | ^meta::pure::metamodel::multiplicity::UserDefinedMultiplicityParameter(name = $mp.name)->cast(@meta::pure::metamodel::multiplicity::MultiplicityParameter));
                let emptyClass = meta::pure::functions::meta::creation::newClass($typeParams, $mulParams);
                let skeleton = ^$emptyClass(
                    name = $c.name,
                    package = ^meta::pure::metamodel::Package(name = $packagePath, package = $rootPkg),
                    typeParameters = $typeParams,
                    multiplicityParameters = $mulParams,
                    sourceInformation = $c.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
                        sourceId = $si.sourceId,
                        startLine = $si.startLine,
                        startColumn = $si.startColumn,
                        endLine = $si.endLine,
                        endColumn = $si.endColumn
                    ))
                );
                ^$ctx(elementMap=$ctx.elementMap->put($className, $skeleton));,
            a:meta::pure::protocol::grammar::relationship::Association[1] |
                let packagePath = $a.package->toOne().pointerValue;
                let aName = $packagePath + '::' + $a.name;
                let rootPkg = ^meta::pure::metamodel::Package(name = 'Root');
                let emptyAssoc = meta::pure::functions::lang::new(
                    ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::relationship::Association)
                )->cast(@meta::pure::metamodel::relationship::Association);
                let assocSkeleton = ^$emptyAssoc(
                    name = $a.name,
                    package = ^meta::pure::metamodel::Package(name = $packagePath, package = $rootPkg),
                    sourceInformation = $a.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
                        sourceId = $si.sourceId,
                        startLine = $si.startLine,
                        startColumn = $si.startColumn,
                        endLine = $si.endLine,
                        endColumn = $si.endColumn
                    ))
                );
                ^$ctx(elementMap=$ctx.elementMap->put($aName, $assocSkeleton));,
            en:meta::pure::protocol::grammar::type::Enumeration[1] |
                let packagePath = $en.package->toOne().pointerValue;
                let enName = $packagePath + '::' + $en.name;
                let rootPkg = ^meta::pure::metamodel::Package(name = 'Root');
                let emptyEnum = meta::pure::functions::lang::new(
                    ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::Enumeration)
                )->cast(@meta::pure::metamodel::type::Enumeration<Any>);
                let enumSkeletonInt = ^$emptyEnum(
                    name = $en.name,
                    package = ^meta::pure::metamodel::Package(name = $packagePath, package = $rootPkg),
                    sourceInformation = $en.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
                        sourceId = $si.sourceId,
                        startLine = $si.startLine,
                        startColumn = $si.startColumn,
                        endLine = $si.endLine,
                        endColumn = $si.endColumn
                    ))
                );
                let selfGenType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = $enumSkeletonInt);
                let enumSkeleton = ^$enumSkeletonInt(
                    classifierGenericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
                        type = meta::pure::metamodel::type::Enumeration,
                        typeArguments = [$selfGenType]
                    )
                );
                ^$ctx(elementMap=$ctx.elementMap->put($enName, $enumSkeleton));,
            pr:meta::pure::protocol::grammar::extension::Profile[1] |
                $pr->compileProfilePass1($ctx);,
            fn:meta::pure::protocol::grammar::function::NativeFunction[1] |
                $fn->compileNativeFunctionPass1($ctx);,
            fd:meta::pure::protocol::grammar::function::UserDefinedFunction[1] |
                $fd->compileFunctionDefinitionPass1($ctx);,
            p:meta::pure::protocol::grammar::type::PrimitiveType[1] |
                let packagePath = $p.package->toOne().pointerValue;
                let pName = $packagePath + '::' + $p.name;
                let rootPkg = ^meta::pure::metamodel::Package(name = 'Root');
                let emptyPrim = meta::pure::functions::lang::new(
                    ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::PrimitiveType)
                )->cast(@meta::pure::metamodel::type::PrimitiveType);
                let primSkeleton = ^$emptyPrim(
                    name = $p.name,
                    package = ^meta::pure::metamodel::Package(name = $packagePath, package = $rootPkg),
                    sourceInformation = $p.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
                        sourceId = $si.sourceId,
                        startLine = $si.startLine,
                        startColumn = $si.startColumn,
                        endLine = $si.endLine,
                        endColumn = $si.endColumn
                    ))
                );
                ^$ctx(elementMap=$ctx.elementMap->put($pName, $primSkeleton));,
            a:meta::pure::protocol::grammar::PackageableElement[1] | $ctx
        ]);
    }, ^meta::pure::compiler::CompilerContext(debugState = $debug, sourceId = $file.sourceId, imports = $allImports, elementMap=newMap([])));

    // Pass 2: Compile elements (threading context for error collection)
    let pass2 = $allElements->fold({e, acc |
        $e->match([
            c:meta::pure::protocol::grammar::type::Class[1] |
                let r = $c->compileClass($acc.context);
                let compiledClass = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
                let packagePath = if($c.package->isEmpty(), | '', | $c.package->toOne().pointerValue);
                let className = if($packagePath == '', | $c.name, | $packagePath + '::' + $c.name);
                let ctx = $r.context;
                let newMap = $ctx.elementMap->put($className, $compiledClass);
                let updatedCtx = ^$ctx(elementMap = $newMap);
                ^$acc(values += $compiledClass, context = $updatedCtx);,
            p:meta::pure::protocol::grammar::type::PrimitiveType[1] |
                let r = $p->compilePrimitive($acc.context);
                let compiledPrim = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
                let primPackagePath = if($p.package->isEmpty(), | '', | $p.package->toOne().pointerValue);
                let primName = if($primPackagePath == '', | $p.name, | $primPackagePath + '::' + $p.name);
                let primRCtx = $r.context;
                let primNewMap = $primRCtx.elementMap->put($primName, $compiledPrim);
                let primCtx = ^$primRCtx(elementMap = $primNewMap);
                ^$acc(values += $compiledPrim, context = $primCtx);,
            assoc:meta::pure::protocol::grammar::relationship::Association[1] |
                let r = $assoc->compileAssociation($acc.context);
                ^$acc(values += $r.value->cast(@meta::pure::metamodel::PackageableElement), context = $r.context);,
            en:meta::pure::protocol::grammar::type::Enumeration[1] |
                ^$acc(values += $en->compileEnumeration($acc.context)->cast(@meta::pure::metamodel::PackageableElement)),
            fn:meta::pure::protocol::grammar::function::NativeFunction[1] |
                let r = $fn->compileNativeFunctionPass2($acc.context);
                let compiledFn = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
                let fnPackagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().pointerValue);
                let fnName = if($fnPackagePath == '', | $fn.name, | $fnPackagePath + '::' + $fn.name);
                let fnRCtx = $r.context;
                let fnNewMap = $fnRCtx.elementMap->put($fnName, $compiledFn);
                let fnCtx = ^$fnRCtx(elementMap = $fnNewMap);
                ^$acc(values += $compiledFn, context = $fnCtx);,
            fd:meta::pure::protocol::grammar::function::UserDefinedFunction[1] |
                let r = $fd->compileFunctionDefinitionPass2($acc.context);
                let compiledFd = $r.value->toOne()->cast(@meta::pure::metamodel::PackageableElement);
                let fdPackagePath = if($fd.package->isEmpty(), | '', | $fd.package->toOne().pointerValue);
                let fdName = if($fdPackagePath == '', | $fd.name, | $fdPackagePath + '::' + $fd.name);
                let fdRCtx = $r.context;
                let fdNewMap = $fdRCtx.elementMap->put($fdName, $compiledFd);
                let fdCtx = ^$fdRCtx(elementMap = $fdNewMap);
                ^$acc(values += $compiledFd, context = $fdCtx);,
            pr:meta::pure::protocol::grammar::extension::Profile[1] |
                let packagePath = if($pr.package->isEmpty(), | '', | $pr.package->toOne().pointerValue);
                let prName = if($pr.package->isEmpty(), | '', | $packagePath + '::') + $pr.name;
                ^$acc(values += $acc.context.elementMap->get($prName)->toOne()->cast(@meta::pure::metamodel::PackageableElement));,
            a:meta::pure::protocol::grammar::PackageableElement[1] |
                $acc
        ]);
    }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::PackageableElement>(context = $pass1Context));

    // Pass 3: Resolution — resolve expression sequences, constraints, qualified properties
    let pass3Ctx = $pass2.values->fold({elem, ctx |
        $elem->match([
            fn:meta::pure::metamodel::function::UserDefinedFunction<Any>[1] |
                resolveFunctionDefinition($fn, $ctx);,
            cls:meta::pure::metamodel::type::Class<Any>[1] |
                resolveClass($cls, $ctx);,
            pt:meta::pure::metamodel::type::PrimitiveType[1] |
                meta::pure::compiler::structural::constraintCompiler::resolveConstraints($pt, $ctx);,
            a:Any[1] | $ctx
        ]);
    }, $pass2.context);

    ^CompilationResult(elements = $pass2.values, errors = $pass3Ctx.errors);
}

function meta::pure::compiler::resolveFunctionDefinition(fn:meta::pure::metamodel::function::UserDefinedFunction<Any>[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    if($fn.expressionSequence->isEmpty(),
        | $context,
        | let _d = debug($context, | 'resolveAndValidate: function \'' + $fn.functionName->toOne() + '\'');
          let result = meta::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence($fn.expressionSequence, $fn.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression), $context->debugSpaceInc());
          let resultCtx = $result.context;
          ^$resultCtx(debugState = $context.debugState);
    );
}

function meta::pure::compiler::resolveClass(cls:meta::pure::metamodel::type::Class<Any>[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    let ctx1 = meta::pure::compiler::structural::qualifiedPropertyCompiler::resolveQualifiedProperties($cls.qualifiedProperties, $context);
    let ctx2 = meta::pure::compiler::structural::qualifiedPropertyCompiler::validateQualifiedPropertyOverrides($cls, $ctx1);
    let ctx3 = meta::pure::compiler::structural::constraintCompiler::resolveConstraints($cls, $ctx2);
    meta::pure::compiler::structural::propertyCompiler::resolvePropertyDefaultValues($cls.properties, $ctx3);
}
