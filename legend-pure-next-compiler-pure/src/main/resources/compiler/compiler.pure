import meta::pure::compiler::*;

function meta::pure::compiler::compile(file:meta::pure::protocol::PureFile[1]):meta::pure::metamodel::PackageableElement[*]
{
    let context = ^meta::pure::compiler::CompilerContext(elementMap=newMap([]));

    // Pass 1: Build structural scaffolding for all classes
    let protocolClasses = $file.sections.elements->filter(e | $e->instanceOf(meta::pure::protocol::grammar::type::Class))->cast(@meta::pure::protocol::grammar::type::Class);
    
    let pass1Context = $protocolClasses->fold({c, ctx |
        let packagePath = $c.package->toOne().pointerValue;
        let className = $packagePath + '::' + $c.name;
        let rootPkg = ^meta::pure::metamodel::Package(name = 'Root');
        let emptyClass = ^meta::pure::metamodel::type::Class<Any>(
            name = $c.name,
            package = ^meta::pure::metamodel::Package(name = $packagePath, package = $rootPkg),
            sourceInformation = $c.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
                sourceId = $si.sourceId,
                startLine = $si.startLine,
                startColumn = $si.startColumn,
                endLine = $si.endLine,
                endColumn = $si.endColumn
            ))
        );
        ^CompilerContext(elementMap=$ctx.elementMap->put($className, $emptyClass));
    }, $context);

    // Pass 2: Connect attributes and internal references
    $protocolClasses->map(c | $c->meta::pure::compiler::compileClass($pass1Context));
}

