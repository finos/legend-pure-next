import meta::pure::compiler::helper::*;

// FunctionType printing

function meta::pure::compiler::helper::printFunctionType(ft:FunctionType[1]):String[1]
{
    $ft->printFunctionType(true)
}

function meta::pure::compiler::helper::printFunctionType(ft:FunctionType[1], fullPath:Boolean[1]):String[1]
{
    let params = $ft.parameters;
    let paramStr = $params->map(p |
        let gt = $p.genericType;
        let mul = $p.multiplicity;
        if($gt->isEmpty(),
            | 'Unknown',
            | $gt->toOne()->printGenericType($fullPath) + $mul->toOne()->printMultiplicity()
        );
    )->joinStrings(', ');
    let returnStr = if($ft.returnType->isEmpty(),
        | '',
        | $ft.returnType->toOne()->printGenericType($fullPath)
    );
    let returnMul = if($ft.returnMultiplicity->isEmpty(),
        | '',
        | $ft.returnMultiplicity->toOne()->printMultiplicity()
    );
    '{' + $paramStr + '->' + $returnStr + $returnMul + '}';
}


// FunctionType concreteness

function meta::pure::compiler::helper::isConcreteFunctionType(ft:FunctionType[1]):Boolean[1]
{
    let paramsOk = $ft.parameters->filter(p | !$p.genericType->toOne()->isConcreteGenericType())->isEmpty();
    if(!$paramsOk,
        | false,
        | if($ft.returnType->isEmpty(),
              | true,
              | $ft.returnType->toOne()->isConcreteGenericType()
          )
    );
}
