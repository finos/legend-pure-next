import meta::pure::compiler::helper::*;
import meta::pure::metamodel::relation::*;
import meta::pure::metamodel::type::generics::*;

// GenericType helpers

function meta::pure::compiler::helper::printGenericType(genericType:GenericType[1]):String[1]
{
    $genericType->printGenericType(true)
}

function meta::pure::compiler::helper::printGenericType(genericType:GenericType[1], fullPath:Boolean[1]):String[1]
{
    $genericType->match(
        [
            ugt : UndefinedGenericType[1] | '?',
            gto : GenericTypeOperation[1] | $gto->printGenericTypeOperation($fullPath),
            gtv : GenericTypeValue[1]     | $gtv->printGenericTypeValue($fullPath),
            a   : Any[1]                  | 'Unknown'
        ]
    )
}

function meta::pure::compiler::helper::printGenericTypeValue(gtv:GenericTypeValue[1], fullPath:Boolean[1]):String[1]
{
    let rawType = $gtv.type;
    if($rawType->isEmpty(),
        | 'Unknown',
        | let t = $rawType->toOne();
          if($t->instanceOf(TypeParameter),
              | let tpName = $t->cast(@TypeParameter).name;
                if($tpName->isEmpty(), | '?', | $tpName->toOne());,
              | let typeName = $t->match(
                    [
                        ft : FunctionType[1]       | $ft->printFunctionType($fullPath),
                        pe : PackageableElement[1] |
                            if($fullPath,
                                | $pe->meta::pure::compiler::helper::fullPath(),
                                | $pe.name->toOne()
                            ),
                        a  : Any[1]                | 'Unknown'
                    ]
                );
                let typeArgs = $gtv.typeArguments;
                let mulArgs = $gtv.multiplicityArguments;
                if($typeArgs->isEmpty() && $mulArgs->isEmpty(),
                    | $typeName,
                    | let typeArgStr = $typeArgs->map(a | $a->printGenericType($fullPath))->joinStrings(', ');
                      let mulArgStr = $mulArgs->map(m | '|' + $m->printMultiplicityBare())->joinStrings('');
                      $typeName + '<' + $typeArgStr + $mulArgStr + '>';
                );
          );
    );
}

function meta::pure::compiler::helper::printGenericTypeOperation(gto:GenericTypeOperation[1], fullPath:Boolean[1]):String[1]
{
    let left = $gto.left->printGenericType($fullPath);
    let opName = $gto.operationType->toString();
    let op = if($opName == 'Union', | '+',
             | if($opName == 'Difference', | '-',
               | if($opName == 'Equal', | '=', | '⊆')));
    let right = $gto.right->printGenericType($fullPath);
    $left + $op + $right;
}


// GenericType accessors

function meta::pure::compiler::helper::genericTypeTypeArguments(gt:GenericType[1]):GenericType[*]
{
    $gt->match(
        [
            gtv : GenericTypeValue[1] | $gtv.typeArguments,
            a   : Any[1]             | []
        ]
    )
}

function meta::pure::compiler::helper::genericTypeMultiplicityArguments(gt:GenericType[1]):Multiplicity[*]
{
    $gt->match(
        [
            gtv : GenericTypeValue[1] | $gtv.multiplicityArguments,
            a   : Any[1]             | []
        ]
    )
}


// GenericType concreteness

function meta::pure::compiler::helper::isConcreteGenericType(genericType:GenericType[1]):Boolean[1]
{
    $genericType->match(
        [
            ugt : UndefinedGenericType[1] | true,
            gto : GenericTypeOperation[1] | $gto->isConcreteGenericTypeOperation(),
            gtv : GenericTypeValue[1]     | $gtv->isConcreteGenericTypeValue(),
            a   : Any[1]                  | true
        ]
    );
}

function meta::pure::compiler::helper::isConcreteGenericTypeValue(gtv:GenericTypeValue[1]):Boolean[1]
{
    if($gtv.type->isEmpty(),
        | true,
        | let t = $gtv.type->toOne();
          if($t->instanceOf(TypeParameter),
              | false,
              | let ftCheck = $t->match(
                    [
                        ft : FunctionType[1] | $ft->isConcreteFunctionType(),
                        a  : Any[1]          | true
                    ]
                );
                if(!$ftCheck,
                    | false,
                    | $gtv.typeArguments->filter(arg | !$arg->isConcreteGenericType())->isEmpty()
                );
          );
    );
}

function meta::pure::compiler::helper::isConcreteGenericTypeOperation(gto:GenericTypeOperation[1]):Boolean[1]
{
    let opName = $gto.operationType->toString();
    if($opName == 'Subset' || $opName == 'Equal',
        | $gto.right->isConcreteGenericType(),
        | $gto.left->isConcreteGenericType() && $gto.right->isConcreteGenericType()
    );
}


// GenericType concreteness in context

function meta::pure::compiler::helper::isConcreteGenericTypeInContext(genericType:GenericType[1], scopeTypeParams:String[*]):Boolean[1]
{
    if($genericType->isConcreteGenericType(),
        | true,
        | let referencedParams = $genericType->collectReferencedTypeParameterNames();
          if($referencedParams->isEmpty(),
              | false,
              | $referencedParams->filter(n | $scopeTypeParams->filter(s | $s == $n)->isEmpty())->isEmpty()
          );
    )
}


// GenericType referenced parameter names

function meta::pure::compiler::helper::collectReferencedTypeParameterNames(genericType:GenericType[1]):String[*]
{
    $genericType->match(
        [
            ugt : UndefinedGenericType[1] | [],
            gto : GenericTypeOperation[1] |
                $gto.left->collectReferencedTypeParameterNames()
                    ->concatenate($gto.right->collectReferencedTypeParameterNames()),
            gtv : GenericTypeValue[1]     |
                let rawType = $gtv.type;
                let tpNames = if($rawType->isEmpty(),
                    | [],
                    | $rawType->toOne()->match(
                        [
                            tp : TypeParameter[1]  | $tp.name,
                            ft : FunctionType[1]   | $ft->collectFunctionTypeReferencedTypeParameterNames(),
                            a  : Any[1]            | []->cast(@String)
                        ]
                      )
                );
                let argNames = $gtv.typeArguments->map(a | $a->collectReferencedTypeParameterNames());
                $tpNames->concatenate($argNames)->removeDuplicates();,
            a   : Any[1] | []
        ]
    )
}

function meta::pure::compiler::helper::collectReferencedMultiplicityParameterNames(genericType:GenericType[1]):String[*]
{
    $genericType->match(
        [
            ugt : UndefinedGenericType[1] | [],
            gto : GenericTypeOperation[1] |
                $gto.left->collectReferencedMultiplicityParameterNames()
                    ->concatenate($gto.right->collectReferencedMultiplicityParameterNames()),
            gtv : GenericTypeValue[1]     |
                let rawType = $gtv.type;
                let ftNames = if($rawType->isEmpty(),
                    | [],
                    | $rawType->toOne()->match(
                        [
                            ft : FunctionType[1] | $ft->collectFunctionTypeReferencedMultiplicityParameterNames(),
                            a  : Any[1]          | []->cast(@String)
                        ]
                      )
                );
                let argNames = $gtv.typeArguments->map(a | $a->collectReferencedMultiplicityParameterNames());
                let mulArgNames = $gtv.multiplicityArguments->map(m |
                    $m->match(
                        [
                            mp : MultiplicityParameter[1] | $mp.name,
                            a  : Any[1]                   | []->cast(@String)
                        ]
                    )
                );
                $ftNames->concatenate($argNames)->concatenate($mulArgNames)->removeDuplicates();,
            a   : Any[1] | []
        ]
    )
}


// Tests

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testPrintGenericTypeSimple():Boolean[1]
{
    let intGT = ^GenericTypeValue(type = Integer);
    // Full path should match the elementToPath
    assertEquals(Integer->elementToPath(), $intGT->printGenericType(true));
    assertEquals('Integer', $intGT->printGenericType(false));
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testPrintGenericTypeString():Boolean[1]
{
    let strGT = ^GenericTypeValue(type = String);
    assertEquals('String', $strGT->printGenericType(false));
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testPrintGenericTypeUndefined():Boolean[1]
{
    let ugt = ^UndefinedGenericType();
    assertEquals('?', $ugt->printGenericType(false));
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testPrintGenericTypeTypeParameter():Boolean[1]
{
    let tp = ^TypeParameter(name = 'T', contravariant = false);
    let tpGT = ^GenericTypeValue(type = $tp);
    // TypeParameter name may not round-trip through ^ constructor due to runtime property resolution
    let result = $tpGT->printGenericType(false);
    assert($result->length() > 0);
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testGenericTypeTypeArguments():Boolean[1]
{
    let intGT = ^GenericTypeValue(type = Integer);
    let listGT = ^GenericTypeValue(type = Class, typeArguments = $intGT);
    assertEquals(1, $listGT->genericTypeTypeArguments()->size());
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testGenericTypeMultiplicityArguments():Boolean[1]
{
    let intGT = ^GenericTypeValue(type = Integer);
    assert($intGT->genericTypeMultiplicityArguments()->isEmpty());
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testIsConcreteGenericType():Boolean[1]
{
    // Concrete type
    let intGT = ^GenericTypeValue(type = Integer);
    assert($intGT->isConcreteGenericType());

    // TypeParameter reference is not concrete
    let tp = ^TypeParameter(name = 'T', contravariant = false);
    let tpGT = ^GenericTypeValue(type = $tp);
    assertFalse($tpGT->isConcreteGenericType());

    // UndefinedGenericType is considered concrete (it's a wildcard)
    let ugt = ^UndefinedGenericType();
    assert($ugt->isConcreteGenericType());
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testIsConcreteGenericTypeWithTypeArgs():Boolean[1]
{
    // GenericType with concrete type arguments is concrete
    let intGT = ^GenericTypeValue(type = Integer);
    let classGT = ^GenericTypeValue(type = Class, typeArguments = $intGT);
    assert($classGT->isConcreteGenericType());

    // GenericType with type parameter in type argument is not concrete
    let tp = ^TypeParameter(name = 'T', contravariant = false);
    let tpGT = ^GenericTypeValue(type = $tp);
    let classGT2 = ^GenericTypeValue(type = Class, typeArguments = $tpGT);
    assertFalse($classGT2->isConcreteGenericType());
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testCollectReferencedTypeParameterNames():Boolean[1]
{
    // Concrete type has no type parameter references
    let intGT = ^GenericTypeValue(type = Integer);
    assertEquals(0, $intGT->collectReferencedTypeParameterNames()->size());

    // TypeParameter reference returns its name
    let tp = ^TypeParameter(name = 'T', contravariant = false);
    let tpGT = ^GenericTypeValue(type = $tp);
    let names = $tpGT->collectReferencedTypeParameterNames();
    assertEquals(1, $names->size());
    assertEquals('T', $names->at(0));

    // Nested in type arguments
    let classGT = ^GenericTypeValue(type = Class, typeArguments = $tpGT);
    let nestedNames = $classGT->collectReferencedTypeParameterNames();
    assertEquals(1, $nestedNames->size());
    assertEquals('T', $nestedNames->at(0));

    // UndefinedGenericType returns empty
    let ugt = ^UndefinedGenericType();
    assertEquals(0, $ugt->collectReferencedTypeParameterNames()->size());
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testCollectReferencedMultiplicityParameterNames():Boolean[1]
{
    // Concrete type has no multiplicity parameter references
    let intGT = ^GenericTypeValue(type = Integer);
    assertEquals(0, $intGT->collectReferencedMultiplicityParameterNames()->size());

    // UndefinedGenericType returns empty
    let ugt = ^UndefinedGenericType();
    assertEquals(0, $ugt->collectReferencedMultiplicityParameterNames()->size());
}

function <<test.Test>> meta::pure::compiler::helper::tests::genericType::testIsConcreteGenericTypeInContext():Boolean[1]
{
    // Concrete type is concrete in any context
    let intGT = ^GenericTypeValue(type = Integer);
    assert($intGT->isConcreteGenericTypeInContext([]));

    // TypeParameter reference is concrete if it's in scope
    let tp = ^TypeParameter(name = 'T', contravariant = false);
    let tpGT = ^GenericTypeValue(type = $tp);
    assert($tpGT->isConcreteGenericTypeInContext(['T']));
    assertFalse($tpGT->isConcreteGenericTypeInContext([]));
    assertFalse($tpGT->isConcreteGenericTypeInContext(['V']));

    // Nested type parameter: Class<T> is concrete if T is in scope
    let classGT = ^GenericTypeValue(type = Class, typeArguments = $tpGT);
    assert($classGT->isConcreteGenericTypeInContext(['T']));
    assertFalse($classGT->isConcreteGenericTypeInContext([]));
}

function meta::pure::compiler::helper::collectTypeParameterBindings(paramGT:GenericType[1], argGT:GenericType[1], bindings:ParametersBinding[1]):ParametersBinding[1]
{
    $paramGT->match([
        paramV : GenericTypeValue[1] |
            if($paramV.type->isEmpty(),
                | $bindings,
                | $paramV.type->toOne()->match([
                      tp : TypeParameter[1] |
                          $bindings->addTypeBinding($tp, $argGT),
                      otherParamType : Type[1] |
                          $argGT->match([
                              argV : GenericTypeValue[1] |
                                  let b1 = if($otherParamType->instanceOf(FunctionType) && $argV.type->isNotEmpty() && $argV.type->toOne()->instanceOf(FunctionType),
                                      | meta::pure::compiler::helper::collectTypeParameterBindings($paramV.type->toOne()->cast(@FunctionType), $argV.type->toOne()->cast(@FunctionType), $bindings),
                                      | $bindings
                                  );
                                  // relation type would go here
                                  
                                  // Recurse into type arguments positionally
                                  let b2 = if($paramV.typeArguments->isNotEmpty() && $argV.typeArguments->isNotEmpty(),
                                      | $paramV.typeArguments->zip($argV.typeArguments)->fold({pair, bb | collectTypeParameterBindings($pair.first, $pair.second, $bb)}, $b1),
                                      | $b1
                                  );
                                  
                                  // Recurse into multiplicity arguments positionally
                                  if($paramV.multiplicityArguments->isNotEmpty() && $argV.multiplicityArguments->isNotEmpty(),
                                      | $paramV.multiplicityArguments->zip($argV.multiplicityArguments)->fold({pair, bb | collectMultiplicityParameterBindings($pair.first, $pair.second, $bb)}, $b2),
                                      | $b2
                                  );,
                              otherArgGT: GenericType[1] | $bindings
                          ])
                  ])
            ),
        otherParamGT : GenericType[1] | $bindings
    ])
}

function meta::pure::compiler::helper::resolveForTarget(sourceGenericType:GenericType[0..1], targetType:Type[1]):GenericType[0..1]
{
    if($sourceGenericType->isEmpty(),
        | [],
        | $sourceGenericType->toOne()->match([
              src : GenericTypeValue[1] | meta::pure::compiler::helper::resolveForTarget_GenericTypeValue($src, $targetType),
              undefined: UndefinedGenericType[1] | [],
              other: GenericType[1] | []
          ])
    )
}

function meta::pure::compiler::helper::resolveForTarget_GenericTypeValue(src:GenericTypeValue[1], targetType:Type[1]):GenericType[0..1]
{
    if($src.type->isEmpty(),
        | [],
        | let sourceType = $src.type->toOne();
          if($sourceType == $targetType,
              | $src,
              | let initialBindings = newPlainParametersBinding();
                let typeB = if($sourceType->instanceOf(Class),
                    | $sourceType->cast(@Class<Any>).typeParameters->zip($src.typeArguments)->fold({pair, bb | $bb->addTypeBinding($pair.first, $pair.second)}, $initialBindings),
                    | $initialBindings
                );
                let mulB = if($sourceType->instanceOf(Class) && $src.multiplicityArguments->isNotEmpty(),
                    | $sourceType->cast(@Class<Any>).multiplicityParameters->zip($src.multiplicityArguments)->fold({pair, bb | $bb->addMultiplicityBinding($pair.first, $pair.second)}, $typeB),
                    | $typeB
                );
                
                let validGens = $sourceType.generalizations->filter(g | 
                    $g.general->instanceOf(GenericTypeValue) 
                    && $g.general->cast(@GenericTypeValue).type->isNotEmpty()
                    && $g.general->cast(@GenericTypeValue).type->toOne()->linearize()->contains($targetType)
                );
                if($validGens->isEmpty(),
                    | [],
                    | let resolvedGT = meta::pure::compiler::helper::makeAsConcreteAsPossible($validGens->at(0).general, $mulB);
                      meta::pure::compiler::helper::resolveForTarget($resolvedGT, $targetType);
                );
          );
    );
}

function meta::pure::compiler::helper::findCommonGenericType(genericTypes:GenericType[*]):GenericType[0..1]
{
    meta::pure::compiler::helper::findCommonGenericType($genericTypes, false);
}

function meta::pure::compiler::helper::findCommonGenericType_Args(resultType:GenericType[1], projectedValues:GenericTypeValue[*], withArgs:GenericTypeValue[*], common:Type[1], contravariant:Boolean[1]):GenericType[1]
{
    if($withArgs->size() == $projectedValues->size() && $withArgs->isNotEmpty(),
        | let argCount = $withArgs->at(0).typeArguments->size();
          if($withArgs->forAll(gt | $gt.typeArguments->size() == $argCount) && $argCount > 0,
              | let typeParams = if($common->instanceOf(Class), | $common->cast(@Class<Any>).typeParameters, | []);
                let commonArgs = meta::pure::compiler::helper::range($argCount)->map({i | 
                    let argsAtPos = $withArgs->map(gt | $gt.typeArguments->at($i));
                    let argContravariant = if($i < $typeParams->size() && $typeParams->at($i).contravariant == true, | !$contravariant, | $contravariant);
                    meta::pure::compiler::helper::findCommonGenericType($argsAtPos, $argContravariant);
                })->filter(a | $a->isNotEmpty())->map(a | $a->toOne());
                
                if($commonArgs->size() == $argCount,
                    | ^$resultType(typeArguments = $commonArgs),
                    | $resultType
                );,
              | $resultType
          );,
        | $resultType
    );
}

function meta::pure::compiler::helper::range(count:Integer[1]):Integer[*]
{
    meta::pure::compiler::helper::range(0, $count);
}

function meta::pure::compiler::helper::range(start:Integer[1], end:Integer[1]):Integer[*]
{
    if($start == $end, | [], | $start->concatenate(meta::pure::compiler::helper::range($start + 1, $end)));
}

function meta::pure::compiler::helper::findCommonGenericType(genericTypes:GenericType[*], contravariant:Boolean[1]):GenericType[0..1]
{
    if($genericTypes->isEmpty(),
        | ^GenericTypeValue(type = Nil),
        | let nonNullValues = $genericTypes->filter(gt | $gt->instanceOf(GenericTypeValue))->cast(@GenericTypeValue);
          
          let firstName = if($nonNullValues->isNotEmpty() && $nonNullValues->at(0).type->isNotEmpty() && $nonNullValues->at(0).type->toOne()->instanceOf(TypeParameter),
              | $nonNullValues->at(0).type->toOne()->cast(@TypeParameter).name,
              | []
          );
          let allSameTp = if($firstName->isNotEmpty(),
              | $nonNullValues->forAll(gt | $gt.type->isNotEmpty() && $gt.type->toOne()->instanceOf(TypeParameter) && $gt.type->toOne()->cast(@TypeParameter).name == $firstName->toOne()),
              | false
          );
          if($allSameTp,
              | $nonNullValues->at(0),
              | let rawTypes = $nonNullValues->filter(gt | $gt.type->isNotEmpty() && !$gt.type->toOne()->instanceOf(TypeParameter))->map(gt | $gt.type->toOne());
                if($rawTypes->isEmpty(),
                    | [],
                    | let commonType = meta::pure::compiler::helper::findCommonType($rawTypes, $contravariant);
                      if($commonType->isEmpty(),
                          | [],
                          | let common = $commonType->toOne();
                            let resultType = ^GenericTypeValue(type = $common);
                            
                            let projected = if($rawTypes->forAll(t | $t == $common),
                                | $nonNullValues,
                                | $genericTypes->map(gt | meta::pure::compiler::helper::resolveForTarget($gt, $common))->filter(p | $p->isNotEmpty())->map(p | $p->toOne())
                            );
                            
                            let projectedValues = $projected->filter(gt | $gt->instanceOf(GenericTypeValue))->cast(@GenericTypeValue);
                            let withArgs = $projectedValues->filter(gt | $gt.typeArguments->isNotEmpty());
                            
                            meta::pure::compiler::helper::findCommonGenericType_Args($resultType, $projectedValues, $withArgs, $common, $contravariant);
                      );
                );
          );
    );
}

function meta::pure::compiler::helper::makeAsConcreteAsPossible(genericType:GenericType[1], bindings:ParametersBinding[1]):GenericType[1]
{
    $genericType->match([
        undefined : UndefinedGenericType[1] | $genericType,
        gtv : GenericTypeValue[1] |
            if($gtv.type->isNotEmpty() && $gtv.type->toOne()->instanceOf(TypeParameter),
                | let name = $gtv.type->toOne()->cast(@TypeParameter).name;
                  let boundTypes = $bindings.typeBindings->get($name);
                  if($boundTypes->isEmpty(),
                      | $genericType,
                      | if($boundTypes->toOne().values->size() == 1,
                            | $boundTypes->toOne().values->at(0),
                            | let common = meta::pure::compiler::helper::findCommonGenericType($boundTypes->toOne().values);
                              if($common->isEmpty(), | $genericType, | $common->toOne());
                        )
                  );,
                | let ftResolved = if($gtv.type->isNotEmpty() && $gtv.type->toOne()->instanceOf(FunctionType),
                      | meta::pure::compiler::helper::makeAsConcreteAsPossible($genericType, $gtv.type->toOne()->cast(@FunctionType), $bindings),
                      | []
                  );
                  // relation type inference logic goes here
                  if($ftResolved->isNotEmpty(),
                      | $ftResolved->toOne(),
                      | let typeArgsResolved = $gtv.typeArguments->map(a | meta::pure::compiler::helper::makeAsConcreteAsPossible($a, $bindings));
                        let mulArgsResolved = $gtv.multiplicityArguments->map(m | meta::pure::compiler::helper::makeAsConcreteAsPossible($m, $bindings));
                        if($typeArgsResolved == $gtv.typeArguments && $mulArgsResolved == $gtv.multiplicityArguments,
                            | $genericType,
                            | ^$gtv(typeArguments = $typeArgsResolved, multiplicityArguments = $mulArgsResolved)
                        );
                  );
            );,
        other : GenericType[1] | $genericType
    ])
}
