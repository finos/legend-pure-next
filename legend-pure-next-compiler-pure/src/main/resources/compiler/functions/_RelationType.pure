import meta::pure::compiler::helper::*;
import meta::pure::metamodel::relation::*;

// RelationType printing

function meta::pure::compiler::helper::printRelationType(rt:RelationType<Any>[1]):String[1]
{
    $rt->printRelationType(true)
}

function meta::pure::compiler::helper::printRelationType(rt:RelationType<Any>[1], fullPath:Boolean[1]):String[1]
{
    let cols = $rt.columns->cast(@Column<Any,Any|*>)->map(col |
        let name = if($col.nameWildCard == true, | '?', | $col.name->toOne());
        let typeStr = if($col.genericType->isEmpty(), | '', | $col.genericType->toOne()->printGenericType($fullPath));
        let mulStr = if($col.multiplicity->isEmpty(), | '', | $col.multiplicity->toOne()->printMultiplicity());
        $name + ':' + $typeStr + $mulStr;
    )->joinStrings(', ');
    '(' + $cols + ')';
}


// RelationType concreteness

function meta::pure::compiler::helper::isConcreteRelationType(rt:RelationType<Any>[1]):Boolean[1]
{
    $rt.columns->cast(@Column<Any,Any|*>)->filter(col | if($col.genericType->isEmpty(), | false, | !$col.genericType->toOne()->isConcreteGenericType()))->isEmpty()
}


// RelationType referenced parameter names

function meta::pure::compiler::helper::collectRelationTypeReferencedTypeParameterNames(rt:RelationType<Any>[1]):String[*]
{
    $rt.columns->cast(@Column<Any,Any|*>)
        ->filter(col | $col.genericType->isNotEmpty())
        ->map(col | $col.genericType->toOne()->collectReferencedTypeParameterNames())
        ->removeDuplicates()
}

function meta::pure::compiler::helper::collectRelationTypeReferencedMultiplicityParameterNames(rt:RelationType<Any>[1]):String[*]
{
    $rt.columns->cast(@Column<Any,Any|*>)->map(col |
        let gtNames = if($col.genericType->isEmpty(),
            | [],
            | $col.genericType->toOne()->collectReferencedMultiplicityParameterNames()
        );
        let mulNames = $col.multiplicity->match(
            [
                mp : MultiplicityParameter[1] | $mp.name,
                a  : Any[1]                   | []->cast(@String)
            ]
        );
        $gtNames->concatenate($mulNames);
    )->removeDuplicates()
}

function meta::pure::compiler::helper::findCommonRelationType(relationTypes:RelationType<Any>[*]):Type[0..1]
{
    meta::pure::compiler::helper::findCommonRelationType($relationTypes, false);
}

function meta::pure::compiler::helper::findCommonRelationType(relationTypes:RelationType<Any>[*], contravariant:Boolean[1]):Type[0..1]
{
    if($relationTypes->isEmpty(),
        | [],
        | if($relationTypes->size() == 1,
              | $relationTypes->at(0),
              | meta::pure::compiler::helper::findCommonRelationType_build($relationTypes, $contravariant)
          )
    );
}

function meta::pure::compiler::helper::findCommonRelationType_build(relationTypes:RelationType<Any>[*], contravariant:Boolean[1]):Type[0..1]
{
    // Find common column names (intersection)
    let firstNames = $relationTypes->at(0).columns->cast(@Column<Any,Any|*>)->map(c | $c.name->toOne());
    let commonNames = $relationTypes->tail()->fold({rt, names |
        let rtNames = $rt.columns->cast(@Column<Any,Any|*>)->map(c | $c.name->toOne());
        $names->filter(n | $rtNames->contains($n));
    }, $firstNames);

    if($commonNames->isEmpty(),
        | if($contravariant, | Nil, | Any),
        | // For each common column, find the common type and multiplicity
          let commonColumns = $commonNames->map({colName |
              let colTypes = $relationTypes->map(rt |
                  $rt.columns->cast(@Column<Any,Any|*>)->filter(c | $c.name == $colName)->map(c | $c.genericType)
              )->filter(gt | $gt->isNotEmpty())->map(gt | $gt->toOne());
              let commonType = if($colTypes->isNotEmpty(),
                  | meta::pure::compiler::helper::findCommonGenericType($colTypes, false),
                  | []
              );
              let colMuls = $relationTypes->map(rt |
                  $rt.columns->cast(@Column<Any,Any|*>)->filter(c | $c.name == $colName)->map(c | $c.multiplicity)
              );
              let commonMul = if($colMuls->isNotEmpty(),
                  | meta::pure::compiler::helper::findCommonMultiplicity($colMuls),
                  | []
              );
              ^Column<Any,Any|*>(
                  name = $colName,
                  nameWildCard = false,
                  genericType = $commonType,
                  multiplicity = if($commonMul->isEmpty(), | PureOne, | $commonMul->toOne())
              );
          });
          ^RelationType<Any>(columns = $commonColumns);
    );
}

function meta::pure::compiler::helper::isCompatibleRelationType(declared:RelationType<Any>[1], actual:RelationType<Any>[1], contravariant:Boolean[1]):Boolean[1]
{
    let declaredCols = $declared.columns->cast(@Column<Any,Any|*>);
    let actualCols = $actual.columns->cast(@Column<Any,Any|*>);
    $declaredCols->forAll({dc |
        if($dc.nameWildCard == true,
            | true,
            | let matchingCol = $actualCols->filter(c | $c.name == $dc.name);
              if($matchingCol->isEmpty(),
                  | false,
                  | let ac = $matchingCol->at(0);
                    let typeOk = if($dc.genericType->isNotEmpty() && $ac.genericType->isNotEmpty(),
                        | meta::pure::compiler::helper::isCompatibleGenericType($dc.genericType->toOne(), $ac.genericType->toOne(), $contravariant),
                        | true
                    );
                    let mulOk = if($dc.multiplicity->isNotEmpty() && $ac.multiplicity->isNotEmpty(),
                        | meta::pure::compiler::helper::multiplicitySubsumes($dc.multiplicity, $ac.multiplicity),
                        | true
                    );
                    $typeOk && $mulOk;
              );
        );
    });
}

function meta::pure::compiler::helper::evaluateRelationTypeOperation(leftRT:RelationType<Any>[1], rightRT:RelationType<Any>[1], opType:GenericTypeOperationType[1]):RelationType<Any>[0..1]
{
    $opType->match([
        op : GenericTypeOperationType[1] |
            if($op == GenericTypeOperationType.Union,
                | let leftCols = $leftRT.columns->cast(@Column<Any,Any|*>)->map(c | 
                      ^Column<Any,Any|*>(name = $c.name, nameWildCard = if($c.nameWildCard->isEmpty(), | false, | $c.nameWildCard), genericType = $c.genericType, multiplicity = $c.multiplicity)
                  );
                  let rightCols = $rightRT.columns->cast(@Column<Any,Any|*>)->map(c |
                      ^Column<Any,Any|*>(name = $c.name, nameWildCard = if($c.nameWildCard->isEmpty(), | false, | $c.nameWildCard), genericType = $c.genericType, multiplicity = $c.multiplicity)
                  );
                  ^RelationType<Any>(columns = $leftCols->concatenate($rightCols));,
                | if($op == GenericTypeOperationType.Difference,
                      | let rightNames = $rightRT.columns->cast(@Column<Any,Any|*>)->map(c | $c.name->toOne());
                        let kept = $leftRT.columns->cast(@Column<Any,Any|*>)->filter(c | !$rightNames->contains($c.name->toOne()))->map(c |
                            ^Column<Any,Any|*>(name = $c.name, nameWildCard = if($c.nameWildCard->isEmpty(), | false, | $c.nameWildCard), genericType = $c.genericType, multiplicity = $c.multiplicity)
                        );
                        ^RelationType<Any>(columns = $kept);,
                      | []
                  )
            )
    ]);
}
