import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::class::*;
import meta::pure::compiler::*;


Class meta::pure::compiler::structural::valueSpecificationCompiler::SequenceCompileResult
{
    specs: meta::pure::metamodel::valuespecification::ValueSpecification[*];
    scope: meta::pure::metamodel::valuespecification::VariableExpression[*];
    openVariables: meta::pure::metamodel::valuespecification::VariableExpression[*];
    context: meta::pure::compiler::CompilerContext[0..1];
}

Class meta::pure::compiler::structural::valueSpecificationCompiler::ValueCompileResult
{
    values: meta::pure::metamodel::valuespecification::ValueSpecification[*];
    openVariables: meta::pure::metamodel::valuespecification::VariableExpression[*];
    context: meta::pure::compiler::CompilerContext[0..1];
}

// ============================================================================
// Expression sequence compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileExpressionSequence(expressions:meta::pure::protocol::grammar::valuespecification::ValueSpecification[*], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]): SequenceCompileResult[1]
{
    let result = fold($expressions, {expr, acc |
        let currentCtx = if($acc.context->isNotEmpty(), | $acc.context->toOne(), | $ctx);
        let m3ExprResult = $expr->compileValueSpecification($currentCtx, $acc.scope);
        let updatedCtx = if($m3ExprResult.context->isNotEmpty(), | $m3ExprResult.context, | $acc.context);

        if($m3ExprResult.values->isEmpty(),
            | ^SequenceCompileResult(
                  specs = $acc.specs,
                  scope = $acc.scope,
                  openVariables = $acc.openVariables,
                  context = $updatedCtx
              ),
            | let m3Expr = $m3ExprResult.values->at(0);
              let exprOpenVars = $m3ExprResult.openVariables;
              // Expand scope for let bindings
              let newScope = match($expr, [
                  fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
                      if($fi.functionName == 'letFunction',
                          | let m3FI = $m3Expr->cast(@meta::pure::metamodel::valuespecification::FunctionInvocation);
                            let args = $m3FI.parametersValues;
                            let varName = $args->at(0)->cast(@meta::pure::metamodel::valuespecification::AtomicValue<String>).value->cast(@String);
                            let newVar = ^meta::pure::metamodel::valuespecification::VariableExpression(
                                name = $varName,
                                genericType = $m3FI.genericType,
                                multiplicity = $m3FI.multiplicity
                            );
                            $acc.scope->concatenate($newVar);,
                          | $acc.scope
                      ),
                  a:Any[1] | $acc.scope
              ]);
              ^SequenceCompileResult(
                  specs = $acc.specs->concatenate($m3Expr),
                  scope = $newScope,
                  openVariables = $acc.openVariables->concatenate($exprOpenVars)->removeDuplicatesBy({v | $v.name->toOne()}),
                  context = $updatedCtx
              );
        );
    }, ^SequenceCompileResult(specs=[], scope=$scope, openVariables=[]));
    $result;
}

// ============================================================================
// Value specification compilation — dispatches by protocol type
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileValueSpecification(vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]): ValueCompileResult[1]
{
    let mGenType = if($vs.genericType->isEmpty(), | [], | $vs.genericType->toOne()->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($ctx, '', []).value);
    let mMult = if($vs.multiplicity->isEmpty(), | [], | $vs.multiplicity->toOne()->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity());

    match($vs, [
        a:meta::pure::protocol::grammar::valuespecification::AtomicValue[1] |
            compileAtomicValue($a, $vs, $ctx, $scope, $mGenType, $mMult),

        v:meta::pure::protocol::grammar::valuespecification::VariableExpression[1] |
            compileVariableExpression($v, $vs, $ctx, $scope),

        fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
            compileFunctionInvocation($fi, $vs, $ctx, $scope),

        l:meta::pure::protocol::grammar::function::LambdaFunction[1] |
            $l->compileLambda($ctx, $scope, $mGenType, $mMult),

        c:meta::pure::protocol::grammar::valuespecification::Collection[1] |
            compileCollection($c, $ctx, $scope),

        arrow:meta::pure::protocol::grammar::valuespecification::ArrowInvocation[1] |
            compileArrowInvocation($arrow, $vs, $ctx, $scope),

        dot:meta::pure::protocol::grammar::valuespecification::DotApplication[1] |
            compileDotApplication($dot, $vs, $ctx, $scope),

        gmh:meta::pure::protocol::grammar::valuespecification::GenericTypeAndMultiplicityHolder[1] |
            compileGenericTypeAndMultiplicityHolder($gmh, $vs, $ctx),

        any:Any[1] |
            ^ValueCompileResult(values = [], openVariables = [])
    ]);
}

// ============================================================================
// AtomicValue compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileAtomicValue(a:meta::pure::protocol::grammar::valuespecification::AtomicValue[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*], mGenType:meta::pure::metamodel::type::generics::GenericType[0..1], mMult:meta::pure::metamodel::multiplicity::Multiplicity[0..1]):ValueCompileResult[1]
{
    let rawValue = $a.value->toOne();
    if($rawValue->instanceOf(meta::pure::protocol::grammar::function::LambdaFunction),
        | let lambdaResult = $rawValue->cast(@meta::pure::protocol::grammar::function::LambdaFunction)->compileLambda($ctx, $scope, $mGenType, $mMult);
          if($lambdaResult.values->isEmpty(),
              | $lambdaResult,
              | let compiledVal = $lambdaResult.values->at(0);
                let inferredGT = if($mGenType->isEmpty(), | ^meta::pure::metamodel::type::generics::UndefinedGenericType(), | $mGenType->toOne());
                ^ValueCompileResult(
                    values = [^meta::pure::metamodel::valuespecification::AtomicValue(
                        value = $compiledVal,
                        genericType = $inferredGT,
                        multiplicity = if($mMult->isEmpty(), | meta::pure::metamodel::multiplicity::PureOne, | $mMult->toOne()),
                        sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
                    )],
                    openVariables = $lambdaResult.openVariables,
                    context = $lambdaResult.context
                );
          );,
        | if($rawValue->instanceOf(meta::pure::protocol::grammar::Package_Pointer),
              | let pp = $rawValue->cast(@meta::pure::protocol::grammar::Package_Pointer);
                let resolved = $ctx->resolveElement($pp.pointerValue);
                if($resolved->isEmpty(),
                    | let siCtx = if($vs.sourceInformation->isNotEmpty(), | formatSourceInfo($vs.sourceInformation->toOne()->cast(@meta::pure::protocol::grammar::SourceInformation), $ctx), | '');
                      ^ValueCompileResult(values = [], openVariables = [], context = ^$ctx(errors += 'The element \'' + $pp.pointerValue + '\' can\'t be found' + $siCtx));,
                    | let element = $resolved->toOne();
                      ^ValueCompileResult(
                          values = [^meta::pure::metamodel::valuespecification::AtomicValue(
                              value = $element,
                              genericType = ^meta::pure::metamodel::type::generics::InferredGenericType(type = $element->type()),
                              multiplicity = meta::pure::metamodel::multiplicity::PureOne,
                              sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
                          )],
                          openVariables = []
                      );
                );,
              | let parserGT = $a.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
                let compiledGT = $parserGT->compileGenericType($ctx, '', []);
                let inferredGT = if($compiledGT.value->isEmpty() || $compiledGT.value->toOne()->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType),
                    | if($mGenType->isEmpty(), | ^meta::pure::metamodel::type::generics::UndefinedGenericType(), | $mGenType->toOne()),
                    | $compiledGT.value->toOne()
                );
                ^ValueCompileResult(
                    values = [^meta::pure::metamodel::valuespecification::AtomicValue(
                        value = $rawValue,
                        genericType = $inferredGT,
                        multiplicity = if($mMult->isEmpty(), | meta::pure::metamodel::multiplicity::PureOne, | $mMult->toOne()),
                        sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
                    )],
                    openVariables = []
                );
          )
    );
}

// ============================================================================
// VariableExpression compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileVariableExpression(v:meta::pure::protocol::grammar::valuespecification::VariableExpression[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]):ValueCompileResult[1]
{
    let inScope = $scope->filter(s | $s.name == $v.name);
    if($inScope->isEmpty(),
        | ^ValueCompileResult(
              values = [^meta::pure::metamodel::valuespecification::VariableExpression(
                  name = $v.name,
                  genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
                  multiplicity = meta::pure::metamodel::multiplicity::PureOne,
                  sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
              )],
              openVariables = []
          ),
        | let varGT = $inScope->at(0).genericType->toOne();
          let varMul = $inScope->at(0).multiplicity->toOne();
          ^ValueCompileResult(
              values = [^meta::pure::metamodel::valuespecification::VariableExpression(
                  name = $v.name,
                  genericType = asInferredGenericType($varGT),
                  multiplicity = asInferredMultiplicity($varMul),
                  sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
              )],
              openVariables = []
          );
    );
}

// ============================================================================
// FunctionInvocation compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileFunctionInvocation(fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]):ValueCompileResult[1]
{
    // Structural compilation only — function resolution happens in pass 3
    let paramsCompilation = $fi.parametersValues->map(p | $p->compileValueSpecification($ctx, $scope));
    let errorContexts = $paramsCompilation.context->filter(c | $c.errors->size() > $ctx.errors->size());
    if($errorContexts->isNotEmpty(),
        | ^ValueCompileResult(values = [], openVariables = [], context = $errorContexts->at($errorContexts->size() - 1)),
        | let paramValues = $paramsCompilation.values;
          let openVars = $paramsCompilation.openVariables->removeDuplicatesBy({ov| $ov.name->toOne()});
          ^ValueCompileResult(
              values = [^meta::pure::metamodel::valuespecification::FunctionInvocation(
                  functionName = $fi.functionName,
                  parametersValues = $paramValues->cast(@meta::pure::metamodel::valuespecification::ValueSpecification),
                  genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
                  multiplicity = meta::pure::metamodel::multiplicity::PureOne,
                  sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
              )],
              openVariables = $openVars
          );
    );
}

// ============================================================================
// ArrowInvocation compilation (same as FunctionInvocation but preserves type)
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileArrowInvocation(arrow:meta::pure::protocol::grammar::valuespecification::ArrowInvocation[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]):ValueCompileResult[1]
{
    // Structural compilation only — function resolution happens in pass 3
    let paramsCompilation = $arrow.parametersValues->map(p | $p->compileValueSpecification($ctx, $scope));
    let errorContexts = $paramsCompilation.context->filter(c | $c.errors->size() > $ctx.errors->size());
    if($errorContexts->isNotEmpty(),
        | ^ValueCompileResult(values = [], openVariables = [], context = $errorContexts->at($errorContexts->size() - 1)),
        | let paramValues = $paramsCompilation.values;
          let openVars = $paramsCompilation.openVariables->removeDuplicatesBy({ov| $ov.name->toOne()});
          ^ValueCompileResult(
              values = [^meta::pure::metamodel::valuespecification::FunctionInvocation(
                  functionName = $arrow.functionName,
                  parametersValues = $paramValues->cast(@meta::pure::metamodel::valuespecification::ValueSpecification),
                  genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
                  multiplicity = meta::pure::metamodel::multiplicity::PureOne,
                  sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
              )],
              openVariables = $openVars
          );
    );
}

// ============================================================================
// DotApplication compilation (pass 2 — structural only, resolution in pass 3)
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileDotApplication(dot:meta::pure::protocol::grammar::valuespecification::DotApplication[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]):ValueCompileResult[1]
{
    let paramResults = $dot.parametersValues->map(p | $p->compileValueSpecification($ctx, $scope));
    let compiledParams = $paramResults->filter(r | $r.values->isNotEmpty())->map(r | $r.values->at(0))->cast(@meta::pure::metamodel::valuespecification::ValueSpecification)->list();
    let newErrors = $paramResults.context->map(ec | $ec.errors)->filter(e | !$ctx.errors->contains($e));
    let updatedCtx = if($newErrors->isNotEmpty(), | ^$ctx(errors += $newErrors), | $ctx);

    let m3Dot = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::valuespecification::DotApplication)
    )->cast(@meta::pure::metamodel::valuespecification::DotApplication);
    ^ValueCompileResult(
        values = [^$m3Dot(
            functionName = $dot.functionName,
            parametersValues = $compiledParams.values,
            genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
            multiplicity = meta::pure::metamodel::multiplicity::PureOne,
            sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
        )],
        openVariables = $paramResults->map(r | $r.openVariables),
        context = $updatedCtx
    );
}

// ============================================================================
// Collection compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileCollection(c:meta::pure::protocol::grammar::valuespecification::Collection[1], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]):ValueCompileResult[1]
{
    let elemResults = $c.values->map(v | $v->compileValueSpecification($ctx, $scope));
    let newErrors = $elemResults.context->map(ec | $ec.errors)->filter(e | !$ctx.errors->contains($e));
    if($newErrors->isNotEmpty(),
        | ^ValueCompileResult(values = [], openVariables = [], context = ^$ctx(errors += $newErrors)),
        | let collMult = $c.multiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();
          let collGenType = if($c.genericType->isNotEmpty(),
              | $c.genericType->toOne()->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($ctx, '', []).value->toOne(),
              | ^meta::pure::metamodel::type::generics::UndefinedGenericType()
          );
          let compiledValues = $elemResults->filter(r | $r.values->isNotEmpty())->map(r | $r.values->at(0))->cast(@meta::pure::metamodel::valuespecification::ValueSpecification)->list();
          ^ValueCompileResult(
              values = [^meta::pure::metamodel::valuespecification::Collection(
                  values = $compiledValues.values,
                  genericType = $collGenType,
                  multiplicity = $collMult,
                  sourceInformation = $c.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
              )],
              openVariables = []
          );
    );
}

// ============================================================================
// GenericTypeAndMultiplicityHolder compilation
// ============================================================================

function meta::pure::compiler::structural::valueSpecificationCompiler::compileGenericTypeAndMultiplicityHolder(gmh:meta::pure::protocol::grammar::valuespecification::GenericTypeAndMultiplicityHolder[1], vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:meta::pure::compiler::CompilerContext[1]):ValueCompileResult[1]
{
    let heldGT = if($gmh.genericType->isNotEmpty(),
        | $gmh.genericType->toOne()->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($ctx, '', []).value->toOne(),
        | []->cast(@meta::pure::metamodel::type::generics::GenericType)
    );
    let heldMul = if($gmh.multiplicity->isNotEmpty(),
        | $gmh.multiplicity->toOne()->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity(),
        | []->cast(@meta::pure::metamodel::multiplicity::Multiplicity)
    );
    let classifierGT = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
        type = meta::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder,
        typeArguments = $heldGT,
        multiplicityArguments = $heldMul
    );
    let holder = meta::pure::functions::lang::new($classifierGT)->cast(@meta::pure::metamodel::valuespecification::UserDefinedGenericTypeAndMultiplicityHolder);
    let holderWithProps = ^$holder(
        genericType = $classifierGT,
        multiplicity = meta::pure::metamodel::multiplicity::PureOne,
        sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
    );
    ^ValueCompileResult(
        values = [$holderWithProps],
        openVariables = []
    );
}
