import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::class::*;
import meta::pure::compiler::*;


Class meta::pure::compiler::structural::valueSpecificationCompiler::SequenceCompileResult
{
    specs: meta::pure::metamodel::valuespecification::ValueSpecification[*];
    scope: meta::pure::metamodel::valuespecification::VariableExpression[*];
    openVariables: meta::pure::metamodel::valuespecification::VariableExpression[*];
    context: meta::pure::compiler::CompilerContext[0..1];
}

Class meta::pure::compiler::structural::valueSpecificationCompiler::ValueCompileResult
{
    values: meta::pure::metamodel::valuespecification::ValueSpecification[*];
    openVariables: meta::pure::metamodel::valuespecification::VariableExpression[*];
    context: meta::pure::compiler::CompilerContext[0..1];
}

function meta::pure::compiler::structural::valueSpecificationCompiler::compileExpressionSequence(expressions:meta::pure::protocol::grammar::valuespecification::ValueSpecification[*], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]): SequenceCompileResult[1]
{
    let result = fold($expressions, {expr, acc |
        let currentCtx = if($acc.context->isNotEmpty(), | $acc.context->toOne(), | $ctx);
        let m3ExprResult = $expr->compileValueSpecification($currentCtx, $acc.scope);
        let updatedCtx = if($m3ExprResult.context->isNotEmpty(), | $m3ExprResult.context, | $acc.context);

        if($m3ExprResult.values->isEmpty(),
            | ^SequenceCompileResult(
                  specs = $acc.specs,
                  scope = $acc.scope,
                  openVariables = $acc.openVariables,
                  context = $updatedCtx
              ),
            | let m3Expr = $m3ExprResult.values->at(0);
              let exprOpenVars = $m3ExprResult.openVariables;
              let newScope = match($expr, [
                  fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
                      if($fi.functionName == 'letFunction',
                          | let m3FI = $m3Expr->cast(@meta::pure::metamodel::valuespecification::FunctionInvocation);
                            let args = $m3FI.parametersValues;
                            let varName = $args->at(0)->cast(@meta::pure::metamodel::valuespecification::AtomicValue<String>).value->cast(@String);
                            let newVar = ^meta::pure::metamodel::valuespecification::VariableExpression(
                                name = $varName,
                                genericType = $m3FI.genericType,
                                multiplicity = $m3FI.multiplicity
                            );
                            $acc.scope->concatenate($newVar);,
                          | $acc.scope
                      ),
                  a:Any[1] | $acc.scope
              ]);
              ^SequenceCompileResult(
                  specs = $acc.specs->concatenate($m3Expr),
                  scope = $newScope,
                  openVariables = $acc.openVariables->concatenate($exprOpenVars)->removeDuplicatesBy({v | $v.name->toOne()}),
                  context = $updatedCtx
              );
        );
    }, ^SequenceCompileResult(specs=[], scope=$scope, openVariables=[]));
    $result;
}

function meta::pure::compiler::structural::valueSpecificationCompiler::compileValueSpecification(vs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[1], ctx:meta::pure::compiler::CompilerContext[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*]): ValueCompileResult[1]
{
    let mGenType = if($vs.genericType->isEmpty(), | [], | $vs.genericType->toOne()->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($ctx, '', []).value);
    let mMult = if($vs.multiplicity->isEmpty(), | [], | $vs.multiplicity->toOne()->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity());
    
    match($vs, [
        a:meta::pure::protocol::grammar::valuespecification::AtomicValue[1] |
            let rawValue = $a.value->toOne();
            if($rawValue->instanceOf(meta::pure::protocol::grammar::function::LambdaFunction),
                | let lambdaResult = $rawValue->cast(@meta::pure::protocol::grammar::function::LambdaFunction)->compileLambda($ctx, $scope, $mGenType, $mMult);
                  if($lambdaResult.values->isEmpty(),
                      | $lambdaResult,
                      | let compiledVal = $lambdaResult.values->at(0);
                        let inferredGT = if($mGenType->isEmpty(), | ^meta::pure::metamodel::type::generics::UndefinedGenericType(), | $mGenType->toOne());
                        ^ValueCompileResult(
                            values = [^meta::pure::metamodel::valuespecification::AtomicValue(
                                value = $compiledVal,
                                genericType = $inferredGT,
                                multiplicity = if($mMult->isEmpty(), | meta::pure::metamodel::multiplicity::PureOne, | $mMult->toOne()),
                                sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
                            )],
                            openVariables = $lambdaResult.openVariables,
                            context = $lambdaResult.context
                        );
                  );,
                | let literalGT = inferLiteralType($rawValue, $ctx);
                  println('  inferLiteralType: ' + $literalGT->type()->elementToPath() + ' mGenType: ' + if($mGenType->isEmpty(), |'EMPTY', | $mGenType->toOne()->type()->elementToPath()) + ' literalGT.type=' + if($literalGT->instanceOf(meta::pure::metamodel::type::generics::GenericTypeValue), | let t = $literalGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type; if($t->isEmpty(), |'NONE', | $t->toOne()->type()->elementToPath() + ':' + if($t->toOne()->instanceOf(meta::pure::metamodel::PackageableElement), | $t->toOne()->cast(@meta::pure::metamodel::PackageableElement)->fullPath(), | '?'));, |'not-GTV'));
                  let inferredGT = if($literalGT->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType),
                      | if($mGenType->isEmpty(), | $literalGT, | $mGenType->toOne()),
                      | $literalGT
                  );
                  ^ValueCompileResult(
                      values = [^meta::pure::metamodel::valuespecification::AtomicValue(
                          value = $rawValue,
                          genericType = $inferredGT,
                          multiplicity = if($mMult->isEmpty(), | meta::pure::metamodel::multiplicity::PureOne, | $mMult->toOne()),
                          sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
                      )],
                      openVariables = []
                  );
            );,
            
        v:meta::pure::protocol::grammar::valuespecification::VariableExpression[1] |
            let inScope = $scope->filter(s | $s.name == $v.name);
            // Use scoped variable type if available, otherwise use explicit type
            let varGT = if($inScope->isNotEmpty(),
                | $inScope->at(0).genericType->toOne(),
                | if($mGenType->isEmpty(), | ^meta::pure::metamodel::type::generics::UndefinedGenericType(), | $mGenType->toOne())
            );
            let varMul = if($inScope->isNotEmpty(),
                | $inScope->at(0).multiplicity->toOne(),
                | if($mMult->isEmpty(), | meta::pure::metamodel::multiplicity::PureOne, | $mMult->toOne())
            );
            // Wrap scoped types as inferred
            let inferredVarGT = asInferredGenericType($varGT);
            let inferredVarMul = asInferredMultiplicity($varMul);
            
            let m3Var = ^meta::pure::metamodel::valuespecification::VariableExpression(
                name = $v.name,
                genericType = $inferredVarGT,
                multiplicity = $inferredVarMul,
                sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
            );
            ^ValueCompileResult(
                values = [$m3Var],
                openVariables = if($inScope->isEmpty(), | [$m3Var], | [])
            );,
            
        fi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
            let paramsCompilation = $fi.parametersValues->map(p | $p->compileValueSpecification($ctx, $scope));
            let paramValues = $paramsCompilation.values;
            let openVars = $paramsCompilation.openVariables->removeDuplicatesBy({ov| $ov.name->toOne()});
            
            // Resolve function against the native function index
            let argTypes = $paramValues->map(pv | $pv.genericType->toOne());
            let argMuls = $paramValues->map(pv | $pv.multiplicity->toOne());
            let resolution = resolveFunctionInvocation($fi.functionName, $argTypes, $argMuls);
            
            let m3Fi = ^meta::pure::metamodel::valuespecification::FunctionInvocation(
                functionName = $resolution.resolvedName,
                parametersValues = $paramValues->cast(@meta::pure::metamodel::valuespecification::ValueSpecification),
                genericType = $resolution.returnGenericType,
                multiplicity = $resolution.returnMultiplicity,
                resolvedTypeParameters = $resolution.resolvedTypeParameters,
                resolvedMultiplicityParameters = $resolution.resolvedMultiplicityParameters,
                sourceInformation = $vs.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(sourceId=$si.sourceId, startLine=$si.startLine, startColumn=$si.startColumn, endLine=$si.endLine, endColumn=$si.endColumn))
            );
            
            ^ValueCompileResult(
                values = [$m3Fi],
                openVariables = $openVars
            );,
            
        l:meta::pure::protocol::grammar::function::LambdaFunction[1] |
            $l->compileLambda($ctx, $scope, $mGenType, $mMult),
            
        any:Any[1] |
            // Fallback for unsupported expression trees right now
            ^ValueCompileResult(
                values = [],
                openVariables = []
            )
    ]);
}
