import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::qualifiedPropertyCompiler::*;
import meta::pure::compiler::structural::annotationCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::*;

function meta::pure::compiler::structural::qualifiedPropertyCompiler::compileQualifiedProperty(qp:meta::pure::protocol::grammar::function::property::QualifiedProperty[1], context:meta::pure::compiler::CompilerContext[1], packagePath:String[1], owner:meta::pure::metamodel::type::Class<Any>[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::property::QualifiedProperty<Any>>[1]
{
    let className = if($packagePath == '', | $owner.name->toOne(), | $packagePath + '::' + $owner.name->toOne());
    let classCtx = 'class \'' + $className + '\'';

    // Compile return type
    let protocolType = $qp.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
    let gtResult = $protocolType->compileGenericType($context, $packagePath, $owner.typeParameters->cast(@meta::pure::metamodel::type::generics::TypeParameter), 'qualified property \'' + $qp.name + '\'', $classCtx);
    let returnGenType = $gtResult.value->toOne();
    let ctx1 = $gtResult.context;
    let returnMult = $qp.multiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();

    // Compile explicit parameters
    let paramAccum = $qp.parameters->fold({p, acc |
        let pType = $p.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
        let pGtResult = $pType->compileGenericType($acc.context, $packagePath, [], 'parameter \'' + $p.name + '\'', $classCtx);
        let pMult = $p.multiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();
        ^$acc(
            values += ^meta::pure::metamodel::valuespecification::VariableExpression(
                name = $p.name,
                genericType = $pGtResult.value->toOne(),
                multiplicity = $pMult
            ),
            context = $pGtResult.context
        );
    }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::valuespecification::VariableExpression>(context = $ctx1));
    let ctx2 = $paramAccum.context;

    // If type or parameter compilation produced errors, skip body compilation to avoid cascading errors
    if($ctx2.errors->size() > $context.errors->size(),
        | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::property::QualifiedProperty<Any>>(context = $ctx2),
        |

    // Prepend implicit $this parameter
    let ownerGenericType = $owner.classifierGenericType->toOne()->genericTypeTypeArguments()->at(0);
    let thisParam = ^meta::pure::metamodel::valuespecification::VariableExpression(
        name = 'this',
        genericType = $ownerGenericType,
        multiplicity = meta::pure::metamodel::multiplicity::PureOne
    );
    let allParams = $thisParam->concatenate($paramAccum.values);

    // Compile expression sequence
    let bodyResult = compileExpressionSequence($qp.expressionSequence, $ctx2, $allParams);
    let ctx3 = if($bodyResult.context->isNotEmpty(), | $bodyResult.context->toOne(), | $ctx2);

    // Build FunctionType and classifierGenericType
    let functionType = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::FunctionType)
    )->cast(@meta::pure::metamodel::type::FunctionType);
    let ft = ^$functionType(
        parameters = $allParams,
        returnType = $returnGenType,
        returnMultiplicity = $returnMult
    );
    let qpClassifierGT = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
        type = meta::pure::metamodel::function::property::QualifiedProperty,
        typeArguments = [
            ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = $ft)
        ]
    );

    let emptyQP = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::function::property::QualifiedProperty)
    )->cast(@meta::pure::metamodel::function::property::QualifiedProperty<Any>);
    // Compile stereotypes and tagged values
    let qpCtx = 'qualified property \'' + $qp.name + '\' in ' + $classCtx;
    let stereoAccum = $qp.stereotypes->fold({s, acc |
                                compileStereotype($s, $acc, $qpCtx);
                            }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::Stereotype>(context = $ctx3));
    let tvAccum = $qp.taggedValues->fold({t, acc |
                                compileTaggedValue($t, $acc, $qpCtx);
                            }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::TaggedValue>(context = $stereoAccum.context));

    let compiledQP = ^$emptyQP(
        name = $qp.name,
        genericType = $returnGenType,
        multiplicity = $returnMult,
        parameters = $allParams,
        stereotypes = $stereoAccum.values,
        taggedValues = $tvAccum.values,
        expressionSequence = $bodyResult.specs,
        classifierGenericType = $qpClassifierGT,
        sourceInformation = $qp.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
            sourceId = $si.sourceId,
            startLine = $si.startLine,
            startColumn = $si.startColumn,
            endLine = $si.endLine,
            endColumn = $si.endColumn
        ))
    );
    ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::property::QualifiedProperty<Any>>(
        value = $compiledQP,
        context = $ctx3
    );
    );
}

function meta::pure::compiler::structural::qualifiedPropertyCompiler::resolveQualifiedProperties(qualifiedProperties:meta::pure::metamodel::function::property::QualifiedProperty<Any>[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    $qualifiedProperties->fold({qp, qCtx |
        if($qp.expressionSequence->isEmpty(),
            | $qCtx,
            | let resolveResult = meta::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence(
                  $qp.expressionSequence,
                  $qp.parameters,
                  $qCtx
              );
              let ctx1 = $resolveResult.context;
              // Validate return type and multiplicity (only if resolution produced no new errors)
              if($ctx1.errors->size() > $qCtx.errors->size() || $resolveResult.resolvedSpecs->isEmpty(),
                  | $ctx1,
                  | let lastExpr = $resolveResult.resolvedSpecs->at($resolveResult.resolvedSpecs->size() - 1);
                    let qpName = $qp.name->toOne();
                    let siCtx = meta::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo($lastExpr.sourceInformation, $ctx1);
                    // Type validation
                    let ctx2 = if([pair(| $lastExpr.genericType->isEmpty() || $qp.genericType->isEmpty()
                                         || $lastExpr.genericType->toOne()->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType),
                                       | $ctx1),
                                  pair(| meta::pure::compiler::helper::genericType::isCompatibleGenericType($qp.genericType->toOne(), $lastExpr.genericType->toOne()),
                                       | $ctx1)],
                                 | ^$ctx1(errors += 'Return type error in qualified property \'' + $qpName + '\': expected ' + meta::pure::compiler::helper::genericType::printGenericType($qp.genericType->toOne()) + ', got ' + meta::pure::compiler::helper::genericType::printGenericType($lastExpr.genericType->toOne()) + $siCtx)
                    );
                    // Multiplicity validation
                    if([pair(| $lastExpr.multiplicity->isEmpty() || $qp.multiplicity->isEmpty(),
                             | $ctx2),
                        pair(| meta::pure::compiler::helper::multiplicity::isCompatibleMultiplicity($qp.multiplicity->toOne(), $lastExpr.multiplicity->toOne(), false),
                             | $ctx2)],
                       | ^$ctx2(errors += 'Return multiplicity error in qualified property \'' + $qpName + '\': expected ' + meta::pure::compiler::helper::multiplicity::printMultiplicity($qp.multiplicity->toOne()) + ', got ' + meta::pure::compiler::helper::multiplicity::printMultiplicity($lastExpr.multiplicity->toOne()) + $siCtx)
                    );
              );
        );
    }, $context);
}

function meta::pure::compiler::structural::qualifiedPropertyCompiler::validateQualifiedPropertyOverrides(cls:meta::pure::metamodel::type::Class<Any>[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    if($cls.qualifiedProperties->isEmpty() || $cls.generalizations->isEmpty(),
        | $context,
        | $cls.qualifiedProperties->fold({qp, qCtx |
              // Walk generalizations to find superclass QPs with same name
              $cls.generalizations->fold({gen, gCtx |
                  let superType = $gen.general;
                  if($superType->isEmpty(),
                      | $gCtx,
                      | match($superType->toOne(), [
                            gtv:meta::pure::metamodel::type::generics::GenericTypeValue[1] |
                                let superTypeValue = $gtv.type;
                                if($superTypeValue->isEmpty(),
                                    | $gCtx,
                                    | match($superTypeValue->toOne(), [
                                          superClass:meta::pure::metamodel::type::Class<Any>[1] |
                                              // Look up the fully compiled superclass from the context
                                              let resolvedSuper = $gCtx->resolveElement($superClass->meta::pure::functions::meta::elementToPath());
                                              let superQPs = if($resolvedSuper->isNotEmpty(),
                                                  | match($resolvedSuper->toOne(), [
                                                        sc:meta::pure::metamodel::type::Class<Any>[1] | $sc.qualifiedProperties->filter(sqp | $sqp.name == $qp.name && $sqp.parameters->size() == $qp.parameters->size()),
                                                        a:Any[1] | []
                                                    ]),
                                                  | []
                                              );
                                              if($superQPs->isEmpty(),
                                                  | $gCtx,
                                                  | let superProp = $superQPs->at(0);
                                                    let siCtx = meta::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo($qp.sourceInformation, $gCtx);
                                                    let clsName = $cls.name->toOne();
                                                    // Check return type covariance
                                                    let gCtx2 = if($qp.genericType->isNotEmpty() && $superProp.genericType->isNotEmpty()
                                                                    && !meta::pure::compiler::helper::genericType::isCompatibleGenericType($superProp.genericType->toOne(), $qp.genericType->toOne()),
                                                        | ^$gCtx(errors += 'Qualified property override variance mismatch for \'' + $qp.name->toOne() + '\' in class \'' + $clsName + '\'. Return type is not covariant. Overridden property has return type \'' + printGenericType($superProp.genericType->toOne()) + '\', but overriding property has return type \'' + printGenericType($qp.genericType->toOne()) + '\'.' + $siCtx),
                                                        | $gCtx
                                                    );
                                                    // Check return multiplicity subsumption
                                                    if($qp.multiplicity->isNotEmpty() && $superProp.multiplicity->isNotEmpty()
                                                        && !meta::pure::compiler::helper::multiplicity::multiplicitySubsumes($superProp.multiplicity->toOne(), $qp.multiplicity->toOne()),
                                                        | ^$gCtx2(errors += 'Qualified property override variance mismatch for \'' + $qp.name->toOne() + '\' in class \'' + $clsName + '\'. Return multiplicity is not subsumed. Overridden property has return multiplicity \'' + meta::pure::compiler::helper::multiplicity::printMultiplicity($superProp.multiplicity->toOne()) + '\', but overriding property has return multiplicity \'' + meta::pure::compiler::helper::multiplicity::printMultiplicity($qp.multiplicity->toOne()) + '\'.' + $siCtx),
                                                        | $gCtx2
                                                    );
                                              );,
                                          a:Any[1] | $gCtx
                                      ])
                                );,
                            a:Any[1] | $gCtx
                        ])
                  );
              }, $qCtx);
          }, $context)
    );
}
