import meta::pure::compiler::*;

function meta::pure::compiler::structural::sourceInformationCompiler::formatSourceInfo(si:meta::pure::protocol::grammar::SourceInformation[0..1], context:meta::pure::compiler::CompilerContext[1]):String[1]
{
    if($si->isEmpty(),
        | '',
        | let psi = $si->toOne();
          let sid = if($psi.sourceId->isNotEmpty(), | $psi.sourceId->toOne(), | if($context.sourceId->isNotEmpty(), | $context.sourceId->toOne(), | ''));
          if($sid->length() > 0,
              | ' (at ' + $sid + ' ' + $psi.startLine->toOne()->toString() + ':' + $psi.startColumn->toOne()->toString() + '-' + $psi.endLine->toOne()->toString() + ':' + $psi.endColumn->toOne()->toString() + ')',
              | ''
          );
    );
}
