import meta::pure::compiler::structural::multiplicityCompiler::*;

function meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity(m:meta::pure::protocol::grammar::multiplicity::Multiplicity_Protocol[1]):meta::pure::metamodel::multiplicity::Multiplicity[1]
{
    if($m->instanceOf(meta::pure::protocol::grammar::multiplicity::MultiplicityParameter),
        | ^meta::pure::metamodel::multiplicity::UserDefinedMultiplicityParameter(name = $m->cast(@meta::pure::protocol::grammar::multiplicity::MultiplicityParameter).name),
        | compileConcreteMultiplicity($m->cast(@meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity))
    );
}

function meta::pure::compiler::structural::multiplicityCompiler::compileConcreteMultiplicity(pMult:meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity[1]):meta::pure::metamodel::multiplicity::Multiplicity[1]
{
    if($pMult.upperBound->isEmpty(),
        | if($pMult.lowerBound.value == 0,
              | meta::pure::metamodel::multiplicity::ZeroMany,
              | meta::pure::metamodel::multiplicity::OneMany
          ),
        | let upper = $pMult.upperBound->toOne().value;
          if($pMult.lowerBound.value == 1 && $upper == 1,
              | meta::pure::metamodel::multiplicity::PureOne,
              | if($pMult.lowerBound.value == 0 && $upper == 1,
                    | meta::pure::metamodel::multiplicity::ZeroOne,
                    | ^meta::pure::metamodel::multiplicity::UserDefinedAdHocMultiplicity(
                          lowerBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $pMult.lowerBound.value),
                          upperBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $upper)
                      )
                )
          );
    );
}
