// ============================================================================
// Function resolution: resolve a FunctionInvocation using the native index
// ============================================================================

Class meta::pure::compiler::structural::functionResolution::FunctionResolutionResult
{
    resolvedFunction: meta::pure::metamodel::function::PackageableFunction<Any>[0..1];
    resolvedName: String[1];
    returnGenericType: meta::pure::metamodel::type::generics::GenericType[1];
    returnMultiplicity: meta::pure::metamodel::multiplicity::Multiplicity[1];
    bindings: ParametersBinding[1];
    resolvedTypeParameters: meta::pure::metamodel::type::generics::ResolvedTypeParameter[*];
    resolvedMultiplicityParameters: meta::pure::metamodel::type::generics::ResolvedMultiplicityParameter[*];
}

function meta::pure::compiler::structural::functionResolution::resolveFunctionInvocation(
    functionName:String[1], 
    argTypes:meta::pure::metamodel::type::generics::GenericType[*], 
    argMuls:meta::pure::metamodel::multiplicity::Multiplicity[*]
):FunctionResolutionResult[1]
{
    // Use the native function index to find candidates by short name + arity
    let candidates = meta::pure::compiler::findFunctionsByNameAndArity($functionName, $argTypes->size());
    
    let emptyResult = ^FunctionResolutionResult(
        resolvedName = $functionName,
        returnGenericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        returnMultiplicity = meta::pure::metamodel::multiplicity::PureOne,
        bindings = newPlainParametersBinding()
    );
    if($candidates->isEmpty(),
        | $emptyResult,
        | // Try each candidate — pick first that matches
          $candidates->fold({candidate, best |
              if($best.resolvedFunction->isNotEmpty(),
                  | $best,
                  | let ft = $candidate->getFunctionType();
                    let params = $ft.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression);
                    
                    // Collect bindings from arg types against param types
                    let bindings = range($argTypes->size())->fold({i, b |
                        let paramGT = $params->at($i).genericType->toOne();
                        let argGT = $argTypes->at($i);
                        let b2 = collectTypeParameterBindings($paramGT, $argGT, $b);
                        let paramMul = $params->at($i).multiplicity->toOne();
                        let argMul = $argMuls->at($i);
                        collectMultiplicityParameterBindings($paramMul, $argMul, $b2);
                    }, newPlainParametersBinding()->cast(@ParametersBinding));
                    
                    // Resolve return type using bindings
                    let returnGT = makeAsConcreteAsPossible($ft.returnType->toOne(), $bindings);
                    let returnMul = makeAsConcreteAsPossible($ft.returnMultiplicity->toOne(), $bindings);
                    
                    // Wrap as inferred
                    let inferredReturnGT = asInferredGenericType($returnGT);
                    let inferredReturnMul = asInferredMultiplicity($returnMul);
                    
                    // Build resolved type/multiplicity parameters
                    let resolvedTypeParams = $bindings.typeBindings->keys()->map(k |
                        let vals = $bindings.typeBindings->get($k)->toOne().values;
                        ^meta::pure::metamodel::type::generics::ResolvedTypeParameter(
                            name = $k,
                            value = asInferredGenericType($vals->at(0))
                        );
                    );
                    let resolvedMulParams = $bindings.multiplicityBindings->keys()->map(k |
                        let vals = $bindings.multiplicityBindings->get($k)->toOne().values;
                        ^meta::pure::metamodel::type::generics::ResolvedMultiplicityParameter(
                            name = $k,
                            value = asInferredMultiplicity($vals->at(0))
                        );
                    );

                    ^FunctionResolutionResult(
                        resolvedFunction = $candidate,
                        resolvedName = $candidate.name->toOne(),
                        returnGenericType = $inferredReturnGT,
                        returnMultiplicity = $inferredReturnMul,
                        bindings = $bindings,
                        resolvedTypeParameters = $resolvedTypeParams,
                        resolvedMultiplicityParameters = $resolvedMulParams
                    );
              );
          }, $emptyResult);
    );
}

// ============================================================================
// Inferred wrappers
// ============================================================================

function meta::pure::compiler::structural::functionResolution::asInferredGenericType(gt:meta::pure::metamodel::type::generics::GenericType[1]):meta::pure::metamodel::type::generics::GenericType[1]
{
    if($gt->instanceOf(meta::pure::metamodel::type::generics::InferredGenericType),
        | $gt,
        | $gt->match([
              gtv:meta::pure::metamodel::type::generics::GenericTypeValue[1] |
                  ^meta::pure::metamodel::type::generics::InferredGenericType(
                      type = $gtv.type,
                      typeArguments = $gtv.typeArguments,
                      multiplicityArguments = $gtv.multiplicityArguments
                  ),
              other:meta::pure::metamodel::type::generics::GenericType[1] | $gt
          ])
    );
}

function meta::pure::compiler::structural::functionResolution::asInferredMultiplicity(mul:meta::pure::metamodel::multiplicity::Multiplicity[1]):meta::pure::metamodel::multiplicity::Multiplicity[1]
{
    if($mul->instanceOf(meta::pure::metamodel::multiplicity::InferredAdHocMultiplicity),
        | $mul,
        | $mul->match([
              cm:meta::pure::metamodel::multiplicity::ConcreteMultiplicity[1] |
                  ^meta::pure::metamodel::multiplicity::InferredAdHocMultiplicity(
                      lowerBound = $cm.lowerBound,
                      upperBound = $cm.upperBound
                  ),
              other:meta::pure::metamodel::multiplicity::Multiplicity[1] | $mul
          ])
    );
}

// ============================================================================
// Literal type inference for AtomicValues
// ============================================================================

function meta::pure::compiler::structural::functionResolution::inferLiteralType(value:Any[1], ctx:meta::pure::compiler::CompilerContext[1]):meta::pure::metamodel::type::generics::GenericType[1]
{
    let pureName = $value->genericType().type->cast(@NamedType).name;
    if($pureName->isNotEmpty(),
        | ^meta::pure::metamodel::type::generics::InferredGenericType(type = $ctx->resolveElement($pureName->toOne())->toOne()->cast(@meta::pure::metamodel::type::Type)),
        | ^meta::pure::metamodel::type::generics::UndefinedGenericType()
    );
}
