import meta::pure::compiler::*;

function meta::pure::compiler::compileGenericType(protocolGT:meta::pure::protocol::grammar::type::generics::GenericTypeValue[1], context:meta::pure::compiler::CompilerContext[1], packagePath:String[1], typeParameters:meta::pure::metamodel::type::generics::TypeParameter[*]):meta::pure::metamodel::type::generics::GenericType[1]
{
    let protocolType = $protocolGT.type->toOne();
    let metamodelType = $protocolType->match([
        p:meta::pure::protocol::grammar::type::Type_Pointer[1] | 
            let resolvedOpt = $context->resolveElement($p.pointerValue);
            let resolvedOptWithPackage = if($resolvedOpt->isEmpty(),
                | $context->resolveElement($packagePath + '::' + $p.pointerValue),
                | $resolvedOpt
            );
            $resolvedOptWithPackage->toOne()->cast(@meta::pure::metamodel::type::Type);,
        t:meta::pure::protocol::grammar::type::generics::TypeParameter[1] |
            $typeParameters->filter(tp | $tp.name == $t.name)->toOne();
    ]);

    ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
        type = $metamodelType,
        typeArguments = $protocolGT.typeArguments->map(a | 
            $a->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->meta::pure::compiler::compileGenericType($context, $packagePath, $typeParameters)
        )
    );
}
