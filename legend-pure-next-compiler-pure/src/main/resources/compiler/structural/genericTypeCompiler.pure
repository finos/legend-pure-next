import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::structural::genericTypeCompiler::compileGenericType(protocolGT:meta::pure::protocol::grammar::type::generics::GenericTypeValue[1], context:meta::pure::compiler::CompilerContext[1], packagePath:String[1], typeParameters:meta::pure::metamodel::type::generics::TypeParameter[*]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::generics::GenericType>[1]
{
    compileGenericType($protocolGT, $context, $packagePath, $typeParameters, '', '');
}

function meta::pure::compiler::structural::genericTypeCompiler::compileGenericType(protocolGT:meta::pure::protocol::grammar::type::generics::GenericTypeValue[1], context:meta::pure::compiler::CompilerContext[1], packagePath:String[1], typeParameters:meta::pure::metamodel::type::generics::TypeParameter[*], elementContext:String[1], ownerContext:String[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::generics::GenericType>[1]
{
    let protocolType = $protocolGT.type->toOne();
    let result = $protocolType->match([
        p:meta::pure::protocol::grammar::type::Type_Pointer[1] |
            let allMatches = $context->resolveAllElements($p.pointerValue);
            let elemCtx = if($elementContext->length() > 0, | ' in ' + $elementContext, | '');
            let ownerCtx = if($ownerContext->length() > 0, | ' in ' + $ownerContext, | '');
            let siCtx = if($p.sourceInformation->isNotEmpty(),
                | formatSourceInfo($p.sourceInformation->cast(@meta::pure::protocol::grammar::SourceInformation), $context),
                | ''
            );
            if($allMatches->size() > 1,
                | let errorMsg = 'The element \'' + $p.pointerValue + '\' is ambiguous, found in multiple imports: ' + $allMatches->map(m | '\'' + $m + '\'')->joinStrings(', ') + $elemCtx + $ownerCtx + $siCtx;
                  ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::generics::GenericType>(
                      value = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::Any),
                      context = ^$context(errors += $errorMsg)
                  );,
                | let resolvedOpt = $context->resolveElement($p.pointerValue);
                  let resolvedOptWithPackage = if($resolvedOpt->isEmpty(),
                      | $context->resolveElement($packagePath + '::' + $p.pointerValue),
                      | $resolvedOpt
                  );
                  if($resolvedOptWithPackage->isEmpty(),
                      | let errorMsg = 'The type \'' + $p.pointerValue + '\' can\'t be found' + $elemCtx + $ownerCtx + $siCtx;
                        ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::generics::GenericType>(
                            value = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::Any),
                            context = ^$context(errors += $errorMsg)
                        );,
                      | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::generics::GenericType>(
                            value = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
                                type = $resolvedOptWithPackage->toOne()->cast(@meta::pure::metamodel::type::Type)
                            ),
                            context = $context
                        )
                  );
            );,
        t:meta::pure::protocol::grammar::type::generics::TypeParameter[1] |
            ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::generics::GenericType>(
                value = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
                    type = $typeParameters->filter(tp | $tp.name == $t.name)->toOne()
                ),
                context = $context
            );
    ]);

    let typeArgResult = $protocolGT.typeArguments->fold({a, acc |
        let argResult = $a->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($acc.context, $packagePath, $typeParameters, '', $ownerContext);
        ^$acc(values += $argResult.value, context = $argResult.context);
    }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::type::generics::GenericType>(context = $result.context));

    let resultValue = $result.value->toOne();
    ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::generics::GenericType>(
        value = ^$resultValue(typeArguments = $typeArgResult.values),
        context = $typeArgResult.context
    );
}
