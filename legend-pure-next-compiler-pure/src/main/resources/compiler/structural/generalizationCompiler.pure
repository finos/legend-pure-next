import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::structural::generalizationCompiler::compileGeneralizations(protocolGeneralizations:meta::pure::protocol::grammar::relationship::Generalization[*], skeleton:meta::pure::metamodel::type::Class<Any>[1], context:meta::pure::compiler::CompilerContext[1], packagePath:String[1], ownerContext:String[1]):meta::pure::compiler::CompilerListResult<meta::pure::metamodel::relationship::Generalization>[1]
{
    if($protocolGeneralizations->isEmpty(),
        | ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::relationship::Generalization>(
              values = [^meta::pure::metamodel::relationship::Generalization(
                  general = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::Any),
                  specific = $skeleton
              )],
              context = $context
          ),
        | $protocolGeneralizations->fold({g, acc |
              let gtResult = $g.general->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($acc.context, $packagePath, $skeleton.typeParameters->cast(@meta::pure::metamodel::type::generics::TypeParameter), 'super type', $ownerContext);
              ^$acc(
                  values += ^meta::pure::metamodel::relationship::Generalization(
                      general = $gtResult.value->toOne(),
                      specific = $skeleton
                  ),
                  context = $gtResult.context
              );
          }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::relationship::Generalization>(context = $context))
    );
}
