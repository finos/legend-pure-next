import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::helper::packageableElement::*;
import meta::pure::compiler::helper::function::*;
import meta::pure::compiler::helper::relationType::*;
import meta::pure::compiler::helper::column::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::compiler::helper::packageableFunction::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::lambda::*;
import meta::pure::compiler::helper::functionExpression::*;
import meta::pure::compiler::helper::variableExpression::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::functionType::*;
import meta::pure::compiler::helper::property::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::class::*;
import meta::pure::compiler::*;

function meta::pure::compiler::structural::propertyCompiler::compileProperty(protocolProperty:meta::pure::protocol::grammar::function::property::Property[1], context:meta::pure::compiler::CompilerContext[1], packagePath:String[1], owner:meta::pure::metamodel::type::Class<Any>[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::property::Property<Nil, Any|*>>[1]
{
    let protocolType = $protocolProperty.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
    let gtResult = $protocolType->compileGenericType($context, $packagePath, $owner.typeParameters->cast(@meta::pure::metamodel::type::generics::TypeParameter), 'property \'' + $protocolProperty.name + '\'', 'class \'' + $packagePath + '::' + $owner.name->toOne() + '\'');
    let mGenType = $gtResult.value->toOne();
    let updatedContext = $gtResult.context;

    if($updatedContext.errors->size() > $context.errors->size(),
        | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::property::Property<Nil, Any|*>>(context = $updatedContext),
        | let mMult = $protocolProperty.multiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();

          let propClassifierGT = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
              type = meta::pure::metamodel::function::property::Property,
              typeArguments = [
                  $owner.classifierGenericType->toOne()->genericTypeTypeArguments()->at(0),
                  $mGenType
              ],
              multiplicityArguments = [$mMult]
          );

          let prop = meta::pure::functions::lang::new($propClassifierGT)->cast(@meta::pure::metamodel::function::property::Property<Nil, Any|*>);
          let builtProp = ^$prop(
              name = $protocolProperty.name,
              aggregation = meta::pure::metamodel::function::property::AggregationKind.None,
              genericType = $mGenType,
              multiplicity = $mMult,
              sourceInformation = $protocolProperty.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
                  sourceId = $si.sourceId,
                  startLine = $si.startLine,
                  startColumn = $si.startColumn,
                  endLine = $si.endLine,
                  endColumn = $si.endColumn
              ))
          );
          let finalProp = if($protocolProperty.defaultValue->isEmpty(),
              | $builtProp,
              | let defaultLambda = $protocolProperty.defaultValue->toOne()->cast(@meta::pure::protocol::grammar::function::LambdaFunction);
                let defaultResult = $defaultLambda->compileLambda($updatedContext, [], [], []);
                if($defaultResult.values->isEmpty(),
                    | $builtProp,
                    | ^$builtProp(defaultValue = $defaultResult.values->at(0)->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->toOne()->cast(@meta::pure::metamodel::function::LambdaFunction<Any>))
                );
          );
          ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::property::Property<Nil, Any|*>>(
              value = $finalProp,
              context = $updatedContext
          );
    );
}

function meta::pure::compiler::structural::propertyCompiler::resolvePropertyDefaultValues(properties:meta::pure::metamodel::function::property::Property<Nil, Any|*>[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    $properties->fold({prop, pCtx |
        if($prop.defaultValue->isEmpty(),
            | $pCtx,
            | let siCtx = if($prop.sourceInformation->isEmpty(), | '', | meta::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo($prop.sourceInformation, $pCtx));
              // Validate: lower bound must be >= 1 for properties with defaults
              let lowerBound = meta::pure::compiler::helper::multiplicity::multiplicityLowerBound($prop.multiplicity->toOne());
              let ctx1 = if($lowerBound == 0,
                  | ^$pCtx(errors += 'Property with a default value cannot have a multiplicity with a lower bound of 0' + $siCtx),
                  | $pCtx
              );
              // Resolve the default value lambda
              let lambda = $prop.defaultValue->toOne()->cast(@meta::pure::metamodel::function::LambdaFunction<Any>);
              if($lambda.expressionSequence->isEmpty() || $ctx1.errors->size() > $pCtx.errors->size(),
                  | $ctx1,
                  | let resolveResult = meta::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence(
                        $lambda.expressionSequence,
                        $lambda.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression),
                        $ctx1
                    );
                    let ctx2 = $resolveResult.context;
                    // Validate type and multiplicity of the resolved default value
                    let lastExpr = $resolveResult.resolvedSpecs->at($resolveResult.resolvedSpecs->size() - 1);
                    // For Collections, compute the actual element type (resolver can't propagate it back)
                    let exprGT = if($lastExpr->instanceOf(meta::pure::metamodel::valuespecification::Collection) && $lastExpr->cast(@meta::pure::metamodel::valuespecification::Collection).values->isNotEmpty(),
                        | let elemTypes = $lastExpr->cast(@meta::pure::metamodel::valuespecification::Collection).values->map(v | $v.genericType)->filter(gt | $gt->isNotEmpty() && !$gt->toOne()->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType))->map(gt | $gt->toOne());
                          if($elemTypes->isNotEmpty(), | meta::pure::compiler::helper::genericType::findCommonGenericType($elemTypes), | $lastExpr.genericType);,
                        | $lastExpr.genericType
                    );
                    let ctx3 = if($exprGT->isEmpty() || $prop.genericType->isEmpty() || $exprGT->toOne()->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType),
                        | $ctx2,
                        | if(meta::pure::compiler::helper::genericType::isCompatibleGenericType($prop.genericType->toOne(), $exprGT->toOne()),
                              | $ctx2,
                              | ^$ctx2(errors += 'Default value type mismatch: expected ' + meta::pure::compiler::helper::genericType::printGenericType($prop.genericType->toOne()) + ' but got ' + meta::pure::compiler::helper::genericType::printGenericType($exprGT->toOne()) + $siCtx)
                          )
                    );
                    if($lastExpr.multiplicity->isEmpty() || $prop.multiplicity->isEmpty(),
                        | $ctx3,
                        | if(meta::pure::compiler::helper::multiplicity::isCompatibleMultiplicity($prop.multiplicity->toOne(), $lastExpr.multiplicity->toOne(), false),
                              | $ctx3,
                              | ^$ctx3(errors += 'Default value multiplicity mismatch: expected ' + meta::pure::compiler::helper::multiplicity::printMultiplicity($prop.multiplicity->toOne()) + ' but got ' + meta::pure::compiler::helper::multiplicity::printMultiplicity($lastExpr.multiplicity->toOne()) + $siCtx)
                          )
                    );
              );
        );
    }, $context);
}