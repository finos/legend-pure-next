import meta::pure::compiler::structural::functionTypeCompiler::*;

function meta::pure::compiler::structural::functionTypeCompiler::compileFunctionType(parameters:meta::pure::metamodel::valuespecification::VariableExpression[*], returnGenericType:meta::pure::metamodel::type::generics::GenericType[1], returnMultiplicity:Multiplicity[1]):meta::pure::metamodel::type::FunctionType[1]
{
    let functionType = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::FunctionType)
    )->cast(@meta::pure::metamodel::type::FunctionType);
    ^$functionType(
        parameters = $parameters,
        returnType = $returnGenericType,
        returnMultiplicity = $returnMultiplicity
    );
}
