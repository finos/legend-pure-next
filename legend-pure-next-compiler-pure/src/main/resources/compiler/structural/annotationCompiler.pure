import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::structural::annotationCompiler::compileStereotype(s:meta::pure::protocol::grammar::extension::Stereotype_Pointer[1], acc:meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::Stereotype>[1], ownerCtx:String[1]):meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::Stereotype>[1]
{
    let ctx = $acc.context;
    let profileOpt = $ctx->resolveElement($s.pointerValue);
    if($profileOpt->isEmpty(),
        | let siCtx = formatSourceInfo($s->cast(@meta::pure::protocol::grammar::type::Any).sourceInformation, $ctx);
          let newCtx = ^$ctx(errors += 'The profile \'' + $s.pointerValue + '\' can\'t be found in ' + $ownerCtx + $siCtx);
          ^$acc(context = $newCtx);,
        | let profile = $profileOpt->toOne()->cast(@meta::pure::metamodel::extension::Profile);
          let stereotypeName = $s.extraPointerValues->at(0).value;
          let matched = $profile.p_stereotypes->filter(x | $x.value == $stereotypeName);
          if($matched->isEmpty(),
              | let siCtx = formatSourceInfo($s.extraPointerValues->at(0).sourceInformation->cast(@meta::pure::protocol::grammar::SourceInformation), $ctx);
                let newCtx = ^$ctx(errors += 'The stereotype \'' + $stereotypeName + '\' can\'t be found in profile \'' + $s.pointerValue + '\' in ' + $ownerCtx + $siCtx);
                ^$acc(context = $newCtx);,
              | ^$acc(values += $matched->toOne())
          );
    );
}

function meta::pure::compiler::structural::annotationCompiler::compileTaggedValue(t:meta::pure::protocol::grammar::extension::TaggedValue[1], acc:meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::TaggedValue>[1], ownerCtx:String[1]):meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::TaggedValue>[1]
{
    let ctx = $acc.context;
    let profileOpt = $ctx->resolveElement($t.tag.pointerValue);
    if($profileOpt->isEmpty(),
        | $acc,
        | let profile = $profileOpt->toOne()->cast(@meta::pure::metamodel::extension::Profile);
          let tagName = $t.tag.extraPointerValues->at(0).value;
          let matched = $profile.p_tags->filter(x | $x.value == $tagName);
          if($matched->isEmpty(),
              | let siCtx = formatSourceInfo($t.tag.extraPointerValues->at(0).sourceInformation->cast(@meta::pure::protocol::grammar::SourceInformation), $ctx);
                let newCtx = ^$ctx(errors += 'The tag \'' + $tagName + '\' can\'t be found in profile \'' + $t.tag.pointerValue + '\' in ' + $ownerCtx + $siCtx);
                ^$acc(context = $newCtx);,
              | let tvGT = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::extension::TaggedValue);
                let inst = meta::pure::functions::lang::new($tvGT)->cast(@meta::pure::metamodel::extension::TaggedValue);
                ^$acc(values += ^$inst(tag = $matched->toOne(), value = $t.value));
          );
    );
}
