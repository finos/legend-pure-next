import meta::pure::compiler::structural::packageableFunctionCompiler::*;
import meta::pure::compiler::structural::functionTypeCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::structural::packageableFunctionCompiler::compileTypeParameters(typeParameters:meta::pure::protocol::grammar::type::generics::TypeParameter[*]):meta::pure::metamodel::type::generics::TypeParameter[*]
{
    $typeParameters->map(tp | ^meta::pure::metamodel::type::generics::TypeParameter(name = $tp.name, contravariant = false)->cast(@meta::pure::metamodel::type::generics::TypeParameter));
}

function meta::pure::compiler::structural::packageableFunctionCompiler::compileFunctionClassifierGenericType(functionMetaType:meta::pure::metamodel::type::Type[1], parameters:meta::pure::metamodel::valuespecification::VariableExpression[*], returnGenericType:meta::pure::metamodel::type::generics::GenericType[1], returnMultiplicity:Multiplicity[1]):meta::pure::metamodel::type::generics::UserDefinedGenericType[1]
{
    let funcType = compileFunctionType($parameters, $returnGenericType, $returnMultiplicity);
    ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
        type = $functionMetaType,
        typeArguments = [
            ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
                type = $funcType
            )
        ]
    );
}

function meta::pure::compiler::structural::packageableFunctionCompiler::validateDuplicateParameters(parameters:meta::pure::protocol::grammar::valuespecification::VariableExpression[*], context:meta::pure::compiler::CompilerContext[1], ownerCtx:String[1], siCtx:String[1]):meta::pure::compiler::CompilerContext[1]
{
    let dupNames = $parameters->map(p | $p.name)->filter(n | $parameters->filter(p | $p.name == $n)->size() > 1)->removeDuplicates();
    $dupNames->fold({d, c |
        ^$c(errors += 'Duplicate parameter name \'' + $d + '\' in ' + $ownerCtx + $siCtx);
    }, $context);
}

function meta::pure::compiler::structural::packageableFunctionCompiler::fullPath(fn:meta::pure::protocol::grammar::function::PackageableFunction[1]):String[1]
{
    let packagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().pointerValue);
    if($packagePath == '', | $fn.name, | $packagePath + '::' + $fn.name);
}
