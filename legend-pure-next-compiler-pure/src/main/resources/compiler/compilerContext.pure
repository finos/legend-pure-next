import meta::pure::compiler::helper::packageableElement::*;
import meta::pure::compiler::*;

Class meta::pure::compiler::DebugState
{
    debug : Boolean[1];
    space : String[1];
}

function meta::pure::compiler::debug(context:CompilerContext[1], fn:FunctionDefinition<{->String[1]}>[1]):Any[*]
{
    if($context.debugState.debug,
        | println($context.debugState.space + $fn->eval()),
        | []
    );
}

function meta::pure::compiler::debugSpaceInc(context:CompilerContext[1]):CompilerContext[1]
{
    let ds = $context.debugState;
    let newDs = ^$ds(space = $ds.space + '\t');
    ^$context(debugState = $newDs);
}

function meta::pure::compiler::debugSpaceDec(context:CompilerContext[1]):CompilerContext[1]
{
    let ds = $context.debugState;
    let newDs = ^$ds(space = $ds.space->substring(1));
    ^$context(debugState = $newDs);
}

Class meta::pure::compiler::CompilerContext
{
    debugState : DebugState[1];
    sourceId : String[0..1];
    imports : String[*];
    elementMap : Map<String, meta::pure::metamodel::PackageableElement>[1];
    errors : String[*];
    scopeTypeParams : String[*];
    scopeMulParams : String[*];
}

function meta::pure::compiler::errorCheckpoint(context:CompilerContext[1]):Integer[1]
{
    $context.errors->size();
}

function meta::pure::compiler::rollbackErrors(context:CompilerContext[1], checkpoint:Integer[1]):CompilerContext[1]
{
    ^$context(errors = $context.errors->take($checkpoint));
}

function meta::pure::compiler::snapshotErrors(context:CompilerContext[1], checkpoint:Integer[1]):String[*]
{
    $context.errors->drop($checkpoint);
}

Class meta::pure::compiler::CompilationResult
{
    elements : meta::pure::metamodel::PackageableElement[*];
    errors : String[*];
}

Class meta::pure::compiler::CompilerResult<T>
{
    value : T[0..1];
    context : CompilerContext[1];
}

Class meta::pure::compiler::CompilerListResult<T>
{
    values : T[*];
    context : CompilerContext[1];
}

native function meta::pure::compiler::findFunctionsByNameAndArity(name:String[1], arity:Integer[1]):meta::pure::metamodel::function::PackageableFunction<Any>[*];

function meta::pure::compiler::isElementVisible(context:CompilerContext[1], elementPath:String[1]):Boolean[1]
{
    if(!$elementPath->contains('::'),
        | true,
        | // Extract package path: everything before the last '::'
          let parts = $elementPath->split('::');
          let pkgPath = $parts->init()->joinStrings('::');
          $context.imports->exists(imp | $imp == $pkgPath);
    );
}

function meta::pure::compiler::findAllFunctionsByNameAndArity(context:CompilerContext[1], name:String[1], arity:Integer[1]):meta::pure::metamodel::function::PackageableFunction<Any>[*]
{
    let all = findAllFunctionsByNameAndArityUnfiltered($context, $name, $arity);
    $all->filter(f | $context->isElementVisible($f->elementToPath()));
}

function meta::pure::compiler::findAllFunctionsByNameAndArityUnfiltered(context:CompilerContext[1], name:String[1], arity:Integer[1]):meta::pure::metamodel::function::PackageableFunction<Any>[*]
{
    // Union: native index + locally-defined functions from context elementMap
    let nativeCandidates = findFunctionsByNameAndArity($name, $arity);
    let localCandidates = $context.elementMap->values()
        ->filter(e | $e->instanceOf(meta::pure::metamodel::function::PackageableFunction))
        ->cast(@meta::pure::metamodel::function::PackageableFunction<Any>)
        ->filter(f | $f.functionName->isNotEmpty() && ($f.functionName->toOne()->startsWith($name + '_') || $f.functionName == $name)
                     && $f.parameters->size() == $arity);
    $nativeCandidates->concatenate($localCandidates);
}

function meta::pure::compiler::resolveElement(context:CompilerContext[1], path:String[1]):meta::pure::metamodel::PackageableElement[0..1]
{
    let localResolution = $context.elementMap->get($path);
    if($localResolution->isNotEmpty(),
        | $localResolution,
        | let shortNameMatch = $context.elementMap->keys()->filter(k | $k->endsWith('::' + $path));
          if($shortNameMatch->isNotEmpty(),
              | $context.elementMap->get($shortNameMatch->at(0)),
              | let nativeAttempt = $path->lenientPathToElement();
                if($nativeAttempt->isNotEmpty(),
                    | $nativeAttempt,
                    | // Try resolving through imports (e.g., String -> meta::pure::metamodel::type::primitives::String)
                      let importMatch = $context.imports->map(imp | ($imp + '::' + $path)->lenientPathToElement())->filter(e | $e->isNotEmpty())->head();
                      if($importMatch->isNotEmpty(),
                          | $importMatch,
                          | ('meta::pure::metamodel::type::' + $path)->lenientPathToElement()
                      );
                );
          );
    );
}

function meta::pure::compiler::resolveAllElements(context:CompilerContext[1], path:String[1]):String[*]
{
    let localResolution = $context.elementMap->get($path);
    if($localResolution->isNotEmpty(),
        | [$path],
        | if($path->contains('::'),
              | if($path->lenientPathToElement()->isNotEmpty(), | [$path], | []),
              | let shortNameMatches = $context.elementMap->keys()->filter(k | $k->endsWith('::' + $path));
                let importMatches = $context.imports->map(imp | $imp + '::' + $path)->filter(candidate | $candidate->lenientPathToElement()->isNotEmpty());
                $importMatches->concatenate($shortNameMatches)->removeDuplicates();
          );
    );
}
