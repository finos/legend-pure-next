import meta::pure::metamodel::type::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::compiler::helper::enumeration::*;

function meta::pure::compiler::helper::enumeration::resolveEnumValue(enumeration:Enumeration<Any>[1], valueName:String[1]):Enum[0..1]
{
    let matched = $enumeration.properties->filter(p | $p.name == $valueName);
    if($matched->isEmpty(),
        | [],
        | let prop = $matched->toOne();
          if($prop.defaultValue->isEmpty(),
              | [],
              | let lambda = $prop.defaultValue->toOne()->cast(@LambdaFunction<Any>);
                if($lambda.expressionSequence->isEmpty(),
                    | [],
                    | let lastExpr = $lambda.expressionSequence->at($lambda.expressionSequence->size() - 1);
                      $lastExpr->match([
                          av : AtomicValue[1] |
                              if($av.value->isNotEmpty(),
                                  | $av.value->toOne()->match([
                                        e : Enum[1] | $e,
                                        other : Any[1] | []
                                    ]);,
                                  | []
                              );,
                          other : Any[1] | []
                      ]);
                );
          );
    );
}
