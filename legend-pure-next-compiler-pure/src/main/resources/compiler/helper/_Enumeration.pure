import meta::pure::compiler::helper::enumeration::*;

function meta::pure::compiler::helper::enumeration::resolveEnumValue(enumeration:meta::pure::metamodel::type::Enumeration<Any>[1], valueName:String[1]):meta::pure::metamodel::type::Enum[0..1]
{
    let matched = $enumeration.properties->filter(p | $p.name == $valueName);
    if($matched->isEmpty(),
        | [],
        | let prop = $matched->toOne();
          if($prop.defaultValue->isEmpty(),
              | [],
              | let lambda = $prop.defaultValue->toOne()->cast(@meta::pure::metamodel::function::LambdaFunction<Any>);
                if($lambda.expressionSequence->isEmpty(),
                    | [],
                    | let lastExpr = $lambda.expressionSequence->at($lambda.expressionSequence->size() - 1);
                      if($lastExpr->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue) && $lastExpr->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->isNotEmpty() && $lastExpr->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->toOne()->instanceOf(meta::pure::metamodel::type::Enum),
                          | $lastExpr->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->toOne()->cast(@meta::pure::metamodel::type::Enum),
                          | []
                      );
                );
          );
    );
}
