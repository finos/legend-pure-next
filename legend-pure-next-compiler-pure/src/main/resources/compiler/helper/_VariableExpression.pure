import meta::pure::metamodel::valuespecification::*;

function meta::pure::compiler::helper::newVariableExpression():VariableExpression[1]
{
    ^VariableExpression(
        name = '',
        genericType = ^meta::pure::metamodel::type::generics::InferredGenericType(type = Any),
        multiplicity = meta::pure::metamodel::multiplicity::PureOne,
        classifierGenericType = ^meta::pure::metamodel::type::generics::InferredGenericType(type = VariableExpression)
    )
}

function <<test.Test>> meta::pure::compiler::helper::tests::variableExpression::testNewVariableExpression():Boolean[1]
{
    let varExpr = meta::pure::compiler::helper::newVariableExpression();
    assert(meta::pure::compiler::helper::genericTypeRawType($varExpr.classifierGenericType->toOne())->toOne() == VariableExpression);
    true;
}
