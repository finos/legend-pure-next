function meta::pure::compiler::helper::variableExpression::newVariableExpression():VariableExpression[1]
{
    let ve = meta::pure::functions::lang::new(^meta::pure::metamodel::type::generics::InferredGenericType(type = VariableExpression))->cast(@VariableExpression);
    ^$ve(
        name = '',
        genericType = ^meta::pure::metamodel::type::generics::InferredGenericType(type = Any),
        multiplicity = meta::pure::metamodel::multiplicity::PureOne
    );
}

function <<test.Test>> meta::pure::compiler::helper::variableExpression::tests::testNewVariableExpression():Boolean[1]
{
    let varExpr = newVariableExpression();
    assert(genericTypeRawType($varExpr.classifierGenericType->toOne())->toOne() == VariableExpression);
    true;
}
