import meta::pure::compiler::helper::*;

// PackageableElement path helpers

function meta::pure::compiler::helper::fullPath(element:PackageableElement[1]):String[1]
{
    let pkg = $element.package;
    let name = $element.name->toOne();
    if($pkg->isEmpty(),
        | $name,
        | let pkgPath = $pkg->toOne()->packagePath();
          if($pkgPath == '',
              | $name,
              | $pkgPath + '::' + $name
          );
    );
}

function meta::pure::compiler::helper::packagePath(pkg:Package[1]):String[1]
{
    if($pkg.package->isEmpty() || $pkg.name->isEmpty(),
        | '',
        | let parentPath = $pkg.package->toOne()->packagePath();
          if($parentPath == '',
              | $pkg.name->toOne(),
              | $parentPath + '::' + $pkg.name->toOne()
          );
    );
}


// Tests

function <<test.Test>> meta::pure::compiler::helper::tests::packageableElement::testFullPath():Boolean[1]
{
    // Verify that fullPath returns a non-empty string for known types
    assert(Integer->fullPath()->length() > 0);
    assert(String->fullPath()->length() > 0);
    // Verify the name is part of the path
    assertEquals('Integer', Integer.name->toOne());
    assertEquals('String', String.name->toOne());
    // Verify that the path equals elementToPath
    assertEquals(Integer->elementToPath(), Integer->fullPath());
    assertEquals(String->elementToPath(), String->fullPath());
}
