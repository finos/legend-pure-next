// Function helpers

function meta::pure::compiler::helper::function::resolveFunctionType(genericType:GenericType[1]):FunctionType[0..1]
{
    let res = $genericType->resolveForTarget(Function);
    let rt = if($res->isNotEmpty(), | $res->toOne()->genericTypeTypeArguments(), | []);
    if($rt->isNotEmpty(),
       | $rt->at(0)->genericTypeRawType()->toOne()->cast(@FunctionType),
       | []
    );
}

function meta::pure::compiler::helper::function::getFunctionType(func:Function<Any>[1]):FunctionType[1]
{
    $func.classifierGenericType->toOne()->resolveFunctionType()->toOne()
}

function meta::pure::compiler::helper::function::validateFunctionParameters(params:VariableExpression[*]):Boolean[1]
{
    let allNames = $params.name;
    let duplicates = $allNames->filter(n | $allNames->filter(x | $x == $n)->size() > 1)->removeDuplicates();
    assert($duplicates->isEmpty(), | 'Duplicate parameter name(s): ' + $duplicates->joinStrings(', '));
    true;
}

// Tests

function <<test.Test>> meta::pure::compiler::helper::function::tests::testResolveFunctionType():Boolean[1]
{
    let lambda = {a:String[1]| $a + 'ok'};
    let cgt = $lambda->getLambdaClassifierGenericType();
    
    let ft = $cgt->resolveFunctionType()->toOne();
    
    assert($ft.parameters->isNotEmpty());
    assertEquals('a', $ft.parameters->at(0).name);
    assertEquals(String, $ft.parameters->at(0).genericType->toOne()->genericTypeRawType()->toOne());
}

function <<test.Test>> meta::pure::compiler::helper::function::tests::testGetFunctionType():Boolean[1]
{
    let func = meta::pure::compiler::helper::function::tests::testResolveFunctionType__Boolean_1_;
    let ft = $func->getFunctionType();
    
    assertEquals(Boolean, $ft.returnType->toOne()->genericTypeRawType()->toOne());
    assertEquals(1, $ft.returnMultiplicity->toOne()->multiplicityLowerBound());
}

function <<test.Test>> meta::pure::compiler::helper::function::tests::testValidateFunctionParameters():Boolean[1]
{
    let params = [
        ^VariableExpression(name='a', genericType=^meta::pure::metamodel::type::generics::InferredGenericType(type=String), multiplicity=PureOne),
        ^VariableExpression(name='b', genericType=^meta::pure::metamodel::type::generics::InferredGenericType(type=Integer), multiplicity=PureOne)
    ];
    assert(validateFunctionParameters($params));
}
