// Column helpers

function meta::pure::compiler::helper::column::buildColumn(name:String[1], owner:GenericType[1], genericType:GenericType[1], multiplicity:Multiplicity[1], nameWildCard:Boolean[1]):Column[1]
{
    let cgtype = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
        type = Column,
        typeArguments = [$owner, $genericType],
        multiplicityArguments = [$multiplicity]
    );

    let col = meta::pure::functions::lang::new($cgtype)->cast(@Column);
    ^$col(
        name = $name,
        nameWildCard = $nameWildCard,
        genericType = $genericType,
        multiplicity = $multiplicity
    );
}

// Tests

function <<test.Test>> meta::pure::compiler::helper::column::tests::testBuildColumn():Boolean[1]
{
    let ownerGT = ^meta::pure::metamodel::type::generics::InferredGenericType(type=String);
    let valueGT = ^meta::pure::metamodel::type::generics::InferredGenericType(type=Integer);
    let col = buildColumn('age', $ownerGT, $valueGT, PureOne, false);

    assertEquals('age', $col.name);
    assertEquals(false, $col.nameWildCard);
    assertEquals($valueGT, $col.genericType);
    assertEquals(PureOne, $col.multiplicity);
    
    let cgt = $col.classifierGenericType->toOne();
    assertEquals(Column, $cgt->genericTypeRawType()->toOne());
    
    let ta = $cgt->genericTypeTypeArguments();
    assertEquals(2, $ta->size());
    assertEquals($ownerGT, $ta->at(0));
    assertEquals($valueGT, $ta->at(1));
    
    let ma = $cgt->genericTypeMultiplicityArguments();
    assertEquals(1, $ma->size());
    assertEquals(PureOne, $ma->at(0));
}
