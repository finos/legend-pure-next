import meta::pure::metamodel::type::generics::*;
import meta::pure::functions::lang::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::property::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::class::*;

// Property helpers

function meta::pure::compiler::helper::property::resolveProperty(prop:Property<Nil,Any|*>[1], receiverType:GenericType[1]):Property<Nil,Any|*>[1]
{
    let resolvedGenericType = $prop.genericType;
    let resolvedMultiplicity = $prop.multiplicity;
    let resolvedClassifierGenericType = $prop.classifierGenericType;
    
    let resolvedTuple = $receiverType->genericTypeRawType()->toOne()->match(
        [
            ownerClass : Class<Any>[1] |
                let bindings = $ownerClass->buildBindingsFromGenericType($receiverType);
                if($bindings.typeBindings->isNotEmpty() || $bindings.multiplicityBindings->isNotEmpty(),
                    | pair(
                        $resolvedGenericType->makeAsConcreteAsPossible($bindings),
                        pair(
                            $resolvedMultiplicity->makeAsConcreteAsPossible($bindings),
                            $resolvedClassifierGenericType->toOne()->makeAsConcreteAsPossible($bindings)
                        )
                      ),
                    | pair($resolvedGenericType, pair($resolvedMultiplicity, $resolvedClassifierGenericType->toOne()))
                );,
            a : Any[1] | pair($resolvedGenericType, pair($resolvedMultiplicity, $resolvedClassifierGenericType->toOne()))
        ]
    );
    
    let resolvedProp = new($resolvedTuple.second.second)->cast(@Property<Nil,Any|*>);
    ^$resolvedProp(
        aggregation = AggregationKind.None,
        name = $prop.name,
        genericType = $resolvedTuple.first,
        multiplicity = $resolvedTuple.second.first,
        owner = $prop.owner
    );
}

// Tests

Class meta::pure::compiler::helper::property::tests::MyClass<T, U|m>
{
}

Class meta::pure::compiler::helper::property::tests::TestClass
{
    prop : meta::pure::compiler::helper::property::tests::MyClass<String, Integer | 1..*>[1];
}

function <<test.Test>> meta::pure::compiler::helper::property::tests::testResolveProperty():Boolean[1]
{
    let ownerClass = meta::pure::compiler::helper::property::tests::MyClass;
    let prop = meta::pure::compiler::helper::property::tests::TestClass.properties->filter(p | $p.name == 'prop')->toOne();
    let receiverType = $prop.genericType->toOne();
    
    let sourceProp = ^Property<Nil,Any|*>(
        aggregation = AggregationKind.None,
        name = 'mockProp',
        genericType = ^InferredGenericType(
            type = meta::pure::compiler::helper::property::tests::TestClass
        ),
        multiplicity = PureOne,
        owner = $ownerClass
    );

    // TODO: A more comprehensive test that has type parameter references inside the source prop
    let resolvedProp = resolveProperty($sourceProp, $receiverType);
    assertEquals('mockProp', $resolvedProp.name);
}
