// GenericType helpers

function meta::pure::compiler::helper::genericType::printGenericType(genericType:GenericType[1]):String[1]
{
    $genericType->printGenericType(true)
}

function meta::pure::compiler::helper::genericType::printGenericType(genericType:GenericType[1], fullPath:Boolean[1]):String[1]
{
    $genericType->match(
        [
            ns  : meta::pure::metamodel::type::generics::CompilerNotSetGenericType[1] | 'NotSet',
            ugt : UndefinedGenericType[1] | '?',
            gto : GenericTypeOperation[1] | $gto->printGenericTypeOperation($fullPath),
            gtv : GenericTypeValue[1]     | $gtv->printGenericTypeValue($fullPath),
            a   : Any[1]                  | if($genericType->genericTypeRawType()->isEmpty(),
                                               | 'Unknown',
                                               | $genericType->genericTypeRawType()->toOne()->cast(@PackageableElement).name->toOne()
                                                 + if($genericType->genericTypeTypeArguments()->isEmpty(),
                                                      | '',
                                                      | '<' + $genericType->genericTypeTypeArguments()->map(t | $t->printGenericType($fullPath))->joinStrings(', ') + '>'
                                                   )
                                            )
        ]
    )
}

function meta::pure::compiler::helper::genericType::printGenericTypeValue(gtv:GenericTypeValue[1], fullPath:Boolean[1]):String[1]
{
    let rawType = $gtv.type;
    if($rawType->isEmpty(),
        | 'Unknown',
        | let t = $rawType->toOne();
          if($t->instanceOf(TypeParameter),
              | let tpName = $t->cast(@TypeParameter).name;
                if($tpName->isEmpty(), | '?', | $tpName->toOne());,
              | let typeName = $t->match(
                    [
                        ft : FunctionType[1]       | $ft->printFunctionType($fullPath),
                        rt : meta::pure::metamodel::relation::RelationType<Any>[1] | $rt->printRelationType($fullPath),
                        pe : PackageableElement[1] |
                            if($fullPath,
                                | let pPath = $pe->fullPath();
                                  if($pPath->startsWith('meta::pure::metamodel::') || $pPath->startsWith('meta::pure::functions::'),
                                      | $pe.name->toOne(),
                                      | $pPath
                                  );,
                                | $pe.name->toOne()
                            ),
                        a  : Any[1]                | 'Unknown'
                    ]
                );
                let typeArgs = $gtv.typeArguments;
                let mulArgs = $gtv.multiplicityArguments;
                if($typeArgs->isEmpty() && $mulArgs->isEmpty(),
                    | $typeName,
                    | let typeArgStr = $typeArgs->map(a | $a->printGenericType($fullPath))->joinStrings(', ');
                      let mulArgStr = $mulArgs->map(m | '|' + $m->printMultiplicityBare())->joinStrings('');
                      $typeName + '<' + $typeArgStr + $mulArgStr + '>';
                );
          );
    );
}

function meta::pure::compiler::helper::genericType::printGenericTypeOperation(gto:GenericTypeOperation[1], fullPath:Boolean[1]):String[1]
{
    let left = $gto.left->printGenericType($fullPath);
    let opName = $gto.operationType->toString();
    let op = if($opName == 'Union', | '+',
             | if($opName == 'Difference', | '-',
               | if($opName == 'Equal', | '=', | '⊆')));
    let right = $gto.right->printGenericType($fullPath);
    $left + $op + $right;
}


// GenericType accessors

function meta::pure::compiler::helper::genericType::genericTypeTypeArguments(gt:GenericType[1]):GenericType[*]
{
    $gt->match(
        [
            gtv : GenericTypeValue[1] | $gtv.typeArguments,
            a   : Any[1]             | []
        ]
    )
}

function meta::pure::compiler::helper::genericType::genericTypeMultiplicityArguments(gt:GenericType[1]):Multiplicity[*]
{
    $gt->match(
        [
            gtv : GenericTypeValue[1] | $gtv.multiplicityArguments,
            a   : Any[1]             | []
        ]
    )
}


// GenericType concreteness

function meta::pure::compiler::helper::genericType::isConcreteGenericType(genericType:GenericType[1]):Boolean[1]
{
    $genericType->match(
        [
            ns  : meta::pure::metamodel::type::generics::CompilerNotSetGenericType[1] | false,
            ugt : UndefinedGenericType[1] | true,
            gto : GenericTypeOperation[1] | $gto->isConcreteGenericTypeOperation(),
            gtv : GenericTypeValue[1]     | $gtv->isConcreteGenericTypeValue(),
            a   : Any[1]                  | true
        ]
    );
}

function meta::pure::compiler::helper::genericType::isConcreteGenericTypeValue(gtv:GenericTypeValue[1]):Boolean[1]
{
    if($gtv.type->isEmpty(),
        | true,
        | let t = $gtv.type->toOne();
          if($t->instanceOf(TypeParameter),
              | false,
              | let ftCheck = $t->match(
                    [
                        ft : FunctionType[1] | $ft->isConcreteFunctionType(),
                        a  : Any[1]          | true
                    ]
                );
                if(!$ftCheck,
                    | false,
                    | $gtv.typeArguments->filter(arg | !$arg->isConcreteGenericType())->isEmpty()
                );
          );
    );
}

function meta::pure::compiler::helper::genericType::isConcreteGenericTypeOperation(gto:GenericTypeOperation[1]):Boolean[1]
{
    let opName = $gto.operationType->toString();
    if($opName == 'Subset' || $opName == 'Equal',
        | $gto.right->isConcreteGenericType(),
        | $gto.left->isConcreteGenericType() && $gto.right->isConcreteGenericType()
    );
}


// GenericType concreteness in context

function meta::pure::compiler::helper::genericType::isConcreteGenericTypeInContext(genericType:GenericType[1], scopeTypeParams:String[*]):Boolean[1]
{
    if($genericType->isConcreteGenericType(),
        | true,
        | let referencedParams = $genericType->collectReferencedTypeParameterNames();
          if($referencedParams->isEmpty(),
              | false,
              | $referencedParams->filter(n | $scopeTypeParams->filter(s | $s == $n)->isEmpty())->isEmpty()
          );
    )
}


// GenericType referenced parameter names

function meta::pure::compiler::helper::genericType::collectReferencedTypeParameterNames(genericType:GenericType[1]):String[*]
{
    $genericType->match(
        [
            ns  : meta::pure::metamodel::type::generics::CompilerNotSetGenericType[1] | [],
            ugt : UndefinedGenericType[1] | [],
            gto : GenericTypeOperation[1] |
                $gto.left->collectReferencedTypeParameterNames()
                    ->concatenate($gto.right->collectReferencedTypeParameterNames()),
            gtv : GenericTypeValue[1]     |
                let rawType = $gtv.type;
                let tpNames = if($rawType->isEmpty(),
                    | [],
                    | $rawType->toOne()->match(
                        [
                            tp : TypeParameter[1]  | $tp.name,
                            ft : FunctionType[1]   | $ft->collectFunctionTypeReferencedTypeParameterNames(),
                            a  : Any[1]            | []->cast(@String)
                        ]
                      )
                );
                let argNames = $gtv.typeArguments->map(a | $a->collectReferencedTypeParameterNames());
                $tpNames->concatenate($argNames)->removeDuplicates();,
            a   : Any[1] | []
        ]
    )
}

function meta::pure::compiler::helper::genericType::collectReferencedMultiplicityParameterNames(genericType:GenericType[1]):String[*]
{
    $genericType->match(
        [
            ns  : meta::pure::metamodel::type::generics::CompilerNotSetGenericType[1] | [],
            ugt : UndefinedGenericType[1] | [],
            gto : GenericTypeOperation[1] |
                $gto.left->collectReferencedMultiplicityParameterNames()
                    ->concatenate($gto.right->collectReferencedMultiplicityParameterNames()),
            gtv : GenericTypeValue[1]     |
                let rawType = $gtv.type;
                let ftNames = if($rawType->isEmpty(),
                    | [],
                    | $rawType->toOne()->match(
                        [
                            ft : FunctionType[1] | $ft->collectFunctionTypeReferencedMultiplicityParameterNames(),
                            a  : Any[1]          | []->cast(@String)
                        ]
                      )
                );
                let argNames = $gtv.typeArguments->map(a | $a->collectReferencedMultiplicityParameterNames());
                let mulArgNames = $gtv.multiplicityArguments->map(m |
                    $m->match(
                        [
                            mp : MultiplicityParameter[1] | $mp.name,
                            a  : Any[1]                   | []->cast(@String)
                        ]
                    )
                );
                $ftNames->concatenate($argNames)->concatenate($mulArgNames)->removeDuplicates();,
            a   : Any[1] | []
        ]
    )
}


// Tests

Class meta::pure::compiler::helper::genericType::tests::MyClass<T>
{
    tpProp: T[1];
    nestedTpProp: Class<T>[1];
}

Class meta::pure::compiler::helper::genericType::tests::TestClass
{
    intProp: Integer[1];
    strProp: String[1];
    listProp: Class<Integer>[1];
    myClassProp: meta::pure::compiler::helper::genericType::tests::MyClass<Integer>[1];
    classTpProp: Class<meta::pure::compiler::helper::genericType::tests::MyClass<String>>[1];
}

function meta::pure::compiler::helper::genericType::tests::getPropGT(name:String[1]):GenericType[1]
{
    let tc = meta::pure::compiler::helper::genericType::tests::TestClass;
    let prop = $tc.properties->filter(p | $p.name == $name)->toOne();
    $prop.genericType;
}

function meta::pure::compiler::helper::genericType::tests::getMyClassTpGT():GenericType[1]
{
    let mc = meta::pure::compiler::helper::genericType::tests::MyClass;
    let prop = $mc.properties->filter(p | $p.name == 'tpProp')->toOne();
    $prop.genericType;
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testPrintGenericTypeSimple():Boolean[1]
{
    let intGT = meta::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assertEquals('Integer', $intGT->printGenericType(true));
    assertEquals('Integer', $intGT->printGenericType(false));
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testPrintGenericTypeString():Boolean[1]
{
    let strGT = meta::pure::compiler::helper::genericType::tests::getPropGT('strProp');
    assertEquals('String', $strGT->printGenericType(false));
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testPrintGenericTypeUndefined():Boolean[1]
{
    let ugt = ^UndefinedGenericType();
    assertEquals('?', $ugt->printGenericType(false));
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testPrintGenericTypeTypeParameter():Boolean[1]
{
    let tpGT = meta::pure::compiler::helper::genericType::tests::getMyClassTpGT();
    let result = $tpGT->printGenericType(false);
    assert($result->length() > 0);
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testGenericTypeTypeArguments():Boolean[1]
{
    let listGT = meta::pure::compiler::helper::genericType::tests::getPropGT('listProp');
    assertEquals(1, $listGT->genericTypeTypeArguments()->size());
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testGenericTypeMultiplicityArguments():Boolean[1]
{
    let intGT = meta::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assert($intGT->genericTypeMultiplicityArguments()->isEmpty());
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testIsConcreteGenericType():Boolean[1]
{
    let intGT = meta::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assert($intGT->isConcreteGenericType());

    let tpGT = meta::pure::compiler::helper::genericType::tests::getMyClassTpGT();
    assertFalse($tpGT->isConcreteGenericType());

    let ugt = ^UndefinedGenericType();
    assert($ugt->isConcreteGenericType());
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testIsConcreteGenericTypeWithTypeArgs():Boolean[1]
{
    let classGT = meta::pure::compiler::helper::genericType::tests::getPropGT('listProp');
    assert($classGT->isConcreteGenericType());

    let tpClassProp = meta::pure::compiler::helper::genericType::tests::getPropGT('classTpProp');
    assert($tpClassProp->isConcreteGenericType());
    
    let mc = meta::pure::compiler::helper::genericType::tests::MyClass;
    let nPropGT = $mc.properties->filter(p | $p.name == 'nestedTpProp')->toOne().genericType;
    assertFalse($nPropGT->isConcreteGenericType());
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testCollectReferencedTypeParameterNames():Boolean[1]
{
    let intGT = meta::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assertEquals(0, $intGT->collectReferencedTypeParameterNames()->size());

    let tpGT = meta::pure::compiler::helper::genericType::tests::getMyClassTpGT();
    let names = $tpGT->collectReferencedTypeParameterNames();
    assertEquals(1, $names->size());
    assertEquals('T', $names->at(0));

    let myClassProp = meta::pure::compiler::helper::genericType::tests::getPropGT('myClassProp');
    assertEquals(0, $myClassProp->collectReferencedTypeParameterNames()->size());

    let mc = meta::pure::compiler::helper::genericType::tests::MyClass;
    let tpClassGT = $mc.properties->filter(p | $p.name == 'nestedTpProp')->toOne().genericType;
    let nestedNames = $tpClassGT->collectReferencedTypeParameterNames();
    assertEquals(1, $nestedNames->size());
    assertEquals('T', $nestedNames->at(0));

    let ugt = ^UndefinedGenericType();
    assertEquals(0, $ugt->collectReferencedTypeParameterNames()->size());
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testCollectReferencedMultiplicityParameterNames():Boolean[1]
{
    let intGT = meta::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assertEquals(0, $intGT->collectReferencedMultiplicityParameterNames()->size());

    let ugt = ^UndefinedGenericType();
    assertEquals(0, $ugt->collectReferencedMultiplicityParameterNames()->size());
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testIsConcreteGenericTypeInContext():Boolean[1]
{
    let intGT = meta::pure::compiler::helper::genericType::tests::getPropGT('intProp');
    assert($intGT->isConcreteGenericTypeInContext([]));

    let tpGT = meta::pure::compiler::helper::genericType::tests::getMyClassTpGT();
    assert($tpGT->isConcreteGenericTypeInContext(['T']));
    assertFalse($tpGT->isConcreteGenericTypeInContext([]));
    assertFalse($tpGT->isConcreteGenericTypeInContext(['V']));

    let mc = meta::pure::compiler::helper::genericType::tests::MyClass;
    let nestedTpProp = $mc.properties->filter(p | $p.name == 'nestedTpProp')->toOne().genericType;
    assert($nestedTpProp->isConcreteGenericTypeInContext(['T']));
    assertFalse($nestedTpProp->isConcreteGenericTypeInContext([]));
}

// ============================================================================
// findCommonGenericType tests
// ============================================================================

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testFindCommonGenericType_sameType():Boolean[1]
{
    let intGT1 = ^InferredGenericType(type = Integer);
    let intGT2 = ^InferredGenericType(type = Integer);
    let result = findCommonGenericType([$intGT1, $intGT2]);
    assert($result->isNotEmpty());
    assertEquals('Integer', $result->toOne()->printGenericType());
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testFindCommonGenericType_subtypes():Boolean[1]
{
    let intGT = ^InferredGenericType(type = Integer);
    let floatGT = ^InferredGenericType(type = Float);
    let result = findCommonGenericType([$intGT, $floatGT]);
    assert($result->isNotEmpty());
    assertEquals('Number', $result->toOne()->printGenericType());
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testFindCommonGenericType_lambdaWithSameFunctionType():Boolean[1]
{
    // LambdaFunction<{Integer[1]->Boolean[1]}> for both
    let ft = meta::pure::functions::lang::new(
        ^UserDefinedGenericType(type = FunctionType)
    )->cast(@FunctionType);
    let concretesFT = ^$ft(
        parameters = [^meta::pure::metamodel::valuespecification::VariableExpression(name='x', genericType=^InferredGenericType(type=Integer), multiplicity=PureOne)],
        returnType = ^InferredGenericType(type = Boolean),
        returnMultiplicity = PureOne
    );
    let lambdaGT1 = ^InferredGenericType(type = LambdaFunction, typeArguments = [^InferredGenericType(type = $concretesFT)]);
    let lambdaGT2 = ^InferredGenericType(type = LambdaFunction, typeArguments = [^InferredGenericType(type = $concretesFT)]);
    let result = findCommonGenericType([$lambdaGT1, $lambdaGT2]);
    assert($result->isNotEmpty());
    // The common type should preserve the FunctionType type argument
    let resultStr = $result->toOne()->printGenericType();
    assert($resultStr->startsWith('LambdaFunction'), | 'Expected LambdaFunction but got: ' + $resultStr);
    assert($resultStr->contains('Integer'), | 'Expected Integer in type args but got: ' + $resultStr);
    assert($resultStr->contains('Boolean'), | 'Expected Boolean in type args but got: ' + $resultStr);
}

function <<test.Test>> meta::pure::compiler::helper::genericType::tests::testFindCommonGenericType_lambdaWithDifferentFunctionTypeInstances():Boolean[1]
{
    // Two LambdaFunction<{Integer[1]->Integer[1]}> with DIFFERENT FunctionType objects
    let ft1 = meta::pure::functions::lang::new(
        ^UserDefinedGenericType(type = FunctionType)
    )->cast(@FunctionType);
    let concreteFT1 = ^$ft1(
        parameters = [^meta::pure::metamodel::valuespecification::VariableExpression(name='x', genericType=^InferredGenericType(type=Integer), multiplicity=PureOne)],
        returnType = ^InferredGenericType(type = Integer),
        returnMultiplicity = PureOne
    );
    let ft2 = meta::pure::functions::lang::new(
        ^UserDefinedGenericType(type = FunctionType)
    )->cast(@FunctionType);
    let concreteFT2 = ^$ft2(
        parameters = [^meta::pure::metamodel::valuespecification::VariableExpression(name='y', genericType=^InferredGenericType(type=Integer), multiplicity=PureOne)],
        returnType = ^InferredGenericType(type = Integer),
        returnMultiplicity = PureOne
    );
    let lambdaGT1 = ^InferredGenericType(type = LambdaFunction, typeArguments = [^InferredGenericType(type = $concreteFT1)]);
    let lambdaGT2 = ^InferredGenericType(type = LambdaFunction, typeArguments = [^InferredGenericType(type = $concreteFT2)]);
    let result = findCommonGenericType([$lambdaGT1, $lambdaGT2]);
    assert($result->isNotEmpty());
    let resultStr = $result->toOne()->printGenericType();
    // Should preserve the common FunctionType structure, not collapse to Any
    assert($resultStr->startsWith('LambdaFunction'), | 'Expected LambdaFunction but got: ' + $resultStr);
    assert($resultStr->contains('Integer'), | 'Expected Integer in type args but got: ' + $resultStr);
}

function meta::pure::compiler::helper::genericType::collectTypeParameterBindings(paramGT:GenericType[1], argGT:GenericType[1], bindings:ParametersBinding[1]):ParametersBinding[1]
{
    $paramGT->match([
        paramV : GenericTypeValue[1] |
            if($paramV.type->isEmpty(),
                | $bindings,
                | $paramV.type->toOne()->match([
                      tp : TypeParameter[1] |
                          $bindings->addTypeBinding($tp, $argGT),
                      otherParamType : Type[1] |
                          $argGT->match([
                              argV : GenericTypeValue[1] |
                                  let b1 = if($otherParamType->instanceOf(FunctionType) && $argV.type->isNotEmpty() && $argV.type->toOne()->instanceOf(FunctionType),
                                      | collectTypeParameterBindings($paramV.type->toOne()->cast(@FunctionType), $argV.type->toOne()->cast(@FunctionType), $bindings),
                                      | $bindings
                                  );
                                  // Recurse into RelationType columns for wildcard binding
                                  let b1rt = if($otherParamType->instanceOf(RelationType) && $argV.type->isNotEmpty() && $argV.type->toOne()->instanceOf(RelationType),
                                      | collectRelationTypeParameterBindings($otherParamType->cast(@RelationType<Any>), $argV.type->toOne()->cast(@RelationType<Any>), $b1),
                                      | $b1
                                  );
                                  
                                  // Recurse into type arguments positionally
                                  let b2 = if($paramV.typeArguments->isNotEmpty() && $argV.typeArguments->isNotEmpty(),
                                      | $paramV.typeArguments->zip($argV.typeArguments)->fold({pair, bb | collectTypeParameterBindings($pair.first, $pair.second, $bb)}, $b1rt),
                                      | $b1rt
                                  );
                                  
                                  // Recurse into multiplicity arguments positionally
                                  if($paramV.multiplicityArguments->isNotEmpty() && $argV.multiplicityArguments->isNotEmpty(),
                                      | $paramV.multiplicityArguments->zip($argV.multiplicityArguments)->fold({pair, bb | collectMultiplicityParameterBindings($pair.first, $pair.second, $bb)}, $b2),
                                      | $b2
                                  );,
                              otherArgGT: GenericType[1] | $bindings
                          ])
                  ])
            ),
        gto : GenericTypeOperation[1] |
            if($gto.operationType == GenericTypeOperationType.Subset,
                | collectTypeParameterBindings($gto.left, $argGT, $bindings),
                | if($gto.operationType == GenericTypeOperationType.Equal,
                      | let b1 = collectTypeParameterBindings($gto.left, $argGT, $bindings);
                        collectTypeParameterBindings($gto.right, $argGT, $b1);,
                      | $bindings
                  )
            ),
        otherParamGT : GenericType[1] | $bindings
    ])
}

function meta::pure::compiler::helper::genericType::resolveForTarget(sourceGenericType:GenericType[0..1], targetType:Type[1]):GenericType[0..1]
{
    if($sourceGenericType->isEmpty(),
        | [],
        | $sourceGenericType->toOne()->match([
              src : GenericTypeValue[1] | resolveForTarget_GenericTypeValue($src, $targetType),
              undefined: UndefinedGenericType[1] | [],
              other: GenericType[1] | []
          ])
    )
}

function meta::pure::compiler::helper::genericType::resolveForTarget_GenericTypeValue(src:GenericTypeValue[1], targetType:Type[1]):GenericType[0..1]
{
    if($src.type->isEmpty(),
        | [],
        | let sourceType = $src.type->toOne();
          if($sourceType == $targetType,
              | $src,
              | let initialBindings = newPlainParametersBinding();
                let typeB = if($sourceType->instanceOf(Class),
                    | $sourceType->cast(@Class<Any>).typeParameters->zip($src.typeArguments)->fold({pair, bb | $bb->addTypeBinding($pair.first, $pair.second)}, $initialBindings->cast(@ParametersBinding)),
                    | $initialBindings
                );
                let mulB = if($sourceType->instanceOf(Class) && $src.multiplicityArguments->isNotEmpty(),
                    | $sourceType->cast(@Class<Any>).multiplicityParameters->zip($src.multiplicityArguments)->fold({pair, bb | $bb->addMultiplicityBinding($pair.first, $pair.second)}, $typeB->cast(@ParametersBinding)),
                    | $typeB
                );
                
                let validGens = $sourceType.generalizations->filter(g | 
                    $g.general->instanceOf(GenericTypeValue) 
                    && $g.general->cast(@GenericTypeValue).type->isNotEmpty()
                    && $g.general->cast(@GenericTypeValue).type->toOne()->linearize()->contains($targetType)
                );
                if($validGens->isEmpty(),
                    | [],
                    | let resolvedGT = makeAsConcreteAsPossible($validGens->at(0).general, $mulB);
                      resolveForTarget($resolvedGT, $targetType);
                );
          );
    );
}

function meta::pure::compiler::helper::genericType::findCommonGenericType(genericTypes:GenericType[*]):GenericType[0..1]
{
    findCommonGenericType($genericTypes, false);
}

function meta::pure::compiler::helper::genericType::findCommonGenericType_Args(resultType:GenericType[1], projectedValues:GenericTypeValue[*], withArgs:GenericTypeValue[*], common:Type[1], contravariant:Boolean[1]):GenericType[1]
{
    if($withArgs->size() == $projectedValues->size() && $withArgs->isNotEmpty(),
        | let argCount = $withArgs->at(0).typeArguments->size();
          if($withArgs->forAll(gt | $gt.typeArguments->size() == $argCount) && $argCount > 0,
              | let typeParams = if($common->instanceOf(Class), | $common->cast(@Class<Any>).typeParameters, | []);
                let commonArgs = range($argCount)->map({i | 
                    let argsAtPos = $withArgs->map(gt | $gt.typeArguments->at($i));
                    let argContravariant = if($i < $typeParams->size() && $typeParams->at($i).contravariant == true, | !$contravariant, | $contravariant);
                    findCommonGenericType($argsAtPos, $argContravariant);
                })->filter(a | $a->isNotEmpty())->map(a | $a->toOne());
                
                if($commonArgs->size() == $argCount && $resultType->instanceOf(meta::pure::metamodel::type::generics::GenericTypeValue),
                    | let rtv = $resultType->cast(@meta::pure::metamodel::type::generics::GenericTypeValue);
                      ^$rtv(typeArguments = $commonArgs);,
                    | $resultType
                );,
              | $resultType
          );,
        | $resultType
    );
}

function meta::pure::compiler::helper::genericType::range(count:Integer[1]):Integer[*]
{
    range(0, $count);
}

function meta::pure::compiler::helper::genericType::range(start:Integer[1], end:Integer[1]):Integer[*]
{
    if($start == $end, | [], | $start->concatenate(range($start + 1, $end)));
}

function meta::pure::compiler::helper::genericType::findCommonGenericType(genericTypes:GenericType[*], contravariant:Boolean[1]):GenericType[0..1]
{
    if($genericTypes->isEmpty(),
        | ^meta::pure::metamodel::type::generics::InferredGenericType(type = Nil),
        | let nonNullValues = $genericTypes->filter(gt | $gt->instanceOf(GenericTypeValue))->cast(@GenericTypeValue);
          
          let firstName = if($nonNullValues->isNotEmpty() && $nonNullValues->at(0).type->isNotEmpty() && $nonNullValues->at(0).type->toOne()->instanceOf(TypeParameter),
              | $nonNullValues->at(0).type->toOne()->cast(@TypeParameter).name,
              | []
          );
          let allSameTp = if($firstName->isNotEmpty(),
              | $nonNullValues->forAll(gt | $gt.type->isNotEmpty() && $gt.type->toOne()->instanceOf(TypeParameter) && $gt.type->toOne()->cast(@TypeParameter).name == $firstName->toOne()),
              | false
          );
          if($allSameTp,
              | $nonNullValues->at(0),
              | let rawTypes = $nonNullValues->filter(gt | $gt.type->isNotEmpty() && !$gt.type->toOne()->instanceOf(TypeParameter))->map(gt | $gt.type->toOne());
                if($rawTypes->isEmpty(),
                    | [],
                    | // If all raw types are FunctionType instances, use structural unification (like Java lines 177-184)
                      let rawFunctionTypes = $rawTypes->filter(t | $t->instanceOf(FunctionType))->cast(@FunctionType);
                      if($rawFunctionTypes->size() == $rawTypes->size() && $rawFunctionTypes->isNotEmpty(),
                          | let common = findCommonFunctionType($rawFunctionTypes);
                            if($common->isNotEmpty(), | ^meta::pure::metamodel::type::generics::InferredGenericType(type = $common->toOne()), | []);,
                          |
                      let commonType = findCommonType($rawTypes, $contravariant);
                      if($commonType->isEmpty(),
                          | [],
                          | let common = $commonType->toOne();
                            let resultType = ^meta::pure::metamodel::type::generics::InferredGenericType(type = $common);
                            
                            let projected = if($rawTypes->forAll(t | $t == $common),
                                | $nonNullValues,
                                | $genericTypes->map(gt | resolveForTarget($gt, $common))->filter(p | $p->isNotEmpty())->map(p | $p->toOne())
                            );
                            
                            let projectedValues = $projected->filter(gt | $gt->instanceOf(GenericTypeValue))->cast(@GenericTypeValue);
                            let withArgs = $projectedValues->filter(gt | $gt.typeArguments->isNotEmpty());
                            
                            findCommonGenericType_Args($resultType, $projectedValues, $withArgs, $common, $contravariant);
                      );
                      ); // end FunctionType check
                );
          );
    );
}

function meta::pure::compiler::helper::genericType::makeAsConcreteAsPossible(genericType:GenericType[1], bindings:ParametersBinding[1]):GenericType[1]
{
    $genericType->match([
        ns : meta::pure::metamodel::type::generics::CompilerNotSetGenericType[1] | $genericType,
        undefined : UndefinedGenericType[1] | $genericType,
        gto : meta::pure::metamodel::relation::GenericTypeOperation[1] |
            let resolvedLeft = makeAsConcreteAsPossible($gto.left, $bindings);
            let resolvedRight = makeAsConcreteAsPossible($gto.right, $bindings);
            // If both sides are concrete RelationTypes, evaluate the operation (like Java _GenericTypeOperation.makeAsConcreteAsPossible)
            let evaluated = if($resolvedLeft->instanceOf(GenericTypeValue) && $resolvedLeft->cast(@GenericTypeValue).type->isNotEmpty() && $resolvedLeft->cast(@GenericTypeValue).type->toOne()->instanceOf(meta::pure::metamodel::relation::RelationType)
                               && $resolvedRight->instanceOf(GenericTypeValue) && $resolvedRight->cast(@GenericTypeValue).type->isNotEmpty() && $resolvedRight->cast(@GenericTypeValue).type->toOne()->instanceOf(meta::pure::metamodel::relation::RelationType),
                | let leftRT = $resolvedLeft->cast(@GenericTypeValue).type->toOne()->cast(@meta::pure::metamodel::relation::RelationType<Any>);
                  let rightRT = $resolvedRight->cast(@GenericTypeValue).type->toOne()->cast(@meta::pure::metamodel::relation::RelationType<Any>);
                  let result = evaluateRelationTypeOperation($leftRT, $rightRT, $gto.operationType);
                  if($result->isNotEmpty(), | ^meta::pure::metamodel::type::generics::InferredGenericType(type = $result->toOne()), | []);,
                | []
            );
            if($evaluated->isNotEmpty(),
                | $evaluated->toOne(),
                | if($resolvedLeft != $gto.left || $resolvedRight != $gto.right,
                      | ^$gto(left = $resolvedLeft, right = $resolvedRight),
                      | $genericType
                  )
            );,
        gtv : GenericTypeValue[1] |
            if($gtv.type->isNotEmpty() && $gtv.type->toOne()->instanceOf(TypeParameter),
                | let name = $gtv.type->toOne()->cast(@TypeParameter).name;
                  let boundTypes = $bindings.typeBindings->get($name);
                  if($boundTypes->isEmpty(),
                      | $genericType,
                      | if($boundTypes->toOne().values->size() == 1,
                            | $boundTypes->toOne().values->at(0),
                            | let common = findCommonGenericType($boundTypes->toOne().values);
                              if($common->isEmpty(), | $genericType, | $common->toOne());
                        )
                  );,
                | let ftResolved = if($gtv.type->isNotEmpty() && $gtv.type->toOne()->instanceOf(FunctionType),
                      | makeAsConcreteAsPossible($genericType, $gtv.type->toOne()->cast(@FunctionType), $bindings),
                      | []
                  );
                  // RelationType inference: resolve column types/multiplicities
                  let rtResolved = if($gtv.type->isNotEmpty() && $gtv.type->toOne()->instanceOf(RelationType),
                      | makeRelationTypeAsConcreteAsPossible($gtv.type->toOne()->cast(@RelationType<Any>), $bindings),
                      | []
                  );
                  if($ftResolved->isNotEmpty(),
                      | $ftResolved->toOne(),
                      | if($rtResolved->isNotEmpty(),
                            | $rtResolved->toOne(),
                            | let typeArgsResolved = $gtv.typeArguments->map(a | makeAsConcreteAsPossible($a, $bindings));
                              let mulArgsResolved = $gtv.multiplicityArguments->map(m | makeAsConcreteAsPossible($m, $bindings));
                              if($typeArgsResolved == $gtv.typeArguments && $mulArgsResolved == $gtv.multiplicityArguments,
                                  | $genericType,
                                  | ^$gtv(typeArguments = $typeArgsResolved, multiplicityArguments = $mulArgsResolved)
                              );
                        )
                  );
            );,
        gto : GenericTypeOperation[1] |
            let resolvedLeft = makeAsConcreteAsPossible($gto.left, $bindings);
            let resolvedRight = makeAsConcreteAsPossible($gto.right, $bindings);
            // If both sides are concrete RelationTypes, evaluate the operation
            if($resolvedLeft->instanceOf(GenericTypeValue) && $resolvedLeft->cast(@GenericTypeValue).type->isNotEmpty() && $resolvedLeft->cast(@GenericTypeValue).type->toOne()->instanceOf(RelationType)
               && $resolvedRight->instanceOf(GenericTypeValue) && $resolvedRight->cast(@GenericTypeValue).type->isNotEmpty() && $resolvedRight->cast(@GenericTypeValue).type->toOne()->instanceOf(RelationType),
                | let resultRT = evaluateRelationTypeOperation(
                      $resolvedLeft->cast(@GenericTypeValue).type->toOne()->cast(@RelationType<Any>),
                      $resolvedRight->cast(@GenericTypeValue).type->toOne()->cast(@RelationType<Any>),
                      $gto.operationType
                  );
                  if($resultRT->isEmpty(),
                      | $genericType,
                      | ^meta::pure::metamodel::type::generics::InferredGenericType(type = $resultRT->toOne())
                  );,
                | if($resolvedLeft != $gto.left || $resolvedRight != $gto.right,
                      | ^$gto(left = $resolvedLeft, right = $resolvedRight),
                      | $genericType
                  )
            );,
        other : GenericType[1] | $genericType
    ])
}

function meta::pure::compiler::helper::genericType::isCompatibleGenericType(declared:GenericType[1], actual:GenericType[1]):Boolean[1]
{
    isCompatibleGenericType($declared, $actual, false);
}

function meta::pure::compiler::helper::genericType::isCompatibleGenericType(declared:GenericType[1], actual:GenericType[1], contravariant:Boolean[1]):Boolean[1]
{
    // GenericTypeOperation dispatch
    if($declared->instanceOf(GenericTypeOperation),
        | isCompatibleGenericTypeOperation($declared->cast(@GenericTypeOperation), $actual, $contravariant),
        | if($actual->instanceOf(GenericTypeOperation),
              | isCompatibleGenericTypeOperation($actual->cast(@GenericTypeOperation), $declared, !$contravariant),
              | // CompilerNotSetGenericType — not set yet, skip compatibility check
                if($declared->instanceOf(meta::pure::metamodel::type::generics::CompilerNotSetGenericType) || $actual->instanceOf(meta::pure::metamodel::type::generics::CompilerNotSetGenericType),
                    | true,
                    | // UndefinedGenericType matches only other UndefinedGenericType
                      if($declared->instanceOf(UndefinedGenericType) || $actual->instanceOf(UndefinedGenericType),
                          | $declared->instanceOf(UndefinedGenericType) && $actual->instanceOf(UndefinedGenericType),
                          | isCompatibleGenericTypeValue($declared->cast(@GenericTypeValue), $actual->cast(@GenericTypeValue), $contravariant)
                      )
                )
          )
    );
}

function meta::pure::compiler::helper::genericType::isCompatibleGenericTypeValue(declared:GenericTypeValue[1], actual:GenericTypeValue[1], contravariant:Boolean[1]):Boolean[1]
{
    // Unresolved type parameters — assume compatible
    if($declared.type->isEmpty() || $actual.type->isEmpty(),
        | true,
        | let declaredType = $declared.type->toOne();
          let actualType = $actual.type->toOne();
          
          // TypeParameter compatibility
          if($declaredType->instanceOf(TypeParameter),
              | if($actualType->instanceOf(TypeParameter),
                    | $declaredType->cast(@TypeParameter).name == $actualType->cast(@TypeParameter).name,
                    | true
                ),
              | if($actualType->instanceOf(TypeParameter),
                    | true,
                    | // FunctionTypes are structural
                      if($declaredType->instanceOf(FunctionType) && $actualType->instanceOf(FunctionType),
                          | isCompatibleFunctionType($declaredType->cast(@FunctionType), $actualType->cast(@FunctionType), $contravariant),
                          | // RelationTypes are structural
                            if($declaredType->instanceOf(RelationType) && $actualType->instanceOf(RelationType),
                                | isCompatibleRelationType($declaredType->cast(@RelationType<Any>), $actualType->cast(@RelationType<Any>), $contravariant),
                                | isCompatibleGenericTypeValue_rawCheck($declared, $actual, $declaredType, $actualType, $contravariant)
                            )
                      )
                )
          );
    );
}

function meta::pure::compiler::helper::genericType::isCompatibleGenericTypeValue_rawCheck(declared:GenericTypeValue[1], actual:GenericTypeValue[1], declaredType:Type[1], actualType:Type[1], contravariant:Boolean[1]):Boolean[1]
{
    if($contravariant && $actualType->isBottomType(),
        | true,
        | let rawCompatible = if(!$contravariant,
              | $actualType->subtypeOf($declaredType),
              | $declaredType->subtypeOf($actualType)
          );
          if(!$rawCompatible,
              | false,
              | let resolvedActual = if($declaredType != $actualType,
                    | resolveForTarget($actual, $declaredType),
                    | $actual
                );
                if($resolvedActual->isEmpty(),
                    | true,
                    | isCompatibleGenericTypeValue_args($declared, $resolvedActual->toOne(), $declaredType, $contravariant)
                );
          );
    );
}

function meta::pure::compiler::helper::genericType::isCompatibleGenericTypeValue_args(declared:GenericTypeValue[1], resolvedActual:GenericType[1], declaredType:Type[1], contravariant:Boolean[1]):Boolean[1]
{
    let typeArgsOk = if($resolvedActual->instanceOf(GenericTypeValue) && $declared.typeArguments->isNotEmpty() && $resolvedActual->cast(@GenericTypeValue).typeArguments->isNotEmpty(),
        | let resolvedActualV = $resolvedActual->cast(@GenericTypeValue);
          if($declared.typeArguments->size() != $resolvedActualV.typeArguments->size(),
              | false,
              | let typeParams = if($declaredType->instanceOf(Class), | $declaredType->cast(@Class<Any>).typeParameters, | []);
                range($declared.typeArguments->size())->forAll({i |
                    let argContravariant = if($i < $typeParams->size() && $typeParams->at($i).contravariant == true, | !$contravariant, | $contravariant);
                    isCompatibleGenericType($declared.typeArguments->at($i), $resolvedActualV.typeArguments->at($i), $argContravariant);
                });
          );,
        | true
    );
    
    if(!$typeArgsOk,
        | false,
        | // Check multiplicity arguments
          if($declared.multiplicityArguments->isNotEmpty() && $resolvedActual->instanceOf(GenericTypeValue) && $resolvedActual->cast(@GenericTypeValue).multiplicityArguments->isNotEmpty(),
              | let actualMulArgs = $resolvedActual->cast(@GenericTypeValue).multiplicityArguments;
                if($declared.multiplicityArguments->size() != $actualMulArgs->size(),
                    | false,
                    | $declared.multiplicityArguments->zip($actualMulArgs)->forAll({pair |
                          multiplicitySubsumes($pair.first, $pair.second);
                      })
                );,
              | true
          )
    );
}

function meta::pure::compiler::helper::genericType::isCompatibleGenericTypeOperation(gto:GenericTypeOperation[1], other:GenericType[1], contravariant:Boolean[1]):Boolean[1]
{
    let right = $gto.right;
    if($gto.operationType == GenericTypeOperationType.Equal,
        | isCompatibleGenericType($right, $other, $contravariant),
        | if($gto.operationType == GenericTypeOperationType.Subset,
              | isCompatibleGenericType($other, $right, $contravariant),
              | true
          )
    );
}

function meta::pure::compiler::helper::genericType::asInferredGenericType(gt:meta::pure::metamodel::type::generics::GenericType[1]):meta::pure::metamodel::type::generics::GenericType[1]
{
    if($gt->instanceOf(meta::pure::metamodel::type::generics::InferredGenericType),
        | $gt,
        | $gt->match([
              gtv:meta::pure::metamodel::type::generics::GenericTypeValue[1] |
                  ^meta::pure::metamodel::type::generics::InferredGenericType(
                      type = $gtv.type,
                      typeArguments = $gtv.typeArguments,
                      multiplicityArguments = $gtv.multiplicityArguments
                  ),
              other:meta::pure::metamodel::type::generics::GenericType[1] | $gt
          ])
    );
}

function meta::pure::compiler::helper::genericType::inferLiteralType(value:Any[1], ctx:meta::pure::compiler::CompilerContext[1]):meta::pure::metamodel::type::generics::GenericType[1]
{
    let pureName = $value->genericType().type->cast(@NamedType).name;
    if($pureName->isNotEmpty(),
        | let resolved = $ctx->resolveElement($pureName->toOne())->toOne()->cast(@meta::pure::metamodel::type::Type);
          ^meta::pure::metamodel::type::generics::InferredGenericType(type = $resolved);,
        | ^meta::pure::metamodel::type::generics::UndefinedGenericType()
    );
}
