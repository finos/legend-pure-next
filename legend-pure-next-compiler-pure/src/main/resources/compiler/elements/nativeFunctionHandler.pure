import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::functionResolution::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::elements::compileNativeFunctionPass1(fn:meta::pure::protocol::grammar::function::NativeFunction[1], ctx:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    let packagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().pointerValue);
    
    let mangledName = $fn.name;
    let fName = if($packagePath == '', | $mangledName, | [$packagePath, '::', $mangledName]->joinStrings(''));
    
    let rootPkg = ^meta::pure::metamodel::Package(name = 'Root');
    let emptyFunc = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::function::NativeFunction)
    )->cast(@meta::pure::metamodel::function::NativeFunction<Any>);
    
    let skeleton = ^$emptyFunc(
        name = $mangledName,
        functionName = $fn.name,
        package = ^meta::pure::metamodel::Package(name = $packagePath, package = $rootPkg),
        sourceInformation = $fn.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
            sourceId = $si.sourceId,
            startLine = $si.startLine,
            startColumn = $si.startColumn,
            endLine = $si.endLine,
            endColumn = $si.endColumn
        ))
    );
    
    ^$ctx(elementMap=$ctx.elementMap->put($fName, $skeleton));
}

function meta::pure::compiler::elements::compileNativeFunctionPass2(fn:meta::pure::protocol::grammar::function::NativeFunction[1], ctx:meta::pure::compiler::CompilerContext[1]):meta::pure::metamodel::function::NativeFunction<Any>[1]
{
    let packagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().pointerValue);
    
    let mangledName = $fn.name;
    let fName = if($packagePath == '', | $mangledName, | [$packagePath, '::', $mangledName]->joinStrings(''));
    
    let skeleton = $ctx.elementMap->get($fName)->toOne()->cast(@meta::pure::metamodel::function::NativeFunction<Any>);
    
    // Compile parameters
    let compiledParams = $fn.parameters->map(p | 
        let pType = $p.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
        let mGenType = $pType->compileGenericType($ctx, $packagePath, []).value->toOne();
        
        let pMult = $p.multiplicity->cast(@meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity);
        let mMult = if($pMult.upperBound->isEmpty(),
                        | if($pMult.lowerBound.value == 0,
                              | meta::pure::metamodel::multiplicity::ZeroMany,
                              | meta::pure::metamodel::multiplicity::OneMany
                          ),
                        | let upper = $pMult.upperBound->toOne().value;
                          if($pMult.lowerBound.value == 1 && $upper == 1,
                              | meta::pure::metamodel::multiplicity::PureOne,
                              | if($pMult.lowerBound.value == 0 && $upper == 1,
                                    | meta::pure::metamodel::multiplicity::ZeroOne,
                                    | ^meta::pure::metamodel::multiplicity::UserDefinedAdHocMultiplicity(
                                          lowerBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $pMult.lowerBound.value),
                                          upperBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $upper)
                                      )
                                )
                          );
                    );
                    
        ^meta::pure::metamodel::valuespecification::VariableExpression(
            name = $p.name,
            genericType = $mGenType,
            multiplicity = $mMult
        );
    );
    
    // Compile return type
    let rTypeStr = $fn.returnGenericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
    let rMGenType = $rTypeStr->compileGenericType($ctx, $packagePath, []).value->toOne();
    
    let rPMult = $fn.returnMultiplicity->cast(@meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity);
    let rMMult = if($rPMult.upperBound->isEmpty(),
                    | if($rPMult.lowerBound.value == 0,
                          | meta::pure::metamodel::multiplicity::ZeroMany,
                          | meta::pure::metamodel::multiplicity::OneMany
                      ),
                    | let upper = $rPMult.upperBound->toOne().value;
                      if($rPMult.lowerBound.value == 1 && $upper == 1,
                          | meta::pure::metamodel::multiplicity::PureOne,
                          | if($rPMult.lowerBound.value == 0 && $upper == 1,
                                | meta::pure::metamodel::multiplicity::ZeroOne,
                                | ^meta::pure::metamodel::multiplicity::UserDefinedAdHocMultiplicity(
                                      lowerBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $rPMult.lowerBound.value),
                                      upperBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $upper)
                                  )
                            )
                      );
                );

    // Compute FunctionType
    let functionType = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::FunctionType)
    )->cast(@meta::pure::metamodel::type::FunctionType);
    
    let populatedFunctionType = ^$functionType(
        parameters = $compiledParams,
        returnType = $rMGenType,
        returnMultiplicity = $rMMult
    );
    
    // Assign proper classifier generic type
    ^$skeleton(
        parameters = $compiledParams,
        returnGenericType = $rMGenType,
        returnMultiplicity = $rMMult,
        classifierGenericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
            type = meta::pure::metamodel::function::NativeFunction,
            typeArguments = [
                ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
                    type = $populatedFunctionType
                )
            ]
        )
    );
}
