import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::generalizationCompiler::*;
import meta::pure::compiler::structural::constraintCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::elements::compilePrimitive(protocolPrimitive:meta::pure::protocol::grammar::type::PrimitiveType[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::PrimitiveType>[1]
{
    let packagePath = if($protocolPrimitive.package->isEmpty(), | '', | $protocolPrimitive.package->toOne().pointerValue);
    let primitiveName = if($packagePath == '', | $protocolPrimitive.name, | $packagePath + '::' + $protocolPrimitive.name);
    let skeleton = $context->resolveElement($primitiveName)->toOne()->cast(@meta::pure::metamodel::type::PrimitiveType);
    let ownerCtx = 'primitive type \'' + $primitiveName + '\'';

    let genAccum = compileGeneralizations($protocolPrimitive.generalizations, $skeleton, $context, $packagePath, $ownerCtx);
    let ctx1 = $genAccum.context;

    let typeVariables = if($protocolPrimitive.typeVariables->isEmpty(), | [],
        | $protocolPrimitive.typeVariables->map(tv |
            let genType = $tv.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue).type->toOne()->cast(@meta::pure::protocol::grammar::type::Type_Pointer).pointerValue;
            let mMult = $tv.multiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();
            ^meta::pure::metamodel::valuespecification::VariableExpression(
                name = $tv.name,
                genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = $ctx1->resolveElement($genType)->toOne()->cast(@meta::pure::metamodel::type::Type)),
                multiplicity = $mMult
            );
        )
    );

    // Build the compiled type with generalizations first, so constraints see the full type
    let compiledPrim = ^$skeleton(
        typeVariables = $typeVariables,
        generalizations = $genAccum.values->map(g | ^$g(specific = ~.~))
    );
    let ownerGenericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = $compiledPrim);
    let constraintAccum = compileConstraints($protocolPrimitive.constraints, $ownerGenericType, $typeVariables, $ctx1);
    let ctx2 = $constraintAccum.context;

    ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::PrimitiveType>(
        value = ^$compiledPrim(
            constraints = $constraintAccum.values
        ),
        context = $ctx2
    );
}
