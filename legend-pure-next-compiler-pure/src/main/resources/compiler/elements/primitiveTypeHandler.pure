import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::functionResolution::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::elements::compilePrimitive(protocolPrimitive:meta::pure::protocol::grammar::type::PrimitiveType[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::metamodel::type::PrimitiveType[1]
{
    let packagePath = $protocolPrimitive.package->toOne().pointerValue;
    let primitiveName = $packagePath + '::' + $protocolPrimitive.name;
    let skeleton = $context->resolveElement($primitiveName)->toOne()->cast(@meta::pure::metamodel::type::PrimitiveType);

    let typeVariables = if($protocolPrimitive.typeVariables->isEmpty(), | [], 
        | $protocolPrimitive.typeVariables->map(tv | 
            let genType = $tv.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue).type->toOne()->cast(@meta::pure::protocol::grammar::type::Type_Pointer).pointerValue;
            let pMult = $tv.multiplicity->cast(@meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity);
            let mMult = if($pMult.upperBound->isEmpty(),
                            | if($pMult.lowerBound.value == 0,
                                  | meta::pure::metamodel::multiplicity::ZeroMany,
                                  | meta::pure::metamodel::multiplicity::OneMany
                              ),
                            | let upper = $pMult.upperBound->toOne().value;
                              if($pMult.lowerBound.value == 1 && $upper == 1,
                                  | meta::pure::metamodel::multiplicity::PureOne,
                                  | if($pMult.lowerBound.value == 0 && $upper == 1,
                                        | meta::pure::metamodel::multiplicity::ZeroOne,
                                        | ^meta::pure::metamodel::multiplicity::UserDefinedAdHocMultiplicity(
                                              lowerBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $pMult.lowerBound.value),
                                              upperBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $upper)
                                          )
                                    )
                              );
                        );
            ^meta::pure::metamodel::valuespecification::VariableExpression(
                name = $tv.name,
                genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = $context->resolveElement($genType)->toOne()->cast(@meta::pure::metamodel::type::Type)),
                multiplicity = $mMult
            );
        )
    );

    // Enrich skeleton from pass 1 with compiled type variables
    ^$skeleton(
        typeVariables = $typeVariables
    );
}
