import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::resolution::functionDefinitionResolver::*;
import meta::pure::compiler::*;

function meta::pure::compiler::elements::compileFunctionDefinitionPass1(fn:meta::pure::protocol::grammar::function::UserDefinedFunction[1], ctx:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    let packagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().pointerValue);
    
    let mangledName = $fn.name;
    let fName = if($packagePath == '', | $mangledName, | [$packagePath, '::', $mangledName]->joinStrings(''));
    
    let rootPkg = ^meta::pure::metamodel::Package(name = 'Root');
    let emptyFunc = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::function::UserDefinedFunction)
    )->cast(@meta::pure::metamodel::function::UserDefinedFunction<Any>);
    
    let skeleton = ^$emptyFunc(
        name = $mangledName,
        functionName = $fn.name,
        package = ^meta::pure::metamodel::Package(name = $packagePath, package = $rootPkg),
        sourceInformation = $fn.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
            sourceId = $si.sourceId,
            startLine = $si.startLine,
            startColumn = $si.startColumn,
            endLine = $si.endLine,
            endColumn = $si.endColumn
        ))
    );
    
    ^$ctx(elementMap=$ctx.elementMap->put($fName, $skeleton));
}

function meta::pure::compiler::elements::compileFunctionDefinitionPass2(fn:meta::pure::protocol::grammar::function::UserDefinedFunction[1], ctx:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::UserDefinedFunction<Any>>[1]
{
    let packagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().pointerValue);
    let mangledName = $fn.name;
    let fName = if($packagePath == '', | $mangledName, | [$packagePath, '::', $mangledName]->joinStrings(''));
    let skeleton = $ctx.elementMap->get($fName)->toOne()->cast(@meta::pure::metamodel::function::UserDefinedFunction<Any>);
    let ownerCtx = 'function \'' + $fName + '\'';
    let siCtx = if($fn.sourceInformation->isNotEmpty(), | formatSourceInfo($fn.sourceInformation->toOne()->cast(@meta::pure::protocol::grammar::SourceInformation), $ctx), | '');

    // Check for duplicate parameter names
    let dupNames = $fn.parameters->map(p | $p.name)->filter(n | $fn.parameters->filter(p | $p.name == $n)->size() > 1)->removeDuplicates();
    let ctx1 = $dupNames->fold({d, c |
        ^$c(errors += 'Duplicate parameter name \'' + $d + '\' in ' + $ownerCtx + $siCtx);
    }, $ctx);

    // Compile parameters with context threading
    let paramAccum = $fn.parameters->fold({p, acc |
        let pType = $p.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
        let gtResult = $pType->compileGenericType($acc.context, $packagePath, [], 'parameter \'' + $p.name + '\'', $ownerCtx);
        let mMult = $p.multiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();
        ^$acc(
            values += ^meta::pure::metamodel::valuespecification::VariableExpression(
                name = $p.name,
                genericType = $gtResult.value->toOne(),
                multiplicity = $mMult
            ),
            context = $gtResult.context
        );
    }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::valuespecification::VariableExpression>(context = $ctx1));
    let compiledParams = $paramAccum.values;
    let ctx2 = $paramAccum.context;

    // Compile return type
    let rType = $fn.returnGenericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
    let rResult = $rType->compileGenericType($ctx2, $packagePath, []);
    let rGenType = $rResult.value->toOne();
    let ctx3 = $rResult.context;

    let rMMult = $fn.returnMultiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();

    let functionType = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::FunctionType)
    )->cast(@meta::pure::metamodel::type::FunctionType);
    let funcType = ^$functionType(
        parameters = $compiledParams,
        returnType = $rGenType,
        returnMultiplicity = $rMMult
    );
    let finalGenType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
        type = meta::pure::metamodel::function::UserDefinedFunction,
        typeArguments = [
            ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
                type = $funcType
            )
        ]
    );

    let bodyResult = compileExpressionSequence($fn.expressionSequence, $ctx3, $compiledParams);
    let ctx4 = if($bodyResult.context->isNotEmpty(), | $bodyResult.context->toOne(), | $ctx3);
    let ctx5 = meta::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence($bodyResult.specs, $compiledParams, $ctx4);

    ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::UserDefinedFunction<Any>>(
        value = ^$skeleton(
            parameters = $compiledParams,
            returnGenericType = $rGenType,
            returnMultiplicity = $rMMult,
            classifierGenericType = $finalGenType,
            expressionSequence = $bodyResult.specs
        ),
        context = $ctx5
    );
}
