import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::functionTypeCompiler::*;
import meta::pure::compiler::structural::packageableFunctionCompiler::*;
import meta::pure::compiler::structural::variableCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::structural::annotationCompiler::*;
import meta::pure::compiler::structural::constraintCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::elements::compileUserDefinedFunctionPass1(fn:meta::pure::protocol::grammar::function::UserDefinedFunction[1], ctx:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    let packagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().pointerValue);

    let mangledName = $fn.name;
    let fName = if($packagePath == '', | $mangledName, | [$packagePath, '::', $mangledName]->joinStrings(''));

    let rootPkg = ^meta::pure::metamodel::Package(name = 'Root');
    let emptyFunc = meta::pure::functions::lang::new(
        ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::function::UserDefinedFunction)
    )->cast(@meta::pure::metamodel::function::UserDefinedFunction<Any>);

    let skeleton = ^$emptyFunc(
        name = $mangledName,
        functionName = $fn.name,
        package = ^meta::pure::metamodel::Package(name = $packagePath, package = $rootPkg),
        sourceInformation = $fn.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
            sourceId = $si.sourceId,
            startLine = $si.startLine,
            startColumn = $si.startColumn,
            endLine = $si.endLine,
            endColumn = $si.endColumn
        ))
    );

    ^$ctx(elementMap=$ctx.elementMap->put($fName, $skeleton));
}

function meta::pure::compiler::elements::compileUserDefinedFunctionPass2(fn:meta::pure::protocol::grammar::function::UserDefinedFunction[1], ctx:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::UserDefinedFunction<Any>>[1]
{
    let packagePath = if($fn.package->isEmpty(), | '', | $fn.package->toOne().pointerValue);
    let mangledName = $fn.name;
    let fName = if($packagePath == '', | $mangledName, | [$packagePath, '::', $mangledName]->joinStrings(''));
    let skeleton = $ctx.elementMap->get($fName)->toOne()->cast(@meta::pure::metamodel::function::UserDefinedFunction<Any>);
    let ownerCtx = 'function \'' + $fName + '\'';
    let siCtx = if($fn.sourceInformation->isNotEmpty(), | formatSourceInfo($fn.sourceInformation->toOne()->cast(@meta::pure::protocol::grammar::SourceInformation), $ctx), | '');

    // Check for duplicate parameter names
    let ctx1 = validateDuplicateParameters($fn.parameters, $ctx, $ownerCtx, $siCtx);

    // Compile type parameters and register them in the context (matches Java setEnclosingOwner)
    let fnTypeParams = compileTypeParameters($fn.typeParameters);
    let ctx1b = ^$ctx1(ownerTypeParams = $fnTypeParams);

    // Compile parameters
    let paramAccum = compileParameters($fn.parameters, $ctx1b, $packagePath, $fnTypeParams, $ownerCtx);
    let compiledParams = $paramAccum.values;
    let ctx2 = $paramAccum.context;

    // Compile return type
    let rType = $fn.returnGenericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue);
    let rResult = $rType->compileGenericType($ctx2, $packagePath, $fnTypeParams);
    let rGenType = $rResult.value->toOne();
    let ctx3 = $rResult.context;

    let rMMult = $fn.returnMultiplicity->meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity();

    let finalGenType = compileFunctionClassifierGenericType(meta::pure::metamodel::function::UserDefinedFunction, $compiledParams, $rGenType, $rMMult);

    let bodyResult = compileExpressionSequence($fn.expressionSequence, $ctx3, $compiledParams);
    let ctx4 = if($bodyResult.context->isNotEmpty(), | $bodyResult.context->toOne(), | $ctx3);

    // Compile stereotypes and tagged values
    let stereoAccum = $fn.stereotypes->fold({s, acc |
                                compileStereotype($s, $acc, $ownerCtx);
                            }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::Stereotype>(context = $ctx4));
    let tvAccum = $fn.taggedValues->fold({t, acc |
                                compileTaggedValue($t, $acc, $ownerCtx);
                            }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::TaggedValue>(context = $stereoAccum.context));
    let ctx5 = $tvAccum.context;

    // Compile pre-constraints (scope: function parameters)
    let preConstraintAccum = compileFunctionConstraints($fn.preConstraints, $compiledParams, $ctx5);
    let ctx6 = $preConstraintAccum.context;

    // Compile post-constraints (scope: function parameters + $return)
    let returnVar = ^meta::pure::metamodel::valuespecification::VariableExpression(
        name = 'return',
        genericType = $rGenType,
        multiplicity = $rMMult
    );
    let postConstraintAccum = compileFunctionConstraints($fn.postConstraints, $compiledParams->concatenate($returnVar), $ctx6);
    let ctx7 = $postConstraintAccum.context;

    ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::function::UserDefinedFunction<Any>>(
        value = ^$skeleton(
            stereotypes = $stereoAccum.values,
            taggedValues = $tvAccum.values,
            parameters = $compiledParams,
            returnGenericType = $rGenType,
            returnMultiplicity = $rMMult,
            classifierGenericType = $finalGenType,
            expressionSequence = $bodyResult.specs,
            preConstraints = $preConstraintAccum.values,
            postConstraints = $postConstraintAccum.values
        ),
        context = $ctx7
    );
}
