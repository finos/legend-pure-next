import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::functionResolution::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::elements::compileAssociation(protocolAssoc:meta::pure::protocol::grammar::relationship::Association[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::relationship::Association>[1]
{
    let packagePath = $protocolAssoc.package->toOne().pointerValue;
    let assocName = $packagePath + '::' + $protocolAssoc.name;
    let skeleton = $context->resolveElement($assocName)->toOne()->cast(@meta::pure::metamodel::relationship::Association);

    let p1Protocol = $protocolAssoc.properties->at(0);
    let p2Protocol = $protocolAssoc.properties->at(1);

    let ownerCtx = 'association \'' + $assocName + '\'';

    let gt1Result = $p1Protocol.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)
                        ->compileGenericType($context, $packagePath, [], $p1Protocol.name, $ownerCtx);
    let mGenType1 = $gt1Result.value->toOne();

    let gt2Result = $p2Protocol.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)
                        ->compileGenericType($gt1Result.context, $packagePath, [], $p2Protocol.name, $ownerCtx);
    let mGenType2 = $gt2Result.value->toOne();

    let ctx1 = $gt2Result.context;

    if($ctx1.errors->size() > $context.errors->size(),
        | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::relationship::Association>(value = $skeleton, context = $ctx1),
        | let mMult1 = meta::pure::compiler::compileLocalMultiplicity($p1Protocol.multiplicity->cast(@meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity));
          let mMult2 = meta::pure::compiler::compileLocalMultiplicity($p2Protocol.multiplicity->cast(@meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity));

          let propClassifierGT1 = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
              type = meta::pure::metamodel::function::property::Property,
              typeArguments = [$mGenType2, $mGenType1],
              multiplicityArguments = [$mMult1]
          );
          let prop1 = meta::pure::functions::lang::new($propClassifierGT1)->cast(@meta::pure::metamodel::function::property::Property<Nil, Any|*>);
          let builtProp1 = ^$prop1(
              name = $p1Protocol.name,
              aggregation = meta::pure::metamodel::function::property::AggregationKind.None,
              genericType = $mGenType1,
              multiplicity = $mMult1,
              sourceInformation = $p1Protocol.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
                  sourceId = $si.sourceId,
                  startLine = $si.startLine,
                  startColumn = $si.startColumn,
                  endLine = $si.endLine,
                  endColumn = $si.endColumn
              ))
          );

          let propClassifierGT2 = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(
              type = meta::pure::metamodel::function::property::Property,
              typeArguments = [$mGenType1, $mGenType2],
              multiplicityArguments = [$mMult2]
          );
          let prop2 = meta::pure::functions::lang::new($propClassifierGT2)->cast(@meta::pure::metamodel::function::property::Property<Nil, Any|*>);
          let builtProp2 = ^$prop2(
              name = $p2Protocol.name,
              aggregation = meta::pure::metamodel::function::property::AggregationKind.None,
              genericType = $mGenType2,
              multiplicity = $mMult2,
              sourceInformation = $p2Protocol.sourceInformation->map(si | ^meta::pure::metamodel::SourceInformation(
                  sourceId = $si.sourceId,
                  startLine = $si.startLine,
                  startColumn = $si.startColumn,
                  endLine = $si.endLine,
                  endColumn = $si.endColumn
              ))
          );

          ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::relationship::Association>(
              value = ^$skeleton(
                  properties = [
                      ^$builtProp1(owner = ~.~),
                      ^$builtProp2(owner = ~.~)
                  ]
              ),
              context = $ctx1
          );
    );
}

function meta::pure::compiler::elements::compileLocalMultiplicity(pMult:meta::pure::protocol::grammar::multiplicity::ConcreteMultiplicity[1]):meta::pure::metamodel::multiplicity::Multiplicity[1]
{
    if($pMult.upperBound->isEmpty(),
        | if($pMult.lowerBound.value == 0,
              | meta::pure::metamodel::multiplicity::ZeroMany,
              | meta::pure::metamodel::multiplicity::OneMany
          ),
        | let upper = $pMult.upperBound->toOne().value;
          if($pMult.lowerBound.value == 1 && $upper == 1,
              | meta::pure::metamodel::multiplicity::PureOne,
              | if($pMult.lowerBound.value == 0 && $upper == 1,
                    | meta::pure::metamodel::multiplicity::ZeroOne,
                    | ^meta::pure::metamodel::multiplicity::UserDefinedAdHocMultiplicity(
                          lowerBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $pMult.lowerBound.value),
                          upperBound = ^meta::pure::metamodel::multiplicity::MultiplicityValue(value = $upper)
                      )
                )
          );
    );
}
