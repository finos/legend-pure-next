import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::functionResolution::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::structural::annotationCompiler::*;
import meta::pure::compiler::structural::generalizationCompiler::*;
import meta::pure::compiler::structural::constraintCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::*;

function meta::pure::compiler::elements::compileClass(protocolClass:meta::pure::protocol::grammar::type::Class[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::Class<Any>>[1]
{
    let packagePath = if($protocolClass.package->isEmpty(), | '', | $protocolClass.package->toOne().pointerValue);
    let className = if($packagePath == '', | $protocolClass.name, | $packagePath + '::' + $protocolClass.name);
    let skeleton = $context->resolveElement($className)->toOne()->cast(@meta::pure::metamodel::type::Class<Any>);

    let propertyAccum = $protocolClass.properties->fold({p, acc |
        let result = $p->compileProperty($acc.context, $packagePath, $skeleton);
        ^$acc(values += $result.value, context = $result.context);
    }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::function::property::Property<Nil, Any|*>>(context = $context));
    let compiledProperties = $propertyAccum.values;
    let ctx1 = $propertyAccum.context;

    let ownerCtx = 'class \'' + $className + '\'';

    let genAccum = compileGeneralizations($protocolClass.generalizations, $skeleton, $ctx1, $packagePath, $ownerCtx);
    let compiledGeneralizations = $genAccum.values;
    let ctx2 = $genAccum.context;

    let stereoAccum = $protocolClass.stereotypes->fold({s, acc |
                                compileStereotype($s, $acc, $ownerCtx);
                            }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::Stereotype>(context = $ctx2));
    let compiledStereotypes = $stereoAccum.values;
    let ctx3 = $stereoAccum.context;

    let tvAccum = $protocolClass.taggedValues->fold({t, acc |
                                compileTaggedValue($t, $acc, $ownerCtx);
                            }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::extension::TaggedValue>(context = $ctx3));
    let compiledTaggedValues = $tvAccum.values;
    let ctx4 = $tvAccum.context;

    let ownerGenericType = $skeleton.classifierGenericType->toOne()->genericTypeTypeArguments()->at(0);
    let constraintAccum = compileConstraints($protocolClass.constraints, $ownerGenericType, $ctx4);
    let compiledConstraints = $constraintAccum.values;
    let ctx5 = $constraintAccum.context;

    ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::Class<Any>>(
        value = ^$skeleton(
            stereotypes = $compiledStereotypes,
            taggedValues = $compiledTaggedValues,
            generalizations = $compiledGeneralizations->map(g | ^$g(specific = ~.~)),
            properties = $compiledProperties->map(p | ^$p(owner = ~.~)),
            constraints = $compiledConstraints
        ),
        context = $ctx5
    );
}


