import meta::pure::compiler::*;

function meta::pure::compiler::compileClass(protocolClass:meta::pure::protocol::grammar::type::Class[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::metamodel::type::Class<Any>[1]
{
    let packagePath = $protocolClass.package->toOne().pointerValue;
    let className = $packagePath + '::' + $protocolClass.name;
    let skeleton = $context->resolveElement($className)->toOne()->cast(@meta::pure::metamodel::type::Class<Any>);

    let superTypes = if($protocolClass.generalizations->isEmpty(),
        | [meta::pure::metamodel::type::Any],
        | $protocolClass.generalizations->map(g |
            let genType = $g.general->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue).type->toOne();
            $context->resolveElement($genType->cast(@meta::pure::protocol::grammar::type::Type_Pointer).pointerValue)->toOne()->cast(@meta::pure::metamodel::type::Type);
        )
    );

    let generalizations = $superTypes->map(s | ^meta::pure::metamodel::relationship::Generalization(
        general = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = $s),
        specific = $skeleton
    ));

    ^$skeleton(
        generalizations = $generalizations,
        properties = $protocolClass.properties->map(p | $p->meta::pure::compiler::compileProperty($context, $packagePath, $skeleton))
    );
}
