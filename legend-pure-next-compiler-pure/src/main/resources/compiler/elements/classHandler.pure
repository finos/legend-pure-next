import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::functionResolution::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::valueSpecificationCompiler::*;
import meta::pure::compiler::structural::lambdaCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::elements::compileClass(protocolClass:meta::pure::protocol::grammar::type::Class[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::Class<Any>>[1]
{
    let packagePath = $protocolClass.package->toOne().pointerValue;
    let className = $packagePath + '::' + $protocolClass.name;
    let skeleton = $context->resolveElement($className)->toOne()->cast(@meta::pure::metamodel::type::Class<Any>);

    let propertyAccum = $protocolClass.properties->fold({p, acc |
        let result = $p->compileProperty($acc.context, $packagePath, $skeleton);
        ^$acc(values += $result.value, context = $result.context);
    }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::function::property::Property<Nil, Any|*>>(context = $context));
    let compiledProperties = $propertyAccum.values;
    let ctx1 = $propertyAccum.context;

    let genAccum = if($protocolClass.generalizations->isEmpty(),
        | ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::relationship::Generalization>(
              values = [^meta::pure::metamodel::relationship::Generalization(
                  general = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::Any),
                  specific = $skeleton
              )],
              context = $ctx1
          ),
        | $protocolClass.generalizations->fold({g, acc |
              let gtResult = $g.general->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)->compileGenericType($acc.context, $packagePath, $skeleton.typeParameters->cast(@meta::pure::metamodel::type::generics::TypeParameter));
              ^$acc(
                  values += ^meta::pure::metamodel::relationship::Generalization(
                      general = $gtResult.value->toOne(),
                      specific = $skeleton
                  ),
                  context = $gtResult.context
              );
          }, ^meta::pure::compiler::CompilerListResult<meta::pure::metamodel::relationship::Generalization>(context = $ctx1))
    );
    let compiledGeneralizations = $genAccum.values;
    let ctx2 = $genAccum.context;

    let compiledStereotypes = $protocolClass.stereotypes->map(s |
        let profile = $ctx2->resolveElement($s.pointerValue)->toOne()->cast(@meta::pure::metamodel::extension::Profile);
        let stereotypeName = $s.extraPointerValues->at(0).value;
        $profile.p_stereotypes->filter(x | $x.value == $stereotypeName)->toOne();
    );

    let compiledTaggedValues = $protocolClass.taggedValues->map(t |
        let profile = $ctx2->resolveElement($t.tag.pointerValue)->toOne()->cast(@meta::pure::metamodel::extension::Profile);
        let tagName = $t.tag.extraPointerValues->at(0).value;
        let pTag = $profile.p_tags->filter(x | $x.value == $tagName)->toOne();
        let tvGT = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::extension::TaggedValue);
        let inst = meta::pure::functions::lang::new($tvGT)->cast(@meta::pure::metamodel::extension::TaggedValue);
        ^$inst(
            tag = $pTag,
            value = $t.value
        );
    );

    ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::type::Class<Any>>(
        value = ^$skeleton(
            stereotypes = $compiledStereotypes,
            taggedValues = $compiledTaggedValues,
            generalizations = $compiledGeneralizations->map(g | ^$g(specific = ~.~)),
            properties = $compiledProperties->map(p | ^$p(owner = ~.~))
        ),
        context = $ctx2
    );
}
