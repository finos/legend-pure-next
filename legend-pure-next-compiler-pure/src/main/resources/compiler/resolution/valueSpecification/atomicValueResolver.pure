import meta::pure::compiler::resolution::functionDefinitionResolver::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::resolveAtomicValue(av:meta::pure::metamodel::valuespecification::AtomicValue[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>[1]
{
    if($av.value->instanceOf(meta::pure::metamodel::function::LambdaFunction),
        | let lambda = $av.value->cast(@meta::pure::metamodel::function::LambdaFunction<Any>);
          let lambdaParams = $lambda.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression);
          // Skip body resolution if lambda params don't have concrete types (like Java processLambda lines 79-88)
          // Java uses inScopeTypeParamNames() which returns only the ENCLOSING OWNER's type params,
          // NOT the current function's type params pushed by the fixpoint. Use isConcreteGenericType
          // (not InContext) to match Java's behavior — the fixpoint's LAMBDA dispatch will fill
          // param types from bindings via setMissingLambdaParameterInformation.
          // NOTE: UndefinedGenericType means "no type set" (Java equivalent: null genericType).
          let paramsAreConcrete = $lambdaParams->forAll(p |
              !$p.genericType->toOne()->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType)
              && $p.genericType->toOne()->isConcreteGenericType()
              && $p.multiplicity->toOne()->isConcreteMultiplicity()
          );
          if(!$paramsAreConcrete,
              | let _d = debug($context, | 'resolveAtomicValue: LAMBDA params not concrete in context, deferring');
                let siCtx = meta::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo($av.sourceInformation, $context);
                // Return av with UndefinedGenericType to match Java behavior (where av._genericType() is null).
                // This prevents the collection resolver from seeing a concrete type for unresolvable lambdas,
                // ensuring the Collection branch in resolveOneParam is reached instead of the CONCRETE branch.
                ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
                    value = ^$av(genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType()),
                    context = ^$context(errors += 'Can\'t resolve lambda parameter types' + $siCtx)
                );,
              | // Check for lambda param names that conflict with existing scope variables (matches Java AtomicValueResolver line 91)
                let siCtx = meta::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo($av.sourceInformation, $context);
                let conflictCtx = $lambdaParams->fold({p, c |
                    let conflict = $scope->filter(s | $s.name == $p.name);
                    if($conflict->isNotEmpty(),
                        | ^$c(errors += 'Variable \'' + $p.name + '\' is already defined' + $siCtx),
                        | $c
                    );
                }, $context);
                let _d = debug($conflictCtx, | 'resolveAtomicValue: LAMBDA resolving body');
                let innerScope = $scope->concatenate($lambdaParams);
                let resolveResult = resolveExpressionSequence($lambda.expressionSequence, $innerScope, $conflictCtx);
                let ctx1 = $resolveResult.context;
                // Compute lambda genericType from body return type (like Java processLambda lines 114-121)
                let bodyReturnGT = if($resolveResult.resolvedSpecs->isEmpty(),
                    | ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
                    | let lastExpr = $resolveResult.resolvedSpecs->at($resolveResult.resolvedSpecs->size() - 1);
                      if($lastExpr.genericType->isEmpty() || $lastExpr.genericType->toOne()->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType),
                          | ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
                          | asInferredGenericType($lastExpr.genericType->toOne())
                      );
                );
                let bodyReturnMul = if($resolveResult.resolvedSpecs->isEmpty(),
                    | meta::pure::metamodel::multiplicity::PureOne,
                    | let lastExpr = $resolveResult.resolvedSpecs->at($resolveResult.resolvedSpecs->size() - 1);
                      if($lastExpr.multiplicity->isEmpty(), | meta::pure::metamodel::multiplicity::PureOne, | asInferredMultiplicity($lastExpr.multiplicity->toOne()));
                );
                let lambdaFT = meta::pure::functions::lang::new(
                    ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = meta::pure::metamodel::type::FunctionType)
                )->cast(@meta::pure::metamodel::type::FunctionType);
                let ft = ^$lambdaFT(parameters = $lambdaParams, returnType = $bodyReturnGT, returnMultiplicity = $bodyReturnMul);
                let lambdaGT = ^meta::pure::metamodel::type::generics::InferredGenericType(
                    type = meta::pure::metamodel::function::LambdaFunction,
                    typeArguments = [^meta::pure::metamodel::type::generics::InferredGenericType(type = $ft)]
                );
                let _d2 = debug($context, | 'resolveAtomicValue: LAMBDA gt=' + printGenericType($lambdaGT));
                ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
                    value = ^$av(genericType = $lambdaGT),
                    context = $ctx1
                );
          );,
        | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(value = $av, context = $context)
    );
}
