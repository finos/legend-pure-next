import meta::pure::metamodel::valuespecification::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::*;
import meta::pure::compiler::resolution::valueSpecification::collectionResolver::*;
import meta::pure::compiler::resolution::valueSpecification::variableExpressionResolver::*;
import meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::*;
import meta::pure::compiler::resolution::valueSpecification::genericTypeAndMultiplicityHolderResolver::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::resolveValueSpecification(vs:ValueSpecification[1], scope:VariableExpression[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<ValueSpecification>[1]
{
    let _d = debug($context, | 'VSR.resolve: ' + $vs->type()->toOne()->elementToPath()
        + if($vs->instanceOf(FunctionExpression), | ' fname=' + $vs->cast(@FunctionExpression).functionName->toOne(), | '')
        + ' gt=' + if($vs.genericType->isEmpty(), | '?', | printGenericType($vs.genericType->toOne()))
        + ' mul=' + if($vs.multiplicity->isEmpty(), | '?', | printMultiplicity($vs.multiplicity->toOne())));
    let deepCtx = $context->debugSpaceInc();
    let result = $vs->match([
        fi:FunctionExpression[1] |
            resolveFunctionExpression($fi, $scope, $deepCtx),
        col:Collection[1] |
            resolveCollection($col, $scope, $deepCtx),
        ve:VariableExpression[1] |
            resolveVariableExpression($ve, $scope, $deepCtx),
        av:AtomicValue[1] |
            resolveAtomicValue($av, $scope, $deepCtx),
        gm:GenericTypeAndMultiplicityHolder[1] |
            resolveGenericTypeAndMultiplicityHolder($gm, $deepCtx),
        a:Any[1] | ^meta::pure::compiler::CompilerResult<ValueSpecification>(context = $deepCtx)
    ]);
    // Restore debug space on returned context so sibling calls in folds stay at the right level
    let resultCtx = $result.context;
    let restoredCtx = ^$resultCtx(debugState = $context.debugState);
    ^meta::pure::compiler::CompilerResult<ValueSpecification>(value = $result.value, context = $restoredCtx);
}
