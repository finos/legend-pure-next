import meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::letResolver::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::resolveExpressionSequence(specs:meta::pure::metamodel::valuespecification::ValueSpecification[*], protocolExprs:meta::pure::protocol::grammar::valuespecification::ValueSpecification[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    if($specs->isEmpty() || $protocolExprs->isEmpty() || $specs->size() != $protocolExprs->size(),
        | $context,
        | $specs->size()->meta::pure::compiler::helper::genericType::range()->fold({i, ctx |
              resolveValueSpecification($specs->at($i), $protocolExprs->at($i), $ctx);
          }, $context)
    );
}

function meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::resolveValueSpecification(spec:Any[1], protocolExpr:Any[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    $spec->match([
        fi:meta::pure::metamodel::valuespecification::FunctionInvocation[1] |
            resolveFunctionExpression($fi, $protocolExpr, $context),
        a:Any[1] | $context
    ]);
}

function meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::resolveFunctionExpression(fi:meta::pure::metamodel::valuespecification::FunctionInvocation[1], protocolExpr:Any[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    $protocolExpr->match([
        pfi:meta::pure::protocol::grammar::valuespecification::FunctionInvocation[1] |
            if($pfi.functionName == 'new',
                | validateNewFromFI($pfi, $fi, $context),
                | $context
            ),
        a:Any[1] | $context
    ]);
}
