import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::genericTypeAndMultiplicityHolderResolver::resolveGenericTypeAndMultiplicityHolder(gm:meta::pure::metamodel::valuespecification::GenericTypeAndMultiplicityHolder[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>[1]
{
    let resolved = if($gm.multiplicity->isEmpty() || $gm.multiplicity->toOne()->instanceOf(meta::pure::metamodel::multiplicity::UndefinedMultiplicity),
        | ^$gm(multiplicity = meta::pure::metamodel::multiplicity::PureOne),
        | $gm
    );
    ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
        value = $resolved,
        context = $context
    );
}
