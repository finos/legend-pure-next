import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::dotApplicationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::newResolver::*;
import meta::pure::compiler::helper::functionExpression::*;
import meta::pure::compiler::helper::function::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::resolveFunctionExpression(fi:meta::pure::metamodel::valuespecification::FunctionExpression[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>[1]
{
    let _d = debug($context, | 'resolveFunctionExpression: ' + $fi.functionName->toOne() + ' (' + $fi->type()->toOne()->elementToPath() + ')');
    let deepCtx = $context->debugSpaceInc();
    let checkpoint = $context.errors->size();
    let result = match($fi, [
        dot:meta::pure::metamodel::valuespecification::DotApplication[1] |
            if($dot.parametersValues->isNotEmpty(),
                | resolveDotApplication($dot, $scope, $deepCtx),
                | resolveFunctionApplication($dot->cast(@FunctionInvocation), $scope, $deepCtx)
            );,
        inv:meta::pure::metamodel::valuespecification::FunctionInvocation[1] |
            resolveFunctionApplication($inv, $scope, $deepCtx)
    ]);
    // Enum value resolution returns an AtomicValue, not a FunctionExpression — finalize only FEs
    if($result.value->isNotEmpty(),
        | match($result.value->toOne(), [
              fInv:meta::pure::metamodel::valuespecification::FunctionInvocation[1] | meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::finalizeFunctionExpression($fInv, $checkpoint, $result.context),
              a:Any[1] | $result
          ]),
        | $result
    );
}

// Mirrors Java FunctionExpressionResolver.finalizeFunctionExpression (lines 87-124)
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::finalizeFunctionExpression(fi:meta::pure::metamodel::valuespecification::FunctionInvocation[1], checkpoint:Integer[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>[1]
{
    if($fi.func->isNotEmpty(),
        | // func resolved — compute return type from FunctionType + bindings (like Java lines 89-107)
          // Get the fully-compiled function from the context if available
          let funcPath = $fi.func->toOne()->elementToPath();
          let fromContext = $context->resolveElement($funcPath);
          let resolvedFunc = if($fromContext->isNotEmpty(),
              | match($fromContext->toOne(), [f:meta::pure::metamodel::function::Function<Any>[1] | $f, a:Any[1] | $fi.func->toOne()]),
              | $fi.func->toOne()
          );
          let ft = $resolvedFunc->getFunctionType();
          let bindings = extractResolvedParametersBinding($fi);
          let returnGT = asInferredGenericType(makeAsConcreteAsPossible($ft.returnType->toOne(), $bindings));
          let returnMul = asInferredMultiplicity(makeAsConcreteAsPossible($ft.returnMultiplicity->toOne(), $bindings));
          let _df = debug($context, | 'finalize: ' + $fi.functionName->toOne()
              + ' gt=' + printGenericType($returnGT)
              + ' mul=' + printMultiplicity($returnMul));
          let updated = ^$fi(genericType = $returnGT, multiplicity = $returnMul);

          // Validate required properties for new expressions
          let fnName = $fi.functionName->toOne();
          let ctx1 = if([pair(| $context.errors->size() > $checkpoint, | $context),
                         pair(| $fnName == 'new' || $fnName->startsWith('new_'), | validateNewFromFI($updated, $context)),
                         pair(| $fnName == 'copy' || $fnName->startsWith('copy_'), | validateCopyFromFI($updated, $context))],
                        | $context
                     );
          ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(value = $updated, context = $ctx1);,
        | // func not resolved — set genericType to undefined, report error if none yet (like Java lines 109-123)
          let updated = ^$fi(genericType = ^meta::pure::metamodel::type::generics::CompilerNotSetGenericType());
          let siCtx = meta::pure::compiler::structural::sourceInformationCompiler::formatMetamodelSourceInfo($fi.sourceInformation, $context);
          let ctx1 = if($context.errors->size() == $checkpoint,
              | ^$context(errors += 'Can\'t resolve the function \'' + $fi.functionName->toOne() + '\'' + $siCtx),
              | $context
          );
          ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(value = $updated, context = $ctx1);
    );
}
