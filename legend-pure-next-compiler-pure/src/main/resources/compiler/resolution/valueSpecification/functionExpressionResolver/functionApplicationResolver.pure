import meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::functionExpression::*;
import meta::pure::compiler::helper::function::*;
import meta::pure::compiler::*;

// ============================================================================
// Function resolution result
// ============================================================================

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::FunctionResolutionResult
{
    resolvedFunction: meta::pure::metamodel::function::PackageableFunction<Any>[0..1];
    resolvedName: String[1];
    returnGenericType: meta::pure::metamodel::type::generics::GenericType[1];
    returnMultiplicity: meta::pure::metamodel::multiplicity::Multiplicity[1];
    bindings: ParametersBinding[1];
    resolvedTypeParameters: meta::pure::metamodel::type::generics::ResolvedTypeParameter[*];
    resolvedMultiplicityParameters: meta::pure::metamodel::type::generics::ResolvedMultiplicityParameter[*];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::ParameterInfo
{
    resolved : Boolean[1];
    newParam : meta::pure::metamodel::valuespecification::ValueSpecification[1];
    savedErrors : String[*];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::FixpointAccumulator
{
    infos : ParameterInfo[*];
    bindings : ParametersBinding[1];
    context : meta::pure::compiler::CompilerContext[1];
    madeProgress : Boolean[1];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::FixpointResult
{
    infos : ParameterInfo[*];
    bindings : ParametersBinding[1];
    context : meta::pure::compiler::CompilerContext[1];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::CandidateTryAccumulator
{
    resolved : Boolean[1];
    result : meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>[0..1];
    context : meta::pure::compiler::CompilerContext[1];
    firstErrors : String[*];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::ValidationAccumulator
{
    failed : Boolean[1];
}

Class meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::ResolveOneParamResult
{
    resolved : Boolean[1];
    newParam : meta::pure::metamodel::valuespecification::ValueSpecification[1];
    bindings : ParametersBinding[1];
    context : meta::pure::compiler::CompilerContext[1];
    savedErrors : String[*];
}

// ============================================================================
// Entry point
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveFunctionApplication(fi:meta::pure::metamodel::valuespecification::FunctionInvocation[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>[1]
{
    let functionName = $fi.functionName->toOne();
    let paramCount = $fi.parametersValues->size();
    let _d = debug($context, | 'resolveFunctionApplication: ' + $functionName + ' (' + $paramCount->toString() + ' args)');
    let deepCtx = $context->debugSpaceInc();

    // Find visible candidates by name and arity
    let candidates = $context->findAllFunctionsByNameAndArity($functionName, $paramCount);

    if($candidates->isEmpty(),
        | // No visible candidates — build error with suggestions
          let siCtx = formatMetamodelSourceInfo($fi.sourceInformation, $context);
          let _d2 = debug($deepCtx, | 'no candidates found');
          let suggestions = buildFunctionSuggestions($context, $functionName, $paramCount);
          let mainError = 'The function \'' + $functionName + '\' with ' + $paramCount->toString() + ' parameter(s) can\'t be found' + $suggestions + $siCtx;
          let errorLines = $mainError->split('\n')->map(s | $s->trim())->filter(s | $s->length() > 0);
          ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
              value = $fi,
              context = ^$context(errors += $errorLines)
          );,
        | if($candidates->size() == 1,
              | // Single candidate — resolve directly, errors are legitimate
                let _d2 = debug($deepCtx, | '1 candidate');
                resolveFunctionApplicationUsingTemplateFunction($fi, $candidates->at(0), $scope, $deepCtx);,
              | // Multiple candidates — pre-resolve non-lambda params, then try each candidate
                let _d2 = debug($deepCtx, | $candidates->size()->toString() + ' candidates, pre-resolving non-lambda params');
                resolveWithMultipleCandidates($fi, $candidates, $scope, $deepCtx, $context);
          );
    );
}

// Mirrors Java resolveFunctionApplication multi-candidate path
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveWithMultipleCandidates(fi:meta::pure::metamodel::valuespecification::FunctionInvocation[1], candidates:meta::pure::metamodel::function::PackageableFunction<Any>[*], scope:meta::pure::metamodel::valuespecification::VariableExpression[*], deepCtx:meta::pure::compiler::CompilerContext[1], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>[1]
{
    // Step 1: Pre-resolve non-lambda params once (like Java lines 86-94)
    // Lambdas are excluded because their param types depend on the candidate's type-parameter bindings.
    let preResolvedParams = $fi.parametersValues->map(pv |
        if($pv->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue) && $pv->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->toOne()->instanceOf(meta::pure::metamodel::function::LambdaFunction),
            | $pv,
            | let r = resolveValueSpecification($pv, $scope, $context);
              if($r.value->isEmpty(), | $pv, | $r.value->toOne());
        )
    );
    let preResolvedFI = ^$fi(parametersValues = $preResolvedParams);

    // Step 2: Try each candidate with the fixpoint — first clean resolution wins (like Java lines 97-126)
    let tryResult = $candidates->fold({candidate, acc |
        if($acc.resolved,
            | $acc,
            | let _dc = debug($deepCtx, | 'trying candidate: ' + $candidate->elementToPath());
              let checkpoint = $context->errorCheckpoint();
              // Pass ORIGINAL context (not accumulated) — each candidate attempt is independent
              let result = resolveFunctionApplicationUsingTemplateFunction($preResolvedFI, $candidate, $scope, $context);
              let resultCtx = $result.context;
              if($resultCtx->errorCheckpoint() == $checkpoint,
                  | // Clean resolution — success
                    let _ds = debug($deepCtx, | 'candidate resolved cleanly');
                    ^$acc(resolved = true, result = $result);,
                  | // Resolution produced errors — save first candidate's errors, try next
                    let _df = debug($deepCtx, | 'candidate produced errors, trying next');
                    let savedErrors = if($acc.firstErrors->isEmpty(), | $resultCtx->snapshotErrors($checkpoint), | $acc.firstErrors);
                    ^$acc(firstErrors = $savedErrors);
              );
        );
    }, ^CandidateTryAccumulator(resolved = false, context = $context));

    // Step 3: Return result or restore first candidate's errors (like Java lines 127-133)
    if($tryResult.resolved,
        | $tryResult.result->toOne(),
        | // No candidate resolved cleanly — restore first candidate's errors
          if($tryResult.firstErrors->isNotEmpty(),
              | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
                    value = $fi,
                    context = ^$context(errors += $tryResult.firstErrors));,
              | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
                    value = $fi,
                    context = $context);
          );
    );
}

// ============================================================================
// Template function resolution with fixpoint
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveFunctionApplicationUsingTemplateFunction(fi:meta::pure::metamodel::valuespecification::FunctionInvocation[1], entry:meta::pure::metamodel::function::PackageableFunction<Any>[1], scope:meta::pure::metamodel::valuespecification::VariableExpression[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>[1]
{
    let ft = $entry->getFunctionType();
    let funcParams = $ft.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression);

    let _d = debug($context, | 'resolveFunctionApplicationUsingTemplateFunction: ' + $entry->elementToPath() + ' (' + $fi.parametersValues->size()->toString() + ' args)');

    // Push entry's type/multiplicity param names into scope (like Java pushBindingNode)
    let entryTypeParams = $entry.typeParameters->map(tp | $tp->cast(@meta::pure::metamodel::type::generics::TypeParameter).name->toOne());
    let entryMulParams = $entry.multiplicityParameters->map(mp | $mp->cast(@meta::pure::metamodel::multiplicity::MultiplicityParameter).name->toOne());
    let _ds = debug($context, | 'scope: pushing typeParams=[' + $entryTypeParams->joinStrings(',') + '] mulParams=[' + $entryMulParams->joinStrings(',') + ']');
    let scopedCtx = ^$context(
        scopeTypeParams = $context.scopeTypeParams->concatenate($entryTypeParams),
        scopeMulParams = $context.scopeMulParams->concatenate($entryMulParams)
    );
    let deepCtx = $scopedCtx->debugSpaceInc();

    // Initialize: all params start unresolved
    let initInfos = $fi.parametersValues->map(pv | ^ParameterInfo(resolved = false, newParam = $pv, savedErrors = []));

    // Fixpoint: resolve params iteratively until no more progress
    let fixpointResult = fixpointResolveParams($initInfos, $fi, $funcParams, newPlainParametersBinding()->cast(@ParametersBinding), $scope, $deepCtx, 1);
    let resolvedInfos = $fixpointResult.infos;
    let bindings = $fixpointResult.bindings;
    let ctx1 = $fixpointResult.context;

    // Push back saved errors from all unresolved args
    let unresolvedErrors = $resolvedInfos->filter(info | !$info.resolved)->map(info | $info.savedErrors);
    let ctx2 = ^$ctx1(errors += $unresolvedErrors);

    // Assemble result
    let resolvedParams = $resolvedInfos->map(info | $info.newParam);
    let hasUnresolved = $resolvedInfos->exists(info | !$info.resolved);

    if($hasUnresolved,
        | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
              value = ^$fi(func = $entry, parametersValues = $resolvedParams),
              context = $ctx2),
        | // All resolved — validate arg types against param types (like Java validateParameterValuesToFunctionType)
          // Skip validation if fixpoint already produced errors (body resolution errors are the right errors)
          let fiSrcInfo = $fi.sourceInformation;
          let fixpointProducedErrors = $ctx2.errors->size() > $context.errors->size();
          let validationCtx = if($fixpointProducedErrors, | $ctx2, | validateParameterTypes($fi.functionName->toOne(), $resolvedParams, $funcParams, $bindings, $fiSrcInfo, $ctx2));
          if($validationCtx.errors->size() > $ctx2.errors->size(),
              | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
                    value = ^$fi(parametersValues = $resolvedParams),
                    context = $validationCtx);,
              |
          // Build return type using bindings
          let returnGT = makeAsConcreteAsPossible($ft.returnType->toOne(), $bindings);
          let returnMul = makeAsConcreteAsPossible($ft.returnMultiplicity->toOne(), $bindings);
          let inferredReturnGT = asInferredGenericType($returnGT);
          let inferredReturnMul = asInferredMultiplicity($returnMul);

          // Build resolved type/multiplicity parameters
          let resolvedTypeParams = $bindings.typeBindings->keys()->map(k |
              let vals = $bindings.typeBindings->get($k)->toOne().values;
              ^meta::pure::metamodel::type::generics::ResolvedTypeParameter(
                  name = $k,
                  value = asInferredGenericType($vals->at(0))
              );
          );
          let resolvedMulParams = $bindings.multiplicityBindings->keys()->map(k |
              let vals = $bindings.multiplicityBindings->get($k)->toOne().values;
              ^meta::pure::metamodel::type::generics::ResolvedMultiplicityParameter(
                  name = $k,
                  value = asInferredMultiplicity($vals->at(0))
              );
          );

          ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(
              value = ^$fi(
                  func = $entry,
                  parametersValues = $resolvedParams,
                  genericType = $inferredReturnGT,
                  multiplicity = $inferredReturnMul,
                  resolvedTypeParameters = $resolvedTypeParams,
                  resolvedMultiplicityParameters = $resolvedMulParams
              ),
              context = $validationCtx
          );
          ); // end validation check
    );
}

// Mirrors Java validateParameterValuesToFunctionType
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::validateParameterTypes(
    functionName:String[1],
    resolvedParams:meta::pure::metamodel::valuespecification::ValueSpecification[*],
    funcParams:meta::pure::metamodel::valuespecification::VariableExpression[*],
    bindings:ParametersBinding[1],
    sourceInfo:meta::pure::metamodel::SourceInformation[0..1],
    context:meta::pure::compiler::CompilerContext[1]
):meta::pure::compiler::CompilerContext[1]
{
    let siCtx = formatMetamodelSourceInfo($sourceInfo, $context);
    // Check each arg against expected type/multiplicity — report first mismatch only
    let mismatch = range($resolvedParams->size())->fold({i, acc |
        if($acc.failed,
            | $acc,
            | let argGT = $resolvedParams->at($i).genericType->toOne();
              let argMul = $resolvedParams->at($i).multiplicity->toOne();
              // Skip validation if arg type is UndefinedGenericType (like Java line 318: if argGT == null, skip)
              if($argGT->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType),
                  | $acc,
                  | let expectedGT = makeAsConcreteAsPossible($funcParams->at($i).genericType->toOne(), $bindings);
                    let expectedMul = makeAsConcreteAsPossible($funcParams->at($i).multiplicity->toOne(), $bindings);
                    let typeOk = isCompatibleGenericType($expectedGT, $argGT) || isCompatibleGenericType($argGT, $expectedGT) || (printGenericType($expectedGT) == printGenericType($argGT));
                    let mulOk = multiplicitySubsumes($expectedMul, $argMul);
                    if(!$typeOk || !$mulOk,
                        | ^$acc(failed = true);,
                        | $acc
                    );
              );
        );
    }, ^ValidationAccumulator(failed = false));
    if($mismatch.failed,
        | let argDesc = $resolvedParams->map(vs | printGenericType($vs.genericType->toOne()) + printMultiplicity($vs.multiplicity->toOne()))->joinStrings(', ');
          ^$context(errors += 'No matching function \'' + $functionName + '\' found for argument types (' + $argDesc + ')' + $siCtx);,
        | $context
    );
}

// ============================================================================
// Fixpoint iteration
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::fixpointResolveParams(
    infos:ParameterInfo[*],
    expr:meta::pure::metamodel::valuespecification::FunctionInvocation[1],
    funcParams:meta::pure::metamodel::valuespecification::VariableExpression[*],
    bindings:ParametersBinding[1],
    scope:meta::pure::metamodel::valuespecification::VariableExpression[*],
    context:meta::pure::compiler::CompilerContext[1],
    iteration:Integer[1]
):FixpointResult[1]
{
    let _d = debug($context, | '--- fixpoint iteration ' + $iteration->toString() + ' ---');

    // One pass: try to resolve each unresolved param
    let passResult = range($infos->size())->fold({i, acc |
        let info = $infos->at($i);
        if($info.resolved,
            | ^$acc(infos += $info),
            | let parameterValue = $info.newParam;
              let paramGT = $funcParams->at($i).genericType->toOne();
              let paramMul = $funcParams->at($i).multiplicity->toOne();

              let _dp = debug($acc.context, | 'parameterValue[' + $i->toString() + '] class=' + $parameterValue->type()->toOne()->elementToPath()
                  + ' paramGT=' + printGenericType($paramGT));

              let resolveResult = resolveOneParam($parameterValue, $paramGT, $paramMul, $acc.bindings, $scope, $acc.context);

              if($resolveResult.resolved,
                  | let _dr = debug($acc.context, | '=> RESOLVED gt=' + printGenericType($resolveResult.newParam.genericType->toOne())
                        + if($resolveResult.newParam.multiplicity->isEmpty(), | '', | ' mul=' + printMultiplicity($resolveResult.newParam.multiplicity->toOne())));
                    ^$acc(infos += ^ParameterInfo(resolved = true, newParam = $resolveResult.newParam, savedErrors = []),
                          bindings = $resolveResult.bindings,
                          context = $resolveResult.context,
                          madeProgress = true);,
                  | let _dr = debug($acc.context, | '=> NOT RESOLVED');
                    ^$acc(infos += ^ParameterInfo(resolved = false, newParam = $resolveResult.newParam, savedErrors = $resolveResult.savedErrors),
                          context = $resolveResult.context);
              );
        );
    }, ^FixpointAccumulator(bindings = $bindings, context = $context, madeProgress = false));

    let updatedInfos = $passResult.infos;
    let updatedBindings = $passResult.bindings;
    let updatedCtx = $passResult.context;

    if($passResult.madeProgress,
        | fixpointResolveParams($updatedInfos, $expr, $funcParams, $updatedBindings, $scope, $updatedCtx, $iteration + 1),
        | ^FixpointResult(infos = $updatedInfos, bindings = $updatedBindings, context = $updatedCtx)
    );
}

// ============================================================================
// Single parameter resolution
// ============================================================================

// Mirrors Java resolveParameterValue — dispatches by resolved value type
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::resolveOneParam(
    parameterValue:meta::pure::metamodel::valuespecification::ValueSpecification[1],
    paramGT:meta::pure::metamodel::type::generics::GenericType[1],
    paramMul:meta::pure::metamodel::multiplicity::Multiplicity[1],
    bindings:ParametersBinding[1],
    scope:meta::pure::metamodel::valuespecification::VariableExpression[*],
    context:meta::pure::compiler::CompilerContext[1]
):ResolveOneParamResult[1]
{
    let checkpoint = $context->errorCheckpoint();

    // If the arg already carries a concrete type and multiplicity (e.g. pre-resolved),
    // skip the expensive VSR call (like Java resolveParameterValue lines 422-425)
    // NOTE: UndefinedGenericType is treated as "concrete" by isConcreteGenericType but
    // should NOT trigger the shortcut — it means the sub-expression failed to resolve.
    // In Java, failed resolution returns null genericType (not UndefinedGenericType).
    let alreadyConcrete = $parameterValue.genericType->isNotEmpty()
        && !$parameterValue.genericType->toOne()->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType)
        && $parameterValue.genericType->toOne()->isConcreteGenericType()
        && $parameterValue.multiplicity->isNotEmpty() && $parameterValue.multiplicity->toOne()->isConcreteMultiplicity();
    let r = if($alreadyConcrete,
        | ^meta::pure::compiler::CompilerResult<meta::pure::metamodel::valuespecification::ValueSpecification>(value = $parameterValue, context = $context),
        | resolveValueSpecification($parameterValue, $scope, $context)
    );
    let processed = if($r.value->isEmpty(), | $parameterValue, | $r.value->toOne());
    let ctx1 = $r.context;

    // Check if concrete in context (like Java isConcreteInContext — allows in-scope type params)
    // NOTE: UndefinedGenericType is "concrete" per isConcreteGenericType but represents
    // unresolved types (Java returns null instead). Exclude it from the concrete check.
    let isConcrete = $processed.genericType->isNotEmpty()
        && !$processed.genericType->toOne()->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType)
        && $processed.genericType->toOne()->isConcreteGenericTypeInContext($context.scopeTypeParams)
        && $processed.multiplicity->isNotEmpty()
        && $processed.multiplicity->toOne()->isConcreteMultiplicityInContext($context.scopeMulParams);

    if($isConcrete,
        | // CONCRETE: collect bindings (Java resolveParameterValue line 427-440)
          let _dc = debug($context, | 'resolveArg: CONCRETE gt=' + printGenericType($processed.genericType->toOne()));
          let argGT = $processed.genericType->toOne();
          let argMul = $processed.multiplicity->toOne();
          let b1 = collectTypeParameterBindings($paramGT, $argGT, $bindings);
          let b2 = collectMultiplicityParameterBindings($paramMul, $argMul, $b1);
          ^ResolveOneParamResult(resolved = true, newParam = $processed, bindings = $b2, context = $ctx1, savedErrors = []);,
        | // Check if LAMBDA: AtomicValue wrapping a LambdaFunction (Java line 442-448)
          let isLambda = $processed->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue)
              && $processed->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->toOne()->instanceOf(meta::pure::metamodel::function::LambdaFunction);
          if($isLambda,
              | let ctx2 = $ctx1->rollbackErrors($checkpoint);
                let _dl = debug($context, | 'resolveArg: LAMBDA');
                let lambda = $processed->cast(@meta::pure::metamodel::valuespecification::AtomicValue).value->toOne()->cast(@meta::pure::metamodel::function::LambdaFunction<Any>);
                let reprocessedLambda = setMissingLambdaParameterInformation($lambda, $paramGT, $bindings);
                let av = $processed->cast(@meta::pure::metamodel::valuespecification::AtomicValue);
                let withReprocessedLambda = ^$av(value = $reprocessedLambda);
                finishProcessing($paramGT, $paramMul, $bindings, $scope, $ctx2, $withReprocessedLambda);,
              | // NOT RESOLVED — save errors and rollback (Java line 486-487)
                let _dn = debug($context, | 'resolveArg: NO_MATCH class=' + $processed->type()->toOne()->elementToPath());
                let savedErrors = $ctx1->snapshotErrors($checkpoint);
                let rolledBackCtx = $ctx1->rollbackErrors($checkpoint);
                ^ResolveOneParamResult(resolved = false, newParam = $processed, bindings = $bindings, context = $rolledBackCtx, savedErrors = $savedErrors);
          );
    );
}

// Mirrors Java setMissingLambdaParameterInformation (lines 523-556)
// Sets lambda param types from the function parameter's expected type using current bindings
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::setMissingLambdaParameterInformation(
    lambda:meta::pure::metamodel::function::LambdaFunction<Any>[1],
    paramGT:meta::pure::metamodel::type::generics::GenericType[1],
    bindings:ParametersBinding[1]
):meta::pure::metamodel::function::LambdaFunction<Any>[1]
{
    // Resolve the function parameter's Function<{FunctionType}> to concrete types using current bindings
    // e.g. Function<{T[1]->Boolean[1]}> with T=String => Function<{String[1]->Boolean[1]}>
    let concreteGT = makeAsConcreteAsPossible($paramGT, $bindings);
    if($concreteGT->instanceOf(meta::pure::metamodel::type::generics::GenericTypeValue) && $concreteGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).typeArguments->isNotEmpty(),
        | let innerGT = $concreteGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).typeArguments->at(0);
          if($innerGT->instanceOf(meta::pure::metamodel::type::generics::GenericTypeValue) && $innerGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type->isNotEmpty() && $innerGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type->toOne()->instanceOf(meta::pure::metamodel::type::FunctionType),
              | let ft = $innerGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type->toOne()->cast(@meta::pure::metamodel::type::FunctionType);
                let lambdaParams = $lambda.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression);
                let newParams = $ft.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression)->zip($lambdaParams)->map({pair |
                    let ftParam = $pair.first;
                    let lambdaParam = $pair.second;
                    let resolvedType = makeAsConcreteAsPossible($ftParam.genericType->toOne(), $bindings);
                    let resolvedMul = makeAsConcreteAsPossible($ftParam.multiplicity->toOne(), $bindings);
                    // Replace if param type is not concrete (UndefinedGenericType = Java null = not concrete)
                    let lambdaGT = $lambdaParam.genericType->toOne();
                    let newGT = if($lambdaGT->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType) || !$lambdaGT->isConcreteGenericType(), | asInferredGenericType($resolvedType), | $lambdaGT);
                    let lambdaMul = $lambdaParam.multiplicity->toOne();
                    let newMul = if(!$lambdaMul->isConcreteMultiplicity(), | asInferredMultiplicity($resolvedMul), | $lambdaMul);
                    ^$lambdaParam(genericType = $newGT, multiplicity = $newMul);
                });
                ^$lambda(parameters = $newParams);,
              | $lambda
          );,
        | $lambda
    );
}

// Mirrors Java finishProcessing (lines 490-517)
// Re-resolve via VSR, then collect bindings
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::finishProcessing(
    paramGT:meta::pure::metamodel::type::generics::GenericType[1],
    paramMul:meta::pure::metamodel::multiplicity::Multiplicity[1],
    bindings:ParametersBinding[1],
    scope:meta::pure::metamodel::valuespecification::VariableExpression[*],
    context:meta::pure::compiler::CompilerContext[1],
    vs:meta::pure::metamodel::valuespecification::ValueSpecification[1]
):ResolveOneParamResult[1]
{
    // Re-resolve via VSR (now lambda has concrete param types)
    let r = resolveValueSpecification($vs, $scope, $context);
    let resolved = if($r.value->isEmpty(), | $vs, | $r.value->toOne());
    let ctx1 = $r.context;

    // Collect bindings from the re-resolved type
    let b1 = if($resolved.genericType->isNotEmpty(),
        | collectTypeParameterBindings($paramGT, $resolved.genericType->toOne(), $bindings),
        | $bindings
    );
    let b2 = if($resolved.multiplicity->isNotEmpty(),
        | collectMultiplicityParameterBindings($paramMul, $resolved.multiplicity->toOne(), $b1),
        | $b1
    );

    let isResolved = $resolved.genericType->isNotEmpty()
        && $resolved.genericType->toOne()->isConcreteGenericTypeInContext($context.scopeTypeParams)
        && $resolved.multiplicity->isNotEmpty()
        && $resolved.multiplicity->toOne()->isConcreteMultiplicityInContext($context.scopeMulParams);

    ^ResolveOneParamResult(resolved = $isResolved, newParam = $resolved, bindings = $b2, context = $ctx1, savedErrors = []);
}

// ============================================================================
// Candidate matching (multiple candidates)
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::isCandidateCompatible(
    candidate:meta::pure::metamodel::function::PackageableFunction<Any>[1],
    argTypes:meta::pure::metamodel::type::generics::GenericType[*],
    argMuls:meta::pure::metamodel::multiplicity::Multiplicity[*]
):Boolean[1]
{
    let ft = $candidate->getFunctionType();
    let params = $ft.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression);

    // Collect bindings from arg types against param types
    let bindings = range($argTypes->size())->fold({i, b |
        let paramGT = $params->at($i).genericType->toOne();
        let argGT = $argTypes->at($i);
        let b2 = collectTypeParameterBindings($paramGT, $argGT, $b);
        let paramMul = $params->at($i).multiplicity->toOne();
        let argMul = $argMuls->at($i);
        collectMultiplicityParameterBindings($paramMul, $argMul, $b2);
    }, newPlainParametersBinding()->cast(@ParametersBinding));

    // Check arg type and multiplicity compatibility
    $argTypes->zip($params)->forAll({pair |
        let argGT = $pair.first;
        let paramGT = $pair.second.genericType->toOne();
        let resolvedParamGT = makeAsConcreteAsPossible($paramGT, $bindings);
        let isUndefined = $resolvedParamGT->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType) || $argGT->instanceOf(meta::pure::metamodel::type::generics::UndefinedGenericType);
        let isTypeParam = $resolvedParamGT->instanceOf(meta::pure::metamodel::type::generics::GenericTypeValue) && $resolvedParamGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type->isNotEmpty() && $resolvedParamGT->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type->toOne()->instanceOf(meta::pure::metamodel::type::generics::TypeParameter);
        if($isUndefined || $isTypeParam,
            | true,
            | let paramStr = printGenericType($resolvedParamGT);
              let argStr = printGenericType($argGT);
              isCompatibleGenericType($resolvedParamGT, $argGT) || isCompatibleGenericType($argGT, $resolvedParamGT) || ($paramStr == $argStr);
        );
    }) && $argMuls->zip($params)->forAll({pair |
        let argMul = $pair.first;
        let paramMul = $pair.second.multiplicity->toOne();
        let resolvedParamMul = makeAsConcreteAsPossible($paramMul, $bindings);
        multiplicitySubsumes($resolvedParamMul, $argMul);
    });
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::buildResolutionResult(
    candidate:meta::pure::metamodel::function::PackageableFunction<Any>[1],
    argTypes:meta::pure::metamodel::type::generics::GenericType[*],
    argMuls:meta::pure::metamodel::multiplicity::Multiplicity[*]
):FunctionResolutionResult[1]
{
    let ft = $candidate->getFunctionType();
    let params = $ft.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression);
    let bindings = range($argTypes->size())->fold({i, b |
        let paramGT = $params->at($i).genericType->toOne();
        let argGT = $argTypes->at($i);
        let b2 = collectTypeParameterBindings($paramGT, $argGT, $b);
        let paramMul = $params->at($i).multiplicity->toOne();
        let argMul = $argMuls->at($i);
        collectMultiplicityParameterBindings($paramMul, $argMul, $b2);
    }, newPlainParametersBinding()->cast(@ParametersBinding));

    let returnGT = makeAsConcreteAsPossible($ft.returnType->toOne(), $bindings);
    let returnMul = makeAsConcreteAsPossible($ft.returnMultiplicity->toOne(), $bindings);

    let resolvedTypeParams = $bindings.typeBindings->keys()->map(k |
        let vals = $bindings.typeBindings->get($k)->toOne().values;
        ^meta::pure::metamodel::type::generics::ResolvedTypeParameter(
            name = $k,
            value = asInferredGenericType($vals->at(0))
        );
    );
    let resolvedMulParams = $bindings.multiplicityBindings->keys()->map(k |
        let vals = $bindings.multiplicityBindings->get($k)->toOne().values;
        ^meta::pure::metamodel::type::generics::ResolvedMultiplicityParameter(
            name = $k,
            value = asInferredMultiplicity($vals->at(0))
        );
    );

    ^FunctionResolutionResult(
        resolvedFunction = $candidate,
        resolvedName = $candidate.name->toOne(),
        returnGenericType = asInferredGenericType($returnGT),
        returnMultiplicity = asInferredMultiplicity($returnMul),
        bindings = $bindings,
        resolvedTypeParameters = $resolvedTypeParams,
        resolvedMultiplicityParameters = $resolvedMulParams
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::findAllMatchingCandidates(
    candidates:meta::pure::metamodel::function::PackageableFunction<Any>[*],
    functionName:String[1],
    argTypes:meta::pure::metamodel::type::generics::GenericType[*],
    argMuls:meta::pure::metamodel::multiplicity::Multiplicity[*]
):FunctionResolutionResult[*]
{
    $candidates
        ->filter(c | isCandidateCompatible($c, $argTypes, $argMuls))
        ->map(c | buildResolutionResult($c, $argTypes, $argMuls));
}

// ============================================================================
// Error suggestions
// ============================================================================

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::functionSignature(f:meta::pure::metamodel::function::PackageableFunction<Any>[1]):String[1]
{
    let ft = $f->getFunctionType();
    let params = $ft.parameters->cast(@meta::pure::metamodel::valuespecification::VariableExpression);
    let paramDesc = $params->map(p | $p.name + ': ' + printGenericType($p.genericType->toOne()) + printMultiplicity($p.multiplicity->toOne()))->joinStrings(', ');
    let retDesc = printGenericType($ft.returnType->toOne()) + printMultiplicity($ft.returnMultiplicity->toOne());
    // Build path with short name: extract package from path, short name from mangled name
    let fullPath = $f->elementToPath();
    let mangledName = $f.name->toOne();
    // Short name is the part before the first '_' (type suffix)
    let shortName = if($mangledName->contains('_'), | $mangledName->substring(0, $mangledName->indexOf('_')), | $mangledName);
    let pkgPath = if($fullPath->contains('::'), | $fullPath->split('::')->init()->joinStrings('::') + '::', | '');
    $pkgPath + $shortName + '(' + $paramDesc + '): ' + $retDesc;
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::buildFunctionSuggestions(context:meta::pure::compiler::CompilerContext[1], functionName:String[1], paramCount:Integer[1]):String[1]
{
    // Look for functions with same name but different arity or visibility
    let allSameArity = findAllFunctionsByNameAndArityUnfiltered($context, $functionName, $paramCount);
    let inScope = $allSameArity->filter(f | $context->isElementVisible($f->elementToPath()));
    let outOfScope = $allSameArity->filter(f | !$context->isElementVisible($f->elementToPath()));

    // Functions with different arity (check a few common arities)
    let diffArity = range(5)->filter(a | $a != $paramCount)->map(a | findAllFunctionsByNameAndArityUnfiltered($context, $functionName, $a))->filter(f | $context->isElementVisible($f->elementToPath()));

    let parts = []
        ->concatenate(if($inScope->isNotEmpty(), | '. Possible matches with ' + $paramCount->toString() + ' parameter(s) in scope:\n    ' + $inScope->map(f | functionSignature($f))->joinStrings('\n    '), | []))
        ->concatenate(if($outOfScope->isNotEmpty(), | '. Possible matches with ' + $paramCount->toString() + ' parameter(s) not in scope:\n    ' + $outOfScope->map(f | functionSignature($f))->joinStrings('\n    '), | []))
        ->concatenate(if($diffArity->isNotEmpty(), | '. Possible matches with different number of parameters:\n    ' + $diffArity->map(f | functionSignature($f))->joinStrings('\n    '), | []));
    $parts->joinStrings('');
}
