import meta::pure::metamodel::valuespecification::*;
import meta::pure::compiler::resolution::functionDefinitionResolver::*;
import meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::letResolver::*;
import meta::pure::compiler::*;

Class meta::pure::compiler::resolution::functionDefinitionResolver::ResolveResult
{
    resolvedSpecs: ValueSpecification[*];
    context: meta::pure::compiler::CompilerContext[1];
}

Class meta::pure::compiler::resolution::functionDefinitionResolver::ResolveAccumulator
{
    scope: VariableExpression[*];
    context: meta::pure::compiler::CompilerContext[1];
    resolvedSpecs: ValueSpecification[*];
}

function meta::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence(specs:ValueSpecification[*], params:VariableExpression[*], context:meta::pure::compiler::CompilerContext[1]):ResolveResult[1]
{
    let result = $specs->fold({spec, acc |
        let r = resolveValueSpecification($spec, $acc.scope, $acc.context);
        let resolved = if($r.value->isEmpty(), | $spec, | $r.value->toOne());
        let ctx2 = $spec->match([
            fi:FunctionInvocation[1] |
                checkLetDuplicate($fi, $acc.scope, $r.context),
            a:Any[1] | $r.context
        ]);
        let newScope = $resolved->match([
            fi:FunctionInvocation[1] |
                if($fi.functionName->toOne()->startsWith('letFunction') && $fi.parametersValues->size() >= 1,
                    | let varName = $fi.parametersValues->at(0)->cast(@AtomicValue<String>).value->cast(@String);
                      $acc.scope->concatenate(^VariableExpression(
                          name = $varName,
                          genericType = $resolved.genericType,
                          multiplicity = $resolved.multiplicity
                      ));,
                    | $acc.scope
                ),
            a:Any[1] | $acc.scope
        ]);
        ^ResolveAccumulator(scope = $newScope, context = $ctx2, resolvedSpecs = $acc.resolvedSpecs->concatenate($resolved));
    }, ^ResolveAccumulator(scope = $params, context = $context, resolvedSpecs = []));
    ^ResolveResult(resolvedSpecs = $result.resolvedSpecs, context = $result.context);
}
