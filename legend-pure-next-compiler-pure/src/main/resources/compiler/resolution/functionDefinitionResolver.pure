import meta::pure::compiler::resolution::functionDefinitionResolver::*;
import meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::letResolver::*;
import meta::pure::compiler::*;

Class meta::pure::compiler::resolution::functionDefinitionResolver::ResolveAccumulator
{
    scope: meta::pure::metamodel::valuespecification::VariableExpression[*];
    context: meta::pure::compiler::CompilerContext[1];
}

function meta::pure::compiler::resolution::functionDefinitionResolver::resolveExpressionSequence(specs:meta::pure::metamodel::valuespecification::ValueSpecification[*], params:meta::pure::metamodel::valuespecification::VariableExpression[*], context:meta::pure::compiler::CompilerContext[1]):meta::pure::compiler::CompilerContext[1]
{
    let result = $specs->fold({spec, acc |
        let ctx1 = resolveValueSpecification($spec, $acc.scope, $acc.context);
        let ctx2 = $spec->match([
            fi:meta::pure::metamodel::valuespecification::FunctionInvocation[1] |
                checkLetDuplicate($fi, $acc.scope, $ctx1),
            a:Any[1] | $ctx1
        ]);
        let newScope = $spec->match([
            fi:meta::pure::metamodel::valuespecification::FunctionInvocation[1] |
                if($fi.functionName->toOne()->startsWith('letFunction') && $fi.parametersValues->size() >= 1,
                    | let varName = $fi.parametersValues->at(0)->cast(@meta::pure::metamodel::valuespecification::AtomicValue<String>).value->cast(@String);
                      $acc.scope->concatenate(^meta::pure::metamodel::valuespecification::VariableExpression(
                          name = $varName,
                          genericType = $fi.genericType,
                          multiplicity = $fi.multiplicity
                      ));,
                    | $acc.scope
                ),
            a:Any[1] | $acc.scope
        ]);
        ^ResolveAccumulator(scope = $newScope, context = $ctx2);
    }, ^ResolveAccumulator(scope = $params, context = $context));
    $result.context;
}
