import meta::pure::metamodel::*;
import meta::pure::metamodel::type::*;
import meta::pure::functions::collection::*;
import meta::pure::functions::string::*;

function meta::pure::compiler::printer::primitive::printPrimitive(p:PrimitiveType[1]):String[1]
{
    [
        'primitive ', $p->fullPath(),
        $p.classifierGenericType->printClassifierGenericType(),
        $p.sourceInformation->printSourceInfo(),
        if($p.typeVariables->isEmpty(), | '', 
            | [ '\n', $p.typeVariables->cast(@meta::pure::metamodel::valuespecification::VariableExpression)->map(tv2 | 
                [ '  typeVariable ', $tv2.name->toOne(), ' :', $tv2.genericType->toOne()->printType(), $tv2.multiplicity->toOne()->printMul() ]->joinStrings('');
              )->joinStrings('\n') ]->joinStrings('')
        )
    ]->joinStrings('');
}
