import meta::pure::compiler::helper::*;
import meta::pure::compiler::printer::*;
import meta::pure::compiler::printer::primitive::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::functions::collection::*;
import meta::pure::functions::string::*;

function meta::pure::compiler::printer::printCompiledGraph(elements:PackageableElement[*]):String[1]
{
    $elements->map(e | $e->printElement())->joinStrings('\n\n')
}

function meta::pure::compiler::printer::printElement(element:PackageableElement[1]):String[1]
{
    $element->match(
        [
            c:meta::pure::metamodel::type::Class<Any>[1] | $c->printClass(),
            assoc:meta::pure::metamodel::relationship::Association[1] | $assoc->printAssociation(),
            en:meta::pure::metamodel::type::Enumeration<Any>[1] | $en->printEnumeration(),
            pr:meta::pure::metamodel::extension::Profile[1] | $pr->printProfile(),
            p:meta::pure::metamodel::type::PrimitiveType[1] | $p->printPrimitive(),
            a:Any[1] | 'unsupported: ' + $element->cast(@PackageableElement)->fullPath()
        ]
    )
}

function meta::pure::compiler::printer::printClass(c:meta::pure::metamodel::type::Class<Any>[1]):String[1]
{
    [
        'class ', $c->fullPath(), 
        if($c.generalizations->isEmpty(), | '', | [ ' extends ', $c.generalizations->cast(@Any)->map(g | let g2 = $g->cast(@meta::pure::metamodel::relationship::Generalization); $g2.general->printType();)->joinStrings(', ') ]->joinStrings('') ),
        $c.classifierGenericType->printClassifierGenericType(),
        $c.sourceInformation->printSourceInfo(),
        if($c.stereotypes->isEmpty(), | '', | '\n  <<' + $c.stereotypes->map(s | $s.profile->toOne()->fullPath() + '.' + $s.value)->joinStrings(', ') + '>>'),
        if($c.taggedValues->isEmpty(), | '', | '\n  {' + $c.taggedValues->map(t | $t.tag.profile->toOne()->fullPath() + '.' + $t.tag.value + ' = \'' + $t.value + '\'')->joinStrings(', ') + '}'),
        if($c.properties->isEmpty(), | '', | [ '\n', $c.properties->cast(@Any)->map(p | 
            let p2 = $p->cast(@meta::pure::metamodel::function::property::Property<Nil, Any|*>);
            [ 'property ', $p2.name->toOne(), ' :', $p2.genericType->printType(), $p2.multiplicity->printMul(), $p2.classifierGenericType->printClassifierGenericType() ]->joinStrings('');
        )->joinStrings('\n') ]->joinStrings(''))
    ]->joinStrings('');
}

function meta::pure::compiler::printer::printAssociation(assoc:meta::pure::metamodel::relationship::Association[1]):String[1]
{
    [
        'association ', $assoc->fullPath(),
        $assoc.classifierGenericType->printClassifierGenericType(),
        $assoc.sourceInformation->printSourceInfo(),
        if($assoc.properties->isEmpty(), | '', | [ '\n', $assoc.properties->cast(@Any)->map(p | 
            let p2 = $p->cast(@meta::pure::metamodel::function::property::Property<Nil, Any|*>);
            [ '  property ', $p2.name->toOne(), ' :', $p2.genericType->printType(), $p2.multiplicity->printMul(), $p2.classifierGenericType->printClassifierGenericType() ]->joinStrings('');
        )->joinStrings('\n') ]->joinStrings(''))
    ]->joinStrings('');
}

function meta::pure::compiler::printer::printEnumeration(en:meta::pure::metamodel::type::Enumeration<Any>[1]):String[1]
{
    [
        'enumeration ', $en->fullPath(), ' extends Enum',
        $en.classifierGenericType->printClassifierGenericType(),
        $en.sourceInformation->printSourceInfo(),
        if($en.properties->isEmpty(), | '', | [ '\n', $en.properties->cast(@Any)->map(p | $p->meta::pure::compiler::printer::printEnumerationProperty())->joinStrings('\n') ]->joinStrings(''))
    ]->joinStrings('');
}

function meta::pure::compiler::printer::printEnumerationProperty(p:Any[1]):String[1]
{
    let p2 = $p->cast(@meta::pure::metamodel::function::property::Property<Nil, Any|*>);
    let expr = $p2.defaultValue->toOne()->cast(@meta::pure::metamodel::function::LambdaFunction<Any>).expressionSequence->at(0);
    let val = $expr->match([
        a:meta::pure::metamodel::valuespecification::AtomicValue[1] | $a.value->toOne()->cast(@meta::pure::metamodel::type::Enumeration<Any>),
        en:meta::pure::metamodel::type::Enumeration<Any>[1] | $en
    ]);
    let propCGT = $p2.classifierGenericType->printClassifierGenericType();
    let enumFullName = $p2.owner->toOne()->fullPath();
    [ '  property ', $p2.name->toOne(), $propCGT, '  = ^', $enumFullName, '(name=\'', $val.name->toOne(), '\')  ~lambda:#LambdaFunction<#{->', $enumFullName, '[1]}#>#', $p2.sourceInformation->printSourceInfo() ]->joinStrings('');
}

function meta::pure::compiler::printer::printProfile(pr:meta::pure::metamodel::extension::Profile[1]):String[1]
{
    [
        'profile ', $pr->fullPath(),
        $pr.classifierGenericType->printClassifierGenericType(),
        $pr.sourceInformation->printSourceInfo(),
        if($pr.p_stereotypes->isEmpty(), | '', | [ '\n', $pr.p_stereotypes->map(s | '  stereotype ' + $s.value + $s.classifierGenericType->printClassifierGenericType())->joinStrings('\n') ]->joinStrings('')),
        if($pr.p_tags->isEmpty(), | '', | [ '\n', $pr.p_tags->map(t | '  tag ' + $t.value + $t.classifierGenericType->printClassifierGenericType())->joinStrings('\n') ]->joinStrings(''))
    ]->joinStrings('');
}

function meta::pure::compiler::printer::printClassifierGenericType(cgt:GenericType[0..1]):String[1]
{
    if($cgt->isEmpty(),
        | '',
        | '  ~' + $cgt->toOne()->printType()
    );
}

function meta::pure::compiler::printer::printSourceInfo(si:meta::pure::metamodel::SourceInformation[0..1]):String[1]
{
    if($si->isEmpty(),
        | '',
        | '  @' + $si.startLine->toOne()->toString() + ':' + $si.startColumn->toOne()->toString() + '-' + $si.endLine->toOne()->toString() + ':' + $si.endColumn->toOne()->toString()
    );
}

function meta::pure::compiler::printer::printType(gt:GenericType[1]):String[1]
{
    // Need to handle missing core mappings!
    let coreType = $gt->match(
        [
            gtv:GenericTypeValue[1] |
                if($gtv.type->isEmpty(), | '?', |
                    $gtv.type->toOne()->match(
                        [
                            tp:meta::pure::metamodel::type::generics::TypeParameter[1] | $tp.name + if($tp.owner->isEmpty(), | '', | '~' + $tp.owner->toOne()->match([ pe:PackageableElement[1] | if($pe.name->isEmpty(), | '?', | $pe->fullPath()), a:Any[1] | '?' ])),
                            pe:PackageableElement[1] |
                                if($pe.name->isEmpty(), | '?', |
                                    let path = $pe->fullPath();
                                    if($path->startsWith('meta::pure::metamodel::type::primitives::'),
                                       | $path->substring(41),
                                       | if($path->startsWith('meta::pure::metamodel::') || $path->startsWith('meta::pure::functions::'),
                                            | $pe.name->toOne(),
                                            | $path
                                         )
                                    );
                                ),
                            a:Any[1] | '?'
                        ]
                    )
                ),
            a:Any[1] | '?'
        ]
    );
    let typeArgs = $gt->genericTypeTypeArguments()->map(t | $t->printType())->joinStrings(', ');
    let mulArgs = $gt->genericTypeMultiplicityArguments()->map(m | $m->printMul())->map(m | if($m->startsWith('[') && $m->endsWith(']'), | $m->substring(1, $m->length() - 1), | $m))->joinStrings(', ');
    
    let args = if($typeArgs == '', | '', | $typeArgs) + if($mulArgs == '', | '', | '|' + $mulArgs);
    if($args == '', | $coreType, | $coreType + '<' + $args + '>');
}

function meta::pure::compiler::printer::printMul(mul:Multiplicity[1]):String[1]
{
    $mul->match([
        pm:PackageableMultiplicity[1] |
            let path = $pm->fullPath();
            let strip1 = if($path->startsWith('meta::pure::metamodel::multiplicity::'), | $path->substring(37), | $path);
            let strip2 = if($strip1->startsWith('Inferred'), | $strip1->substring(8), | $strip1);
            
            if($strip2 == 'PureOne', | '[1]',
               | if($strip2 == 'ZeroOne', | '[0..1]',
                    | if($strip2 == 'ZeroMany', | '[*]',
                         | if($strip2 == 'OneMany', | '[1..*]',
                              | '[' + $strip2 + ']'
                           )
                      )
                 )
            );,
        cm:ConcreteMultiplicity[1] |
            if($cm.upperBound->isEmpty(),
               | if($cm.lowerBound->isEmpty() || $cm.lowerBound.value == 0,
                    | '[*]',
                    | '[' + $cm.lowerBound.value->toOne()->toString() + '..*]'
                 ),
               | if($cm.lowerBound.value == $cm.upperBound.value,
                    | '[' + $cm.lowerBound.value->toOne()->toString() + ']',
                    | '[' + $cm.lowerBound.value->toOne()->toString() + '..' + $cm.upperBound.value->toOne()->toString() + ']'
                 )
            );,
        mp:meta::pure::metamodel::multiplicity::MultiplicityParameter[1] |
            '[' + $mp.name + if($mp.owner->isEmpty(), | '', | '~' + $mp.owner->toOne()->match([ pe:PackageableElement[1] | if($pe.name->isEmpty(), | '?', | $pe->fullPath()), a:Any[1] | '?' ])) + ']'
    ])
}
