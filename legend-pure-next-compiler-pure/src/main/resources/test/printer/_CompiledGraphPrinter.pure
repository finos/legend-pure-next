function meta::pure::compiler::test::printer::printCompiledGraph(elements:PackageableElement[*]):String[1]
{
    $elements->map(e | $e->printElement())->joinStrings('\n\n')
}

function meta::pure::compiler::test::printer::printElement(element:PackageableElement[1]):String[1]
{
    $element->match(
        [
            c:Class<Any>[1] | $c->printClass(),
            assoc:Association[1] | $assoc->printAssociation(),
            en:Enumeration<Any>[1] | $en->meta::pure::compiler::test::printer::printEnumeration(),
            fn:NativeFunction<Any>[1] | $fn->meta::pure::compiler::test::printer::printNativeFunction(),
            udf:UserDefinedFunction<Any>[1] | $udf->meta::pure::compiler::test::printer::printUserDefinedFunction(),
            pr:Profile[1] | $pr->meta::pure::compiler::test::printer::printProfile(),
            p:PrimitiveType[1] | $p->printPrimitive(),
            a:Any[1] | 'unsupported: ' + $element->cast(@PackageableElement)->fullPath()
        ]
    )
}

function meta::pure::compiler::test::printer::printClass(c:Class<Any>[1]):String[1]
{
    [
        'class ', $c->fullPath(), 
        if($c.generalizations->isEmpty(), | '', | [ ' extends ', $c.generalizations->cast(@Any)->map(g | let g2 = $g->cast(@Generalization); $g2.general->printType();)->joinStrings(', ') ]->joinStrings('') ),
        $c.classifierGenericType->printClassifierGenericType(),
        $c.sourceInformation->printSourceInfo(),
        if($c.stereotypes->isEmpty(), | '', | '\n  <<' + $c.stereotypes->map(s | $s.profile->toOne()->fullPath() + '.' + $s.value)->joinStrings(', ') + '>>'),
        if($c.taggedValues->isEmpty(), | '', | '\n  {' + $c.taggedValues->map(t | $t.tag.profile->toOne()->fullPath() + '.' + $t.tag.value + ' = \'' + $t.value + '\'')->joinStrings(', ') + '}'),
        if($c.properties->isEmpty(), | '', | [ '\n', $c.properties->cast(@Any)->map(p | 
            let p2 = $p->cast(@Property<Nil, Any|*>);
            [ 'property ', $p2.name->toOne(), ' :', $p2.genericType->printType(), $p2.multiplicity->printMul(), $p2.classifierGenericType->printClassifierGenericType() ]->joinStrings('');
        )->joinStrings('\n') ]->joinStrings(''))
    ]->joinStrings('');
}

function meta::pure::compiler::test::printer::printAssociation(assoc:Association[1]):String[1]
{
    [
        'association ', $assoc->fullPath(),
        $assoc.classifierGenericType->printClassifierGenericType(),
        $assoc.sourceInformation->printSourceInfo(),
        if($assoc.properties->isEmpty(), | '', | [ '\n', $assoc.properties->cast(@Any)->map(p | 
            let p2 = $p->cast(@Property<Nil, Any|*>);
            [ '  property ', $p2.name->toOne(), ' :', $p2.genericType->printType(), $p2.multiplicity->printMul(), $p2.classifierGenericType->printClassifierGenericType() ]->joinStrings('');
        )->joinStrings('\n') ]->joinStrings(''))
    ]->joinStrings('');
}

function meta::pure::compiler::test::printer::printEnumeration(en:Enumeration<Any>[1]):String[1]
{
    [
        'enumeration ', $en->fullPath(), ' extends Enum',
        $en.classifierGenericType->printClassifierGenericType(),
        $en.sourceInformation->printSourceInfo(),
        if($en.properties->isEmpty(), | '', | [ '\n', $en.properties->cast(@Any)->map(p | $p->meta::pure::compiler::test::printer::printEnumerationProperty())->joinStrings('\n') ]->joinStrings(''))
    ]->joinStrings('');
}

function meta::pure::compiler::test::printer::printEnumerationProperty(p:Any[1]):String[1]
{
    let p2 = $p->cast(@Property<Nil, Any|*>);
    let expr = $p2.defaultValue->toOne()->cast(@LambdaFunction<Any>).expressionSequence->at(0);
    let val = $expr->match([
        a:AtomicValue[1] | $a.value->toOne()->cast(@Enumeration<Any>),
        en:Enumeration<Any>[1] | $en
    ]);
    let propCGT = $p2.classifierGenericType->printClassifierGenericType();
    let enumFullName = $p2.owner->toOne()->cast(@PackageableElement)->fullPath();
    [ '  property ', $p2.name->toOne(), $propCGT, '  = ^', $enumFullName, '(name=\'', $val.name->toOne(), '\')  ~lambda:#LambdaFunction<#{->', $enumFullName, '[1]}#>#', $p2.sourceInformation->printSourceInfo() ]->joinStrings('');
}

function meta::pure::compiler::test::printer::printNativeFunction(fn:NativeFunction<Any>[1]):String[1]
{
    let paramStr = $fn.parameters->cast(@VariableExpression)->map(p |
        [$p.name->toOne(), ':', $p.genericType->toOne()->printType(), $p.multiplicity->toOne()->printMul()]->joinStrings('')
    )->joinStrings(', ');
    let returnStr = [$fn.returnGenericType->toOne()->printType(), $fn.returnMultiplicity->toOne()->printMul()]->joinStrings('');
    let signature = [$fn->fullPath(), '(', $paramStr, '):', $returnStr]->joinStrings('');
    [
        'native function ', $signature,
        $fn.classifierGenericType->printClassifierGenericType(),
        if($fn.sourceInformation->isEmpty(), | '', | '\n')
    ]->joinStrings('');
}

function meta::pure::compiler::test::printer::printProfile(pr:Profile[1]):String[1]
{
    [
        'profile ', $pr->fullPath(),
        $pr.classifierGenericType->printClassifierGenericType(),
        $pr.sourceInformation->printSourceInfo(),
        if($pr.p_stereotypes->isEmpty(), | '', | [ '\n', $pr.p_stereotypes->map(s | '  stereotype ' + $s.value + $s.classifierGenericType->printClassifierGenericType())->joinStrings('\n') ]->joinStrings('')),
        if($pr.p_tags->isEmpty(), | '', | [ '\n', $pr.p_tags->map(t | '  tag ' + $t.value + $t.classifierGenericType->printClassifierGenericType())->joinStrings('\n') ]->joinStrings(''))
    ]->joinStrings('');
}

function meta::pure::compiler::test::printer::printClassifierGenericType(cgt:GenericType[0..1]):String[1]
{
    if($cgt->isEmpty(),
        | '',
        | '  ~' + $cgt->toOne()->printType()
    );
}

function meta::pure::compiler::test::printer::printSourceInfo(si:SourceInformation[0..1]):String[1]
{
    if($si->isEmpty(),
        | '',
        | '  @' + $si.startLine->toOne()->toString() + ':' + $si.startColumn->toOne()->toString() + '-' + $si.endLine->toOne()->toString() + ':' + $si.endColumn->toOne()->toString()
    );
}

function meta::pure::compiler::test::printer::printType(gt:GenericType[1]):String[1]
{
    let isInferred = $gt->instanceOf(Inferred);
    // Need to handle missing core mappings!
    let coreType = $gt->match(
        [
            gtv:GenericTypeValue[1] |
                if($gtv.type->isEmpty(), | '?', |
                    $gtv.type->toOne()->match(
                        [
                            tp:TypeParameter[1] | $tp.name + if($tp.owner->isEmpty(), | '', | '~' + $tp.owner->toOne()->match([ pe:PackageableElement[1] | if($pe.name->isEmpty(), | '?', | $pe->fullPath()), a:Any[1] | '?' ])),
                            ft:FunctionType[1] |
                                let pStr = $ft.parameters->cast(@VariableExpression)->map(p | [$p.genericType->toOne()->printType(), $p.multiplicity->toOne()->printMul()]->joinStrings(''))->joinStrings(', ');
                                let rStr = [$ft.returnType->toOne()->printType(), $ft.returnMultiplicity->toOne()->printMul()]->joinStrings('');
                                ['{', $pStr, '->', $rStr, '}']->joinStrings('');,
                            pe:PackageableElement[1] |
                                if($pe.name->isEmpty(), | '?', |
                                    let path = $pe->fullPath();
                                    if([pair(| $path->startsWith('meta::pure::metamodel::type::primitives::'), | $path->substring(41)),
                                        pair(| $path->startsWith('meta::pure::metamodel::') || $path->startsWith('meta::pure::functions::'), | $pe.name->toOne())],
                                       | $path
                                    );
                                ),
                            a:Any[1] | '?'
                        ]
                    )
                ),
            a:Any[1] | '?'
        ]
    );
    let typeArgs = $gt->genericTypeTypeArguments()->map(t | $t->printType())->joinStrings(', ');
    let mulArgs = $gt->genericTypeMultiplicityArguments()->map(m | $m->printMul())->map(m | if($m->startsWith('[') && $m->endsWith(']'), | $m->substring(1, $m->length() - 1), | $m))->joinStrings(', ');
    
    let args = if($typeArgs == '', | '', | $typeArgs) + if($mulArgs == '', | '', | '|' + $mulArgs);
    let typeStr = if($args == '', | $coreType, | $coreType + '<' + $args + '>');
    
    // Wrap with # for inferred types
    if($isInferred, | '#' + $typeStr + '#', | $typeStr);
}

function meta::pure::compiler::test::printer::printMul(mul:Multiplicity[1]):String[1]
{
    let isInferred = $mul->instanceOf(Inferred);
    let coreMul = $mul->match([
        pm:PackageableMultiplicity[1] |
            let path = $pm->fullPath();
            let strip1 = if($path->startsWith('meta::pure::metamodel::multiplicity::'), | $path->substring(37), | $path);
            let strip2 = if($strip1->startsWith('Inferred'), | $strip1->substring(8), | $strip1);
            
            if([pair(| $strip2 == 'PureOne', | '[1]'),
                pair(| $strip2 == 'ZeroOne', | '[0..1]'),
                pair(| $strip2 == 'ZeroMany', | '[*]'),
                pair(| $strip2 == 'OneMany', | '[1..*]')],
               | '[' + $strip2 + ']'
            );,
        cm:ConcreteMultiplicity[1] |
            if([pair(| $cm.upperBound->isEmpty() && ($cm.lowerBound->isEmpty() || $cm.lowerBound.value == 0), | '[*]'),
                pair(| $cm.upperBound->isEmpty(), | '[' + $cm.lowerBound.value->toOne()->toString() + '..*]'),
                pair(| $cm.lowerBound.value == $cm.upperBound.value, | '[' + $cm.lowerBound.value->toOne()->toString() + ']')],
               | '[' + $cm.lowerBound.value->toOne()->toString() + '..' + $cm.upperBound.value->toOne()->toString() + ']'
            );,
        mp:MultiplicityParameter[1] |
            '[' + $mp.name + if($mp.owner->isEmpty(), | '', | '~' + $mp.owner->toOne()->match([ pe:PackageableElement[1] | if($pe.name->isEmpty(), | '?', | $pe->fullPath()), a:Any[1] | '?' ])) + ']'
    ]);
    
    // Wrap with # for inferred multiplicities
    if($isInferred, | '#' + $coreMul + '#', | $coreMul);
}

function meta::pure::compiler::test::printer::printUserDefinedFunction(fn:UserDefinedFunction<Any>[1]):String[1]
{
    let paramStr = $fn.parameters->cast(@VariableExpression)->map(p |
        [$p.name->toOne(), ':', $p.genericType->toOne()->printType(), $p.multiplicity->toOne()->printMul()]->joinStrings('')
    )->joinStrings(', ');
    let returnStr = [$fn.returnGenericType->toOne()->printType(), $fn.returnMultiplicity->toOne()->printMul()]->joinStrings('');
    let signature = [$fn->fullPath(), '(', $paramStr, '):', $returnStr]->joinStrings('');
    
    let exprs = $fn.expressionSequence->cast(@ValueSpecification)->map(expr |
        $expr->meta::pure::compiler::test::printer::printValueSpecification('  ')
    )->joinStrings('\n');
    
    [
        'function ', $signature,
        $fn.classifierGenericType->printClassifierGenericType(),
        if($exprs == '', | '', | '\n' + $exprs)
    ]->joinStrings('');
}

function meta::pure::compiler::test::printer::printValueSpecification(vs:Any[1], indent:String[1]):String[1]
{
    $vs->match([
        l:LambdaFunction<Any>[1] |
            let paramStr = $l.parameters->cast(@VariableExpression)->map(p |
                [$p.name->toOne(), ':', $p.genericType->toOne()->printType(), $p.multiplicity->toOne()->printMul()]->joinStrings('')
            )->joinStrings(', ');
            let openVars = $l.openVariables->cast(@VariableExpression)->map(v |
                $indent + '  openVar ' + $v.name->toOne() + ' :' + $v.genericType->toOne()->printType() + $v.multiplicity->toOne()->printMul()
            )->joinStrings('\n');
            let body = $l.expressionSequence->cast(@ValueSpecification)->map(expr |
                $expr->meta::pure::compiler::test::printer::printValueSpecification($indent + '  ')
            )->joinStrings('\n');
            let lamCGT = $l.classifierGenericType->toOne()->printType();
            let lamMul = if($l.classifierGenericType->toOne()->genericTypeMultiplicityArguments()->isEmpty(),
                | '[1]',
                | $l.classifierGenericType->toOne()->genericTypeMultiplicityArguments()->at(0)->printMul()
            );
            [
                $indent, 'Lambda(', $paramStr, ') :', $lamCGT, $lamMul,
                '  ~AtomicValue',
                $l.sourceInformation->printSourceInfo(),
                if($openVars == '', | '', | '\n' + $openVars),
                if($body == '', | '', | '\n' + $body)
            ]->joinStrings('');,
        fi:FunctionInvocation[1] |
            let params = $fi.parametersValues->cast(@ValueSpecification)->map(p |
                $p->meta::pure::compiler::test::printer::printValueSpecification($indent + '  ')
            )->joinStrings('\n');
            let resolvedTypeParams = $fi.resolvedTypeParameters->map(rtp |
                $indent + '  typeParam ' + $rtp.name + ' -> ' + $rtp.value->printType()->replace('#', '')
            )->joinStrings('\n');
            let resolvedMulParams = $fi.resolvedMultiplicityParameters->map(rmp |
                $indent + '  mulParam ' + $rmp.name + ' -> ' + $rmp.value->printMul()->replace('#', '')
            )->joinStrings('\n');
            [
                $indent, 'FunctionInvocation ', $fi.functionName->toOne()->replace('::', '_'), ' :', $fi.genericType->toOne()->printType(), $fi.multiplicity->toOne()->printMul(),
                $fi.classifierGenericType->printClassifierGenericType(),
                $fi.sourceInformation->printSourceInfo(),
                if($resolvedTypeParams == '', | '', | '\n' + $resolvedTypeParams),
                if($resolvedMulParams == '', | '', | '\n' + $resolvedMulParams),
                if($params == '', | '', | '\n' + $params)
            ]->joinStrings('');,
        v:VariableExpression[1] |
            [
                $indent, 'Variable ', $v.name->toOne(), ' :', $v.genericType->toOne()->printType(), $v.multiplicity->toOne()->printMul(),
                $v.classifierGenericType->printClassifierGenericType(),
                $v.sourceInformation->printSourceInfo()
            ]->joinStrings('');,
        a:ValueSpecification[1] |
            let val = $a->cast(@AtomicValue).value->toOne();
            if($val->instanceOf(LambdaFunction),
               | $val->meta::pure::compiler::test::printer::printValueSpecification($indent),
               | [
                   $indent, 'AtomicValue  ', 
                   if($val->instanceOf(String), | '\'' + $val->toString() + '\'', | $val->toString()),
                   ' :', $a.genericType->toOne()->printType(), $a.multiplicity->toOne()->printMul(),
                   $a.classifierGenericType->printClassifierGenericType(),
                   $a.sourceInformation->printSourceInfo()
                 ]->joinStrings('')
            );,
        other:Any[1] | $indent + 'unsupported: ' + $other->type()->elementToPath()
    ]);
}
