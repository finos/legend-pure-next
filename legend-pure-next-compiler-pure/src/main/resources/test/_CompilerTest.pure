import meta::pure::compiler::test::*;
import meta::pure::functions::collection::*;
import meta::pure::functions::string::*;
import meta::pure::metamodel::function::*;
import meta::pure::compiler::printer::*;
import meta::pure::protocol::*;
import meta::pure::test::pct::*;

// Harness
function meta::pure::compiler::test::assertCompiledGraph(content:String[1]):Boolean[1]
{
    if(contains($content, '###' + 'CompiledGraph'),
       | // 1. Call native parse (assuming the parser has CompiledGraphLanguageExtension configured)
         let parsedFile = meta::pure::compiler::parse('testSource.pure', $content);
         
         // 2. Extract CompiledGraph assertion from the PureFile sections
         let expectedGraphElement = $parsedFile.sections.elements->filter(e | $e->instanceOf(meta::pure::compiler::test::CompiledGraph))->head();
         if($expectedGraphElement->isNotEmpty(),
            | let expectedGraphValue = $expectedGraphElement->toOne()->cast(@meta::pure::compiler::test::CompiledGraph).value;
              
              // 3. Compile the rest of the Pure models
              let compiledMetamodel = meta::pure::compiler::compile($parsedFile);
              
              // 4. Print elements
              let actualGraph = meta::pure::compiler::printer::printCompiledGraph($compiledMetamodel);
              
              // 5. Assert equality
              let cleanedExpected = $expectedGraphValue->replace('\r', '')->split('\n')->map(s | $s->trim())->joinStrings('\n')->trim();
              let cleanedActual = $actualGraph->replace('\r', '')->split('\n')->map(s | $s->trim())->joinStrings('\n')->trim();
              println('EXPECTED LEN: ' + $cleanedExpected->length()->toString());
              println('ACTUAL LEN: ' + $cleanedActual->length()->toString());
              assertEquals($cleanedExpected, $cleanedActual);
              true;,
            | true
         );,
       | true
    );
}
