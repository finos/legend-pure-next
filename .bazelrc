common --enable_bzlmod

# No bazel-* links at the root: the one to the execroot mirrors the workspace, .git included, and IDEs then find a
# second Git root in it. Outputs are at `bazel info bazel-bin` / `bazel info bazel-testlogs`.
common --experimental_convenience_symlinks=ignore

# JDK 25, on GraalVM: Truffle
# needs its JIT, in tests and as the tool that compiles the modules (tools/bazel/graalvm.bzl).
common --java_language_version=25
common --java_runtime_version=graalvm_25
common --tool_java_language_version=25
common --tool_java_runtime_version=graalvm_25

# The checks javac runs: no Error Prone, which Bazel runs by default.
build --javacopt=-XepDisableAllChecks
build --host_javacopt=-XepDisableAllChecks

test --test_output=errors

# The test JVMs (Truffle with its Graal JIT, the bootstrap) size their compiler and GC threads to the processors they
# see: each is told 4, and at most a quarter of the processors' worth of tests run at once, so together they fit the
# machine. Without it a full `bazel test //...` on a many-core machine runs a test per core, each JVM sizing its pools for
# all of them, and the JIT-heavy suites slow twentyfold (test_junit of truffle-pure: 13s alone, past its 300s timeout).
# The compiles get the same from target_genrule.bzl.
test --test_env=JAVA_TOOL_OPTIONS=-XX:ActiveProcessorCount=4
test --local_test_jobs=HOST_CPUS*.25

# Reports stay files, so tools/bazel/collect-reports.mjs copies them as they are.
test --nozip_undeclared_test_outputs

# Tiers (spec Section 3). Every non-manual test runs on a pull request. Manual tests are never in //...: the bootstrap
# and self-host jobs name them, e.g. bazel test $(bazel query 'attr(tags, selfhost, //...)').
test:required --test_tag_filters=-manual

# CI (.github/workflows/build.yml): a disk cache and a repository cache, which each job restores from the job it
# needs and saves for the jobs that need it (actions/cache), in place of a remote cache.
common:ci --disk_cache=~/.cache/bazel-disk
common:ci --repository_cache=~/.cache/bazel-repo
common:ci --experimental_disk_cache_gc_max_size=6G
common:ci --color=yes
common:ci --curses=no
common:ci --show_progress_rate_limit=30
# A CI runner has about 4 processors, a test JVM's whole share already: a quarter of them would run its tests one by one.
test:ci --local_test_jobs=auto

try-import %workspace%/.bazelrc.user
