#!/usr/bin/env bash
# Shell wrapper for the Pure CLI fat JAR.
#
# Requires the project to be built with `just build-cli` first.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
JAR="${ROOT}/build/cli/pure-cli.jar"

if [[ ! -f "${JAR}" ]]; then
    echo "Error: CLI jar not found at ${JAR}" >&2
    echo "Run 'just build-cli' first." >&2
    exit 1
fi

exec java -jar "${JAR}" "$@"
