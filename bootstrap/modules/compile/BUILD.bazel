# Step 1 on the bootstrap: the reference PDBs of what the Truffle CLI builds, and the compiler written in Pure compiled by
# itself (compile-via-pure).

load("//tools/bazel:hosts.bzl", "module_compiles", "module_reference_compiles")

module_reference_compiles()

module_compiles(
    "pure",
    command = "compile-via-pure",
    modules = ["compiler", "core_metamodel_pdb_writer", "island_pdb_writer"],
    parser_mappings = False,
    tags = ["bootstrap"],
    tool = "bootstrap",
)
