#!/usr/bin/env bash
# Shell wrapper for the bootstrap CLI fat JAR.
#
# Requires the project to be built with `just build-bootstrap` first.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
JAR="${BOOT_DIR}/build/pure-bootstrap.jar"

if [[ ! -f "${JAR}" ]]; then
    echo "Error: bootstrap CLI jar not found at ${JAR}" >&2
    echo "Run 'just build-bootstrap' first." >&2
    exit 1
fi

exec java -jar "${JAR}" "$@"
