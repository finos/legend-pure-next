import meta::pure::compiler::*;

function go():Any[*]
{
let content = 'Class pkg::MyClass { (composite) child:String[*]; name:String[1]; }';
    let file = meta::pure::functions::meta::parse('testSource', $content);
    let cls = $file.sections->at(0).elements->at(0)->cast(@meta::pure::protocol::grammar::type::Class);

    // The composite property should have AggregationKind == Composite
    let compositeProp = $cls.properties->filter(p | $p.name == 'child')->at(0);
    println($compositeProp.aggregation);
}