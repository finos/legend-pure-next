<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>bootstrap</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>legend-pure-next-cli</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - CLI</name>
    <description>Command-line interface for compiling and executing Pure code.</description>

    <dependencies>
        <!-- Execution engine (transitively brings compiler, parser) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-execution</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Compiler (for SpecificationBinaryBuilder) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-compiler</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Eclipse Collections -->
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Compiler test-jar provides CompiledGraphPrinter used by CompilerCompiledGraphTest -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-compiler</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.finos.legend.pure.cli.PureCLI</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Merge LICENSE / NOTICE entries instead of duplicating them. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                            </transformers>
                            <finalName>pure-cli-${project.version}-fat</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signature files: invalid once jars are merged. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Per-input MANIFEST.MF: ManifestResourceTransformer
                                             builds the output manifest from <mainClass>; suppresses
                                             the "MANIFEST.MF in two or more JARs" warning. -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- module-info.class (root + multi-release) — fat jar is a
                                             classpath jar; JPMS encapsulation does not apply. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- Per-jar license/notice noise; merged copies are
                                             produced by the transformers above. -->
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/NOTICE.txt</exclude>
                                        <!-- Eclipse Collections ships these duplicated across api/impl. -->
                                        <exclude>about.html</exclude>
                                        <exclude>LICENSE-EDL-1.0.txt</exclude>
                                        <exclude>LICENSE-EPL-1.0.txt</exclude>
                                    </excludes>
                                </filter>
                                <!-- pure/annotations/* are emitted identically by RdfJavaGenerator
                                     in both parser and compiler. Keep the parser copy (parser is
                                     the upstream module) and drop the compiler's duplicate. -->
                                <filter>
                                    <artifact>org.finos.legend.pure:legend-pure-next-compiler</artifact>
                                    <excludes>
                                        <exclude>pure/annotations/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
