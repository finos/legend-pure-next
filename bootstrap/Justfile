# bootstrap/Justfile — builds and tests the bootstrap Java compiler/CLI.
#
# Direct invocation:    just <recipe>             (from bootstrap/)
# Via the root Justfile: just bootstrap::<recipe> (from repo root)
#
# Outputs split between bootstrap-local and shared:
#   bootstrap/build/pure-bootstrap.jar       — bootstrap-only fat jar
#   <repo>/shared/core.pdb                    — shared (truffle codegen reads it)
#   <repo>/shared/compiler.pdb                — shared
#   bootstrap/build/compiler_bootstrap.pdb   — bootstrap-only (self-host output)
#   <repo>/shared/specification/              — shared (generated spec files)
#
# Two Maven modes selected by argument to a single parameterized `_mvn` recipe:
#   `build`  → `(_mvn "skip-tests")` (mvn install -DskipTests) — fast, no Java tests
#   `test-java` → `(_mvn "with-tests")` (mvn install)          — surefire runs unit tests inline
#                                                                (also runs the Pure runTests / PCT
#                                                                suites that live as Java tests)
# `test` is one Maven launch end to end: `test-java` covers Java + Pure-via-surefire, then
# `test-compiler` adds the compiled-graph spec suite via the bootstrap CLI.
#
# Public steps (`stage`, `build-compiler-pdb`) have no Maven dep of their own;
# the entry-point recipe (`build` or `test`) lists Maven + stage + build-compiler-pdb in order.
#
# `test-pure`, `test-pct`, `test-compiler` are zero-dep "expert mode" recipes — they assume
# `just build` (or `just test`) has already produced the artifacts. Run them
# standalone for fast Pure-side iteration without re-invoking Maven.

set quiet := true
set shell := ["bash", "-c"]

bootstrap_root := source_directory()
repo_root      := bootstrap_root / ".."
boot           := bootstrap_root / "legend-pure-next-bootstrap"
bcore          := boot / "legend-pure-next-bootstrap-core"
spec           := repo_root / "pure" / "specification"
compiler_src   := repo_root / "pure" / "compiler-pure"
boot_out       := bootstrap_root / "build"
shared_out     := repo_root / "shared"
cli            := boot_out / "pure-bootstrap.jar"
pure_bootstrap := bootstrap_root / "bin" / "pure-bootstrap"

# verbose=1 disables -q and stops filtering JDK/SLF4J warnings.
verbose := ""
mvnq    := if verbose == "" { "-q" } else { "" }
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

banner := "printf '\\n══════════════════════════════════════════════════════════════════════════════════\\n  %-13s %s\\n══════════════════════════════════════════════════════════════════════════════════\\n'"

default: test

# --- Public: build (mvn install -DskipTests + stage + compile compiler.pdb) ---
build: (_mvn "skip-tests") stage build-compiler-pdb

# Copy artifacts: pure-bootstrap.jar to bootstrap/build/, core.pdb + generated
# specs to <repo>/shared/ (shared with truffle).
stage:
    @{{banner}} '[stage]' 'copy bootstrap jar + core.pdb + generated specs'
    mkdir -p {{boot_out}} {{shared_out}}/specification/protocol
    cp {{boot}}/legend-pure-next-bootstrap-cli/target/pure-bootstrap-*-fat.jar {{cli}}
    cp {{bcore}}/legend-pure-next-bootstrap-compiler/target/classes/core.pdb {{shared_out}}/core.pdb
    cp -r {{bcore}}/legend-pure-next-bootstrap-generators/target/generated-specification/* {{shared_out}}/specification/

# Compile compiler.pdb from compiler-pure sources via the bootstrap CLI.
# Truffle codegen reads compiler.pdb out of <repo>/shared/, so this is a
# prerequisite for any truffle work as well.
build-compiler-pdb:
    @{{banner}} '[bootstrap]' 'compile compiler.pdb against core.pdb'
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --source {{compiler_src}} \
        --output {{shared_out}}/compiler.pdb {{err_filter}}

# --- Public: test (Maven with surefire + stage + compile compiler.pdb + run compiler-graph tests) ---
# `test-java` runs Maven with surefire (Java unit tests + Pure runTests/PCT
# suites that live as Java tests). `stage` and `build-compiler-pdb` are then
# run by just's dep chain; `test-compiler` runs the compiled-graph spec suite
# via the bootstrap CLI on top.
test: test-java stage build-compiler-pdb test-compiler

# --- Public: Java unit tests only — `(_mvn "with-tests")` runs surefire inline ---
test-java: (_mvn "with-tests")

# --- Public: Pure runTests over the standard library ---
# No deps — assumes `just build` has already produced shared/core.pdb +
# shared/compiler.pdb + bootstrap/build/pure-bootstrap.jar. Used as a fast
# inner-loop entry point during Pure-side iteration;
# Pure tests are already running in the maven execution build
test-pure:
    @{{banner}} '[pure→bootstrap]' 'runTests over meta::pure::functions (assumes `just build` was run)'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --function "meta::pure::test::runTests_String_1__String_1_" \
        --args "meta::pure::functions" {{err_filter}}

# --- Public: PCT tests over the standard library ---
# Same convention as test-pure: no deps, run `just build` first.
# Pure PCT tests are already running in the maven execution build
test-pct:
    @{{banner}} '[pure→bootstrap]' 'runPCTTests over meta::pure::functions (assumes `just build` was run)'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --function "meta::pure::test::runPCTTests_String_1__String_1_" \
        --args "meta::pure::functions" {{err_filter}}

# --- Public: Compiler tests ---
# Same convention as test-pure: no deps, run `just build` first.
test-compiler:
    @{{banner}} '[pure→bootstrap]' 'runCompiledGraphTests over pure/specification/compiler'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --function "meta::pure::test::runCompiledGraphTests_String_1__String_1_" \
        --args "{{spec}}/compiler" {{err_filter}}

# Self-host: compile compiler-pure ON the bootstrap Java runtime via the Pure
# compiler (compile-via-pure), producing compiler_bootstrap.pdb, then run
# compiler tests against that PDB. Verifies the bootstrap can run compiler-pure
# end-to-end and produce a usable compiler.
test-self-host: build-compiler-pdb
    @{{banner}} '[self-host-java]' 'compiler-pure → compiler_bootstrap.pdb (Pure compiler)'
    {{pure_bootstrap}} compile-via-pure \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --source {{compiler_src}} \
        --output {{boot_out}}/compiler_bootstrap.pdb {{err_filter}}
    @{{banner}} '[self-host-java]' 'runCompiledGraphTests against compiler_bootstrap.pdb'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{boot_out}}/compiler_bootstrap.pdb \
        --function "meta::pure::test::runCompiledGraphTests_String_1__String_1_" \
        --args "{{spec}}/compiler" {{err_filter}}
    @{{banner}} '[self-host-java]' 'diff compiler.pdb (Java compiler) ↔ compiler_bootstrap.pdb (Pure compiler)'
    {{pure_bootstrap}} diff-pdb --deep --core {{shared_out}}/core.pdb \
        {{shared_out}}/compiler.pdb \
        {{boot_out}}/compiler_bootstrap.pdb {{err_filter}}
    @{{banner}} '[self-host-java]' 'diff compiler_truffle.pdb ↔ compiler_bootstrap.pdb (cross-platform)'
    {{pure_bootstrap}} diff-pdb --deep --core {{shared_out}}/core.pdb \
        {{repo_root}}/platforms/truffle/build/compiler_truffle.pdb \
        {{boot_out}}/compiler_bootstrap.pdb {{err_filter}}

ide: build-compiler-pdb
    @{{banner}} '[ide]' 'launch IDE via bootstrap CLI'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --function "meta::pure::ide::start"

clean:
    @{{banner}} '[bootstrap clean]' 'remove bootstrap/build + mvn target/'
    rm -rf {{boot_out}}
    cd {{boot}} && mvn clean {{mvnq}}

# --- Internal: Maven invocation. `mode` is "skip-tests" (fast, no Java tests)
# or "with-tests" (surefire runs unit tests during the install lifecycle).
# Pick one per top-level run; just dedupes by (recipe, args) so the same mode
# called twice from different deps in one invocation runs once.
_mvn mode:
    @{{banner}} '[bootstrap]' '{{ if mode == "skip-tests" { "mvn clean install -DskipTests (Java + core.pdb)" } else { "mvn clean install (Java + core.pdb + unit tests)" } }}'
    rm -rf {{boot_out}}
    cd {{boot}} && mvn clean install {{ if mode == "skip-tests" { "-DskipTests" } else { "" } }} {{mvnq}} {{err_filter}}





