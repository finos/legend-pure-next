# bootstrap/Justfile — builds and tests the bootstrap Java compiler/CLI.
#
# Direct invocation:    just <recipe>             (from bootstrap/)
# Via the root Justfile: just bootstrap::<recipe> (from repo root)
#
# Outputs split between bootstrap-local and shared:
#   bootstrap/build/pure-bootstrap.jar       — bootstrap-only fat jar
#   <repo>/shared/core.pdb                    — shared (truffle codegen reads it)
#   <repo>/shared/compiler.pdb                — shared
#   bootstrap/build/compiler.pdb (Pure-compiled)   — bootstrap-only (self-host output)
#   <repo>/shared/specification/              — shared (generated spec files)
#
# Two Maven modes selected by argument to a single parameterized `_mvn` recipe:
#   `build`  → `(_mvn "skip-tests")` (mvn install -DskipTests) — fast, no Java tests
#   `test-java` → `(_mvn "with-tests")` (mvn install)          — surefire runs unit tests inline
# `test` is one Maven launch (`test-java`: the Java tests, surefire — including the TestPureExecution /
# TestPCT factories) followed by specification runs of the Pure code on the bootstrap interpreter
# (`spec-*`, via the bootstrap CLI), each writing test-results/spec/<spec>/pure@cli-bootstrap[+<source>].json.
#
# Public steps (`stage`, `build-compiler-pdb`) have no Maven dep of their own;
# the entry-point recipe (`build` or `test`) lists Maven + stage + build-compiler-pdb in order.
#
# The `spec-*` recipes are zero-dep "expert mode" recipes — they assume `just build` (or
# `just test`) has already produced the artifacts. Run them standalone for fast Pure-side
# iteration without re-invoking Maven. `spec` runs every specification run of this host.

set quiet := true
set shell := ["bash", "-c"]

bootstrap_root := source_directory()
repo_root      := bootstrap_root / ".."
# Records heavy build steps for the dashboard build time trend.
build_step     := "node " + repo_root / "tools" / "test-dashboard" / "build-step.mjs"
boot           := bootstrap_root / "legend-pure-next-bootstrap"
bcore          := boot / "legend-pure-next-bootstrap-core"
spec           := repo_root / "pure" / "specification"
compiler_src   := repo_root / "pure" / "specification" / "compiler" / "compiler-pure"
gen_writer     := compiler_src / "pdb" / "writer" / "generated" / "generatedWriter.pure"
mappings_src   := repo_root / "pure" / "specification" / "grammar" / "mapping" / "mappings-pure"
boot_out       := bootstrap_root / "build"
shared_out     := repo_root / "shared"
test_results   := repo_root / "test-results"
cli            := boot_out / "pure-bootstrap.jar"
pure_bootstrap := bootstrap_root / "bin" / "pure-bootstrap"

# verbose=1 disables -q and stops filtering JDK/SLF4J warnings.
verbose := ""
mvnq    := if verbose == "" { "-q" } else { "" }
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

header := "h(){ s=\"[bootstrap::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build + run all tests.
default: test

# Build the Java compiler/CLI and stage core.pdb + compiler.pdb into shared/.
build: (_mvn "skip-tests") stage build-compiler-pdb

# Bootstrap is the root of the dep tree — alias of `build` for symmetry with sub-Justfiles' `build-all`.
build-all: build

# Copy bootstrap CLI jar to bootstrap/build/ and core.pdb / core-tests.pdb / generated specs to shared/.
stage:
    @{{header}} 'stage'
    @{{substep}} 'copy bootstrap jar + core.pdb + core-tests.pdb + parser-mappings.pdb + generated specs'
    mkdir -p {{boot_out}} {{shared_out}}/specification/protocol
    cp {{boot}}/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli/target/pure-bootstrap-*-fat.jar {{cli}}
    cp {{bcore}}/legend-pure-next-bootstrap-compiler/target/classes/core.pdb {{shared_out}}/core.pdb
    cp {{bcore}}/legend-pure-next-bootstrap-compiler/target/classes/core-tests.pdb {{shared_out}}/core-tests.pdb
    # parser-mappings.pdb is produced by bootstrap-grammar-validation's
    # exec-maven-plugin execution into its target/classes/ during `mvn install`;
    # mirror it into shared/ so Truffle's Justfile recipes find it there.
    # Direct iteration on mappings.pure can still use `just build-parser-mappings-pdb`.
    cp {{bcore}}/legend-pure-next-bootstrap-grammar/legend-pure-next-bootstrap-grammar-validation/target/classes/parser-mappings.pdb {{shared_out}}/parser-mappings.pdb
    cp -r {{bcore}}/legend-pure-next-bootstrap-generators/target/generated-specification/* {{shared_out}}/specification/

# Companion compiler-tests.pdb holds the compiler-pure tests; mirrors the
# core.pdb/core-tests.pdb split so the same test discovery path works.

# Generate pdb/writer/generated/generatedWriter.pure (gitignored build output).
#
# The writer defines platform::pure::compiler::pdb::gen::*, and producing it needs a
# compiled generator — which lives in the same module. Nothing references those
# names at COMPILE time: archive.pure and the pdb tests resolve them through
# writerHelper::genFn + evalGenWrite (pathToElement, then eval on a Function cast
# to a concrete signature). So pass 1 compiles a staged copy of compiler-pure with
# only the generated file removed, runs the generator against it, and pass 2
# (build-compiler-pdb) compiles the whole tree with the output in place. ~6s.
#
# Both passes are needed: a clean tree has no compiler.pdb, so the generator has
# to be compiled before it can run, and the output has to be in the PDB for
# pathToElement to find it. Pass 1 works on a COPY so a stale or broken generated
# file can never wedge the build — that is what let it self-heal when the
# writerHelper package was renamed under it.
#
# Generating every build rather than committing the file is deliberate: it is
# derived from m3.fbs + the LIVE METAMODEL, so any class reordered or reparented
# changes what it should be. Committed, it silently went stale once already.
generate-writer:
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'generate-writer'
    # printGeneratedWriter reads 'shared/specification/m3.fbs' RELATIVE to cwd,
    # and just runs recipes from the Justfile's directory — so anchor at the root.
    cd "{{repo_root}}"
    if [[ ! -f "{{shared_out}}/core.pdb" ]]; then
        echo "ERROR: missing {{shared_out}}/core.pdb (run \`just bootstrap::build\` first)" >&2
        exit 1
    fi
    stage=$(mktemp -d); body=$(mktemp); log=$(mktemp)
    trap 'rm -rf "$stage"; rm -f "$body" "$log"' EXIT
    mkdir -p "$stage/src" "$stage/out"
    cp -R "{{compiler_src}}/." "$stage/src/"
    # Only the generated writer: every caller resolves gen:: at runtime, so the
    # rest of compiler-pure — tests included — compiles without it.
    rm -rf "$stage/src/pdb/writer/generated"
    # The test island values' generated writer too (test/islands/generated): it calls the m3 writer.
    rm -rf "$stage/src/test/islands/generated"
    {{substep}} 'pass 1: compile compiler-pure without the generated writer'
    if ! {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --source "$stage/src" \
        --output-dir "$stage/out" \
        --tests split > "$log" 2>&1; then
        echo "" >&2
        echo "ERROR: pass 1 could not compile compiler-pure without pdb/writer/generated/." >&2
        echo "Something now has a COMPILE-TIME reference to the generated writer" >&2
        echo "(platform::pure::compiler::pdb::gen::*). Resolve it at runtime instead, via" >&2
        echo "platform::pure::compiler::pdb::writerHelper::evalGenWrite (or genFn + eval on" >&2
        echo "a Function cast to the concrete signature). Note evaluate() is NOT a" >&2
        echo "substitute: it introspects an argument's runtime type and fails on the" >&2
        echo "ClassPointer anchors the wire-format fixtures use on purpose." >&2
        echo "Compiler errors:" >&2
        echo "" >&2
        grep -E "can.t be found|Can.t resolve|error" "$log" | head -20 >&2
        exit 1
    fi
    {{substep}} 'run printGeneratedWriter -> pdb/writer/generated/generatedWriter.pure'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb "$stage/out/compiler.pdb" \
        --pdb "$stage/out/compiler-tests.pdb" \
        --function "platform::pure::compiler::pdb::generator::printGeneratedWriter__Boolean_1_" 2>/dev/null \
      | awk '/===GENWRITER-BEGIN===/{f=1;next} /===GENWRITER-END===/{f=0} f' > "$body"
    if [[ ! -s "$body" ]]; then
        echo "ERROR: printGeneratedWriter produced no output between its markers" >&2
        exit 1
    fi
    mkdir -p "$(dirname "{{gen_writer}}")"
    # The generator emits only its AUTO-GENERATED banner, so the licence header
    # is prepended here — the file is compiled into compiler.pdb like any source.
    printf '%s\n' \
        '// ©2026 JP Morgan Chase & Co. All rights reserved.' \
        '//' \
        '// Licensed under the Apache License, Version 2.0 (the "License");' \
        '// you may not use this file except in compliance with the License.' \
        '// You may obtain a copy of the License at' \
        '//' \
        '//      http://www.apache.org/licenses/LICENSE-2.0' \
        '//' \
        '// Unless required by applicable law or agreed to in writing, software' \
        '// distributed under the License is distributed on an "AS IS" BASIS,' \
        '// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.' \
        '// See the License for the specific language governing permissions and' \
        '// limitations under the License.' > "{{gen_writer}}"
    cat "$body" >> "{{gen_writer}}"
    echo "  wrote {{gen_writer}} ($(grep -c '^function ' "$body") generated functions)"
    # The test package's island values (test/islands/metamodel.pure: EchoLiteral, RefLiteral) are a language
    # extension's values: their fbs fragment and writer are generated from the metamodel exactly as the
    # diagram's are (pure/extensions/diagram/Justfile `generate`), from pass 1's PDBs. The fragment is also
    # staged beside m3.fbs, where the specification's PDB golden runner and the test language read it.
    {{substep}} 'test island values -> test/islands/generated/{islandTest.fbs,writer.pure}'
    isl="{{compiler_src}}/test/islands"; ids="$isl/islandTest-fbs-field-ids.txt"
    test -f "$ids" || printf '# FlatBuffer field-ID registry — keeps wire format stable across builds.\n# Auto-maintained by RdfFbsSchemaGenerator. Append-only.\n# Format: TableName.field_name=ID\n\n' > "$ids"
    mkdir -p "$isl/generated"
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb --pdb {{shared_out}}/core-tests.pdb \
        --pdb "$stage/out/compiler.pdb" --pdb "$stage/out/compiler-tests.pdb" \
        --function "platform::pure::compiler::pdb::fbsgen::printFbs_String_1__String_1__String_1__Boolean_1_" \
        --args "platform::pure::compiler::test::islands::metamodel" "{{shared_out}}/specification/m3.fbs" "$ids" 2>"$log" > "$body"
    awk '/^===FBS-BEGIN===$/{f=1;next} /^===FBS-END===$/{f=0} f' "$body" > "$isl/generated/islandTest.fbs"
    awk '/^===IDS-BEGIN===$/{f=1;next} /^===IDS-END===$/{f=0} f' "$body" > "$ids"
    test -s "$isl/generated/islandTest.fbs" || { echo "ERROR: printFbs produced nothing for the test island values" >&2; cat "$log" "$body" >&2; exit 1; }
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb --pdb {{shared_out}}/core-tests.pdb \
        --pdb "$stage/out/compiler.pdb" --pdb "$stage/out/compiler-tests.pdb" \
        --function "platform::pure::compiler::pdb::generator::printExtensionWriter_String_1__String_1__String_1__String_1__Boolean_1_" \
        --args "{{shared_out}}/specification/m3.fbs" "$isl/generated/islandTest.fbs" \
               "platform::pure::compiler::test::islands::metamodel" "platform::pure::compiler::test::islands::pdb::gen" 2>"$log" > "$body"
    head -13 "{{gen_writer}}" > "$isl/generated/writer.pure"
    awk '/^===GENWRITER-BEGIN===$/{f=1;next} /^===GENWRITER-END===$/{f=0} f' "$body" >> "$isl/generated/writer.pure"
    grep -q '_pdbValueBlob' "$isl/generated/writer.pure" || { echo "ERROR: printExtensionWriter produced no value writers for the test island values" >&2; cat "$log" "$body" >&2; exit 1; }
    cp "$isl/generated/islandTest.fbs" "{{shared_out}}/specification/islandTest.fbs"
    echo "  wrote test/islands/generated/islandTest.fbs ($(grep -c '^table ' "$isl/generated/islandTest.fbs") tables) and writer.pure"

# The island goldens (pure/specification/compiler/tests-pdb-serialization/valueSpecification/island): the
# archives the island SUCCESS fixtures compile to, written by the Pure writer with the test island handlers
# (the Java compiler cannot build the test package's island values, so PdbGoldenGeneratorTest skips them).
# Read each one back before keeping it.
regen-island-goldens: build-compiler-pdb
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'regen-island-goldens'
    tests="{{spec}}/compiler/tests"; out="{{spec}}/compiler/tests-pdb-serialization/valueSpecification/island"
    mkdir -p "$out"
    for f in $(cd "$tests" && find valueSpecification/island -name '*.pure' ! -name '*_E_*' | sort); do
        name="${f%.pure}"
        {{pure_bootstrap}} execute \
            --pdb {{shared_out}}/core.pdb --pdb {{shared_out}}/core-tests.pdb \
            --pdb {{shared_out}}/compiler.pdb --pdb {{shared_out}}/compiler-tests.pdb \
            --function "platform::pure::compiler::test::pdb::goldenHexOf_String_1__String_1__String_1_" \
            --args "$tests" "$name" 2>/dev/null | grep -v '^\[graal' | tail -1 | tr -d '\n' \
            | xxd -r -p > "$out/$(basename "$name").pdb"
        test -s "$out/$(basename "$name").pdb" || { echo "ERROR: no archive for $name" >&2; exit 1; }
        echo "  wrote tests-pdb-serialization/$name.pdb"
    done

# Compile compiler-pure -> shared/compiler.pdb (lean) + compiler-tests.pdb via the bootstrap CLI.
build-compiler-pdb: (_step-start "bootstrap/compiler-pdb") generate-writer
    @{{header}} 'build-compiler-pdb'
    @{{substep}} 'compile compiler.pdb + compiler-tests.pdb against core.pdb'
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --source {{compiler_src}} \
        --output-dir {{shared_out}} \
        --tests split {{err_filter}}
    {{build_step}} end "bootstrap/compiler-pdb"

# Compile parser-mappings -> shared/parser-mappings.pdb via the bootstrap CLI.
# Mirror of `build-compiler-pdb`; the same PDB is also produced as a classpath
# resource by the bootstrap-grammar-validation Maven module (exec-maven-plugin
# in process-classes), and `stage` copies that target/classes/ copy into
# shared/. This standalone recipe lets you regenerate the file directly after
# editing mappings.pure / interpreter sources, without a full Maven build.
build-parser-mappings-pdb:
    @{{header}} 'build-parser-mappings-pdb'
    @{{substep}} 'compile parser-mappings.pdb against core.pdb'
    {{pure_bootstrap}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --source {{mappings_src}} \
        --output-dir {{shared_out}} {{err_filter}}

# Build + run the Java tests (surefire — including TestPureExecution / TestPCT, the Pure runTests and PCT
# suites over core-tests.pdb) + the compiler corpus and PDB specification runs on the bootstrap interpreter.
test: test-java stage build-compiler-pdb spec-compiler spec-pdb check-fbs-parity

# `test` plus the self-hosted compiler run and both printer corpora.
test-all: test spec-compiler-selfhost spec-functions spec-pct spec-printer-compiled spec-printer-protocol

# Build with surefire-driven Java tests (unit tests, plus the TestPureExecution / TestPCT factories
# that run the Pure runTests and PCT suites).
test-java: (_mvn "with-tests")

# Print silencing for tests is per-test-body now: the Pure test runner wraps
# each <<test.Test>> invocation in withSilencedPrint, which flips a
# thread-local around the body. Runner-side prints (tickProgress, etc.)
# remain visible.

# Every specification run of the bootstrap host (self-host excluded: see `spec-compiler-selfhost`).
spec: spec-compiler spec-pdb check-fbs-parity spec-functions spec-pct spec-printer-compiled spec-printer-protocol

# Needs core-tests.pdb (runTests is <<test.TestDependency>>, classified into the
# tests-only PDB) and compiler-tests.pdb (mirrors the compiler-graph recipe).
# Standalone Pure runTests over platform::pure::functions (assumes `just build` was run).
spec-functions:
    @{{header}} 'spec-functions'
    @{{substep}} 'runTests over platform::pure::functions (assumes `just build` was run)'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "platform::pure::test::runTests_String_1__String_1__String_1_" \
        --args "platform::pure::functions" "{{test_results}}/spec/functions/pure@cli-bootstrap.json" {{err_filter}}

# Needs core-tests.pdb and compiler-tests.pdb for the same reason as spec-functions.
# Standalone Pure PCT tests over platform::pure::functions (assumes `just build` was run).
spec-pct:
    @{{header}} 'spec-pct'
    @{{substep}} 'runPCTTests over platform::pure::functions (assumes `just build` was run)'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "platform::pure::test::runPCTTests_String_1__String_1__String_1_" \
        --args "platform::pure::functions" "{{test_results}}/spec/pct/pure@cli-bootstrap.json" {{err_filter}} || echo "  PCT failures do not fail the build: they are in the report and on the dashboard"

# Parses + compiles each test source, runs the compiled-side printer, and
# counts how many render without hitting an /* UNSUPPORTED */ sentinel.
# Lives separately from spec-compiler because its purpose is to track
# printer coverage, not graph correctness — both run over the same corpus
# but check different things.

# Compiled-printer corpus check over pure/specification/compiler/tests.
spec-printer-compiled:
    @{{header}} 'spec-printer-compiled'
    @{{substep}} 'runCompiledPrinterCorpus over pure/specification/compiler/tests'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "platform::pure::compiler::test::printer::runCompiledPrinterCorpus_String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{test_results}}/pure/printer-compiled/pure@cli-bootstrap.json" {{err_filter}}

# Mirrors spec-printer-compiled for the protocol-side printer: parses each
# grammar.pure, prints, re-parses, prints again, and counts how many files are
# round-trip stable (printer is a fixed point of parse∘print) and how many are
# byte-equal to source. Round-trip failures are real code loss; source-byte
# mismatches are formatting drift, informational only.

# Protocol-printer corpus check over pure/specification/grammar/tests.
spec-printer-protocol:
    @{{header}} 'spec-printer-protocol'
    @{{substep}} 'runProtocolPrinterCorpus over pure/specification/grammar/tests'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "platform::pure::functions::printer::protocol::tests::runProtocolPrinterCorpus_String_1__String_1__String_1_" \
        --args "{{spec}}/grammar/tests" "{{test_results}}/pure/printer-protocol/pure@cli-bootstrap.json" {{err_filter}}

# Pure compiler-graph spec tests over pure/specification/compiler/tests via the bootstrap CLI (Pure-on-Java; assumes `just build` was run). Run as part of `just test`.
spec-compiler:
    @{{header}} 'spec-compiler'
    @{{substep}} 'runCompiledGraphTests over pure/specification/compiler/tests'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "platform::pure::compiler::test::runCompiledGraphTests_String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{test_results}}/spec/compiler/pure@cli-bootstrap.json" {{err_filter}}

# Pure runTests over platform::pure::compiler::pdb (PDB writer/reader tests in compiler-tests.pdb) via the bootstrap CLI.
# The tests live in compiler-tests.pdb, built after the Maven reactor (assumes `just build` was run). Run as part of `just test`.
spec-pdb:
    @{{header}} 'spec-pdb'
    @{{substep}} 'runTests over platform::pure::compiler::pdb'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "platform::pure::test::runTests_String_1__String_1__String_1_" \
        --args "platform::pure::compiler::pdb" "{{test_results}}/spec/pdb-format/pure@cli-bootstrap.json" {{err_filter}}

# The Pure fbs generator (compiler-pure pdb/fbsgen) run over m3 itself must reproduce m3.fbs.
# m3.fbs stays RdfFbsSchemaGenerator's output (from m3.ttl); this keeps the Pure port of its rules —
# which generates every language extension's schema — the same rules. Run as part of `just test`.
check-fbs-parity:
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'check-fbs-parity'
    cd "{{repo_root}}"
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --function "platform::pure::compiler::pdb::fbsgen::printFbsParity_String_1__String_1__Boolean_1_" \
        --args "shared/specification/m3.fbs" "pure/specification/m3-fbs-field-ids.txt" {{err_filter}}

# Self-host: compile compiler-pure on Pure-on-Java, run compiler tests, then diff PDBs vs Java direct (and Truffle if present; assumes `just build` was run).
spec-compiler-selfhost: generate-writer
    @{{header}} 'spec-compiler-selfhost'
    @{{substep}} 'compiler-pure → compiler.pdb (Pure-compiled) (Pure compiler)'
    {{pure_bootstrap}} compile-via-pure \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --source {{compiler_src}} \
        --output-dir {{boot_out}} \
        --tests split {{err_filter}}
    @{{substep}} 'runCompiledGraphTests (from compiler-tests.pdb) against Pure-compiled compiler.pdb'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{boot_out}}/compiler.pdb \
        --pdb {{boot_out}}/compiler-tests.pdb \
        --function "platform::pure::compiler::test::runCompiledGraphTests_String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{test_results}}/spec/compiler/pure@cli-bootstrap+selfhost.json" {{err_filter}}
    @{{substep}} 'diff Java compiler.pdb ↔ Pure-compiled compiler.pdb (both lean)'
    {{pure_bootstrap}} diff-pdb --deep --core {{shared_out}}/core.pdb \
        {{shared_out}}/compiler.pdb \
        {{boot_out}}/compiler.pdb {{err_filter}}

# Launch the Pure IDE via the bootstrap CLI.
ide: build-compiler-pdb
    @{{header}} 'ide'
    @{{substep}} 'launch IDE via bootstrap CLI'
    {{pure_bootstrap}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --function "platform::pure::ide::start"

# Remove bootstrap/build/ and run mvn clean.
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove bootstrap/build, the generated PDB writer, mvn target/ and shade poms'
    rm -rf {{boot_out}} {{compiler_src}}/pdb/writer/generated
    cd {{boot}} && mvn clean {{mvnq}}
    find {{boot}} -name dependency-reduced-pom.xml -not -path '*/target/*' -delete

# Internal: parameterized `mvn clean install` invocation.
# `mode` is "skip-tests" (fast, no Java tests) or "with-tests" (surefire runs unit tests).
# just dedupes by (recipe, args), so the same mode invoked twice via different deps in one
# `just` run executes once.
_mvn mode: (_step-start "bootstrap/maven-" + mode)
    @{{header}} '_mvn'
