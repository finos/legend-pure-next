# The compiler written in Pure compiled on the bootstrap (compile-via-pure), and what is generated from it, against what
# the bootstrap compiles in Java, element for element.

load("//tools/bazel:pure.bzl", "compiler_selfhost")

compiler_selfhost(
    "bootstrap",
    command = "compile-via-pure",
    parser_mappings = False,
    tags = ["bootstrap"],
    tool = "bootstrap",
)
