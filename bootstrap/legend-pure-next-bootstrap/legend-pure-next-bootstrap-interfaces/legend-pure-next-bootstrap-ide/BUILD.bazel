# The Pure IDE: a language server and a web page over the bootstrap.

load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_library(
    name = "ide",
    srcs = glob(["src/main/java/**/*.java"]),
    resource_strip_prefix = package_name() + "/src/main/resources",
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    deps = [
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-runtime:runtime",
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli:cli",
        "@maven//:com_google_code_gson_gson",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
        "@maven//:org_eclipse_lsp4j_org_eclipse_lsp4j",
        "@maven//:org_eclipse_lsp4j_org_eclipse_lsp4j_jsonrpc",
        "@maven//:org_java_websocket_Java_WebSocket",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

java_binary(
    name = "pure-ide",
    main_class = "org.finos.legend.pure.ide.PureIDEMain",
    runtime_deps = [
        ":ide",
        "@maven//:org_slf4j_slf4j_nop",
    ],
)
