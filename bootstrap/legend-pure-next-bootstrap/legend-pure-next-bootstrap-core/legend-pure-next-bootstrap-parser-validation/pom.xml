<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-next-bootstrap-core</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>legend-pure-next-bootstrap-parser-validation</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - Bootstrap - Parser Validation</name>
    <description>
        Validates the Pure-data parser visitor mappings (mappings.pure)
        by running them through the Pure interpreter against the same
        ANTLR parse tree the production parser walks, and asserting
        equivalent protocol output. Sits downstream of both `parser` and
        `execution` to avoid a dependency cycle in the parser module.
    </description>

    <dependencies>
        <!-- Parser: source of the production .dsl-derived PureLanguageParser
             (the oracle), the ANTLR M3Lexer/M3Parser, and the JSON serializer
             used to diff protocol outputs. -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-bootstrap-parser</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Execution: PureExecution + NativeExtension that drive the
             interpreter consuming shared/parser-mappings.pdb. -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-bootstrap-execution</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- bootstrap-cli is invoked by the exec-maven-plugin execution
             below to produce parser-mappings.pdb. Declared at provided scope
             so it doesn't bleed into transitive deps, but having the
             dependency forces the Maven reactor to build bootstrap-cli (and
             its fat-jar) before this module's process-classes runs. -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-bootstrap-cli</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ANTLR runtime (re-exported by parser, declared explicitly for clarity). -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
        </dependency>

        <!-- Eclipse Collections -->
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Build parser-mappings.pdb into this module's target/classes/ so
                it lives alongside core.pdb / compiler.pdb as a classpath
                resource. The validator test loads it through
                BootstrapModule.locateParserMappingsPdb() (the same extract-from-
                classpath helper used for core.pdb), so the test no longer
                depends on `shared/parser-mappings.pdb` being produced by a
                separate Justfile recipe ahead of time — the Maven reactor
                (which builds bootstrap-cli + bootstrap-compiler before this
                module) gives us the CLI jar and core.pdb on disk by the time
                process-classes fires.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-parser-mappings-pdb</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.basedir}/../../legend-pure-next-bootstrap-cli/target/pure-bootstrap-${project.version}-fat.jar</argument>
                                <argument>compile</argument>
                                <argument>--base-pdb</argument>
                                <argument>${project.basedir}/../legend-pure-next-bootstrap-compiler/target/classes/core.pdb</argument>
                                <argument>--source</argument>
                                <argument>${project.basedir}/../../../../pure/specification/grammar/mapping/mappings-pure</argument>
                                <argument>--output-dir</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Duser.timezone=UTC</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
