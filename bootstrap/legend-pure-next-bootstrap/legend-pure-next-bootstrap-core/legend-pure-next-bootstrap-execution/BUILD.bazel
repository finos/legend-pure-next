# The interpreter of compiled Pure.

load("@rules_java//java:defs.bzl", "java_library")

java_library(
    name = "execution",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    exports = ["//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-compiler:compiler"],
    deps = [
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-compiler:compiler",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)
