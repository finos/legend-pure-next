<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-next-bootstrap-core</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>legend-pure-next-bootstrap-parser</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - Bootstrap - Parser</name>
    <description>Parser for Pure M3 protocol model.</description>

    <properties>
        <spec.dir>${project.basedir}/../../../../pure/specification</spec.dir>
        <gen.spec.dir>${project.build.directory}/generated-specification</gen.spec.dir>
    </properties>

    <dependencies>
        <!-- RDF Generators (for exec-maven-plugin invocation) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-bootstrap-generators</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ANTLR runtime (used by specification ANTLR classes) -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
        </dependency>

        <!-- Jackson 3 databind/datatype: only used by the protocol JSON serializer in src/test -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.datatype</groupId>
            <artifactId>jackson-datatype-eclipse-collections</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Eclipse Collections -->
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Unpack generated specification from generators JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-generated-spec</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.finos.legend.pure</groupId>
                                    <artifactId>legend-pure-next-bootstrap-generators</artifactId>
                                    <version>${project.version}</version>
                                    <includes>generated-specification/**</includes>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Step 1: Copy ANTLR grammars from pure/specification/ into Java-package directory
                 layouts that antlr4-maven-plugin can consume.
                 - M3 source grammar  → org/finos/legend/pure/next/parser/m3/
                 - Visitor-mapping DSL grammar → org/finos/legend/pure/next/parser/m3/codegen/mapping/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-m3-antlr-grammars</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/antlr4/org/finos/legend/pure/next/parser</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${spec.dir}/grammar/antlr</directory>
                                    <includes>
                                        <include>**/*.g4</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-visitor-mapping-grammar</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/antlr4/org/finos/legend/pure/next/parser/codegen/mapping</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${spec.dir}/grammar/mapping/antlr</directory>
                                    <includes>
                                        <include>**/*.g4</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- ANTLR4 plugin -->
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>antlr</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.build.directory}/antlr4</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources</outputDirectory>
                            <visitor>true</visitor>
                            <listener>false</listener>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Pre-compile the codegen sub-package (PureLanguageVisitorMappingGenerator + the ANTLR
                 mapping parser/lexer) before the visitor-generation exec below. This is the
                 bootstrap step: the compiler lives in this module but must be runnable in the
                 generate-sources phase, before the regular `compile` phase processes the rest
                 of src/main/java. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/codegen/**/*.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Protocol Java class generation from m3_protocol.ttl (generated by generators module) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-protocol-classes</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.finos.legend.pure.generators.RdfJavaGenerator</mainClass>
                            <arguments>
                                <argument>${gen.spec.dir}/m3_protocol.ttl</argument>
                                <argument>${project.build.directory}/generated-sources</argument>
                                <argument>org.finos.legend.pure.m3.generated.protocol</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- M3 visitor: emit PureLanguageProtocolBuilder.java by compiling the visitor-mapping
                         DSL at pure/specification/grammar/mapping/pure-language-mappings.dsl. The
                         generated class extends M3ParserBaseVisitor directly; there is no
                         hand-written parent. To port the parser to another target language,
                         port the DSL and the PureLanguageVisitorMappingGenerator (grammar lives in
                         pure/specification/grammar/mapping/antlr/). -->
                    <execution>
                        <id>generate-m3-visitor</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.finos.legend.pure.next.parser.pureLanguage.codegen.ProtocolPureLanguageVisitorMappingGenerator</mainClass>
                            <arguments>
                                <argument>${spec.dir}/grammar/mapping/pure-language-mappings.dsl</argument>
                                <argument>${project.build.directory}/generated-sources/org/finos/legend/pure/next/parser/pureLanguage/PureLanguageProtocolBuilder.java</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Top-level visitor: emit TopLevelProtocolBuilder.java from
                         top-mappings.dsl. Built methods drive section detection +
                         dispatch — replaces the hand-written TopLevelParser body. -->
                    <execution>
                        <id>generate-top-visitor</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.finos.legend.pure.next.parser.topLevel.codegen.ProtocolTopLevelGenerator</mainClass>
                            <arguments>
                                <argument>${spec.dir}/grammar/mapping/top-mappings.dsl</argument>
                                <argument>${project.build.directory}/generated-sources/org/finos/legend/pure/next/parser/topLevel/TopLevelProtocolBuilder.java</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        
        </plugins>
    </build>
</project>
