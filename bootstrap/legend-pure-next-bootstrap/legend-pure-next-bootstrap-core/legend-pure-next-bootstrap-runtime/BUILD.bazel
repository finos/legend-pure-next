# The runtime the interpreter runs Pure with.

load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:junit5.bzl", "junit5_test")

java_library(
    name = "runtime",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    exports = ["//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-execution:execution"],
    deps = [
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-execution:execution",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)

junit5_test(
    name = "tests",
    # The bootstrap own tests run on demand (spec Section 3).
    tags = ["bootstrap", "manual"],
    srcs = glob(["src/test/java/**/*.java"]),
    data = ["//pure/specification:all"],
    jvm_flags = ["-Duser.timezone=UTC"],
    deps = [
        ":runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)
