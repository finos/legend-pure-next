# The runtime the interpreter runs Pure with.

load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:junit5.bzl", "junit5_test")

# The language manifests compileSource compiles with (PureCompilation.LANGUAGES), on the class path at languages/,
# as Truffle stages them.
genrule(
    name = "language_resources",
    srcs = [
        "//pure/extensions/diagram:language_diagram.json",
        "//pure/extensions/pure/tds:language_tds.json",
        "//pure/specification:language_pure.json",
        "//pure/specification:language_test.json",
    ],
    outs = [
        "languages/language_diagram.json",
        "languages/language_tds.json",
        "languages/language_pure.json",
        "languages/language_test.json",
    ],
    cmd = "cp $(SRCS) $(RULEDIR)/languages/",
)

java_library(
    name = "runtime",
    srcs = glob(["src/main/java/**/*.java"]),
    resource_strip_prefix = package_name(),
    resources = [":language_resources"],
    visibility = ["//visibility:public"],
    exports = ["//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-execution:execution"],
    deps = [
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-execution:execution",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)

junit5_test(
    name = "junit",
    # On every pull request, in the bootstrap job: the bootstrap builds every PDB the hosts load.
    tags = ["bootstrap", "job:bootstrap"],
    srcs = glob(["src/test/java/**/*.java"]),
    data = ["//pure/specification:specification_files"],
    jvm_flags = ["-Duser.timezone=UTC"],
    deps = [
        ":runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)
