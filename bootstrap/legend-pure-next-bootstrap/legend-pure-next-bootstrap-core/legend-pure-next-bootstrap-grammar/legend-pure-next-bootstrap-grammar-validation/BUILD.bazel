# The Pure parser checked against the Java one: parser-mappings.pdb, compiled by the bootstrap CLI from the grammar
# mappings (Maven: build-parser-mappings-pdb), and the tests that read it from the classpath.

load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:junit5.bzl", "junit5_test")

_CLI = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli:pure-bootstrap"

_CORE_PDB = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-compiler:core.pdb"

genrule(
    name = "parser_mappings_pdb",
    srcs = [
        _CORE_PDB,
        "//pure/specification:parser_mappings_sources",
    ],
    outs = ["parser-mappings.pdb"],
    cmd = """
        set -e
        T=$$(mktemp -d)
        $(execpath %s) compile --base-pdb $(execpath %s) --source pure/specification/grammar/mapping/mappings-pure \
            --output-dir $$T > /dev/null
        cp $$T/parser-mappings.pdb $@
    """ % (_CLI, _CORE_PDB),
    tools = [_CLI],
    visibility = ["//visibility:public"],
)

java_library(
    name = "parser_mappings",
    resource_strip_prefix = package_name(),
    resources = [":parser-mappings.pdb"],
)

junit5_test(
    name = "tests",
    # The bootstrap own tests run on demand (spec Section 3).
    tags = ["bootstrap", "manual"],
    srcs = glob(["src/test/java/**/*.java"]),
    data = ["//pure/specification:all"],
    jvm_flags = ["-Duser.timezone=UTC"],
    runtime_deps = [":parser_mappings"],
    deps = [
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-grammar/legend-pure-next-bootstrap-grammar-parser:grammar-parser",
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-runtime:runtime",
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli:cli",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)
