# The Pure parser checked against the Java one: parser-mappings.pdb (//pure/specification:parser_mappings_compile),
# and the tests that read it from the classpath.

load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:junit5.bzl", "junit5_test")

_CLI = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli:pure-bootstrap"

_CORE_PDB = "//pure/specification:core.pdb"

java_library(
    name = "parser_mappings",
    resource_strip_prefix = "pure/specification",
    resources = ["//pure/specification:parser-mappings.pdb"],
)

junit5_test(
    name = "junit",
    # On every pull request, in the bootstrap job: the bootstrap builds every PDB the hosts load.
    tags = ["bootstrap", "job:bootstrap"],
    srcs = glob(["src/test/java/**/*.java"]),
    data = ["//pure/specification:specification_files"],
    jvm_flags = ["-Duser.timezone=UTC"],
    runtime_deps = [":parser_mappings"],
    deps = [
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-grammar/legend-pure-next-bootstrap-grammar-parser:grammar-parser",
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-runtime:runtime",
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-cli:cli",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)
