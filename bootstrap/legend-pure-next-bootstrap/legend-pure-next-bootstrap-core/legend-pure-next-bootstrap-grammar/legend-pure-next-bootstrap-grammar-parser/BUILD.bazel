# The M3 and top-level parsers: ANTLR over pure/specification/grammar/antlr, and the protocol classes generated from
# m3_protocol.ttl (Maven: the antlr4 and generate-protocol-classes executions of this pom).

load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:antlr.bzl", "antlr_srcjar")
load("//tools/bazel:junit5.bzl", "junit5_test")
load("//tools/bazel:srcjar.bzl", "generated_srcjar")

_GENERATORS = "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-generators"

antlr_srcjar(
    name = "antlr_sources",
    srcs = ["//pure/specification:grammar_antlr"],
    grammar_dir = "pure/specification/grammar/antlr",
    grammars = [
        ("", ["TopLexer.g4", "TopParser.g4"]),
        ("m3", ["M3Lexer.g4", "M3Parser.g4"]),
    ],
    package = "org.finos.legend.pure.next.parser",
)

generated_srcjar(
    name = "protocol_sources",
    srcs = [_GENERATORS + ":m3_protocol_ttl"],
    cmd = "$(execpath %s:RdfJavaGenerator) $(execpath %s:m3_protocol_ttl) $$OUT_DIR org.finos.legend.pure.m3.generated.protocol" % (_GENERATORS, _GENERATORS),
    tools = [_GENERATORS + ":RdfJavaGenerator"],
)

java_library(
    name = "grammar-parser",
    srcs = glob(["src/main/java/**/*.java"]) + [
        ":antlr_sources",
        ":protocol_sources",
    ],
    visibility = ["//visibility:public"],
    exports = ["@maven//:org_antlr_antlr4_runtime"],
    deps = [
        _GENERATORS + ":generators",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)

junit5_test(
    name = "tests",
    # On every pull request, in the bootstrap job: the bootstrap builds every PDB the hosts load.
    tags = ["bootstrap", "job:bootstrap"],
    srcs = glob(["src/test/java/**/*.java"]),
    data = ["//pure/specification:grammar_tests"],
    deps = [
        ":grammar-parser",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
        "@maven//:tools_jackson_core_jackson_core",
        "@maven//:tools_jackson_core_jackson_databind",
        "@maven//:tools_jackson_datatype_jackson_datatype_eclipse_collections",
    ],
)
