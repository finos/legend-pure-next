import meta::pure::compiler::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::extension::*;
import meta::pure::functions::lang::*;

function meta::pure::compiler::elements::compileProfilePass1(pr:meta::pure::protocol::grammar::extension::Profile[1], ctx:CompilerContext[1]):CompilerContext[1]
{
    let packagePath = if($pr.package->isEmpty(), | '', | $pr.package->toOne().pointerValue);
    let prName = if($pr.package->isEmpty(), | '', | $packagePath + '::') + $pr.name;
    let rootPkg = ^Package(name = 'Root');
    let emptyProfile = new(
        ^UserDefinedGenericType(type = Profile)
    )->cast(@Profile);

    let profileSkeletonInt = ^$emptyProfile(
        name = $pr.name,
        package = ^Package(name = $packagePath, package = $rootPkg),
        p_stereotypes = $pr.p_stereotypes->map(s |
            let stInst = new(
                ^UserDefinedGenericType(type = Stereotype)
            )->cast(@Stereotype);
            ^$stInst(value = $s.value, profile = ~.~);
        ),
        p_tags = $pr.p_tags->map(t |
            let tagInst = new(
                ^UserDefinedGenericType(type = Tag)
            )->cast(@Tag);
            ^$tagInst(value = $t.value, profile = ~.~);
        ),
        sourceInformation = $pr.p_sourceInformation->map(si | ^SourceInformation(
            sourceId = $si.sourceId,
            startLine = $si.startLine,
            startColumn = $si.startColumn,
            endLine = $si.endLine,
            endColumn = $si.endColumn
        ))
    );

    let profileSkeleton = ^$profileSkeletonInt(
        classifierGenericType = ^UserDefinedGenericType(
            type = Profile
        )
    );

    ^$ctx(elementMap=$ctx.elementMap->put($prName, $profileSkeleton));
}
