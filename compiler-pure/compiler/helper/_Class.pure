// Class helpers — property lookup across inheritance hierarchy

function meta::pure::compiler::helper::class::findProperty(owner:Any[1], name:String[1]):Property<Nil, Any|*>[0..1]
{
    $owner->match(
        [
            cls : Class<Any>[1] |
                // Direct properties
                let directMatch = $cls.properties->filter(p | $p.name == $name);
                if($directMatch->isNotEmpty(),
                    | $directMatch->head(),
                    | // Association properties
                      let assocMatch = $cls.propertiesFromAssociations->filter(p | $p.name == $name);
                      if($assocMatch->isNotEmpty(),
                          | $assocMatch->head(),
                          | // Inherited properties via generalizations
                            let inherited = $cls.generalizations
                                ->map(g | $g.general->genericTypeRawType())
                                ->map(superType | $superType->findProperty($name))
                                ->filter(p | $p->isNotEmpty())
                                ->head();
                            $inherited;
                      );
                );,
            a : Any[1] | []
        ]
    )
}

// Context-aware findProperty: resolves each parent class from the element map
// so that association properties (registered during pass 2) are visible.
function meta::pure::compiler::helper::class::findProperty(owner:Any[1], name:String[1], context:CompilerContext[1]):Property<Nil, Any|*>[0..1]
{
    $owner->match(
        [
            cls : Class<Any>[1] |
                let directMatch = $cls.properties->filter(p | $p.name == $name);
                if($directMatch->isNotEmpty(),
                    | $directMatch->head(),
                    | let assocMatch = $cls.propertiesFromAssociations->filter(p | $p.name == $name);
                      if($assocMatch->isNotEmpty(),
                          | $assocMatch->head(),
                          | let inherited = $cls.generalizations
                                ->map(g | $g.general->genericTypeRawType())
                                ->filter(t | $t->instanceOf(Class))
                                ->map(t |
                                    let superPath = $t->cast(@PackageableElement)->elementToPath();
                                    let resolved = $context->resolveElement($superPath);
                                    let superCls = if($resolved->isNotEmpty(),
                                        | $resolved->toOne()->match([c:Class<Any>[1] | $c, a:Any[1] | $t]),
                                        | $t
                                    );
                                    $superCls->findProperty($name, $context);
                                )
                                ->filter(p | $p->isNotEmpty())
                                ->head();
                            $inherited;
                      );
                );,
            a : Any[1] | []
        ]
    )
}

function meta::pure::compiler::helper::class::findQualifiedProperties(cls:Class<Any>[1], name:String[1]):QualifiedProperty<Any>[*]
{
    // Direct qualified properties
    let directMatch = $cls.qualifiedProperties->filter(qp | $qp.name == $name);
    // Inherited qualified properties via generalizations
    let inherited = $cls.generalizations
        ->map(g | $g.general->genericTypeRawType())
        ->filter(t | $t->instanceOf(Class))
        ->map(t | $t->cast(@Class<Any>)->findQualifiedProperties($name));
    $directMatch->concatenate($inherited);
}

// Context-aware findQualifiedProperties: resolves each parent class from the element map.
function meta::pure::compiler::helper::class::findQualifiedProperties(cls:Class<Any>[1], name:String[1], context:CompilerContext[1]):QualifiedProperty<Any>[*]
{
    let directMatch = $cls.qualifiedProperties->filter(qp | $qp.name == $name);
    let inherited = $cls.generalizations
        ->map(g | $g.general->genericTypeRawType())
        ->filter(t | $t->instanceOf(Class))
        ->map(t |
            let superPath = $t->cast(@PackageableElement)->elementToPath();
            let resolved = $context->resolveElement($superPath);
            let superCls = if($resolved->isNotEmpty(),
                | $resolved->toOne()->match([c:Class<Any>[1] | $c, a:Any[1] | $t->cast(@Class<Any>)]),
                | $t->cast(@Class<Any>)
            );
            $superCls->findQualifiedProperties($name, $context);
        );
    $directMatch->concatenate($inherited);
}


// buildBindingsFromGenericType — zips class type/multiplicity params with receiver type args

function meta::pure::compiler::helper::class::buildBindingsFromGenericType(ownerClass:Class<Any>[1], receiverType:GenericType[1]):ParametersBinding[1]
{
    let typeArgs = $receiverType->genericTypeTypeArguments();
    let mulArgs = $receiverType->genericTypeMultiplicityArguments();

    let withTypes = $ownerClass.typeParameters->zip($typeArgs)->fold({pair, b |
        $b->addTypeBinding($pair.first, $pair.second);
    }, newPlainParametersBinding()->cast(@ParametersBinding));

    $ownerClass.multiplicityParameters->zip($mulArgs)->fold({pair, b |
        $b->addMultiplicityBinding($pair.first, $pair.second);
    }, $withTypes->cast(@ParametersBinding));
}


// Tests

Class <<test.TestDependency>> meta::pure::compiler::helper::class::tests::SuperClass
{
    superProp : String[1];
    superQual(a:String[1]) { $a } : String[1];
    overloadedQual(a:String[1]) { $a } : String[1];
}

Class <<test.TestDependency>> meta::pure::compiler::helper::class::tests::SubClass extends meta::pure::compiler::helper::class::tests::SuperClass
{
    subProp : Integer[1];
    subQual(a:String[1]) { $a } : String[1];
    overloadedQual(a:String[1], b:String[1]) { $a } : String[1];
}

Association <<test.TestDependency>> meta::pure::compiler::helper::class::tests::Asso
{
    origin : meta::pure::compiler::helper::class::tests::SubClass[1];
    assocProp : meta::pure::compiler::helper::class::tests::SuperClass[1];
}

function <<test.Test>> meta::pure::compiler::helper::class::tests::testFindProperty():Boolean[1]
{
    let subClass = meta::pure::compiler::helper::class::tests::SubClass;

    // Direct
    let subProp = $subClass->findProperty('subProp');
    assert($subProp->isNotEmpty());
    assertEquals('subProp', $subProp->toOne().name);

    // Inherited
    let superProp = $subClass->findProperty('superProp');
    assert($superProp->isNotEmpty());
    assertEquals('superProp', $superProp->toOne().name);

    // Association
    let assocProp = $subClass->findProperty('assocProp');
    assert($assocProp->isNotEmpty());
    assertEquals('assocProp', $assocProp->toOne().name);

    // Not Found
    let notFound = $subClass->findProperty('notFound');
    assert($notFound->isEmpty());
}

function <<test.Test>> meta::pure::compiler::helper::class::tests::testFindQualifiedProperties():Boolean[1]
{
    let subClass = meta::pure::compiler::helper::class::tests::SubClass;

    assertEquals(1, $subClass->findQualifiedProperties('subQual')->size());
    assertEquals(1, $subClass->findQualifiedProperties('superQual')->size());
    // Since SubClass defines overloadedQual with different signature than SuperClass, both are returned
    assertEquals(2, $subClass->findQualifiedProperties('overloadedQual')->size());

    assertEquals(0, $subClass->findQualifiedProperties('notFound')->size());
}

Class <<test.TestDependency>> meta::pure::compiler::helper::class::tests::Wrapper<Z>
{
}

Class <<test.TestDependency>> meta::pure::compiler::helper::class::tests::MyClass<T, U|m>
{
}

Class <<test.TestDependency>> meta::pure::compiler::helper::class::tests::TestClass
{
    prop : meta::pure::compiler::helper::class::tests::MyClass<meta::pure::compiler::helper::class::tests::Wrapper<String>, Integer | 1..*>[1];
}

function <<test.Test>> meta::pure::compiler::helper::class::tests::testBuildBindingsFromGenericType():Boolean[1]
{
    let ownerClass = meta::pure::compiler::helper::class::tests::MyClass;
    let prop = meta::pure::compiler::helper::class::tests::TestClass.properties->filter(p | $p.name == 'prop')->toOne();
    let receiverType = $prop.genericType->toOne();

    let bindings = $ownerClass->buildBindingsFromGenericType($receiverType);
    
    let tKeys = $bindings.typeBindings->keys();
    assertEquals(['T', 'U'], $tKeys->sort());
    
    let mKeys = $bindings.multiplicityBindings->keys();
    assertEquals(['m'], $mKeys);
    
    let tBinding = $bindings.typeBindings->get('T')->toOne().values->at(0);
    assertEquals(meta::pure::compiler::helper::class::tests::Wrapper, $tBinding->genericTypeRawType()->toOne());
    assertEquals(String, $tBinding->genericTypeTypeArguments()->at(0)->genericTypeRawType()->toOne());
    
    let uBinding = $bindings.typeBindings->get('U')->toOne().values->at(0);
    assertEquals(Integer, $uBinding->genericTypeRawType()->toOne());

    let mBinding = $bindings.multiplicityBindings->get('m')->toOne().values->at(0);
    assertEquals(1, $mBinding->multiplicityLowerBound());
    assertEquals(-1, $mBinding->multiplicityUpperBound());

    assertEquals('{T=Wrapper<String>, U=Integer | m=[1..*]}', $bindings->toString());
}
