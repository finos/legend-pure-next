import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::compiler::resolution::functionDefinitionResolver::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::resolveAtomicValue(av:AtomicValue[1], scope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    $av.value->match(
        [
            lambda : LambdaFunction<Any>[1] |
                let lambdaParams = $lambda.parameters->cast(@VariableExpression);
                // Skip body resolution if lambda params don't have concrete types (like Java processLambda lines 79-88)
                // Java uses inScopeTypeParamNames() which returns only the ENCLOSING OWNER's type params,
                // NOT the current function's type params pushed by the fixpoint. Use isConcreteGenericType
                // (not InContext) to match Java's behavior — the fixpoint's LAMBDA dispatch will fill
                // param types from bindings via setMissingLambdaParameterInformation.
                // CompilerNotSetGenericType/Multiplicity means "not set yet" (Java equivalent: null).
                // isConcreteGenericType/isConcreteMultiplicity return false for CompilerNotSet types.
                let paramsAreConcrete = $lambdaParams->forAll(p |
                    $p.genericType->toOne()->isConcreteGenericType()
                    && $p.multiplicity->toOne()->isConcreteMultiplicity()
                );
                if(!$paramsAreConcrete,
                    | debug($context, | 'resolveAtomicValue: LAMBDA params not concrete in context, deferring');
                      let siCtx = formatMetamodelSourceInfo($av.sourceInformation, $context);
                      // Return av with CompilerNotSetGenericType (matches Java where av._genericType() is null/not-set).
                      // This prevents the collection resolver from seeing a concrete type for unresolvable lambdas,
                      // ensuring the Collection branch in resolveParameterValue is reached instead of the CONCRETE branch.
                      ^CompilerResult<ValueSpecification>(
                          value = ^$av(genericType = ^CompilerNotSetGenericType()),
                          context = ^$context(errors += 'Can\'t resolve lambda parameter types' + $siCtx)
                      );,
                    | // Check for lambda param names that conflict with existing scope variables (matches Java AtomicValueResolver line 91)
                      let siCtx = formatMetamodelSourceInfo($av.sourceInformation, $context);
                      let conflictCtx = $lambdaParams->fold({p, c |
                          let conflict = $scope->filter(s | $s.name == $p.name);
                          if($conflict->isNotEmpty(),
                              | ^$c(errors += 'Variable \'' + $p.name + '\' is already defined' + $siCtx),
                              | $c
                          );
                      }, $context);
                      debug($conflictCtx, | 'resolveAtomicValue: LAMBDA resolving body');
                      let innerScope = $scope->concatenate($lambdaParams);
                      let resolveResult = resolveExpressionSequence($lambda.expressionSequence, $innerScope, $conflictCtx);
                      let ctx1 = $resolveResult.context;
                      // Compute lambda genericType from body return type (mirrors Java _Lambda.buildFunctionType).
                      // In Java, FunctionExpression body expressions have InferredGenericType from finalizeFunctionExpression.
                      // Only wrap as inferred when the last expression is a FunctionExpression (which went through finalize).
                      let bodyReturnGT = if($resolveResult.resolvedSpecs->isEmpty(),
                          | ^CompilerNotSetGenericType(),
                          | let lastExpr = $resolveResult.resolvedSpecs->at($resolveResult.resolvedSpecs->size() - 1);
                            if($lastExpr.genericType->isEmpty() || $lastExpr.genericType->toOne()->instanceOf(CompilerNotSetGenericType),
                                | ^CompilerNotSetGenericType(),
                                | $lastExpr.genericType->toOne()
                            );
                      );
                      let bodyReturnMul = if($resolveResult.resolvedSpecs->isEmpty(),
                          | PureOne,
                          | let lastExpr = $resolveResult.resolvedSpecs->at($resolveResult.resolvedSpecs->size() - 1);
                            if($lastExpr.multiplicity->isEmpty(), | PureOne, | $lastExpr.multiplicity->toOne());
                      );
                      let lambdaFT = meta::pure::functions::lang::new(
                          ^UserDefinedGenericType(type = FunctionType)
                      )->cast(@FunctionType);
                      let ft = ^$lambdaFT(parameters = $lambdaParams, returnType = $bodyReturnGT, returnMultiplicity = $bodyReturnMul);
                      let lambdaGT = ^InferredGenericType(
                          type = LambdaFunction,
                          typeArguments = [^InferredGenericType(type = $ft)]
                      );
                      // Collect open variables by walking the resolved expression tree
                      let paramNames = $lambdaParams->map(p | $p.name->toOne());
                      let resolvedOpenVars = meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($resolveResult.resolvedSpecs->cast(@ValueSpecification), $paramNames);
                      let resolvedLambda = ^$lambda(
                          expressionSequence = $resolveResult.resolvedSpecs->cast(@ValueSpecification),
                          classifierGenericType = $lambdaGT,
                          openVariables = $resolvedOpenVars
                      );
                      debug($context, | 'resolveAtomicValue: LAMBDA gt=' + printGenericType($lambdaGT));
                      ^CompilerResult<ValueSpecification>(
                          value = ^$av(value = $resolvedLambda, genericType = $lambdaGT),
                          context = $ctx1
                      );
                );,
            a : Any[1] |
                // For element references, refresh from the map to get up-to-date classifierGenericType
                if($a->instanceOf(PackageableElement),
                    | let path = $a->cast(@PackageableElement)->elementToPath();
                      let fromMap = $context->resolveElement($path);
                      if($fromMap->isNotEmpty(),
                          | let resolved = $fromMap->toOne()->cast(@PackageableElement);
                            let resolvedCGT = $resolved->cast(@Any).classifierGenericType;
                            let updatedGT = if($resolvedCGT->isEmpty(), | $av.genericType, | asInferredGenericType($resolvedCGT->toOne()));
                            ^CompilerResult<ValueSpecification>(value = ^$av(value = $resolved, genericType = $updatedGT->toOne()), context = $context);,
                          | ^CompilerResult<ValueSpecification>(value = $av, context = $context)
                      );,
                    | ^CompilerResult<ValueSpecification>(value = $av, context = $context)
                )
        ]
    );
}

function meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables(specs:ValueSpecification[*], paramNames:String[*]):VariableExpression[*]
{
    let result = $specs->fold({vs, acc |
        $vs->match([
            ve:VariableExpression[1] |
                if($paramNames->contains($ve.name->toOne()) || $acc->exists(a | $a.name == $ve.name),
                    | $acc,
                    | $acc->concatenate($ve)
                ),
            fe:FunctionExpression[1] |
                $acc->concatenate(meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($fe.parametersValues->cast(@ValueSpecification), $paramNames)),
            av:AtomicValue[1] |
                if($av.value->toOne()->instanceOf(LambdaFunction),
                    | let innerLambda = $av.value->toOne()->cast(@LambdaFunction<Any>);
                      let innerParamNames = $paramNames->concatenate($innerLambda.parameters->cast(@VariableExpression)->map(p | $p.name->toOne()));
                      $acc->concatenate(meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($innerLambda.expressionSequence->cast(@ValueSpecification), $innerParamNames));,
                    | $acc
                ),
            col:Collection[1] |
                $acc->concatenate(meta::pure::compiler::resolution::valueSpecification::atomicValueResolver::collectOpenVariables($col.values->cast(@ValueSpecification), $paramNames)),
            a:Any[1] | $acc
        ]);
    }, []->cast(@VariableExpression));
    $result->removeDuplicatesBy(v | $v.name->toOne());
}
