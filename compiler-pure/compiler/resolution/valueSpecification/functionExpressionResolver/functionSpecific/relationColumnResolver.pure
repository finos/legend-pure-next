// Mirrors Java RelationColumnResolver.java
// Handles relation-column-specific enrichment for "magical" column spec
// functions such as funcColSpec, aggColSpec, funcColSpecArray, aggColSpecArray, and colSpecArray.

import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::metamodel::relation::*;
import meta::pure::metamodel::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionApplicationResolver::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::helper::type::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::enrichRelationTypeHolderForMagicalFunctions(funcName:String[1], resolvedParams:ValueSpecification[*], ft:FunctionType[1], bindings:meta::pure::compiler::helper::parametersBinding::ParametersBinding[1], context:CompilerContext[1], exprSourceInformation:SourceInformation[0..1]):EnrichResult[1]
{
    let bindingsDebug = $bindings.typeBindings->keys()->map(k | $k + '=' + printGenericType($bindings.typeBindings->get($k)->toOne().values->at(0)));
    debug($context, | 'enrichRelationTypeHolder: ' + $funcName + ' bindings={' + $bindingsDebug->joinStrings(',') + '}');
    let paramCount = $resolvedParams->size();
    if([pair(| ($funcName == 'funcColSpec' || $funcName == 'funcColSpec2') && $paramCount == 3,
             | let enriched = enrichColumnTypeHolder($resolvedParams, 0, 1, 2);
               let updatedBindings = updateTypeHolderBinding($ft, $enriched, 2, $bindings);
               ^EnrichResult(resolvedParams = $enriched, bindings = $updatedBindings, context = $context);),
        pair(| ($funcName == 'funcColSpecArray' || $funcName == 'funcColSpecArray2') && $paramCount == 2,
             | let enriched = mergeColSpecArrayTypeHolder($resolvedParams);
               let updatedBindings = updateTypeHolderBinding($ft, $enriched, 1, $bindings);
               ^EnrichResult(resolvedParams = $enriched, bindings = $updatedBindings, context = $context);),
        pair(| ($funcName == 'aggColSpec' || $funcName == 'aggColSpec2') && $paramCount == 4,
             | let enriched = enrichColumnTypeHolder($resolvedParams, 1, 2, 3);
               let updatedBindings = updateTypeHolderBinding($ft, $enriched, 3, $bindings);
               ^EnrichResult(resolvedParams = $enriched, bindings = $updatedBindings, context = $context);),
        pair(| ($funcName == 'aggColSpecArray' || $funcName == 'aggColSpecArray2') && $paramCount == 2,
             | let enriched = mergeColSpecArrayTypeHolder($resolvedParams);
               let updatedBindings = updateTypeHolderBinding($ft, $enriched, 1, $bindings);
               ^EnrichResult(resolvedParams = $enriched, bindings = $updatedBindings, context = $context);),
        pair(| ($funcName == 'colSpecArray' || $funcName == 'colSpec') && $paramCount >= 2,
             | let result = tryResolveSubsetForTypeHolder($resolvedParams, $ft, $bindings, $context, $exprSourceInformation);
               let updatedBindings = updateTypeHolderBinding($ft, $result.resolvedParams, 1, $result.bindings);
               ^$result(bindings = $updatedBindings);)],
       | ^EnrichResult(resolvedParams = $resolvedParams, bindings = $bindings, context = $context)
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::enrichColumnTypeHolder(paramValues:ValueSpecification[*], lambdaIdx:Integer[1], nameIdx:Integer[1], typeHolderIdx:Integer[1]):ValueSpecification[*]
{
    let lambda = $paramValues->at($lambdaIdx)->cast(@AtomicValue).value->toOne()->cast(@LambdaFunction<Any>);
    let lastExpr = $lambda.expressionSequence->at($lambda.expressionSequence->size() - 1);
    let colName = $paramValues->at($nameIdx)->cast(@AtomicValue).value->toOne()->cast(@String);
    let enrichedRT = ^RelationType<Any>(columns = [
        meta::pure::compiler::helper::column::buildColumn($colName, ^UserDefinedGenericType(type = RelationType), if($lastExpr.genericType->isNotEmpty(), | $lastExpr.genericType->toOne(), | ^CompilerNotSetGenericType()), if($lastExpr.multiplicity->isNotEmpty(), | $lastExpr.multiplicity->toOne(), | PureOne), false)
    ]);
    let enrichedGT = ^InferredGenericType(type = $enrichedRT);
    let typeHolderGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder, typeArguments = [$enrichedGT], multiplicityArguments = [PureOne]);
    let compilerCGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder);
    range($paramValues->size())->map(i | if($i == $typeHolderIdx, | let val = $paramValues->at($i); ^$val(genericType = $typeHolderGT, classifierGenericType = $compilerCGT);, | $paramValues->at($i)));
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::mergeColSpecArrayTypeHolder(paramValues:ValueSpecification[*]):ValueSpecification[*]
{
    let collection = $paramValues->at(0)->cast(@Collection);
    let mergedColumns = $collection.values->map(v |
        let innerFE = $v->cast(@FunctionInvocation);
        let lastParam = $innerFE.parametersValues->at($innerFE.parametersValues->size() - 1);
        let lastParamGT = if($lastParam.genericType->isNotEmpty() && !$lastParam.genericType->toOne()->instanceOf(CompilerNotSetGenericType), | $lastParam.genericType->toOne(), | $lastParam->cast(@Any).classifierGenericType->toOne());
        let typeArgs = $lastParamGT->genericTypeTypeArguments();
        if($typeArgs->isNotEmpty() && $typeArgs->at(0)->genericTypeRawType()->isNotEmpty(),
            | $typeArgs->at(0)->genericTypeRawType()->toOne()->match([
                  rt:RelationType<Any>[1] | $rt.columns->cast(@Column<Nil, Any|*>),
                  a:Any[1] | []->cast(@Column<Nil, Any|*>)
              ]),
            | []->cast(@Column<Nil, Any|*>)
        );
    );
    let mergedRT = ^RelationType<Any>(columns = $mergedColumns);
    let enrichedGT = ^InferredGenericType(type = $mergedRT);
    let typeHolderGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder, typeArguments = [$enrichedGT], multiplicityArguments = [PureOne]);
    let compilerCGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder);
    let val = $paramValues->at(1);
    [$paramValues->at(0), ^$val(genericType = $typeHolderGT, classifierGenericType = $compilerCGT)];
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::tryResolveSubsetForTypeHolder(paramValues:ValueSpecification[*], ft:FunctionType[1], bindings:meta::pure::compiler::helper::parametersBinding::ParametersBinding[1], context:CompilerContext[1], exprSourceInformation:SourceInformation[0..1]):EnrichResult[1]
{
    let typeHolderParamGT = $ft.parameters->at(1)->cast(@VariableExpression).genericType->toOne();
    let typeArgs = $typeHolderParamGT->genericTypeTypeArguments();
    if($typeArgs->isEmpty(),
        | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context),
        | let innerType = $typeArgs->at(0)->genericTypeRawType();
          if($innerType->isEmpty(),
              | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context),
              | $innerType->toOne()->match([
                    tp:TypeParameter[1] |
                        let typeParamName = $tp.name;
                        let boundTypes = $bindings.typeBindings->get($typeParamName);
                        debug($context, | 'tryResolveSubsetForTypeHolder: tp=' + $typeParamName + ' bound=' + if($boundTypes->isEmpty(), |'empty', | printGenericType($boundTypes->toOne().values->at(0)) + ' isGTO=' + $boundTypes->toOne().values->at(0)->instanceOf(GenericTypeOperation)->toString()));
                        if($boundTypes->isEmpty() || $boundTypes->toOne().values->isEmpty(),
                            | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context),
                            | let boundGT = $boundTypes->toOne().values->at(0);
                              $boundGT->match([
                                  gto:GenericTypeOperation[1] |
                                      if([pair(| $gto.operationType == GenericTypeOperationType.Subset, | resolveFromSubset($paramValues, $gto, $bindings, $context, $exprSourceInformation)),
                                          pair(| $gto.operationType == GenericTypeOperationType.Equal, | resolveFromEqualWithWildcard($paramValues, $gto, $bindings, $context))],
                                         | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context)
                                      ),
                                  a:Any[1] | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context)
                              ]);
                        );,
                    a:Any[1] | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context)
                ]);
          );
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::resolveFromSubset(paramValues:ValueSpecification[*], subsetOp:GenericTypeOperation[1], bindings:meta::pure::compiler::helper::parametersBinding::ParametersBinding[1], context:CompilerContext[1], exprSourceInformation:SourceInformation[0..1]):EnrichResult[1]
{
    let resolvedRight = makeAsConcreteAsPossible($subsetOp.right, $bindings);
    let referenceType = $resolvedRight->genericTypeRawType();
    if($referenceType->isEmpty(),
        | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context),
        | $referenceType->toOne()->match([
              referenceRT:RelationType<Any>[1] |
                  let columnNames = extractColumnNames($paramValues->at(0));
                  let siCtx = formatMetamodelSourceInfo($exprSourceInformation, $context);
                  let lookupResult = $columnNames->fold({colName, acc |
                      let foundCol = $referenceRT.columns->cast(@Column<Nil, Any|*>)->filter(c | $c.name == $colName);
                      if($foundCol->isEmpty(),
                          | let errCtx = $acc.context;
                            ^$acc(context = ^$errCtx(errors += 'The column \'' + $colName + '\' can\'t be found in the relation ' + meta::pure::compiler::helper::relationType::printRelationType($referenceRT) + $siCtx));,
                          | let col = $foundCol->at(0);
                            let newCol = meta::pure::compiler::helper::column::buildColumn($colName, ^UserDefinedGenericType(type = RelationType), if($col.genericType->isNotEmpty(), | $col.genericType->toOne(), | ^CompilerNotSetGenericType()), if($col.multiplicity->isNotEmpty(), | $col.multiplicity->toOne(), | PureOne), false);
                            ^$acc(values += $newCol);
                      );
                  }, ^CompilerListResult<Any>(context = $context));
                  let enrichedRT = ^RelationType<Any>(columns = $lookupResult.values->cast(@Column<Nil, Any|*>));
                  let enrichedGT = ^InferredGenericType(type = $enrichedRT);
                  let typeHolderGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder, typeArguments = [$enrichedGT], multiplicityArguments = [PureOne]);
                  let compilerCGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder);
                  let val = $paramValues->at(1);
                  ^EnrichResult(resolvedParams = [$paramValues->at(0), ^$val(genericType = $typeHolderGT, classifierGenericType = $compilerCGT)], bindings = $bindings, context = $lookupResult.context);,
              a:Any[1] | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context)
          ]);
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::resolveFromEqualWithWildcard(paramValues:ValueSpecification[*], equalOp:GenericTypeOperation[1], bindings:meta::pure::compiler::helper::parametersBinding::ParametersBinding[1], context:CompilerContext[1]):EnrichResult[1]
{
    let resolvedRight = makeAsConcreteAsPossible($equalOp.right, $bindings);
    let rightType = $resolvedRight->genericTypeRawType();
    if($rightType->isEmpty(),
        | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context),
        | $rightType->toOne()->match([
              wildcardRT:RelationType<Any>[1] |
                  let wildcardCol = $wildcardRT.columns->cast(@Column<Nil, Any|*>)->at(0);
                  let resolvedColType = makeAsConcreteAsPossible($wildcardCol.genericType->toOne(), $bindings);
                  let resolvedColMul = if($wildcardCol.multiplicity->isNotEmpty(), | makeAsConcreteAsPossible($wildcardCol.multiplicity->toOne(), $bindings), | PureOne);
                  let columnNames = extractColumnNames($paramValues->at(0));
                  let enrichedCols = $columnNames->map(colName | meta::pure::compiler::helper::column::buildColumn($colName, ^UserDefinedGenericType(type = RelationType), $resolvedColType, $resolvedColMul, false));
                  let enrichedRT = ^RelationType<Any>(columns = $enrichedCols);
                  let enrichedGT = ^InferredGenericType(type = $enrichedRT);
                  let typeHolderGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder, typeArguments = [$enrichedGT], multiplicityArguments = [PureOne]);
                  let compilerCGT = ^UserDefinedGenericType(type = CompilerGenericTypeAndMultiplicityHolder);
                  let val = $paramValues->at(1);
                  ^EnrichResult(resolvedParams = [$paramValues->at(0), ^$val(genericType = $typeHolderGT, classifierGenericType = $compilerCGT)], bindings = $bindings, context = $context);,
              a:Any[1] | ^EnrichResult(resolvedParams = $paramValues, bindings = $bindings, context = $context)
          ]);
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::extractColumnNames(arg:ValueSpecification[1]):String[*]
{
    $arg->match([
        fe:FunctionInvocation[1] |
          let fName = $fe.functionName;
          if([pair(| $fName == 'colSpecArray', | let first = $fe.parametersValues->at(0);
                $first->match([
                    col:Collection[1] | $col.values->map(v | $v->match([av:AtomicValue[1] | $av.value->toOne()->cast(@String), a:Any[1] | []])),
                    a:Any[1] | []->cast(@String)
                ]);),
              pair(| $fName == 'colSpec', | let first = $fe.parametersValues->at(0);
                      $first->match([
                          av:AtomicValue[1] | [$av.value->toOne()->cast(@String)],
                          a:Any[1] | []->cast(@String)
                      ]);)],
             | []->cast(@String)
          );,
        // Direct Collection or AtomicValue (when called with resolved params instead of FunctionInvocation)
        col:Collection[1] |
          $col.values->map(v | $v->match([av:AtomicValue[1] | $av.value->toOne()->cast(@String), a:Any[1] | []])),
        av:AtomicValue[1] |
          [$av.value->toOne()->cast(@String)],
        a:Any[1] | []->cast(@String)
    ]);
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::functionSpecific::relationColumnResolver::updateTypeHolderBinding(ft:FunctionType[1], paramValues:ValueSpecification[*], typeHolderArgIdx:Integer[1], bindings:meta::pure::compiler::helper::parametersBinding::ParametersBinding[1]):meta::pure::compiler::helper::parametersBinding::ParametersBinding[1]
{
    let enrichedGT = $paramValues->at($typeHolderArgIdx).genericType;
    if($enrichedGT->isNotEmpty() && !$enrichedGT->toOne()->instanceOf(CompilerNotSetGenericType),
        | let paramGT = $ft.parameters->at($typeHolderArgIdx)->cast(@VariableExpression).genericType->toOne();
          let typeArgs = $paramGT->genericTypeTypeArguments();
          if($typeArgs->isNotEmpty() && $typeArgs->at(0)->genericTypeRawType()->isNotEmpty(),
              | $typeArgs->at(0)->genericTypeRawType()->toOne()->match([
                    tp:TypeParameter[1] |
                        let typeParamName = $tp.name;
                        let enrichedTypeArgs = $enrichedGT->toOne()->genericTypeTypeArguments();
                        if($enrichedTypeArgs->isNotEmpty(),
                            | // Clear existing binding before adding enriched value (mirrors Java updateTypeHolderBinding line 378: bound.clear())
                              let cleared = ^$bindings(typeBindings = $bindings.typeBindings->put($typeParamName, ^List<GenericType>(values = [])));
                              collectTypeParameterBindings(^UserDefinedGenericType(type = ^TypeParameter(name = $typeParamName, contravariant = false)), $enrichedTypeArgs->at(0), $cleared);,
                            | $bindings
                        );,
                    a:Any[1] | $bindings
                ]),
              | $bindings
          );,
        | $bindings
    );
}
