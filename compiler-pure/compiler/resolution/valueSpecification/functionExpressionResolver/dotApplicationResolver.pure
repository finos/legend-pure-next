import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::*;
import meta::pure::metamodel::function::property::*;
import meta::pure::metamodel::multiplicity::*;
import meta::pure::metamodel::relation::*;
import meta::pure::metamodel::*;
import meta::pure::functions::meta::*;
import meta::pure::compiler::resolution::valueSpecification::valueSpecificationResolver::*;
import meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::dotApplicationResolver::*;
import meta::pure::compiler::structural::sourceInformationCompiler::*;
import meta::pure::compiler::helper::genericType::*;
import meta::pure::compiler::helper::multiplicity::*;
import meta::pure::compiler::helper::relationType::*;
import meta::pure::compiler::helper::class::*;
import meta::pure::compiler::helper::property::*;
import meta::pure::compiler::helper::parametersBinding::*;
import meta::pure::compiler::*;

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::dotApplicationResolver::resolveDotApplication(dot:DotApplication[1], scope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    let functionName = $dot.functionName->toOne();
    let siCtx = formatMetamodelSourceInfo($dot.sourceInformation, $context);

    // Resolve receiver parameters — use resolved types for property lookup
    let resolvedParamResults = $dot.parametersValues->map(p | resolveValueSpecification($p, $scope, $context));
    let ctx1 = $resolvedParamResults->fold({r, c | $r.context}, $context);
    let resolvedParams = $resolvedParamResults->map(r | if($r.value->isEmpty(), | [], | $r.value->toOne()));

    if($resolvedParams->isEmpty(),
        | ^CompilerResult<ValueSpecification>(
              value = $dot,
              context = ^$ctx1(errors += 'DotApplication has no parameters' + $siCtx)
          ),
        | let receiver = $resolvedParams->at(0);
          debug($context, | 'resolveDotApplication: .' + $functionName
              + ' receiverGT=' + if($receiver.genericType->isEmpty(), | '?', | printGenericType($receiver.genericType->toOne()))
              + ' receiverMul=' + if($receiver.multiplicity->isEmpty(), | '?', | printMultiplicity($receiver.multiplicity->toOne()))
              + ' additionalParams=' + $resolvedParams->size()->toString());
          if($receiver.genericType->isEmpty() || $receiver.genericType->toOne()->instanceOf(CompilerNotSetGenericType),
              | ^CompilerResult<ValueSpecification>(
                    value = $dot,
                    context = ^$ctx1(errors += 'Can\'t resolve property \'' + $functionName + '\' on unresolved receiver' + $siCtx)
                ),
              | let ownerType = $receiver.genericType->toOne()->cast(@GenericTypeValue).type->toOne();
                // Handle Enumeration value access: check if the receiver's value IS an Enumeration
                let maybeEnumeration = $receiver->match([
                    av:AtomicValue[1] |
                        $av.value->toOne()->match([
                            e:Enumeration<Any>[1] | $e,
                            a:Any[1] | []
                        ]),
                    a:Any[1] | []
                ]);
                if($maybeEnumeration->isNotEmpty(),
                    | let enumeration = $maybeEnumeration->toOne();
                      let enumPath = $enumeration->elementToPath();
                      let resolvedEnum = $context->resolveElement($enumPath);
                      let enumOwner = if($resolvedEnum->isNotEmpty(),
                          | $resolvedEnum->toOne()->match([
                                re:Enumeration<Any>[1] | $re,
                                a:Any[1] | $enumeration
                            ]),
                          | $enumeration
                      );
                      let matchedProp = $enumOwner.properties->filter(p | $p.name == $functionName);
                      if($matchedProp->isEmpty(),
                          | ^CompilerResult<ValueSpecification>(
                                value = $dot,
                                context = ^$ctx1(errors += 'Can\'t find enum value \'' + $functionName + '\' in enumeration \'' + $enumPath + '\'' + $siCtx)
                            ),
                          | debug($context, | '  enum property found: ' + $matchedProp->at(0).name->toOne());
                            let enumGT = ^InferredGenericType(type = $enumeration);
                            ^CompilerResult<ValueSpecification>(
                                value = ^$dot(
                                    func = $matchedProp->at(0),
                                    genericType = $enumGT,
                                    multiplicity = PureOne,
                                    parametersValues = $resolvedParams->cast(@ValueSpecification)
                                ),
                                context = $ctx1
                            );
                      );,
                    | // Column access on a RelationType — mirrors Java DotApplicationResolver.lookupFunction lines 300-313
                      $ownerType->match([
                          rt:RelationType<Any>[1] |
                            let col = $rt.columns->cast(@Column<Any,Any|*>)->filter(c | $c.name == $functionName);
                            debug($context, | '  column lookup: ' + $functionName + ' ' + if($col->isNotEmpty(), | 'found', | 'NOT FOUND'));
                            if($col->isNotEmpty(),
                                | let resolvedCol = $col->at(0);
                                  let colGT = if($resolvedCol.genericType->isNotEmpty(), | asInferredGenericType($resolvedCol.genericType->toOne()), | ^CompilerNotSetGenericType());
                                  let colMul = if($resolvedCol.multiplicity->isNotEmpty(), | $resolvedCol.multiplicity->toOne(), | PureOne);
                                  ^CompilerResult<ValueSpecification>(
                                      value = ^$dot(
                                          func = $resolvedCol,
                                          genericType = $colGT,
                                          multiplicity = $colMul
                                      ),
                                      context = $ctx1
                                  );,
                                | ^CompilerResult<ValueSpecification>(
                                      value = $dot,
                                      context = ^$ctx1(errors += 'Can\'t find column \'' + $functionName + '\' in relation type \'' + printGenericType($receiver.genericType->toOne()) + '\'' + $siCtx)
                                  )
                            );,
                          cls:Class<Any>[1] |
                            // Look up the fully compiled class from the context (the receiver may reference the pass 1 skeleton)
                            let path = $cls->cast(@PackageableElement)->elementToPath();
                            let fromCtx = $context->resolveElement($path);
                            let resolvedOwner = if($fromCtx->isNotEmpty(),
                                | $fromCtx->toOne()->match([
                                      c:Class<Any>[1] | $c,
                                      a:Any[1] | $cls
                                  ]),
                                | $cls
                            );
                            // Look up property or qualified property on the owner type (mirrors Java DotApplicationResolver.lookupFunction)
                            let paramCount = $resolvedParams->size();
                            // Try simple property first (only when no additional params)
                            let simpleProp = if($paramCount == 1,
                                | findProperty($resolvedOwner, $functionName),
                                | []->cast(@Property<Nil, Any|*>)
                            );
                            let foundFunc = if($simpleProp->isNotEmpty(),
                                | $simpleProp->toOne(),
                                | // Fall through to QP lookup — match by name and arity
                                  let qps = $resolvedOwner->cast(@Class<Any>).qualifiedProperties->concatenate($resolvedOwner->cast(@Class<Any>).qualifiedPropertiesFromAssociations)
                                      ->filter(qp | $qp.name == $functionName && $qp.parameters->size() == $paramCount);
                                  if($qps->isEmpty(), | []->cast(@AbstractProperty<Any>), | $qps->at(0));
                            );
                            if($foundFunc->isEmpty(),
                                | ^CompilerResult<ValueSpecification>(
                                      value = $dot,
                                      context = ^$ctx1(errors += 'Can\'t find property \'' + $functionName + '\' in class \'' + $resolvedOwner->elementToPath() + '\'' + $siCtx)
                                  ),
                                | debug($context, | '  property found: ' + $foundFunc->toOne().name->toOne());
                                  let resolvedProp = $foundFunc->toOne();
                                  let propResolved = resolvePropertyReturnTypeAndMultiplicity($resolvedProp, $receiver.genericType->toOne());
                                  let propGT = $propResolved.first;
                                  let propMul = $propResolved.second;
                                  let receiverMul = $receiver.multiplicity;
                                  // Check if automap needed: receiver multiplicity is NOT [1]
                                  if($receiverMul->isNotEmpty() && multiplicityLowerBound($receiverMul->toOne()) == 1 && multiplicityUpperBound($receiverMul->toOne()) == 1,
                                      | // Direct access — receiver is [1]
                                        debug($context, | '  direct access [1]');
                                        ^CompilerResult<ValueSpecification>(
                                            value = ^$dot(
                                                func = $resolvedProp,
                                                genericType = $propGT,
                                                multiplicity = $propMul,
                                                parametersValues = $resolvedParams->cast(@ValueSpecification)
                                            ),
                                            context = $ctx1
                                        );,
                                      | // Automap — rewrite as map(receiver, {v:T[1] | $v.prop})
                                        debug($context, | '  AUTOMAP: receiverMul=' + if($receiverMul->isEmpty(), | '?', | printMultiplicity($receiverMul->toOne())));
                                        buildAutomap($dot, $receiver, $functionName, $propGT, $propMul, $resolvedProp, $scope, $ctx1);
                                  );
                            );,
                          a:Any[1] |
                            ^CompilerResult<ValueSpecification>(
                                value = $dot,
                                context = ^$ctx1(errors += 'Can\'t find property \'' + $functionName + '\' on type \'' + $ownerType->cast(@PackageableElement)->elementToPath() + '\'' + $siCtx)
                            )
                      ]); // end ownerType match
                ); // end enum if
          );
    );
}

// Matches Java DotApplicationResolver lines 106-113: apply class type bindings to property type and multiplicity
function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::dotApplicationResolver::resolvePropertyReturnTypeAndMultiplicity(prop:AbstractProperty<Any>[1], ownerGT:GenericType[1]):Pair<GenericType, Multiplicity>[1]
{
    let rawGT = $prop.genericType->toOne();
    let rawMul = $prop.multiplicity->toOne();
    let ownerType = $ownerGT->match([
        gtv:GenericTypeValue[1] | $gtv.type,
        a:Any[1] | []
    ]);
    if($ownerType->isNotEmpty(),
        | $ownerType->toOne()->match([
              ownerClass:Class<Any>[1] |
                  let bindings = $ownerClass->buildBindingsFromGenericType($ownerGT);
                  if($bindings.typeBindings->isEmpty() && $bindings.multiplicityBindings->isEmpty(),
                      | pair($rawGT, $rawMul),
                      | pair(asInferredGenericType(makeAsConcreteAsPossible($rawGT, $bindings)), asInferredMultiplicity(makeAsConcreteAsPossible($rawMul, $bindings)))
                  );,
              a:Any[1] | pair($rawGT, $rawMul)
          ]),
        | pair($rawGT, $rawMul)
    );
}

function meta::pure::compiler::resolution::valueSpecification::functionExpressionResolver::dotApplicationResolver::buildAutomap(dot:DotApplication[1], receiver:ValueSpecification[1], functionName:String[1], propGT:GenericType[1], propMul:Multiplicity[1], prop:AbstractProperty<Any>[1], scope:VariableExpression[*], context:CompilerContext[1]):CompilerResult<ValueSpecification>[1]
{
    // Build lambda parameter: v_automap:ReceiverElementType[1]
    let lambdaParam = ^VariableExpression(
        name = 'v_automap',
        genericType = $receiver.genericType->toOne(),
        multiplicity = PureOne
    );

    // Build lambda body: $v_automap.propertyName (direct DotApplication with [1] receiver)
    let varRef = ^VariableExpression(
        name = 'v_automap',
        genericType = $receiver.genericType->toOne(),
        multiplicity = PureOne
    );
    let innerDot = meta::pure::functions::lang::new(
        ^UserDefinedGenericType(type = DotApplication)
    )->cast(@DotApplication);
    let dotBody = ^$innerDot(
        functionName = $functionName,
        parametersValues = [$varRef],
        func = $prop,
        genericType = $propGT,
        multiplicity = $propMul,
        sourceInformation = $dot.sourceInformation
    );

    // Build lambda function
    let emptyLambda = meta::pure::functions::lang::new(
        ^UserDefinedGenericType(type = LambdaFunction)
    )->cast(@LambdaFunction<Any>);
    let lambda = ^$emptyLambda(
        parameters = [$lambdaParam],
        expressionSequence = [$dotBody]
    );

    // Wrap lambda in AtomicValue
    let lambdaAV = ^AtomicValue(
        value = $lambda,
        genericType = ^CompilerNotSetGenericType(),
        multiplicity = PureOne
    );

    // Build map() FunctionInvocation
    let mapFI = ^FunctionInvocation(
        functionName = 'map',
        parametersValues = [$receiver, $lambdaAV],
        genericType = $propGT,
        multiplicity = $receiver.multiplicity->toOne(),
        sourceInformation = $dot.sourceInformation
    );

    // Resolve the map expression to bind the function
    debug($context, | '  automap: resolving map() expression');
    let mapResult = resolveValueSpecification($mapFI, $scope, $context->debugSpaceInc());
    let resolved = if($mapResult.value->isEmpty(), | $mapFI, | $mapResult.value->toOne());
    debug($context, | '  automap: map() resolved gt=' + if($resolved.genericType->isEmpty(), | '?', | printGenericType($resolved.genericType->toOne()))
        + ' mul=' + if($resolved.multiplicity->isEmpty(), | '?', | printMultiplicity($resolved.multiplicity->toOne())));
    // Restore debug space — mapResult.context carries deeper space from resolveValueSpecification
    let mapCtx = $mapResult.context;
    let restoredCtx = ^$mapCtx(debugState = $context.debugState);
    ^CompilerResult<ValueSpecification>(value = $mapResult.value, context = $restoredCtx);
}
