import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::functions::lang::*;
import meta::pure::compiler::structural::functionTypeCompiler::*;

function meta::pure::compiler::structural::functionTypeCompiler::compileFunctionType(parameters:VariableExpression[*], returnGenericType:GenericType[1], returnMultiplicity:Multiplicity[1]):FunctionType[1]
{
    let functionType = new(
        ^UserDefinedGenericType(type = FunctionType)
    )->cast(@FunctionType);
    ^$functionType(
        parameters = $parameters,
        returnType = $returnGenericType,
        returnMultiplicity = $returnMultiplicity
    );
}
