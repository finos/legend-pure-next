import meta::pure::compiler::structural::genericTypeCompiler::*;
import meta::pure::compiler::structural::propertyCompiler::*;
import meta::pure::compiler::structural::annotationCompiler::*;
import meta::pure::compiler::*;
import meta::pure::metamodel::*;
import meta::pure::metamodel::type::generics::*;
import meta::pure::metamodel::function::property::*;
import meta::pure::metamodel::relationship::*;
import meta::pure::metamodel::extension::*;
import meta::pure::functions::lang::*;

function meta::pure::compiler::elements::compileAssociation(protocolAssoc:meta::pure::protocol::grammar::relationship::Association[1], context:CompilerContext[1]):CompilerResult<Association>[1]
{
    let packagePath = $protocolAssoc.package->toOne().pointerValue;
    let assocName = $packagePath + '::' + $protocolAssoc.name;
    let skeleton = $context->resolveElement($assocName)->toOne()->cast(@Association);

    let p1Protocol = $protocolAssoc.properties->at(0);
    let p2Protocol = $protocolAssoc.properties->at(1);

    let ownerCtx = 'association \'' + $assocName + '\'';

    let gt1Result = $p1Protocol.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)
                        ->compileGenericType($context, $packagePath, [], 'property \'' + $p1Protocol.name + '\'', $ownerCtx);
    let mGenType1 = $gt1Result.value->toOne();

    let gt2Result = $p2Protocol.genericType->cast(@meta::pure::protocol::grammar::type::generics::GenericTypeValue)
                        ->compileGenericType($gt1Result.context, $packagePath, [], 'property \'' + $p2Protocol.name + '\'', $ownerCtx);
    let mGenType2 = $gt2Result.value->toOne();

    let ctx1 = $gt2Result.context;

    if($ctx1.errors->size() > $context.errors->size(),
        | ^CompilerResult<Association>(value = $skeleton, context = $ctx1),
        | let mMult1 = meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity($p1Protocol.multiplicity);
          let mMult2 = meta::pure::compiler::structural::multiplicityCompiler::compileMultiplicity($p2Protocol.multiplicity);

          let propClassifierGT1 = ^UserDefinedGenericType(
              type = Property,
              typeArguments = [$mGenType2, $mGenType1],
              multiplicityArguments = [$mMult1]
          );
          let prop1 = new($propClassifierGT1)->cast(@Property<Nil, Any|*>);
          let builtProp1 = ^$prop1(
              name = $p1Protocol.name,
              aggregation = compileAggregationKind($p1Protocol),
              genericType = $mGenType1,
              multiplicity = $mMult1,
              stereotypes = compilePropertyStereotypes($p1Protocol, $ctx1, $ownerCtx).values,
              taggedValues = compilePropertyTaggedValues($p1Protocol, $ctx1, $ownerCtx).values,
              sourceInformation = $p1Protocol.sourceInformation->map(si | ^SourceInformation(
                  sourceId = $si.sourceId,
                  startLine = $si.startLine,
                  startColumn = $si.startColumn,
                  endLine = $si.endLine,
                  endColumn = $si.endColumn
              ))
          );

          let propClassifierGT2 = ^UserDefinedGenericType(
              type = Property,
              typeArguments = [$mGenType1, $mGenType2],
              multiplicityArguments = [$mMult2]
          );
          let prop2 = new($propClassifierGT2)->cast(@Property<Nil, Any|*>);
          let builtProp2 = ^$prop2(
              name = $p2Protocol.name,
              aggregation = compileAggregationKind($p2Protocol),
              genericType = $mGenType2,
              multiplicity = $mMult2,
              stereotypes = compilePropertyStereotypes($p2Protocol, $ctx1, $ownerCtx).values,
              taggedValues = compilePropertyTaggedValues($p2Protocol, $ctx1, $ownerCtx).values,
              sourceInformation = $p2Protocol.sourceInformation->map(si | ^SourceInformation(
                  sourceId = $si.sourceId,
                  startLine = $si.startLine,
                  startColumn = $si.startColumn,
                  endLine = $si.endLine,
                  endColumn = $si.endColumn
              ))
          );

          // Compile stereotypes and tagged values on the association itself
          let stereoAccum = $protocolAssoc.stereotypes->fold({s, acc |
                                      compileStereotype($s, $acc, $ownerCtx);
                                  }, ^CompilerListResult<Stereotype>(context = $ctx1));
          let tvAccum = $protocolAssoc.taggedValues->fold({t, acc |
                                      compileTaggedValue($t, $acc, $ownerCtx);
                                  }, ^CompilerListResult<TaggedValue>(context = $stereoAccum.context));
          let ctx2 = $tvAccum.context;

          ^CompilerResult<Association>(
              value = ^$skeleton(
                  stereotypes = $stereoAccum.values,
                  taggedValues = $tvAccum.values,
                  properties = [
                      ^$builtProp1(owner = ~.~),
                      ^$builtProp2(owner = ~.~)
                  ]
              ),
              context = $ctx2
          );
    );
}
