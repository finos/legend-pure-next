import meta::pure::functions::collection::*;
import meta::pure::functions::date::*;
import meta::pure::functions::io::*;
import meta::pure::functions::lang::*;
import meta::pure::functions::meta::*;
import meta::pure::functions::string::*;
import meta::pure::metamodel::extension::*;
import meta::pure::metamodel::function::*;
import meta::pure::test::pct::*;

// ---------------------------------------------------------------------------
// Pure-native runner for <<test.Test>> functions.
//
// Walks the package tree under a given root, finds every
// UserDefinedFunction annotated with <<test.Test>> that takes zero
// parameters, invokes each, and reports pass/fail.
//
// Invocation:
//   pure-compile execute --pdb core.pdb --pdb compiler.pdb \
//       --function "meta::pure::test::runFunctionTests_String_1__Boolean_1_" \
//       --args "meta::pure::functions"
//
// Returns true iff every discovered test returns true.
// Skips parametrized tests (e.g. PCT tests) — those go through runPCTTests.
// ---------------------------------------------------------------------------

// Recursively collect zero-arg <<test.Test>> functions under a package.
function meta::pure::test::collectFunctionTests(pkg:Package[1]):UserDefinedFunction<Any>[*]
{
    let directTests = $pkg.children
        ->filter(e | $e->instanceOf(UserDefinedFunction)
                     && meta::pure::test::hasTestStereotype($e)
                     && meta::pure::test::isZeroArg($e->cast(@UserDefinedFunction<Any>)))
        ->cast(@UserDefinedFunction<Any>);

    let subPackages = $pkg.children
        ->filter(e | $e->instanceOf(Package))
        ->cast(@Package);
    let subTests = $subPackages->map(p | meta::pure::test::collectFunctionTests($p));

    concatenate($directTests, $subTests);
}

// PackageableElement → AnnotatedElement → ElementWithStereotypes, so stereotypes
// is available directly on any PackageableElement. We still check via a cast
// that's always-true so the type system doesn't complain about non-inherited
// access.
function meta::pure::test::hasTestStereotype(el:PackageableElement[1]):Boolean[1]
{
    $el.stereotypes
        ->exists(s | $s.value == 'Test' && $s.profile.name == 'test');
}

function meta::pure::test::isZeroArg(fn:UserDefinedFunction<Any>[1]):Boolean[1]
{
    $fn.parameters->isEmpty();
}

function meta::pure::test::runFunctionTests(rootPackagePath:String[1]):Boolean[1]
{
    let root = pathToElement($rootPackagePath)->cast(@Package);
    let tests = meta::pure::test::collectFunctionTests($root);
    let total = $tests->size();
    println('Running ' + $total->toString() + ' <<test.Test>> tests from ' + $rootPackagePath + '...');
    println('');
    println('');
    print('\u001B[2A');

    let start = currentTimeMillis();

    range(0, $total)->map(i |
        let fn = $tests->at($i);
        let name = $fn->elementToPath();
        print('\r\u001B[K' + meta::pure::test::renderBar($i + 1, $total)
              + '\u001B[B\r\u001B[K  ' + $name + '\u001B[K\u001B[A\r');
        // Each zero-arg <<test.Test>> returns Boolean[1]. An assertion failure
        // throws, unwinding the whole run — the progress display already shows
        // which test was executing.
        $fn->evaluate([]);
    );

    let elapsedMs = currentTimeMillis() - $start;
    print('\r\u001B[K\u001B[B\r\u001B[K\u001B[B\r');
    println('OK: ' + $total->toString() + ' / ' + $total->toString() + ' <<test.Test>> tests passed in ' + $elapsedMs->toString() + ' ms');
    true;
}

// ---------------------------------------------------------------------------
// <<PCT.test>> runner — Platform Conformance Tests, parametrized by an
// adapter function. Uses the in-memory adapter already defined in the stdlib
// at meta::pure::test::pct::testAdapterForInMemoryExecution: it simply
// evaluates the passed-in closure in the current runtime.
// ---------------------------------------------------------------------------

function meta::pure::test::hasPctTestStereotype(el:PackageableElement[1]):Boolean[1]
{
    $el.stereotypes
        ->exists(s | $s.value == 'test' && $s.profile.name == 'PCT');
}

function meta::pure::test::collectPCTTests(pkg:Package[1]):UserDefinedFunction<Any>[*]
{
    let directTests = $pkg.children
        ->filter(e | $e->instanceOf(UserDefinedFunction)
                     && meta::pure::test::hasPctTestStereotype($e))
        ->cast(@UserDefinedFunction<Any>);

    let subPackages = $pkg.children
        ->filter(e | $e->instanceOf(Package))
        ->cast(@Package);
    let subTests = $subPackages->map(p | meta::pure::test::collectPCTTests($p));

    concatenate($directTests, $subTests);
}

function meta::pure::test::runPCTTests(rootPackagePath:String[1]):Boolean[1]
{
    let root = pathToElement($rootPackagePath)->cast(@Package);
    let tests = meta::pure::test::collectPCTTests($root);
    let total = $tests->size();
    println('Running ' + $total->toString() + ' <<PCT.test>> tests from ' + $rootPackagePath + '...');
    println('');
    println('');
    print('\u001B[2A');

    let start = currentTimeMillis();

    // Every PCT test takes an adapter function. We pass the stdlib in-memory
    // adapter (testAdapterForInMemoryExecution) by reference — it just calls
    // $f->eval() on the closure the test hands it.
    //
    // The trailing `true;` pins the map body's return type to Boolean[1].
    // Without it the generic return type of eval() (parameterized on the
    // adapter's X/o) propagates into map's overload resolution and picks the
    // many→many form, breaking scalar iteration. (Known Java-interpreter
    // quirk; the Truffle rewrite makes this dispatch unambiguous.)
    range(0, $total)->map(i:Integer[1] |
        let fn = $tests->at($i);
        let name = $fn->elementToPath();
        print('\r\u001B[K' + meta::pure::test::renderBar($i + 1, $total)
              + '\u001B[B\r\u001B[K  ' + $name + '\u001B[K\u001B[A\r');
        $fn->eval(meta::pure::test::pct::testAdapterForInMemoryExecution_Function_1__X_o_);
        true;
    );

    let elapsedMs = currentTimeMillis() - $start;
    print('\r\u001B[K\u001B[B\r\u001B[K\u001B[B\r');
    println('OK: ' + $total->toString() + ' / ' + $total->toString() + ' <<PCT.test>> tests passed in ' + $elapsedMs->toString() + ' ms');
    true;
}
