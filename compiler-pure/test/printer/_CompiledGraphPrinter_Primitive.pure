import meta::pure::metamodel::*;
import meta::pure::metamodel::valuespecification::*;
import meta::pure::metamodel::type::*;
import meta::pure::functions::collection::*;
import meta::pure::functions::string::*;
import meta::pure::compiler::helper::packageableElement::*;
import meta::pure::compiler::test::printer::*;

function meta::pure::compiler::test::printer::primitive::printPrimitive(p:PrimitiveType[1]):String[1]
{
    [
        'primitive ', $p->fullPath(),
        $p->classifierGT(),
        $p.sourceInformation->printSourceInfo(),
        '\n',
        $p->printAnnotations('  '),
        $p->printTypeVariables('  '),
        $p->printConstraints('  ')
    ]->joinStrings('');
}
