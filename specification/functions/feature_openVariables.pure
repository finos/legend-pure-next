function <<test.Test>> meta::pure::functions::tests::openVariables::testClosedVariablePropagatedThroughMap():Boolean[1]
{
    let suffix = '_ok';
    let result = ['a', 'b', 'c']->map(x | $x + $suffix);
    assertEquals(['a_ok', 'b_ok', 'c_ok'], $result);
}

function <<test.Test>> meta::pure::functions::tests::openVariables::testClosedVariablePropagatedThroughFilter():Boolean[1]
{
    let threshold = 3;
    let result = [1, 2, 3, 4, 5]->filter(x | $x > $threshold);
    assertEquals([4, 5], $result);
}

function <<test.Test>> meta::pure::functions::tests::openVariables::testMultipleClosedVariables():Boolean[1]
{
    let prefix = 'Hello';
    let separator = ' ';
    let result = ['World', 'Pure']->map(x | $prefix + $separator + $x);
    assertEquals(['Hello World', 'Hello Pure'], $result);
}

function <<test.Test>> meta::pure::functions::tests::openVariables::testClosedVariableInNestedLambda():Boolean[1]
{
    let multiplier = 10;
    let offset = 1;
    let result = [1, 2, 3]->map(x | ($x * $multiplier) + $offset);
    assertEquals([11, 21, 31], $result);
}

function <<test.Test>> meta::pure::functions::tests::openVariables::testClosedVariableInFold():Boolean[1]
{
    let separator = '-';
    let result = ['a', 'b', 'c']->fold({x, acc | $acc + $separator + $x}, 'start');
    assertEquals('start-a-b-c', $result);
}

function meta::pure::functions::tests::openVariables::applyMapper(values:String[*], fn:Function<{String[1]->String[1]}>[1]):String[*]
{
    $values->map($fn);
}

function <<test.Test>> meta::pure::functions::tests::openVariables::testClosedVariableThroughUserDefinedFunction():Boolean[1]
{
    let tag = '[tagged]';
    let result = meta::pure::functions::tests::openVariables::applyMapper(['x', 'y'], x | $x + $tag);
    assertEquals(['x[tagged]', 'y[tagged]'], $result);
}

// ────────────────────────────────────────────────────────────────────────────
// fold + match: the fold accumulator must propagate into inner match lambdas.
// This mirrors the compiler pattern: $allElements->fold({e, ctx | $e->match([...])})
// ────────────────────────────────────────────────────────────────────────────

function <<test.Test>> meta::pure::functions::tests::openVariables::testFoldAccumulatorVisibleInMatchLambda():Boolean[1]
{
    let items = [1, 2, 3];
    let result = $items->fold({e, acc |
        $e->match([
            i:Integer[1] | $acc + $i
        ])
    }, 0);
    assertEquals(6, $result);
}

// ────────────────────────────────────────────────────────────────────────────
// Shadowing tests: verify that an intermediate function defining a variable
// with the same name does NOT corrupt the lambda's captured binding.
// ────────────────────────────────────────────────────────────────────────────

function meta::pure::functions::tests::openVariables::applyWithShadow(values:String[*], fn:Function<{String[1]->String[1]}>[1]):String[*]
{
    let suffix = '_WRONG';  // same name as the outer 'suffix' — must NOT leak into fn
    $values->map($fn);
}

function <<test.Test>> meta::pure::functions::tests::openVariables::testClosedVariableNotShadowedByIntermediateScope():Boolean[1]
{
    let suffix = '_correct';
    let result = meta::pure::functions::tests::openVariables::applyWithShadow(['a', 'b'], x | $x + $suffix);
    assertEquals(['a_correct', 'b_correct'], $result);
}


function <<test.Test>> meta::pure::functions::tests::openVariables::testLetInsideIfBranch():Boolean[1]
{
    let x = 1;
    let result = if($x == 0,
        | 'zero',
        | let y = $x + 1;
          let z = $y + 2;
          $z;
    );
    assertEquals(4, $result);
}

function <<test.Test>> meta::pure::functions::tests::openVariables::testNestedLetInFold():Boolean[1]
{
    let items = [1, 2, 3];
    let result = $items->fold({e, acc |
        let sum = $acc + $e;
        let doubled = $sum * 2;
        $doubled;
    }, 0);
    // fold: 0 -> (0+1)*2=2 -> (2+2)*2=8 -> (8+3)*2=22
    assertEquals(22, $result);
}

function <<test.Test>> meta::pure::functions::tests::openVariables::testLetUsedAcrossNestedBlocks():Boolean[1]
{
    let items = [1, 2, 3];
    let result = $items->fold({e, acc |
        let prefix = 'item';
        $e->match([
            i:Integer[1] | $prefix + ':' + $acc + ':' + toString($i)
        ]);
    }, '');
    assertEquals('item:item:item::1:2:3', $result);
}
