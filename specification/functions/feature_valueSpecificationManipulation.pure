function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testIterateExpressionSequence():Boolean[1]
{
    let fn = meta::pure::functions::valueSpecificationManipulation::sampleFunction__Any_MANY_;
    let exprs = $fn.expressionSequence;
    assert($exprs->size() == 3);
    let mapped = $exprs->map(e | $e);
    assert($mapped->size() == 3);
    let types = $exprs->map(e | $e->type()->elementToPath());
    assert($types->size() == 3);
    true;
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testBuildCollectionFromExpressions():Boolean[1]
{
    let fn = meta::pure::functions::valueSpecificationManipulation::sampleFunction__Any_MANY_;
    let exprs = $fn.expressionSequence;
    let mapped = $exprs->map(e | $e)->cast(@meta::pure::metamodel::valuespecification::ValueSpecification);
    let coll = ^meta::pure::metamodel::valuespecification::Collection(
        values = $mapped,
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    );
    assert($coll.values->size() == 3);
    true;
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testCollectionValuesAreUnwrapped():Boolean[1]
{
    let fn = meta::pure::functions::valueSpecificationManipulation::sampleFunction__Any_MANY_;
    let exprs = $fn.expressionSequence;
    let mapped = $exprs->map(e | $e)->cast(@meta::pure::metamodel::valuespecification::ValueSpecification);
    let coll = ^meta::pure::metamodel::valuespecification::Collection(
        values = $mapped,
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    );
    let vals = $coll.values;
    assert($vals->size() == 3);
    assertEquals(1, $vals->at(0));
    assertEquals('hello', $vals->at(1));
    assertEquals(true, $vals->at(2));
    true;
}

Class meta::pure::functions::valueSpecificationManipulation::VSHolder
{
    values: meta::pure::metamodel::valuespecification::ValueSpecification[*];
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testFoldPlusEqualsWithValueSpecifications():Boolean[1]
{
    let items = [
        ^meta::pure::metamodel::valuespecification::AtomicValue(value = 1, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne),
        ^meta::pure::metamodel::valuespecification::AtomicValue(value = 'hello', genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = String), multiplicity = meta::pure::metamodel::multiplicity::PureOne),
        ^meta::pure::metamodel::valuespecification::AtomicValue(value = true, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Boolean), multiplicity = meta::pure::metamodel::multiplicity::PureOne)
    ];
    let result = $items->fold({e, acc |
        ^$acc(values += $e);
    }, ^meta::pure::metamodel::valuespecification::Collection(
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    ));
    assertEquals(3, $result.values->size());
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testAccessValuesViaHolder():Boolean[1]
{
    let coll = ^meta::pure::metamodel::valuespecification::Collection(
        values = [
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 1, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne),
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 'hello', genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = String), multiplicity = meta::pure::metamodel::multiplicity::PureOne)
        ],
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    );
    let holder = ^meta::pure::functions::valueSpecificationManipulation::VSHolder(values = [$coll]);
    let holderVals = $holder.values;
    assertEquals(1, $holderVals->size());
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testHolderValuesNotEmpty():Boolean[1]
{
    let coll = ^meta::pure::metamodel::valuespecification::Collection(
        values = [
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 42, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne)
        ],
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    );
    let holder = ^meta::pure::functions::valueSpecificationManipulation::VSHolder(values = [$coll]);
    assert($holder.values->isEmpty() == false);
    assert($holder.values->at(0)->instanceOf(meta::pure::metamodel::valuespecification::Collection));
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testFoldCollectionThenStoreInHolder():Boolean[1]
{
    let items = [
        ^meta::pure::metamodel::valuespecification::AtomicValue(value = 1, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne),
        ^meta::pure::metamodel::valuespecification::AtomicValue(value = 2, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne)
    ];
    let collection = $items->fold({e, acc |
        ^$acc(values += $e);
    }, ^meta::pure::metamodel::valuespecification::Collection(
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    ));
    let holder = ^meta::pure::functions::valueSpecificationManipulation::VSHolder(values = [$collection]);
    let holderVals = $holder.values;
    assertEquals(1, $holderVals->size());
    let retrieved = $holderVals->at(0);
    let result = []->cast(@meta::pure::metamodel::valuespecification::ValueSpecification)->concatenate($retrieved->cast(@meta::pure::metamodel::valuespecification::ValueSpecification));
    assertEquals(1, $result->size());
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testConcatenateFromHolder():Boolean[1]
{
    let av = ^meta::pure::metamodel::valuespecification::AtomicValue(
        value = 42,
        genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer),
        multiplicity = meta::pure::metamodel::multiplicity::PureOne
    );
    let holder = ^meta::pure::functions::valueSpecificationManipulation::VSHolder(values = [$av]);
    let item = $holder.values->at(0);
    let result = []->cast(@meta::pure::metamodel::valuespecification::ValueSpecification)->concatenate($item->cast(@meta::pure::metamodel::valuespecification::ValueSpecification));
    assertEquals(1, $result->size());
}

// Verifies that a meta-level AtomicValue created via ^AtomicValue(...) is treated
// as data, not as an execution-level wrapper. If wrap() short-circuited on AtomicValue
// (returning av as-is instead of wrapping it), the meta AV would lose its object identity:
// instanceOf would see Integer instead of AtomicValue, and .value would fail.
function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testMetaAtomicValueIsNavigable():Boolean[1]
{
    let av = ^meta::pure::metamodel::valuespecification::AtomicValue(
        value = 42,
        genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer),
        multiplicity = meta::pure::metamodel::multiplicity::PureOne
    );
    assert($av->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue));
    assertEquals(42, $av.value);
    true;
}

// Tests that a Collection stored in a property is treated as multiple values,
// not as a single Collection value. In Pure, a Collection IS multiple values.
Class meta::pure::functions::valueSpecificationManipulation::VSResult
{
    resolved: meta::pure::metamodel::valuespecification::ValueSpecification[*];
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testCollectionStoredInPropertyIsMultipleValues():Boolean[1]
{
    let col = ^meta::pure::metamodel::valuespecification::Collection(
        values = [
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 1, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne),
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 2, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne)
        ],
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    );
    let result = ^meta::pure::functions::valueSpecificationManipulation::VSResult(resolved = $col);
    // $result.resolved should return 1 element (the Collection itself), not 2 (its elements)
    assert($result.resolved->isNotEmpty());
    assert($result.resolved->size() == 1);
    assert($result.resolved->toOne()->instanceOf(meta::pure::metamodel::valuespecification::Collection));
    true;
}

// Reproduces the appendToProperty re-unwrap bug: when folding AtomicValues
// into a holder with +=, the first element gets its AtomicValue wrapper stripped
// on the second append (appendToProperty re-unwraps existing items).
Class meta::pure::functions::valueSpecificationManipulation::AVHolder
{
    items: meta::pure::metamodel::valuespecification::AtomicValue[*];
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testFoldPlusEqualsPreservesAllElements():Boolean[1]
{
    let av1 = ^meta::pure::metamodel::valuespecification::AtomicValue(value = 1, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne);
    let av2 = ^meta::pure::metamodel::valuespecification::AtomicValue(value = 2, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne);
    let result = [$av1, $av2]->fold({e, acc |
        ^$acc(items += $e);
    }, ^meta::pure::functions::valueSpecificationManipulation::AVHolder());
    assertEquals(2, $result.items->size());
    // Both elements must retain their AtomicValue type AND their Integer genericType
    assert($result.items->at(0)->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue));
    assert($result.items->at(1)->instanceOf(meta::pure::metamodel::valuespecification::AtomicValue));
    assertEquals(Integer, $result.items->at(0).genericType->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type->toOne());
    assertEquals(Integer, $result.items->at(1).genericType->cast(@meta::pure::metamodel::type::generics::GenericTypeValue).type->toOne());
    true;
}

// Walk expressionSequence and cast elements to ValueSpecification — reproduces
// the compiler-pure pattern: $fn.expressionSequence->cast(@ValueSpecification)
function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testExpressionSequenceCastToValueSpecification():Boolean[1]
{
    let fn = meta::pure::functions::valueSpecificationManipulation::sampleFunction__Any_MANY_;
    let exprs = $fn.expressionSequence;
    let vsExprs = $exprs->cast(@meta::pure::metamodel::valuespecification::ValueSpecification);
    assertEquals(3, $vsExprs->size());
    true;
}

// Walk expressionSequence and cast elements to AtomicValue, then access .value —
// reproduces the compiler printer pattern: $a->cast(@AtomicValue).value->toOne()
function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testExpressionSequenceCastToAtomicValue():Boolean[1]
{
    let fn = meta::pure::functions::valueSpecificationManipulation::sampleFunction__Any_MANY_;
    let exprs = $fn.expressionSequence;
    let first = $exprs->at(0)->cast(@meta::pure::metamodel::valuespecification::AtomicValue);
    assertEquals(1, $first.value);
    true;
}

// Walk expressionSequence and access .genericType on each element —
// reproduces the compiler pattern: $a.genericType->toOne()->printType()
function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testExpressionSequenceGenericType():Boolean[1]
{
    let fn = meta::pure::functions::valueSpecificationManipulation::sampleFunction__Any_MANY_;
    let exprs = $fn.expressionSequence;
    let first = $exprs->at(0)->cast(@meta::pure::metamodel::valuespecification::AtomicValue);
    assert($first.genericType->isNotEmpty());
    true;
}

// Walk expressionSequence via match — reproduces the compiler printValueSpecification pattern
function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testExpressionSequenceMatch():Boolean[1]
{
    let fn = meta::pure::functions::valueSpecificationManipulation::sampleFunction__Any_MANY_;
    let results = $fn.expressionSequence->map(vs |
        $vs->match([
            a:meta::pure::metamodel::valuespecification::AtomicValue[1] | $a.value->toOne()->toString(),
            v:meta::pure::metamodel::valuespecification::ValueSpecification[1] | 'vs'
        ])
    );
    assertEquals('1', $results->at(0));
    assertEquals('hello', $results->at(1));
    assertEquals('true', $results->at(2));
    true;
}

function meta::pure::functions::valueSpecificationManipulation::sampleFunction():Any[*]
{
    1;
    'hello';
    true;
}

// Collection in [0..1] property tests
Class meta::pure::functions::valueSpecificationManipulation::SingleVSHolder
{
    value: meta::pure::metamodel::valuespecification::ValueSpecification[0..1];
}

function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testCollectionInSingleValuedProperty():Boolean[1]
{
    let col = ^meta::pure::metamodel::valuespecification::Collection(
        values = [
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 1, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne),
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 2, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne)
        ],
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    );
    let holder = ^meta::pure::functions::valueSpecificationManipulation::SingleVSHolder(value = $col);
    assert($holder.value->size() == 1);
    assert($holder.value->toOne()->instanceOf(meta::pure::metamodel::valuespecification::Collection));
    true;
}

// Plain copy — goes through shallowCopyProperties → getInstanceProperty.
// Reproduces: getInstanceProperty returns a naked Collection VS (line 1105-1107),
// then setInstanceProperty → put(unwrap(Collection)) flattens it.
function <<test.Test>> meta::pure::functions::valueSpecificationManipulation::testCollectionPlainCopy():Boolean[1]
{
    let col = ^meta::pure::metamodel::valuespecification::Collection(
        values = [
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 1, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne),
            ^meta::pure::metamodel::valuespecification::AtomicValue(value = 2, genericType = ^meta::pure::metamodel::type::generics::UserDefinedGenericType(type = Integer), multiplicity = meta::pure::metamodel::multiplicity::PureOne)
        ],
        genericType = ^meta::pure::metamodel::type::generics::UndefinedGenericType(),
        multiplicity = meta::pure::metamodel::multiplicity::ZeroMany
    );
    let holder1 = ^meta::pure::functions::valueSpecificationManipulation::SingleVSHolder(value = $col);
    let holder2 = ^$holder1();
    assert($holder2.value->size() == 1);
    assert($holder2.value->toOne()->instanceOf(meta::pure::metamodel::valuespecification::Collection));
    true;
}
