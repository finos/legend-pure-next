import meta::pure::metamodel::type::*;
import meta::pure::test::pct::*;

native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::meta::creation::newClass(typeParameters:meta::pure::metamodel::type::generics::TypeParameter[*], multiplicityParameters:meta::pure::metamodel::multiplicity::MultiplicityParameter[*]): Class<Any>[1];

function <<test.Test>> meta::pure::functions::meta::tests::creation::testNewClassEmpty():Boolean[1]
{
    let cls = meta::pure::functions::meta::creation::newClass([], []);

    // Should be a Class
    assert($cls->instanceOf(Class));

    // Self-referencing CGT: Class<cls>
    let cgt = $cls.classifierGenericType->toOne()->cast(@GenericTypeValue);
    assertIs(Class, $cgt.type->toOne());
    let selfGT = $cgt.typeArguments->at(0)->cast(@GenericTypeValue);
    assertIs($cls, $selfGT.type->toOne());

    // No type parameters or multiplicity parameters
    assertEquals(0, $cls.typeParameters->size());
    assertEquals(0, $cls.multiplicityParameters->size());
}

function <<test.Test>> meta::pure::functions::meta::tests::creation::testNewClassWithTypeParameter():Boolean[1]
{
    let tp = ^TypeParameter(name='T', contravariant=false);
    let cls = meta::pure::functions::meta::creation::newClass([$tp], []);

    // Type parameters should be set
    assertEquals(1, $cls.typeParameters->size());

    // TypeParameter owner should be the created class
    let actualTp = $cls.typeParameters->at(0);
    assert($actualTp.owner->isNotEmpty(), 'TypeParameter owner should be set');
    assertIs($cls, $actualTp.owner->toOne());

    // Self-referencing CGT should include the type parameter
    let cgt = $cls.classifierGenericType->toOne()->cast(@GenericTypeValue);
    let selfGT = $cgt.typeArguments->at(0)->cast(@GenericTypeValue);
    assertIs($cls, $selfGT.type->toOne());
    assertEquals(1, $selfGT.typeArguments->size());
    let tpGT = $selfGT.typeArguments->at(0)->cast(@GenericTypeValue);
    assertIs($actualTp, $tpGT.type->toOne());
}

function <<test.Test>> meta::pure::functions::meta::tests::creation::testNewClassWithMultipleTypeParameters():Boolean[1]
{
    let tp1 = ^TypeParameter(name='T', contravariant=false);
    let tp2 = ^TypeParameter(name='U', contravariant=false);
    let cls = meta::pure::functions::meta::creation::newClass([$tp1, $tp2], []);

    assertEquals(2, $cls.typeParameters->size());

    // Both TypeParameters should have owner set to cls
    assertIs($cls, $cls.typeParameters->at(0).owner->toOne());
    assertIs($cls, $cls.typeParameters->at(1).owner->toOne());
}

function <<test.Test>> meta::pure::functions::meta::tests::creation::testNewClassCGTSurvivesCopy():Boolean[1]
{
    let tp = ^TypeParameter(name='T', contravariant=false);
    let cls = meta::pure::functions::meta::creation::newClass([$tp], []);
    let named = ^$cls(name='MyClass');

    // The CGT on the copy should be Class<MyClass<T~MyClass>>
    let cgt = $named.classifierGenericType->toOne()->cast(@GenericTypeValue);
    assertIs(Class, $cgt.type->toOne());
    let selfGT = $cgt.typeArguments->at(0)->cast(@GenericTypeValue);
    assertIs($named, $selfGT.type->toOne());

    // The self-GT should carry the TypeParameter as a type argument
    assertEquals(1, $selfGT.typeArguments->size(), 'self-GT should have 1 type arg (the TypeParameter)');
    let tpGT = $selfGT.typeArguments->at(0)->cast(@GenericTypeValue);
    let tpType = $tpGT.type->toOne();
    assert($tpType->instanceOf(TypeParameter), 'type arg should be TypeParameter');
}

function <<test.Test>> meta::pure::functions::meta::tests::creation::testNewClassOwnerSurvivesCopy():Boolean[1]
{
    let tp = ^TypeParameter(name='T', contravariant=false);
    let cls = meta::pure::functions::meta::creation::newClass([$tp], []);

    // Copy the class with a name — simulates what the compiler does
    let named = ^$cls(name='MyClass');

    // The TypeParameter from the COPIED class should still have owner pointing to the copy
    let copiedTp = $named.typeParameters->at(0);
    assert($copiedTp.owner->isNotEmpty(), 'TypeParameter owner should survive copy');
    assertIs($named, $copiedTp.owner->toOne());
    assertEquals('MyClass', $copiedTp.owner->toOne()->cast(@PackageableElement).name->toOne());
}
