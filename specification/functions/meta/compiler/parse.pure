import meta::pure::protocol::*;

native function meta::pure::functions::meta::parse(sourceId:String[1], content:String[1]):PureFile[1];

function <<test.Test>> meta::pure::functions::meta::testParseNativeIntegration() : Boolean[1]
{
    let content = 'Class pkg::MyClass { name:String[1]; }';
    let file = meta::pure::functions::meta::parse('testSource', $content);
    assertEquals('testSource', $file.sourceId);
    assertEquals(1, $file.sections->size());

    let section = $file.sections->at(0);
    assertEquals(1, $section.elements->size());

    let cls = $section.elements->at(0)->cast(@meta::pure::protocol::grammar::type::Class);
    assertEquals('MyClass', $cls.name);
    assertEquals('pkg', $cls.package->cast(@meta::pure::protocol::grammar::Package_Pointer).value);
    assertEquals(1, $cls.properties->size());

    let prop = $cls.properties->at(0);
    assertEquals('name', $prop.name);
}

function <<test.Test>> meta::pure::functions::meta::testParseUnknownSectionThrows() : Boolean[1]
{
    assertError(|meta::pure::functions::meta::parse('test', '###Pure\nClass a::A {}\n\n###Unknown\nstuff\n'), 'No parser registered for section: ###Unknown');
}

function <<test.Test>> meta::pure::functions::meta::testParseEnumPropertyValues() : Boolean[1]
{
    // Parse a class with a composite aggregation property
    let content = 'Class pkg::MyClass { (composite) child:String[*]; name:String[1]; }';
    let file = meta::pure::functions::meta::parse('testSource', $content);
    let cls = $file.sections->at(0).elements->at(0)->cast(@meta::pure::protocol::grammar::type::Class);

    // The composite property's aggregation should be an Enum_Pointer referencing the metamodel enum
    let compositeProp = $cls.properties->filter(p | $p.name == 'child')->at(0);
    let enumPtr = $compositeProp.aggregation->cast(@meta::pure::protocol::grammar::Enum_Pointer);
    assertEquals('meta::pure::metamodel::function::property::AggregationKind', $enumPtr.value);
    assertEquals('Composite', $enumPtr.extraPointerValues->at(0).value);
}
