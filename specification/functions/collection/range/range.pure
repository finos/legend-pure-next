import meta::pure::functions::collection::*;

// range(count) returns [0, 1, ..., count-1].
function meta::pure::functions::collection::range(count:Integer[1]):Integer[*]
{
    range(0, $count);
}

// range(start, end) returns [start, start+1, ..., end-1]. Empty when start >= end.
// Implemented as divide-and-conquer so the recursion depth is O(log n) rather
// than O(n) — important on a tree-walking interpreter where each Pure call
// consumes many Java stack frames.
function meta::pure::functions::collection::range(start:Integer[1], end:Integer[1]):Integer[*]
{
    if($start >= $end,
        | [],
        | if($start + 1 == $end,
            | $start,
            | let mid = floor(($start + $end) / 2);
              range($start, $mid)->concatenate(range($mid, $end));
        )
    );
}
