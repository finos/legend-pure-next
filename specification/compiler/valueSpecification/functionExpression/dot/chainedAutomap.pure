###Pure
import test::*;

Class test::CA_Person
{
    firstName : String[1];
    lastName : String[1];
    address : CA_Address[0..1];
}

Class test::CA_Address
{
    name : String[1];
}

// Local function with same signature as assertEquals to force local resolution
function test::myCheck(expected:Any[*], actual:Any[*]):Boolean[1]
{
    true;
}

// Reproduces chained automap inside eval lambda: [$a, $b].address.name
// Both .address and .name should be resolved with automap
function test::testChainedAutomap<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let addressParis = ^CA_Address(name='Paris, FR');
    let addressHoboken = ^CA_Address(name='Hoboken, NJ, US');
    let smith = ^CA_Person(firstName='Fabrice', lastName='Smith', address=$addressParis);
    let roe = ^CA_Person(firstName='David', lastName='Roe', address=$addressHoboken);
    myCheck(['Paris, FR', 'Hoboken, NJ, US'], $f->eval(|[$smith, $roe].address.name));
}

