import test::*;

Class test::TPR_Person
{
    firstName : String[1];
    lastName : String[1];
}

// Local function with same signature as assertEquals to force local resolution
function test::myCheck(expected:Any[*], actual:Any[*]):Boolean[1]
{
    true;
}

// eval + let + automap inside local function call.
// Z should be resolved transitively through eval, making $res.lastName valid.
function test::testTypeParamResolution<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let res = $f->eval(|^TPR_Person(firstName='A', lastName='B')->head());
    myCheck('B', $res.lastName);
}

