###Pure
import test::*;

// A function that takes two T-typed params — the simplest generic
function test::first<T>(a: T[1], b: T[1]): T[1]
{
    $a
}

// WITHOUT outer <T>: first(1, 'hello') → first.T = common(Integer, String) = Any
function test::baselineNoTypeParam(): Any[1]
{
    test::first(1, 'hello')
}

// WITH outer <T>: should produce the EXACT same result as above.
// If the name collision causes a different result, that's the bug.
function test::withTypeParam<T>(x: T[1]): Any[1]
{
    test::first(1, 'hello')
}

