###Pure
import test::*;

Class test::MPV_Person
{
    firstName : String[1];
    lastName : String[1];
}

// map with a Property passed as a variable:
// the Property<Nil, Any|*> must be resolved to Function<{Nil[1]->Any[*]}>
// before type parameter binding so that map resolves correctly.
function test::testMapWithPropertyAsVariable():Boolean[1]
{
    let vals = [^MPV_Person(firstName='a', lastName='a'), ^MPV_Person(firstName='b', lastName='b')];
    let property = MPV_Person.properties->filter(p | $p.name == 'lastName')->toOne();
    assertEquals(['a','b'], $vals->map($property));
}

