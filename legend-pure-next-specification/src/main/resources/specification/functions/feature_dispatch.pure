Class <<test.TestDependency>> meta::pure::functions::tests::dispatch::SuperClass
{
    poly() { 'super' }: String[1];
}

Class <<test.TestDependency>> meta::pure::functions::tests::dispatch::SubClass1 extends meta::pure::functions::tests::dispatch::SuperClass
{
    poly() { 'sub1' }: String[1];
}

Class <<test.TestDependency>> meta::pure::functions::tests::dispatch::SubClass2 extends meta::pure::functions::tests::dispatch::SuperClass
{
    poly() { 'sub2' }: String[1];
}

function <<test.Test>> meta::pure::functions::tests::dispatch::testPolymorphicQualifiedPropertyDispatch():Boolean[1]
{
    let sup = ^meta::pure::functions::tests::dispatch::SuperClass();
    let sub1 = ^meta::pure::functions::tests::dispatch::SubClass1();
    let sub2 = ^meta::pure::functions::tests::dispatch::SubClass2();

    assertEquals('super', $sup.poly());
    assertEquals('sub1', $sub1.poly());
    assertEquals('sub2', $sub2.poly());

    let list = [$sup, $sub1, $sub2];
    assertEquals(['super', 'sub1', 'sub2'], $list->map(x | $x.poly()));

    // Test calling via explicit superclass pointer 
    let pointer1 = $sub1->cast(@meta::pure::functions::tests::dispatch::SuperClass);
    let pointer2 = $sub2->cast(@meta::pure::functions::tests::dispatch::SuperClass);

    assertEquals('sub1', $pointer1.poly());
    assertEquals('sub2', $pointer2.poly());
}
