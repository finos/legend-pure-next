import meta::pure::test::pct::*;
import meta::pure::functions::lang::tests::model::*;
import meta::pure::functions::lang::tests::parentReference::*;

native function <<PCT.platformOnly>> meta::pure::functions::lang::parentReference(depth:Integer[1], propertyPath:String[1]):Any[1];

// =============================================
// Test: Self-reference loop using ~
// =============================================
function <<test.Test>> meta::pure::functions::lang::tests::parentReference::testSelfReferenceLoop():Boolean[1]
{
    let n = ^LA_Node(value=1, next=~);
    assertEquals(1, $n.value);
    assertIs($n, $n.next->toOne());
}

// =============================================
// Test: Nested back-reference using ~.~
// =============================================
function <<test.Test>> meta::pure::functions::lang::tests::parentReference::testNestedBackReference():Boolean[1]
{
    // Outer node's next is an inner node whose next points back to the outer via ~.~
    let outer = ^LA_Node(value=1, next=^LA_Node(value=2, next=~.~));
    assertEquals(1, $outer.value);
    let inner = $outer.next->toOne();
    assertEquals(2, $inner.value);
    assertIs($outer, $inner.next->toOne());
}

// =============================================
// Test: Copy with self-reference loop using ~
// =============================================
function <<test.Test>> meta::pure::functions::lang::tests::parentReference::testCopySelfReference():Boolean[1]
{
    let n = ^LA_Node(value=1);
    let c = ^$n(next=~);
    assertEquals(1, $c.value);
    assertIs($c, $c.next->toOne());
}
