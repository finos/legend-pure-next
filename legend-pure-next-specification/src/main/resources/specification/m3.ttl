# =============================================================================
# CLASSES AND THEIR PROPERTIES
# =============================================================================

# --- Class ---

:Class a :Class ;
    :name "Class" ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Class ; :typeArguments [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Class ; :typeArguments [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "T" ] ] ] ] ;
    :package :meta_pure_metamodel_type ;
    :TypeAndMultiplicityParametersOwner_typeParameters [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "T" ] ;
    :generalizations 
        [ a :Generalization ; :classifierGenericType :GenericType_Generalization ; :specific :Class ; :general :GenericType_Type ],
        [ a :Generalization ; :classifierGenericType :GenericType_Generalization ; :specific :Class ; :general :GenericType_PropertyOwner ],
        [ a :Generalization ; :classifierGenericType :GenericType_Generalization ; :specific :Class ; :general :GenericType_ElementWithConstraints ],
        [ a :Generalization ; :classifierGenericType :GenericType_Generalization ; :specific :Class ; :general :GenericType_Testable ],
        [ a :Generalization ; :classifierGenericType :GenericType_Generalization ; :specific :Class ; :general :GenericType_TypeAndMultiplicityParametersOwner ] .

:qualifiedProperties a :Property ;
    :abstractProperty_name "qualifiedProperties" ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( :GenericType_PropertyOwner [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :QualifiedProperty ; :typeArguments :GenericType_Any ] ) ; :multiplicityArguments :ZeroMany ] ;
    :owner :PropertyOwner ;
    :genericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :QualifiedProperty ; :typeArguments :GenericType_Any ] ;
    :multiplicity :ZeroMany .

:propertiesFromAssociations a :Property ;
    :stereotypes :ProtocolInfo_inferred, :ProtocolInfo_pointer ;
    :abstractProperty_name "propertiesFromAssociations" ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Class ; :typeArguments [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "T" ] ] ] [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "T" ] ] :GenericType_Any ) ; :multiplicityArguments :ZeroMany ] ) ; :multiplicityArguments :ZeroMany ] ;
    :owner :Class ;
    :genericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "T" ] ] :GenericType_Any ) ; :multiplicityArguments :ZeroMany ] ;
    :multiplicity :ZeroMany .

:qualifiedPropertiesFromAssociations a :Property ;
    :stereotypes :ProtocolInfo_inferred, :ProtocolInfo_pointer ;
    :abstractProperty_name "qualifiedPropertiesFromAssociations" ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Class ; :typeArguments [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "T" ] ] ] [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :QualifiedProperty ; :typeArguments :GenericType_Any ] ) ; :multiplicityArguments :ZeroMany ] ;
    :owner :Class ;
    :genericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :QualifiedProperty ; :typeArguments :GenericType_Any ] ;
    :multiplicity :ZeroMany .

:typeVariables a :Property ;
    :abstractProperty_name "typeVariables" ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Class ; :typeArguments [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "T" ] ] ] :GenericType_VariableExpression ) ; :multiplicityArguments :ZeroMany ] ;
