:aggregation a :Property ;
    :abstractProperty_name "aggregation" ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "U" ; :contravariant true ] ] [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "V" ] ] ) ] :GenericType_AggregationKind ) ; :multiplicityArguments :PureOne ] ;
    :owner :Property ;
    :genericType :GenericType_AggregationKind ;
    :multiplicity :PureOne ;
    :prop_defaultValue [ a :LambdaFunction ;
        :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :LambdaFunction ; :typeArguments [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :FunctionType ; :classifierGenericType :GenericType_FunctionType ; :returnType :GenericType_AggregationKind ; :returnMultiplicity :PureOne ] ] ] ;
        :expressionSequence [ a :AtomicValue ;
            :classifierGenericType :GenericType_AtomicValue ;
            :ValueSpecification_genericType :GenericType_AggregationKind ;
            :ValueSpecification_multiplicity :PureOne ;
            :AtomicValue_value :AggregationKind_None ] ] .

:prop_defaultValue a :Property ;
    :abstractProperty_name "defaultValue" ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "U" ; :contravariant true ] ] [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "V" ] ] ) ] [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :LambdaFunction ; :typeArguments [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :FunctionType ; :classifierGenericType :GenericType_FunctionType ; :returnType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "V" ] ] ; :returnMultiplicity :PureOne ] ] ] ) ; :multiplicityArguments :ZeroOne ] ;
    :owner :Property ;
    :genericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :LambdaFunction ; :typeArguments [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :FunctionType ; :classifierGenericType :GenericType_FunctionType ; :returnType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type [ a :TypeParameter ; :classifierGenericType :GenericType_TypeParameter ; :typeParameter_name "V" ] ] ; :returnMultiplicity :PureOne ] ] ] ;
    :multiplicity :ZeroOne .

