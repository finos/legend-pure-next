:originalMilestonedProperties a :Property ;
    :stereotypes :ProtocolInfo_inferred ;
    :abstractProperty_name "originalMilestonedProperties" ;
    :classifierGenericType [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( :GenericType_PropertyOwner [ a :UserDefinedGenericType ; :classifierGenericType :GenericType_GenericType ; :type :Property ; :typeArguments ( :GenericType_Nil :GenericType_Any ) ; :multiplicityArguments :ZeroMany ] ) ; :multiplicityArguments :ZeroMany ] ;
