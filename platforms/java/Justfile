# Every suite this platform runs, each writing its own java@platform report for
# the dashboard. `compile` is a dependency of each and just runs it once.
# Failures land in the reports rather than failing the build (see each recipe).
# The module's JUnit tests: the host API end to end (TestPureRuntime), as bootstrap and
# Truffle run theirs. Needs `compile` first — the tests drive the compiled platform.
test-junit: compile
    @{{header}} 'test-junit'
    @{{substep}} 'mvn test: src/test/java'
    cd {{module}} && mvn -q test

test-all: pct test-junit test-translation spec-functions spec-grammar spec-compiler spec-pdb-format spec-pdb

# The Pure -> Java gallery, rendered BY THIS PLATFORM: the translated renderer
# runs on the JVM, so every card shows the Java this platform generates and runs
# (the Truffle harness renders the same page through its own adapter).
gallery PACKAGE="meta::pure::functions" OUT=(java_root / "build" / "java-platform-gallery.html"): compile
    @{{header}} 'gallery'
    @{{substep}} 'render {{PACKAGE}} -> {{OUT}}'
    java -Xmx{{jvm_heap}} -Xss64m -cp {{run_classpath}} org.finos.legend.pure.platform.java.execution.Execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::gallery::renderGallery_String_1__String_1_" \
        --args "{{PACKAGE}}" > {{OUT}}
    @echo "  wrote {{OUT}} ($(wc -c < {{OUT}} | tr -d ' ') bytes)"

# Read a Class element out of a PDB with the translated reader.
spike PDB=(shared / "core.pdb") ELEMENT="meta::pure::metamodel::type::Class": compile
    @{{header}} 'spike'
    @{{substep}} 'java: read {{ELEMENT}}'
    java -cp {{classes}} org.finos.legend.pure.platform.java.compiler.module.pdbModule.PdbSpike "{{PDB}}" {{repo_root}}/shared/specification/m3.fbs "{{ELEMENT}}"

# Navigate the Pure metamodel from PDBs through the generated typed interfaces.
metamodel-spike ELEMENT="meta::pure::metamodel::type::Class": compile
    @{{header}} 'metamodel-spike'
    @{{substep}} 'java: navigate {{ELEMENT}} (core.pdb + compiler.pdb)'
    java -cp {{classes}} org.finos.legend.pure.platform.java.compiler.module.pdbModule.MetamodelSpike {{repo_root}}/shared/specification/m3.fbs "{{ELEMENT}}" {{shared}}/core.pdb {{shared}}/compiler.pdb

# One object model: instances built at run time next to PDB-read ones.
model-spike: compile
    @{{header}} 'model-spike'
    @{{substep}} 'java: build a Class in memory, copy a PDB element'
    java -cp {{classes}} org.finos.legend.pure.platform.java.compiler.module.pdbModule.ModelSpike {{repo_root}}/shared/specification/m3.fbs {{shared}}/core.pdb
