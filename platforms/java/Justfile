        || echo "  failures do not fail the build: they are in the report"

# The PDB wire contract ON this platform: compile each compiler fixture, write it
# with the Pure writer and compare the archive with the Java golden in
# pure/specification/compiler/tests-pdb-serialization. This one compiles from
# source, so it parses -> it needs the ANTLR extension, and compiler-tests.pdb
# for the fixtures' section parsers.
spec-pdb: compile
    @{{header}} 'spec-pdb'
    @{{substep}} 'runPdbGoldenTests: the Pure writer against the Java golden archives (Java platform)'
    mkdir -p {{repo_root}}/test-results/spec/pdb
    java -Xmx{{jvm_heap}} -Xss64m -cp {{run_classpath}} org.finos.legend.pure.platform.java.execution.Execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::pure::compiler::test::pdb::runPdbGoldenTests_String_1__String_1__String_1__String_1__String_1_" \
        --args "{{repo_root}}/pure/specification/compiler/tests" "{{repo_root}}/pure/specification/compiler/tests-pdb-serialization" "{{shared}}/specification/m3.fbs" "{{repo_root}}/test-results/spec/pdb/java@platform.json" \
        || echo "  failures do not fail the build: they are in the report"

