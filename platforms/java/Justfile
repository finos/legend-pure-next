# platforms/java/Justfile — the Java platform.
#
# Direct invocation:    just <recipe>         (from platforms/java/)
# Via the root Justfile: just java::<recipe>  (from repo root)
#
# The platform's runtime is Pure translated to JDK-only Java: generated/ holds
# the translated packages (gitignored), src/ the handwritten host. First stage:
# the self-hosted PDB reader, which lets the platform read PDBs lazily.

set quiet := true
set shell := ["bash", "-c"]

java_root              := source_directory()
repo_root              := java_root / ".." / ".."
shared                 := repo_root / "shared"
language_java_out      := repo_root / "pure" / "modules" / "language" / "java" / "build"
translation_shared_out := repo_root / "pure" / "modules" / "translation" / "shared" / "build"
translation_java_out   := repo_root / "pure" / "modules" / "translation" / "java" / "build"
pure_truffle           := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"
pure_bootstrap         := repo_root / "bootstrap" / "bin" / "pure-bootstrap"

# The Pure runtime that RUNS the transform when generating this platform's Java.
#
# Truffle, because it is 2.4x faster on the same work — full `compile` 253s ->
# 105s, `generate-functions` 54s -> 18s — and because the output is now
# BYTE-IDENTICAL to bootstrap's (`diff -r`, 0 lines). It was not always: Truffle
# capped recursive <<equality.Key>> comparison at depth 10, so types nested
# deeper than ten packages compared unequal and the translator emitted a doubled
# cast. Fixed in EqualNode and pinned by
# factory::tests::classEqualityIsStructuralAtDepth — if that test ever fails,
# the two runtimes have diverged again and this default is unsafe.
#
# A BUILD-TIME dependency only: nothing generated here references Truffle, and
# the platform still runs on the JDK alone. Switch back with:
#     just pure_rt=bootstrap java::compile
pure_rt                := "truffle"
emit_rt                := if pure_rt == "truffle" { pure_truffle } else { pure_bootstrap }
emit_rt_jar            := if pure_rt == "truffle" { repo_root / "platforms" / "truffle" / "build" / "pure-truffle.jar" } else { repo_root / "bootstrap" / "build" / "pure-bootstrap.jar" }
emit_rt_recipe         := if pure_rt == "truffle" { "just truffle::build" } else { "just bootstrap::build" }
# The Maven module: the handwritten host plus the translator's output, compiled
# as ONE unit (they reference each other) with no dependencies — see its pom.
module                 := java_root / "legend-pure-next-java"
generated              := module / "generated"
classes                := module / "target" / "classes"
# The ANTLR runtime, staged by the module's build (copy-dependencies) because a run is
# `java -cp` assembled here rather than by maven. Parsing is part of the platform now:
# it used to be a separate ext/antlr compiled against the bootstrap fat jar, which was
# this platform's last dependency on another platform.
antlr_runtime          := module / "target" / "lib" / "antlr4-runtime-4.13.2.jar"
# What a run needs. Nothing from bootstrap or Truffle.
run_classpath          := classes + ":" + antlr_runtime

# Heap for a suite run. Measured on the PDB golden corpus (the heaviest): it
# passes in 512m, and 6g bought nothing once the writer was pre-generated —
# 62.3s at 6g vs 67.0s at 512m, peak usage just tracking the ceiling. Kept well
# clear of what a GitHub-hosted runner has. Override: `just jvm_heap=6g java::pct`.
jvm_heap               := "2g"

header := "h(){ s=\"[java::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

default: spike

# Translate the self-hosted PDB reader (meta::pure::compiler::pdb reader + schema):
# a class per function under generated/org/finos/legend/pure/m3/meta/pure/..., in
# the Java package mirroring its Pure package.
generate-pdb:
    @{{header}} 'generate-pdb'
    @{{substep}} 'translate meta::pure::compiler::pdb (reader + writer) -> generated/org/finos/legend/pure/m3'
    test -f {{translation_java_out}}/java-translation-tests.pdb || (echo "ERROR: missing {{translation_java_out}}/java-translation-tests.pdb (run \`just modules::translation_java::build-tests\` first)" && exit 1)
    # The WHOLE pdb package — reader, schema and the writer stack (gen, fbb,
    # archive, writerHelper) — which is exactly the directory wiped below. The
    # writer used to be left out, so every golden test re-translated it at run
    # time (Execute.call falls back to Metadata.translateAndInvoke when there is
    # no class). The JavaScript platform emits this same package whole.
    # Not the parent `compiler` package: that would take the types generate-types
    # just wrote under compiler/test with it.
    rm -rf {{generated}}/org/finos/legend/pure/m3/meta/pure/compiler/pdb
    set -o pipefail; {{emit_rt}} execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::translatePackagesToJava_String_1__String_1_" \
        --args "meta::pure::compiler::pdb" \
        2> >(grep -v '^WARNING' >&2) | grep -v '^\[graal-tripwire\]' \
        | awk -v root="{{generated}}" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } file != "" { print > file }'

# Generate the Java interfaces / enums of the Pure metamodel (meta::pure::metamodel)
# and of the core library's classes (meta::pure::functions: List, Pair, TryResult,
# Error, ...) into generated/org/finos/legend/pure/m3/...
generate-types:
    @{{header}} 'generate-types'
    @{{substep}} 'generate meta::pure::{metamodel,functions,compiler::test} interfaces + enums -> generated/org/finos/legend/pure/m3'
    test -f {{translation_java_out}}/java-translation-tests.pdb || (echo "ERROR: missing {{translation_java_out}}/java-translation-tests.pdb (run \`just modules::translation_java::build-tests\` first)" && exit 1)
    rm -rf {{generated}}/org/finos/legend/pure/m3/meta/pure/metamodel {{generated}}/org/finos/legend/pure/m3/meta/pure/functions {{generated}}/org/finos/legend/pure/m3/meta/pure/compiler/test {{generated}}/org/finos/legend/pure/m3/PdbTypes.java
    set -o pipefail; {{emit_rt}} execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::platform::generatePlatformTypes_String_1__String_1__String_1_" \
        --args "meta::pure::metamodel,meta::pure::functions,meta::pure::compiler::test" "org.finos.legend.pure.m3" \
        2> >(grep -v '^WARNING' >&2) | grep -v '^\[graal-tripwire\]' \
        | awk -v root="{{generated}}" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } { print > file }'
    echo "  $(find {{generated}}/org/finos/legend/pure/m3 -name '*.java' | wc -l | tr -d ' ') files"

# Generate the runtime classes every translated program calls (PureMap, PureMatch,
# Variant, PureDate, PureFormat, PureBytes) into generated/org/finos/legend/pure/platform/java/runtime.
generate-runtime:
    @{{header}} 'generate-runtime'
    @{{substep}} 'generate PureMap, PureMatch, Variant, PureDate, PureFormat, PureBytes -> generated/.../runtime'
    test -f {{translation_java_out}}/java-translation-tests.pdb || (echo "ERROR: missing {{translation_java_out}}/java-translation-tests.pdb (run \`just modules::translation_java::build-tests\` first)" && exit 1)
    rm -rf {{generated}}/org/finos/legend/pure/platform/java/runtime
    set -o pipefail; {{emit_rt}} execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::generateRuntimeClasses__String_1_" \
        2> >(grep -v '^WARNING' >&2) | grep -v '^\[graal-tripwire\]' \
        | awk -v root="{{generated}}" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } file != "" { print > file }'

# Translate the Java translator (meta::external::language::java::translation) and
# every function it reaches (the java factory and serializer, translation shared,
# the Pure compiler, the core library) into generated/. A function that doesn't
# translate is a stub throwing "not translated: <reason>".
generate-translator:
    @{{header}} 'generate-translator'
    @{{substep}} 'translate meta::external::language::java::translation -> generated/org/finos/legend/pure/m3'
    test -f {{translation_java_out}}/java-translation-tests.pdb || (echo "ERROR: missing {{translation_java_out}}/java-translation-tests.pdb (run \`just modules::translation_java::build-tests\` first)" && exit 1)
    set -o pipefail; {{emit_rt}} execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::translatePackagesToJava_String_1__String_1_" \
        --args "meta::external::language::java::translation" \
        2> >(grep -v '^WARNING' >&2) | grep -v '^\[graal-tripwire\]' \
        | awk -v root="{{generated}}" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } file != "" { print > file }'
    echo "  $(grep -rl 'not translated' {{generated}} | wc -l | tr -d ' ') functions not translated"

# Pre-generate the FUNCTION LIBRARY itself (meta::pure::functions).
#
# Pre-generate the FUNCTION LIBRARY (meta::pure::functions::**), so no function
# has to be translated and javac'd at run time.
#
# generate-tests pulls in whatever its test seeds happen to reach, which leaves
# any function no test exercises to be translated at run time. Generating the
# library in its own right makes the coverage a property of the build rather
# than of the test corpus.
#
# The extra roots past meta::pure::functions are what the suites THEMSELVES run
# on — the PCT harness (meta::pure::test::runPCTTests) and the section parsers.
# They are entered once each, but a javac is expensive enough that even one
# costs more than generating it: with only 7 functions left to translate at run
# time, javac still held 35% of the PCT profile's samples.
generate-functions:
    @{{header}} 'generate-functions'
    @{{substep}} 'translate meta::pure::functions -> generated/org/finos/legend/pure/m3'
    set -o pipefail; {{emit_rt}} execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::translatePackagesToJava_String_1__String_1_" \
        --args "meta::pure::functions,meta::pure::test,meta::pure::parser::mappings,meta::pure::compiler::test" \
        2> >(grep -v '^WARNING' >&2) | grep -v '^\[graal-tripwire\]' \
        | awk -v root="{{generated}}" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } file != "" { print > file }'
    @echo "  $(find {{generated}}/org/finos/legend/pure/m3/meta/pure/functions -name '*_*__*.java' -not -path '*tests*' 2>/dev/null | wc -l | tr -d ' ') function classes"

# Pre-generate the PCT TEST wrappers (meta::pure::functions::**::tests).
#
# translatableElements skips `tests` on purpose — a platform does not ship its
# test wrappers. But this platform RUNS the PCT corpus, and Execute silently
# falls back to translating-and-javac'ing anything it has no class for: a JFR
# profile of `java::pct` put 52% of samples inside javac, with ZERO test
# wrappers on disk. Same fix as the PDB writer, which went from hours to
# seconds once it was prebuilt.
generate-tests:
    @{{header}} 'generate-tests'
    @{{substep}} 'translate the PCT test packages -> generated/org/finos/legend/pure/m3'
    test -f {{translation_java_out}}/java-translation-tests.pdb || (echo "ERROR: missing {{translation_java_out}}/java-translation-tests.pdb (run `just modules::translation_java::build-tests` first)" && exit 1)
    set -o pipefail; {{emit_rt}} execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::translateTestPackagesToJava_String_1__String_1_" \
        --args "meta::pure::functions,meta::pure::compiler::pdb" \
        2> >(grep -v '^WARNING' >&2) | grep -v '^\[graal-tripwire\]' \
        | awk -v root="{{generated}}" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } file != "" { print > file }'
    @{{substep}} 'types the wrappers reference (FuncColSpec/AggColSpec: stored with the functions, so the package walk misses them)'
    set -o pipefail; {{emit_rt}} execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::platform::generatePlatformTypesWithTests_String_1__String_1__String_1_" \
        --args "meta::pure::functions,meta::pure::compiler::pdb" "org.finos.legend.pure.m3" \
        2> >(grep -v '^WARNING' >&2) | grep -v '^\[graal-tripwire\]' \
        | awk -v root="{{generated}}" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } file != "" { print > file }'
    @echo "  $(find {{generated}} -path '*tests*' -name '*.java' | wc -l | tr -d ' ') test classes"

# Remove everything this platform builds: the translator's output AND Maven's
# target/. `clean-generated` alone leaves target/classes behind, so a compiled
# class could outlive both its Pure source and the generated Java it came from.
#
# Remove everything this platform builds (generated/ + target/).
clean: clean-generated
    @{{header}} 'clean'
    @{{substep}} 'remove generated/ and mvn target/'
    cd {{module}} && mvn -q clean

# Remove everything generated, so no stale class outlives its Pure source.
clean-generated:
    rm -rf {{generated}}

# Compile the module: the handwritten host and the translator's output together,
# with the JDK alone. The pom declares NO dependencies, so a generated class that
# reached for a Truffle or Pure type cannot compile here unnoticed.
#
# One unit, not two: the host imports the generated metamodel and ~1250 generated
# classes call back into the host, so neither side compiles without the other.
# The transform has to RUN somewhere: fail with a pointer to the missing runtime
# rather than with a wall of "package does not exist" from the Maven step.
_depCheck_emit_rt:
    test -f {{emit_rt_jar}} || (echo "ERROR: missing {{emit_rt_jar}} — this platform generates its Java with {{pure_rt}}. Run \`{{emit_rt_recipe}}\` first, or generate with the other runtime: \`just pure_rt=bootstrap java::compile\`" && exit 1)

compile: _depCheck_emit_rt clean-generated generate-types generate-runtime generate-pdb generate-translator generate-functions generate-tests
    @{{header}} 'compile'
    @{{substep}} 'mvn compile: src/main/java + target/generated-sources/pure, JDK only'
    cd {{module}} && mvn -q clean compile
    test -f {{classes}}/org/finos/legend/pure/platform/java/compiler/module/pdbModule/PdbRuntime.class
    @echo "  $(find {{classes}} -name '*.class' | wc -l | tr -d ' ') classes"

# Inner loop for hand iteration: recompile WITHOUT cleaning and WITHOUT
# regenerating. `compile` takes ~3 minutes because it wipes generated/, re-runs
# all five generate steps and then `mvn clean compile` over ~4000 classes; this
# skips straight to an incremental javac.
#
# NOT a substitute for `compile`, and CI must never use it: `compile` cleans on
# purpose, because a generated class that outlives its Pure source still
# compiles and still runs. Re-run whichever `generate-*` recipe covers what you
# changed, then this. When in doubt which one that is, use `compile`.
#
# Incremental javac only — for hand iteration, never for CI (see above).
compile-fast:
    @{{header}} 'compile-fast'
    @{{substep}} 'incremental mvn compile — no clean, no regeneration (hand iteration only)'
    cd {{module}} && mvn -q compile
    test -f {{classes}}/org/finos/legend/pure/platform/java/compiler/module/pdbModule/PdbRuntime.class
    @echo "  $(find {{classes}} -name '*.class' | wc -l | tr -d ' ') classes"

# The transform's own Java, generated twice: once by the Pure runtime that builds
# this platform, once by the COMPILED transform running on the JVM. They must
# match — the check that the platform can build itself.
transform_roots := "meta::external::language::java::translation"

fixpoint: compile
    @{{header}} 'fixpoint'
    @{{substep}} 'generate {{transform_roots}} with {{pure_rt}} and with the compiled transform'
    rm -rf {{java_root}}/build/fixpoint {{java_root}}/build/fixpoint-ref
    mkdir -p {{java_root}}/build/fixpoint {{java_root}}/build/fixpoint-ref
    set -o pipefail; {{emit_rt}} execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::translatePackagesToJava_String_1__String_1_" \
        --args "{{transform_roots}}" \
        2> >(grep -v '^WARNING' >&2) | grep -v '^\[graal-tripwire\]' \
        | awk -v root="{{java_root}}/build/fixpoint-ref" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } file != "" { print > file }'
    set -o pipefail; java -Xmx{{jvm_heap}} -Xss64m -cp {{run_classpath}} org.finos.legend.pure.platform.java.execution.Execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::external::language::java::translation::translatePackagesToJava_String_1__String_1_" \
        --args "{{transform_roots}}" \
        | awk -v root="{{java_root}}/build/fixpoint" '/^\/\/\/\/ FILE /{ file = root "/" $3; dir = file; sub(/\/[^\/]*$/, "", dir); system("mkdir -p \"" dir "\""); next } file != "" { print > file }'
    diff -r {{java_root}}/build/fixpoint-ref {{java_root}}/build/fixpoint > {{java_root}}/build/fixpoint.diff 2>&1 && echo "  fixpoint: $(find {{java_root}}/build/fixpoint -name '*.java' | wc -l | tr -d ' ') files, the transform reproduces its own sources" || (echo "  FIXPOINT DIFFERS (build/fixpoint.diff):" && head -20 {{java_root}}/build/fixpoint.diff && exit 1)

# The PCT corpus ON this platform: the translated runner discovers the tests,
# the platform translates and compiles each one in memory, and runs it with the
# in-memory adapter (`$f->eval()` — the lambda is already Java here).
pct PACKAGE="meta::pure::functions": compile
    @{{header}} 'pct'
    @{{substep}} 'run {{PACKAGE}} PCT tests on the platform'
    mkdir -p {{repo_root}}/test-results/spec/pct
    java -Xmx{{jvm_heap}} -Xss64m -cp {{run_classpath}} org.finos.legend.pure.platform.java.execution.Execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::pure::test::runPCTTests_String_1__String_1__String_1_" \
        --args "{{PACKAGE}}" "{{repo_root}}/test-results/spec/pct/java@platform.json" \
        || echo "  PCT failures do not fail the build: they are in the report"

# The grammar corpus ON this platform: parse each fixture under
# pure/specification/grammar/tests and compare with its expected protocol.
spec-grammar: compile
    @{{header}} 'spec-grammar'
    @{{substep}} 'runGrammarCorpus over pure/specification/grammar/tests (Java platform)'
    mkdir -p {{repo_root}}/test-results/spec/grammar
    java -Xmx{{jvm_heap}} -Xss64m -cp {{run_classpath}} org.finos.legend.pure.platform.java.execution.Execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::pure::test::grammar::runGrammarCorpus_String_1__String_1__String_1_" \
        --args "{{repo_root}}/pure/specification/grammar/tests" "{{repo_root}}/test-results/spec/grammar/java@platform.json" \
        || echo "  failures do not fail the build: they are in the report"

# The compiler corpus ON this platform: compile each fixture under
# pure/specification/compiler/tests and compare the graph with its
# ###CompiledGraph section. compiler-tests.pdb carries those section parsers.
spec-compiler: compile
    @{{header}} 'spec-compiler'
    @{{substep}} 'runCompiledGraphTests over pure/specification/compiler/tests (Java platform)'
    mkdir -p {{repo_root}}/test-results/spec/compiler
    java -Xmx{{jvm_heap}} -Xss64m -cp {{run_classpath}} org.finos.legend.pure.platform.java.execution.Execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::pure::compiler::test::runCompiledGraphTests_String_1__String_1__String_1_" \
        --args "{{repo_root}}/pure/specification/compiler/tests" "{{repo_root}}/test-results/spec/compiler/java@platform.json" \
        || echo "  failures do not fail the build: they are in the report"

# The function corpus ON this platform: every `<<test.Test>>` under
# meta::pure::functions, run straight from the PDBs (no parsing, so no ANTLR
# extension needed). The sibling of truffle's `spec-functions`.
spec-functions PACKAGE="meta::pure::functions": compile
    @{{header}} 'spec-functions'
    @{{substep}} 'runTests over {{PACKAGE}} (Java platform)'
    mkdir -p {{repo_root}}/test-results/spec/functions
    java -Xmx{{jvm_heap}} -Xss64m -cp {{run_classpath}} org.finos.legend.pure.platform.java.execution.Execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/parser-mappings.pdb \
        --pdb {{language_java_out}}/java.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_java_out}}/java-translation.pdb \
        --pdb {{translation_java_out}}/java-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "{{PACKAGE}}" "{{repo_root}}/test-results/spec/functions/java@platform.json" \
        || echo "  failures do not fail the build: they are in the report"

# The PDB format suite ON this platform: the `<<test.Test>>` functions under
# meta::pure::compiler::pdb (reader/writer unit level), run from the PDBs.
