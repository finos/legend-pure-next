<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-next-platform-java-extensions</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>legend-pure-next-platform-java-extensions-tds</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - Java Platform - TDS Extension</name>
    <!--
      The `#TDS{…}#` island of the Pure language on this platform: no grammar (M3 parses a TDS header), its
      manifest and schema fragment staged where the engine's reader finds them, and its Pure translated into
      generated/ by `just java::generate-tds`.
    -->
    <properties>
        <repo.dir>${project.basedir}/../../../../..</repo.dir>
        <extension.dir>${repo.dir}/pure/extensions/pure/tds</extension.dir>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-platform-java-pure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <!-- Its manifest, under the same `languages/` prefix the engine uses for its own, and the
                         schema fragment (the manifest's `fbs`) beside it: the PDB runtime decodes a TDS with it. -->
                    <execution>
                        <id>stage-language</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/languages</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${extension.dir}</directory>
                                    <includes>
                                        <include>language_tds.json</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${extension.dir}/generated</directory>
                                    <includes>
                                        <include>tds.fbs</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The extension's Pure, translated — written here by `just java::generate-tds`. generated/ sits
                 BESIDE target/, not inside it: `mvn clean` owns target/. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>1.9.1</version>
                <executions>
                    <execution>
                        <id>add-translated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/generated</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-nowarn</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- The tests reach shared/*.pdb and the extension's build/*.pdb at the repository root. -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <workingDirectory>${repo.dir}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
