# The tds language on the Java platform: its translated runtime (//platforms/java:tds_generated) and language class.

load("@rules_java//java:defs.bzl", "java_import", "java_library")
load("//tools/bazel:junit5.bzl", "junit5_test")

java_import(
    name = "positions",
    jars = ["//platforms/java:tds_generated-positions.jar"],
)

_LANGUAGE_RESOURCES = {
    "language_tds.json": "//pure/extensions/pure/tds:language_tds.json",
    "tds.fbs": "//pure/extensions/pure/tds:generated/tds.fbs",
}

genrule(
    name = "language_resources",
    srcs = _LANGUAGE_RESOURCES.values(),
    outs = ["languages/" + name for name in _LANGUAGE_RESOURCES.keys()],
    cmd = " ".join(["cp $(execpath %s) $(RULEDIR)/languages/%s;" % (label, name) for name, label in _LANGUAGE_RESOURCES.items()]),
)

java_library(
    name = "extension",
    srcs = glob(["src/main/java/**/*.java"]) + ["//platforms/java:tds_generated.srcjar"],
    resource_strip_prefix = package_name(),
    resources = [":language_resources"],
    visibility = ["//visibility:public"],
    runtime_deps = [":positions"],
    deps = [
        "//platforms/java/legend-pure-next-platform-java/legend-pure-next-platform-java-pure:engine",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)

junit5_test(
    name = "tests",
    tags = ["job:translations/java"],
    srcs = glob(["src/test/java/**/*.java"]),
    data = [
        "//platforms/java:runtime_data",
        "//pure/extensions/pure/tds:test_data",
    ],
    deps = [
        ":extension",
        "//platforms/java/legend-pure-next-platform-java/legend-pure-next-platform-java-pure:engine",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)
