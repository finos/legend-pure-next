# The Java platform CLI, pure-java: the composition root, which installs every language. 'pure-java_deploy.jar' is
# its one jar.

load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_library(
    name = "cli",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//platforms/java/legend-pure-next-platform-java/legend-pure-next-platform-java-pure:engine",
        "//platforms/java/legend-pure-next-platform-java/legend-pure-next-platform-java-extensions/legend-pure-next-platform-java-extensions-diagram:extension",
        "//platforms/java/legend-pure-next-platform-java/legend-pure-next-platform-java-extensions/legend-pure-next-platform-java-extensions-tds:extension",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)

java_binary(
    name = "pure-java",
    # As just runs it (jvm_heap): the PDB golden corpus passes in 512m.
    jvm_flags = [
        "-Xmx2g",
        "-Xss64m",
    ],
    main_class = "org.finos.legend.pure.platform.java.cli.PureJava",
    visibility = ["//visibility:public"],
    runtime_deps = [":cli"],
)
