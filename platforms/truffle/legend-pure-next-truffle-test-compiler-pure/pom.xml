<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>truffle</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>legend-pure-next-truffle-test-compiler-pure</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - Truffle - Test - Compiler Pure</name>
    <description>Runs specification/compiler tests using the Pure compiler via the Truffle evaluator.</description>

    <properties>
        <compiler.pure.dir>${project.basedir}/../../../compiler-pure</compiler.pure.dir>
    </properties>

    <dependencies>
        <!-- Truffle runtime (includes StandaloneEvaluator, TrufflePdbLoader) — listed first
             so its hand-written MapImpl takes precedence over the codegen-generated one -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-truffle-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Truffle codegen (TruffleMetadataAccess, generated PDB classes) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-truffle-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Bootstrap compiler (CompiledGraphLanguageExtension, ErrorLanguageExtension) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-compiler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- CLI (CompilerBinaryBuilder for building compiler.pdb) -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Truffle API -->
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-api</artifactId>
            <version>${truffle.version}</version>
        </dependency>

        <!-- Eclipse Collections -->
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
            <version>${eclipsecollections.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
            <version>${eclipsecollections.version}</version>
        </dependency>

        <!-- Truffle Polyglot -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${truffle.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Copy core.pdb to test-classes -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-core-pdb</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.finos.legend.pure</groupId>
                                    <artifactId>legend-pure-next-compiler</artifactId>
                                    <version>${project.version}</version>
                                    <includes>core.pdb</includes>
                                    <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build compiler.pdb from compiler-pure sources -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>build-compiler-pdb</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.finos.legend.pure.cli.CompilerBinaryBuilder</mainClass>
                            <arguments>
                                <argument>${project.build.testOutputDirectory}/core.pdb</argument>
                                <argument>${compiler.pure.dir}</argument>
                                <argument>${project.build.testOutputDirectory}/compiler.pdb</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Copy PDBs to build/ — runs after build-compiler-pdb (same plugin, declaration order) -->
                    <execution>
                        <id>copy-pdbs-to-build</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>mkdir -p ${project.basedir}/../../../build &amp;&amp; cp ${project.build.testOutputDirectory}/core.pdb ${project.build.testOutputDirectory}/compiler.pdb ${project.basedir}/../../../build/</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>-Duser.timezone=UTC --add-opens=java.base/sun.misc=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                    <trimStackTrace>false</trimStackTrace>
                    <includes>
                        <include>**/*CompilerPure.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
