# PDBs compiled by Truffle, against what the bootstrap compiles, element for element.

load("//tools/bazel:hosts.bzl", "module_selfhost")
load("//tools/bazel:pure.bzl", "compiler_selfhost")

# The compiler written in Pure, and what is generated from it, on Truffle: JIT and native image.
compiler_selfhost("truffle", tool = "truffle")

compiler_selfhost("truffle_native", tool = "truffle-native")

# The modules the Truffle CLI compiles, against what the bootstrap compiles from the same sources.
module_selfhost({
    "diagram": {"sources": ["code", "generated"], "generated": ["generated/protocol.pure", "generated/writer.pure"]},
    "tds": {"sources": ["code", "generated"], "generated": ["generated/writer.pure"]},
    "legacy": {"sources": ["code"]},
    "legacy_loader": {},
    "diagram-analysis": {},
    "javascript": {},
    "protocol": {},
    "javascript-translation": {"sources": ["code"]},
    "truffle-translation-gallery": {},
})
