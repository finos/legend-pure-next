<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-next-truffle-extension</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>legend-pure-next-truffle-extension-java</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - Truffle - Extension - Java</name>
    <description>
        Truffle native bridge for the Pure→Java translator: contributes a
        specialized node for `meta::external::language::java::compileAndExecute`
        that compiles a Java source string in-process via `javax.tools.JavaCompiler`,
        loads the class through a throw-away ClassLoader, and invokes a named
        static method on it. Registered via the TruffleNativesExtension SPI.
    </description>

    <dependencies>
        <!-- Truffle runtime: provides PureNode, NativeNodeRegistry, the
             TruffleNativesExtension SPI, plus PureSequence and the
             CollectionHelper / StringHelper utility classes. All available
             at runtime via the fat jar, so `provided` here. -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-truffle-runtime</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Truffle-pdb-generation: holds PureSequence + the PDB value/runtime
             types the truffle-runtime depends on. Pulled in transitively by
             truffle-runtime, but declared explicitly so the extension's
             compile classpath doesn't depend on transitive resolution through
             a `provided` edge. -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-truffle-pdb-generation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-api</artifactId>
            <version>${truffle.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
