<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.finos.legend.pure</groupId>
    <artifactId>legend-pure-next-truffle</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Legend Pure - Next - Truffle</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <!-- Pinned to match CI's GraalVM Community 25.0.2 (latest CE release). Oracle
             GraalVM 25.0.3 used by some local devs is forward-compatible with this
             jar; the reverse (25.0.3 truffle-runtime jar against 25.0.2 JVMCI) is
             NOT — the polyglot Engine falls back to DefaultTruffleRuntime
             (interpreted), which trips assertNoCompilationFailures in
             TrufflePureTestRunner. Bump only after CE catches up. -->
        <truffle.version>25.0.2</truffle.version>
        <junit-jupiter.version>5.14.2</junit-jupiter.version>
        <eclipsecollections.version>13.0.0</eclipsecollections.version>
        <slf4j.version>2.0.16</slf4j.version>
    </properties>

    <modules>
        <module>legend-pure-next-truffle-codegen</module>
        <module>legend-pure-next-truffle-runtime</module>
    </modules>

    <!--
      Inherited by every child module: slf4j-nop on the runtime + test
      classpath silences the "No SLF4J providers were found" warning that
      transitive deps (e.g. SLF4J-using libs) trigger when no binding is
      present. Mirrors the bootstrap parent pom — same rationale.
    -->
    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      Inherited by every child module. Broader than surefire's
                      defaults (Test*, *Test, *Tests, *TestCase) so a class
                      named *TestRunner, FooTestSuite, etc. still gets picked
                      up. The SurefireDiscoveryTest tripwire (in the bootstrap
                      reactor) enforces that any class with @Test annotations
                      matches this pattern.
                    -->
                    <includes>
                        <include>**/*Test*.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
