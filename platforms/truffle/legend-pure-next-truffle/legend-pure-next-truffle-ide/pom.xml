<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-next-truffle</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>legend-pure-next-truffle-ide</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - Truffle - IDE</name>
    <description>Pure IDE launcher with the Truffle execute backend. Wraps the bootstrap IDE (HTTP + LSP) and supplies a PureTruffleRuntime-backed PureBackend.</description>

    <dependencies>
        <!-- Bootstrap IDE — supplies PureIDEMain.run(...), PureBackend, the
             LSP server and the Java-direct compile/diagnostics path. -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-bootstrap-ide</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Truffle runtime + codegen — supplies PureTruffleRuntime,
             TrufflePdbLoader, the codegen-emitted PDOs (TruffleMetadataAccess
             lives here despite its package name). -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-truffle-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-truffle-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Truffle Runtime (Graal JIT). truffle-runtime declares this with
             runtime scope which does not propagate transitively; redeclare
             so PureTruffleRuntime can recognize engine.* options at boot. -->
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-runtime</artifactId>
            <version>${truffle.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.finos.legend.pure.ide.truffle.PureIDETruffleMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
