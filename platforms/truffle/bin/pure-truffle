#!/usr/bin/env bash
# Shell wrapper for the Truffle-backed Pure compile fat JAR.
#
# Requires the project to be built with `just build-truffle` first.
# Phase F will replace this with a native-image binary of the same name.
#
# JVMCI flags: the polyglot engine falls back to a fallback runtime (and prints
# a warning) unless JVMCI is explicitly enabled. With GraalVM JDK on PATH that
# gives Graal real runtime compilation; on a non-Graal JDK the flags become
# inert (the launcher silently keeps interpreting), so the wrapper is safe to
# run anywhere.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRUFFLE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
JAR="${TRUFFLE_DIR}/build/pure-truffle.jar"

if [[ ! -f "${JAR}" ]]; then
    echo "Error: pure-truffle jar not found at ${JAR}" >&2
    echo "Run 'just build-truffle' first." >&2
    exit 1
fi

exec java \
    -XX:+UnlockExperimentalVMOptions \
    -XX:+EnableJVMCI \
    -XX:+UseJVMCICompiler \
    -jar "${JAR}" "$@"
