# platforms/truffle/Justfile — builds and tests the Truffle interpreter.
#
# Direct invocation:    just <recipe>          (from platforms/truffle/)
# Via the root Justfile: just truffle::<recipe> (from repo root)
#
# Truffle reads core.pdb / compiler.pdb out of <repo>/shared/ (produced by
# bootstrap). All recipes that need them depend on `_depCheck_pdbs` which fails
# loudly with a pointer to `just bootstrap::build-compiler-pdb` if they're missing.
#
# A single parameterized private recipe `_mvn mode` invokes Maven; `mode` is
# either "skip-tests" (passes `-DskipTests`) or "with-tests" (lets surefire
# run unit tests during the install lifecycle). Two recipes use it directly:
#   `build` → `(_mvn "skip-tests")` (mvn install -DskipTests) — fast, no Java tests
#   `test-java` → `(_mvn "with-tests")` (mvn install)         — surefire runs unit tests inline
# Maven runs once on the truffle parent pom; the reactor walks
# parent → runtime → ide
# in a single launch.

set quiet := true
set shell := ["bash", "-c"]

# GraalVM native-image build + native-binary test recipes — `just truffle::native::<recipe>`.
mod native "native.just"

# Upstream dep consumed by `build-all` (relative path from this Justfile).
# `build` itself only checks for the produced PDBs and fails loudly (via `_depCheck_pdbs`) —
# this mod is used solely to make `build-all` self-sufficient.
mod _mod_bootstrap "../../bootstrap/Justfile"

truffle_root      := source_directory()
repo_root         := truffle_root / ".." / ".."
# Records heavy build steps for the dashboard build time trend.
build_step     := "node " + repo_root / "tools" / "test-dashboard" / "build-step.mjs"
truffle           := truffle_root / "legend-pure-next-truffle"
truffle_cli_module := truffle / "legend-pure-next-truffle-interfaces" / "legend-pure-next-truffle-cli"
spec              := repo_root / "pure" / "specification"
compiler_src      := repo_root / "pure" / "specification" / "compiler" / "compiler-pure"
truffle_out       := truffle_root / "build"
shared_out        := repo_root / "shared"
test_results := repo_root / "test-results"
truffle_cli       := truffle_out / "pure-truffle.jar"
pure_truffle      := truffle_root / "bin" / "pure-truffle"
pure_bootstrap    := repo_root / "bootstrap" / "bin" / "pure-bootstrap"

verbose := ""
mvnq    := if verbose == "" { "-q" } else { "" }
err_filter := if verbose == "" { "2> >(grep -E -v '^(SLF4J(\\(W\\))?:|WARNING: |Note: )' >&2)" } else { "" }

header := "h(){ s=\"[truffle::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build + run all tests.
default: test

# Build the Truffle interpreter (mvn install -DskipTests, fat jar into truffle/build/).
build: (_mvn "skip-tests")

# Build bootstrap (produces shared/core.pdb + compiler.pdb) first, then this module.
build-all: _mod_bootstrap::build build

# Build + run the Java tests (surefire — including TrufflePurePCTAndFuncFromPDBTest: runTests + PCT with
# the Graal tripwire) + the compiler corpus specification run on Truffle.
test: test-java spec-compiler

# `test` plus every other specification run (self-hosted compiler, in-memory sources) + the native (AOT) suite.
test-all: test spec-compiler-selfhost spec native::test-all

# Each `spec-*` recipe runs one specification on the Truffle host and writes
# test-results/spec/<spec>/pure@cli-truffle[+<source>].json.
#
# `spec-*` recipes are zero-Maven-dep "expert mode" recipes — they assume
# `just build` (or `just test`) has produced the fat jar in `truffle/build/`. Run them
# standalone for fast Pure-side iteration. In CI, `test-all` runs `test` first
# (which depends on `_mvn "with-tests"`), so the jar is already in place by the time
# the standalone recipes execute — no redundant Maven invocation.

# Build with surefire-driven Java tests (unit tests, plus TrufflePurePCTAndFuncFromPDBTest over the PDBs).
test-java: (_mvn "with-tests")

# Print silencing for tests is per-test-body now: the Pure test runner
# wraps each <<test.Test>> invocation in withSilencedPrint, which flips a
# thread-local around the body. Runner-side prints (tickProgress, etc.)
# remain visible.

# Every specification run of the Truffle host (self-host excluded: see `spec-compiler-selfhost`).
spec: spec-compiler spec-functions spec-pct spec-grammar spec-pdb spec-pdb-golden spec-printer-compiled spec-printer-protocol spec-functions-inmemory spec-pct-inmemory

# Needs core-tests.pdb (runTests itself is <<test.TestDependency>> and is classified into the
# tests-only PDB) and compiler-tests.pdb (mirrors the compiler-graph recipe).
# Standalone Pure runTests over meta::pure::functions (assumes `just build` was run).
spec-functions:
    @{{header}} 'spec-functions'
    @{{substep}} 'runTests'
    {{pure_truffle}} execute --strict-jit \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/spec/functions/pure@cli-truffle.json" {{err_filter}}

# Standalone Pure compiler-graph spec tests over pure/specification/compiler/tests (assumes `just build` was run).
spec-compiler:
    @{{header}} 'spec-compiler'
    @{{substep}} 'runCompiledGraphTests over pure/specification/compiler/tests'
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "meta::pure::compiler::test::runCompiledGraphTests_String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{test_results}}/spec/compiler/pure@cli-truffle.json" {{err_filter}}

# Needs core-tests.pdb and compiler-tests.pdb for the same reason as spec-functions.
# Standalone Pure PCT tests over meta::pure::functions (assumes `just build` was run).
spec-pct:
    @{{header}} 'spec-pct'
    @{{substep}} 'runPCTTests'
    {{pure_truffle}} execute --strict-jit \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "meta::pure::test::runPCTTests_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/spec/pct/pure@cli-truffle.json" {{err_filter}} || echo "  PCT failures do not fail the build: they are in the report and on the dashboard"

# Compiles pure/specification/runtime/ from sources via Pure-on-Truffle, filters
# to test-tagged elements + Package PDOs, registers them as an inmem module on
# top of core.pdb/compiler.pdb, then drives the standard runners. Exercises the
# from-source path end-to-end without staging a -tests.pdb on disk — counterpart
# to spec-functions / spec-pct which load test
# elements from core-tests.pdb. The inMemory variants compile every recipe run,
# so they're slower (compile takes a few seconds on top of the runner time).
# Grammar corpus: parse each grammar.pure and compare the parse result with its protocol.json.
spec-grammar:
    @{{header}} 'spec-grammar'
    @{{substep}} 'runGrammarCorpus over pure/specification/grammar/tests'
    {{pure_truffle}} execute --strict-jit \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "meta::pure::test::grammar::runGrammarCorpus_String_1__String_1__String_1_" \
        --args "{{spec}}/grammar/tests" "{{test_results}}/spec/grammar/pure@cli-truffle.json" {{err_filter}}

# PDB writer/reader unit tests (meta::pure::compiler::pdb), the same Pure suite the native and bootstrap CLIs run.
spec-pdb:
    @{{header}} 'spec-pdb'
    @{{substep}} 'runTests over meta::pure::compiler::pdb'
    {{pure_truffle}} execute --strict-jit \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::compiler::pdb" "{{test_results}}/spec/pdb-format/pure@cli-truffle.json" {{err_filter}}

# PDB wire contract: compile each compiler fixture, write it with the Pure writer and compare the archive
# with the Java golden in pure/specification/compiler/tests-pdb-serialization (compiler-pure test/pdbGoldenRunner.pure).
spec-pdb-golden:
    @{{header}} 'spec-pdb-golden'
    @{{substep}} 'runPdbGoldenTests: the Pure compiler and writer against the Java golden archives'
    {{pure_truffle}} execute --strict-jit \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "meta::pure::compiler::test::pdb::runPdbGoldenTests_String_1__String_1__String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{spec}}/compiler/tests-pdb-serialization" "{{shared_out}}/specification/m3.fbs" "{{test_results}}/spec/pdb/pure@cli-truffle.json" {{err_filter}}

# Compiled-printer corpus: compile each compiler-corpus file, print the compiled elements, compare with the source.
spec-printer-compiled:
    @{{header}} 'spec-printer-compiled'
    @{{substep}} 'runCompiledPrinterCorpus over pure/specification/compiler/tests'
    {{pure_truffle}} execute --strict-jit \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "meta::pure::compiler::test::printer::runCompiledPrinterCorpus_String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{test_results}}/pure/printer-compiled/pure@cli-truffle.json" {{err_filter}}

# Protocol-printer corpus: parse each grammar-corpus file, print the protocol, compare with the source.
spec-printer-protocol:
    @{{header}} 'spec-printer-protocol'
    @{{substep}} 'runProtocolPrinterCorpus over pure/specification/grammar/tests'
    {{pure_truffle}} execute --strict-jit \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --pdb {{shared_out}}/compiler-tests.pdb \
        --function "meta::pure::functions::printer::protocol::tests::runProtocolPrinterCorpus_String_1__String_1__String_1_" \
        --args "{{spec}}/grammar/tests" "{{test_results}}/pure/printer-protocol/pure@cli-truffle.json" {{err_filter}}


# Standalone Pure runTests over meta::pure::functions, against freshly-compiled test sources (in-memory module on top of core.pdb).
spec-functions-inmemory:
    @{{header}} 'spec-functions-inmemory'
    @{{substep}} 'compile pure/specification/runtime + runTests (in-memory)'
    {{pure_truffle}} execute-from-memory \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --source-dir {{spec}}/runtime/functions \
        --source-dir {{spec}}/runtime/featureTests \
        --source-dir {{spec}}/runtime/ui \
        --source-dir {{spec}}/runtime/test \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/spec/functions/pure@cli-truffle+inMemory.json" {{err_filter}}

# Standalone Pure PCT tests over meta::pure::functions, against freshly-compiled test sources (in-memory module on top of core.pdb).
spec-pct-inmemory:
    @{{header}} 'spec-pct-inmemory'
    @{{substep}} 'compile pure/specification/runtime + runPCTTests (in-memory)'
    {{pure_truffle}} execute-from-memory \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/compiler.pdb \
        --source-dir {{spec}}/runtime/functions \
        --source-dir {{spec}}/runtime/featureTests \
        --source-dir {{spec}}/runtime/ui \
        --source-dir {{spec}}/runtime/test \
        --function "meta::pure::test::runPCTTests_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/spec/pct/pure@cli-truffle+inMemory.json" {{err_filter}} || echo "  PCT failures do not fail the build: they are in the report and on the dashboard"

# Truffle-compiled compiler.pdb goes to {{truffle_out}}/ to keep it separate from the
# Java-compiled shared/compiler.pdb (filename is derived from module manifest).
# Self-host: compile compiler-pure on Truffle, run compiler tests, then diff PDB vs Java direct (assumes `just build` was run).
spec-compiler-selfhost: _depCheck_pdbs
    @{{header}} 'spec-compiler-selfhost'
    @{{substep}} 'compiler-pure → {{truffle_out}}/compiler.pdb (truffle), then run compiler tests'
    {{pure_truffle}} compile \
        --base-pdb {{shared_out}}/core.pdb \
        --base-pdb {{shared_out}}/parser-mappings.pdb \
        --base-pdb {{shared_out}}/core-tests.pdb \
        --base-pdb {{shared_out}}/compiler.pdb \
        --source {{compiler_src}} \
        --output-dir {{truffle_out}} \
        --tests split {{err_filter}}
    {{pure_truffle}} execute \
        --pdb {{shared_out}}/core.pdb \
        --pdb {{shared_out}}/parser-mappings.pdb \
        --pdb {{shared_out}}/core-tests.pdb \
        --pdb {{truffle_out}}/compiler.pdb \
        --pdb {{truffle_out}}/compiler-tests.pdb \
        --function "meta::pure::compiler::test::runCompiledGraphTests_String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{test_results}}/spec/compiler/pure@cli-truffle+selfhost.json" {{err_filter}}
    @{{substep}} 'diff shared/compiler.pdb (Java compiler) ↔ {{truffle_out}}/compiler.pdb (Truffle compiler)'
    {{pure_bootstrap}} diff-pdb --deep --core {{shared_out}}/core.pdb \
        {{shared_out}}/compiler.pdb \
        {{truffle_out}}/compiler.pdb {{err_filter}}

# Run the PureEvaluatorBenchmark.
bench: (_mvn "skip-tests")
    @{{header}} 'bench'
    @{{substep}} 'PureEvaluatorBenchmark'
    cd {{truffle}} && mvn -Pbench test -Dtest=PureEvaluatorBenchmark

# Remove truffle/build/ and run mvn clean across the unified truffle reactor.
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove truffle/build (jar + native + self-host pdb) and mvn target/'
    rm -rf {{truffle_out}}
    cd {{truffle}} && mvn clean {{mvnq}}

# Internal: parameterized `mvn install` invocation.
# `mode` is "skip-tests" (fast, no Java tests) or "with-tests" (surefire runs unit tests).
# Walks the unified truffle reactor in one launch:
#   parent (legend-pure-next-truffle)
#     → core
#     → interfaces/cli, interfaces/ide
# Maven derives the build order from compile deps (cli and ide depend on core).
_mvn mode: (_step-start "truffle/maven-" + mode) _depCheck_pdbs _depCheck_graalvm
    @{{header}} '_mvn'
    @{{substep}} '{{ if mode == "skip-tests" { "mvn install -DskipTests (truffle reactor)" } else { "mvn install (truffle reactor + unit tests)" } }}'
    # `--fail-at-end` so all surefire suites run even when one module's tests
    # fail — surfaces every assertion failure across the reactor in a single
    # `just truffle::test` run instead of discovering them one module at a
    # time.
    cd {{truffle}} && mvn --fail-at-end clean install {{ if mode == "skip-tests" { "-DskipTests" } else { "" } }} {{mvnq}} {{err_filter}}
    mkdir -p {{truffle_out}}
    cp {{truffle_cli_module}}/target/pure-truffle-*-fat.jar {{truffle_cli}}
    {{build_step}} end "truffle/maven-{{mode}}"

# Internal: fail loudly if shared/core.pdb or shared/compiler.pdb is missing.
_depCheck_pdbs:
    #!/usr/bin/env bash
    if [[ ! -f "{{shared_out}}/core.pdb" || ! -f "{{shared_out}}/compiler.pdb" ]]; then
        echo "Error: <repo>/shared/core.pdb or compiler.pdb missing." >&2
        echo "Run 'just bootstrap::build-compiler-pdb' first (or 'just build' from the repo root)." >&2
        exit 1
    fi
    if [[ ! -f "{{repo_root}}/pure/specification/compiler/compiler-pure/pdb/writer/generated/generatedWriter.pure" ]]; then
        echo "Error: <repo>/pure/specification/compiler/compiler-pure/pdb/writer/generated/generatedWriter.pure missing." >&2
        echo "It is generated (gitignored) and compiler-pure does not compile correctly without it:" >&2
        echo "every meta::pure::compiler::pdb::gen::write* is simply absent, so the self-host" >&2
        echo "compile quietly produces 193 fewer elements instead of failing." >&2
        echo "Run 'just bootstrap::build-compiler-pdb' first (or 'just build' from the repo root)." >&2
        exit 1
    fi

# Internal: enforce GraalVM JDK at $JAVA_HOME (Truffle needs the optimizing runtime).
# Plain OpenJDK falls back to DefaultTruffleRuntime (Interpreted), which doesn't
# register engine.TraceCompilation and breaks the test harness's compile-failure
# tripwire. The native-image build also fails with a non-GraalVM JDK.
# Maven uses $JAVA_HOME (not `java` on PATH) so we MUST verify JAVA_HOME
# specifically — a GraalVM `java` on PATH with JAVA_HOME pointing elsewhere
# slips past a PATH-only check and breaks Maven later.
_depCheck_graalvm:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "${JAVA_HOME:-}" ]]; then
        echo "Error: JAVA_HOME is not set. Truffle requires JAVA_HOME to point at a GraalVM 25 JDK." >&2
        echo "" >&2
        echo "On macOS:" >&2
        echo "  brew install --cask graalvm-jdk@25       # if not already installed" >&2
        echo "  export JAVA_HOME=\$(/usr/libexec/java_home -v 25)" >&2
        echo "  export PATH=\"\$JAVA_HOME/bin:\$PATH\"" >&2
        exit 1
    fi
    JAVA="$JAVA_HOME/bin/java"
    if [[ ! -x "$JAVA" ]]; then
        echo "Error: \$JAVA_HOME ($JAVA_HOME) does not contain bin/java." >&2
        exit 1
    fi
    if ! "$JAVA" -version 2>&1 | grep -qiE 'graalvm'; then
        echo "Error: \$JAVA_HOME at '$JAVA_HOME' is not a GraalVM JDK." >&2
        "$JAVA" -version >&2 || true
        echo "" >&2
        echo "Truffle needs GraalVM's optimizing runtime (and native-image for *-native recipes)." >&2
        echo "On macOS:" >&2
        echo "  brew install --cask graalvm-jdk@25       # if not already installed" >&2
        echo "  export JAVA_HOME=\$(/usr/libexec/java_home -v 25)" >&2
        echo "  export PATH=\"\$JAVA_HOME/bin:\$PATH\"" >&2
        exit 1
    fi

# Build time trend (tools/test-dashboard/build-step.mjs): the first dependency of a heavy recipe, whose last line runs `{{build_step}} end`.
_step-start STEP:
    {{build_step}} start "{{STEP}}"
