# Every suite of every owner on Truffle (tools/bazel/hosts.bzl): '<owner>_<suite>_<variant>'.

load("//tools/bazel:hosts.bzl", "host_specs", "pdb_read_backs")

host_specs(host = "truffle")

# The extension goldens read back by Truffle's own decoder.

pdb_read_backs(
    fixtures = {
        "diagram/" + name: "m::D"
        for name in [
            "propertyAndAssociation",
            "complexGeometry",
            "complexTypeProperties",
        ]
    },
    function = "platform::extensions::pure::diagram::tests::readBack_String_1__String_1__String_1_",
    host = "truffle",
    owner = "diagram",
)

pdb_read_backs(
    fixtures = {
        "tds/" + name: "test::tds::%s__Any_MANY_" % name
        for name in [
            "typedHeader",
            "inferredColumns",
            "mixedInference",
            "quotedNamesAndCells",
            "enumeration",
            "quotedValues",
            "manyMultiplicity",
            "primitiveExtension",
        ]
    },
    function = "platform::extensions::pure::tds::tests::readBack_String_1__String_1__String_1_",
    host = "truffle",
    owner = "tds",
)

# The Truffle translation gallery, which publish-gallery deploys: the HTML that
# renderGallery prints, from its doctype on.
_CORE = "//pure/specification"

_GALLERY_PDBS = [
    _CORE + ":core.pdb",
    "//pure/specification:parser-mappings.pdb",
    _CORE + ":core-tests.pdb",
    "//pure/specification:compiler.pdb",
    "//pure/specification:core_metamodel_pdb_writer.pdb",
    "//pure/modules/translation/shared:build/translation-shared.pdb",
    "//pure/modules/translation/truffle:build/truffle-translation-gallery.pdb",
    "//pure/modules/translation/truffle:build/truffle-translation-gallery-tests.pdb",
]

_TRUFFLE_CLI = "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-interfaces/legend-pure-next-platform-truffle-cli:pure-truffle"

genrule(
    name = "gallery",
    srcs = _GALLERY_PDBS,
    outs = ["truffle-translation-gallery.html"],
    cmd = """
        set -eo pipefail
        $(execpath %s) execute %s \\
            --function "platform::extensions::language::truffle::gallery::renderGallery_String_1__String_1_" \\
            --args "platform::pure::functions" 2> /dev/null | grep -v '^\\[graal-tripwire\\]' | awk '/<!DOCTYPE/{p=1} p' > $@
        test -s $@
    """ % (_TRUFFLE_CLI, " ".join(["--pdb $(execpath %s)" % pdb for pdb in _GALLERY_PDBS])),
    tags = ["job:translations"],
    tools = [_TRUFFLE_CLI],
    visibility = ["//visibility:public"],
)
