<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-next-platform-truffle-extensions</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>legend-pure-next-platform-truffle-extensions-tds</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - Truffle Platform - TDS Extension</name>
    <!--
      The `#TDS{…}#` island of the Pure language on this platform: no grammar (M3 parses its header), only
      its manifest and the PDB schema fragment generated from its metamodel, staged where the engine's
      reader finds them.
    -->
    <properties>
        <repo.dir>${project.basedir}/../../../../..</repo.dir>
        <extension.dir>${repo.dir}/pure/extensions/pure/tds</extension.dir>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-platform-truffle-pure</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <!-- Its manifest, read at startup by the engine, under the same `languages/` prefix the
                         engine uses for its own, and the schema fragment (the manifest's `fbs`) beside it:
                         the PDB reader decodes a TDS value with it. -->
                    <execution>
                        <id>stage-language</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/languages</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${extension.dir}</directory>
                                    <includes>
                                        <include>language_tds.json</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${extension.dir}/generated</directory>
                                    <includes>
                                        <include>tds.fbs</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
