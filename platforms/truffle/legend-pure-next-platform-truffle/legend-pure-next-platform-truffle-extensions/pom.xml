    <artifactId>legend-pure-next-platform-truffle-extensions</artifactId>
    <packaging>pom</packaging>
    <name>Legend Pure - Next - Truffle Platform - Language Extensions</name>

    <!--
      One module per language extension, mirroring pure/extensions/<name> on the Pure side and the Java
      platform's own -extensions. Grouping only: nothing is built here.

      Each extension depends on -truffle-pure and never the other way, which is what keeps an extension's
      generated parser out of the engine's tree.
    -->

    <modules>
        <module>legend-pure-next-platform-truffle-extensions-diagram</module>
    </modules>
</project>
