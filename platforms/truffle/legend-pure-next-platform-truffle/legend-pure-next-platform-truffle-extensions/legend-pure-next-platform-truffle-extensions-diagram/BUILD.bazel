# The diagram language on Truffle: its parser, generated from the diagram grammar, and its language class.

load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:antlr.bzl", "antlr_srcjar")

antlr_srcjar(
    name = "antlr_sources",
    srcs = ["//pure/extensions/diagram:grammar_antlr"],
    grammar_dir = "pure/extensions/diagram/code/grammar/antlr",
    grammars = [("", ["DiagramLexer.g4", "DiagramParser.g4"])],
    package = "org.finos.legend.pure.truffle.extensions.diagram",
)

# The language manifest and schemas the extension adds to a host, under languages/.
_LANGUAGE_RESOURCES = {
    "language_diagram.json": "//pure/extensions/diagram:language_diagram.json",
    "diagram.fbs": "//pure/extensions/diagram:generated/diagram.fbs",
}

genrule(
    name = "language_resources",
    srcs = _LANGUAGE_RESOURCES.values(),
    outs = ["languages/" + name for name in _LANGUAGE_RESOURCES.keys()],
    cmd = " ".join(["cp $(execpath %s) $(RULEDIR)/languages/%s;" % (label, name) for name, label in _LANGUAGE_RESOURCES.items()]),
)

java_library(
    name = "extension",
    srcs = glob(["src/main/java/**/*.java"]) + [":antlr_sources"],
    resource_strip_prefix = package_name(),
    resources = [":language_resources"],
    visibility = ["//visibility:public"],
    deps = [
        "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-pure:truffle-pure",
        "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-pure:truffle_dsl",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)
