<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-next-platform-truffle-interfaces</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>legend-pure-next-platform-truffle-cli</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Next - Truffle - CLI</name>
    <description>Command-line interface for compiling and executing Pure on the Truffle runtime (pure-truffle fat jar and native image).</description>

    <dependencies>

        <!-- Every language extension this CLI can run. It is the composition root: the one place that
             names them, which is why it is also the one place that depends on them. -->
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-platform-truffle-extensions-diagram</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.finos.legend.pure</groupId>
            <artifactId>legend-pure-next-platform-truffle-pure</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.finos.legend.pure.truffle.interfaces.cli.PureCompileMain</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Merge LICENSE / NOTICE entries instead of duplicating them. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                            </transformers>
                            <finalName>pure-truffle-${project.version}-fat</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signature files: invalid once jars are merged. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Per-input MANIFEST.MF: ManifestResourceTransformer
                                             builds the output manifest from <mainClass> +
                                             <manifestEntries>. -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- module-info.class (root + multi-release) — fat jar is
                                             classpath-loaded; JPMS encapsulation does not apply. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- Per-jar license/notice noise; merged copies are
                                             produced by the transformers above. -->
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/NOTICE.txt</exclude>
                                        <!-- Eclipse Collections ships these duplicated across api/impl. -->
                                        <exclude>about.html</exclude>
                                        <exclude>LICENSE-EDL-1.0.txt</exclude>
                                        <exclude>LICENSE-EPL-1.0.txt</exclude>
                                    </excludes>
                                </filter>
                                <!-- pure/annotations/* are emitted identically by RdfJavaGenerator
                                     in both parser and compiler. Keep the parser copy (parser is
                                     the upstream module) and drop the compiler's duplicate.

                                     core.pdb is also packed at JAR root by the bootstrap-compiler
                                     module (its build-core-pdb execution writes to target/classes/).
                                     We embed the same file under /embedded/ via the native-lib
                                     profile's <resource> mapping; without this exclude we get
                                     4.5MB duplicated in the image. -->
                                <filter>
                                    <artifact>org.finos.legend.pure:legend-pure-next-bootstrap-compiler</artifact>
                                    <excludes>
                                        <exclude>pure/annotations/**</exclude>
                                        <exclude>core.pdb</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>org.finos.legend.pure.truffle.interfaces.cli.PureCompileMain</mainClass>
                            <imageName>pure-truffle-native</imageName>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--features=org.finos.legend.pure.truffle.runtime.nativeimage.PureFeature</buildArg>
                                <buildArg>--initialize-at-build-time=org.finos.legend.pure.truffle.execution.PureLanguageProvider</buildArg>
                                <!-- PureProfilerProvider is referenced by static fields reachable from the
                                     image heap (Truffle profiler service-provider lookup). Initialize at
                                     build time so its singleton lands in the heap as a fully constructed
                                     object rather than triggering the build-time/run-time mismatch error. -->
                                <buildArg>--initialize-at-build-time=org.finos.legend.pure.truffle.execution.profiler.PureProfilerProvider</buildArg>
                                <!-- m3.fbs: GenericFbDecoder loads the wire schema as a
                                     classpath resource at runtime; native-image strips
                                     unregistered resources, and without this the binary
                                     fails on first deserialize ("Schema resource not on
                                     classpath"). -->
                                <buildArg>-H:IncludeResources=generated-specification/m3\.fbs</buildArg>
                                <!-- The LANGUAGE MANIFESTS, for the same reason: PureLanguage and each
                                     extension's own accessor read `languages/language_*.json` as classpath
                                     resources at startup, so a binary without them fails immediately with
                                     "no language manifest on the class path". One pattern covers the Pure
                                     language, compiler-pure's test sections and every extension, because
                                     all of them stage into the same `languages/` prefix. -->
                                <buildArg>-H:IncludeResources=languages/.*\.json</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
