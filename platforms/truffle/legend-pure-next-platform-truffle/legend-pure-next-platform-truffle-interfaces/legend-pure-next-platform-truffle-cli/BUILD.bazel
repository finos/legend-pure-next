# The Truffle CLI, pure-truffle, with every extension. 'pure-truffle_deploy.jar' is the fat jar Maven shades
# (pure-truffle-<version>-fat.jar).

load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("//tools/bazel:classpath.bzl", "runtime_jars")

java_library(
    name = "cli",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-extensions/legend-pure-next-platform-truffle-extensions-diagram:extension",
        "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-extensions/legend-pure-next-platform-truffle-extensions-relation:extension",
        "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-extensions/legend-pure-next-platform-truffle-extensions-tds:extension",
        "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-pure:truffle-pure",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
        "@maven//:org_graalvm_polyglot_polyglot",
    ],
)

java_binary(
    name = "pure-truffle",
    # The Graal JIT, as bin/pure-truffle runs it.
    jvm_flags = [
        "-XX:+UnlockExperimentalVMOptions",
        "-XX:+EnableJVMCI",
        "-XX:+UseJVMCICompiler",
    ],
    main_class = "org.finos.legend.pure.truffle.interfaces.cli.PureCompileMain",
    visibility = ["//visibility:public"],
    runtime_deps = [
        ":cli",
        "@maven//:org_slf4j_slf4j_nop",
    ],
)

# The runtime class path of pure-truffle (its runtime_deps).
runtime_jars(
    name = "native_classpath",
    deps = [
        ":cli",
        "@maven//:org_slf4j_slf4j_nop",
    ],
)

# The native image, pure-truffle-native (just: truffle::native::build; Maven: the native profile of this pom), built
# by the native-image of the GraalVM runtime from the runtime jars, with the profile's arguments.
genrule(
    name = "pure-truffle-native",
    srcs = [":native_classpath"],
    outs = ["pure-truffle-native"],
    cmd = """
        set -e
        T=$$(mktemp -d)
        CP=$$(echo $(execpaths :native_classpath) | tr ' ' ':')
        $(JAVABASE)/bin/native-image -cp $$CP \\
            --no-fallback \\
            --features=org.finos.legend.pure.truffle.runtime.nativeimage.PureFeature \\
            --initialize-at-build-time=org.finos.legend.pure.truffle.execution.PureLanguageProvider \\
            --initialize-at-build-time=org.finos.legend.pure.truffle.execution.profiler.PureProfilerProvider \\
            '-H:IncludeResources=languages/.*\\.json' \\
            '-H:IncludeResources=languages/.*\\.fbs' \\
            -o $$T/pure-truffle-native \\
            org.finos.legend.pure.truffle.interfaces.cli.PureCompileMain > $$T/log 2>&1 || { tail -40 $$T/log >&2; exit 1; }
        cp $$T/pure-truffle-native $@
    """,
    executable = True,
    toolchains = ["@bazel_tools//tools/jdk:current_java_runtime"],
    tools = ["@bazel_tools//tools/jdk:current_java_runtime"],
    visibility = ["//visibility:public"],
)
