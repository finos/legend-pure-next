# The Pure IDE on Truffle.

load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_library(
    name = "ide",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "//platforms/truffle/legend-pure-next-platform-truffle/legend-pure-next-platform-truffle-pure:truffle-pure",
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-interfaces/legend-pure-next-bootstrap-ide:ide",
        "//bootstrap/legend-pure-next-bootstrap/legend-pure-next-bootstrap-core/legend-pure-next-bootstrap-runtime:runtime",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
        "@maven//:org_graalvm_polyglot_polyglot",
    ],
)

java_binary(
    name = "pure-ide-truffle",
    main_class = "org.finos.legend.pure.truffle.interfaces.ide.PureIDETruffleMain",
    runtime_deps = [
        ":ide",
        "@maven//:org_slf4j_slf4j_nop",
    ],
)
