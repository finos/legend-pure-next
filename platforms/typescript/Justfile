# platforms/typescript/Justfile — builds and tests the TypeScript runtime.
#
# Direct invocation:    just <recipe>             (from platforms/typescript/)
# Via the root Justfile: just typescript::<recipe> (from repo root)
#
# Backed by pnpm; package.json defines `build` (tsc) and `test`.

set quiet := true
set shell := ["bash", "-c"]

ts_root := source_directory()

header := "h(){ s=\"[typescript::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build + run tests.
default: test

# pnpm install + pnpm run build (tsc).
build:
    @{{header}} 'build'
    @{{substep}} 'pnpm install + build'
    cd {{ts_root}} && pnpm install && pnpm run build

# No external deps — alias of `build` for symmetry with sub-Justfiles' `build-all`.
build-all: build

# Build + run pnpm tests (placeholder until the TypeScript runtime grows real tests).
test: build
    @{{header}} 'test'
    @{{substep}} 'pnpm run test'
    cd {{ts_root}} && pnpm run test

# No self-host or runtime-PCT suites on the TypeScript side yet.
# Alias of `test` for parity with bootstrap/truffle `test-all`.
test-all: test

# Remove dist/ and node_modules/.
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove dist/ and node_modules/'
    rm -rf {{ts_root}}/dist {{ts_root}}/node_modules
