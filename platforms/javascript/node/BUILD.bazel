# The JavaScript platform: the runtime translated from Pure, its parsers and bundles, and its suites.

# The npm packages of the JavaScript platform, from pnpm-lock.yaml: one target per package, in this package so that
# they stay apart from the platform's own targets.

load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

exports_files(
    [
        "package.json",
        "pnpm-lock.yaml",
    ],
    visibility = ["//visibility:public"],
)
