# The browser IDE, driven in a real browser over the DevTools Protocol: load index.html, wait for it
# to report Ready, compile a source with a ###Diagram section, find the element in the concept tree.
#
# `web-deps` and `generate-all` are dependencies because the page loads what they produce — Monaco
# from build/vs, the two bundles, and generated/. Chrome comes from the environment (CHROME_PATH or
# the usual locations) and is preinstalled on GitHub's ubuntu runners.
#
# This is the only suite that exercises how the PAGE assembles itself: classic <script>s for
# runtime-lib and the bundles, ES modules for the rest. Everything else here runs in Node, where that
# split does not exist — which is how the page once silently stopped compiling diagrams.
test-ide: web-deps generate-all
    @{{header}} 'test-ide'
    @{{substep}} 'browser IDE over CDP (pnpm run test:ide)'
    cd {{js_root}} && pnpm run test:ide --report {{test_results}}/javascript/web/ide-tests.json

# Every platform suite: grammar parsing, compiler conformance, the PCT corpus, and
# the translated PDB stack.
# The translation module's own suites and gallery run from
# pure/modules/translation/javascript through bin/pure-js, the same way
# translation/java runs its through bin/pure-truffle.
# The TRANSLATION MODULE's own Pure tests, run on this host. Here rather than only under
# `modules::translation_javascript` because they exercise the translator's OUTPUT on this platform, and
# a platform suite that skips them is a platform suite with a hole: the read switch to `_prop()`
# accessors passed everything in this file while leaving two of those five red, because a captured
# instance was still being emitted as an object literal.
test-translation: generate-all
    @{{header}} 'test-translation'
    @{{substep}} 'runTests meta::external::language::javascript::translation (the module that generated this host)'
    just --justfile {{repo_root}}/Justfile modules::translation_javascript::test-translation

test-all: test test-compiler test-execution spec-grammar spec-compiler spec-pct test-pdb spec-pdb-golden test-printer-compiled test-printer-protocol test-host-api usage-example test-extensions test-diagram test-section-hint test-source-store test-ide test-translation

# The `###Diagram` language extension's OWN Pure tests (pure/extensions/diagram/code/tests):
# its grammar mapping rules and its compiler passes.
#
# They run HERE rather than next to the extension because they call parseAntlr with the
# DiagramParser grammar, and this is the platform that generates and registers it — the Pure is
# cross-platform, the parser behind it is not yet. On a host whose adapter has not been
# generated they fail with "Unknown grammar: DiagramParser", which is the honest signal that
# that platform has not adapted the extension; see pure/extensions/diagram/Justfile.
test-extensions: generate-all
    @{{header}} 'test-extensions'
    @{{substep}} 'runTests meta::pure::diagram (JavaScript host)'
    test -f {{extension_diagram_out}}/diagram.pdb || (echo "ERROR: missing {{extension_diagram_out}}/diagram.pdb (run \`just extensions::build\` first)" && exit 1)
    test -f {{extension_diagram_out}}/diagram-tests.pdb || (echo "ERROR: missing {{extension_diagram_out}}/diagram-tests.pdb (run \`just extensions::build-tests\` first — the lean pdb drops <<test.Test>> elements whether or not the build splits)" && exit 1)
    mkdir -p {{test_results}}/pure/extensions-diagram
    {{js_root}}/bin/pure-js execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{extension_diagram_out}}/diagram.pdb \
        --pdb {{extension_diagram_out}}/diagram-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::diagram" "{{test_results}}/pure/extensions-diagram/pure@cli-javascript.json"

# Generate the lexers/parsers this host parses with: the Pure language's own (Top + M3) and one
# directory per extension. ANTLR's JavaScript target via the complete jar bundled with antlr4ng-cli
# (its `antlr4ng` wrapper only emits TypeScript); each grammar is generated from its own directory so
# `-lib` finds the lexer's token vocabulary beside it.
antlr-generate-parsers: web-deps
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'antlr-generate-parsers'
    {{substep}} "antlr4 on the Pure language's grammars -> generated/pure/grammar/antlr/"
    rm -rf "{{antlr_gen}}"
    mkdir -p "{{antlr_gen}}"
    jar="$(ls {{js_root}}/node_modules/antlr4ng-cli/antlr4-*-complete.jar | head -1)"
    ( cd "{{grammar_src}}" && java -jar "$jar" -Dlanguage=JavaScript -no-listener -no-visitor -o "{{antlr_gen}}" -lib "{{antlr_gen}}" TopLexer.g4 TopParser.g4 )
    ( cd "{{grammar_src}}/m3" && java -jar "$jar" -Dlanguage=JavaScript -no-listener -no-visitor -o "{{antlr_gen}}" -lib "{{antlr_gen}}" M3Lexer.g4 M3Parser.g4 )
    {{substep}} 'antlr4 on each extension grammar -> generated/extensions/<name>/grammar/antlr/'
    for ext in {{repo_root}}/pure/extensions/*/; do
        [ -d "$ext/code/grammar/antlr" ] || continue
        name=$(basename "$ext"); dest="{{ext_gen}}/$name/grammar/antlr"
        # Safe to wipe wholesale: this directory holds ANTLR output and nothing else, so a grammar
        # that was renamed or removed cannot leave a stale parser behind to resolve and fail quietly.
        # The extension's own generated files (language_<name>.js, grammar/parser.js, compiler.js) are above it.
        rm -rf "$dest"
        mkdir -p "$dest"
        ( cd "$ext/code/grammar/antlr" && java -jar "$jar" -Dlanguage=JavaScript -no-listener -no-visitor -o "$dest" -lib "$dest" *.g4 )
    done
    echo "  generated $(ls {{antlr_gen}}/*.js | wc -l | tr -d ' ') for the language + $(ls {{ext_gen}}/*/grammar/antlr/*.js 2>/dev/null | wc -l | tr -d ' ') for extensions"

# Bundle antlr4 + the generated parsers + the ANTLR natives -> build/antlr-bundle.js (a no-imports
# IIFE exposing `PureAntlr`). `--conditions=browser` selects antlr4's browser build (no node
# fs/path), which is what the browser and any non-Node host needs.
#
# PARSER HALF: depends only on antlr-generate-parsers, so it needs no PDB and no Pure runtime. Keep
# it that way — it is what lets a host parse before anything has been compiled.
# generate-extensions too, and not only antlr-generate-parsers: the bundled antlr-natives.js imports the
# generated descriptors — `generated/extensions/antlr-modules.js` for the parser CLASSES and
# `generated/languages.js` for each grammar's name and entry rule — so esbuild cannot resolve them until
# the generator has run. `generate-all` happens to order these correctly, which is why only a caller that
# runs `antlr-all` on its own (CI's javascript job) saw "Could not resolve".
antlr-bundle: antlr-generate-parsers generate-extensions
    @{{header}} 'antlr-bundle'
    @{{substep}} 'esbuild --bundle src/core/grammar/antlr-entry.js -> build/antlr-bundle.js'
    mkdir -p "$(dirname "{{antlr_bundle}}")"
    cd {{js_root}} && pnpm exec esbuild "{{antlr_entry}}" \
        --bundle --format=iife --global-name=PureAntlr --platform=neutral --conditions=browser --target=es2020 \
        --outfile="{{antlr_bundle}}" --log-level=warning
    @echo "  wrote build/antlr-bundle.js ($(wc -c < {{antlr_bundle}} | tr -d ' ') bytes)"

# Translate the parser-mappings module -> generated/pure/grammar/parser.js, then bundle it with
# __pureParseTop -> build/parser-mappings-bundle.js.
#
# MAPPINGS HALF: this one needs the PDBs, because it IS translated Pure. load-parser installs a
# throwing stub for `__pureParseTop` when the bundle is absent — only Pure's `parse` needs it.
parser-mappings-bundle: (_emit "meta::pure::parser::mappings" "pure/grammar/parser.js") antlr-generate-parsers
    @{{header}} 'parser-mappings-bundle'
    @{{substep}} 'esbuild --bundle src/core/grammar/parser-mappings-entry.js -> build/parser-mappings-bundle.js'
    mkdir -p "$(dirname "{{mappings_bundle}}")"
    cd {{js_root}} && pnpm exec esbuild "{{mappings_entry}}" \
        --bundle --format=iife --platform=neutral --conditions=browser --target=es2020 \
        --outfile="{{mappings_bundle}}" --log-level=warning
    @echo "  wrote build/parser-mappings-bundle.js ($(wc -c < {{mappings_bundle}} | tr -d ' ') bytes)"

# Both halves of the host's parser.
antlr-all: antlr-bundle parser-mappings-bundle

# Render the Pure -> JavaScript translation gallery: every <<PCT.test>> under PACKAGE, with its Pure
# source beside its translated JavaScript, and a pass/fail icon from COMPILING AND EXECUTING the
# translated source on this host.
#
# The execution and the output belong here, not to the translation module: the gallery's pass/fail
# column is this host's behaviour, so it is a report about the platform. `gallery.pure` itself stays
# with the translator — it needs the translator's own API to render a card — and
# `modules::translation_javascript::gallery` delegates here, as translation/java already does.
gallery PACKAGE="meta::pure::functions" OUT=(js_root / "build" / "javascript-translation-gallery.html"): generate-all
    @{{header}} 'gallery'
    @{{substep}} 'render {{PACKAGE}} -> {{OUT}}'
    test -f {{translation_javascript_out}}/javascript-translation-tests.pdb || (echo "ERROR: missing {{translation_javascript_out}}/javascript-translation-tests.pdb (run \`just modules::translation_javascript::build-tests\` first — renderGallery is <<test.TestDependency>>)" && exit 1)
    mkdir -p "$(dirname "{{OUT}}")"
    {{js_root}}/bin/pure-js execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::external::language::javascript::translation::gallery::renderGallery_String_1__String_1_" \
        --args "{{PACKAGE}}" > {{OUT}}
    @echo "  wrote {{OUT}} ($(wc -c < {{OUT}} | tr -d ' ') bytes)"

# Vendor Monaco for the browser demo: pnpm installs the pinned monaco-editor and its
# prebuilt AMD distribution is copied to build/vs, which index.html loads. Vendored
# rather than pulled from a CDN so the page stays exactly what it claims to be — a
# compiler that runs with no network — and so the editor version is pinned like the
# antlr4 bundle translation/javascript vendors.
#
# build/ is gitignored; re-run after changing the monaco-editor version.
web-deps:
    @{{header}} 'web-deps'
    @{{substep}} 'pnpm install + copy monaco min/vs -> build/vs'
    cd {{js_root}} && pnpm install --silent && rm -rf build/vs && mkdir -p build && cp -R node_modules/monaco-editor/min/vs build/vs
    @echo "  $(du -sh {{js_root}}/build/vs | cut -f1) in build/vs"

# Serve the browser demo. Served from the repo root so src/interfaces/web/index.html's
# relative paths to the parser bundle resolve; open the printed URL.
serve: web-deps
    @{{header}} 'serve'
    @{{substep}} 'static server at repo root'
    @echo "  open  http://localhost:8000/platforms/javascript/src/interfaces/web/index.html"
    cd {{js_root}}/../.. && python3 -m http.server 8000

# Remove node_modules/ (no dist — plain JS).
clean:
    @{{header}} 'clean'
    @{{substep}} 'remove node_modules/'
    rm -rf {{js_root}}/node_modules

# Build time trend (tools/test-dashboard/build-step.mjs): the first dependency of a heavy recipe, whose last line runs `{{build_step}} end`.
_step-start STEP:
    {{build_step}} start "{{STEP}}"
