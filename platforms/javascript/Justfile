# platforms/javascript/Justfile — builds and tests the JavaScript runtime.
#
# Direct invocation:    just <recipe>             (from platforms/javascript/)
# Via the root Justfile: just javascript::<recipe> (from repo root)
#
# Plain JavaScript stub — no build step (no TypeScript, no bundler). The
# recipes run the package.json `build`/`test` scripts, which are placeholders
# until the in-browser interpreter is implemented.

set quiet := true
set shell := ["bash", "-c"]

js_root   := source_directory()
repo_root := js_root / ".." / ".."
# Records heavy build steps for the dashboard build time trend.
build_step     := "node " + repo_root / "tools" / "test-dashboard" / "build-step.mjs"
shared    := repo_root / "shared"
test_results := repo_root / "test-results"
spec      := repo_root / "pure" / "specification"
# THE JAVASCRIPT HOST'S PARSER. Generated from the grammars in pure/specification (the Pure
# language) and pure/extensions/*/grammar (each extension), then bundled with antlr4 for a host that
# has no module loader. This is platform territory, not translation: a parser turns text into a
# tree, which has nothing to do with turning Pure into JavaScript. What DOES belong to translation is
# runtime-lib.js — the 170 helpers the translator emits calls to — which stays in that module.
grammar_src  := spec / "grammar" / "antlr"
antlr_gen    := js_root / "generated" / "pure" / "grammar" / "antlr"
ext_gen      := js_root / "generated" / "extensions"
antlr_entry  := js_root / "src" / "core" / "grammar" / "antlr-entry.js"
mappings_entry := js_root / "src" / "core" / "grammar" / "parser-mappings-entry.js"
antlr_bundle := js_root / "build" / "antlr-bundle.js"
mappings_bundle := js_root / "build" / "parser-mappings-bundle.js"
translation_js_dir := repo_root / "pure" / "modules" / "translation" / "javascript" / "js"
# Module build outputs: each module writes its own pdbs (and gallery) into its build/.
language_javascript_out    := repo_root / "pure" / "modules" / "language" / "javascript" / "build"
# Language extensions (pure/extensions/*) each write their own pdb into their build/.
extension_diagram_out      := repo_root / "pure" / "extensions" / "diagram" / "build"
translation_shared_out     := repo_root / "pure" / "modules" / "translation" / "shared" / "build"
translation_javascript_out := repo_root / "pure" / "modules" / "translation" / "javascript" / "build"
pure_bootstrap := repo_root / "bootstrap" / "bin" / "pure-bootstrap"
pure_truffle   := repo_root / "platforms" / "truffle" / "bin" / "pure-truffle"

# Pure runtime used to RUN the translator when emitting generated/*.js. Truffle
# is only a tool here — it emits byte-identical output to bootstrap (verified),
# it is just faster. Bootstrap is the default so this platform builds with no
# Truffle at all; set `pure_rt=truffle` for the quicker inner loop:
#     just pure_rt=truffle javascript::generate-all      (overrides precede the recipe)
pure_rt := "bootstrap"
emit_rt := if pure_rt == "truffle" { pure_truffle } else { pure_bootstrap }

# Pure package -> standalone JS, emitted into generated/ (gitignored).
translate_fn := "meta::external::language::javascript::translation::pdb::translatePackageToJs_String_1__String_1_"
# The TEST half of a package. Tests are not in a package of their own — a PCT test model sits
# inside meta::pure::functions — so the emit splits them by stereotype instead, the same rule the
# pdb split uses. Only the test harnesses load the companions; the browser IDE does not.
translate_tests_fn := "meta::external::language::javascript::translation::pdb::translatePackageTestsToJs_String_1__String_1_"
# The test FRAMEWORK package (meta::pure::test) emits whole: its adapters are test material by
# the stereotype rule, but only test hosts ever load it, so splitting it would just produce two
# files that always travel together.
translate_all_fn := "meta::external::language::javascript::translation::pdb::translatePackageAllToJs_String_1__String_1_"

# Everything an emission reads: the pdbs the translator runs against and the jars
# of the runtime running it (bin/pure-truffle puts every build/*.jar on its classpath).
emit_pdbs := shared / "core.pdb" + " " + shared / "core-tests.pdb" + " " + shared / "parser-mappings.pdb" + " " + shared / "compiler.pdb" + " " + shared / "compiler-tests.pdb" + " " + language_javascript_out / "javascript.pdb" + " " + language_javascript_out / "javascript-tests.pdb" + " " + translation_shared_out / "translation-shared.pdb" + " " + translation_shared_out / "translation-shared-tests.pdb" + " " + translation_javascript_out / "javascript-translation.pdb" + " " + translation_javascript_out / "javascript-translation-tests.pdb" + " " + extension_diagram_out / "diagram.pdb" + " " + extension_diagram_out / "diagram-tests.pdb"
emit_rt_jars := if pure_rt == "truffle" { repo_root / "platforms" / "truffle" / "build" / "*.jar" } else { repo_root / "bootstrap" / "build" / "pure-bootstrap.jar" }

header := "h(){ s=\"[javascript::$1]\"; ru=$(printf '█%.0s' $(seq 1 ${#s})); printf '\\n  %s\\n  %s\\n  %s\\n' \"$ru\" \"$s\" \"$ru\"; }; h"
substep := "p(){ ru=$(printf '─%.0s' $(seq 1 $((${#1}+2)))); printf '\\n  %s\\n  ↳ %s\\n  %s\\n' \"$ru\" \"$1\" \"$ru\"; }; p"

# Default: build + run tests.
default: test

# No build step — plain JS. Runs the package.json `build` placeholder script.
build:
    @{{header}} 'build'
    @{{substep}} 'pnpm run build (no-op)'
    cd {{js_root}} && pnpm run build

# No external deps — alias of `build` for symmetry with sub-Justfiles' `build-all`.
build-all: build

# Translate one Pure package to generated/<out> via the JVM translator. All
# emitted JS is gitignored. Functions are emitted under full-path-mangled names,
# so files compose: load them all and cross-file refs resolve as globals.
_emit PKG OUT FN=translate_fn:
    @{{substep}} 'translate {{PKG}} -> generated/{{OUT}}'
    test -f {{shared}}/compiler.pdb || (echo "ERROR: missing {{shared}}/compiler.pdb (run \`just bootstrap::build\` first)" && exit 1)
    test -f {{shared}}/parser-mappings.pdb || (echo "ERROR: missing {{shared}}/parser-mappings.pdb (run \`just bootstrap::build\` first — the parser-mappings module is translated into this host's parser bundle)" && exit 1)
    test -f {{language_javascript_out}}/javascript.pdb || (echo "ERROR: missing {{language_javascript_out}}/javascript.pdb (run \`just modules::build\` first — the generate step runs the TRANSLATED translator from the modules tree's pdbs)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared.pdb (run \`just modules::build\` first)" && exit 1)
    test -f {{translation_javascript_out}}/javascript-translation.pdb || (echo "ERROR: missing {{translation_javascript_out}}/javascript-translation.pdb (run \`just modules::build\` first)" && exit 1)
    test -f {{translation_javascript_out}}/javascript-translation-tests.pdb || (echo "ERROR: missing {{translation_javascript_out}}/javascript-translation-tests.pdb (run \`just modules::build\` first — split-built lean pdbs carry refs into their -tests companion)" && exit 1)
    test -f {{language_javascript_out}}/javascript-tests.pdb || (echo "ERROR: missing {{language_javascript_out}}/javascript-tests.pdb (run \`just modules::build\` first — split-built lean pdbs carry refs into their -tests companion)" && exit 1)
    test -f {{translation_shared_out}}/translation-shared-tests.pdb || (echo "ERROR: missing {{translation_shared_out}}/translation-shared-tests.pdb (run \`just modules::build\` first — split-built lean pdbs carry refs into their -tests companion)" && exit 1)
    test -f {{extension_diagram_out}}/diagram.pdb || (echo "ERROR: missing {{extension_diagram_out}}/diagram.pdb (run \`just extensions::build\` first)" && exit 1)
    test -f {{extension_diagram_out}}/diagram-tests.pdb || (echo "ERROR: missing {{extension_diagram_out}}/diagram-tests.pdb (run \`just extensions::build-tests\` first — the extension's <<test.Test>> functions are translated too, so `test-extensions` can run them on this host)" && exit 1)
    mkdir -p {{js_root}}/generated/.stamps
    # Skip when the inputs hash to the key of the last successful emission: each
    # `just` process re-runs its dependencies, and a CI job reaches generate-all
    # from several of them. The key is written only after the translator succeeds
    # (pipefail), so a failed or interrupted emission always reruns.
    # Inputs are zips (pdbs, jars) whose entries carry the build time, so a rebuild
    # with identical content still changes the file bytes: key each input by its
    # central-directory listing (length, method, size, CRC-32, name) minus the
    # date/time columns — content-sensitive, timestamp-blind, and read without
    # decompressing anything.
    set -o pipefail; \
    out={{js_root}}/generated/{{OUT}}; stamp={{js_root}}/generated/.stamps/{{OUT}}.sha256; \
    mkdir -p "$(dirname "$out")" "$(dirname "$stamp")"; \
    key=$({ echo "{{PKG}} {{FN}} {{pure_rt}}"; for f in {{emit_pdbs}} {{emit_rt_jars}}; do echo "$f"; unzip -v "$f" | awk 'NR > 3 && $1 ~ /^[0-9]+$/ && $8 != "" { print $1, $2, $3, $7, $8 }'; done; } | shasum -a 256 | cut -d' ' -f1); \
    if [ -s "$out" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$key" ]; then \
        echo "  generated/{{OUT}} up to date (inputs unchanged)"; exit 0; \
    fi; \
    rm -f "$stamp"; \
    cd {{repo_root}} && {{emit_rt}} execute \
        $(printf -- '--pdb %s ' {{emit_pdbs}}) \
        --function "{{FN}}" --args "{{PKG}}" \
        2> >(grep -E -v '^(SLF4J(\(W\))?:|WARNING: |Note: )' >&2) \
        | grep -v '^\[graal-tripwire\]' > "$out" \
    && echo "$key" > "$stamp" \
    && echo "  wrote generated/{{OUT}} ($(wc -c < "$out" | tr -d ' ') bytes)"

# Generate the compiler.
generate: (_emit "meta::pure::compiler" "pure/compiler/compiler.js") (_emit "meta::pure::compiler" "pure/compiler/compiler-tests.js" translate_tests_fn)
    @{{header}} 'generate'

# Generate the core library the compiler depends on (metamodel enums + function
# library + UI). Classes emit nothing; metamodel enums (AggregationKind, …) emit
# `export const`, which the compiler references.
generate-core: (_emit "meta::pure::metamodel" "pure/compiler/metamodel.js") (_emit "meta::pure::protocol" "pure/grammar/protocol.js") (_emit "meta::pure::functions" "pure/runtime/functions.js") (_emit "meta::pure::ui" "ui.js") (_emit "meta::pure::metamodel" "pure/compiler/metamodel-tests.js" translate_tests_fn) (_emit "meta::pure::protocol" "pure/grammar/protocol-tests.js" translate_tests_fn) (_emit "meta::pure::functions" "pure/runtime/functions-tests.js" translate_tests_fn)
    @{{header}} 'generate-core'

# Generate just the PDB reader/schema package (a small subset of compiler.js).
# The parser-only host (grammar/load-parser.js) loads this to back its metadata
# globals with the translated Pure reader without pulling in the whole compiler.
generate-pdb-reader: (_emit "meta::pure::compiler::pdb" "pure/compiler/pdb.js")
    @{{header}} 'generate-pdb-reader'

# Generate the in-process translator stack for the execution host
# (src/core/execution): the Pure→JS translator itself translated to JS, its shared
# canonicalization pipeline, the JS-language metamodel/factories it builds on,
# and the meta::pure::test helpers (resolveChild & co.) its package walker calls.
generate-translator: (_emit "meta::pure::test" "test.js" translate_all_fn) (_emit "meta::pure::translation::shared" "pure/runtime/translator/shared.js") (_emit "meta::external::language::javascript" "pure/runtime/translator/javascript.js") (_emit "meta::external::language::javascript::translation" "pure/runtime/translator/translation.js") (_emit "meta::pure::translation::shared" "pure/runtime/translator/shared-tests.js" translate_tests_fn) (_emit "meta::external::language::javascript" "pure/runtime/translator/javascript-tests.js" translate_tests_fn) (_emit "meta::external::language::javascript::translation" "pure/runtime/translator/translation-tests.js" translate_tests_fn)
    @{{header}} 'generate-translator'

# THE PLATFORM'S EXTENSION AREA: one descriptor per extension found under pure/extensions, read
# from its `language_<name>.json`. This is how the host learns a language exists — the module that carries
# its Pure code, where that module's pdb is built, and the Pure entry points for its section parser
# and its compiler passes. src/core/runtime/LanguageExtensions.js builds its registry from it, so
# adding a language is a directory on disk rather than an edit to the host.
generate-extensions:
    @{{header}} 'generate-extensions'
    @{{substep}} 'pure/extensions/*/language_<name>.json -> generated/extensions/<name>/language_<name>.js'
    mkdir -p {{js_root}}/generated
    node {{js_root}}/bin/generate-languages.mjs {{repo_root}} "{{js_root}}/generated"
    @echo "  (the same run writes extensions/antlr-modules.js, which only antlr-bundle.js may import)"

# Translate every extension's Pure into its own directory under the platform's extension area, ONE
# FILE PER HALF of the language: `parser.js` for the grammar mapping rules, `compiler.js` for the
# compiler passes. They used to be one `code.js`, whose name said nothing about what was in it.
#
# No extension and no package is named here — the generated descriptors say which packages to
# translate and where, derived from each `language_<name>.json`.
#
# The browser IDE needs these loaded before a source containing that section will parse at all:
# dispatchSection fails hard on an unregistered section.
generate-extensions-code: generate-extensions
    #!/usr/bin/env bash
    set -euo pipefail
    {{header}} 'generate-extensions-code'
    node --input-type=module -e '
        import { LANGUAGES } from "{{js_root}}/generated/languages.js";
        for (const e of LANGUAGES) {
            for (const t of e.translate ?? []) console.log(`${t.package}\t${t.out}`);
        }
    ' | while IFS=$'\t' read -r pkg out; do
        # WHOLE, not split. An extension's tests sit inside the packages it declares
        # (meta::pure::diagram::parser::tests is part of meta::pure::diagram::parser), and its whole
        # generated output is ~80 KB — so there is nothing to save by cutting it in two, and a host
        # that registers an extension loads all of it anyway. The library/test split exists for
        # functions.js, where the test corpus was 1.2 MB.
        just --justfile "{{js_root}}/Justfile" _emit "$pkg" "$out" "{{translate_all_fn}}"
    done

# Generate everything the standalone compiler + execution hosts need.
# `antlr-all` is a dependency because the parser the hosts actually RUN is the bundle, not
# generated/pure/grammar/parser.js: re-translating the parser without re-bundling leaves the old
# parser in place, and nothing says so. That cost a long debugging detour — a bundle built before
# Pure classes were emitted kept producing plain object literals while the freshly generated
# compiler read them through accessors, so the failure surfaced as `file._sections is not a
# function` in the compiler, nowhere near the stale artifact. Both bundles together rebuild in ~2s.
generate-all: (_step-start "javascript/generate") generate-extensions generate-core generate generate-pdb-reader generate-translator generate-extensions-code antlr-all
    {{build_step}} end "javascript/generate"

# Run the grammar-corpus suite (standalone JS parser vs committed protocol.json).
# Needs the parser bundle (build/antlr-bundle.js) plus generated/pdb-reader.js
# (the parser host's metadata globals decodes core.pdb with the Pure reader).
# `generate-all` rather than just the pdb reader: this runs the grammar corpus against the parser
# BUNDLE, and test-all lists this recipe first — so without the dependency the corpus exercises
# whatever bundle happened to be lying around, and a later recipe in the same run regenerates it.
# That is how a stale bundle produced `__rdiag is not defined` from a since-removed helper.
test: build generate-all
    @{{header}} 'test'
    @{{substep}} 'grammar corpus (pnpm run test:grammar)'
    cd {{js_root}} && pnpm run test:grammar --report {{test_results}}/javascript/core/grammar-tests.json

# Run the compiler-conformance suite (standalone JS compiler vs committed
# ###CompiledGraph). Requires the generated/ compiler JS, so depends on
# generate-all.
test-compiler: generate-all
    @{{header}} 'test-compiler'
    @{{substep}} 'compiler conformance (pnpm run test:compiler)'
    cd {{js_root}} && pnpm run test:compiler --report {{test_results}}/javascript/core/compiler-tests.json

# Run the PCT suite through the execution host (src/core/execution): translate
# meta::pure::functions IN-PROCESS with the translated translator, eval the
# emitted JS, and run every <<PCT.test>> against it.
#
# A PCT failure FAILS THE BUILD. It used to be swallowed with `|| echo`, from when the translated
# runtime still had gaps; both PCT recipes have been at 831/831 on this platform for a while, so all
# the mask could still do was hide a regression — and it did: a change that dropped 10 tests to
# 821/831 was reported as a clean run, because the suite carried on and exited 0.
test-execution: generate-all
    @{{header}} 'test-execution'
    @{{substep}} 'PCT via in-process translator (pnpm run test:execution)'
    cd {{js_root}} && pnpm run test:execution --report {{test_results}}/javascript/core/pct-tests.json

# Grammar corpus specification: parse each grammar.pure and compare with its protocol.json, through bin/pure-js.
spec-grammar: generate-all
    @{{header}} 'spec-grammar'
    @{{substep}} 'runGrammarCorpus over pure/specification/grammar/tests (JavaScript host)'
    {{js_root}}/bin/pure-js execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::pure::test::grammar::runGrammarCorpus_String_1__String_1__String_1_" \
        --args "{{spec}}/grammar/tests" "{{test_results}}/spec/grammar/pure@cli-javascript.json"

# Compiler corpus specification: compile each fixture and compare with its ###CompiledGraph, through bin/pure-js.
spec-compiler: generate-all
    @{{header}} 'spec-compiler'
    @{{substep}} 'runCompiledGraphTests over pure/specification/compiler/tests (JavaScript host)'
    {{js_root}}/bin/pure-js execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::pure::compiler::test::runCompiledGraphTests_String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{test_results}}/spec/compiler/pure@cli-javascript.json"

# PCT specification over meta::pure::functions, through bin/pure-js.
spec-pct: generate-all
    @{{header}} 'spec-pct'
    @{{substep}} 'runPCTTests over meta::pure::functions (JavaScript host)'
    {{js_root}}/bin/pure-js execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::pure::test::runPCTTests_String_1__String_1__String_1_" \
        --args "meta::pure::functions" "{{test_results}}/spec/pct/pure@cli-javascript.json"

# The self-hosted PDB stack's <<test.Test>> suite (meta::pure::compiler::pdb:
# schema, reader, writer, archive), translated: byte-exact wire format against the
# JVM reference writer, archives, read-back round trips. Run through bin/pure-js
# like every other Pure suite; the tests live in compiler-tests.pdb.
test-pdb: generate-all
    @{{header}} 'test-pdb'
    @{{substep}} 'runTests meta::pure::compiler::pdb (JavaScript host)'
    {{js_root}}/bin/pure-js execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::pure::test::runTests_String_1__String_1__String_1_" \
        --args "meta::pure::compiler::pdb" "{{test_results}}/spec/pdb-format/pure@cli-javascript.json"

# PDB wire contract: compile each compiler fixture, write it with the Pure writer and compare the archive
# with the Java golden in pure/specification/compiler/tests-pdb-serialization (compiler-pure test/pdbGoldenRunner.pure).
spec-pdb-golden: generate-all
    @{{header}} 'spec-pdb-golden'
    @{{substep}} 'runPdbGoldenTests: the Pure compiler and writer against the Java golden archives'
    {{js_root}}/bin/pure-js execute \
        --pdb {{shared}}/core.pdb \
        --pdb {{shared}}/core-tests.pdb \
        --pdb {{shared}}/compiler.pdb \
        --pdb {{shared}}/compiler-tests.pdb \
        --pdb {{language_javascript_out}}/javascript.pdb \
        --pdb {{translation_shared_out}}/translation-shared.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation.pdb \
        --pdb {{translation_javascript_out}}/javascript-translation-tests.pdb \
        --function "meta::pure::compiler::test::pdb::runPdbGoldenTests_String_1__String_1__String_1__String_1__String_1_" \
        --args "{{spec}}/compiler/tests" "{{spec}}/compiler/tests-pdb-serialization" "{{shared}}/specification/m3.fbs" "{{test_results}}/spec/pdb/pure@cli-javascript.json"

# Compiled-printer corpus: compile each compiler-corpus file, print the compiled elements, compare with the source. Run through bin/pure-js like test-pdb.
