# Host platform API conformance: module, registry, natives and runtime shapes
# (docs/superpowers/specs/2026-09-13-unified-host-api-design.md).
test-host-api: generate-all
    @{{header}} 'test-host-api'
    @{{substep}} 'host platform API (pnpm run test:host-api)'
    cd {{js_root}} && pnpm run test:host-api --report {{test_results}}/javascript/core/host-api-tests.json

# The host API end to end, as bootstrap's TestPureRuntime: set Pure source into an in-memory module,
# compile through the PureRuntime, execute a function it defines, modify and recompile.
# Run the usage example — the simplest way to start Pure on JavaScript
# (src/interfaces/usage-example/). An INTERFACE to the platform, like the browser IDE and like the
# Java platform's own usage-example module. It asserts nothing and writes no report: it is here so the
# example cannot rot, and it fails the build by throwing if the system no longer starts. The
# behaviour it demonstrates is pinned by `test-host-api`.
usage-example: generate-all
    @{{header}} 'usage-example'
    @{{substep}} 'start a runtime, compile a source, execute a function'
    cd {{js_root}} && pnpm run usage-example

# The browser IDE's diagram engine: `###Diagram` text -> model -> text. Needs no PDB or
# generated code, so it does not depend on generate-all.
test-diagram:
    @{{header}} 'test-diagram'
