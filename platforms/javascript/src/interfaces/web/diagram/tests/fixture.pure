###Pure
Class model::Person
{
   firstName : String[1];
   lastName  : String[1];
   firm      : model::Firm[1];
}

Class model::Firm extends model::LegalEntity
{
   legalName : String[1];
}

Class model::LegalEntity
{
   registrationId : String[1];
}

###Diagram
Diagram model::PersonDiagram(width=1000.0, height=600.0)
{
   TypeView tv_person
   (
      type=model::Person,
      stereotypesVisible=true,
      attributesVisible=true,
      attributeStereotype=none,
      attributeTypes=none,
      color=#FFFFCC,
      lineWidth=-1.0,
      position=(100.0, 100.0),
      width=200.0,
      height=80.0
   )
   TypeView tv_firm
   (
      type=model::Firm,
      stereotypesVisible=true,
      attributesVisible=true,
      attributeStereotype=none,
      attributeTypes=none,
      color=#FFFFCC,
      lineWidth=-1.0,
      position=(500.0, 100.0),
      width=200.0,
      height=80.0
   )
   TypeView tv_legal
   (
      type=model::LegalEntity,
      stereotypesVisible=false,
      attributesVisible=true,
      attributeStereotype=none,
      attributeTypes=none,
      color=#CCFFFF,
      lineWidth=-1.0,
      position=(500.0, 300.0),
      width=200.0,
      height=80.0
   )
   GeneralizationView gv_firm_legal
   (
      source=tv_firm,
      target=tv_legal,
      points=[(600.0, 160.0), (600.0, 320.0)]
   )
   PropertyView pv_person_firm
   (
      property=model::Person.firm,
      source=tv_person,
      target=tv_firm,
      points=[(250.0, 140.0), (400.0, 200.0), (550.0, 140.0)]
   )
   AssociationView av_person_legal
   (
      association=model::Person_LegalEntity,
      source=tv_person,
      target=tv_legal,
      points=[(200.0, 170.0), (560.0, 310.0)],
      color=#FF0000,
      lineWidth=2.0,
      label=employs
   )
}
