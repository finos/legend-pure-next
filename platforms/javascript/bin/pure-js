# Shell wrapper for the Node-backed Pure execution host — the JavaScript
# counterpart of platforms/truffle/bin/pure-truffle. It takes the same
# `execute` arguments, so module recipes drive either host the same way:
#
#     pure-js execute [--pdb <file>...] --function <path> [--args <arg>...]
#
# Unlike Truffle, which interprets PDBs directly, this host runs JavaScript
# already translated from them: run `just javascript::generate-all` first (and
# again after the translated modules change).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JS_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ ! -f "${JS_DIR}/generated/translator.js" ]]; then
    echo "Error: generated JavaScript not found under ${JS_DIR}/generated" >&2
    echo "Run 'just javascript::generate-all' first." >&2
    exit 1
fi

exec node --stack-size=4000 "${JS_DIR}/src/interfaces/cli/cli.js" "$@"
