# The IntelliJ Bazel plugin's project view (it reads this file before its own .bazelbsp/.bazelproject).
derive_targets_from_directories: true
directories: .

# The bootstrap and self-host tiers are tagged manual (out of //...): sync them too, so they show and run from the IDE.
allow_manual_targets_sync: true
